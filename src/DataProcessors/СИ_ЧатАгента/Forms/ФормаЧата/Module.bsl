&НаКлиенте
Процедура ПослеВводаТекстаКопирования(Результат, ДополнительныеПараметры) Экспорт
	
КонецПроцедуры

// Копирует ответ модели с указанным номером сообщения в системный буфер обмена.
// Копируется только Контент ответа — без рассуждений (reasoning) и служебных данных.
&НаКлиенте
Процедура СкопироватьОтветПоНомеру(НомерСообщения)

	ТекстДляКопирования = "";
	Для Каждого Строка Из ИсторияСообщений Цикл
		Если Строка.Роль = "assistant" И Строка.НомерСообщения = НомерСообщения Тогда
			Контент = Строка.Контент;
			Если Контент = Неопределено Тогда
				Контент = "";
			КонецЕсли;
			ТекстДляКопирования = Контент;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ТекстДляКопирования) Тогда
		ПоказатьПредупреждение(, "Ответ ассистента пустой или уже недоступен для копирования.");
		Возврат;
	КонецЕсли;

	Если ЗаписатьВБуферОбменаЧерезDOM(ТекстДляКопирования) Тогда
		СтатусАгента = "Ответ скопирован в буфер обмена";
	Иначе
		ПоказатьВводСтроки(Новый ОписаниеОповещения("ПослеВводаТекстаКопирования", ЭтотОбъект),
			ТекстДляКопирования, "Текст ответа (скопируйте его)", 25);
	КонецЕсли;

КонецПроцедуры

// Обрабатывает клик по кнопке-варианту ответа на вопрос модели (ссылка choose:<номер>:<индекс>).
// Находит текст выбранного варианта в кэше ВариантыВопросов (заполняется при рендере истории)
// и отправляет его агенту как обычное сообщение пользователя — начинается новый ход диалога,
// в котором модель продолжает с учётом сделанного выбора.
&НаКлиенте
Процедура ВыбратьВариантОтвета(НомерСообщения, ИндексВарианта)

	ТекстВарианта = "";
	Для Каждого СтрокаВарианта Из ВариантыВопросов Цикл
		Если СтрокаВарианта.НомерСообщения = НомерСообщения
			И СтрокаВарианта.Индекс = ИндексВарианта Тогда
			ТекстВарианта = СтрокаВарианта.Текст;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ТекстВарианта) Тогда
		ПоказатьПредупреждение(, "Вариант ответа уже недоступен. Задайте вопрос заново.");
		Возврат;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания)
		И ЗначениеЗаполнено(ЗаходИдДиалога) И ЗаходИдДиалога = АктивныйДиалог Тогда
		ПоказатьПредупреждение(, "Дождитесь завершения текущего запроса");
		Возврат;
	КонецЕсли;

	ОчиститьКэшВариантовВопросов();

	Элементы.КомандаОтправить.Доступность = Ложь;
	Элементы.ПолеВвода.Доступность = Ложь;
	Элементы.КомандаПрикрепитьФайл.Доступность = Ложь;
	Элементы.КомандаСжать.Доступность = Ложь;

	ТекстВвода = ТекстВарианта;
	ОтправитьСообщениеАгенту();

КонецПроцедуры

// Очищает кэш вариантов вопросов модели (реквизит ВариантыВопросов).
// Вызывается после выбора варианта пользователем, чтобы кнопки уже отвеченного
// вопроса не могли отправить повторный ответ.
&НаКлиенте
Процедура ОчиститьКэшВариантовВопросов()
	ВариантыВопросов.Очистить();
КонецПроцедуры

// Обрабатывает клик по кнопке решения на карточке запроса разрешения
// (ссылка perm:<allow|always|deny>:<ИдВызова>). Решение записывается только
// по ЭТОМУ вызову; карточка остаётся в документе и показывает следующий
// нерешённый вызов. Когда решения приняты по всем вызовам пакета, запускается
// ОДНО возобновление захода - фоновое задание исполняет одобренные вызовы
// (или пишет отказы) и продолжает цикл модели. Благодаря этому пакет
// подтверждается последовательно, без «Дождитесь завершения текущего запроса»
// между кликами.
&НаКлиенте
Процедура ОтветитьНаЗапросРазрешения(Действие, ИдВызова)

	Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания)
		И ЗначениеЗаполнено(ЗаходИдДиалога) И ЗаходИдДиалога = АктивныйДиалог Тогда
		ПоказатьПредупреждение(, "Дождитесь завершения текущего запроса");
		Возврат;
	КонецЕсли;

	Если Действие = "resume" Тогда
		НачатьВозобновлениеЗаходаПослеРазрешений();
		Возврат;
	КонецЕсли;

	Если РешениеРазрешенияЗаписывается = Истина Тогда
		Возврат;
	КонецЕсли;
	РешениеРазрешенияЗаписывается = Истина;

	Результат = Неопределено;
	ТекстОшибки = "";
	Попытка
		Результат = ЗафиксироватьРешениеРазрешенияНаСервере(Действие, ИдВызова);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	РешениеРазрешенияЗаписывается = Ложь;

	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, "Ошибка подтверждения инструмента: " + ТекстОшибки);
		Возврат;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось сохранить решение по инструменту");
		Возврат;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;

	Если НЕ Результат.ВсеРешены Тогда
		ОбновитьКарточкуРазрешенияНаКлиенте(Результат.HTMLКарточки);
		Возврат;
	КонецЕсли;

	НачатьВозобновлениеЗаходаПослеРазрешений();

КонецПроцедуры

// Запускает ОДНО возобновление захода, когда решения приняты по всем вызовам
// пакета. Общая часть клика по последнему решению и кнопки «Продолжить»
// (perm:resume:) на карточке, оставшейся после сбоя запуска.
&НаКлиенте
Процедура НачатьВозобновлениеЗаходаПослеРазрешений()

	Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания)
		И ЗначениеЗаполнено(ЗаходИдДиалога) И ЗаходИдДиалога = АктивныйДиалог Тогда
		ПоказатьПредупреждение(, "Дождитесь завершения текущего запроса");
		Возврат;
	КонецЕсли;

	Элементы.КомандаОтправить.Доступность = Ложь;
	Элементы.ПолеВвода.Доступность = Ложь;
	Элементы.КомандаПрикрепитьФайл.Доступность = Ложь;
	Элементы.КомандаСжать.Доступность = Ложь;

	ТаймерАктивен = Истина;
	ФинализацияВыполнена = Ложь;
	ВремяСтарта = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Элементы.КомандаПрерватьДиалог.Доступность = Истина;
	ВызовыИнструментовЗахода = Новый Массив;
	РассужденияЗахода = "";
	ПромежуточныйТекстЗахода = "";

	Попытка
		ЗапуститьВозобновлениеНаСервере(СобратьОткрытыеФормы());

		Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания) Тогда
			Попытка
				Если ОкноHTML <> Неопределено Тогда
					ОкноHTML.siRemovePermCard();
				КонецЕсли;
			Исключение
				ОкноHTML = Неопределено;
			КонецПопытки;
		КонецЕсли;

		ПодключитьОжиданиеЗаходаКлиент();
	Исключение
		РазблокироватьИнтерфейс();
		ПоказатьПредупреждение(, "Ошибка запуска фонового задания: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Обновляет карточку запроса разрешения на клиенте: показывает следующий
// нерешённый вызов без пересоздания документа. Основной путь - JS-мост
// (siReplacePermCard); если моста нет, строку HTML правит сервер.
//
// Параметры:
//  HTMLКарточки - Строка - HTML следующей карточки (СИ_ЧатHTMLСервер.ПолучитьБлокРазрешенияHTML).
&НаКлиенте
Процедура ОбновитьКарточкуРазрешенияНаКлиенте(Знач HTMLКарточки)

	МостЗаменил = Ложь;
	Попытка
		Если ОкноHTML <> Неопределено Тогда
			ОтветМоста = ОкноHTML.siReplacePermCard(HTMLКарточки);
			МостЗаменил = (ОтветМоста = "ok");
		КонецЕсли;
	Исключение
		ОкноHTML = Неопределено;
	КонецПопытки;

	Если НЕ МостЗаменил Тогда
		ОбновитьКарточкуРазрешенияВИсторииНаСервере(HTMLКарточки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗафиксироватьРешениеРазрешенияНаСервере(Знач Действие, Знач ИдВызова)

	Результат = Новый Структура;
	Результат.Вставить("ВсеРешены", Ложь);
	Результат.Вставить("HTMLКарточки", "");
	Результат.Вставить("Ошибка", "");

	Если НЕ ЗначениеЗаполнено(АктивныйДиалог) Тогда
		Результат.Ошибка = "Диалог не выбран";
		Возврат Результат;
	КонецЕсли;

	Если СИ_УправлениеДиалогом.ЕстьАктивныйЗапуск(АктивныйДиалог) Тогда
		Результат.Ошибка = "Дождитесь завершения текущего запроса";
		Возврат Результат;
	КонецЕсли;

	Попытка
		ОбновленныйJSON = СИ_Агент1С.ЗаписатьРешениеРазрешения(АктивныйДиалог, Действие, ИдВызова);
	Исключение
		Результат.Ошибка = "Не удалось сохранить решение: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(ОбновленныйJSON) Тогда
		Результат.ВсеРешены = Истина;
		Возврат Результат;
	КонецЕсли;

	Разобранное = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ОбновленныйJSON);
	Если Разобранное = Неопределено ИЛИ ТипЗнч(Разобранное) <> Тип("Массив") Тогда
		Результат.Ошибка = "Не удалось разобрать ожидающие вызовы";
		Возврат Результат;
	КонецЕсли;

	ВсегоВызовов = Разобранное.Количество();
	Осталось = 0;
	Для Каждого Элемент Из Разобранное Цикл
		Если ПустаяСтрока(СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Решение", "")))) Тогда
			Осталось = Осталось + 1;
		КонецЕсли;
	КонецЦикла;

	Если Осталось = 0 Тогда
		Результат.ВсеРешены = Истина;
		СтатусАгента = "Все вызовы подтверждены (" + Строка(ВсегоВызовов) + ")";
	Иначе
		Результат.HTMLКарточки = СИ_ЧатHTMLСервер.ПолучитьБлокРазрешенияHTML(ОбновленныйJSON);
		СтатусАгента = "Подтверждено " + Строка(ВсегоВызовов - Осталось)
			+ " из " + Строка(ВсегоВызовов);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ОбновитьКарточкуРазрешенияВИсторииНаСервере(Знач HTMLКарточки)

	ТекстИстории = СИ_ЧатHTMLСервер.ЗаменитьБлокРазрешенияHTML(ТекстИстории, HTMLКарточки);

КонецПроцедуры

// Общая часть запуска захода (ОтправитьСообщениеАгенту и ОтветитьНаЗапросРазрешения):
// после того как сервер выставил ИдентификаторФоновогоЗадания, подключает живой
// канал и обработчик завершения (ДлительныеОперацииКлиент.ОжидатьЗавершение).
&НаКлиенте
Процедура ПодключитьОжиданиеЗаходаКлиент()

	Если ПустаяСтрока(ИдентификаторФоновогоЗадания) Тогда
		РазблокироватьИнтерфейс();
		Возврат;
	КонецЕсли;

	ЗаходИдДиалога = АктивныйДиалог;
	УИДиалога = Строка(АктивныйДиалог.УникальныйИдентификатор());

	Состояние = ПолучитьСостояниеЗахода(УИДиалога);
	Состояние.ИдЗадания = ИдентификаторФоновогоЗадания;
	Состояние.ПоследнийНомер = ПоследнийПоказанныйНомерСообщения;
	Состояние.ВызовыИнструментов = ВызовыИнструментовЗахода;
	Состояние.Рассуждения = РассужденияЗахода;
	Состояние.ПромежуточныйТекст = ПромежуточныйТекстЗахода;
	Состояние.ТокеныЗаЗаход = 0;
	Состояние.ПромптТокеныПоследнейИтерации = 0;
	Состояние.ВсегоТокенов = 0;
	Состояние.ОкноМоделиЗапрошено = Ложь;

	ПодключитьЖивойКанал(УИДиалога);

	Операция = Новый Структура;
	Операция.Вставить("Статус", "Выполняется");
	Операция.Вставить("ИдентификаторЗадания",
		Новый УникальныйИдентификатор(ИдентификаторФоновогоЗадания));

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;
	ПараметрыОжидания.ОтменятьПриЗакрытииФормыВладельца = Ложь;
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"АгентЗаданиеЗавершено", ЭтотОбъект, УИДиалога);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, ОповещениеОЗавершении, ПараметрыОжидания);
	Состояние.ОжиданиеПодключено = Истина;

КонецПроцедуры

&НаКлиенте
АСИНХ Процедура ОткрытьФайлДиалогаПоУИД(УИДФайла)

	Если ПустаяСтрока(УИДФайла) Тогда
		Возврат;
	КонецЕсли;

	ДанныеФайла = ПолучитьДанныеФайлаДляОткрытияНаСервере(УИДФайла);
	Если ДанныеФайла = Неопределено ИЛИ ПустаяСтрока(ДанныеФайла.АдресВоВременномХранилище) Тогда
		ПоказатьПредупреждение(, "Не удалось получить файл.");
		Возврат;
	КонецЕсли;

	АдресФайла = ДанныеФайла.АдресВоВременномХранилище;
	ИмяФайла = ДанныеФайла.ИмяФайла;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "файл";
	КонецЕсли;

	Попытка
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайла, ИмяФайла);
	Исключение
		ПоказатьПредупреждение(, "Ошибка сохранения файла: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Открывает файл-изображение диалога для просмотра по ссылке view:<UUID>:
// выгружает оригинал во временный каталог и запускает ассоциированное
// приложение (svg - браузер, png - просмотрщик), диалог сохранения не
// показывается. Вызывается из обработчика клика по превью в истории чата.
&НаКлиенте
Процедура ОткрытьФайлДляПросмотраПоУИД(УИДФайла)

	Если ПустаяСтрока(УИДФайла) Тогда
		Возврат;
	КонецЕсли;

	ДанныеФайла = ПолучитьДанныеФайлаДляОткрытияНаСервере(УИДФайла);
	Если ДанныеФайла = Неопределено ИЛИ ПустаяСтрока(ДанныеФайла.АдресВоВременномХранилище) Тогда
		ПоказатьПредупреждение(, "Не удалось получить файл.");
		Возврат;
	КонецЕсли;

	ИмяФайла = ДанныеФайла.ИмяФайла;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "файл";
	КонецЕсли;

	Попытка
		КаталогПросмотра = КаталогВременныхФайлов() + "СИ_ЧатАгента\";
		СоздатьКаталог(КаталогПросмотра);
		ПолноеИмяФайла = КаталогПросмотра + ИмяФайла;

		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.АдресВоВременномХранилище);
		Если ДвоичныеДанные = Неопределено Тогда
			ПоказатьПредупреждение(, "Не удалось получить файл.");
			Возврат;
		КонецЕсли;
		ДвоичныеДанные.Записать(ПолноеИмяФайла);

		ЗапуститьПриложение(ПолноеИмяФайла, , Ложь);
	Исключение
		ПоказатьПредупреждение(, "Не удалось открыть файл для просмотра: " + ОписаниеОшибки()
			+ Символы.ПС + "Проверьте, что в системе есть приложение для файлов этого типа.");
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеФайлаДляОткрытияНаСервере(УИДФайла)

	Попытка
		Результат = СИ_ФайлыДиалога.ДанныеФайлаДляОткрытия(УИДФайла);
		Если Результат = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Результат;
	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.ПолучениеФайла", УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка получения файла: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Открывает таблицы из ответа ассистента (сообщение с указанным номером)
// табличным документом на просмотр («В таблицу»). Таблицы разбираются из
// ТЕКСТА ответа, поэтому привязки к инструменту запроса к БД нет.
// Вызывается из обработчика клика по ссылке totable:<номер сообщения>.
&НаКлиенте
Процедура ОткрытьТаблицуОтветаПоНомеру(НомерСообщения)

	Если НомерСообщения <= 0 Тогда
		Возврат;
	КонецЕсли;

	АдресТабличногоДокумента = "";
	Попытка
		АдресТабличногоДокумента = СформироватьТаблицуОтветаНаСервере(НомерСообщения);
	Исключение
		АдресТабличногоДокумента = "";
	КонецПопытки;
	Если ПустаяСтрока(АдресТабличногоДокумента) Тогда
		ПоказатьПредупреждение(, "В ответе нет таблицы для выгрузки.");
		Возврат;
	КонецЕсли;

	Попытка
		ПараметрыФормы = СтандартныеПодсистемыКлиент.ПараметрыРедактораТабличногоДокумента();
		ПараметрыФормы.ИмяДокумента = "Таблица ответа ассистента";
		ПараметрыФормы.Редактирование = Ложь;
		СтандартныеПодсистемыКлиент.ПоказатьРедакторТабличногоДокумента(
			АдресТабличногоДокумента, ПараметрыФормы, , ЭтотОбъект);
	Исключение
		ПоказатьПредупреждение(, "Ошибка открытия табличного документа: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция СформироватьТаблицуОтветаНаСервере(НомерСообщения)

	Если НомерСообщения <= 0 Тогда
		Возврат "";
	КонецЕсли;

	Контент = Неопределено;
	Для Каждого СтрокаИстории Из ИсторияСообщений Цикл
		Если СтрокаИстории.Роль = "assistant" И СтрокаИстории.НомерСообщения = НомерСообщения Тогда
			Контент = СтрокаИстории.Контент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Контент = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Контент = Строка(Контент);

	РазборВопроса = СИ_ЧатHTMLСервер.РазобратьВопросСВариантами(Контент);
	Если РазборВопроса.Успех Тогда
		Контент = РазборВопроса.КонтентБезМаркеров;
	КонецЕсли;

	Таблицы = СИ_МаркдаунHTML.ИзвлечьТаблицыMarkdown(Контент);
	Если Таблицы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ТабличныйДокумент = ПостроитьТабличныйДокумент(Таблицы);
	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.ВТаблицу", УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка формирования таблицы из ответа ассистента: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

	Возврат ПоместитьВоВременноеХранилище(ТабличныйДокумент);

КонецФункции

// Строит табличный документ по разобранным markdown-таблицам ответа: для каждой
// таблицы строка шапки и строки данных, между таблицами пустая строка.
// Оформление общее: тонкая сетка, заливка шапки, «зебра» строк, автоподбор ширины.
//
// Параметры:
//  Таблицы - Массив из Структура - результат СИ_МаркдаунHTML.ИзвлечьТаблицыMarkdown.
//
// Возвращаемое значение:
//  ТабличныйДокумент - готовый документ для просмотра.
//@skip-check new-color
//@skip-check new-font
&НаСервереБезКонтекста
Функция ПостроитьТабличныйДокумент(Таблицы)

	ТабличныйДокумент = Новый ТабличныйДокумент;

	ЛинияГраницы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	ЦветШапки = Новый Цвет(215, 228, 252);
	ЦветЗебры = Новый Цвет(245, 248, 253);
	ЦветРамки = Новый Цвет(160, 176, 205);

	ШиринаТаблицы = 0;
	Для Каждого Таблица Из Таблицы Цикл
		ШиринаТаблицы = Макс(ШиринаТаблицы, Таблица.Шапка.Количество());
	КонецЦикла;
	МаксимальныеДлины = Новый Массив;
	Для ИндексКолонки = 1 По ШиринаТаблицы Цикл
		МаксимальныеДлины.Добавить(0);
	КонецЦикла;

	НомерСтрокиТаблицы = 1;
	ПервыйДокумент = Истина;
	Для Каждого Таблица Из Таблицы Цикл

		Если НЕ ПервыйДокумент Тогда
			НомерСтрокиТаблицы = НомерСтрокиТаблицы + 1;
		КонецЕсли;
		ПервыйДокумент = Ложь;

		Шапка = ТабличныйДокумент.Область(НомерСтрокиТаблицы, 1, НомерСтрокиТаблицы, ШиринаТаблицы);
		Шапка.ЦветФона = ЦветШапки;
		Шапка.ЦветРамки = ЦветРамки;
		
		Шапка.Шрифт = Новый Шрифт(, , Истина);
		Шапка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Шапка.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
		Для ИндексКолонки = 1 По Таблица.Шапка.Количество() Цикл
			ТекстШапки = Строка(Таблица.Шапка[ИндексКолонки - 1]);
			ЯчейкаШапки = ТабличныйДокумент.Область(НомерСтрокиТаблицы, ИндексКолонки,
				НомерСтрокиТаблицы, ИндексКолонки);
			ЯчейкаШапки.Текст = ТекстШапки;
			ЯчейкаШапки.Обвести(ЛинияГраницы, ЛинияГраницы, ЛинияГраницы, ЛинияГраницы);
			Если СтрДлина(ТекстШапки) > МаксимальныеДлины[ИндексКолонки - 1] Тогда
				МаксимальныеДлины[ИндексКолонки - 1] = СтрДлина(ТекстШапки);
			КонецЕсли;
		КонецЦикла;

		НомерСтрокиТаблицы = НомерСтрокиТаблицы + 1;

		Четная = Ложь;
		Для Каждого СтрокаДанных Из Таблица.Строки Цикл
			ЦветСтроки = ?(Четная, Новый Цвет(255, 255, 255), ЦветЗебры);
			Четная = НЕ Четная;
			ЯчейкиСтроки = СтрокаДанных.Ячейки;
			Для ИндексКолонки = 1 По ШиринаТаблицы Цикл
				ЗначениеЯчейки = "";
				Если ИндексКолонки <= ЯчейкиСтроки.Количество() Тогда
					ЗначениеЯчейки = Строка(ЯчейкиСтроки[ИндексКолонки - 1]);
				КонецЕсли;

				Ячейка = ТабличныйДокумент.Область(НомерСтрокиТаблицы, ИндексКолонки,
					НомерСтрокиТаблицы, ИндексКолонки);
				Ячейка.Текст = ЗначениеЯчейки;
				Ячейка.ЦветФона = ЦветСтроки;
				Ячейка.ЦветРамки = ЦветРамки;
				Ячейка.Обвести(ЛинияГраницы, ЛинияГраницы, ЛинияГраницы, ЛинияГраницы);
				Ячейка.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
				Ячейка.ГоризонтальноеПоложение = ?(ЭтоЧисловаяЯчейка(ЗначениеЯчейки),
					ГоризонтальноеПоложение.Право, ГоризонтальноеПоложение.Лево);

				Если СтрДлина(ЗначениеЯчейки) > МаксимальныеДлины[ИндексКолонки - 1] Тогда
					МаксимальныеДлины[ИндексКолонки - 1] = СтрДлина(ЗначениеЯчейки);
				КонецЕсли;
			КонецЦикла;
			НомерСтрокиТаблицы = НомерСтрокиТаблицы + 1;
		КонецЦикла;

	КонецЦикла;

	Для ИндексКолонки = 1 По ШиринаТаблицы Цикл
		ШиринаМм = Цел(МаксимальныеДлины[ИндексКолонки - 1] * 2) + 6;
		Если ШиринаМм < 12 Тогда
			ШиринаМм = 12;
		ИначеЕсли ШиринаМм > 140 Тогда
			ШиринаМм = 140;
		КонецЕсли;
		ТабличныйДокумент.Область(1, ИндексКолонки, 1, ИндексКолонки).ШиринаКолонки = ШиринаМм;
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

// Признак числовой ячейки для выравнивания в табличном документе. Нужен потому,
// что ячейки ответа приходят строками, а ТипЗнч для них всегда Строка.
// Числом считаем строку из цифр, пробелов и одного десятичного разделителя
// (точка или запятая); минус допускается только первым символом. Так даты
// (07.10.2026, 2026-10-07) и диапазоны (1-2-3) не уезжают вправо как числа.
//
// Параметры:
//  Значение - Строка - текст ячейки.
//
// Возвращаемое значение:
//  Булево - Истина, если текст можно считать числом.
&НаСервереБезКонтекста
Функция ЭтоЧисловаяЯчейка(Знач Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	НачальнаяПозиция = 1;
	Если Лев(Значение, 1) = "-" Тогда
		НачальнаяПозиция = 2;
	КонецЕсли;

	ЕстьЦифра = Ложь;
	РазделителейДробнойЧасти = 0;
	Для Позиция = НачальнаяПозиция По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			ЕстьЦифра = Истина;
		ИначеЕсли Символ = "." ИЛИ Символ = "," Тогда
			РазделителейДробнойЧасти = РазделителейДробнойЧасти + 1;
			Если РазделителейДробнойЧасти > 1 Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли Символ <> " " Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьЦифра;

КонецФункции

// Записывает текст в системный буфер обмена через DOM HTML-поля истории чата.
// Создаёт скрытый textarea, вставляет текст, выделяет его и вызывает execCommand("Copy").
// Клик пользователя по ссылке — активный жест, поэтому команда работает
// и в тонком, и в веб-клиенте.
//@skip-check bsl-legacy-check-dynamic-feature-access
&НаКлиенте
Функция ЗаписатьВБуферОбменаЧерезDOM(Знач Текст)

	Попытка
		ДокументПоля = Элементы.ТекстИстории.Документ;
		Если ДокументПоля = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Тело = ДокументПоля.body;
		Если Тело = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		ТекстовоеПоле = ДокументПоля.createElement("textarea");
		ТекстовоеПоле.value = Текст;
		ТекстовоеПоле.style.position = "fixed";
		ТекстовоеПоле.style.opacity = "0";
		Тело.appendChild(ТекстовоеПоле);

		ТекстовоеПоле.focus();
		ТекстовоеПоле.select();
		Результат = ДокументПоля.execCommand("Copy");
		Тело.removeChild(ТекстовоеПоле);

		Возврат Результат;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Процедура ПрименитьДанныеРежимаНаСервере()
	ПрименитьДанныеРежима();
	
	Если ЗначениеЗаполнено(АктивныйДиалог) И ЗначениеЗаполнено(РежимРаботы) Тогда
		Попытка
			Если СИ_УправлениеДиалогом.ПрименитьРежимКДиалогу(АктивныйДиалог, РежимРаботы) Тогда
				ЗаписьЖурналаРегистрации("ЧатАгента.ПрименитьРежим", УровеньЖурналаРегистрации.Информация, , ,
					"Системный промпт текущего диалога обновлён под режим: " + Строка(РежимРаботы));
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ЧатАгента.ПрименитьРежим", УровеньЖурналаРегистрации.Предупреждение, , ,
				"Ошибка применения режима к текущему диалогу: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

//@skip-check bsl-legacy-check-dynamic-feature-access
&НаКлиенте
Асинх Функция ПрочитатьФайлНаСервереАсинх(АдресФайла, ИмяФайлаКороткое)

	Результат = ПрочитатьФайлНаСервере(АдресФайла);
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		СтатусАгента = Результат;
		Возврат Ложь;
	КонецЕсли;
	
	ДвоичныеДанные = Результат;

	Расширение = НРег(ПолучитьРасширениеФайла(ИмяФайлаКороткое));
	ЭтоКартинка = Расширение = "jpg" ИЛИ Расширение = "jpeg" ИЛИ Расширение = "png"
		ИЛИ Расширение = "gif" ИЛИ Расширение = "bmp" ИЛИ Расширение = "webp";
	ЭтоПDF = (Расширение = "pdf");

	Если НЕ (ЭтоКартинка ИЛИ ЭтоПDF) Тогда
		РасширениеИзСодержимого = НРег(ОпределитьТипФайлаПоСодержимому(ДвоичныеДанные));
		Если НЕ ПустаяСтрока(РасширениеИзСодержимого) Тогда
			Расширение = РасширениеИзСодержимого;
			ЭтоКартинка = Расширение = "jpg" ИЛИ Расширение = "jpeg" ИЛИ Расширение = "png"
				ИЛИ Расширение = "gif" ИЛИ Расширение = "bmp" ИЛИ Расширение = "webp";
			ЭтоПDF = (Расширение = "pdf");
		КонецЕсли;
	КонецЕсли;

	Если ЭтоКартинка ИЛИ ЭтоПDF Тогда
		МаксимальныйРазмерБинарногоФайла = 15000000;
		Если ДвоичныеДанные.Размер() > МаксимальныйРазмерБинарногоФайла Тогда
			СтатусАгента = "Ошибка: Файл слишком большой (" + Формат(ДвоичныеДанные.Размер() / 1024 / 1024, "ЧДЦ=1")
				+ " МБ). Максимальный размер для анализа: 15 МБ.";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		МаксимальныйРазмерФайла = 500000;
		Если ДвоичныеДанные.Размер() > МаксимальныйРазмерФайла Тогда
			СтатусАгента = "Ошибка: Файл слишком большой (" + Формат(ДвоичныеДанные.Размер() / 1024, "ЧДЦ=0")
				+ " КБ). Максимальный размер для анализа: 500 КБ.";
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Если ЭтоКартинка ИЛИ ЭтоПDF Тогда
		Вложение = Новый Структура;
		Вложение.Вставить("ИмяФайла", ИмяФайлаКороткое);
		Вложение.Вставить("Содержимое", "");
		Вложение.Вставить("Адрес", АдресФайла);
		Вложение.Вставить("ТипВложения", ?(ЭтоПDF, "PDF", "Картинка"));
		ДобавитьВложениеВМассив(Вложение);
		СтатусАгента = "Прикреплен файл: " + ИмяФайлаКороткое
			+ ?(ЭтоПDF, " (PDF). Будет распознан vision-моделью. Нажмите «Отправить».", " (изображение). Будет распознано vision-моделью. Нажмите «Отправить».");
		Возврат Истина;
	КонецЕсли;

	ЧтениеДанных = Новый ЧтениеДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Попытка
		
		
		Содержимое = ЖДАТЬ ЧтениеДанных.ПрочитатьСимволыАсинх();
	Исключение
		Попытка
			ЖДАТЬ ЧтениеДанных.ЗакрытьАсинх();
			ЧтениеДанных = Новый ЧтениеДанных(ДвоичныеДанные, КодировкаТекста.ANSI);
			Содержимое = ЖДАТЬ ЧтениеДанных.ПрочитатьСимволыАсинх();
		Исключение
			СтатусАгента = "Ошибка: Не удалось прочитать файл как текст. Поддерживаются текстовые файлы, изображения (jpg/png/gif/bmp/webp) и PDF.";
			
			ЖДАТЬ ЧтениеДанных.ЗакрытьАсинх();
			
			Возврат Ложь;
		КонецПопытки;
	КонецПопытки;
	
	ЖДАТЬ ЧтениеДанных.ЗакрытьАсинх();

	Если ПустаяСтрока(Содержимое) Тогда
		СтатусАгента = "Ошибка: Не удалось прочитать файл как текст. Поддерживаются текстовые файлы, изображения (jpg/png/gif/bmp/webp) и PDF.";
		Возврат Ложь;
	КонецЕсли;

	Вложение = Новый Структура;
	Вложение.Вставить("ИмяФайла", ИмяФайлаКороткое);
	Вложение.Вставить("Содержимое", Содержимое);
	Вложение.Вставить("Адрес", АдресФайла);
	Вложение.Вставить("ТипВложения", "Текст");
	ДобавитьВложениеВМассив(Вложение);
	СтатусАгента = "Прикреплен файл: " + ИмяФайлаКороткое + ". Нажмите «Отправить».";
	
	Возврат Истина;
	
КонецФункции

// Добавляет вложение в клиентский массив ПрикрепленныеВложения.
// При совпадении имени уже прикреплённого файла — заменяет его (повторное
// прикрепление того же файла обновляет содержимое/адрес).
&НаКлиенте
Процедура ДобавитьВложениеВМассив(Вложение)
	
	Если ПрикрепленныеВложения = Неопределено Тогда
		ПрикрепленныеВложения = Новый Массив;
	КонецЕсли;
	
	Для Индекс = 0 По ПрикрепленныеВложения.ВГраница() Цикл
		Если ПрикрепленныеВложения[Индекс].ИмяФайла = Вложение.ИмяФайла Тогда
			ПрикрепленныеВложения[Индекс] = Вложение;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ПрикрепленныеВложения.Добавить(Вложение);
	
КонецПроцедуры

// Очищает клиентский массив вложений (после отправки сообщения).
&НаКлиенте
Процедура ОчиститьВложения()
	ПрикрепленныеВложения = Неопределено;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьФайлНаСервере(Знач АдресФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат "Ошибка: Не удалось прочитать файл.";
	КонецЕсли;
	
	Возврат ДвоичныеДанные;
	
КонецФункции

// Ленивая инициализация и доступ к состояниям заходов.
&НаКлиенте
Функция ПолучитьСостояниеЗахода(УИДиалога)

	Если СостоянияЗаходов = Неопределено Тогда
		СостоянияЗаходов = Новый Соответствие;
	КонецЕсли;

	Состояние = СостоянияЗаходов.Получить(УИДиалога);
	Если Состояние = Неопределено Тогда
		Состояние = Новый Структура;
		Состояние.Вставить("ИдЗадания", "");
		Состояние.Вставить("ПоследнийНомер", 0);
		Состояние.Вставить("ВызовыИнструментов", Новый Массив);
		Состояние.Вставить("Рассуждения", "");
		Состояние.Вставить("ПромежуточныйТекст", "");
		Состояние.Вставить("ЖивыеСтроки", Новый Массив);
		Состояние.Вставить("ТокеныЗаЗаход", 0);
		Состояние.Вставить("ПромптТокеныПоследнейИтерации", 0);
		Состояние.Вставить("ВсегоТокенов", 0);
		Состояние.Вставить("ОкноМоделиЗапрошено", Ложь);
		Состояние.Вставить("ОжиданиеПодключено", Ложь);
		СостоянияЗаходов.Вставить(УИДиалога, Состояние);
	КонецЕсли;

	Возврат Состояние;

КонецФункции

// Подключает обработчик живых уведомлений диалога (best-effort).
//
// Параметры:
//  УИДиалога - Строка - УИД диалога захода.
&НаКлиенте
Процедура ПодключитьЖивойКанал(УИДиалога)

	Попытка
		УведомленияКлиента.ПодключитьОбработчик("СИ_ЧатАгента." + УИДиалога,
			Новый ОписаниеОповещения("ЖивойПакетПолучен", ЭтотОбъект));
	Исключение
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			"ЧатАгента.ЖивойКанал", "Предупреждение",
			"Не удалось подключить обработчик живых уведомлений: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Отключает обработчик живых уведомлений диалога (best-effort).
//
// Параметры:
//  УИДиалога - Строка - УИД диалога захода.
&НаКлиенте
Процедура ОтключитьЖивойКанал(УИДиалога)

	Попытка
		УведомленияКлиента.ОтключитьОбработчик("СИ_ЧатАгента." + УИДиалога);
	Исключение
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			"ЧатАгента.ЖивойКанал", "Информация",
			"Не удалось отключить обработчик уведомлений: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Присоединён ли заход: его живой ход отображается в текущем документе чата.
//
// Параметры:
//  УИДиалога - Строка - УИД диалога захода ("" - проверить факт присоединения).
//
// Возвращаемое значение:
//  Булево - Истина, если заход присоединён (и, при заданном УИДиалога,
//   его диалог открыт в окне).
&НаКлиенте
Функция ЗаходПрисоединён(УИДиалога = "")

	Если НЕ ЗначениеЗаполнено(ЗаходИдДиалога)
		Или ПустаяСтрока(ИдентификаторФоновогоЗадания) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(УИДиалога) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(АктивныйДиалог)
		И ЗаходИдДиалога = АктивныйДиалог
		И Строка(АктивныйДиалог.УникальныйИдентификатор()) = УИДиалога;

КонецФункции

// Отсоединяет присоединённый заход (при переключении чата, создании нового
// диалога): ФЗ НЕ отменяется и продолжает работать, состояние сохраняется
// в СостоянияЗаходов для перезахвата и спасения при аварии.
&НаКлиенте
Процедура ОтсоединитьЗаход()

	Если НЕ ЗначениеЗаполнено(ЗаходИдДиалога) Тогда
		Возврат;
	КонецЕсли;

	УИДиалога = Строка(ЗаходИдДиалога.УникальныйИдентификатор());
	Состояние = ПолучитьСостояниеЗахода(УИДиалога);
	Состояние.ПоследнийНомер = ПоследнийПоказанныйНомерСообщения;
	Состояние.ВызовыИнструментов = ВызовыИнструментовЗахода;
	Состояние.Рассуждения = РассужденияЗахода;
	Состояние.ПромежуточныйТекст = ПромежуточныйТекстЗахода;

	ОтключитьЖивойКанал(УИДиалога);

	ЗаходИдДиалога = Неопределено;
	ТаймерАктивен = Ложь;
	ПоказыватьИндикаторПечати = Ложь;
	ИдентификаторФоновогоЗадания = "";

КонецПроцедуры

// Присоединяет заход диалога к живому каналу: подключает обработчик
// уведомлений, восстанавливает состояние индикатора и дорисовывает
// кэшированные живые строки (при возврате к ранее отсоединённому заходу).
// Также подключает БСП-оповещение о завершении ФЗ.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  ИдЗадания - Строка - идентификатор живого ФЗ (из АктивноеЗаданиеИд).
&НаКлиенте
Процедура ПрисоединитьЗаход(ИдДиалога, ИдЗадания)

	УИДиалога = Строка(ИдДиалога.УникальныйИдентификатор());
	Состояние = ПолучитьСостояниеЗахода(УИДиалога);
	Состояние.ИдЗадания = ИдЗадания;

	ЗаходИдДиалога = ИдДиалога;
	ИдентификаторФоновогоЗадания = ИдЗадания;
	ТаймерАктивен = Истина;
	ФинализацияВыполнена = Ложь;
	ВремяСтарта = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПоказыватьИндикаторПечати = Истина;
	Элементы.КомандаПрерватьДиалог.Доступность = Истина;

	Если Состояние.ПоследнийНомер = 0 Тогда
		Состояние.ПоследнийНомер = ПоследнийПоказанныйНомерСообщения;
	Иначе
		ПоследнийПоказанныйНомерСообщения = Состояние.ПоследнийНомер;
	КонецЕсли;
	ВызовыИнструментовЗахода = Состояние.ВызовыИнструментов;
	РассужденияЗахода = Состояние.Рассуждения;
	ПромежуточныйТекстЗахода = Состояние.ПромежуточныйТекст;

	ПодключитьЖивойКанал(УИДиалога);

	Попытка
		ОбновитьЖивойИндикатор();
		Если Состояние.ЖивыеСтроки.Количество() > 0 Тогда
			ПрименитьДельтуЖивыхСообщений(Состояние.ЖивыеСтроки, Состояние.ПоследнийНомер);
		КонецЕсли;
	Исключение
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			"ЧатАгента.ЖивойКанал", "Предупреждение",
			"Ошибка дорисовки живого хода при перезахвате: " + ОписаниеОшибки());
	КонецПопытки;

	Если НЕ Состояние.ОжиданиеПодключено Тогда
		Состояние.ОжиданиеПодключено = Истина;
		Операция = Новый Структура;
		Операция.Вставить("Статус", "Выполняется");
		Операция.Вставить("ИдентификаторЗадания", Новый УникальныйИдентификатор(ИдЗадания));
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ПараметрыОжидания.ВыводитьСообщения = Ложь;
		ПараметрыОжидания.ОтменятьПриЗакрытииФормыВладельца = Ложь;
		ОповещениеОЗавершении = Новый ОписаниеОповещения("АгентЗаданиеЗавершено", ЭтотОбъект, УИДиалога);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, ОповещениеОЗавершении, ПараметрыОжидания);
	КонецЕсли;

КонецПроцедуры

// Обработчик живых уведомлений (МенеджерУведомленийКлиента). Данные - пакет
// из ядра: {ИдДиалогаУИД, Сообщения} - сообщения захода с номерами. Для
// присоединённого захода дельта отрисовывается (ПрименитьДельтуЖивыхСообщений),
// для отсоединённого - копится в клиентский буфер ЖивыеСтроки.
//
// Параметры:
//  Данные - Структура - {ИдДиалогаУИД - Строка, Сообщения - Массив из Структура}.
//  ДополнительныеПараметры - Неопределено - обработчик подключается без них.
&НаКлиенте
Процедура ЖивойПакетПолучен(Данные, ДополнительныеПараметры) Экспорт

	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	УИДиалога = "";
	Если НЕ Данные.Свойство("ИдДиалогаУИД", УИДиалога) Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(УИДиалога) Тогда
		Возврат;
	КонецЕсли;

	Состояние = СостоянияЗаходов.Получить(УИДиалога);
	Если Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показывать = ЗаходПрисоединён(УИДиалога);
	НовыеСтроки = Новый Массив;
	МаксНомер = Состояние.ПоследнийНомер;

	Для Каждого Сообщение Из Данные.Сообщения Цикл
		Номер = Число(Сообщение.НомерСообщения);
		Если Номер <= Состояние.ПоследнийНомер Тогда
			Продолжить;
		КонецЕсли;
		Состояние.ЖивыеСтроки.Добавить(Сообщение);
		Если Состояние.ЖивыеСтроки.Количество() > 1000 Тогда
			Состояние.ЖивыеСтроки.Удалить(0);
		КонецЕсли;
		Если Номер > МаксНомер Тогда
			МаксНомер = Номер;
		КонецЕсли;
		Если Показывать Тогда
			НовыеСтроки.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;

	Состояние.ПоследнийНомер = МаксНомер;

	ТокеныПакета = 0;
	ПромптТокеныПакета = 0;
	Данные.Свойство("ТокеныЗаЗаход", ТокеныПакета);
	Данные.Свойство("ПромптТокеныПоследнейИтерации", ПромптТокеныПакета);
	Состояние.ТокеныЗаЗаход = ТокеныПакета;
	Состояние.ПромптТокеныПоследнейИтерации = ПромптТокеныПакета;

	Если НовыеСтроки.Количество() > 0 Тогда
		Попытка
			ДобавленоСообщений = ПрименитьДельтуЖивыхСообщений(НовыеСтроки, МаксНомер);
			ОбновитьСтатусОжидания(ДобавленоСообщений);
		Исключение
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				"ЧатАгента.ЖивойКанал", "Предупреждение",
				"Ошибка применения живой дельты: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Если Показывать Тогда
		ОбновитьТекстТокеновЖивогоЗахода(Состояние);
	КонецЕсли;

КонецПроцедуры

// Живой прогресс токенов присоединённого захода: обновляется ТОЛЬКО надпись
// ПолеТокенов (реквизит ТекстТокенов) - перерисовка HTML не нужна. Кэш
// справочника диалога (ПотраченоТокенов) складывается с расходом текущего
// захода; окно модели запрашивается однократно за заход и кэшируется
// в состоянии захода (ВсегоТокенов).
//
// Параметры:
//  Состояние - Структура - состояние захода из СостоянияЗаходов.
&НаКлиенте
Процедура ОбновитьТекстТокеновЖивогоЗахода(Состояние)

	Если Состояние.ТокеныЗаЗаход <= 0 И Состояние.ПромптТокеныПоследнейИтерации <= 0 Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Состояние.ОкноМоделиЗапрошено Тогда
		Состояние.ОкноМоделиЗапрошено = Истина;
		Состояние.ВсегоТокенов = ПолучитьОкноМоделиДляФормы(ИмяМодели, ПрофильПодключения);
	КонецЕсли;

	ТекстТокенов = СтрШаблон("Израсходовано: %1 | История: %2%3",
		Формат(ПотраченоТокенов + Состояние.ТокеныЗаЗаход, "ЧГ="),
		Формат(Состояние.ПромптТокеныПоследнейИтерации, "ЧГ="),
		?(Состояние.ВсегоТокенов > 0, " / " + Формат(Состояние.ВсегоТокенов, "ЧГ="), ""));

КонецПроцедуры

// Окно модели для живого счётчика токенов - из профиля модели, тот же
// источник, что у ядра (СИ_НастройкиАгента). Безконтекстный вызов: клиент
// запрашивает его однократно за заход (кэш в состоянии захода).
//
// Параметры:
//   ИмяМодели          - Строка - имя модели текущего режима.
//   ПрофильПодключения - Строка - профиль подключения текущего режима.
//
// Возвращаемое значение:
//   Число - размер контекстного окна модели; 0 - определить не удалось.
&НаСервереБезКонтекста
Функция ПолучитьОкноМоделиДляФормы(ИмяМодели, ПрофильПодключения)

	ОкноМодели = 0;
	Попытка
		ПрофильМоделиФормы = СИ_НастройкиАгента.ПолучитьПрофильМодели(ИмяМодели, ПрофильПодключения);
		ОкноМодели = Число(СИ_РаботаСJSON.БезопасноПолучить(ПрофильМоделиФормы, "КонтекстОкно", 0));
	Исключение
		ОкноМодели = 0;
	КонецПопытки;

	Возврат ОкноМодели;

КонецФункции

// Спасает живые строки захода из клиентского буфера в регистр (вызов на сервере).
// Вызывается при аварийном завершении ФЗ: сообщения, доставленные живыми
// уведомлениями, дописываются в регистр по их номерам.
//
// Параметры:
//  УИДиалога - Строка - УИД диалога захода.
&НаКлиенте
Процедура СпасениеЖивыхСтрокНаСервере(УИДиалога)

	Если СостоянияЗаходов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние = СостоянияЗаходов.Получить(УИДиалога);
	Если Состояние = Неопределено
		Или Состояние.ЖивыеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СпастиЖивыеСообщенияНаСервере(УИДиалога, Состояние.ЖивыеСтроки);
	Исключение
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			"ЧатАгента.Спасение", "Предупреждение",
			"Ошибка спасения живых сообщений: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Серверная часть спасения живых строк (безконтекстный вызов).
//
// Параметры:
//  УИДиалога - Строка - УИД диалога захода.
//  Сообщения - Массив из Структура - элементы живого пакета (с НомерСообщения).
&НаСервереБезКонтекста
Процедура СпастиЖивыеСообщенияНаСервере(Знач УИДиалога, Знач Сообщения)

	Попытка
		ИдДиалога = Справочники.СИ_ДиалогиАгента.ПолучитьСсылку(
			Новый УникальныйИдентификатор(УИДиалога));
		СИ_УправлениеДиалогом.СпастиЖивыеСообщения(ИдДиалога, Сообщения);
	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.Спасение", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ошибка серверной части спасения живых сообщений: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Очищает реквизит диалога АктивноеЗаданиеИд по УИД (безконтекстный вызов).
// Вызывается из тихой финализации отсоединённого захода.
//
// Параметры:
//  УИДиалога - Строка - УИД диалога.
&НаСервереБезКонтекста
Процедура ОчиститьАктивноеЗаданиеНаСервере(Знач УИДиалога)

	Попытка
		ИдДиалога = Справочники.СИ_ДиалогиАгента.ПолучитьСсылку(
			Новый УникальныйИдентификатор(УИДиалога));
		СИ_УправлениеДиалогом.ОчиститьАктивноеЗадание(ИдДиалога);
	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.ЖивойКанал", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ошибка очистки АктивноеЗаданиеИд при тихой финализации: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Проверяет перезахват диалога: возвращает ИД живого фонового задания
// из реквизита АктивноеЗаданиеИд (мёртвое задание лениво очищается).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//
// Возвращаемое значение:
//  Строка - ИД живого задания; "" - живого запуска нет.
&НаСервереБезКонтекста
Функция ПроверитьПерезахватНаСервере(Знач ИдДиалога)

	Возврат СИ_УправлениеДиалогом.ИдАктивногоЗадания(ИдДиалога);

КонецФункции

// Оповещение ДлительныеОперацииКлиент о завершении фонового задания агента.
// Заход идентифицируется по ДополнительныеПараметры (УИД диалога, переданный
// при подключении оповещения): запуски могут идти параллельно по нескольким
// диалогам. Для присоединённого захода (его ход отображается в документе) -
// штатная/аварийная финализация с отрисовкой; для отсоединённого (заход
// другого диалога, оставленного работать в фоне) - тихая финализация без DOM:
// при аварии живые строки спасаются из клиентского буфера, реквизит
// АктивноеЗаданиеИд диалога очищается.
// Результат = Неопределено - задание отменено (кнопка «Прервать», закрытие
// формы или отмена платформой).
// ВАЖНО: серверная финализация не трогает Элементы формы - после неё
// клиент обязан вызвать РазблокироватьИнтерфейс() (кнопки/флаг).
//
// Параметры:
//   Результат - Структура - результат длительной операции (НовыйРезультатДлительнойОперации);
//   Неопределено - задание отменено.
//   ДополнительныеПараметры - Строка - УИД диалога завершившегося захода.
&НаКлиенте
Процедура АгентЗаданиеЗавершено(Результат, ДополнительныеПараметры) Экспорт

	УИДиалога = "";
	Если ДополнительныеПараметры <> Неопределено Тогда
		УИДиалога = Строка(ДополнительныеПараметры);
	КонецЕсли;

	Если НЕ ЗаходПрисоединён(УИДиалога) Тогда
		Если Результат <> Неопределено И Результат.Статус = "Ошибка" Тогда
			СпасениеЖивыхСтрокНаСервере(УИДиалога);
		КонецЕсли;
		ОчиститьАктивноеЗаданиеНаСервере(УИДиалога);
		Если СостоянияЗаходов <> Неопределено Тогда
			СостоянияЗаходов.Удалить(УИДиалога);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ФинализацияВыполнена ИЛИ ПустаяСтрока(ИдентификаторФоновогоЗадания) Тогда
		Возврат;
	КонецЕсли;

	Если Результат = Неопределено Тогда
		ФинализацияВыполнена = Истина;
		Попытка
			ПрерватьОжиданиеНаСервере();
		Исключение
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				"ЧатАгента.Прерывание", "Предупреждение",
				"Ошибка обработки внешней отмены задания: " + ОписаниеОшибки());
		КонецПопытки;
		РазблокироватьИнтерфейс();
		Возврат;
	КонецЕсли;

	ФинализацияВыполнена = Истина;

	Если Результат.Статус = "Ошибка" Тогда
		Попытка
			СпасениеЖивыхСтрокНаСервере(УИДиалога);
			ОбработатьАварийноеЗавершениеНаСервере();
		Исключение
			СтатусАгента = "Ошибка: " + ОписаниеОшибки();
		КонецПопытки;
		РазблокироватьИнтерфейс();
		Возврат;
	КонецЕсли;

	Попытка
		ЗавершитьЗаход();
	Исключение
		СтатусАгента = "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;
	РазблокироватьИнтерфейс();

КонецПроцедуры

// Финализация захода на клиенте.
//
// При доступном JS-мосте документ не пересоздаётся: сервер заново отрисовывает
// последний ответ хода уже с погашенным индикатором печати (появляются кнопка
// «В таблицу» и вопрос с вариантами), клиент подменяет этот пузырь и снимает
// индикатор. Благодаря этому сохраняются позиция прокрутки, развёрнутые блоки
// «Рассуждения модели» и время, которое пользователь видел в живом чате.
//
// Без моста, при сбое сервера, при сбое подмены пузыря и при расхождении
// нумерации буфера с регистром - полная перечитка истории, как раньше: тогда
// время в пузырях берётся из регистра (момент пакетной записи хода в БД) и
// отличается от времени, которое было видно в живом чате. Поэтому путь
// финализации пишется в журнал: по записи видно, почему выбрана перечитка.
&НаКлиенте
Процедура ЗавершитьЗаход()

	Если НЕ МостДоступен Тогда
		ЗаписатьПричинуПеречитки("мост HTML недоступен");
		ЗагрузитьРезультатФоновогоЗадания();
		Возврат;
	КонецЕсли;

	РезультатЗахода = Неопределено;
	ПричинаСбоя = "";
	Попытка
		РезультатЗахода = ЗавершитьЗаходНаСервере(Ложь);
	Исключение
		ПричинаСбоя = ОписаниеОшибки();
		РезультатЗахода = Неопределено;
	КонецПопытки;

	Если РезультатЗахода = Неопределено Тогда
		ЗаписатьПричинуПеречитки("сбой финализации на сервере"
			+ ?(ПричинаСбоя = "", "", ": " + ПричинаСбоя));
		ЗагрузитьРезультатФоновогоЗадания();
		Возврат;
	КонецЕсли;

	Если РезультатЗахода.ТребуетсяПерерисовка Тогда
		ЗаписатьПричинуПеречитки("финализация сорвалась на сервере");
		ЗагрузитьРезультатФоновогоЗадания();
		Возврат;
	КонецЕсли;

	Если РезультатЗахода.ДокументПерерисован Тогда
		ЗаписатьПричинуПеречитки("нумерация сообщений разошлась с регистром: "
			+ ?(РезультатЗахода.РасхождениеНомеров = "", "(без деталей)", РезультатЗахода.РасхождениеНомеров));
		Возврат;
	КонецЕсли;

	ПрименитьТочечноеОбновлениеОтвета(РезультатЗахода);

КонецПроцедуры

// Пишет в журнал, почему финализация пошла по пути полной перечитки истории.
// Нужна для диагностики: перечитка меняет время в пузырях (берёт его из
// регистра, то есть момент пакетной записи хода в БД), и без этой записи
// такой симптом неотличим от точечного обновления.
//
// Параметры:
//  Причина - Строка - что привело к полной перечитке.
&НаКлиенте
Процедура ЗаписатьПричинуПеречитки(Знач Причина)

	ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
		"ЧатАгента.Финализация", "Информация",
		"Финализация захода по пути полной перечитки истории. Причина: " + Причина);

КонецПроцедуры

// Применяет точечное обновление последнего ответа к документу чата.
//
// Параметры:
//  РезультатЗахода - Структура - описание от ЗавершитьЗаходНаСервере.
&НаКлиенте
Процедура ПрименитьТочечноеОбновлениеОтвета(Знач РезультатЗахода)

	Если РезультатЗахода.НуженТочечныйРендер Тогда

		Ответ = "notfound";
		Попытка
			Ответ = ОкноHTML.siReplaceBubble(
				Формат(РезультатЗахода.НомерСообщения, "ЧДЦ=0; ЧГ=0"), РезультатЗахода.HTML);
		Исключение
			Ответ = "notfound";
		КонецПопытки;

		Если Ответ <> "ok" Тогда
			МостДоступен = Ложь;
			ОкноHTML = Неопределено;
			ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
				"ЧатАгента.МостHTML", "Предупреждение",
				"Точечная замена пузыря не удалась, история перечитывается из регистра");
			ЗагрузитьРезультатФоновогоЗадания();
			Возврат;
		КонецЕсли;

		ВариантыВопросов.Очистить();
		Если РезультатЗахода.ВариантыВопроса <> Неопределено Тогда
			МассивВариантовДляКэша = РезультатЗахода.ВариантыВопроса.Варианты;
			Для ИндексВарианта = 0 По МассивВариантовДляКэша.Количество() - 1 Цикл
				СтрокаВариантаКэша = ВариантыВопросов.Добавить();
				СтрокаВариантаКэша.НомерСообщения = РезультатЗахода.ВариантыВопроса.НомерСообщения;
				СтрокаВариантаКэша.Индекс = ИндексВарианта;
				СтрокаВариантаКэша.Текст = МассивВариантовДляКэша[ИндексВарианта];
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;

	Попытка
		ОкноHTML.siSetPrintingOff();
	Исключение
		ОкноHTML = Неопределено;
		МостДоступен = Ложь;
	КонецПопытки;

КонецПроцедуры

// Применяет дельту живых сообщений пакета ВХ к таблице истории (клиентская
// часть тика) и дописывает их в документ чата. Фильтры: user/system не
// показываются; assistant с пустым контентом пузыря не создаёт независимо
// от режима и наличия рассуждений (рассуждения из assistant-дельт уходят
// в живой индикатор «Думаю»). Документ трогаем ТОЛЬКО при фактическом
// добавлении сообщений: пустые тики не делают ничего.
&НаКлиенте
Функция ПрименитьДельтуЖивыхСообщений(Дельта, СледующийНомер)

	ДобавленоСообщений = 0;
	СписокИнструментовОбновлён = Ложь;
	РассужденияОбновлены = Ложь;
	ПромежуточныйТекстОбновлён = Ложь;
	НовыеСтроки = Новый Массив;

	Для Каждого Сообщение Из Дельта Цикл

		РольСообщения = Сообщение.Роль;

		Если РольСообщения = "user" ИЛИ РольСообщения = "system" Тогда
			Продолжить;
		КонецЕсли;

		РассужденияСообщения = Сообщение.Рассуждения;

		Если РольСообщения = "assistant" И НЕ ПустаяСтрока(РассужденияСообщения) Тогда
			РассужденияЗахода = РассужденияСообщения;
			РассужденияОбновлены = Истина;
		КонецЕсли;

		Если РольСообщения = "assistant" Тогда
			Если ЭтоПромежуточноеСообщениеАссистента(Сообщение) Тогда
				Если НЕ ПустаяСтрока(Сообщение.Контент) Тогда
					ПромежуточныйТекстЗахода = Сообщение.Контент;
					ПромежуточныйТекстОбновлён = Истина;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(Сообщение.Контент) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		СтрокаСообщения = ИсторияСообщений.Добавить();
		СтрокаСообщения.Роль = РольСообщения;
		СтрокаСообщения.Контент = Сообщение.Контент;
		СтрокаСообщения.Время = Сообщение.Время;
		СтрокаСообщения.Рассуждения = РассужденияСообщения;
		СтрокаСообщения.НомерСообщения = Сообщение.НомерСообщения;

		Если РольСообщения = "tool" Тогда
			ДействиеВызова = "";
			Если Сообщение.Свойство("Действие") Тогда
				ДействиеВызова = Сообщение.Действие;
			КонецЕсли;
			ЗапомнитьВызовИнструмента(РассужденияСообщения, ДействиеВызова, Сообщение.УспехИсполнения);
			СписокИнструментовОбновлён = Истина;
		Иначе
			НоваяСтрока = Новый Структура;
			НоваяСтрока.Вставить("Роль", РольСообщения);
			НоваяСтрока.Вставить("Контент", СтрокаСообщения.Контент);
			НоваяСтрока.Вставить("Время", СтрокаСообщения.Время);
			НоваяСтрока.Вставить("Рассуждения", РассужденияСообщения);
			НоваяСтрока.Вставить("НомерСообщения", СтрокаСообщения.НомерСообщения);
			НоваяСтрока.Вставить("СсылкиДокументов", Сообщение.СсылкиДокументов);
			НовыеСтроки.Добавить(НоваяСтрока);
		КонецЕсли;

		ДобавленоСообщений = ДобавленоСообщений + 1;

	КонецЦикла;

	ПоследнийПоказанныйНомерСообщения = Макс(ПоследнийПоказанныйНомерСообщения, СледующийНомер);

	Если ДобавленоСообщений > 0 Тогда
		ДописатьНовыеСообщения(НовыеСтроки);
	КонецЕсли;

	Если СписокИнструментовОбновлён ИЛИ РассужденияОбновлены ИЛИ ПромежуточныйТекстОбновлён Тогда
		ОбновитьЖивойИндикатор();
	КонецЕсли;

	Возврат ДобавленоСообщений;

КонецФункции

// Признак промежуточного assistant-сообщения: модель вызывает инструменты
// В ТОМ ЖЕ сообщении, где дала реплику. Итерация без вызовов инструментов
// завершает ход, поэтому assistant без них - финальный ответ. Формат вызовов
// зависит от источника: живые дельты несут ВызовыИнструментовJSON (строка),
// сообщения из регистра - ВызовыИнструментов (массив).
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПромежуточноеСообщениеАссистента(Сообщение)

	Роль = "";
	Если НЕ Сообщение.Свойство("Роль", Роль) ИЛИ Роль <> "assistant" Тогда
		Возврат Ложь;
	КонецЕсли;

	ВызовыJSON = "";
	Если Сообщение.Свойство("ВызовыИнструментовJSON", ВызовыJSON)
		И НЕ ПустаяСтрока(ВызовыJSON) Тогда
		Возврат Истина;
	КонецЕсли;

	Вызовы = Неопределено;
	Если Сообщение.Свойство("ВызовыИнструментов", Вызовы) Тогда
		Возврат ТипЗнч(Вызовы) = Тип("Массив") И Вызовы.Количество() > 0;
	КонецЕсли;

	Возврат Ложь;

КонецФункции
// Запоминает вызов инструмента в списке текущего захода (для строки живого
// индикатора). Имена уникальны: повторный вызов того же инструмента занимает
// первое место в списке; если тот же инструмент позже завершился ошибкой,
// пометка распространяется на его имя (успех обратно не «обеляется»).
&НаКлиенте
Процедура ЗапомнитьВызовИнструмента(Знач ИмяИнструмента, Знач Действие, Знач Успех)

	Если ПустаяСтрока(ИмяИнструмента) Тогда
		Возврат;
	КонецЕсли;

	Если ВызовыИнструментовЗахода = Неопределено Тогда
		ВызовыИнструментовЗахода = Новый Массив;
	КонецЕсли;

	Для Каждого Вызов Из ВызовыИнструментовЗахода Цикл
		Если Вызов.Имя = ИмяИнструмента Тогда
			Если НЕ Успех Тогда
				Вызов.Успех = Ложь;
			КонецЕсли;
			ДействиеВызова = "";
			Если Вызов.Свойство("Действие") Тогда
				ДействиеВызова = СокрЛП(Строка(Вызов.Действие));
			КонецЕсли;
			Если ПустаяСтрока(ДействиеВызова) И НЕ ПустаяСтрока(Действие) Тогда
				Вызов.Вставить("Действие", Действие);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызовыИнструментовЗахода.Добавить(Новый Структура("Имя, Действие, Успех",
		ИмяИнструмента, Действие, Успех));

КонецПроцедуры
// Перерисовывает живой индикатор (пузырь «Думаю» / строка «Инструменты: …»)
// НА МЕСТЕ: новых блоков в документ не добавляется, содержимое узла siPrinting
// заменяется целиком. Основной путь - JS-мост (siSetLive). Резервный (моста
// нет) - замена блока индикатора прямо в строке реквизита ТекстИстории:
// границы блока детерминированы (открывающий тег <div id="siPrinting"> до
// якоря chatBottom), поэтому кэшировать прежнюю строку не нужно.
&НаКлиенте
Процедура ОбновитьЖивойИндикатор()

	Если НЕ ПоказыватьИндикаторПечати Тогда
		Возврат;
	КонецЕсли;

	СодержимоеHTML = СобратьHTMLЖивогоИндикатора(ВызовыИнструментовЗахода, РассужденияЗахода, ПромежуточныйТекстЗахода, ТемнаяТема);

	Если МостДоступен Тогда
		ОтветМоста = "";
		Попытка
			ОтветМоста = ОкноHTML.siSetLive(СодержимоеHTML);
		Исключение
			ОтветМоста = "notfound";
		КонецПопытки;
		Если ОтветМоста = "ok" Тогда
			Попытка
				Если ОкноHTML.siChatAtBottom() = Истина Тогда
					ПрокрутитьВнизНепосредственно();
				КонецЕсли;
			Исключение
				ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
					"ЧатАгента.МостHTML", "Информация",
					"Не удалось прокрутить чат после обновления живого индикатора: "
						+ ОписаниеОшибки());
			КонецПопытки;
			Возврат;
		КонецЕсли;
		ОкноHTML = Неопределено;
		МостДоступен = Ложь;
		ОбновитьТекстИстории(, ВызовыИнструментовЗахода, РассужденияЗахода, ПромежуточныйТекстЗахода);
		Возврат;
	КонецЕсли;

	ПозицияИндикатора = СтрНайти(ТекстИстории, "<div id=""siPrinting"">");
	ПозицияЯкоря = 0;
	Если ПозицияИндикатора > 0 Тогда
		ПозицияЯкоря = СтрНайти(ТекстИстории, "<a name=""chatBottom""", , ПозицияИндикатора);
	КонецЕсли;
	Если ПозицияИндикатора = 0 ИЛИ ПозицияЯкоря = 0 Тогда
		ОбновитьТекстИстории(, ВызовыИнструментовЗахода, РассужденияЗахода, ПромежуточныйТекстЗахода);
		Возврат;
	КонецЕсли;

	НовыйИндикатор = "<div id=""siPrinting"">" + СодержимоеHTML + "</div>";
	ТекстИстории = Лев(ТекстИстории, ПозицияИндикатора - 1) + НовыйИндикатор
		+ Сред(ТекстИстории, ПозицияЯкоря);
	ПозицияХвостаHTML = ПозицияИндикатора;

КонецПроцедуры
// Содержимое живого индикатора для обновления на месте. Безконтекстная:
// вызывается с клиента (ОбновитьЖивойИндикатор), где реквизиты формы
// недоступны напрямую, поэтому вызовы инструментов, рассуждения,
// промежуточная реплика захода и тема оформления передаются параметрами.
&НаСервереБезКонтекста
Функция СобратьHTMLЖивогоИндикатора(Знач ВызовыИнструментов, Знач Рассуждения, Знач ПромежуточныйТекст = "", Знач ТемнаяТема = Ложь)

	Возврат СИ_ЧатHTMLСервер.ПолучитьИндикаторПечатиHTML(ВызовыИнструментов, Рассуждения, ПромежуточныйТекст, ТемнаяТема);

КонецФункции

// Дописывает новые сообщения в документ истории чата двумя путями.
//
// Основной - через JS-мост (ОкноHTML.siAppend): функция страницы вставляет
// готовый фрагмент перед индикатором печати (или якорем chatBottom), документ
// при этом не пересоздаётся. Благодаря этому стоимость тика перестаёт зависеть
// от длины диалога: сервер рендерит и передаёт только новые строки.
//
// Резервный - дописыванием строки реквизита. Работает, когда мост недоступен:
// серверная часть та же, документ перерисовывается платформой целиком, но
// без повторного рендера и передачи всей истории.
&НаКлиенте
Процедура ДописатьНовыеСообщения(Знач Строки)

	ЗапомнитьСсылкиДокументовНаСервере(Строки);
	ЗапомнитьДиаграммыНаСервере(Строки);

	ОтрисовкаДельты = СобратьHTMLЖивыхСообщений(Строки, ТемнаяТема);
	ДельтаHTML = ОтрисовкаДельты.HTML;
	Если ПустаяСтрока(ДельтаHTML) Тогда
		Возврат;
	КонецЕсли;

	ПрименитьВремяКСтрокамИстории(ОтрисовкаДельты.Времена);

	Если МостДоступен Тогда
		ПоложениеПрокрутки = "";
		Попытка
			ПоложениеПрокрутки = ОкноHTML.siAppend(ДельтаHTML);
		Исключение
			ПричинаОшибки = ОписаниеОшибки();
		КонецПопытки;
		Если ПоложениеПрокрутки = "bottom" ИЛИ ПоложениеПрокрутки = "stay" Тогда
			Если ПоложениеПрокрутки = "bottom" Тогда
				ПрокрутитьВнизНепосредственно();
			КонецЕсли;
			ПодтвердитьРаботуМоста(ПоложениеПрокрутки);
			Возврат;
		КонецЕсли;
		ОкноHTML = Неопределено;
		МостДоступен = Ложь;
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			"ЧатАгента.МостHTML", "Предупреждение",
			"Дописывание через JS-мост не удалось, документ перерисовывается целиком. "
			+ ?(ПричинаОшибки = "", "", "Причина: " + ПричинаОшибки));
		ОбновитьТекстИстории(, ВызовыИнструментовЗахода, РассужденияЗахода, ПромежуточныйТекстЗахода);
		Возврат;
	КонецЕсли;

	ДописатьHTMLВИсторию(ДельтаHTML);

КонецПроцедуры

// Раскладывает время, проставленное сервером при отрисовке дельты, по только
// что добавленным строкам таблицы истории. Массив Времена идёт в порядке
// следования переданных на отрисовку строк, а те добавлялись в таблицу
// последними - поэтому начало диапазона считается от конца таблицы.
&НаКлиенте
Процедура ПрименитьВремяКСтрокамИстории(Знач Времена)

	Если Времена = Неопределено ИЛИ Времена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИндексСтроки = ИсторияСообщений.Количество() - Времена.Количество();
	Для Каждого ВремяСтроки Из Времена Цикл
		Если ИндексСтроки >= 0 Тогда
			ИсторияСообщений[ИндексСтроки].Время = ВремяСтроки;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;

КонецПроцедуры
// Резервное дописывание: вставляет фрагмент в строку реквизита ТекстИстории
// перед её «хвостом» - индикатором печати либо якорем chatBottom вместе с
// закрывающими тегами. Хвост вырезается на время вставки и возвращается на
// место, поэтому остаётся последним видимым блоком, как и при полной сборке.
&НаКлиенте
Процедура ДописатьHTMLВИсторию(Знач ДельтаHTML)

	ПозицияХвоста = ПозицияХвостаHTML;
	Если ПозицияХвоста <= 0 Тогда
		ПозицияХвоста = НайтиХвостДокумента(ТекстИстории);
		ПозицияХвостаHTML = ПозицияХвоста;
	КонецЕсли;

	Если ПозицияХвоста <= 0 Тогда
		ОбновитьТекстИстории(, ВызовыИнструментовЗахода, РассужденияЗахода, ПромежуточныйТекстЗахода);
		Возврат;
	КонецЕсли;

	ДлинаДокумента = СтрДлина(ТекстИстории);
	ХвостДокумента = Прав(ТекстИстории, ДлинаДокумента - ПозицияХвоста + 1);
	ТекстИстории = Лев(ТекстИстории, ПозицияХвоста - 1) + ДельтаHTML + ХвостДокумента;
	ПозицияХвостаHTML = ПозицияХвоста + СтрДлина(ДельтаHTML);

КонецПроцедуры

// Фиксирует в журнале, что активен путь отрисовки через JS-мост.
//
// Признак срабатывания - возврат siAppend: скрипт отдаёт 'bottom'/'stay'
// только после того, как вставил узлы в документ, поэтому сам факт вызова
// с таким ответом доказывает, что скрипт исполнился.
//
// Раньше здесь дополнительно читался атрибут body «data-si-appends», который
// скрипт накапливал для независимой проверки, но 1С-обёртка WebKit пользовательские
// атрибуты не отдаёт (то же ограничение, что и с dataset), и значение всегда
// было пустым. Поэтому счётчик из скрипта убран.
//
// Сообщение пишется один раз на форму: по нему видно, какой путь отрисовки
// активен - мост или резервное дописывание строкой.
&НаКлиенте
Процедура ПодтвердитьРаботуМоста(Знач РезультатВызова)

	Если МостРаботаетЛогирован = Истина Тогда
		Возврат;
	КонецЕсли;
	МостРаботаетЛогирован = Истина;

	ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
		"ЧатАгента.МостHTML", "Информация",
		"JS-мост работает: сообщения дописываются в документ без перерисовки. "
		+ "Ответ siAppend = " + РезультатВызова);

КонецПроцедуры

// Позиция начала «хвоста» документа в строке HTML: индикатор печати
// («<div id="siPrinting">»), если он отрисован, иначе якорь chatBottom.
// Возвращает 0, если хвост в документе не найден.
&НаКлиенте
Функция НайтиХвостДокумента(Знач ДокументHTML)

	ПозицияИндикатора = СтрНайти(ДокументHTML, "<div id=""siPrinting"">");
	Если ПозицияИндикатора > 0 Тогда
		Возврат ПозицияИндикатора;
	КонецЕсли;

	Возврат СтрНайти(ДокументHTML, "<a name=""chatBottom""");

КонецФункции

// Статус ожидания при отсутствии новых сообщений: через ~6 с тишины
// показывает, что модель обрабатывает запрос, чтобы отсутствие дельт
// (длинный вызов модели) не выглядело зависанием задания.
&НаКлиенте
Процедура ОбновитьСтатусОжидания(ДобавленоСообщений)

	Если ДобавленоСообщений > 0 Тогда
		СтатусАгента = "Модель отвечает...";
		Возврат;
	КонецЕсли;

	СекундОжидания = Макс(0, Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяСтарта) / 1000));
	Если СекундОжидания >= 6 Тогда
		СтатусАгента = СтрШаблон("Модель обрабатывает запрос… (%1 с)", СекундОжидания);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РазблокироватьИнтерфейс()
	ТаймерАктивен = Ложь;
	ФинализацияВыполнена = Ложь;
	ПоказыватьИндикаторПечати = Ложь;
	ВызовыИнструментовЗахода = Новый Массив;
	РассужденияЗахода = "";
	ПромежуточныйТекстЗахода = "";
	Элементы.КомандаОтправить.Доступность = Истина;
	Элементы.ПолеВвода.Доступность = Истина;
	Элементы.КомандаПрикрепитьФайл.Доступность = Истина;
	Элементы.КомандаПрерватьДиалог.Доступность = Ложь;
	Элементы.КомандаСжать.Доступность = Истина;
	Если ЗначениеЗаполнено(ЗаходИдДиалога) Тогда
		УИДиалога = Строка(ЗаходИдДиалога.УникальныйИдентификатор());
		ОтключитьЖивойКанал(УИДиалога);
		Если СостоянияЗаходов <> Неопределено Тогда
			СостоянияЗаходов.Удалить(УИДиалога);
		КонецЕсли;
	КонецЕсли;
	ЗаходИдДиалога = Неопределено;
	ИдентификаторФоновогоЗадания = "";
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьФоновоеЗаданиеПриЗакрытии()
	Попытка
		ОтменитьФоновоеЗаданиеНаСервере();
	Исключение
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Ошибка при отмене фонового задания: " + ОписаниеОшибки();
		СообщениеПользователю.Сообщить();
	КонецПопытки;
КонецПроцедуры

// Собирает список форм, открытых у пользователя в клиенте, чтобы передать его
// агенту: по нему модель понимает рабочее место пользователя (например, что
// открыта обработка, формирующая опись) и не ищет нужную форму по всей
// конфигурации. Список доступен ТОЛЬКО на клиенте (ПолучитьОкна), поэтому
// собирается здесь и уходит параметром в серверные процедуры запуска захода.
//
// Возвращаемое значение:
//  Массив из Структура - по элементу на каждую открытую форму:
//   * ИмяФормы  - Строка - полное имя формы («Обработка.Опись.Форма.Форма»);
//   * Заголовок - Строка - заголовок окна формы.
&НаКлиенте
Функция СобратьОткрытыеФормы()

	Результат = Новый Массив;

	Попытка
		Для Каждого ОкноКлиента Из ПолучитьОкна() Цикл
			Если ОкноКлиента.НачальнаяСтраница Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ФормаОкна Из ОкноКлиента.Содержимое Цикл
				ОписаниеФормы = ОписаниеОткрытойФормы(ФормаОкна, ОкноКлиента.Заголовок);
				Если ОписаниеФормы <> Неопределено Тогда
					Результат.Добавить(ОписаниеФормы);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Результат = Новый Массив;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Описывает одну открытую форму для передачи агенту.
//
// Параметры:
//  ФормаОкна - ФормаКлиентскогоПриложения,Форма - содержимое окна клиентского приложения;
//  ЗаголовокОкна - Строка - заголовок окна, в котором открыта форма.
//
// Возвращаемое значение:
//  Структура,Неопределено - ИмяФормы и Заголовок; Неопределено, если форму
//  описать нельзя (в окне может быть обычная форма или документ без имени формы).
&НаКлиенте
Функция ОписаниеОткрытойФормы(ФормаОкна, ЗаголовокОкна)

	ИмяОткрытойФормы = "";
	Попытка
		ИмяОткрытойФормы = СокрЛП(Строка(ФормаОкна.ИмяФормы));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	ЗаголовокФормы = СокрЛП(Строка(ЗаголовокОкна));
	Если ПустаяСтрока(ИмяОткрытойФормы) И ПустаяСтрока(ЗаголовокФормы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ИмяФормы", ИмяОткрытойФормы);
	Результат.Вставить("Заголовок", ЗаголовокФормы);
	Возврат Результат;

КонецФункции

// Отправка сообщения агенту: серверный запуск длительной операции БСП +
// подключение живого канала (уведомления МенеджерУведомленийКлиента) и
// обработчика завершения (ДлительныеОперацииКлиент.ОжидатьЗавершение).
// Передаёт на сервер клиентский массив ПрикрепленныеВложения и собранный на
// клиенте список открытых форм (СобратьОткрытыеФормы); вложения очищает
// после успешного запуска.
&НаКлиенте
Процедура ОтправитьСообщениеАгенту()

	ТаймерАктивен = Истина;
	ФинализацияВыполнена = Ложь;
	ВремяСтарта = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Элементы.КомандаПрерватьДиалог.Доступность = Истина;

	ВызовыИнструментовЗахода = Новый Массив;
	РассужденияЗахода = "";
	ПромежуточныйТекстЗахода = "";

	Попытка
		ОтправитьСообщениеАгентуНаСервере(ПрикрепленныеВложения, СобратьОткрытыеФормы());
		ОчиститьВложения();
		ПодключитьОжиданиеЗаходаКлиент();
	Исключение
		РазблокироватьИнтерфейс();
		ПоказатьПредупреждение(, "Ошибка запуска фонового задания: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОтправитьСообщениеАгентуНаСервере(Знач Вложения, Знач ОткрытыеФормы = Неопределено)

	Попытка

		ИнструментыОбзораДляЗапуска = ИнструментыПервогоШагаЗахода;
		ИнструментыПервогоШагаЗахода = Неопределено;

		Если ЗначениеЗаполнено(АктивныйДиалог)
			И СИ_УправлениеДиалогом.ЕстьАктивныйЗапуск(АктивныйДиалог) Тогда
			СтатусАгента = "По этому диалогу уже идёт обработка запроса";
			Возврат;
		КонецЕсли;

		СИ_Агент1С.СнятьОжиданиеРазрешения(АктивныйДиалог, Истина);

		СтрокаСообщения = ИсторияСообщений.Добавить();

		СтрокаСообщения.Роль = "user";
		СтрокаСообщения.Контент = ТекстВвода;
		СтрокаСообщения.Время = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT;");
		ОбновитьТекстИстории();

		ЗапросТекст = ТекстВвода;
		ТекстВвода = "";

		ВложенияДляЗапуска = Новый Массив;
		Если Вложения <> Неопределено И ТипЗнч(Вложения) = Тип("Массив") Тогда
			Для Каждого Вложение Из Вложения Цикл
				
				ОписаниеВложения = Новый Структура;
				ОписаниеВложения.Вставить("ИмяФайла", Строка(Вложение.ИмяФайла));
				ОписаниеВложения.Вставить("ТипВложения", Строка(Вложение.ТипВложения));
				ОписаниеВложения.Вставить("АдресВоВременномХранилище", Строка(Вложение.Адрес));
				Если ОписаниеВложения.ТипВложения = "Картинка" ИЛИ ОписаниеВложения.ТипВложения = "PDF" Тогда
					ОписаниеВложения.Вставить("Содержимое", "");
				Иначе
					ОписаниеВложения.Вставить("Содержимое", Строка(Вложение.Содержимое));
				КонецЕсли;
				ОписаниеВложения.Вставить("СсылкаСохраненногоФайла", Справочники.СИ_ДиалогиАгентаПрисоединенныеФайлы.ПустаяСсылка());
				ВложенияДляЗапуска.Добавить(ОписаниеВложения);
				
			КонецЦикла;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(АктивныйДиалог) Тогда
			ПараметрыДиалога = Новый Структура;
			ПараметрыДиалога.Вставить("Режим", РежимРаботы);
			ПараметрыДиалога.Вставить("Модель", ИмяМодели);
			ПараметрыДиалога.Вставить("Профиль", ПрофильПодключения);
			ПараметрыДиалога.Вставить("СистемныйПромпт", Неопределено);
			ПараметрыДиалога.Вставить("ТекущийПользователь", ТекущийПользователь);
			АктивныйДиалог = СИ_УправлениеДиалогом.СоздатьДиалог(ПараметрыДиалога);
		КонецЕсли;

		Если ВложенияДляЗапуска.Количество() > 0 Тогда
			Для Каждого ОписаниеВложения Из ВложенияДляЗапуска Цикл
				
				АдресДляСохранения = ОписаниеВложения.АдресВоВременномХранилище;
				Если НЕ ПустаяСтрока(АдресДляСохранения) Тогда
					Попытка
						ИмяДляСохранения = ОписаниеВложения.ИмяФайла;
						Если ПустаяСтрока(ИмяДляСохранения) Тогда
							ИмяДляСохранения = "вложение";
						КонецЕсли;
						ОписаниеВложения.СсылкаСохраненногоФайла = СИ_ФайлыДиалога.СохранитьПрикрепленныйФайл(
							АктивныйДиалог, АдресДляСохранения, ИмяДляСохранения);
					Исключение
						ЗаписьЖурналаРегистрации("ЧатАгента.СохранениеФайла", УровеньЖурналаРегистрации.Предупреждение,,
							Неопределено,
							"Ошибка сохранения прикреплённого файла «" + ОписаниеВложения.ИмяФайла + "»: " + ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
				
				ИмяМаркера = ОписаниеВложения.ИмяФайла;
				Если ПустаяСтрока(ИмяМаркера) Тогда
					ИмяМаркера = "файл";
				КонецЕсли;
				СтрокаСообщения.Контент = СтрокаСообщения.Контент
					+ Символы.ПС + "[Вложение: " + ИмяМаркера + "]";
				Если ЗначениеЗаполнено(ОписаниеВложения.СсылкаСохраненногоФайла) Тогда
					СтрокаСообщения.Контент = СтрокаСообщения.Контент + " file:"
						+ Строка(ОписаниеВложения.СсылкаСохраненногоФайла.УникальныйИдентификатор());
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;

		СтатусАгента = "Запуск фонового задания...";

		ПараметрыЗапуска = Новый Структура;
		ПараметрыЗапуска.Вставить("ЗапросПользователя", ЗапросТекст);
		ПараметрыЗапуска.Вставить("Режим", РежимРаботы);
		ПараметрыЗапуска.Вставить("Модель", ИмяМодели);
		ПараметрыЗапуска.Вставить("Профиль", ПрофильПодключения);
		ПараметрыЗапуска.Вставить("ИдДиалога", АктивныйДиалог);

		ДопПараметрыЗапуска = Новый Структура;
		ДопПараметрыЗапуска.Вставить("ОткрытыеФормы", ОткрытыеФормы);

		Если ТипЗнч(ИнструментыОбзораДляЗапуска) = Тип("Массив")
			И ИнструментыОбзораДляЗапуска.Количество() > 0 Тогда
			ДопПараметрыЗапуска.Вставить("ИнструментыПервогоШага", ИнструментыОбзораДляЗапуска);
		КонецЕсли;

		Если ВложенияДляЗапуска.Количество() > 0 Тогда
			ЭтоОдиночноеВложение = (ВложенияДляЗапуска.Количество() = 1);
			Если ЭтоОдиночноеВложение Тогда
				ЕдинственноеВложение = ВложенияДляЗапуска[0];
				ДопПараметрыЗапуска.Вставить("ТипВложения", ЕдинственноеВложение.ТипВложения);
				ДопПараметрыЗапуска.Вставить("ИмяФайла", ЕдинственноеВложение.ИмяФайла);
				Если ЕдинственноеВложение.ТипВложения = "Картинка" ИЛИ ЕдинственноеВложение.ТипВложения = "PDF" Тогда
					ДопПараметрыЗапуска.Вставить("АдресФайлаВоВременномХранилище", ЕдинственноеВложение.АдресВоВременномХранилище);
				Иначе
					ДопПараметрыЗапуска.Вставить("СодержимоеФайла", ЕдинственноеВложение.Содержимое);
				КонецЕсли;
				Если ЗначениеЗаполнено(ЕдинственноеВложение.СсылкаСохраненногоФайла) Тогда
					ДопПараметрыЗапуска.Вставить("СсылкаСохраненногоФайла", ЕдинственноеВложение.СсылкаСохраненногоФайла);
				КонецЕсли;
			КонецЕсли;
			ДопПараметрыЗапуска.Вставить("Вложения", ВложенияДляЗапуска);
		КонецЕсли;

		ПараметрыЗапуска.Вставить("ДопПараметры", ДопПараметрыЗапуска);

		ОбработатьРезультатЗапускаОперации(ЗапуститьФоновоеЗадание(ПараметрыЗапуска));

		ОбновитьТекстИстории();

	Исключение
		СтатусАгента = "Ошибка: " + ОписаниеОшибки();
		РазблокироватьИнтерфейсНаСервере();
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗапуститьВозобновлениеНаСервере(Знач ОткрытыеФормы = Неопределено)

	Попытка
		Если НЕ ЗначениеЗаполнено(АктивныйДиалог)
			ИЛИ НЕ СИ_Агент1С.ЕстьОтложенныеВызовы(АктивныйДиалог) Тогда
			СтатусАгента = "Запрос разрешения не найден или уже обработан";
			Возврат;
		КонецЕсли;

		Если СИ_УправлениеДиалогом.ЕстьАктивныйЗапуск(АктивныйДиалог) Тогда
			СтатусАгента = "По этому диалогу уже идёт обработка запроса";
			Возврат;
		КонецЕсли;

		ВсеВызовыРешены = Истина;
		Разобранное = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(
			СИ_Агент1С.ПолучитьОтложенныеВызовыJSON(АктивныйДиалог));
		Если Разобранное <> Неопределено И ТипЗнч(Разобранное) = Тип("Массив")
			И Разобранное.Количество() > 0 Тогда
			Для Каждого Элемент Из Разобранное Цикл
				Действие = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Решение", "")));
				Если ПустаяСтрока(Действие)
					И НЕ ПустаяСтрока(Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Ид", ""))) Тогда
					ВсеВызовыРешены = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ВсеВызовыРешены = Ложь;
		КонецЕсли;

		Если НЕ ВсеВызовыРешены Тогда
			СтатусАгента = "Не все вызовы подтверждены";
			Возврат;
		КонецЕсли;

		Решения = Новый Массив;
		Для Каждого Элемент Из Разобранное Цикл
			ИдВызова = Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Ид", ""));
			Если ПустаяСтрока(ИдВызова) Тогда
				ЗаписьЖурналаРегистрации("Агент1С.ЗапросРазрешения", УровеньЖурналаРегистрации.Предупреждение,
					Строка(АктивныйДиалог),, "Возобновление: вызов без Ид будет отклонён.");
				Продолжить;
			КонецЕсли;
			Действие = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Решение", "")));
			Решение = Новый Структура;
			Решение.Вставить("ИдВызова", ИдВызова);
			Решение.Вставить("ИмяИнструмента", Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Имя", "")));
			Решение.Вставить("Разрешено", Действие = "allow" ИЛИ Действие = "always");
			Решение.Вставить("Запомнить", Действие = "always");
			Решения.Добавить(Решение);
		КонецЦикла;

		ДопПараметрыЗапуска = Новый Структура;
		ДопПараметрыЗапуска.Вставить("ВозобновлениеРазрешения", Истина);
		ДопПараметрыЗапуска.Вставить("РешенияРазрешений", Решения);
		ДопПараметрыЗапуска.Вставить("ОткрытыеФормы", ОткрытыеФормы);

		ПараметрыЗапуска = Новый Структура;
		ПараметрыЗапуска.Вставить("ЗапросПользователя", "");
		ПараметрыЗапуска.Вставить("Режим", РежимРаботы);
		ПараметрыЗапуска.Вставить("Модель", ИмяМодели);
		ПараметрыЗапуска.Вставить("Профиль", ПрофильПодключения);
		ПараметрыЗапуска.Вставить("ИдДиалога", АктивныйДиалог);
		ПараметрыЗапуска.Вставить("ДопПараметры", ДопПараметрыЗапуска);

		СтатусАгента = "Запуск фонового задания...";
		ОбработатьРезультатЗапускаОперации(ЗапуститьФоновоеЗадание(ПараметрыЗапуска));

		ОбновитьТекстИстории();

	Исключение
		СтатусАгента = "Ошибка: " + ОписаниеОшибки();
		РазблокироватьИнтерфейсНаСервере();
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатЗапускаОперации(Операция)

		Если Операция = Неопределено Тогда
			СтатусАгента = "Ошибка: не удалось запустить фоновое задание";
			ЗаписьЖурналаРегистрации("ЧатАгента.Ошибка", УровеньЖурналаРегистрации.Ошибка, ,
				, "Фоновое задание не запустилось. Синхронное выполнение не допускается.");
		ИначеЕсли Операция.Статус = "Ошибка" Тогда
			ТекстОшибкиЗапуска = "";
			Попытка
				ТекстОшибкиЗапуска = Операция.ИнформацияОбОшибке.Описание;
			Исключение
				ТекстОшибкиЗапуска = "";
			КонецПопытки;
			СтатусАгента = ?(ПустаяСтрока(ТекстОшибкиЗапуска),
				"Ошибка: не удалось запустить фоновое задание",
				"Ошибка: " + ТекстОшибкиЗапуска);
			ЗаписьЖурналаРегистрации("ЧатАгента.Ошибка", УровеньЖурналаРегистрации.Ошибка, ,
				, "Фоновое задание не запустилось: " + ТекстОшибкиЗапуска);
		ИначеЕсли Операция.Статус = "Выполнено" Тогда
			ЗагрузитьРезультатФоновогоЗадания();
		ИначеЕсли Операция.Статус = "Отменено" Тогда
			РазблокироватьИнтерфейсНаСервере();
		ИначеЕсли Операция.ИдентификаторЗадания = Неопределено Тогда
			СтатусАгента = "Ошибка: не удалось запустить фоновое задание";
			ЗаписьЖурналаРегистрации("ЧатАгента.Ошибка", УровеньЖурналаРегистрации.Ошибка, ,
				, "Длительная операция без идентификатора задания (Статус=" + Операция.Статус + ")");
		Иначе
			ИдентификаторФоновогоЗадания = Строка(Операция.ИдентификаторЗадания);
			СтатусАгента = "Запрос отправлен, ожидание ответа...";
			ПоказыватьИндикаторПечати = Истина;
			СИ_УправлениеДиалогом.ЗаписатьАктивноеЗаданиеИСтатус(
				АктивныйДиалог, ИдентификаторФоновогоЗадания,
				Перечисления.СИ_СтатусыДиалога.Активен);
		КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗапуститьФоновоеЗадание(ПараметрыЗапуска)

	Операция = Неопределено;

	Попытка
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Запуск агента ИИ";
		ПараметрыВыполнения.КлючФоновогоЗадания =
			Строка(ПараметрыЗапуска.ИдДиалога.УникальныйИдентификатор());

		Операция = ДлительныеОперации.ВыполнитьВФоне("СИ_Агент1С.ЗапуститьАгентаФоново",
			ПараметрыЗапуска, ПараметрыВыполнения);

		Если Операция.Статус = "Ошибка" Тогда
			ТекстОшибки = "";
			Попытка
				ТекстОшибки = Операция.ИнформацияОбОшибке.Описание;
			Исключение
				ТекстОшибки = "";
			КонецПопытки;
			ЗаписьЖурналаРегистрации("ЧатАгента.ФоновоеЗадание", УровеньЖурналаРегистрации.Ошибка, ,
				, "Ошибка запуска длительной операции: " + ТекстОшибки);
		КонецЕсли;

	Исключение
		Операция = Неопределено;
		ЗаписьЖурналаРегистрации("ЧатАгента.ФоновоеЗадание", УровеньЖурналаРегистрации.Ошибка, ,
			, "Ошибка: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Операция;

КонецФункции

&НаСервере
Процедура ОбработатьАварийноеЗавершениеНаСервере()

	ТекстОшибки = "";
	Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания) Тогда
		Попытка
			ФЗОбъект = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
				Новый УникальныйИдентификатор(ИдентификаторФоновогоЗадания));
			Если ФЗОбъект <> Неопределено Тогда
				ИнформацияОбОшибке = Неопределено;
				Попытка
					ИнформацияОбОшибке = ФЗОбъект.ИнформацияОбОшибке;
				Исключение
					ИнформацияОбОшибке = Неопределено;
					ЗаписьЖурналаРегистрации("ЧатАгента.ФЗОшибка", УровеньЖурналаРегистрации.Предупреждение, , ,
						"ИнформацияОбОшибке недоступна: " + ОписаниеОшибки());
				КонецПопытки;
				Если ИнформацияОбОшибке <> Неопределено Тогда
					Попытка
						ТекстОшибки = ИнформацияОбОшибке.Описание;
					Исключение
						ТекстОшибки = "Неизвестная ошибка";
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ЧатАгента.ФЗОшибка", УровеньЖурналаРегистрации.Предупреждение, , ,
				"Очередь фоновых заданий недоступна при аварийной финализации: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ПоказыватьИндикаторПечати = Ложь;
	ЗагрузитьРезультатФоновогоЗадания();

	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		СтатусАгента = "Ошибка: " + ТекстОшибки;

		СтрокаОшибки = ИсторияСообщений.Добавить();
		СтрокаОшибки.Роль = "assistant";
		СтрокаОшибки.Контент = "Ошибка: " + ТекстОшибки;
		СтрокаОшибки.Время = Формат(ТекущаяДатаСеанса(), "ДЛФ=ВТ");
		ОбновитьТекстИстории();

		ЗаписьЖурналаРегистрации("ЧатАгента.ФЗОшибка", УровеньЖурналаРегистрации.Ошибка, , ,
			"ФЗ ошибка: " + ТекстОшибки);
	КонецЕсли;

	СИ_УправлениеДиалогом.ОчиститьАктивноеЗадание(АктивныйДиалог);

	РазблокироватьИнтерфейсНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРезультатФоновогоЗадания()

	ЗавершитьЗаходНаСервере(Истина);

КонецПроцедуры

&НаСервере
Функция ЗавершитьЗаходНаСервере(Знач ПерерисоватьИсторию)

	Результат = Новый Структура;
	Результат.Вставить("ДокументПерерисован", Ложь);
	Результат.Вставить("ТребуетсяПерерисовка", Ложь);
	Результат.Вставить("НуженТочечныйРендер", Ложь);
	Результат.Вставить("HTML", "");
	Результат.Вставить("НомерСообщения", 0);
	Результат.Вставить("ВариантыВопроса", Неопределено);
	Результат.Вставить("РасхождениеНомеров", "");

	ПоказыватьИндикаторПечати = Ложь;

	СИ_УправлениеДиалогом.ОчиститьАктивноеЗадание(АктивныйДиалог);

	Попытка
		Если ЗначениеЗаполнено(АктивныйДиалог) Тогда
			ДанныеДиалога = ДанныеДиалогаДляФормы(АктивныйДиалог);

			Если СИ_Агент1С.ЕстьОтложенныеВызовы(АктивныйДиалог) Тогда
				ПерерисоватьИсторию = Истина;
				ПоказыватьИндикаторПечати = Истина;
			КонецЕсли;

			Если НЕ ПерерисоватьИсторию Тогда
				РасхождениеНомеров = ЧислаСообщенийРазошлись(АктивныйДиалог);
				Если НЕ ПустаяСтрока(РасхождениеНомеров) Тогда
					ПерерисоватьИсторию = Истина;
					Результат.РасхождениеНомеров = РасхождениеНомеров;
				КонецЕсли;
			КонецЕсли;

			Если ПерерисоватьИсторию Тогда
				ЗагрузитьИсториюСообщений(АктивныйДиалог, ДанныеДиалога.Сводка);
				Результат.ДокументПерерисован = Истина;
			Иначе
				ПодготовитьТочечноеОбновлениеОтвета(Результат);
			КонецЕсли;

			Элементы.СписокЧатов.Обновить();

			ОбновитьСтатистикуТокенов(ДанныеДиалога);

			Попытка
				КоличествоФактовПамяти = СИ_ПамятьДиалога.КоличествоФактов(АктивныйДиалог);
				Если КоличествоФактовПамяти > 0 Тогда
					СтатусАгента = "Готов к работе | Память: " + Строка(КоличествоФактовПамяти) + " факт(ов)";
				КонецЕсли;
			Исключение
				ЗаписьЖурналаРегистрации("ЧатАгента.Память", УровеньЖурналаРегистрации.Предупреждение, ,
					, "Ошибка загрузки количества фактов памяти: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		Если ПустаяСтрока(СтатусАгента) ИЛИ СтрНайти(СтатусАгента, "Память:") = 0 Тогда
			СтатусАгента = "Готов к работе";
		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.Результат", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка финализации захода: " + ОписаниеОшибки());
		Результат.ТребуетсяПерерисовка = Истина;
	КонецПопытки;

	РазблокироватьИнтерфейсНаСервере();

	Возврат Результат;

КонецФункции

&НаСервере
Функция ЧислаСообщенийРазошлись(Знач ИдДиалога)

	МаксимумТаблицы = 0;
	Для Каждого Строка Из ИсторияСообщений Цикл
		НомерСтроки = 0;
		Попытка
			НомерСтроки = Число(Строка.НомерСообщения);
		Исключение
			НомерСтроки = 0;
		КонецПопытки;
		Если НомерСтроки > МаксимумТаблицы Тогда
			МаксимумТаблицы = НомерСтроки;
		КонецЕсли;
	КонецЦикла;

	ВРегистре = СИ_УправлениеДиалогом.ПолучитьМаксимальныйНомерСообщения(ИдДиалога);

	Если МаксимумТаблицы = ВРегистре Тогда
		Возврат "";
	КонецЕсли;

	Возврат "в таблице истории максимум " + Формат(МаксимумТаблицы, "ЧГ=0")
		+ ", в регистре " + Формат(ВРегистре, "ЧГ=0")
		+ " (строк в таблице: " + Формат(ИсторияСообщений.Количество(), "ЧГ=0") + ")";

КонецФункции

&НаСервере
Процедура ПодготовитьТочечноеОбновлениеОтвета(Результат)

	НачалоХода = 0;
	Для Индекс = 0 По ИсторияСообщений.Количество() - 1 Цикл
		Если ИсторияСообщений[Индекс].Роль = "user" Тогда
			НачалоХода = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	ИндексОтвета = Неопределено;
	ИндексПоиска = ИсторияСообщений.Количество() - 1;
	Пока ИндексПоиска >= НачалоХода Цикл
		Если ИсторияСообщений[ИндексПоиска].Роль = "assistant"
			И НЕ ПустаяСтрока(ИсторияСообщений[ИндексПоиска].Контент) Тогда
			ИндексОтвета = ИндексПоиска;
			Прервать;
		КонецЕсли;
		ИндексПоиска = ИндексПоиска - 1;
	КонецЦикла;

	Если ИндексОтвета <> Неопределено Тогда
		ДозаполнитьСсылкиДокументовДиалога();
		ДозаполнитьДиаграммыДиалога();
		Для Индекс = НачалоХода По ИндексОтвета Цикл
			ЭтоОтвет = (Индекс = ИндексОтвета);
			ОтрисованнаяСтрока = СобратьHTMLСтроки(ИсторияСообщений[Индекс], ЭтоОтвет, ЭтоОтвет,
				Ложь, КэшПревьюИзображений, ТемнаяТема,
				КартаСсылокСтрокиИстории(ИсторияСообщений[Индекс]),
				КартаДиаграммСтрокиИстории(ИсторияСообщений[Индекс]));
			Если ЭтоОтвет И НЕ ПустаяСтрока(ОтрисованнаяСтрока.HTML) Тогда
				Результат.НуженТочечныйРендер = Истина;
				Результат.HTML = ОтрисованнаяСтрока.HTML;
				Результат.НомерСообщения = Число(ИсторияСообщений[Индекс].НомерСообщения);
				Результат.ВариантыВопроса = ОтрисованнаяСтрока.ВариантыВопроса;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтменитьФоновоеЗаданиеНаСервере()

	Попытка
		Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания) Тогда
			ФЗОбъект = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
				Новый УникальныйИдентификатор(ИдентификаторФоновогоЗадания));

			Если ФЗОбъект <> Неопределено Тогда
				ФЗОбъект.Отменить();
				ЗаписьЖурналаРегистрации("ЧатАгента.ОтменаФЗ", УровеньЖурналаРегистрации.Информация, , ,
					"Фоновое задание отменено при закрытии формы");
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.ОтменаФЗ", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка отмены фонового задания: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПрерватьОжиданиеНаСервере()

	ИдентификаторФоновогоЗадания = "";
	ПоказыватьИндикаторПечати = Ложь;
	СИ_УправлениеДиалогом.ОчиститьАктивноеЗадание(АктивныйДиалог);
	СИ_Агент1С.СнятьОжиданиеРазрешения(АктивныйДиалог, Истина);
	СтатусАгента = "Диалог прерван пользователем";

	СтрокаСообщения = ИсторияСообщений.Добавить();
	СтрокаСообщения.Роль = "assistant";
	СтрокаСообщения.Контент = "⏹ Ответ прерван пользователем";
	СтрокаСообщения.Время = Формат(ТекущаяДатаСеанса(), "ДЛФ=ВТ");
	ОбновитьТекстИстории();

	ЗаписьЖурналаРегистрации("ЧатАгента.Прерывание", УровеньЖурналаРегистрации.Информация, , ,
		"Ожидание ответа модели прервано пользователем");

КонецПроцедуры

&НаСервере
Процедура РазблокироватьИнтерфейсНаСервере()
	Если НЕ (ЗначениеЗаполнено(АктивныйДиалог)
		И СИ_Агент1С.ЕстьОтложенныеВызовы(АктивныйДиалог)) Тогда
		ПоказыватьИндикаторПечати = Ложь;
	КонецЕсли;
	ИдентификаторФоновогоЗадания = "";
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФорму()

	Попытка
		Настройки = СИ_НастройкиАгента.ПолучитьНастройки();

		ПрофильПодключения = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ПрофильПодключения",
			Справочники.СИ_ПрофилиПодключений.ПустаяСсылка());
		РежимРаботы = Константы.СИ_АктивныйРежим.Получить();

		МассивДоступныхРежимов = СИ_НастройкиАгента.ПолучитьДоступныеРежимыПользователя(ТекущийПользователь, Истина);
		Элементы.РежимРаботы.СписокВыбора.ЗагрузитьЗначения(МассивДоступныхРежимов);

		ДоступныеРежимы.Очистить();
		Для Каждого СсылкаНаРежим Из МассивДоступныхРежимов Цикл
			СтрокаДоступных = ДоступныеРежимы.Добавить();
			СтрокаДоступных.Режим = СсылкаНаРежим;
		КонецЦикла;

		Если ЗначениеЗаполнено(РежимРаботы)
			И НЕ РежимДоступенПользователюИзКеша(РежимРаботы) Тогда
			СтатусАгента = "Текущий режим недоступен вашему пользователю. Выберите доступный режим из списка.";
		КонецЕсли;

		ИмяМодели = СИ_НастройкиАгента.ПолучитьМодельПоУмолчанию(ПрофильПодключения);
		Если ПустаяСтрока(ИмяМодели) Тогда
			ИмяМодели = Настройки.МодельПоУмолчанию;
		КонецЕсли;

		Если ЗначениеЗаполнено(РежимРаботы) Тогда
			ПрименитьДанныеРежима();
		КонецЕсли;

		СтатусАгента = "Готов к работе";
		ИдентификаторФоновогоЗадания = "";
		ТаймерАктивен = Ложь;
		ПоказыватьИндикаторПечати = Ложь;
		ПотраченоТокенов = 0;
		ВсегоТокенов = 0;
		ТекстТокенов = "";
		ПоследнийПоказанныйНомерСообщения = 0;

		ЗаписьЖурналаРегистрации("ЧатАгента.Инициализация", УровеньЖурналаРегистрации.Информация, , ,
			"ИдТекущегоДиалога заполнен = " + Строка(ЗначениеЗаполнено(АктивныйДиалог))
			+ "; значение = " + Строка(АктивныйДиалог)
			+ "; модель = " + ИмяМодели + "; режим = " + Строка(РежимРаботы)
			+ "; профиль = " + Строка(ПрофильПодключения));

		АктивныйДиалог = Справочники.СИ_ДиалогиАгента.ПустаяСсылка();

	Исключение
		СтатусАгента = "Ошибка: " + ОписаниеОшибки();
		ИмяМодели = "";
		РежимРаботы = Неопределено;
		ПрофильПодключения = Справочники.СИ_ПрофилиПодключений.ПустаяСсылка();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПрименитьДанныеРежима()

	Если НЕ ЗначениеЗаполнено(РежимРаботы) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Режим.Модель КАК Модель,
			|	Режим.Профиль КАК Профиль
			|ИЗ
			|	Справочник.СИ_РежимиРаботы КАК Режим
			|ГДЕ
			|	Режим.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", РежимРаботы);

		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат;
		КонецЕсли;

		Если НЕ ПустаяСтрока(Выборка.Модель) Тогда
			ИмяМодели = Выборка.Модель;
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Профиль) Тогда
			ПрофильПодключения = Выборка.Профиль;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("ЧатАгента.ПрименитьРежим", УровеньЖурналаРегистрации.Информация, , ,
			"Режим = " + Строка(РежимРаботы)
			+ "; модель = " + ИмяМодели
			+ "; профиль = " + Строка(ПрофильПодключения));
	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.ПрименитьРежим", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ошибка применения данных режима: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИсториюСообщений(Знач ИдДиалога, Знач ТекстСводкиЗапроса = Неопределено)

	Попытка
		ЭтоОжиданиеРазрешения = ЗначениеЗаполнено(ИдДиалога)
			И СИ_Агент1С.ЕстьОтложенныеВызовы(ИдДиалога);

		Если ПустаяСтрока(ИдентификаторФоновогоЗадания) И НЕ ЭтоОжиданиеРазрешения Тогда
			ПоказыватьИндикаторПечати = Ложь;
		КонецЕсли;

		История = СИ_УправлениеДиалогом.ПолучитьИсторию(ИдДиалога, Неопределено);

		СсылкиДокументовПоНомерам = Новый Соответствие;
		ДиаграммыПоНомерам = Новый Соответствие;

		ИсторияСообщений.Очистить();

		РезультатНормализации = НормализоватьСообщенияДляТаблицы(История);

		Для Каждого СтрокаСообщения Из РезультатНормализации.Строки Цикл
			НоваяСтрокаТаблицы = ИсторияСообщений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаСообщения);
		КонецЦикла;

		ПоследнийПоказанныйНомерСообщения = РезультатНормализации.МаксимальныйНомер;

		Если ТекстСводкиЗапроса = Неопределено Тогда
			ТекстСводкиЗапроса = ДанныеДиалогаСводки(ИдДиалога);
		КонецЕсли;
		ТекстСтатусаИндикатора = ?(ЭтоОжиданиеРазрешения,
			"Ожидает подтверждения пользователя…", "");
		ОбновитьТекстИстории(ТекстСводкиЗапроса, , , ТекстСтатусаИндикатора);

		ЗаписьЖурналаРегистрации("ЧатАгента.ЗагрузкаИстории", УровеньЖурналаРегистрации.Информация, , ,
			"ИдДиалога = " + Строка(ИдДиалога) + "; загружено всего = " + Строка(История.Количество())
			+ "; показано = " + Строка(ИсторияСообщений.Количество()));
	Исключение
		СтатусАгента = "Ошибка загрузки истории: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция НормализоватьСообщенияДляТаблицы(Знач Сообщения)

	НормализованныеСтроки = Новый Массив;
	МинимальныйНомер = Неопределено;
	МаксимальныйНомер = 0;

	Для Каждого Сообщение Из Сообщения Цикл

		Если Сообщение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		РольСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");

		НомерСообщенияЗаписи = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "НомерСообщения", 0);
		Если НомерСообщенияЗаписи > МаксимальныйНомер Тогда
			МаксимальныйНомер = НомерСообщенияЗаписи;
		КонецЕсли;
		Если НомерСообщенияЗаписи >= 0
			И (МинимальныйНомер = Неопределено ИЛИ НомерСообщенияЗаписи < МинимальныйНомер) Тогда
			МинимальныйНомер = НомерСообщенияЗаписи;
		КонецЕсли;

		Если РольСообщения = "system" Тогда
			Продолжить;
		КонецЕсли;

		ИмяИнструментаЗаписи = "";
		РезультатИнструментаЗаписи = "";
		Если РольСообщения = "tool" Тогда
			ИмяИнструментаЗаписи = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИмяИнструмента", "");
			РезультатИнструментаЗаписи = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Контент", "");
			Если РезультатИнструментаЗаписи = Неопределено Тогда
				РезультатИнструментаЗаписи = "";
			КонецЕсли;
		КонецЕсли;

		КонтентСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Контент", "");

		РассужденияСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Рассуждения", "");
		Если РольСообщения = "assistant"
			И (ПустаяСтрока(КонтентСообщения) ИЛИ ЭтоПромежуточноеСообщениеАссистента(Сообщение)) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТаблицы = Новый Структура;
		СтрокаТаблицы.Вставить("Роль", РольСообщения);
		СтрокаТаблицы.Вставить("Контент", КонтентСообщения);
		СтрокаТаблицы.Вставить("Время", СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Время", ""));
		СтрокаТаблицы.Вставить("Рассуждения", РассужденияСообщения);
		СтрокаТаблицы.Вставить("НомерСообщения", НомерСообщенияЗаписи);
		Если РольСообщения = "tool" Тогда
			СтрокаТаблицы.Рассуждения = ИмяИнструментаЗаписи;
			Если ПустаяСтрока(СтрокаТаблицы.Контент) Тогда
				СтрокаТаблицы.Контент = РезультатИнструментаЗаписи;
			КонецЕсли;
		КонецЕсли;

		НормализованныеСтроки.Добавить(СтрокаТаблицы);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Строки", НормализованныеСтроки);
	Результат.Вставить("МинимальныйНомер", МинимальныйНомер);
	Результат.Вставить("МаксимальныйНомер", МаксимальныйНомер);

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ОбновитьТекстИстории(
		Знач ТекстСводки = "", 
		Знач ВызовыИнструментов = Неопределено, 
		Знач РассужденияИндикатора = "", 
		Знач ПромежуточныйТекстИндикатора = "")

	ВариантыВопросов.Очистить();

	Если ИсторияСообщений.Количество() = 0 Тогда
		ТекстИстории = СИ_ЧатHTMLСервер.ПолучитьЗаголовокHTML(ТемнаяТема);
		Если НЕ ПустаяСтрока(ТекстСводки) Тогда
			ТекстИстории = ТекстИстории + СИ_ЧатHTMLСервер.ПолучитьСводкуHTML(ТекстСводки);
		КонецЕсли;
		ТекстИстории = ТекстИстории + СИ_ЧатHTMLСервер.ПолучитьСтартовыйЭкранHTML(РежимРаботы)
			+ "<a name=""chatBottom"" id=""chatBottom""></a></body></html>";
		Возврат;
	КонецЕсли;

	ДозаполнитьСсылкиДокументовДиалога();
	ДозаполнитьДиаграммыДиалога();

	Части = Новый Массив;
	Части.Добавить(СИ_ЧатHTMLСервер.ПолучитьЗаголовокHTML(ТемнаяТема));

	Если НЕ ПустаяСтрока(ТекстСводки) Тогда
		Части.Добавить(СИ_ЧатHTMLСервер.ПолучитьСводкуHTML(ТекстСводки));
	КонецЕсли;

	РолиСтрокИстории = Новый Массив;
	Для Каждого СтрокаДляРоли Из ИсторияСообщений Цикл
		РолиСтрокИстории.Добавить(СтрокаДляРоли.Роль);
	КонецЦикла;
	ЭтоФиналХода = Новый Массив(РолиСтрокИстории.Количество());
	Для ИндексСтроки = 0 По РолиСтрокИстории.Количество() - 1 Цикл
		Если ИндексСтроки = РолиСтрокИстории.Количество() - 1 Тогда
			ЭтоФиналХода[ИндексСтроки] = Истина;
		Иначе
			ЭтоФиналХода[ИндексСтроки] = (РолиСтрокИстории[ИндексСтроки + 1] = "user");
		КонецЕсли;
	КонецЦикла;

	ИндексСтрокиИстории = -1;
	ВсегоСтрокИстории = РолиСтрокИстории.Количество();
	Для Каждого Строка Из ИсторияСообщений Цикл
		ИндексСтрокиИстории = ИндексСтрокиИстории + 1;
		КартаСсылокСтроки = КартаСсылокСтрокиИстории(Строка);
		КартаДиаграммСтроки = КартаДиаграммСтрокиИстории(Строка);
		ОтрисованнаяСтрока = СобратьHTMLСтроки(Строка, ЭтоФиналХода[ИндексСтрокиИстории],
			ИндексСтрокиИстории = ВсегоСтрокИстории - 1,
			ПоказыватьИндикаторПечати, КэшПревьюИзображений, ТемнаяТема, КартаСсылокСтроки,
			КартаДиаграммСтроки);

		Если ОтрисованнаяСтрока.ВариантыВопроса <> Неопределено Тогда
			НомерСообщенияВопроса = ОтрисованнаяСтрока.ВариантыВопроса.НомерСообщения;
			МассивВариантовДляКэша = ОтрисованнаяСтрока.ВариантыВопроса.Варианты;
			Для ИндексВарианта = 0 По МассивВариантовДляКэша.Количество() - 1 Цикл
				СтрокаВариантаКэша = ВариантыВопросов.Добавить();
				СтрокаВариантаКэша.НомерСообщения = НомерСообщенияВопроса;
				СтрокаВариантаКэша.Индекс = ИндексВарианта;
				СтрокаВариантаКэша.Текст = МассивВариантовДляКэша[ИндексВарианта];
			КонецЦикла;
		КонецЕсли;

		Если НЕ ПустаяСтрока(ОтрисованнаяСтрока.HTML) Тогда
			Части.Добавить(ОтрисованнаяСтрока.HTML);
		КонецЕсли;
	КонецЦикла;

	Если ПоказыватьИндикаторПечати Тогда
		Части.Добавить("<div id=""siPrinting"">"
			+ СИ_ЧатHTMLСервер.ПолучитьИндикаторПечатиHTML(ВызовыИнструментов, РассужденияИндикатора, ПромежуточныйТекстИндикатора, ТемнаяТема)
			+ "</div>");
	КонецЕсли;

	Части.Добавить("<a name=""chatBottom"" id=""chatBottom""></a></body></html>");
	ТекстИстории = СтрСоединить(Части, "");

	Если ЗначениеЗаполнено(АктивныйДиалог) Тогда
		ВызовыОжиданияJSON = СИ_Агент1С.ПолучитьОтложенныеВызовыJSON(АктивныйДиалог);
		Если НЕ ПустаяСтрока(ВызовыОжиданияJSON) Тогда
			КарточкаРазрешения = СИ_ЧатHTMLСервер.ПолучитьБлокРазрешенияHTML(
				ВызовыОжиданияJSON, ПустаяСтрока(ИдентификаторФоновогоЗадания));
			Если НЕ ПустаяСтрока(КарточкаРазрешения) Тогда
				ТекстИстории = Лев(ТекстИстории, СтрДлина(ТекстИстории) - СтрДлина("</body></html>"))
					+ КарточкаРазрешения + "</body></html>";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Рендерит одно сообщение истории в HTML «пузырь». Общая часть полной
// перерисовки документа (ОбновитьТекстИстории) и дописывания живых
// сообщений (СобратьHTMLЖивыхСообщений) - вёрстка не дублируется.
//
// Параметры:
//  Строка - Произвольный - строка таблицы ИсторияСообщений либо структура с
//           теми же полями (Роль, Контент, Время, Рассуждения, НомерСообщения);
//  ЭтоФиналХода - Булево - строка последняя в своём ходе: за ней идёт
//           сообщение пользователя либо это конец истории. От этого зависит
//           блок вопроса с вариантами. Ссылка «В таблицу» от него не зависит:
//           её признак - таблица в самом ответе, поэтому она одинаково
//           рисуется и при полной перерисовке, и при дописывании живых
//           сообщений (раньше признак шёл от инструмента запроса к БД и в
//           живом пути был подавлен - кнопка появлялась лишь после перечита
//           истории, то есть после перезахода в диалог);
//  ЭтоПоследняяСтрока - Булево - строка последняя в отрисованном наборе;
//  ПоказыватьИндикаторПечати - Булево - идёт генерация ответа; на время
//           генерации вопрос с вариантами подавлен;
//  КэшПревью - Соответствие из Структура - кэш готовых превью изображений
//           формы чата. Неопределено означает, что превью строятся заново
//           (у безконтекстного вызова нет доступа к переменной формы);
//  ТемнаяТема - Булево - палитра оформления чата. У безконтекстного вызова нет
//           доступа к реквизиту формы ТемнаяТема, поэтому тема передаётся
//           параметром; цвета разметки берутся из css темы, а от этого
//           параметра зависят только стопы градиента заголовка роли.
//  КартаСсылок - Массив из Структура,Неопределено - карта навигационных ссылок
//           на объекты 1С для этой строки (Упоминание, Адрес): по ней
//           упоминания объектов в ответе становятся ссылками e1cib/ (см.
//           СИ_МаркдаунHTML.ПреобразоватьУпоминанияВСсылки). Неопределено или
//           пустой массив - ссылок в ответе не будет.
//  КартаДиаграмм - Массив из Структура,Неопределено - карточки диаграмм ответа
//           (Заголовок, SVG, Подпись, УИДФайла, ИмяФайла). Рисуются под
//           пузырём ассистента; каждая проходит БезопасныйSVG.
//
// Возвращаемое значение:
//  Структура:
//   * HTML - Строка - готовый HTML блока ("" - строка не рисуется);
//   * ВариантыВопроса - Неопределено, Структура - разобранный вопрос модели:
//     структура с полями НомерСообщения (Число) и Варианты (Массив из Строка);
//     её вызывающий наполняет кэш ВариантыВопросов формы.
//
// ВНИМАНИЕ: параметр КэшПревью передаётся БЕЗ «Знач» намеренно - превью
// кэшируются по ходу рендера (СИ_ФайлыДиалога дополняет переданный кэш),
// и при копировании по значению накопленные превью до формы не дошли бы.
&НаСервереБезКонтекста
Функция СобратьHTMLСтроки(Знач Строка, ЭтоФиналХода, ЭтоПоследняяСтрока,
		Знач ПоказыватьИндикаторПечати, КэшПревью, Знач ТемнаяТема = Ложь,
		Знач КартаСсылок = Неопределено, Знач КартаДиаграмм = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("HTML", "");
	Результат.Вставить("ВариантыВопроса", Неопределено);

	КонтентСтроки = Строка.Контент;
	Если КонтентСтроки = Неопределено Тогда
		КонтентСтроки = "";
	КонецЕсли;

	Если Строка.Роль = "user" Тогда

		Контент = СИ_МаркдаунHTML.ЭкранироватьHTML(КонтентСтроки);
		Контент = СтрЗаменить(Контент, Символы.ПС, "<br/>");
		Контент = СИ_ЧатHTMLСервер.ПреобразоватьВложенияПользователяВHTML(Контент, КэшПревью);
		Контент = СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте(Контент);
		Результат.Вставить("HTML", СИ_ЧатHTMLСервер.ПолучитьBubbleUserHTML(Строка.Время, Контент));

	ИначеЕсли Строка.Роль = "tool" Тогда

	ИначеЕсли ПустаяСтрока(КонтентСтроки) Тогда
		Результат.HTML = HTMLКарточекДиаграмм(КартаДиаграмм);
		Возврат Результат;

	ИначеЕсли СтрНачинаетсяС(КонтентСтроки, "Ошибка:") Тогда

		Контент = СИ_МаркдаунHTML.ЭкранироватьHTML(КонтентСтроки);
		Контент = СтрЗаменить(Контент, Символы.ПС, "<br/>");
		Контент = СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте(Контент);
		Результат.Вставить("HTML", СИ_ЧатHTMLСервер.ПолучитьBubbleErrorHTML(Строка.Время, Контент));

	Иначе

		КонтентДляРендера = КонтентСтроки;
		БлокВопросаДляВывода = "";
		РазборВопросаАссистента = СИ_ЧатHTMLСервер.РазобратьВопросСВариантами(КонтентСтроки);
		Если РазборВопросаАссистента.Успех Тогда
			КонтентДляРендера = РазборВопросаАссистента.КонтентБезМаркеров;

			Если ЭтоФиналХода И ЭтоПоследняяСтрока И НЕ ПоказыватьИндикаторПечати Тогда
				НомерСообщенияВопроса = 0;
				Попытка
					НомерСообщенияВопроса = Число(Строка.НомерСообщения);
				Исключение
					НомерСообщенияВопроса = 0;
				КонецПопытки;
				Если НомерСообщенияВопроса > 0 Тогда
					ВопросДляКэша = Новый Структура;
					ВопросДляКэша.Вставить("НомерСообщения", НомерСообщенияВопроса);
					ВопросДляКэша.Вставить("Варианты", РазборВопросаАссистента.Варианты);
					Результат.Вставить("ВариантыВопроса", ВопросДляКэша);
					БлокВопросаДляВывода = СИ_ЧатHTMLСервер.ПолучитьБлокВопросаHTML(
						НомерСообщенияВопроса,
						РазборВопросаАссистента.Вопрос,
						ВопросДляКэша.Варианты);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Контент = СИ_МаркдаунHTML.ЭкранироватьHTML(КонтентДляРендера);
		Контент = СИ_МаркдаунHTML.РазобратьMarkdownВHTML(Контент);
		Контент = СИ_МаркдаунHTML.ПреобразоватьСсылкиВHTML(Контент);
		Контент = СИ_МаркдаунHTML.ПреобразоватьСсылкиНаФайлыВHTML(Контент, Истина, КэшПревью,
			УИДыФайловДиаграмм(КартаДиаграмм));
		Контент = СИ_МаркдаунHTML.ПреобразоватьУпоминанияВСсылки(Контент, КартаСсылок);
		Контент = СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте(Контент);

		НомерСообщенияДляТаблицы = 0;
		Если СтрНайти(Контент, "<table") > 0 Тогда
			Попытка
				НомерСообщенияДляТаблицы = Число(Строка.НомерСообщения);
			Исключение
				НомерСообщенияДляТаблицы = 0;
			КонецПопытки;
		КонецЕсли;
		Результат.Вставить("HTML", СИ_ЧатHTMLСервер.ПолучитьBubbleAssistantHTML(Строка.Время, Контент,
			Строка.НомерСообщения, НомерСообщенияДляТаблицы, БлокВопросаДляВывода, ТемнаяТема));

		Если ТипЗнч(КартаДиаграмм) = Тип("Массив") И КартаДиаграмм.Количество() > 0 Тогда
			Результат.HTML = Результат.HTML + HTMLКарточекДиаграмм(КартаДиаграмм);
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

// HTML карточек диаграмм (DrawChart) для строки ответа. Каждая карточка
// проходит проверку БезопасныйSVG внутри ПолучитьКарточкуДиаграммыHTML;
// отклонённая карточка просто не рисуется.
//
// Параметры:
//  КартаДиаграмм - Массив из Структура,Неопределено - карточки (Заголовок,
//    SVG, Подпись, УИДФайла, ИмяФайла).
//
// Возвращаемое значение:
//  Строка - HTML карточек; "" - если карточек нет.
&НаСервереБезКонтекста
Функция HTMLКарточекДиаграмм(Знач КартаДиаграмм)

	Если ТипЗнч(КартаДиаграмм) <> Тип("Массив") ИЛИ КартаДиаграмм.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	HTMLКарточек = "";
	Для Каждого Карточка Из КартаДиаграмм Цикл
		HTMLКарточек = HTMLКарточек + СИ_ЧатHTMLСервер.ПолучитьКарточкуДиаграммыHTML(
			СИ_РаботаСJSON.БезопасноПолучить(Карточка, "Заголовок", ""),
			СИ_РаботаСJSON.БезопасноПолучить(Карточка, "SVG", ""),
			СИ_РаботаСJSON.БезопасноПолучить(Карточка, "Подпись", ""),
			СИ_РаботаСJSON.БезопасноПолучить(Карточка, "УИДФайла", ""),
			СИ_РаботаСJSON.БезопасноПолучить(Карточка, "ИмяФайла", ""));
	КонецЦикла;

	Возврат HTMLКарточек;

КонецФункции

// УИД файлов карточек диаграмм. Их превью в тексте ответа не строится:
// SVG, загруженный как <img>, не видит классы палитры (фигуры чёрные),
// а карточка диаграммы уже рисуется отдельным блоком под пузырём.
//
// Параметры:
//  КартаДиаграмм - Массив из Структура,Неопределено - карточки диаграмм.
//
// Возвращаемое значение:
//  Массив из Строка - UUID файлов SVG.
&НаСервереБезКонтекста
Функция УИДыФайловДиаграмм(Знач КартаДиаграмм)

	УИДы = Новый Массив;
	Если ТипЗнч(КартаДиаграмм) <> Тип("Массив") Тогда
		Возврат УИДы;
	КонецЕсли;

	Для Каждого Карточка Из КартаДиаграмм Цикл
		УИД = СИ_РаботаСJSON.БезопасноПолучить(Карточка, "УИДФайла", "");
		Если НЕ ПустаяСтрока(УИД) Тогда
			УИДы.Добавить(Строка(УИД));
		КонецЕсли;
	КонецЦикла;

	Возврат УИДы;

КонецФункции

// Рендерит порцию живых сообщений в готовый фрагмент HTML для дописывания
// в документ чата (без заголовка, индикатора печати и закрывающих тегов).
//
// Вызов намеренно БЕЗ КОНТЕКСТА формы: по сети на тик уходит только дельта,
// а не весь документ, плюс сервер не гоняет через контекст таблицу истории.
// Плата за это - нет доступа к серверной переменной формы с кэшем превью:
// изображения из ответа (маркеры file:<UUID> после DrawMermaid) отрисуются
// заново. Случается не чаще раза за ход и только на финальном ответе.
//
// Время сообщений проставляется здесь: в живом пакете ВХ ключ «Время» пуст
// (ядро хранит сообщения буфера в формате OpenAI и времени в них не заводит),
// а в регистр оно попадает только при пакетной записи в конце захода.
// ТекущаяДатаСеанса - тот же источник, что и при записи в регистр, поэтому
// подписи «Ассистент · время» получаются в одном формате и в одном часовом
// поясе. На клиенте время проставить нечем: ТекущаяУниверсальнаяДата в
// клиентском контексте формы недоступна, поэтому значение возвращается.
//
// Параметры:
//  Строки - Массив из Структура - строки с полями Роль, Контент, Время,
//           Рассуждения, НомерСообщения и СсылкиДокументов (карта навигационных
//           ссылок на объекты 1С; поля может не быть) - формат строк таблицы
//           истории плюс карта ссылок;
//  ТемнаяТема - Булево - палитра оформления: тема передаётся параметром,
//           потому что у безконтекстного вызова нет доступа к реквизиту формы
//           ТемнаяТема (нужна только для стопов градиента заголовка роли).
//
// Возвращаемое значение:
//  Структура:
//   * HTML - Строка - HTML-фрагмент с новыми сообщениями;
//   * Времена - Массив из Строка - время каждой входной строки в порядке
//     следования (в том числе для строк, которые не отрисованы).
&НаСервереБезКонтекста
Функция СобратьHTMLЖивыхСообщений(Знач Строки, Знач ТемнаяТема = Ложь)

	Части = Новый Массив;
	Времена = Новый Массив;
	ВремяЖивыхСообщений = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");

	Для Каждого Строка Из Строки Цикл

		ВремяСтроки = Строка.Время;
		Если ПустаяСтрока(ВремяСтроки) Тогда
			ВремяСтроки = ВремяЖивыхСообщений;
		КонецЕсли;
		Строка.Время = ВремяСтроки;

		КартаСсылокЖивая = СИ_РаботаСJSON.БезопасноПолучить(Строка, "СсылкиДокументов", Неопределено);
		КартаДиаграммЖивая = СИ_РаботаСJSON.БезопасноПолучить(Строка, "Диаграмма", Неопределено);
		ОтрисованнаяСтрока = СобратьHTMLСтроки(Строка, Ложь, Истина, Истина, Неопределено, ТемнаяТема,
			КартаСсылокЖивая, КартаДиаграммЖивая);
		Если НЕ ПустаяСтрока(ОтрисованнаяСтрока.HTML) Тогда
			Части.Добавить(ОтрисованнаяСтрока.HTML);
		КонецЕсли;

		Времена.Добавить(ВремяСтроки);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("HTML", СтрСоединить(Части, ""));
	Результат.Вставить("Времена", Времена);

	Возврат Результат;

КонецФункции

&НаСервере
Функция ДанныеДиалогаСводки(Знач ИдДиалога)
	Результат = "";
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Д.СводкаДиалога КАК СводкаХранилище
			|ИЗ
			|	Справочник.СИ_ДиалогиАгента КАК Д
			|ГДЕ
			|	Д.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ИдДиалога);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СводкаХранилище = Выборка.СводкаХранилище;
			Если СводкаХранилище <> Неопределено Тогда
				Результат = СводкаХранилище.Получить();
				Если Результат = Неопределено Тогда
					Результат = "";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат = "";
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура СоздатьНовыйДиалогНаСервере()

	ИсторияСообщений.Очистить();
	СсылкиДокументовПоНомерам = Новый Соответствие;
	ДиаграммыПоНомерам = Новый Соответствие;
	ОбновитьТекстИстории();
	АктивныйДиалог = Неопределено;
	СтатусАгента = "Новый диалог. Готов к работе.";
	ИдентификаторФоновогоЗадания = "";
	ТаймерАктивен = Ложь;
	ПоказыватьИндикаторПечати = Ложь;
	ПотраченоТокенов = 0;
	ВсегоТокенов = 0;
	ТекстТокенов = "";
	ПоследнийПоказанныйНомерСообщения = 0;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйДиалог()
	СоздатьНовыйДиалогНаСервере();
	Элементы.КомандаОтправить.Доступность = Истина;
	Элементы.ПолеВвода.Доступность = Истина;
	Элементы.КомандаПрикрепитьФайл.Доступность = Истина;
	Элементы.КомандаПрерватьДиалог.Доступность = Ложь;
	Элементы.КомандаСжать.Доступность = Истина;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЧатНаСервере(Знач СсылкаНаЧат)

	Если НЕ ЗначениеЗаполнено(СсылкаНаЧат) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		АктивныйДиалог = СсылкаНаЧат;

		ДанныеДиалога = ДанныеДиалогаДляФормы(СсылкаНаЧат);

		ЗагрузитьИсториюСообщений(СсылкаНаЧат, ДанныеДиалога.Сводка);

		СтатусАгента = "Загружен чат: " + ДанныеДиалога.Наименование;
		РежимРаботы = ДанныеДиалога.Режим;
		Если ЗначениеЗаполнено(РежимРаботы)
			И НЕ РежимДоступенПользователюИзКеша(РежимРаботы) Тогда
			СтатусАгента = "Загружен чат: " + ДанныеДиалога.Наименование
				+ " (режим диалога недоступен вашему пользователю, но продолжает работать)";
		КонецЕсли;
		ИмяМодели = ДанныеДиалога.Модель;
		Если ЗначениеЗаполнено(ДанныеДиалога.ПрофильПодключения) Тогда
			ПрофильПодключения = ДанныеДиалога.ПрофильПодключения;
		КонецЕсли;

		ОбновитьСтатистикуТокенов(ДанныеДиалога);

		Попытка
			КоличествоФактовПамяти = СИ_ПамятьДиалога.КоличествоФактов(СсылкаНаЧат);
			Если КоличествоФактовПамяти > 0 Тогда
				СтатусАгента = СтатусАгента + " | Память: " + Строка(КоличествоФактовПамяти) + " факт(ов)";
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ЧатАгента.Память", УровеньЖурналаРегистрации.Предупреждение, ,
				, "Ошибка загрузки количества фактов памяти: " + ОписаниеОшибки());
		КонецПопытки;
	Исключение
		СтатусАгента = "Ошибка загрузки чата: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция СжатьИсториюНаСервере()

	РезультатВозврата = Новый Структура("Успех, Сообщение", Ложь, "");

	Если Не ЗначениеЗаполнено(АктивныйДиалог) Тогда
		РезультатВозврата.Сообщение = "Не выбран активный диалог.";
		Возврат РезультатВозврата;
	КонецЕсли;

	Попытка
		История = СИ_УправлениеДиалогом.ПолучитьИсторию(АктивныйДиалог, Неопределено);
		Если История.Количество() = 0 Тогда
			РезультатВозврата.Сообщение = "В диалоге нет сообщений для сжатия.";
			Возврат РезультатВозврата;
		КонецЕсли;

		ЛимитТокенов = 128000;
		МодельСжатия = "";
		ПрофильСжатия = Неопределено;
		ОбъектДиалога = Неопределено;
		Попытка
			ОбъектДиалога = АктивныйДиалог.ПолучитьОбъект();
			Если ОбъектДиалога <> Неопределено Тогда
				Если ОбъектДиалога.ЛимитТокенов > 0 Тогда
					ЛимитТокенов = ОбъектДиалога.ЛимитТокенов;
				КонецЕсли;
				МодельСжатия = ОбъектДиалога.Модель;
				ПрофильСжатия = ОбъектДиалога.ПрофильПодключения;
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ЧатАгента.Сжатие", УровеньЖурналаРегистрации.Предупреждение, ,
				, "Ошибка чтения параметров диалога для сжатия (используем дефолты): " + ОписаниеОшибки());
		КонецПопытки;

		ПараметрыСжатия = Новый Структура;
		ПараметрыСжатия.Вставить("Модель", МодельСжатия);
		ПараметрыСжатия.Вставить("Профиль", ПрофильСжатия);
		ПараметрыСжатия.Вставить("ИспользоватьСводку", Истина);
		ПараметрыСжатия.Вставить("СхлопыватьToolПары", Истина);
		ПараметрыСжатия.Вставить("МаксТокеновСводки", 1500);
		ПараметрыСжатия.Вставить("КоличествоСвежих", 10);
		ПараметрыСжатия.Вставить("МаксДлинаToolРезультата", 4000);
		ПараметрыСжатия.Вставить("МаксДлинаСообщения", 4000);
		ПараметрыСжатия.Вставить("Принудительно", Истина);

		Результат = СИ_УправлениеДиалогом.СжатьИсторию(История, ЛимитТокенов, ПараметрыСжатия);

		Если СИ_РаботаСJSON.БезопасноПолучить(Результат, "ПримененоСжатие", Ложь) Тогда
			СжатаяИстория = СИ_РаботаСJSON.БезопасноПолучить(Результат, "Сообщения", Неопределено);
			Если СжатаяИстория <> Неопределено И СжатаяИстория.Количество() > 0 Тогда
				СИ_УправлениеДиалогом.ЗаменитьИсториюДиалога(АктивныйДиалог, СжатаяИстория);

				СводкаСжатия = СИ_РаботаСJSON.БезопасноПолучить(Результат, "Сводка", "");
				ЗначенияЗаписиДиалога = Новый Структура;
				Если НЕ ПустаяСтрока(СводкаСжатия) Тогда
					ЗначенияЗаписиДиалога.Вставить("СводкаДиалога", Новый ХранилищеЗначения(СводкаСжатия));
				КонецЕсли;
				ЗначенияЗаписиДиалога.Вставить("ИсторияТокенов",
					СИ_УправлениеДиалогом.ОценитьТокеныИстории(СжатаяИстория));
				ПараметрыЗаписиДиалога = Новый Структура;
				ПараметрыЗаписиДиалога.Вставить("ИмяОперации", "СжатиеДиалогаВручную");
				СИ_УправлениеДиалогом.ЗаписатьРеквизитыДиалога(АктивныйДиалог, ЗначенияЗаписиДиалога,
					ПараметрыЗаписиДиалога);

				ДанныеДиалога = ДанныеДиалогаДляФормы(АктивныйДиалог);
				ЗагрузитьИсториюСообщений(АктивныйДиалог, ДанныеДиалога.Сводка);
				ОбновитьСтатистикуТокенов(ДанныеДиалога);

				ЗаписьЖурналаРегистрации("ЧатАгента.Сжатие", УровеньЖурналаРегистрации.Информация, ,
					"Принудительное сжатие: было = " + Строка(Результат.БылоСообщений)
					+ "; стало = " + Строка(Результат.СталоСообщений)
					+ "; сводка = " + Строка(СИ_РаботаСJSON.БезопасноПолучить(Результат, "ИспользованаСводка", Ложь)));

				РезультатВозврата.Успех = Истина;
				РезультатВозврата.Сообщение = "История диалога сжата: было = " + Строка(Результат.БылоСообщений)
					+ ", стало = " + Строка(Результат.СталоСообщений) + ".";
				Возврат РезультатВозврата;
			КонецЕсли;
		КонецЕсли;

		Если СИ_РаботаСJSON.БезопасноПолучить(Результат, "НечегоСжимать", Ложь) Тогда
			РезультатВозврата.Успех = Ложь;
			РезультатВозврата.Сообщение = "Сжать историю не удалось: недостаточно данных для сводки "
				+ "или лёгкие техники сжатия ничего не сократили. История не изменена.";
			Возврат РезультатВозврата;
		КонецЕсли;

		РезультатВозврата.Успех = Истина;
		РезультатВозврата.Сообщение = "История уже в пределах лимита токенов, сжатие не требуется.";
		Возврат РезультатВозврата;

	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.Сжатие", УровеньЖурналаРегистрации.Ошибка, ,
			, "Ошибка сжатия истории: " + ОписаниеОшибки());
		РезультатВозврата.Сообщение = "Не удалось сжать историю диалога. Подробности в журнале регистрации.";
	КонецПопытки;

	Возврат РезультатВозврата;
КонецФункции

&НаСервере
Функция РежимДоступенПользователюИзКеша(Режим)

	Если НЕ ЗначениеЗаполнено(Режим) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого СтрокаДоступных Из ДоступныеРежимы Цикл
		Если СтрокаДоступных.Режим = Режим Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
// Читает данные диалога ОДНИМ запросом вместо трёх обращений к СИ_ДиалогиАгента
// (ПолучитьОбъект() + ПолучитьОбъект() + отдельный запрос).
// Возвращает структуру со всеми полями, нужными для отображения:
// Наименование, Режим, Модель, ПрофильПодключения, Сводка, ПотраченоТокенов,
// ЛимитТокенов, ИсторияТокенов.
// ТЧ РазрешённыеИнструменты и хранилище СистемныйПромпт НЕ включаются — они
// не нужны для отображения истории и статистики.
Функция ДанныеДиалогаДляФормы(ЗНАЧ СсылкаНаЧат)

	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Режим", Справочники.СИ_РежимиРаботы.ПустаяСсылка());
	Результат.Вставить("Модель", "");
	Результат.Вставить("ПрофильПодключения", Справочники.СИ_ПрофилиПодключений.ПустаяСсылка());
	Результат.Вставить("Сводка", "");
	Результат.Вставить("ПотраченоТокенов", 0);
	Результат.Вставить("ЛимитТокенов", 0);
	Результат.Вставить("ИсторияТокенов", 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Д.Наименование КАК Наименование,
		|	Д.Режим КАК Режим,
		|	Д.Модель КАК Модель,
		|	Д.ПрофильПодключения КАК ПрофильПодключения,
		|	Д.СводкаДиалога КАК СводкаХранилище,
		|	Д.ПотраченоТокенов КАК ПотраченоТокенов,
		|	Д.ЛимитТокенов КАК ЛимитТокенов,
		|	Д.ИсторияТокенов КАК ИсторияТокенов
		|ИЗ
		|	Справочник.СИ_ДиалогиАгента КАК Д
		|ГДЕ
		|	Д.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаЧат);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		Результат.Наименование = Выборка.Наименование;
		Результат.Модель = Выборка.Модель;

		ПрофильДиалога = Выборка.ПрофильПодключения;
		Если ПрофильДиалога <> Неопределено
			И ТипЗнч(ПрофильДиалога) = Тип("СправочникСсылка.СИ_ПрофилиПодключений")
			И ЗначениеЗаполнено(ПрофильДиалога) Тогда
			Результат.ПрофильПодключения = ПрофильДиалога;
		КонецЕсли;

		РежимДиалога = Выборка.Режим;
		Если РежимДиалога <> Неопределено
			И ТипЗнч(РежимДиалога) = Тип("СправочникСсылка.СИ_РежимиРаботы")
			И ЗначениеЗаполнено(РежимДиалога) Тогда
			Результат.Режим = РежимДиалога;
		КонецЕсли;

		СводкаХранилище = Выборка.СводкаХранилище;
		Если СводкаХранилище <> Неопределено Тогда
			Сводка = СводкаХранилище.Получить();
			Если Сводка <> Неопределено Тогда
				Результат.Сводка = Сводка;
			КонецЕсли;
		КонецЕсли;

		Результат.ПотраченоТокенов = Выборка.ПотраченоТокенов;
		Результат.ЛимитТокенов = Выборка.ЛимитТокенов;
		Результат.ИсторияТокенов = Выборка.ИсторияТокенов;

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура УдалитьДиалогиПоДатеНаСервере(Знач ДатаГруппы)

Попытка
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СИ_ДиалогиАгента.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СИ_ДиалогиАгента КАК СИ_ДиалогиАгента
		|ГДЕ
		|	СИ_ДиалогиАгента.Пользователь = &Пользователь
		|	И СИ_ДиалогиАгента.ДатаНачала >= НАЧАЛОПЕРИОДА(&ДатаГруппы, ДЕНЬ)
		|	И СИ_ДиалогиАгента.ДатаНачала <= КОНЕЦПЕРИОДА(&ДатаГруппы, ДЕНЬ)
		|	И НЕ СИ_ДиалогиАгента.ПометкаУдаления";
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("ДатаГруппы", ДатаГруппы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Истина);
	ЗначенияЗаписиДиалога = Новый Структура;
	ЗначенияЗаписиДиалога.Вставить("ПометкаУдаления", Истина);
	ПараметрыЗаписиДиалога = Новый Структура;
	ПараметрыЗаписиДиалога.Вставить("ИмяОперации", "УдалениеДиалоговГруппы");
	Пока Выборка.Следующий() Цикл
		СИ_УправлениеДиалогом.ЗаписатьРеквизитыДиалога(Выборка.Ссылка, ЗначенияЗаписиДиалога,
			ПараметрыЗаписиДиалога);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
Исключение
	
	ЗаписьЖурналаРегистрации("ЧатАгента.УдалениеЧата", УровеньЖурналаРегистрации.Ошибка, ,
		, "Ошибка удаления диалогов группировки: " + ОписаниеОшибки());
	ВызватьИсключение "Не удалось удалить диалоги группировки: " + ОписаниеОшибки();
	
КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура УдалитьЧатНаСервере(Знач СсылкаНаЧат)

	Попытка

		ОбъектЧат = СсылкаНаЧат.ПолучитьОбъект();

		Если ОбъектЧат <> Неопределено Тогда
			Если ОбъектЧат.Пользователь <> ТекущийПользователь Тогда
				ВызватьИсключение "Нельзя удалить чужой чат.";
			КонецЕсли;

			УстановитьПривилегированныйРежим(Истина);
			ЗначенияЗаписиДиалога = Новый Структура;
			ЗначенияЗаписиДиалога.Вставить("ПометкаУдаления", Истина);
			ПараметрыЗаписиДиалога = Новый Структура;
			ПараметрыЗаписиДиалога.Вставить("ИмяОперации", "УдалениеДиалога");
			СИ_УправлениеДиалогом.ЗаписатьРеквизитыДиалога(СсылкаНаЧат, ЗначенияЗаписиДиалога,
				ПараметрыЗаписиДиалога);
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;

	Исключение

		ЗаписьЖурналаРегистрации("ЧатАгента.УдалениеЧата", УровеньЖурналаРегистрации.Ошибка, ,
			, "Ошибка удаления чата: " + ОписаниеОшибки());
		ВызватьИсключение "Не удалось удалить чат: " + ОписаниеОшибки();

	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПрокрутитьВнизНепосредственно()
	
	ДокументПоля = Элементы.ТекстИстории.Документ;
	
	Если ДокументПоля <> Неопределено И ДокументПоля.body <> Неопределено Тогда
		ДокументПоля.body.scrollTop = 99999999999999999;
	КонецЕсли;

КонецПроцедуры

// Поднимает JS-мост 1С -> документ истории чата: кэширует контекст окна
// страницы, через который вызываются функции из блока <script> документа
// (СИ_ЧатHTMLСервер.ПолучитьСкриптДокументаHTML).
//
// Мост нужен для инкрементального дописывания: он позволяет вставить новые
// сообщения прямо в загруженный документ, не переприсваивая реквизит
// ТекстИстории и не пересоздавая документ целиком.
//
// Свойство defaultView у типа ДокументHTML не документировано платформой
// (в перечне свойств типа его нет), поэтому доступность проверяется в
// рантайме, а parentWindow оставлен запасным вариантом. При недоступности
// обоих чат продолжает работать на резервном дописывании строкой.
&НаКлиенте
Процедура ИнициализироватьJSМост(Элемент)

	ОкноHTML = Неопределено;
	МостДоступен = Ложь;
	ПозицияХвостаHTML = 0;

	Попытка
		ДокументПоля = Элемент.Документ;
		Если ДокументПоля <> Неопределено Тогда
			ОкноHTML = ДокументПоля.defaultView;
			Если ОкноHTML = Неопределено Тогда
				ОкноHTML = ДокументПоля.parentWindow;
			КонецЕсли;
		КонецЕсли;
		МостДоступен = (ОкноHTML <> Неопределено);
	Исключение
		ОкноHTML = Неопределено;
		МостДоступен = Ложь;
	КонецПопытки;

	Если МостПредупреждениеВыдано = Неопределено Тогда
		МостПредупреждениеВыдано = Ложь;
	КонецЕсли;

	Если НЕ МостДоступен И НЕ МостПредупреждениеВыдано Тогда
		МостПредупреждениеВыдано = Истина;
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			"ЧатАгента.МостHTML", "Предупреждение",
			"JS-мост с документом истории недоступен - чат дописывает HTML строкой, "
			+ "документ перерисовывается целиком");
	КонецЕсли;

КонецПроцедуры

&НаСервере
// Обновляет индикаторы токенов формы. Данные читаются через запрос
// (ДанныеДиалогаДляФормы), без ПолучитьОбъект() — тяжёлые ТЧ и хранилища
// не поднимаются. В сценарии «выбор диалога» данные уже прочитаны одним
// запросом в ЗагрузитьЧатНаСервере и передаются параметром — повторный
// запрос не выполняется.
Процедура ОбновитьСтатистикуТокенов(Знач ДанныеДиалогаЗапроса = Неопределено)

	Если Не ЗначениеЗаполнено(АктивныйДиалог) Тогда
		ПотраченоТокенов = 0;
		ВсегоТокенов = 0;
		ТекстТокенов = "";
		Возврат;
	КонецЕсли;

	Попытка
		Если ДанныеДиалогаЗапроса = Неопределено Тогда
			ДанныеДиалогаЗапроса = ДанныеДиалогаДляФормы(АктивныйДиалог);
		КонецЕсли;

		ПотраченоТокенов = ДанныеДиалогаЗапроса.ПотраченоТокенов;
		ВсегоТокенов = ДанныеДиалогаЗапроса.ЛимитТокенов;
		ИсторияТокеновДиалога = Число(ДанныеДиалогаЗапроса.ИсторияТокенов);

		Если ВсегоТокенов > 0 Тогда
			ТекстТокенов = СтрШаблон("Израсходовано: %1 | История: %2 / %3",
				Формат(ПотраченоТокенов, "ЧГ="),
				Формат(ИсторияТокеновДиалога, "ЧГ="),
				Формат(ВсегоТокенов, "ЧГ="));
		Иначе
			ТекстТокенов = СтрШаблон("Израсходовано: %1 | История: %2",
				Формат(ПотраченоТокенов, "ЧГ="),
				Формат(ИсторияТокеновДиалога, "ЧГ="));
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЧатАгента.Токены", УровеньЖурналаРегистрации.Предупреждение, ,
			, "Ошибка чтения статистики токенов: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ДозаполнитьСсылкиДокументовДиалога()

	Если НЕ ЗначениеЗаполнено(АктивныйДиалог) Тогда
		Возврат;
	КонецЕсли;

	Если СсылкиДокументовПоНомерам = Неопределено Тогда
		СсылкиДокументовПоНомерам = Новый Соответствие;
	КонецЕсли;

	КартыПоНомерам = СИ_УправлениеДиалогом.ПолучитьСсылкиДокументовПоНомерам(АктивныйДиалог);
	Для Каждого КлючИЗначение Из КартыПоНомерам Цикл
		СсылкиДокументовПоНомерам.Вставить(Формат(КлючИЗначение.Ключ, "ЧДЦ=0; ЧГ=0"), КлючИЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция КартаСсылокСтрокиИстории(Знач Строка)

	Если СсылкиДокументовПоНомерам = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЗначениеНомера = Строка.НомерСообщения;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(ЗначениеНомера) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СсылкиДокументовПоНомерам.Получить(Формат(ЗначениеНомера, "ЧДЦ=0; ЧГ=0"));

КонецФункции

&НаСервере
Процедура ЗапомнитьСсылкиДокументовСообщения(Знач Сообщение)

	Если СсылкиДокументовПоНомерам = Неопределено Тогда
		СсылкиДокументовПоНомерам = Новый Соответствие;
	КонецЕсли;

	ЗначениеНомера = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "НомерСообщения", 0);
	Если ТипЗнч(ЗначениеНомера) <> Тип("Число") ИЛИ ЗначениеНомера < 0 Тогда
		Возврат;
	КонецЕсли;

	СсылкиДокументов = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "СсылкиДокументов", Неопределено);
	Если ТипЗнч(СсылкиДокументов) <> Тип("Массив") ИЛИ СсылкиДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СсылкиДокументовПоНомерам.Вставить(Формат(ЗначениеНомера, "ЧДЦ=0; ЧГ=0"), СсылкиДокументов);

КонецПроцедуры

&НаСервере
Процедура ЗапомнитьСсылкиДокументовНаСервере(Знач Строки)

	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Строки Цикл
		ЗапомнитьСсылкиДокументовСообщения(Строка);
	КонецЦикла;

КонецПроцедуры

