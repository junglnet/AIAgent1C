#Область ПрограммныйИнтерфейс

// Выполнение JSON-RPC 2.0 запроса к MCP-серверу через POST (streamable-http).
//
// Параметры:
//  СерверСсылка - СправочникСсылка.СИ_MCPСерверы - элемент справочника с настройками подключения.
//  Метод - Строка - имя JSON-RPC метода ("initialize", "tools/list", "tools/call", ...).
//  Параметры - Произвольный - параметры запроса (params).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Результат - Произвольный,Неопределено - значение result JSON-RPC.
//    * Ошибка - Строка,Неопределено - текст ошибки при Успех=Ложь.
//    * КодОшибки - Число,Строка,Неопределено - код ошибки JSON-RPC/HTTP.
//    * Сессия - Строка,Неопределено - MCP-Session-Id после инициализации.
Функция ВыполнитьЗапросJSONRPC(СерверСсылка, Метод, Параметры) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Результат", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);
	Результат.Вставить("КодОшибки", Неопределено);
	Результат.Вставить("Сессия", Неопределено);

	Попытка
		ДанныеСервера = ПолучитьДанныеСервера(СерверСсылка);
		Если НЕ ДанныеСервера.Найден Тогда
			Результат.Ошибка = "Не найден элемент справочника СИ_MCPСерверы";
			Возврат Результат;
		КонецЕсли;

		URL = СокрЛП(ДанныеСервера.URL);
		Если ПустаяСтрока(URL) Тогда
			Результат.Ошибка = "Не указан URL сервера";
			Возврат Результат;
		КонецЕсли;

		ВерсияПротокола = СокрЛП(ДанныеСервера.ВерсияПротокола);
		Если ПустаяСтрока(ВерсияПротокола) Тогда
			ВерсияПротокола = "2025-06-18";
		КонецЕсли;

		Соединение = СоздатьHTTPСоединение(ДанныеСервера);
		ПутьРесурса = ИзвлечьПутьРесурса(URL);

		Запрос = Новый HTTPЗапрос(ПутьРесурса);
		ПутьРесурса = ЗаполнитьЗаголовкиЗапроса(Запрос, ДанныеСервера, ПутьРесурса, ВерсияПротокола);

		Если ДанныеСервера.ТребуетИнициализацию И Метод <> "initialize" Тогда
			РезультатИнициализации = ВыполнитьInitialize(Соединение, Запрос, ДанныеСервера);
			Если НЕ РезультатИнициализации.Успех Тогда
				Результат.Ошибка = "Ошибка initialize: " + РезультатИнициализации.Ошибка;
				Результат.КодОшибки = РезультатИнициализации.КодОшибки;
				Возврат Результат;
			КонецЕсли;
			Сессия = РезультатИнициализации.Сессия;
			Если НЕ ПустаяСтрока(Сессия) Тогда
				Запрос.Заголовки.Вставить("MCP-Session-Id", Сессия);
			КонецЕсли;
			ВерсияСогласованная = СокрЛП(РезультатИнициализации.ВерсияПротокола);
			Если НЕ ПустаяСтрока(ВерсияСогласованная) И ВерсияСогласованная <> СокрЛП(ДанныеСервера.ВерсияПротокола) Тогда
				Попытка
					ОбъектСервера = СерверСсылка.ПолучитьОбъект();
					Если ОбъектСервера <> Неопределено Тогда
						ОбъектСервера.ВерсияПротокола = ВерсияСогласованная;
						ОбъектСервера.Записать();
					КонецЕсли;
				Исключение
					ЗаписьЖурналаРегистрации("Агент1С.ИнструментыMCP.СохранениеВерсииПротокола",
						УровеньЖурналаРегистрации.Предупреждение,,
						"Ошибка сохранения согласованной версии протокола: " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

		ИдЗапроса = "1c-" + Строка(Новый УникальныйИдентификатор);
		Тело = Новый Соответствие;
		Тело.Вставить("jsonrpc", "2.0");
		Тело.Вставить("id", ИдЗапроса);
		Тело.Вставить("method", Метод);
		Если Параметры <> Неопределено Тогда
			Тело.Вставить("params", Параметры);
		КонецЕсли;
		СтрокаТела = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Тело);
		Запрос.УстановитьТелоИзСтроки(СтрокаТела, КодировкаТекста.UTF8);

		HTTPОтвет = Соединение.ОтправитьДляОбработки(Запрос);
		Результат.КодОшибки = HTTPОтвет.КодСостояния;

		СессияОтвета = ПолучитьЗаголовокОтвета(HTTPОтвет, "mcp-session-id");
		Если НЕ ПустаяСтрока(СессияОтвета) Тогда
			Результат.Сессия = СессияОтвета;
		КонецЕсли;

		ТелоОтвета = "";
		Попытка
			ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
		Исключение
			ТелоОтвета = "";
		КонецПопытки;

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			РазобранныйОтвет = РазобратьОтветJSONRPC(ТелоОтвета, ИдЗапроса);
			Если РазобранныйОтвет.Успех Тогда
				Результат.Успех = Истина;
				Результат.Результат = РазобранныйОтвет.Результат;
			Иначе
				Результат.Ошибка = РазобранныйОтвет.Ошибка;
				Результат.КодОшибки = РазобранныйОтвет.КодОшибки;
			КонецЕсли;
		Иначе
			Результат.Ошибка = "HTTP " + Строка(HTTPОтвет.КодСостояния) + ": " + Лев(ТелоОтвета, 2000);
		КонецЕсли;

	Исключение
		Результат.Ошибка = "Ошибка JSON-RPC вызова: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Получение списка инструментов MCP-сервера через tools/list.
//
// Параметры:
//  СерверСсылка - СправочникСсылка.СИ_MCPСерверы - сервер.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Инструменты - Массив из Структура - [{Имя, Описание, СхемаПараметров}].
//    * Ошибка - Строка,Неопределено.
Функция ПолучитьИнструментыСервера(СерверСсылка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Инструменты", Новый Массив);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		Ответ = ВыполнитьЗапросJSONRPC(СерверСсылка, "tools/list", Неопределено);
		Если НЕ Ответ.Успех Тогда
			Результат.Ошибка = Ответ.Ошибка;
			Возврат Результат;
		КонецЕсли;

		Данные = Ответ.Результат;
		Если Данные = Неопределено Тогда
			Результат.Ошибка = "Пустой ответ tools/list";
			Возврат Результат;
		КонецЕсли;

		Инструменты = СИ_РаботаСJSON.БезопасноПолучить(Данные, "tools", Неопределено);
		Если Инструменты = Неопределено ИЛИ ТипЗнч(Инструменты) <> Тип("Массив") Тогда
			Результат.Ошибка = "В ответе tools/list нет массива tools";
			Возврат Результат;
		КонецЕсли;

		Для Каждого Инструмент Из Инструменты Цикл
			Имя = СИ_РаботаСJSON.БезопасноПолучить(Инструмент, "name", "");
			Если ПустаяСтрока(Имя) Тогда
				Продолжить;
			КонецЕсли;

			Описание = СИ_РаботаСJSON.БезопасноПолучить(Инструмент, "description", "");
			СхемаПараметров = СИ_РаботаСJSON.БезопасноПолучить(Инструмент, "inputSchema", Новый Соответствие);
			Аннотации = СИ_РаботаСJSON.БезопасноПолучить(Инструмент, "annotations", Неопределено);

			ОписаниеИнструмента = Новый Структура;
			ОписаниеИнструмента.Вставить("Имя", Имя);
			ОписаниеИнструмента.Вставить("Описание", Строка(Описание));
			ОписаниеИнструмента.Вставить("СхемаПараметров", СхемаПараметров);
			ОписаниеИнструмента.Вставить("Аннотации", Аннотации);
			Результат.Инструменты.Добавить(ОписаниеИнструмента);
		КонецЦикла;

		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = "Ошибка получения инструментов сервера: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Признак «запрашивать подтверждение пользователя» для НОВОГО инструмента MCP
// по аннотациям схемы (MCP annotations). Правило:
//  * destructiveHint = Истина - инструмент пишущий;
//  * иначе readOnlyHint = Истина - только чтение, разрешение не нужно;
//  * иначе (аннотации есть, но признака «только чтение» в них нет) - считаем
//    инструмент пишущим: по спецификации MCP readOnlyHint по умолчанию Ложь,
//    поэтому отсутствие признака означает потенциальную запись.
// Аннотации не переданы ВООБЩЕ - инструмент считается безопасным: запрашивать
// разрешение на каждый вызов внешнего сервера, который аннотаций не отдаёт,
// было бы навязчиво, администратор включает флаг вручную. Это единственное
// отклонение от спецификации, и оно касается только таких серверов.
//
// Параметры:
//  ОписаниеИнструмента - Структура,Неопределено - дескриптор из ПолучитьИнструментыСервера.
//
// Возвращаемое значение:
//  Булево - Истина, если для инструмента следует запрашивать подтверждение.
Функция ТребуетРазрешенияПоИнструменту(ОписаниеИнструмента) Экспорт

	Аннотации = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Аннотации", Неопределено);
	Если Аннотации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Разрушительный = СИ_РаботаСJSON.БезопасноПолучить(Аннотации, "destructiveHint", Неопределено);
	Если Разрушительный = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	ТолькоЧтение = СИ_РаботаСJSON.БезопасноПолучить(Аннотации, "readOnlyHint", Неопределено);
	Возврат ТолькоЧтение <> Истина;

КонецФункции

// Проверка подключения к MCP-серверу: initialize + tools/list.
// Обновляет реквизиты диагностики элемента справочника и записывает его.
//
// Параметры:
//  СерверСсылка - СправочникСсылка.СИ_MCPСерверы - сервер.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Сообщение - Строка - человекочитаемый результат.
//    * КоличествоИнструментов - Число.
//    * ДатаПоследнейПроверки - Дата - дата и время проверки.
Функция ПроверитьПодключение(СерверСсылка) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("КоличествоИнструментов", 0);
	
	Результат.Вставить("ДатаПоследнейПроверки", ТекущаяДатаСеанса());

	Попытка
		ДанныеСервера = ПолучитьИнструментыСервера(СерверСсылка);

		ОбъектСервера = СерверСсылка.ПолучитьОбъект();
		Если ОбъектСервера = Неопределено Тогда
			Результат.Сообщение = "Не найден элемент справочника";
			Возврат Результат;
		КонецЕсли;

		ОбъектСервера.ДатаПоследнейПроверки = ТекущаяДатаСеанса();
		Если ДанныеСервера.Успех Тогда
			Результат.Успех = Истина;
			Результат.КоличествоИнструментов = ДанныеСервера.Инструменты.Количество();
			Результат.Сообщение = "Подключение успешно. Инструментов на сервере: " + Строка(Результат.КоличествоИнструментов);
			ОбъектСервера.РезультатПоследнейПроверки = Результат.Сообщение;
		Иначе
			Результат.Сообщение = "Ошибка подключения: " + ДанныеСервера.Ошибка;
			ОбъектСервера.РезультатПоследнейПроверки = Результат.Сообщение;
		КонецЕсли;

		ОбъектСервера.Записать();

		Результат.ДатаПоследнейПроверки = ОбъектСервера.ДатаПоследнейПроверки;
	Исключение
		Результат.Сообщение = "Ошибка проверки подключения: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Загрузка выбранных инструментов в ТЧ Инструменты/РежимыИнструментов справочника.
// Для каждого выбранного инструмента обновляет/создаёт строку ТЧ Инструменты
// и перезаписывает режимы в ТЧ РежимыИнструментов.
//
// Параметры:
//  СерверСсылка - СправочникСсылка.СИ_MCPСерверы - сервер.
//  ВыбранныеИнструменты - Массив из Структура - [{Имя, Описание, СхемаПараметров, Режимы}],
//    где Режимы - Массив из СправочникСсылка.СИ_РежимиРаботы.
//  ОчиститьОтсутствующие - Булево - при Истина снимает Разрешен с инструментов,
//    которые не попали в ВыбранныеИнструменты.
//
// Возвращаемое значение:
//  Булево - Истина при успешной синхронизации.
Функция ЗагрузитьИнструменты(СерверСсылка, ВыбранныеИнструменты, ОчиститьОтсутствующие) Экспорт
	Попытка
		ОбъектСервера = СерверСсылка.ПолучитьОбъект();
		Если ОбъектСервера = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		ВыбранныеИмена = Новый Соответствие;
		Для Каждого Выбранный Из ВыбранныеИнструменты Цикл
			Имя = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Имя", "");
			Если ПустаяСтрока(Имя) Тогда
				Продолжить;
			КонецЕсли;
			ВыбранныеИмена.Вставить(НРег(Имя), Выбранный);
		КонецЦикла;

		НайденныеСтроки = Новый Соответствие;
		Для Каждого СтрокаТЧ Из ОбъектСервера.Инструменты Цикл
			ИмяИнструмента = СтрокаТЧ.ИмяИнструмента;
			Если ВыбранныеИмена.Получить(НРег(ИмяИнструмента)) <> Неопределено Тогда
				Выбранный = ВыбранныеИмена.Получить(НРег(ИмяИнструмента));
				СтрокаТЧ.Описание = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Описание", "");
				СтрокаТЧ.ПараметрыSchema = ПолучитьСхемуПараметров(Выбранный);
				СтрокаТЧ.Разрешен = Истина;
				НайденныеСтроки.Вставить(НРег(ИмяИнструмента), СтрокаТЧ);
			ИначеЕсли ОчиститьОтсутствующие Тогда
				СтрокаТЧ.Разрешен = Ложь;
			КонецЕсли;
		КонецЦикла;

		Для Каждого Выбранный Из ВыбранныеИнструменты Цикл
			Имя = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Имя", "");
			Если ПустаяСтрока(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Если НайденныеСтроки.Получить(НРег(Имя)) = Неопределено Тогда
				НоваяСтрока = ОбъектСервера.Инструменты.Добавить();
				НоваяСтрока.ИмяИнструмента = Имя;
				НоваяСтрока.Описание = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Описание", "");
				НоваяСтрока.ПараметрыSchema = ПолучитьСхемуПараметров(Выбранный);
				НоваяСтрока.Разрешен = Истина;
				НоваяСтрока.ТребуетРазрешения = ТребуетРазрешенияПоИнструменту(Выбранный);
				НоваяСтрока.ДатаРегистрации = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЦикла;

		ИндексыНаУдаление = Новый Массив;
		Для Индекс = 0 По ОбъектСервера.РежимыИнструментов.Количество() - 1 Цикл
			ИмяРежима = ОбъектСервера.РежимыИнструментов[Индекс].Инструмент;
			Если ВыбранныеИмена.Получить(НРег(ИмяРежима)) <> Неопределено Тогда
				ИндексыНаУдаление.Добавить(Индекс);
			КонецЕсли;
		КонецЦикла;
		ИндексУдаления = ИндексыНаУдаление.ВГраница();
		Пока ИндексУдаления >= 0 Цикл
			ОбъектСервера.РежимыИнструментов.Удалить(ИндексыНаУдаление[ИндексУдаления]);
			ИндексУдаления = ИндексУдаления - 1;
		КонецЦикла;

		Для Каждого Выбранный Из ВыбранныеИнструменты Цикл
			Имя = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Имя", "");
			Если ПустаяСтрока(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Режимы = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Режимы", Неопределено);
			Если Режимы <> Неопределено И ТипЗнч(Режимы) = Тип("Массив") Тогда
				Для Каждого РежимСсылка Из Режимы Цикл
					Если ТипЗнч(РежимСсылка) = Тип("СправочникСсылка.СИ_РежимиРаботы") И ЗначениеЗаполнено(РежимСсылка) Тогда
						НоваяСтрока = ОбъектСервера.РежимыИнструментов.Добавить();
						НоваяСтрока.Инструмент = Имя;
						НоваяСтрока.Режим = РежимСсылка;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

		ОбъектСервера.Записать();
		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ИнструментыMCP.ЗагрузитьИнструменты", УровеньЖурналаРегистрации.Ошибка,
			,, "Ошибка загрузки инструментов: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Вызов инструмента MCP через tools/call.
//
// Параметры:
//  СерверСсылка - СправочникСсылка.СИ_MCPСерверы - сервер.
//  ИмяИнструмента - Строка - имя инструмента (поле name).
//  Аргументы - Произвольный - аргументы вызова.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Результат - Строка - текстовое содержимое результата (склеенные text-контенты).
//      Image-контенты в текст НЕ включаются: вместо base64 кладётся метка
//      "[Изображение: <mime>]", чтобы не раздувать контекст модели.
//    * Изображения - Массив из Структура - изображения из image-контентов ответа:
//      ** ДанныеBase64 - Строка - содержимое data без префикса "data:...;base64,".
//      ** MIME - Строка - mimeType из ответа (по умолчанию "image/png", если не задан).
//    * ОшибкаИсполнения - Строка,Неопределено.
Функция ВызватьИнструмент(СерверСсылка, ИмяИнструмента, Аргументы) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Результат", "");
	Результат.Вставить("Изображения", Новый Массив);
	Результат.Вставить("ОшибкаИсполнения", Неопределено);

	Попытка
		ПараметрыВызова = Новый Соответствие;
		ПараметрыВызова.Вставить("name", ИмяИнструмента);

		АргументыДляПередачи = Аргументы;
		Если АргументыДляПередачи = Неопределено Тогда
			АргументыДляПередачи = Новый Соответствие;
		ИначеЕсли ТипЗнч(АргументыДляПередачи) = Тип("Структура") Тогда
			АргументыДляПередачи = СИ_РаботаСJSON.СтруктуруВСоответствие(АргументыДляПередачи);
		КонецЕсли;
		ПараметрыВызова.Вставить("arguments", АргументыДляПередачи);

		Ответ = ВыполнитьЗапросJSONRPC(СерверСсылка, "tools/call", ПараметрыВызова);
		Если НЕ Ответ.Успех Тогда
			Результат.ОшибкаИсполнения = Ответ.Ошибка;
			Возврат Результат;
		КонецЕсли;

		Данные = Ответ.Результат;
		Если Данные = Неопределено Тогда
			Результат.ОшибкаИсполнения = "Пустой ответ tools/call";
			Возврат Результат;
		КонецЕсли;

		Содержимое = СИ_РаботаСJSON.БезопасноПолучить(Данные, "content", Неопределено);
		Тексты = Новый Массив;
		Если Содержимое <> Неопределено И ТипЗнч(Содержимое) = Тип("Массив") Тогда
			Для Каждого Часть Из Содержимое Цикл
				ТипЧасти = СИ_РаботаСJSON.БезопасноПолучить(Часть, "type", "");
				Если ТипЧасти = "text" Тогда
					Тексты.Добавить(СИ_РаботаСJSON.БезопасноПолучить(Часть, "text", ""));
				ИначеЕсли ТипЧасти = "image" Тогда
					ДанныеBase64 = Строка(СИ_РаботаСJSON.БезопасноПолучить(Часть, "data", ""));
					MIME = Строка(СИ_РаботаСJSON.БезопасноПолучить(Часть, "mimeType", "image/png"));
					Если ПустаяСтрока(MIME) Тогда
						MIME = "image/png";
					КонецЕсли;

					ПозицияМаркера = СтрНайти(ДанныеBase64, ";base64,");
					Если ПозицияМаркера > 0 Тогда
						ДанныеBase64 = Сред(ДанныеBase64, ПозицияМаркера + СтрДлина(";base64,"));
					КонецЕсли;

					Если НЕ ПустаяСтрока(ДанныеBase64) Тогда
						ОписаниеИзображения = Новый Структура("ДанныеBase64, MIME", ДанныеBase64, MIME);
						Результат.Изображения.Добавить(ОписаниеИзображения);
					КонецЕсли;

					Тексты.Добавить("[Изображение: " + MIME + "]");
				Иначе
					СерийноеПредставление = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Часть);
					Если НЕ ПустаяСтрока(СерийноеПредставление) Тогда
						Тексты.Добавить(СерийноеПредставление);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		ЭтоОшибка = СИ_РаботаСJSON.БезопасноПолучить(Данные, "isError", Ложь);

		Результат.Результат = СтрСоединить(Тексты, Символы.ПС);
		Если ЭтоОшибка Тогда
			Результат.ОшибкаИсполнения = ?(ПустаяСтрока(Результат.Результат), "Инструмент вернул ошибку", Результат.Результат);
		Иначе
			Результат.Успех = Истина;
		КонецЕсли;

	Исключение
		Результат.ОшибкаИсполнения = "Ошибка вызова MCP-инструмента: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Чтение настроек элемента справочника СИ_MCPСерверы запросом.
// Возвращает структуру без получения объекта (ПолучитьОбъект) - только для чтения.
//
// Возвращаемое значение:
//  Структура:
//    * Найден - Булево - Истина, если элемент существует и данные прочитаны.
//    * URL - Строка.
//    * ВерсияПротокола - Строка.
//    * ЗаголовкиJSON - Строка.
//    * ИспользоватьАвторизацию - Булево.
//    * ТипАвторизации - ПеречислениеСсылка.СИ_ТипыАвторизации,Неопределено.
//    * ЗначениеАвторизации - Строка.
//    * ТребуетИнициализацию - Булево.
//    * ПроверятьSSL - Булево.
//    * ТаймаутВызова - Число.
Функция ПолучитьДанныеСервера(СерверСсылка)
	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("URL", "");
	Результат.Вставить("ВерсияПротокола", "");
	Результат.Вставить("ЗаголовкиJSON", "");
	Результат.Вставить("ИспользоватьАвторизацию", Ложь);
	Результат.Вставить("ТипАвторизации", Неопределено);
	Результат.Вставить("ЗначениеАвторизации", "");
	Результат.Вставить("ТребуетИнициализацию", Ложь);
	Результат.Вставить("ПроверятьSSL", Ложь);
	Результат.Вставить("ТаймаутВызова", 0);

	Если СерверСсылка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СерверСсылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СИ_MCPСерверы.URL КАК URL,
			|	СИ_MCPСерверы.ВерсияПротокола КАК ВерсияПротокола,
			|	СИ_MCPСерверы.ЗаголовкиJSON КАК ЗаголовкиJSON,
			|	СИ_MCPСерверы.ИспользоватьАвторизацию КАК ИспользоватьАвторизацию,
			|	СИ_MCPСерверы.ТипАвторизации КАК ТипАвторизации,
			|	СИ_MCPСерверы.ЗначениеАвторизации КАК ЗначениеАвторизации,
			|	СИ_MCPСерверы.ТребуетИнициализацию КАК ТребуетИнициализацию,
			|	СИ_MCPСерверы.ПроверятьSSL КАК ПроверятьSSL,
			|	СИ_MCPСерверы.ТаймаутВызова КАК ТаймаутВызова
			|ИЗ
			|	Справочник.СИ_MCPСерверы КАК СИ_MCPСерверы
			|ГДЕ
			|	СИ_MCPСерверы.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", СерверСсылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат Результат;
		КонецЕсли;

		Результат.Найден = Истина;
		Результат.URL = Строка(Выборка.URL);
		Результат.ВерсияПротокола = Строка(Выборка.ВерсияПротокола);
		Результат.ЗаголовкиJSON = Строка(Выборка.ЗаголовкиJSON);
		Результат.ИспользоватьАвторизацию = Выборка.ИспользоватьАвторизацию;
		Результат.ТипАвторизации = Выборка.ТипАвторизации;
		Результат.ЗначениеАвторизации = Строка(Выборка.ЗначениеАвторизации);
		Результат.ТребуетИнициализацию = Выборка.ТребуетИнициализацию;
		Результат.ПроверятьSSL = Выборка.ПроверятьSSL;
		Результат.ТаймаутВызова = Выборка.ТаймаутВызова;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ИнструментыMCP.ПолучитьДанныеСервера",
			УровеньЖурналаРегистрации.Ошибка,,, "Ошибка чтения данных сервера: " + ОписаниеОшибки());
		Результат.Найден = Ложь;
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Нормализация схемы параметров инструмента в JSON-строку.
// Принимает Соответствие/Структуру (СхемаПараметров) или готовую JSON-строку (СхемаПараметровJSON).
Функция ПолучитьСхемуПараметров(Выбранный)
	СхемаПараметров = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "СхемаПараметров", Неопределено);
	Если СхемаПараметров <> Неопределено Тогда
		Возврат СИ_РаботаСJSON.ЗаписатьСтрокуJSON(СхемаПараметров);
	КонецЕсли;

	СхемаJSON = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "СхемаПараметровJSON", "");
	Если НЕ ПустаяСтрока(СхемаJSON) Тогда
		Распарс = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(СхемаJSON);
		Если Распарс <> Неопределено Тогда
			Возврат СхемаJSON;
		КонецЕсли;
	КонецЕсли;

	Возврат "{}";
КонецФункции

// Регистронезависимое чтение заголовка HTTP-ответа.
// Поиск в HTTPЗаголовки (Соответствие) чувствителен к регистру ключей,
// а серверы возвращают имена заголовков в любом регистре
// (например "Mcp-Session-Id" или "mcp-session-id").
//
// Параметры:
//  HTTPОтвет - HTTPОтвет - ответ сервера.
//  ИмяЗаголовка - Строка - имя заголовка в нижнем регистре.
//
// Возвращаемое значение:
//  Строка - значение заголовка, пустая строка если не найден.
Функция ПолучитьЗаголовокОтвета(HTTPОтвет, ИмяЗаголовка)
	Результат = "";
	Попытка
		Для Каждого Заголовок Из HTTPОтвет.Заголовки Цикл
			Если НРег(Заголовок.Ключ) = НРег(ИмяЗаголовка) Тогда
				Результат = Строка(Заголовок.Значение);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Результат = "";
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Отправка уведомления notifications/initialized после успешного initialize.
// Уведомление не имеет id и не требует ответа (сервер вернёт 202) - ошибки
// не фатальны и не прерывают основной вызов.
//
// Параметры:
//  Соединение - HTTPСоединение - открытое соединение с сервером.
//  ЗапросШаблон - HTTPЗапрос - шаблон запроса с адресом ресурса и заголовками.
//  Сессия - Строка - идентификатор сессии Mcp-Session-Id.
Процедура ОтправитьУведомлениеИнициализации(Соединение, ЗапросШаблон, Сессия)
	Попытка
		Уведомление = Новый Соответствие;
		Уведомление.Вставить("jsonrpc", "2.0");
		Уведомление.Вставить("method", "notifications/initialized");

		Заголовки = Новый Соответствие;
		Для Каждого Заголовок Из ЗапросШаблон.Заголовки Цикл
			Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
		КонецЦикла;
		Заголовки.Вставить("Mcp-Session-Id", Сессия);

		ЗапросУведомления = Новый HTTPЗапрос(ЗапросШаблон.АдресРесурса, Заголовки);
		ЗапросУведомления.УстановитьТелоИзСтроки(
			СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Уведомление), КодировкаТекста.UTF8);

		Соединение.ОтправитьДляОбработки(ЗапросУведомления);
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ИнструментыMCP.УведомлениеИнициализации",
			УровеньЖурналаРегистрации.Предупреждение,,
			"Ошибка отправки notifications/initialized: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Выполнение JSON-RPC метода initialize (рукопожатие MCP).
// Возвращает структуру {Успех, Сессия, ВерсияПротокола, Ошибка, КодОшибки}.
Функция ВыполнитьInitialize(Соединение, ЗапросШаблон, ДанныеСервера)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сессия", Неопределено);
	Результат.Вставить("ВерсияПротокола", "");
	Результат.Вставить("Ошибка", Неопределено);
	Результат.Вставить("КодОшибки", Неопределено);

	Попытка
		ВерсияПротокола = СокрЛП(ДанныеСервера.ВерсияПротокола);
		Если ПустаяСтрока(ВерсияПротокола) Тогда
			ВерсияПротокола = "2025-06-18";
		КонецЕсли;

		ПараметрыInitialize = Новый Соответствие;
		ПараметрыInitialize.Вставить("protocolVersion", ВерсияПротокола);
		ПараметрыInitialize.Вставить("capabilities", Новый Соответствие);
		КлиентИнфо = Новый Соответствие;
		КлиентИнфо.Вставить("name", "AIAgent");
		КлиентИнфо.Вставить("version", "1.0");
		ПараметрыInitialize.Вставить("clientInfo", КлиентИнфо);

		ИдЗапроса = "1c-init-" + Строка(Новый УникальныйИдентификатор);
		Тело = Новый Соответствие;
		Тело.Вставить("jsonrpc", "2.0");
		Тело.Вставить("id", ИдЗапроса);
		Тело.Вставить("method", "initialize");
		Тело.Вставить("params", ПараметрыInitialize);

		Заголовки = Новый Соответствие;
		Для Каждого Заголовок Из ЗапросШаблон.Заголовки Цикл
			Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
		КонецЦикла;
		Запрос = Новый HTTPЗапрос(ЗапросШаблон.АдресРесурса, Заголовки);
		Запрос.Заголовки.Вставить("MCP-Protocol-Version", ВерсияПротокола);
		Запрос.УстановитьТелоИзСтроки(СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Тело), КодировкаТекста.UTF8);

		HTTPОтвет = Соединение.ОтправитьДляОбработки(Запрос);
		Результат.КодОшибки = HTTPОтвет.КодСостояния;

		СессияОтвета = ПолучитьЗаголовокОтвета(HTTPОтвет, "mcp-session-id");
		Если НЕ ПустаяСтрока(СессияОтвета) Тогда
			Результат.Сессия = СессияОтвета;
		КонецЕсли;

		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Разобранный = РазобратьОтветJSONRPC(ТелоОтвета, ИдЗапроса);
			Если Разобранный.Успех Тогда
				Результат.Успех = Истина;
				СогласованнаяВерсия = "";
				Попытка
					СогласованнаяВерсия = СИ_РаботаСJSON.БезопасноПолучить(
						СИ_РаботаСJSON.БезопасноПолучить(Разобранный.Результат, "protocolVersion", Неопределено),
						"", "");
					Если ПустаяСтрока(СогласованнаяВерсия) Тогда
						ЗначениеВерсии = СИ_РаботаСJSON.БезопасноПолучить(Разобранный.Результат, "protocolVersion", "");
						Если ТипЗнч(ЗначениеВерсии) = Тип("Строка") Тогда
							СогласованнаяВерсия = ЗначениеВерсии;
						КонецЕсли;
					КонецЕсли;
				Исключение
					СогласованнаяВерсия = "";
				КонецПопытки;
				Если НЕ ПустаяСтрока(СогласованнаяВерсия) Тогда
					Результат.ВерсияПротокола = СогласованнаяВерсия;
				КонецЕсли;
			Иначе
				Результат.Ошибка = Разобранный.Ошибка;
			КонецЕсли;

			Если Результат.Успех И НЕ ПустаяСтрока(Результат.Сессия) Тогда
				ОтправитьУведомлениеИнициализации(Соединение, ЗапросШаблон, Результат.Сессия);
			КонецЕсли;
		Иначе
			Результат.Ошибка = "HTTP " + Строка(HTTPОтвет.КодСостояния) + ": " + Лев(ТелоОтвета, 1000);
		КонецЕсли;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Разбор JSON-RPC ответа: извлечение result или error.
//
// Возвращаемое значение:
//  Структура - структура с полями:
//    * Успех - Булево.
//    * Результат - Произвольный,Неопределено - значение result JSON-RPC.
//    * Ошибка - Строка,Неопределено - текст ошибки.
//    * КодОшибки - Произвольный,Неопределено - код ошибки.
Функция РазобратьОтветJSONRPC(Тело, ИдЗапроса)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Результат", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);
	Результат.Вставить("КодОшибки", Неопределено);

	Попытка
		Если ПустаяСтрока(Тело) Тогда
			Результат.Ошибка = "Пустое тело ответа";
			Возврат Результат;
		КонецЕсли;

		Данные = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(Тело);

		Кандидаты = Новый Массив;
		Если Данные <> Неопределено Тогда
			Кандидаты.Добавить(Данные);
		Иначе
			Кандидаты = СИ_РаботаСJSON.ИзвлечьJSONИзSSE(Тело);
		КонецЕсли;

		Если Кандидаты.Количество() = 0 Тогда
			Результат.Ошибка = "Не удалось разобрать JSON ответа";
			Возврат Результат;
		КонецЕсли;

		Данные = ВыбратьСообщениеJSONRPC(Кандидаты, ИдЗапроса);
		Если Данные = Неопределено Тогда
			Результат.Ошибка = "В ответе не найдено JSON-RPC сообщение";
			Возврат Результат;
		КонецЕсли;

		ОшибкаJSONRPC = СИ_РаботаСJSON.БезопасноПолучить(Данные, "error", Неопределено);
		Если ОшибкаJSONRPC <> Неопределено Тогда
			Результат.КодОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаJSONRPC, "code", Неопределено);
			Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаJSONRPC, "message", "Ошибка JSON-RPC");
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;
		Результат.Результат = СИ_РаботаСJSON.БезопасноПолучить(Данные, "result", Неопределено);
	Исключение
		Результат.Ошибка = "Ошибка разбора JSON-RPC: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Выбор JSON-RPC сообщения из массива кандидатов по совпадающему id.
// Если совпадений нет - возвращает первое одиночное (не массив) сообщение.
Функция ВыбратьСообщениеJSONRPC(Кандидаты, ИдЗапроса)
	Первое = Неопределено;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ТипЗнч(Кандидат) = Тип("Массив") Тогда
			Для Каждого Сообщение Из Кандидат Цикл
				Если СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "id", "") = ИдЗапроса Тогда
					Возврат Сообщение;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если Первое = Неопределено Тогда
				Первое = Кандидат;
			КонецЕсли;
			Если СИ_РаботаСJSON.БезопасноПолучить(Кандидат, "id", "") = ИдЗапроса Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Первое;
КонецФункции

// Создание HTTP-соединения к MCP-серверу по его настройкам.
// Переиспользует логику из СИ_ОpenAIКлиент (прокси/таймаут/SSL берутся из активного профиля).
// Принимает структуру ПолучитьДанныеСервера (не объект справочника).
Функция СоздатьHTTPСоединение(ДанныеСервера)
	URL = СокрЛП(ДанныеСервера.URL);
	Хост = URL;
	Порт = 443;
	ИспользоватьSSL = Истина;

	Если СтрНайти(Хост, "://") > 0 Тогда
		Схема = Лев(Хост, СтрНайти(Хост, "://") - 1);
		Хост = Сред(Хост, СтрНайти(Хост, "://") + 3);
		Если Схема = "http" Тогда
			ИспользоватьSSL = Ложь;
			Порт = 80;
		КонецЕсли;
	КонецЕсли;

	Если СтрНайти(Хост, ":") > 0 Тогда
		ПозицияДвоеточия = СтрНайти(Хост, ":");
		ПортСтрока = Сред(Хост, ПозицияДвоеточия + 1);
		Если СтрНайти(ПортСтрока, "/") > 0 Тогда
			ПортСтрока = Лев(ПортСтрока, СтрНайти(ПортСтрока, "/") - 1);
		КонецЕсли;
		Попытка
			Порт = Число(ПортСтрока);
		Исключение
			Порт = ?(ИспользоватьSSL, 443, 80);
		КонецПопытки;
		Хост = Лев(Хост, ПозицияДвоеточия - 1);
	КонецЕсли;

	Если СтрНайти(Хост, "/") > 0 Тогда
		Хост = Лев(Хост, СтрНайти(Хост, "/") - 1);
	КонецЕсли;

	Настройки = Неопределено;
	Попытка
		Настройки = СИ_НастройкиАгента.ПолучитьНастройки();
	Исключение
		Настройки = Неопределено;
	КонецПопытки;

	Таймаут = 60;
	Если ДанныеСервера.ТаймаутВызова > 0 Тогда
		Таймаут = ДанныеСервера.ТаймаутВызова;
	ИначеЕсли Настройки <> Неопределено Тогда
		Таймаут = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "Таймаут", 60);
	КонецЕсли;

	ИспользоватьПрокси = Неопределено;
	Если Настройки <> Неопределено Тогда
		Прокси = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "Прокси", Неопределено);
		Если Прокси <> Неопределено Тогда
			ПроксиСервер = СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Сервер", "");
			Если НЕ ПустаяСтрока(ПроксиСервер) Тогда
				ПроксиПорт = СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Порт", 8080);
				ПроксиПользователь = СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Пользователь", Неопределено);
				ПроксиПароль = СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Пароль", Неопределено);
				ИспользоватьПрокси = Новый ИнтернетПрокси(Ложь);
				ИспользоватьПрокси.Установить("http", ПроксиСервер, ПроксиПорт, ПроксиПользователь, ПроксиПароль);
				ИспользоватьПрокси.Установить("https", ПроксиСервер, ПроксиПорт, ПроксиПользователь, ПроксиПароль);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ЗащищенноеСоединение = Неопределено;
	Если ИспользоватьSSL И ДанныеСервера.ПроверятьSSL Тогда
		Попытка
			ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
		Исключение
			ЗащищенноеСоединение = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ИспользоватьПрокси <> Неопределено Тогда
		Возврат Новый HTTPСоединение(Хост, Порт,,, ИспользоватьПрокси, Таймаут, ЗащищенноеСоединение);
	Иначе
		Возврат Новый HTTPСоединение(Хост, Порт,,,, Таймаут, ЗащищенноеСоединение);
	КонецЕсли;
КонецФункции

// Извлечение пути ресурса из полного URL (после хоста), включая query-строку.
Функция ИзвлечьПутьРесурса(URL)
	ПутьРесурса = URL;
	Если СтрНачинаетсяС(ПутьРесурса, "https://") Тогда
		ПутьРесурса = Сред(ПутьРесурса, 9);
	ИначеЕсли СтрНачинаетсяС(ПутьРесурса, "http://") Тогда
		ПутьРесурса = Сред(ПутьРесурса, 8);
	КонецЕсли;
	ПозицияПервогоСлеша = СтрНайти(ПутьРесурса, "/");
	Если ПозицияПервогоСлеша > 0 Тогда
		ПутьРесурса = Сред(ПутьРесурса, ПозицияПервогоСлеша);
	Иначе
		ПутьРесурса = "/";
	КонецЕсли;
	Возврат ПутьРесурса;
КонецФункции

// Заполнение HTTP-запроса базовыми и кастомными заголовками, а также авторизацией.
// Возвращает уточнённый путь ресурса (для авторизации "ключ в URL").
//
// Параметры:
//  Запрос - HTTPЗапрос - запрос, в который добавляются заголовки.
//  ДанныеСервера - Структура - данные сервера (ПолучитьДанныеСервера).
//  ПутьРесурса - Строка - исходный путь ресурса (может быть изменён).
//  ВерсияПротокола - Строка - версия протокола MCP.
//
// Возвращаемое значение:
//  Строка - актуальный путь ресурса (с query-параметром авторизации при необходимости).
Функция ЗаполнитьЗаголовкиЗапроса(Запрос, ДанныеСервера, ПутьРесурса, ВерсияПротокола)
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.Заголовки.Вставить("Accept", "application/json, text/event-stream");
	Запрос.Заголовки.Вставить("MCP-Protocol-Version", ВерсияПротокола);

	ДопЗаголовки = РазобратьЗаголовки(ДанныеСервера.ЗаголовкиJSON);
	Если ДопЗаголовки <> Неопределено Тогда
		Для Каждого КлючЗначение Из ДопЗаголовки Цикл
			Запрос.Заголовки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Если ДанныеСервера.ИспользоватьАвторизацию Тогда
		ТипАвторизации = ДанныеСервера.ТипАвторизации;
		Значение = СокрЛП(ДанныеСервера.ЗначениеАвторизации);
		Если НЕ ПустаяСтрока(Значение) Тогда
			Если ТипАвторизации = Перечисления.СИ_ТипыАвторизации.Bearer Тогда
				Запрос.Заголовки.Вставить("Authorization", "Bearer " + Значение);
			ИначеЕсли ТипАвторизации = Перечисления.СИ_ТипыАвторизации.КлючВЗаголовке Тогда
				ПозицияДвоеточия = СтрНайти(Значение, ":");
				Если ПозицияДвоеточия > 0 Тогда
					ИмяЗаголовка = СокрЛП(Лев(Значение, ПозицияДвоеточия - 1));
					ЗначениеЗаголовка = СокрЛП(Сред(Значение, ПозицияДвоеточия + 1));
					Если НЕ ПустаяСтрока(ИмяЗаголовка) Тогда
						Запрос.Заголовки.Вставить(ИмяЗаголовка, ЗначениеЗаголовка);
					КонецЕсли;
				Иначе
					Запрос.Заголовки.Вставить("X-Api-Key", Значение);
				КонецЕсли;
			ИначеЕсли ТипАвторизации = Перечисления.СИ_ТипыАвторизации.КлючВURL Тогда
				Разделитель = "?";
				Если СтрНайти(ПутьРесурса, "?") > 0 Тогда
					Разделитель = "&";
				КонецЕсли;
				ПутьРесурса = ПутьРесурса + Разделитель + "api_key=" + ЗакодироватьURL(Значение);
				Запрос.АдресРесурса = ПутьРесурса;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат ПутьРесурса;
КонецФункции

// Разбор строки ЗаголовкиJSON в Соответствие заголовков.
Функция РазобратьЗаголовки(ЗаголовкиJSON)
	Если ПустаяСтрока(ЗаголовкиJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Данные = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ЗаголовкиJSON);
		Если Данные <> Неопределено И (ТипЗнч(Данные) = Тип("Соответствие") ИЛИ ТипЗнч(Данные) = Тип("Структура")) Тогда
			Результат = Новый Соответствие;
			Для Каждого КлючЗначение Из Данные Цикл
				Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
			Возврат Результат;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// URL-кодирование строки для безопасного включения в URL (query-параметры).
Функция ЗакодироватьURL(Значение)
	Результат = "";
	Для Поз = 1 По СтрДлина(Значение) Цикл
		Симв = Сред(Значение, Поз, 1);
		КодСимв = КодСимвола(Симв);
		Если (КодСимв >= 97 И КодСимв <= 122)
			ИЛИ (КодСимв >= 65 И КодСимв <= 90)
			ИЛИ (КодСимв >= 48 И КодСимв <= 57)
			ИЛИ КодСимв = 45
			ИЛИ КодСимв = 46
			ИЛИ КодСимв = 95
			ИЛИ КодСимв = 126
		Тогда
			Результат = Результат + Симв;
		Иначе
			Результат = Результат + "%" + Формат(КодСимв, "ЧГ=");
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
