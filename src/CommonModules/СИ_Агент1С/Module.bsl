// Порог числа доступных инструментов, после которого включается каталог
// (виртуальный fetch_toolset). Ниже порога поведение прежнее: модели передаются
// все доступные инструменты - каталог на маленьком наборе только мешает.
//
// Возвращаемое значение:
//  Число - порог каталога.
Функция ПорогКаталогаИнструментов()
	Возврат 25;
КонецФункции

// Все инструменты, доступные в режиме захода, с кэшем на заход: один запрос
// к справочнику инструментов и МCP-серверам вместо запроса на каждый шаг
// (набор доступных инструментов внутри захода не меняется, а подгруженные
// через fetch_toolset имена живут отдельным списком - см.
// ДополнительныеИнструментыЗахода).
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//
// Возвращаемое значение:
//  Структура - кэш доступных инструментов:
//    * Описания - Массив из Структура - описания в порядке реестра;
//    * ПоИмени - Соответствие из Строка, Структура - ключ НРег(имя).
Функция ИнструментыЗахода(КонтекстЦикла)

	Кэш = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "КэшИнструментовЗахода", Неопределено);
	Если ТипЗнч(Кэш) = Тип("Структура") Тогда
		Возврат Кэш;
	КонецЕсли;

	РежимСсылка = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "РежимСсылка", Неопределено);
	Фильтр = Неопределено;
	Если РежимСсылка <> Неопределено Тогда
		Фильтр = Новый Структура("РазрешенныйРежим", РежимСсылка);
	КонецЕсли;

	Описания = СИ_УправлениеИнструментами1С.ПолучитьСписокИнструментов(Фильтр);

	ПоИмени = Новый Соответствие;
	Для Каждого Описание Из Описания Цикл
		Имя = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Имя", "")));
		Если НЕ ПустаяСтрока(Имя) Тогда
			ПоИмени.Вставить(НРег(Имя), Описание);
		КонецЕсли;
	КонецЦикла;

	Кэш = Новый Структура;
	Кэш.Вставить("Описания", Описания);
	Кэш.Вставить("ПоИмени", ПоИмени);
	КонтекстЦикла.Вставить("КэшИнструментовЗахода", Кэш);

	Возврат Кэш;

КонецФункции

// Имена инструментов, подгруженных моделью виртуальным fetch_toolset в этом заходе.
// Список нормализуется и живёт в контексте захода: на следующем шаге цикла
// подгруженные инструменты попадают в набор шага.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла.
//
// Возвращаемое значение:
//  Соответствие из Строка, Булево - ключ НРег(имя).
Функция ДополнительныеИнструментыЗахода(КонтекстЦикла)

	Дополнительные = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ДополнительныеИнструменты", Неопределено);
	Если ТипЗнч(Дополнительные) <> Тип("Соответствие") Тогда
		Индексы = Новый Соответствие;
		Если ТипЗнч(Дополнительные) = Тип("Массив") Тогда
			Для Каждого Имя Из Дополнительные Цикл
				Индексы.Вставить(НРег(СокрЛП(Строка(Имя))), Истина);
			КонецЦикла;
		КонецЕсли;
		КонтекстЦикла.Вставить("ДополнительныеИнструменты", Индексы);
		Возврат Индексы;
	КонецЕсли;

	Возврат Дополнительные;

КонецФункции

// Имена инструментов, уже вызванных в этом диалоге (по истории захода: tool-сообщения
// в КонтекстЦикла.Сообщения). Такие инструменты всегда остаются в наборе шага -
// модель не должна терять доступ к тому, чем уже пользовалась.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла.
//
// Возвращаемое значение:
//  Соответствие из Строка, Булево - ключ НРег(имя).
Функция ВызванныеИнструментыДиалога(КонтекстЦикла)

	Вызванные = Новый Соответствие;
	Сообщения = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Сообщения", Новый Массив);
	Если ТипЗнч(Сообщения) = Тип("Массив") Тогда
		Для Каждого Сообщение Из Сообщения Цикл
			Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
			Если Роль <> "tool" Тогда
				Продолжить;
			КонецЕсли;
			Имя = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИмяИнструмента", "")));
			Если НЕ ПустаяСтрока(Имя) Тогда
				Вызванные.Вставить(НРег(Имя), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Вызванные;

КонецФункции

// Текст последнего вопроса пользователя в истории захода: по нему подбираются
// инструменты по ключевым словам (реквизит «Слова»).
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла.
//
// Возвращаемое значение:
//  Строка - текст вопроса; пустая строка, если вопроса в истории нет.
Функция ТекстВопросаЗахода(КонтекстЦикла)

	Текст = "";
	Сообщения = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Сообщения", Новый Массив);
	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат Текст;
	КонецЕсли;

	Для Индекс = Сообщения.Количество() - 1 По 0 Цикл
		Сообщение = Сообщения[Индекс];
		Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
		Если Роль <> "user" Тогда
			Продолжить;
		КонецЕсли;
		Текст = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Контент", "")));
		Прервать;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Признак совпадения ключевых слов инструмента с текстом вопроса.
// Слова хранятся строкой через запятую. Совпадение ищется ПО ГРАНИЦАМ СЛОВ, а не
// по подстроке: иначе «счет» срабатывал бы внутри «расчет», а «акт» - внутри
// «факт», и группа инструментов поднималась бы в промпт по ложному совпадению.
// Ключ-фраза (несколько слов) ищется в нормализованном тексте вопроса, где знаки
// препинания заменены пробелами, то есть как последовательность слов. Ключ-слово
// длиной от 4 знаков совпадает с началом слова вопроса («остатк» находит
// «остатки», «остатками»). Более короткий ключ совпадает только целиком
// («акт» находит «акт», но не «акты» и не «факт»).
//
// Параметры:
//  Слова - Строка - ключевые слова через запятую (реквизит «Слова»).
//  Текст - Строка - текст вопроса.
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы одно слово встречается в тексте вопроса.
Функция СловаСовпалиСТекстом(Знач Слова, Знач Текст)

	Если ПустаяСтрока(Слова) ИЛИ ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	СловаВопроса = СтрРазделить(НормализованныйТекстВопроса(Текст), " ", Ложь);
	ТекстВопроса = СтрСоединить(СловаВопроса, " ");

	Для Каждого Слово Из СтрРазделить(СокрЛП(Слова), ",", Ложь) Цикл

		Ключ = НРег(СокрЛП(Слово));
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрНайти(Ключ, " ") > 0 Тогда
			КлючФраза = СтрСоединить(СтрРазделить(Ключ, " ", Ложь), " ");
			Если СтрНайти(ТекстВопроса, КлючФраза) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Для Каждого СловоВопроса Из СловаВопроса Цикл
			Если СловоВопроса = Ключ
				ИЛИ (СтрДлина(Ключ) >= МинимальнаяДлинаКлючаДляПрефикса()
					И СтрНачинаетсяС(СловоВопроса, Ключ)) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Минимальная длина ключевого слова, для которого допускается совпадение с НАЧАЛОМ
// слова вопроса (а не только полное совпадение): короткие ключи вроде «акт»
// иначе цеплялись бы к половине слов русского текста.
//
// Возвращаемое значение:
//  Число - минимальная длина ключа.
Функция МинимальнаяДлинаКлючаДляПрефикса()

	Возврат 4;

КонецФункции

// Текст вопроса в виде для поиска по словам: нижний регистр, знаки препинания
// и прочие разделители заменены пробелами, кратные пробелы схлопнуты. Нужен,
// чтобы ключ-фраза искался как последовательность СЛОВ: в «вполне работает»
// фразы «не работает» нет, хотя подстрока формально совпадает.
//
// Параметры:
//  Текст - Строка - текст вопроса.
//
// Возвращаемое значение:
//  Строка - нормализованный текст (слова через один пробел).
Функция НормализованныйТекстВопроса(Знач Текст)

	Разделители = " " + Символы.ПС + Символы.ВК + Символы.Таб
		+ ",.;:!?()[]{}""'«»…---/\|+*=%$#@&^~`<>№";
	Возврат СтрСоединить(СтрРазделить(НРег(Текст), Разделители, Ложь), " ");

КонецФункции

// Группы инструментов, которые на этом шаге передаются модели целиком:
// группа по умолчанию - всегда; остальные - если вопрос содержит ключевое слово
// инструмента этой группы или инструмент группы уже вызывался в диалоге.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла.
//  Описания - Массив из Структура - доступные инструменты (см. ИнструментыЗахода).
//  Вызванные - Соответствие из Строка, Булево - уже вызванные в диалоге инструменты
//    (см. ВызванныеИнструментыДиалога): набор считается вызывающим кодом один раз
//    на шаг и передаётся сюда, чтобы не обходить историю сообщений дважды.
//
// Возвращаемое значение:
//  Соответствие из Строка, Булево - ключ ИМЯ ГРУППЫ.
Функция ГруппыИнструментовДляПодъёма(КонтекстЦикла, Описания, Вызванные)

	Группы = Новый Соответствие;
	Группы.Вставить(СИ_УправлениеИнструментами1С.ГруппаИнструментаПоУмолчанию(), Истина);

	ТекстВопроса = ТекстВопросаЗахода(КонтекстЦикла);

	Для Каждого Описание Из Описания Цикл
		Группа = СИ_УправлениеИнструментами1С.ГруппаИнструментаПоОписанию(Описание);
		Если Группы.Получить(Группа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Имя = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Имя", "")));
		Слова = СИ_РаботаСJSON.БезопасноПолучить(Описание, "Слова", "");

		Если СловаСовпалиСТекстом(Слова, ТекстВопроса)
			ИЛИ Вызванные.Получить(НРег(Имя)) <> Неопределено Тогда
			Группы.Вставить(Группа, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Группы;

КонецФункции

// Набор инструментов (поле tools) для шага цикла.
// До порога каталога (или при явном белом списке в ДопПараметры) - все доступные
// инструменты, как раньше. Выше порога в промпт уходят только «основная» группа,
// MCP-инструменты, уже вызванные в диалоге и подгруженные через fetch_toolset;
// остальные модель видит каталогом в описании виртуального fetch_toolset.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла.
//  ИменаИзДопПараметров - Массив из Строка,Неопределено - явный белый список
//    инструментов (ДопПараметры.ИменаИнструментов); задан - каталог не применяется.
//
// Возвращаемое значение:
//  Массив из Структура - готовое поле tools запроса к API.
Функция СхемыИнструментовДляШага(КонтекстЦикла, ИменаИзДопПараметров)

	РежимСсылка = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "РежимСсылка", Неопределено);

	Если ТипЗнч(ИменаИзДопПараметров) = Тип("Массив") И ИменаИзДопПараметров.Количество() > 0 Тогда
		Возврат СИ_УправлениеИнструментами1С.СформироватьПолеТools(ИменаИзДопПараметров, РежимСсылка);
	КонецЕсли;

	Кэш = ИнструментыЗахода(КонтекстЦикла);

	Если Кэш.Описания.Количество() <= ПорогКаталогаИнструментов() Тогда
		Возврат СИ_УправлениеИнструментами1С.СформироватьПолеТoolsИзОписаний(Кэш.Описания);
	КонецЕсли;

	Вызванные = ВызванныеИнструментыДиалога(КонтекстЦикла);
	ГруппыПодъёма = ГруппыИнструментовДляПодъёма(КонтекстЦикла, Кэш.Описания, Вызванные);
	Дополнительные = ДополнительныеИнструментыЗахода(КонтекстЦикла);

	ИнструментыШага = Новый Массив;
	КаталогИмён = Новый Массив;

	Для Каждого Описание Из Кэш.Описания Цикл
		Имя = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Имя", "")));
		ТипИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Описание, "Тип", "1С");

		ВШаге = ГруппыПодъёма.Получить(СИ_УправлениеИнструментами1С.ГруппаИнструментаПоОписанию(Описание)) <> Неопределено
			ИЛИ ТипИнструмента = "MCP"
			ИЛИ Вызванные.Получить(НРег(Имя)) <> Неопределено
			ИЛИ Дополнительные.Получить(НРег(Имя)) <> Неопределено;

		Если ВШаге Тогда
			ИнструментыШага.Добавить(Описание);
		Иначе
			КаталогИмён.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	ПолеТools = СИ_УправлениеИнструментами1С.СформироватьПолеТoolsИзОписаний(ИнструментыШага);

	Если КаталогИмён.Количество() > 0 Тогда
		ПолеТools.Добавить(ОписаниеВиртуальногоИнструментаЗагрузки(КаталогИмён, Кэш.Описания));
	КонецЕсли;

	Возврат ПолеТools;

КонецФункции

// Описание виртуального инструмента fetch_toolset с каталогом скрытых инструментов
// («- имя: краткое действие»). Приписывается к полю tools шага, когда каталог непуст.
//
// Параметры:
//  КаталогИмён - Массив из Строка - имена инструментов, скрытых от модели.
//  Описания - Массив из Структура - все доступные инструменты (для действий).
//
// Возвращаемое значение:
//  Соответствие из Строка, Произвольный - элемент поля tools в формате OpenAI.
Функция ОписаниеВиртуальногоИнструментаЗагрузки(КаталогИмён, Описания)

	ПоИмени = Новый Соответствие;
	Для Каждого Описание Из Описания Цикл
		ПоИмени.Вставить(НРег(СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Имя", "")))), Описание);
	КонецЦикла;

	СтрокиКаталога = Новый Массив;
	Для Каждого Имя Из КаталогИмён Цикл
		Описание = ПоИмени.Получить(НРег(Имя));
		СтрокиКаталога.Добавить("- " + Имя + ": "
			+ СИ_УправлениеИнструментами1С.ДействиеИнструментаПоОписанию(Описание, Имя));
	КонецЦикла;

	ТекстОписания = "Загрузить дополнительные инструменты по именам. Используй, когда нужного "
		+ "инструмента нет в текущем наборе. Доступные для загрузки инструменты:"
		+ Символы.ПС + СтрСоединить(СтрокиКаталога, Символы.ПС);

	СхемаИмениПараметра = Новый Соответствие;
	СхемаИмениПараметра.Вставить("type", "array");
	СхемаИмениПараметра.Вставить("description", "Реестровые имена инструментов из списка выше");
	ЭлементМассива = Новый Соответствие;
	ЭлементМассива.Вставить("type", "string");
	СхемаИмениПараметра.Вставить("items", ЭлементМассива);

	Свойства = Новый Соответствие;
	Свойства.Вставить("names", СхемаИмениПараметра);

	Требуемые = Новый Массив;
	Требуемые.Добавить("names");

	Параметры = Новый Соответствие;
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Требуемые);
	Параметры.Вставить("type", "object");

	ФункцияОбъект = Новый Соответствие;
	ФункцияОбъект.Вставить("name", ИмяИнструментаЗагрузкиИнструментов());
	ФункцияОбъект.Вставить("description", ТекстОписания);
	ФункцияОбъект.Вставить("parameters", Параметры);

	ИнструментAPI = Новый Соответствие;
	ИнструментAPI.Вставить("type", "function");
	ИнструментAPI.Вставить("function", ФункцияОбъект);

	Возврат ИнструментAPI;

КонецФункции

// Имена инструментов из аргументов вызова fetch_toolset.
// Модель присылает массив имён (ключ names); строку со списком через запятую
// тоже принимаем - провайдеры иногда сериализуют единственный аргумент строкой.
//
// Параметры:
//  Аргументы - Структура,Произвольный,Неопределено - аргументы вызова в виде
//    структуры или соответствия (как приходят из JSON).
//
// Возвращаемое значение:
//  Массив из Строка - запрошенные имена (пустой массив, если аргумент не разобран).
Функция ИменаИзАргументовЗагрузки(Аргументы)

	Результат = Новый Массив;
	Значение = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "names", Неопределено);
	Если Значение = Неопределено Тогда
		Значение = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "tools", Неопределено);
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент) = Тип("Строка") И НЕ ПустаяСтрока(СокрЛП(Элемент)) Тогда
				Результат.Добавить(СокрЛП(Элемент));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(Значение) Тогда
		Для Каждого Часть Из СтрРазделить(Значение, ",", Ложь) Цикл
			Если НЕ ПустаяСтрока(СокрЛП(Часть)) Тогда
				Результат.Добавить(СокрЛП(Часть));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Обработка вызова виртуального fetch_toolset: запрошенные имена добавляются в набор
// захода, модели возвращается подтверждение со списком подгруженных инструментов
// (неизвестные имена - отдельным списком, чтобы она не повторяла вызов).
// Повторный вызов с теми же именами идемпотентен: имена уже в наборе.
//
// Параметры:
//  ИдВызова - Строка - call_id вызова.
//  Аргументы - Структура,Произвольный,Неопределено - аргументы вызова.
//  КонтекстЦикла - Структура - контекст цикла.
//
// Возвращаемое значение:
//  Структура - сообщение role=tool для истории.
Функция СообщениеПодгрузкиИнструментов(Знач ИдВызова, Аргументы, КонтекстЦикла)

	Кэш = ИнструментыЗахода(КонтекстЦикла);
	Дополнительные = ДополнительныеИнструментыЗахода(КонтекстЦикла);

	Загружено = Новый Массив;
	Неизвестные = Новый Массив;

	Для Каждого Имя Из ИменаИзАргументовЗагрузки(Аргументы) Цикл
		Описание = Кэш.ПоИмени.Получить(НРег(Имя));
		Если Описание = Неопределено Тогда
			Неизвестные.Добавить(Имя);
			Продолжить;
		КонецЕсли;

		РеестровоеИмя = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Имя", "")));
		Если ПустаяСтрока(РеестровоеИмя) Тогда
			Неизвестные.Добавить(Имя);
			Продолжить;
		КонецЕсли;

		Если НЕ Загружено.Найти(РеестровоеИмя) Тогда
			Загружено.Добавить(РеестровоеИмя);
		КонецЕсли;
		Дополнительные.Вставить(НРег(РеестровоеИмя), Истина);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("Загружено", Загружено);
	Ответ.Вставить("Неизвестные", Неизвестные);
	Ответ.Вставить("Подсказка",
		"Инструменты из «Загружено» доступны со следующего шага. "
		+ "Имена из «Неизвестные» не найдены - выбери инструменты из каталога в описании fetch_toolset.");

	Сообщение = Новый Структура;
	Сообщение.Вставить("Роль", "tool");
	Сообщение.Вставить("ИдВызоваИнструмента", ИдВызова);
	Сообщение.Вставить("ИмяИнструмента", ИмяИнструментаЗагрузкиИнструментов());
	Сообщение.Вставить("Контент", СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Ответ));
	Сообщение.Вставить("ДлительностьИсполненияМс", 0);
	Сообщение.Вставить("УспехИсполнения", Истина);
	Сообщение.Вставить("Действие", "Загружаю инструменты");

	ЗаписьЖурналаРегистрации("Агент1С.ЗагрузкаИнструментов",
		УровеньЖурналаРегистрации.Информация,
		Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИдДиалога", Неопределено)),,
		"fetch_toolset: подгружено " + Строка(Загружено.Количество())
		+ ", не найдено " + Строка(Неизвестные.Количество()) + ".");

	Возврат Сообщение;

КонецФункции

// Признак вызова виртуального инструмента загрузки инструментов.
//
// Параметры:
//  Имя - Строка - имя вызываемого инструмента.
//
// Возвращаемое значение:
//  Булево.
Функция ЭтоВызовЗагрузкиИнструментов(Знач Имя)

	Возврат НРег(СокрЛП(Имя)) = НРег(ИмяИнструментаЗагрузкиИнструментов());

КонецФункции

// Действие инструмента (человекочитаемый статус шага) с кэшем на заход:
// индикатор чата показывает «Смотрю остатки товара…» вместо имени функции.
// Кэш собирается одним обращением к реестру на заход (см. ДействияИнструментов).
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла.
//  Имя - Строка - реестровое имя инструмента.
//
// Возвращаемое значение:
//  Строка - действие; имя инструмента, если действие неизвестно.
Функция ДействиеИнструментаЗахода(КонтекстЦикла, Знач Имя)

	Кэш = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ДействияИнструментов", Неопределено);
	Если ТипЗнч(Кэш) <> Тип("Соответствие") Тогда
		Кэш = СИ_УправлениеИнструментами1С.ДействияИнструментов();
		КонтекстЦикла.Вставить("ДействияИнструментов", Кэш);
	КонецЕсли;

	Действие = Кэш.Получить(НРег(СокрЛП(Имя)));
	Если Действие = Неопределено ИЛИ ПустаяСтрока(Строка(Действие)) Тогда
		Возврат СокрЛП(Имя);
	КонецЕсли;

	Возврат Строка(Действие);

КонецФункции

#КонецОбласти

#Область ЗапросРазрешения

// Для формы чата: есть ли у диалога вызовы, ожидающие подтверждения.
Функция ЕстьОтложенныеВызовы(Знач ИдДиалога) Экспорт
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ожидания.ВызовыJSON
	|ИЗ
	|	РегистрСведений.СИ_ОжидающиеРазрешения КАК Ожидания
	|ГДЕ
	|	Ожидания.Диалог = &Диалог";
	Запрос.УстановитьПараметр("Диалог", ИдДиалога);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

// Для формы чата: JSON-строка с отложенными вызовами диалога (для карточки
// СИ_ЧатHTMLСервер.ПолучитьБлокРазрешенияHTML). Пустая строка — ожиданий нет.
Функция ПолучитьОтложенныеВызовыJSON(Знач ИдДиалога) Экспорт
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ожидания.ВызовыJSON
	|ИЗ
	|	РегистрСведений.СИ_ОжидающиеРазрешения КАК Ожидания
	|ГДЕ
	|	Ожидания.Диалог = &Диалог";
	Запрос.УстановитьПараметр("Диалог", ИдДиалога);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВызовыJSON;
	КонецЕсли;
	Возврат "";
КонецФункции

// Для формы чата: снимает активное ожидание разрешения БЕЗ исполнения
// (используется при прерывании диалога/отправке нового сообщения):
// в историю пишутся role=tool отказы, ожидание удаляется.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента.
//  ЗаписыватьОтказы - Булево - Истина: добавить в историю tool-сообщения с отказом
//    (нужно, если assistant-сообщение с tool_calls уже в истории и следующий вызов
//    модели без tool-результатов дал бы ошибку invalid tool_call_id).
Процедура СнятьОжиданиеРазрешения(Знач ИдДиалога, Знач ЗаписыватьОтказы = Истина) Экспорт
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат;
	КонецЕсли;
	ВызовыОжидания = ПрочитатьОжиданиеРазрешения(ИдДиалога);
	Если ВызовыОжидания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ЗаписыватьОтказы Тогда
		Для Каждого ВызовОжидания Из ВызовыОжидания Цикл
			СообщениеОтказа = Новый Структура;
			СообщениеОтказа.Вставить("Роль", "tool");
			СообщениеОтказа.Вставить("ИдВызоваИнструмента", Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Ид", "")));
			СообщениеОтказа.Вставить("ИмяИнструмента", Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Имя", "")));
			Отказ = Новый Структура("Ошибка", "Вызов отклонён пользователем");
			СообщениеОтказа.Вставить("Контент", СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Отказ));
			СообщениеОтказа.Вставить("ДлительностьИсполненияМс", 0);
			СообщениеОтказа.Вставить("УспехИсполнения", Ложь);
			СИ_УправлениеДиалогом.ДобавитьСообщение(ИдДиалога, СообщениеОтказа);
		КонецЦикла;
	КонецЕсли;
	УдалитьОжиданиеРазрешения(ИдДиалога);
	УстановитьСтатусДиалога(ИдДиалога, Перечисления.СИ_СтатусыДиалога.Активен);
КонецПроцедуры

// Требуется ли подтверждение пользователя перед исполнением вызова, если описание
// инструмента и запомненные разрешения диалога уже прочитаны вызывающим кодом.
// Обращений к БД не выполняет, поэтому допустима внутри цикла (проверка EDT
// query-in-loop): см. ЗапомненныеРазрешенияДиалога.
//
// Параметры:
//  ОписаниеИнструмента - Структура, Неопределено - описание из СИ_УправлениеИнструментами1С.
//  Имя - Строка - реестровое имя инструмента.
//  ЗапомненныеРазрешения - Соответствие Из КлючИЗначение - ИмяИнструмента -> Истина.
//
// Возвращаемое значение:
//  Булево - Истина, если исполнение требует подтверждения пользователя.
Функция ТребуетсяРазрешениеПоОписанию(Знач ОписаниеИнструмента, Знач Имя, Знач ЗапомненныеРазрешения)
	Если ОписаниеИнструмента = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "ТребуетРазрешения", Ложь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗапомненныеРазрешения.Получить(НРег(Имя)) <> Истина;
КонецФункции

// Читает одним запросом запомненные решения «разрешить всегда в этом диалоге» по
// всем инструментам диалога: один запрос на пакет вызовов вместо запроса на каждый
// вызов (проверка EDT query-in-loop).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - ИмяИнструмента -> Истина.
Функция ЗапомненныеРазрешенияДиалога(Знач ИдДиалога)
	Разрешения = Новый Соответствие;
	Если НЕ ЗначениеЗаполнено(ИдДиалога) ИЛИ ТипЗнч(ИдДиалога) <> Тип("СправочникСсылка.СИ_ДиалогиАгента") Тогда
		Возврат Разрешения;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РазрешенияИнструментов.ИмяИнструмента КАК ИмяИнструмента
	|ИЗ
	|	РегистрСведений.СИ_РазрешенияИнструментовДиалога КАК РазрешенияИнструментов
	|ГДЕ
	|	РазрешенияИнструментов.Диалог = &Диалог
	|	И РазрешенияИнструментов.Разрешено = Истина";
	Запрос.УстановитьПараметр("Диалог", ИдДиалога);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Разрешения.Вставить(НРег(Строка(Выборка.ИмяИнструмента)), Истина);
	КонецЦикла;
	Возврат Разрешения;
КонецФункции

// Запоминает решение «разрешить всегда в этом диалоге» (до конца жизни диалога).
Процедура ЗапомнитьРазрешениеИнструмента(Знач ИдДиалога, Знач ИмяИнструмента)
	Если НЕ ЗначениеЗаполнено(ИдДиалога) ИЛИ ПустаяСтрока(ИмяИнструмента) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		МенеджерЗаписи = РегистрыСведений.СИ_РазрешенияИнструментовДиалога.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Диалог = ИдДиалога;
		МенеджерЗаписи.ИмяИнструмента = ИмяИнструмента;
		МенеджерЗаписи.Разрешено = Истина;
		МенеджерЗаписи.Записать(Истина);
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ЗапросРазрешения", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка запоминания разрешения для " + ИмяИнструмента + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Сохраняет отложенные вызовы (ожидающие решения пользователя) в регистр
// СИ_ОжидающиеРазрешения. Служебные ключи ИдДиалога/ПрофильПодключения удаляются
// из аргументов (ссылка 1С не сериализуется; на возобновлении они восстанавливаются
// штатно в ОбработатьВызовыИнструментов).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента.
//  ВызовыОжидания - Массив Из Структура {Ид, Имя, Аргументы}.
Процедура ЗаписатьОжиданиеРазрешения(Знач ИдДиалога, ВызовыОжидания)
	МассивJSON = Новый Массив;
	Для Каждого ВызовОжидания Из ВызовыОжидания Цикл
		Аргументы = СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Аргументы", Неопределено);
		Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
			Если Аргументы.Свойство("ИдДиалога") Тогда
				Аргументы.Удалить("ИдДиалога");
			КонецЕсли;
			Если Аргументы.Свойство("ПрофильПодключения") Тогда
				Аргументы.Удалить("ПрофильПодключения");
			КонецЕсли;
		ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
			Аргументы.Удалить("ИдДиалога");
			Аргументы.Удалить("ПрофильПодключения");
		КонецЕсли;
		ЗаписьОжидания = Новый Структура;
		ЗаписьОжидания.Вставить("Ид", Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Ид", "")));
		ЗаписьОжидания.Вставить("Имя", Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Имя", "")));
		ЗаписьОжидания.Вставить("Аргументы", Аргументы);
		МассивJSON.Добавить(ЗаписьОжидания);
	КонецЦикла;
	Попытка
		МенеджерЗаписи = РегистрыСведений.СИ_ОжидающиеРазрешения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Диалог = ИдДиалога;
		МенеджерЗаписи.ВызовыJSON = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(МассивJSON);
		МенеджерЗаписи.ДатаЗапроса = ТекущаяУниверсальнаяДата();
		МенеджерЗаписи.Записать(Истина);
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ЗапросРазрешения", УровеньЖурналаРегистрации.Ошибка,
			Строка(ИдДиалога),, "Ошибка записи ожидающих вызовов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Записывает решение пользователя по ОДНОМУ отложенному вызову (последовательное
// подтверждение пакета). Решение хранится в том же JSON-пакете регистра
// СИ_ОжидающиеРазрешения: поля Решение ("allow"/"always"/"deny") и Запомнить.
// Пока решение не принято по всем вызовам, заход остаётся остановленным, а
// карточка в чате показывает следующий нерешённый вызов.
//
// Чтение-изменение-запись пакета идёт в транзакции под управляемой блокировкой
// по измерению Диалог: иначе параллельный клик из другой сессии (второе окно
// чата, повторный вход) перезапишет пакет и потеряет ранее принятые решения.
//
// Решение "always" дополнительно распространяется на остальные нерешённые
// вызовы ТОГО ЖЕ инструмента в пакете: пользователь разрешил инструмент в
// этом диалоге, повторно спрашивать его в том же пакете не нужно.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  Действие - Строка - "allow" / "always" / "deny".
//  ИдВызова - Строка - идентификатор вызова (Ид из ссылки perm:<действие>:<Ид>).
//
// Возвращаемое значение:
//  Строка - обновлённый JSON пакета; исходный JSON, если вызов не найден;
//   пустая строка, если ожидания по диалогу нет.
Функция ЗаписатьРешениеРазрешения(Знач ИдДиалога, Знач Действие, Знач ИдВызова) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) ИЛИ ПустаяСтрока(ИдВызова) Тогда
		Возврат "";
	КонецЕсли;
	Если Действие <> "allow" И Действие <> "always" И Действие <> "deny" Тогда
		Возврат "";
	КонецЕсли;

	НовыйJSON = "";
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СИ_ОжидающиеРазрешения");
		ЭлементБлокировки.УстановитьЗначение("Диалог", ИдДиалога);
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.СИ_ОжидающиеРазрешения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Диалог = ИдДиалога;
		МенеджерЗаписи.Прочитать();
		Если НЕ МенеджерЗаписи.Выбран() Тогда
			ЗафиксироватьТранзакцию();
			Возврат "";
		КонецЕсли;

		ВызовыJSON = МенеджерЗаписи.ВызовыJSON;
		Разобранное = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ВызовыJSON);
		Если ТипЗнч(Разобранное) <> Тип("Массив") Тогда
			ЗафиксироватьТранзакцию();
			Возврат ВызовыJSON;
		КонецЕсли;

		ИдНорм = НРег(СокрЛП(ИдВызова));
		ИмяИнструмента = "";
		Найден = Ложь;
		Для Каждого Элемент Из Разобранное Цикл
			Если НРег(Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Ид", ""))) = ИдНорм Тогда
				ИмяИнструмента = Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Имя", ""));
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НЕ Найден Тогда
			ЗафиксироватьТранзакцию();
			Возврат ВызовыJSON;
		КонецЕсли;

		Для Каждого Элемент Из Разобранное Цикл
			ИдЭлемента = НРег(Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Ид", "")));
			ИмяЭлемента = Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Имя", ""));
			РешениеЭлемента = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Решение", "")));
			Если ИдЭлемента = ИдНорм Тогда
				Если ПустаяСтрока(РешениеЭлемента) Тогда
					Элемент.Вставить("Решение", Действие);
					Элемент.Вставить("Запомнить", Действие = "always");
				КонецЕсли;
			ИначеЕсли Действие = "always"
				И НЕ ПустаяСтрока(ИмяИнструмента)
				И НРег(ИмяЭлемента) = НРег(ИмяИнструмента)
				И ПустаяСтрока(РешениеЭлемента) Тогда
				Элемент.Вставить("Решение", "always");
				Элемент.Вставить("Запомнить", Истина);
			КонецЕсли;
		КонецЦикла;

		НовыйJSON = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Разобранное);
		МенеджерЗаписи.ВызовыJSON = НовыйJSON;
		МенеджерЗаписи.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("Агент1С.ОжиданиеРазрешения", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка записи ожидания разрешения: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

	Возврат НовыйJSON;

КонецФункции

// Читает отложенные вызовы из регистра СИ_ОжидающиеРазрешения.
//
// Возвращаемое значение:
//  Массив Из Структура {Ид, Имя, Аргументы} (Аргументы — Соответствие/Структура из JSON).
Функция ПрочитатьОжиданиеРазрешения(Знач ИдДиалога)
	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ожидания.ВызовыJSON
	|ИЗ
	|	РегистрСведений.СИ_ОжидающиеРазрешения КАК Ожидания
	|ГДЕ
	|	Ожидания.Диалог = &Диалог";
	Запрос.УстановитьПараметр("Диалог", ИдДиалога);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Разобранное = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(Выборка.ВызовыJSON);
		Если ТипЗнч(Разобранное) = Тип("Массив") Тогда
			Для Каждого Элемент Из Разобранное Цикл
				ВызовОжидания = Новый Структура;
				ВызовОжидания.Вставить("Ид", Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Ид", "")));
				ВызовОжидания.Вставить("Имя", Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Имя", "")));
				ВызовОжидания.Вставить("Аргументы", СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Аргументы", Неопределено));
				Результат.Добавить(ВызовОжидания);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ЗапросРазрешения", УровеньЖурналаРегистрации.Ошибка,
			Строка(ИдДиалога),, "Ошибка разбора ожидающих вызовов: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Удаляет запись ожидающих вызовов диалога (после обработки или при прерывании).
Процедура УдалитьОжиданиеРазрешения(Знач ИдДиалога)
	Попытка
		НаборЗаписей = РегистрыСведений.СИ_ОжидающиеРазрешения.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Диалог.Установить(ИдДиалога);
		НаборЗаписей.Записать(Истина);
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ЗапросРазрешения", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка удаления ожидающих вызовов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Устанавливает статус диалога (best-effort, сбой не прерывает заход). Запись идёт
// через ядро записи реквизитов диалога: блокировка данных ДО чтения объекта и повтор
// при конфликте с параллельной записью (форма/ФЗ).
Процедура УстановитьСтатусДиалога(Знач ИдДиалога, Знач Статус) Экспорт
	
	ЗначенияЗаписиДиалога = Новый Структура;
	ЗначенияЗаписиДиалога.Вставить("Статус", Статус);
	ПараметрыЗаписиДиалога = Новый Структура;
	ПараметрыЗаписиДиалога.Вставить("ИмяОперации", "УстановитьСтатусДиалога");
	СИ_УправлениеДиалогом.ЗаписатьРеквизитыДиалога(ИдДиалога, ЗначенияЗаписиДиалога,
		ПараметрыЗаписиДиалога);
	
КонецПроцедуры

// Исполняет отложенные вызовы при возобновлении захода после запроса разрешения.
// Одобренные вызовы исполняются общим механизмом ОбработатьВызовыИнструментов
// (шлюз пропущен), отклонённые получают role=tool отказ «Вызов отклонён
// пользователем». Сообщения пишутся в буфер пакетной записи и в локальную
// историю цикла, затем главный цикл продолжается вызовом модели.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла агента.
//  Решения - Массив,Неопределено - решения пользователя:
//    [{ИдВызова, ИмяИнструмента, Разрешено, Запомнить}].
//  Результат - Структура - итоговый результат ЗапуститьАгента.
Процедура ВыполнитьОтложенныеВызовы(КонтекстЦикла, Знач Решения, Результат)
	ИдДиалога = КонтекстЦикла.ИдДиалога;
	КонтекстЦикла.Вставить("ВозобновлениеРазрешения", Истина);

	ВызовыОжидания = ПрочитатьОжиданиеРазрешения(ИдДиалога);
	УдалитьОжиданиеРазрешения(ИдДиалога);
	Если ВызовыОжидания.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ЗапросРазрешения", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Возобновление: ожидающие вызовы не найдены (запись уже обработана?).");
		Возврат;
	КонецЕсли;

	РешенияПоИд = Новый Соответствие;
	Если Решения <> Неопределено И ТипЗнч(Решения) = Тип("Массив") Тогда
		Для Каждого Решение Из Решения Цикл
			ИдРешения = НРег(Строка(СИ_РаботаСJSON.БезопасноПолучить(Решение, "ИдВызова", "")));
			РешенияПоИд.Вставить(ИдРешения, СИ_РаботаСJSON.БезопасноПолучить(Решение, "Разрешено", Ложь) = Истина);
			Если СИ_РаботаСJSON.БезопасноПолучить(Решение, "Запомнить", Ложь) Тогда
				ИмяИзРешения = Строка(СИ_РаботаСJSON.БезопасноПолучить(Решение, "ИмяИнструмента", ""));
				Если НЕ ПустаяСтрока(ИмяИзРешения) Тогда
					ЗапомнитьРазрешениеИнструмента(ИдДиалога, ИмяИзРешения);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	РазрешенныеВызовы = Новый Массив;
	ФлагиРазрешения = Новый Соответствие;
	Для Каждого ВызовОжидания Из ВызовыОжидания Цикл
		ИдВызова = НРег(Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Ид", "")));
		Разрешено = РешенияПоИд.Получить(ИдВызова);
		Если Разрешено = Неопределено Тогда
			Разрешено = Ложь;
		КонецЕсли;
		ФлагиРазрешения.Вставить(ИдВызова, Разрешено);
		Если Разрешено Тогда
			Вызов = Новый Структура;
			Вызов.Вставить("Ид", ВызовОжидания.Ид);
			Вызов.Вставить("Имя", ВызовОжидания.Имя);
			Вызов.Вставить("Аргументы", СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Аргументы", Неопределено));
			РазрешенныеВызовы.Добавить(Вызов);
		КонецЕсли;
	КонецЦикла;

	РезультатыРазрешенных = Новый Массив;
	Если РазрешенныеВызовы.Количество() > 0 Тогда
		РезультатыРазрешенных = ОбработатьВызовыИнструментов(РазрешенныеВызовы, КонтекстЦикла);
	КонецЕсли;

	БуферСообщений = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "БуферСообщений", Неопределено);
	ИндексРазрешенных = 0;
	Для Каждого ВызовОжидания Из ВызовыОжидания Цикл
		ИдВызова = НРег(Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Ид", "")));
		Если ФлагиРазрешения.Получить(ИдВызова) = Истина Тогда
			Если ИндексРазрешенных >= РезультатыРазрешенных.Количество() Тогда
				Продолжить;
			КонецЕсли;
			СообщениеТул = РезультатыРазрешенных[ИндексРазрешенных];
			ИндексРазрешенных = ИндексРазрешенных + 1;
		Иначе
			СообщениеТул = Новый Структура;
			СообщениеТул.Вставить("Роль", "tool");
			СообщениеТул.Вставить("ИдВызоваИнструмента", Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Ид", "")));
			СообщениеТул.Вставить("ИмяИнструмента", Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Имя", "")));
			Отказ = Новый Структура("Ошибка", "Вызов отклонён пользователем");
			СообщениеТул.Вставить("Контент", СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Отказ));
			СообщениеТул.Вставить("ДлительностьИсполненияМс", 0);
			СообщениеТул.Вставить("УспехИсполнения", Ложь);
		КонецЕсли;

		Если БуферСообщений <> Неопределено Тогда
			ДобавитьСообщениеВЦикле(БуферСообщений, ИдДиалога, СообщениеТул);
			ОтправитьЖивоеПоследнееСообщение(БуферСообщений, КонтекстЦикла);
		КонецЕсли;
		КонтекстЦикла.Сообщения.Добавить(СообщениеТул);
	КонецЦикла;

	УстановитьСтатусДиалога(ИдДиалога, Перечисления.СИ_СтатусыДиалога.Активен);

	ЗаписьЖурналаРегистрации("Агент1С.ЗапросРазрешения", УровеньЖурналаРегистрации.Информация,
		Строка(ИдДиалога),, "Возобновление: одобрено " + Строка(РазрешенныеВызовы.Количество())
		+ " из " + Строка(ВызовыОжидания.Количество()) + " отложенных вызовов.");
КонецПроцедуры

#КонецОбласти

#КонецОбласти
