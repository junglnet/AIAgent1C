// Возвращаемое значение:
//  Число - максимальная длина строки.
Функция МаксимальнаяДлинаСтрокиРезультата() Экспорт
	Возврат 500;
КонецФункции

// Выполнение read-only запроса к базе данных с гарантированными директивами
// РАЗРЕШЕННЫЕ и ПЕРВЫЕ (число строк берётся из параметра ЛимитСтрок).
//
// Параметры:
//  Аргументы - Структура/Соответствие:
//    * ТекстЗапроса - Строка (обязательный) - текст запроса на языке 1С.
//      РАЗРЕШЕННЫЕ и ПЕРВЫЕ добавляются автоматически - писать их не нужно.
//    * Параметры - Соответствие/Структура,Неопределено - именованные параметры запроса.
//    * ЛимитСтрок - Число,Неопределено - сколько строк вернуть модели: целое
//      от 1 до ЛимитСтрокРезультата() (по умолчанию и максимум 100).
//    * ТаймаутСекунд - Число,Неопределено - таймаут выполнения в секундах
//      (по умолчанию 60).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура - результат:
//      ** Строки - Массив из Соответствие - строки результата (колонка -> значение).
//      ** КоличествоСтрок - Число - сколько строк реально возвращено.
//      ** ЕстьЕщеДанные - Булево - Истина, если под отбор попало больше строк,
//         чем вернулось (в выборке была ещё одна строка за лимитом).
//    * Ошибка - Строка,Неопределено.
Функция ВыполнитьЗапрос(Аргументы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	ТекстЗапроса = "";

	Попытка
		ТекстЗапроса = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ТекстЗапроса", "");
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			Результат.Ошибка = "Не передан ТекстЗапроса. Передайте текст запроса в поле ТекстЗапроса.";
			Возврат Результат;
		КонецЕсли;

		Нормализованный = НормализоватьТекст(ТекстЗапроса);
		Запрещенные = НайтиЗапрещенныеОбъекты(Нормализованный);
		Если Запрещенные.Количество() > 0 Тогда
			ЗаписьЖурналаРегистрации("СИ_Инструменты1С.ЗапретОбъектов",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Запрос от модели содержит запрещенные объекты: " + СтрСоединить(Запрещенные, ", "));
			Результат.Ошибка = "Запрос содержит недоступные объекты метаданных: "
				+ СтрСоединить(Запрещенные, ", ")
				+ ". Уберите их из запроса. Доступны для запросов: Справочники, Документы, "
				+ "Регистры сведений, Регистры накопления, Перечисления, "
				+ "Планы видов характеристик, Журналы документов. "
				+ "Уточнить состав объектов можно через инструмент GetMetadataSchema.";
			Возврат Результат;
		КонецЕсли;

		ЗапрещенныйОператор = НайтиЗапрещенныйОператор(Нормализованный);
		Если НЕ ПустаяСтрока(ЗапрещенныйОператор) Тогда
			ЗаписьЖурналаРегистрации("СИ_Инструменты1С.ЗапретОператора",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Запрос от модели содержит запрещенный оператор " + ЗапрещенныйОператор);
			Результат.Ошибка = "Запрос содержит запрещенный оператор " + ЗапрещенныйОператор
				+ ". Инструмент выполняет только чтение данных (ВЫБРАТЬ).";
			Возврат Результат;
		КонецЕсли;

		ЗапрещенныйПсевдоним = НайтиЗапрещенныйПсевдоним(Нормализованный);
		Если НЕ ПустаяСтрока(ЗапрещенныйПсевдоним) Тогда
			ЗаписьЖурналаРегистрации("СИ_Инструменты1С.ЗапретПсевдонима",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Запрос от модели использует ключевое слово как псевдоним: " + ЗапрещенныйПсевдоним);
			Результат.Ошибка = ТекстОшибкиПсевдонима(ЗапрещенныйПсевдоним);
			Возврат Результат;
		КонецЕсли;

		ЛимитСтрок = НормализоватьЛимитСтрок(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ЛимитСтрок", Неопределено));
		ТекстПодготовленный = ВнедритьДирективы(ТекстЗапроса, ЛимитСтрок);

		ПараметрыJSON = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Параметры", Неопределено);
		Параметры = Новый Соответствие;
		Если ПараметрыJSON <> Неопределено Тогда
			Параметры = КонвертироватьПараметры(ПараметрыJSON);
		КонецЕсли;

		ТаймаутСекунд = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ТаймаутСекунд", ТаймаутЗапросаПоУмолчанию());
		Если ТаймаутСекунд = Неопределено ИЛИ Число(ТаймаутСекунд) <= 0 Тогда
			ТаймаутСекунд = ТаймаутЗапросаПоУмолчанию();
		КонецЕсли;

		ЗаписатьДиагностикуЗапроса("Выполнение", ТекстПодготовленный, Параметры, Число(ТаймаутСекунд),
			"Лимит строк: " + Строка(ЛимитСтрок));

		РезультатВыполнения = ВыполнитьСТаймаутом(ТекстПодготовленный, Параметры, Число(ТаймаутСекунд), ЛимитСтрок);

		Результат.Успех = СИ_РаботаСJSON.БезопасноПолучить(РезультатВыполнения, "Успех", Ложь);
		Результат.Значение = СИ_РаботаСJSON.БезопасноПолучить(РезультатВыполнения, "Значение", Неопределено);
		Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(РезультатВыполнения, "Ошибка", Неопределено);

		Если Результат.Успех И ТипЗнч(Результат.Значение) = Тип("Структура")
			И Число(СИ_РаботаСJSON.БезопасноПолучить(Результат.Значение, "КоличествоСтрок", 0)) > 0 Тогда
			СсылкиОбъектовЗначения = СИ_РаботаСJSON.БезопасноПолучить(Результат.Значение, "СсылкиОбъектов", Неопределено);
			Если ТипЗнч(СсылкиОбъектовЗначения) <> Тип("Массив")
				ИЛИ СсылкиОбъектовЗначения.Количество() = 0 Тогда
				Результат.Значение.Вставить("Подсказка", ТекстПодсказкиОСсылкахВРезультате());
			КонецЕсли;
		КонецЕсли;

	Исключение
		Результат.Ошибка = ТекстОшибкиЗапросаПоИсключению(ТекстЗапроса,
			"Ошибка выполнения запроса: %1. Проверьте: имена таблиц и полей, синтаксис запроса, типы параметров.");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполнение read-only запроса для выгрузки данных в файл (инструменты
// ExportTable и DrawChart). Проверки те же, что в ВыполнитьЗапрос (черный
// список объектов, запрещенные операторы, РАЗРЕШЕННЫЕ, таймаут), но лимит
// строк - до МаксимумСтрокВыгрузки(), а строки возвращаются СЫРЫМИ значениями
// (число, дата, булево) - они нужны табличному документу и диаграмме, а не
// JSON-представлению для модели.
//
// Инструментом этот путь НЕ публикуется: ExecuteDBQuery остаётся с лимитом
// ЛимитСтрокРезультата().
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса на языке 1С (обязательный).
//  Параметры - Структура/Соответствие,Неопределено - именованные параметры
//    (даты строкой ISO конвертируются, как в ВыполнитьЗапрос).
//  ЛимитСтрок - Число,Неопределено - 1..МаксимумСтрокВыгрузки()
//    (по умолчанию ЛимитСтрокВыгрузкиПоУмолчанию()).
//  ТаймаутСекунд - Число,Неопределено - таймаут выполнения (по умолчанию 60).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура:
//      ** Строки - Массив из Соответствие - строки с сырыми значениями.
//      ** Колонки - Массив из Строка - имена колонок в порядке запроса.
//      ** КоличествоСтрок - Число.
//      ** ЕстьЕщеДанные - Булево - под отбор попало больше строк, чем лимит.
//    * Ошибка - Строка,Неопределено.
Функция ВыполнитьЗапросДляВыгрузки(ТекстЗапроса, Параметры = Неопределено,
	ЛимитСтрок = Неопределено, ТаймаутСекунд = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		ТекстЗапроса = Строка(ТекстЗапроса);
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			Результат.Ошибка = "Не передан ТекстЗапроса. Передайте текст запроса в поле ТекстЗапроса.";
			Возврат Результат;
		КонецЕсли;

		Нормализованный = НормализоватьТекст(ТекстЗапроса);
		Запрещенные = НайтиЗапрещенныеОбъекты(Нормализованный);
		Если Запрещенные.Количество() > 0 Тогда
			ЗаписьЖурналаРегистрации("СИ_Инструменты1С.ЗапретОбъектов",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Запрос выгрузки от модели содержит запрещенные объекты: " + СтрСоединить(Запрещенные, ", "));
			Результат.Ошибка = "Запрос содержит недоступные объекты метаданных: "
				+ СтрСоединить(Запрещенные, ", ")
				+ ". Уберите их из запроса. Доступны для запросов: Справочники, Документы, "
				+ "Регистры сведений, Регистры накопления, Перечисления, "
				+ "Планы видов характеристик, Журналы документов. "
				+ "Уточнить состав объектов можно через инструмент GetMetadataSchema.";
			Возврат Результат;
		КонецЕсли;

		ЗапрещенныйОператор = НайтиЗапрещенныйОператор(Нормализованный);
		Если НЕ ПустаяСтрока(ЗапрещенныйОператор) Тогда
			ЗаписьЖурналаРегистрации("СИ_Инструменты1С.ЗапретОператора",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Запрос выгрузки от модели содержит запрещенный оператор " + ЗапрещенныйОператор);
			Результат.Ошибка = "Запрос содержит запрещенный оператор " + ЗапрещенныйОператор
				+ ". Инструмент выполняет только чтение данных (ВЫБРАТЬ).";
			Возврат Результат;
		КонецЕсли;

		ЗапрещенныйПсевдоним = НайтиЗапрещенныйПсевдоним(Нормализованный);
		Если НЕ ПустаяСтрока(ЗапрещенныйПсевдоним) Тогда
			Результат.Ошибка = ТекстОшибкиПсевдонима(ЗапрещенныйПсевдоним);
			Возврат Результат;
		КонецЕсли;

		ЛимитВыгрузки = ЛимитСтрокВыгрузкиПоУмолчанию();
		Если ЛимитСтрок <> Неопределено Тогда
			Попытка
				ЗапрошенныйЛимит = Цел(Число(ЛимитСтрок));
			Исключение
				ЗапрошенныйЛимит = 0;
			КонецПопытки;
			Если ЗапрошенныйЛимит > 0 Тогда
				ЛимитВыгрузки = Мин(ЗапрошенныйЛимит, МаксимумСтрокВыгрузки());
			КонецЕсли;
		КонецЕсли;
		ТекстПодготовленный = ВнедритьДирективы(ТекстЗапроса, ЛимитВыгрузки);

		ПараметрыЗапроса = Новый Соответствие;
		Если Параметры <> Неопределено Тогда
			Если ТипЗнч(Параметры) = Тип("Соответствие") ИЛИ ТипЗнч(Параметры) = Тип("Структура") Тогда
				ПараметрыЗапроса = КонвертироватьПараметры(Параметры);
			КонецЕсли;
		КонецЕсли;

		Если ТаймаутСекунд = Неопределено ИЛИ Число(ТаймаутСекунд) <= 0 Тогда
			ТаймаутСекунд = ТаймаутЗапросаПоУмолчанию();
		КонецЕсли;

		ЗаписатьДиагностикуЗапроса("Выгрузка", ТекстПодготовленный, ПараметрыЗапроса,
			Число(ТаймаутСекунд), "Лимит строк: " + Строка(ЛимитВыгрузки));

		РезультатВыполнения = ВыполнитьВыгрузкуСТаймаутом(ТекстПодготовленный, ПараметрыЗапроса,
			Число(ТаймаутСекунд), ЛимитВыгрузки);

		Результат.Успех = СИ_РаботаСJSON.БезопасноПолучить(РезультатВыполнения, "Успех", Ложь);
		Результат.Значение = СИ_РаботаСJSON.БезопасноПолучить(РезультатВыполнения, "Значение", Неопределено);
		Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(РезультатВыполнения, "Ошибка", Неопределено);
	Исключение
		Результат.Ошибка = ТекстОшибкиЗапросаПоИсключению(Строка(ТекстЗапроса),
			"Ошибка выполнения запроса выгрузки: %1. Проверьте: имена таблиц и полей, синтаксис запроса, типы параметров.");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Поисковая схема метаданных: список таблиц по классу/подстроке имени либо
// детальная схема указанного объекта (поля и типы).
//
// Параметры:
//  Аргументы - Структура/Соответствие:
//    * ИмяТаблицы - Строка,Неопределено - точное имя таблицы (например "Справочник.Пользователи")
//      для получения полной схемы объекта (поля и типы). Приоритетнее Поиск.
//    * Поиск - Строка,Неопределено - строка поиска списка таблиц. Поддерживаются формы:
//        - "Справочник", "Справочник." или "Справочники" — ВСЕ объекты класса целиком
//          (аналогично: Документ/Документы, Перечисление/Перечисления,
//          РегистрНакопления, ПланВидовХарактеристик, ЖурналДокументов);
//        - "Справочник.Польз" — подстрока имени/синонима только внутри указанного класса;
//        - "пользовател" — подстрока по всем классам (без указания класса);
//        - пусто — краткая статистика по классам.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Произвольный,Неопределено - найденные таблицы (Массив из Строка,
//      "Класс.Имя (Синоним)") или структура детальной схемы объекта.
//    * Ошибка - Строка,Неопределено.
Функция ПолучитьСхемуМетаданных(Аргументы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		ИмяТаблицы = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИмяТаблицы", "");
		Поиск = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Поиск", "");

		Если НЕ ПустаяСтрока(ИмяТаблицы) Тогда
			Результат.Значение = ДетальнаяСхемаОбъекта(ИмяТаблицы);
		Иначе
			Результат.Значение = ПоискОбъектов(Поиск);
		КонецЕсли;
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = "Ошибка получения схемы метаданных: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает текущую дату и время сеанса информационной базы.
// Инструмент нужен модели для определения текущего года/месяца/периода:
//  - когда пользователь просит найти объекты «за этот год/месяц»;
//  - когда нумерация документов сбрасывается раз в год и нужно уточнить период
//    для поиска документа по номеру.
//
// Параметры:
//  Аргументы - Структура/Соответствие - не используются (инструмент без аргументов).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Структура:
//      ** ДатаВремя - Строка - текущие дата и время в формате ГГГГ-ММ-ДДTЧЧ:ММ:СС.
//      ** Дата - Строка - текущая дата в формате ГГГГ-ММ-ДД.
//      ** Год - Число - текущий год.
//      ** Месяц - Число - текущий месяц (1-12).
//      ** День - Число - текущий день месяца.
//    * Ошибка - Строка,Неопределено.
Функция ТекущиеДатаВремя(Аргументы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		ТекущаяДатаСеанса = ТекущаяДатаСеанса();

		Данные = Новый Структура;
		Данные.Вставить("ДатаВремя", Формат(ТекущаяДатаСеанса, "ДФ='yyyy-MM-dd'T'HH:mm:ss'"));
		Данные.Вставить("Дата", Формат(ТекущаяДатаСеанса, "ДФ='yyyy-MM-dd'"));
		Данные.Вставить("Год", Год(ТекущаяДатаСеанса));
		Данные.Вставить("Месяц", Месяц(ТекущаяДатаСеанса));
		Данные.Вставить("День", День(ТекущаяДатаСеанса));

		Результат.Значение = Данные;
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = "Ошибка получения текущей даты: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Регистрирует инструменты ExecuteDBQuery, GetMetadataSchema и GetCurrentDateTime в реестре.
//
// Возвращаемое значение:
//  Массив из Строка - имена зарегистрированных инструментов.
Функция ЗарегистрироватьИнструментыЗапросБД()

	Зарегистрированные = Новый Массив;

	СвойстваЗапрос = Новый Соответствие;
	ТекстЗапросаСвойство = Новый Соответствие;
	ТекстЗапросаСвойство.Вставить("type", "string");
	ТекстЗапросаСвойство.Вставить("description",
		"Запрос на языке 1С, начинается с ВЫБРАТЬ. РАЗРЕШЕННЫЕ и ПЕРВЫЕ не пишите - добавляются автоматически; модифицирующие операторы запрещены.");
	СвойстваЗапрос.Вставить("ТекстЗапроса", ТекстЗапросаСвойство);
	ПараметрыСвойство = Новый Соответствие;
	ПараметрыСвойство.Вставить("type", "object");
	ПараметрыСвойство.Вставить("description",
		"Именованные параметры (имя -> значение). Даты - строкой ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTЧЧ:ММ:СС; для отбора по ссылке - текстовые поля (Код/Наименование), не GUID. Массивы - для условий В (&Параметр).");
	СвойстваЗапрос.Вставить("Параметры", ПараметрыСвойство);
	ТаймаутСвойство = Новый Соответствие;
	ТаймаутСвойство.Вставить("type", "number");
	ТаймаутСвойство.Вставить("description", "Таймаут выполнения запроса в секундах (по умолчанию 60).");
	СвойстваЗапрос.Вставить("ТаймаутСекунд", ТаймаутСвойство);
	ЛимитСтрокСвойство = Новый Соответствие;
	ЛимитСтрокСвойство.Вставить("type", "number");
	ЛимитСтрокСвойство.Вставить("description",
		"Сколько строк вернуть: 1-100 (по умолчанию 100). Когда пользователь называет число («последние 10»), укажите его и добавьте УПОРЯДОЧИТЬ ПО.");
	СвойстваЗапрос.Вставить("ЛимитСтрок", ЛимитСтрокСвойство);
	ОбязательныеЗапрос = Новый Массив;
	ОбязательныеЗапрос.Добавить("ТекстЗапроса");

	Если ЗарегистрироватьИнструмент("ExecuteDBQuery",
		"Read-only запрос к БД 1С: данные (строки, суммы, остатки, документы, списки), а не структура. Начинается с ВЫБРАТЬ; РАЗРЕШЕННЫЕ и ПЕРВЫЕ не пишите - добавляются автоматически. Неизвестны таблицы/поля - сначала GetMetadataSchema. Возвращает до ЛимитСтрок строк (1-100, по умолчанию 100) и флаг ЕстьЕщеДанные. Запрещённые объекты (константа СИ_ЗапрещенныеОбъектыЗапросов) недоступны. Номера документов могут сбрасываться по годам - при поиске по номеру ограничьте период. Включайте в выборку ссылочное поле (Ссылка или ссылочный реквизит), чтобы объекты в ответе были кликабельны. Пустой результат - данных нет, не перепроверяйте. Период словами - ParsePeriod; выгрузка в файл - ExportTable; график - DrawChart.",
		СвойстваЗапрос, ОбязательныеЗапрос, "СИ_Инструменты1С.ВыполнитьЗапрос", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Выполняю запрос к базе")) Тогда
		Зарегистрированные.Добавить("ExecuteDBQuery");
	КонецЕсли;

	СвойстваСхема = Новый Соответствие;
	ПоискСвойство = Новый Соответствие;
	ПоискСвойство.Вставить("type", "string");
	ПоискСвойство.Вставить("description",
		"Строка поиска объектов. 'Справочник' или 'Справочник.' — ВСЕ справочники; 'Справочник.Польз' — только внутри класса Справочник по подстроке 'Польз'; 'пользовател' — по всем классам. Аналогично для Документ, Перечисление, РегистрНакопления, ПланВидовХарактеристик, ЖурналДокументов. Пусто — краткая статистика по классам.");
	СвойстваСхема.Вставить("Поиск", ПоискСвойство);
	ИмяТаблицыСвойство = Новый Соответствие;
	ИмяТаблицыСвойство.Вставить("type", "string");
	ИмяТаблицыСвойство.Вставить("description",
		"Точное имя таблицы (например 'Справочник.Пользователи') для получения полной схемы: реквизиты, типы. Приоритетнее Поиск.");
	СвойстваСхема.Вставить("ИмяТаблицы", ИмяТаблицыСвойство);

	Если ЗарегистрироватьИнструмент("GetMetadataSchema",
		"Схема метаданных для корректных запросов: вызывайте перед ExecuteDBQuery, когда неизвестны таблицы или поля. Поиск возвращает список таблиц вида 'Справочник.X (Синоним)'; все объекты класса - префикс класса ('Справочник', 'Документ'...), внутри класса - 'Справочник.Польз'. По ИмяТаблицы - поля с типами. Пустой результат - объекта нет, повторять поиск не нужно. Запрещённые объекты не возвращаются.",
		СвойстваСхема, Неопределено, "СИ_Инструменты1С.ПолучитьСхемуМетаданных", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Смотрю структуру данных")) Тогда
		Зарегистрированные.Добавить("GetMetadataSchema");
	КонецЕсли;

	СвойстваДата = Новый Соответствие;
	Если ЗарегистрироватьИнструмент("GetCurrentDateTime",
		"Текущая дата и время информационной базы. Возвращает ДатаВремя (ГГГГ-ММ-ДДTЧЧ:ММ:СС), Дата, Год, Месяц. Используйте, когда нужны «этот год/месяц» или границы периода; периоды словами («за 3 квартал», «в прошлом месяце») разбирайте через ParsePeriod.",
		СвойстваДата, Неопределено, "СИ_Инструменты1С.ТекущиеДатаВремя", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Уточняю текущую дату")) Тогда
		Зарегистрированные.Добавить("GetCurrentDateTime");
	КонецЕсли;

	СвойстваПериод = Новый Соответствие;
	ТекстСвойство = Новый Соответствие;
	ТекстСвойство.Вставить("type", "string");
	ТекстСвойство.Вставить("description",
		"Фраза из вопроса пользователя, в которой назван период: «за 3 квартал», «во 2 квартале», «в прошлом месяце», «за неделю», «с начала года», «за июль», «за 2025 год», «за последние 30 дней». Можно передавать весь текст вопроса - период будет найден в нем.");
	СвойстваПериод.Вставить("Текст", ТекстСвойство);
	ОбязательныеПериод = Новый Массив;
	ОбязательныеПериод.Добавить("Текст");

	Если ЗарегистрироватьИнструмент("ParsePeriod",
		"Границы периода, названного словами («за 3 квартал», «в прошлом месяце», «за последние 30 дней», «с начала года») - вместо ручного счёта. Возвращает Распознан, ДатаНачала/ДатаКонца (ГГГГ-ММ-ДД), НачалоДатаВремя/КонецДатаВремя - их передавайте параметрами запроса - и Пояснение. Если Распознан = Ложь, уточните период у пользователя.",
		СвойстваПериод, ОбязательныеПериод, "СИ_Инструменты1С.РазобратьПериодПоТексту", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Определяю период")) Тогда
		Зарегистрированные.Добавить("ParsePeriod");
	КонецЕсли;

	Возврат Зарегистрированные;

КонецФункции

// Выполняет запрос в фоновом задании. Экспортная — вызывается ДлительныеОперации.ВыполнитьФункцию.
//
// Параметры:
//  ТекстЗапроса - Строка - подготовленный текст запроса (с директивами).
//  Параметры - Соответствие,Неопределено - конвертированные параметры запроса.
//  ЛимитСтрок - Число,Неопределено - нормализованный лимит строк результата.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура - {Строки, КоличествоСтрок, ЕстьЕщеДанные}.
//    * Ошибка - Строка,Неопределено.
Функция ВыполнитьЗапросВФоне(ТекстЗапроса, Параметры, ЛимитСтрок = Неопределено) Экспорт

	Возврат ВыполнитьЗапросСинхронно(ТекстЗапроса, Параметры, ЛимитСтрок);

КонецФункции

// Выполняет запрос выгрузки в фоновом задании. Экспортная - вызывается
// ДлительныеОперации.ВыполнитьФункцию (см. ВыполнитьВыгрузкуСТаймаутом).
//
// Параметры:
//  ТекстЗапроса - Строка - подготовленный текст запроса (с директивами).
//  Параметры - Соответствие,Неопределено - конвертированные параметры запроса.
//  ЛимитСтрок - Число,Неопределено - нормализованный лимит строк выгрузки.
//
// Возвращаемое значение:
//  Структура - {Успех, Значение: {Строки, Колонки, КоличествоСтрок, ЕстьЕщеДанные}, Ошибка}.
Функция ВыполнитьЗапросДляВыгрузкиВФоне(ТекстЗапроса, Параметры, ЛимитСтрок = Неопределено) Экспорт

	Возврат ВыполнитьЗапросВыгрузкиВТекущемСеансе(ТекстЗапроса, Параметры,
		?(ЛимитСтрок = Неопределено, ЛимитСтрокВыгрузкиПоУмолчанию(), ЛимитСтрок));

КонецФункции

// Синхронное выполнение запроса (в текущем сеансе). Используется:
//  - как реализация функции фонового задания (ВыполнитьЗапросВФоне);
//  - напрямую из ВыполнитьСТаймаутом, когда текущий сеанс сам является сеансом
//    фонового задания агента — в этом случае ставить в очередь ещё одно фоновое
//    задание бессмысленно (в файловой базе оно никогда не стартует, пока занят
//    поток текущего задания).
//
// Параметры:
//  ТекстЗапроса - Строка - подготовленный текст запроса (с директивами).
//  Параметры - Соответствие,Неопределено - конвертированные параметры запроса.
//  ЛимитСтрок - Число,Неопределено - нормализованный лимит строк результата.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура - {Строки, КоличествоСтрок, ЕстьЕщеДанные}.
//    * Ошибка - Строка,Неопределено.
Функция ВыполнитьЗапросСинхронно(ТекстЗапроса, Параметры, ЛимитСтрок)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Если ЭтоСеансФоновогоЗадания() Тогда
		ЗаписьЖурналаРегистрации("СИ_Инструменты1С.Фон", УровеньЖурналаРегистрации.Информация,,,
			"Запрос выполняется в фоновом задании (отдельный сеанс).");
	КонецЕсли;

	НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		РезультатЗапроса = ВыполнитьЗапросВТекущемСеансе(ТекстЗапроса, Параметры, ЛимитСтрок);
		Результат.Успех = СИ_РаботаСJSON.БезопасноПолучить(РезультатЗапроса, "Успех", Ложь);
		Результат.Значение = СИ_РаботаСJSON.БезопасноПолучить(РезультатЗапроса, "Значение", Неопределено);
		Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(РезультатЗапроса, "Ошибка", Неопределено);

		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения;
		Если Результат.Успех Тогда
			ЗаписьЖурналаРегистрации("СИ_Инструменты1С.Фон", УровеньЖурналаРегистрации.Информация,,,
				"Запрос выполнен за " + Строка(ДлительностьМс) + " мс, строк: "
				+ Строка(СИ_РаботаСJSON.БезопасноПолучить(Результат.Значение, "КоличествоСтрок", 0))
				+ ", лимит: " + Строка(ЛимитСтрок));
		Иначе
			ЗаписьЖурналаРегистрации("СИ_Инструменты1С.Фон", УровеньЖурналаРегистрации.Предупреждение,,,
				"Запрос не выполнен (за " + Строка(ДлительностьМс) + " мс): " + Строка(Результат.Ошибка));
		КонецЕсли;
	Исключение
		Результат.Ошибка = ТекстОшибкиЗапросаПоИсключению(ТекстЗапроса,
			"Запрос не выполнен: %1. Проверьте: имена таблиц и полей, синтаксис, типы параметров.");
		ЗаписатьДиагностикуЗапроса("Ошибка", ТекстЗапроса, Параметры, 0, Результат.Ошибка,
			УровеньЖурналаРегистрации.Предупреждение);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполняет запрос в текущем сеансе и сериализует результат.
//
// Параметры:
//  ТекстЗапроса - Строка - подготовленный текст запроса.
//  Параметры - Соответствие,Неопределено - параметры запроса.
//  ЛимитСтрок - Число,Неопределено - лимит строк результата; нормализуется здесь
//    повторно, потому что функция достижима и по внешнему вызову
//    ВыполнитьЗапросВФоне без параметра (тогда приходит Неопределено).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура - {Строки, КоличествоСтрок, ЕстьЕщеДанные}.
//    * Ошибка - Строка,Неопределено.
Функция ВыполнитьЗапросВТекущемСеансе(ТекстЗапроса, Параметры, ЛимитСтрок)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Если Параметры <> Неопределено Тогда
			Для Каждого КлючИЗначение Из Параметры Цикл
				Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();

		ЛимитСтрок = НормализоватьЛимитСтрок(ЛимитСтрок);
		СсылкиОбъектов = Новый Массив;
		Данные = СериализоватьВыборку(РезультатЗапроса, Выборка, СсылкиОбъектов, ЛимитСтрок);
		Результат.Успех = Истина;
		Результат.Значение = ЗначениеСоСсылкамиОбъектов(Данные, СсылкиОбъектов);
	Исключение
		Результат.Ошибка = ТекстОшибкиЗапросаПоИсключению(ТекстЗапроса,
			"Запрос не выполнен: %1. Проверьте: имена таблиц и полей, синтаксис, типы параметров.");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Текущий черный список объектов метаданных, запрещенных для запросов модели.
// Базовый список (классы объектов) + дополнения администратора из константы
// СИ_ЗапрещенныеОбъектыЗапросов (через точку с запятой).
//
// Для пользователя с ролью «Администратор системы» ограничения не действуют:
// функция возвращает пустой массив (администратору доступны все объекты).
//
// Возвращаемое значение:
//  Массив из Строка - паттерны для поиска в нормализованном тексте запроса.
Функция ЗапрещенныеОбъекты() Экспорт

	Запрещенные = НеотключаемыеЗапрещенныеОбъекты();

	Если ЭтоАдминистраторСистемы() Тогда
		Возврат Запрещенные;
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Запрещенные,
		ДополнительныеЗапрещенныеОбъектыИзКонстанты(), Истина);

	Возврат Запрещенные;

КонецФункции

// Таймаут выполнения запроса по умолчанию.
//
// Возвращаемое значение:
//  Число - таймаут в секундах.
Функция ТаймаутЗапросаПоУмолчанию() Экспорт

	Возврат ТаймаутЗапросаКонстанта();

КонецФункции

#КонецОбласти

#Область ИнструментыДиагностики

// Последние ошибки и предупреждения ТЕКУЩЕГО пользователя из журнала регистрации:
// инструмент GetRecentErrors. Используется, когда пользователь пишет, что 1С выдала
// ошибку или что-то не проводится/не записывается.
//
// Параметры:
//  Аргументы - Структура, Соответствие:
//    * Минут - Число,Неопределено - за сколько последних минут искать
//      (по умолчанию 60, максимум 1440).
//    * Уровни - Массив из Строка,Неопределено - уровни событий
//      («Ошибка», «Предупреждение», «Информация», «Примечание»);
//      по умолчанию Ошибка и Предупреждение.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура:
//      ** Пользователь - Строка - чьи события показаны.
//      ** ПериодМинут - Число - фактический период выборки.
//      ** События - Массив из Соответствие - последние события
//        (Дата, Уровень, Событие, Метаданные, Данные, Комментарий).
//      ** Подсказка - Строка,Неопределено - что делать, если событий нет.
//    * Ошибка - Строка,Неопределено.
Функция ПоследниеСобытияЖурнала(Аргументы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		Минут = Число(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Минут", МинутПоУмолчанию()));
		Если Минут <= 0 Тогда
			Минут = МинутПоУмолчанию();
		КонецЕсли;
		Минут = Мин(Минут, МаксимумМинут());

		// Журнал хранит серверное время, поэтому берём ТекущаяДата(), а не дату сеанса.
		ТекущийМомент = ТекущаяДата();
		Отбор = Новый Структура;
		Отбор.Вставить("ДатаНачала", ТекущийМомент - Минут * 60);
		Отбор.Вставить("ДатаОкончания", ТекущийМомент);
		Отбор.Вставить("Уровень", УровниСобытийИзАргументов(Аргументы));
		Отбор.Вставить("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь());

			ПредыдущийРежим = ПривилегированныйРежим();
			УстановитьПривилегированныйРежим(Истина);
			Попытка
				ВыборкаЖурнала = НайтиПоследниеЗаписи(Отбор, ВнутреннийЛимитСобытий());
			Исключение
			УстановитьПривилегированныйРежим(ПредыдущийРежим);
			Результат.Ошибка = "Журнал регистрации недоступен: " + ОписаниеОшибки()
				+ ". Сообщите администратору базы.";
			Возврат Результат;
		КонецПопытки;
		УстановитьПривилегированныйРежим(ПредыдущийРежим);

		События = ПреобразоватьСобытияЖурнала(ВыборкаЖурнала.Таблица);
		ФактическийПериодМинут = Цел((ТекущийМомент - ВыборкаЖурнала.НачалоВыборки) / 60);
		Если ФактическийПериодМинут < 1 Тогда
			ФактическийПериодМинут = 1;
		КонецЕсли;
		Значение = Новый Структура;
		Значение.Вставить("Пользователь", Строка(ПользователиИнформационнойБазы.ТекущийПользователь()));
		Значение.Вставить("ПериодМинут", ФактическийПериодМинут);
		Значение.Вставить("События", События);
		Если ВыборкаЖурнала.Усечено Тогда
			Значение.Вставить("Примечание",
				"Журнал очень плотный: показаны последние " + События.Количество()
				+ " событий периода, более ранние события за этот период не включены.");
		КонецЕсли;
		Если События.Количество() = 0 Тогда
			Значение.Вставить("Подсказка", "За указанный период в журнале нет событий. Часть сообщений "
				+ "при проведении (нехватка остатков, незаполненные поля) в журнал не попадает - "
				+ "попросите пользователя передать текст сообщения или назвать документ.");
		КонецЕсли;

		Результат.Значение = Значение;
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = "Не удалось получить события журнала: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Регистрирует инструмент GetRecentErrors в реестре инструментов агента.
// Вызывается кнопкой регистрации в форме списка справочника СИ_ИнструментыАгента
// (объекты метаданных для инструмента не требуются).
//
// Возвращаемое значение:
//  Массив из Строка - имена зарегистрированных инструментов.
Функция ЗарегистрироватьИнструментыДиагностики()

	Зарегистрированные = Новый Массив;

	Свойства = Новый Соответствие;
	МинутСвойство = Новый Соответствие;
	МинутСвойство.Вставить("type", "number");
	МинутСвойство.Вставить("description",
		"За сколько последних минут искать события: по умолчанию 60, максимум 1440 (сутки).");
	Свойства.Вставить("Минут", МинутСвойство);
	УровниСвойство = Новый Соответствие;
	УровниСвойство.Вставить("type", "array");
	УровниСвойство.Вставить("description",
		"Уровни событий: Ошибка, Предупреждение, Информация, Примечание. По умолчанию - Ошибка и Предупреждение.");
	ЭлементыУровней = Новый Соответствие;
	ЭлементыУровней.Вставить("type", "string");
	УровниСвойство.Вставить("items", ЭлементыУровней);
	Свойства.Вставить("Уровни", УровниСвойство);

	Если ЗарегистрироватьИнструмент("GetRecentErrors",
		"Свежие ошибки и предупреждения текущего пользователя из журнала регистрации - при сообщениях о сбое (не проводится, не записывается, не работает). Возвращает до 30 событий (Дата, Уровень, Событие, Метаданные, Данные, Комментарий). Пустой результат - тоже ответ: сообщите об этом и запросите текст ошибки, показанный 1С; повторные проверки не нужны.",
		Свойства, Неопределено, "СИ_Инструменты1С.ПоследниеСобытияЖурнала", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестра("Диагностика",
			"ошибка, ошибки, не проводится, не записывается, не сохраняется, не работает, не открывается, вылетает, не печатается, сбой, проблема",
			"Смотрю ошибки пользователя")) Тогда
		Зарегистрированные.Добавить("GetRecentErrors");
	КонецЕсли;

	Возврат Зарегистрированные;

КонецФункции

#КонецОбласти

#Область ИнструментыВыгрузки

// Регистрирует инструменты выгрузки в реестре: ExportTable и DrawChart.
//
// Возвращаемое значение:
//  Массив из Строка - имена зарегистрированных инструментов.
Функция ЗарегистрироватьИнструментыВыгрузки()

	Зарегистрированные = Новый Массив;

	СвойстваВыгрузки = Новый Соответствие;
	СвойстваВыгрузки.Вставить("ТекстЗапроса", ОписаниеПараметраЗапроса());
	СвойстваВыгрузки.Вставить("Параметры", ОписаниеПараметраПараметры());
	ЛимитСвойство = Новый Соответствие;
	ЛимитСвойство.Вставить("type", "number");
	ЛимитСвойство.Вставить("description",
		"Сколько строк выгрузить: от 1 до " + Формат(МаксимумСтрокВыгрузки(), "ЧДЦ=0; ЧГ=")
		+ " (по умолчанию " + Формат(ЛимитСтрокВыгрузкиПоУмолчанию(), "ЧДЦ=0; ЧГ=") + "). Больше - ошибка, сузьте отбор.");
	СвойстваВыгрузки.Вставить("ЛимитСтрок", ЛимитСвойство);
	ИмяФайлаСвойство = Новый Соответствие;
	ИмяФайлаСвойство.Вставить("type", "string");
	ИмяФайлаСвойство.Вставить("description",
		"Необязательное имя файла с расширением .xlsx. Если не указано, имя строится по дате и времени.");
	СвойстваВыгрузки.Вставить("ИмяФайла", ИмяФайлаСвойство);

	ОбязательныеВыгрузки = Новый Массив;
	ОбязательныеВыгрузки.Добавить("ТекстЗапроса");

	Если ЗарегистрироватьИнструмент("ExportTable",
		"Выгрузить результат запроса в Excel (.xlsx) и приложить к диалогу - «выгрузи», «скачай», «сохрани в Excel/файл». ТекстЗапроса - как у ExecuteDBQuery (директивы добавляются автоматически). Строки в ответ не возвращаются: возвращаются имя файла, число строк/колонок, первые 5 строк и итоги, поэтому подходит для больших выборок. Больше лимита строк - ошибка, сузьте отбор.",
		СвойстваВыгрузки, ОбязательныеВыгрузки, "СИ_Инструменты1С.ВыгрузитьВExcel", Истина,
		СИ_УправлениеИнструментами1С.ЗначенияРеестра("Выгрузки и диаграммы",
			"excel, xlsx, эксель, выгрузи, выгрузить, выгрузка, скачай, скачать, сохрани, файл, таблица, отчет",
			"Выгружаю в Excel")) Тогда
		Зарегистрированные.Добавить("ExportTable");
	КонецЕсли;

	СвойстваДиаграммы = Новый Соответствие;
	СвойстваДиаграммы.Вставить("ТекстЗапроса", ОписаниеПараметраЗапроса());
	СвойстваДиаграммы.Вставить("Параметры", ОписаниеПараметраПараметры());

	ТипСвойство = Новый Соответствие;
	ТипСвойство.Вставить("type", "string");
	ТипыДиаграмм = Новый Массив;
	ТипыДиаграмм.Добавить("столбцы");
	ТипыДиаграмм.Добавить("линия");
	ТипыДиаграмм.Добавить("круг");
	ТипСвойство.Вставить("enum", ТипыДиаграмм);
	ТипСвойство.Вставить("description",
		"Тип диаграммы: столбцы (bar), линия (line), круг (pie). По умолчанию столбцы.");
	СвойстваДиаграммы.Вставить("Тип", ТипСвойство);

	КатегорииСвойство = Новый Соответствие;
	КатегорииСвойство.Вставить("type", "string");
	КатегорииСвойство.Вставить("description",
		"Имя колонки запроса с подписями точек (например Месяц, Номенклатура). По умолчанию первая колонка.");
	СвойстваДиаграммы.Вставить("КолонкаКатегорий", КатегорииСвойство);

	ЗначенияСвойство = Новый Соответствие;
	ЗначенияСвойство.Вставить("type", "string");
	ЗначенияСвойство.Вставить("description",
		"Имя колонки запроса с числовыми значениями (например Сумма). По умолчанию вторая колонка.");
	СвойстваДиаграммы.Вставить("КолонкаЗначений", ЗначенияСвойство);

	ЗаголовокСвойство = Новый Соответствие;
	ЗаголовокСвойство.Вставить("type", "string");
	ЗаголовокСвойство.Вставить("description", "Заголовок диаграммы. Если не указан, строится из имен колонок.");
	СвойстваДиаграммы.Вставить("Заголовок", ЗаголовокСвойство);

	ЛимитТочекСвойство = Новый Соответствие;
	ЛимитТочекСвойство.Вставить("type", "number");
	ЛимитТочекСвойство.Вставить("description",
		"Сколько точек (категорий) показать: от 1 до 100, по умолчанию 30. Для круговой диаграммы лишние точки сворачиваются в «Прочие».");
	СвойстваДиаграммы.Вставить("ЛимитТочек", ЛимитТочекСвойство);

	ОбязательныеДиаграммы = Новый Массив;
	ОбязательныеДиаграммы.Добавить("ТекстЗапроса");

	Если ЗарегистрироватьИнструмент("DrawChart",
		"Диаграмма по данным запроса в чате - «график», «диаграмма», «динамика по месяцам». Запрос - как у ExecuteDBQuery: колонка подписей и числовая колонка (например Месяц и Сумма). Тип: столбцы (по умолчанию), линия, круг. Файлы SVG/XLSX сохраняются в диалоге. Таблица без графика - ExecuteDBQuery, выгрузка в файл - ExportTable.",
		СвойстваДиаграммы, ОбязательныеДиаграммы, "СИ_Инструменты1С.НарисоватьДиаграмму", Истина,
		СИ_УправлениеИнструментами1С.ЗначенияРеестра("Выгрузки и диаграммы", "график, диаграмма, chart, гистограмма, круговая, динамика", "Рисую диаграмму")) Тогда
		Зарегистрированные.Добавить("DrawChart");
	КонецЕсли;

	Возврат Зарегистрированные;

КонецФункции

// Выгружает результат запроса в файл Excel (.xlsx) и сохраняет его в файлы диалога.
// Полные строки модели не возвращаются: только сводка и первые 5 строк.
//
// Параметры:
//  Аргументы - Структура/Соответствие:
//    * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог (подставляет движок).
//    * ТекстЗапроса - Строка (обязательный) - запрос на языке 1С.
//    * Параметры - Соответствие/Структура,Неопределено - параметры запроса.
//    * ЛимитСтрок - Число,Неопределено - 1..100000, по умолчанию 10000.
//    * ИмяФайла - Строка,Неопределено - имя файла .xlsx.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Структура,Неопределено:
//      ** Ссылка - Строка - UUID файла диалога (по нему рендер строит «Скачать файл»).
//      ** ИмяФайла - Строка.
//      ** Строк - Число - выгруженных строк.
//      ** Колонок - Число.
//      ** ПервыеСтроки - Массив из Структура - до 5 первых строк (значения строками).
//      ** Итоги - Структура - суммы по числовым колонкам (не более 5 колонок).
//    * Ошибка - Строка,Неопределено.
Функция ВыгрузитьВExcel(Аргументы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		ИдДиалога = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИдДиалога", Неопределено);
		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Результат.Ошибка = "Не передан идентификатор диалога (ИдДиалога).";
			Возврат Результат;
		КонецЕсли;

		ТекстЗапроса = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ТекстЗапроса", ""));
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			Результат.Ошибка = "Не передан ТекстЗапроса. Передайте текст запроса в поле ТекстЗапроса.";
			Возврат Результат;
		КонецЕсли;

		ЛимитСтрок = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ЛимитСтрок", Неопределено);
		ПараметрыЗапроса = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Параметры", Неопределено);

		Выборка = ВыполнитьЗапросДляВыгрузки(ТекстЗапроса, ПараметрыЗапроса,
			ЛимитСтрок, Неопределено);
		Если НЕ СИ_РаботаСJSON.БезопасноПолучить(Выборка, "Успех", Ложь) Тогда
			Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(Выборка, "Ошибка",
				"Запрос выгрузки не выполнен.");
			Возврат Результат;
		КонецЕсли;

		Данные = СИ_РаботаСJSON.БезопасноПолучить(Выборка, "Значение", Неопределено);
		Если Данные = Неопределено Тогда
			Результат.Ошибка = "Запрос выгрузки вернул пустой результат.";
			Возврат Результат;
		КонецЕсли;

		Если СИ_РаботаСJSON.БезопасноПолучить(Данные, "ЕстьЕщеДанные", Ложь) Тогда
			Результат.Ошибка = "Под отбор попало больше строк, чем лимит выгрузки. "
				+ "Сузьте отбор (период, организация, вид документа) или увеличьте ЛимитСтрок "
				+ "(максимум " + Формат(МаксимумСтрокВыгрузки(), "ЧДЦ=0; ЧГ=")
				+ "). Молчаливая обрезка данных не выполняется.";
			Возврат Результат;
		КонецЕсли;

		Строки = СИ_РаботаСJSON.БезопасноПолучить(Данные, "Строки", Неопределено);
		Колонки = СИ_РаботаСJSON.БезопасноПолучить(Данные, "Колонки", Неопределено);
		Если ТипЗнч(Строки) <> Тип("Массив") ИЛИ ТипЗнч(Колонки) <> Тип("Массив")
			ИЛИ Колонки.Количество() = 0 Тогда
			Результат.Ошибка = "Запрос выгрузки не вернул колонок. Проверьте текст запроса.";
			Возврат Результат;
		КонецЕсли;

		ТабличныйДокумент = ПостроитьТабличныйДокумент(Строки, Колонки);
		ДвоичныеДанные = ЗаписатьТабличныйДокументВXLSX(ТабличныйДокумент);
		ТабличныйДокумент = Неопределено;
		Если ДвоичныеДанные = Неопределено Тогда
			Результат.Ошибка = "Не удалось сформировать файл Excel.";
			Возврат Результат;
		КонецЕсли;

		ИмяФайла = ИмяФайлаВыгрузки(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИмяФайла", ""),
			"выгрузка", "xlsx");
		СсылкаФайла = СИ_ФайлыДиалога.СохранитьБинарныйФайлВДиалоге(
			ИдДиалога, ИмяФайла, ДвоичныеДанные, "Выгрузка из чата");
		Если НЕ ЗначениеЗаполнено(СсылкаФайла) Тогда
			Результат.Ошибка = "Не удалось сохранить файл выгрузки в диалог: " + ИмяФайла;
			Возврат Результат;
		КонецЕсли;

		Значение = Новый Структура;
		Значение.Вставить("Ссылка", Строка(СсылкаФайла.УникальныйИдентификатор()));
		Значение.Вставить("ИмяФайла", ИмяФайла);
		Значение.Вставить("Строк", Строки.Количество());
		Значение.Вставить("Колонок", Колонки.Количество());
		Значение.Вставить("ПервыеСтроки", ПервыеСтрокиДляМодели(Строки, Колонки, 5));
		Значение.Вставить("Итоги", ИтогиПоЧисловымКолонкам(Строки, Колонки));
		Результат.Значение = Значение;
		Результат.Успех = Истина;

	Исключение
		Результат.Ошибка = "Ошибка выгрузки в Excel: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_Инструменты1С.ВыгрузитьВExcel",
			УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Строит диаграмму по данным запроса: SVG-карточка для чата и файлы SVG/XLSX
// в диалоге. SVG проходит обязательную проверку СИ_ЧатHTMLСервер.БезопасныйSVG.
//
// Параметры:
//  Аргументы - Структура/Соответствие:
//    * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//    * ТекстЗапроса - Строка (обязательный).
//    * Параметры - Соответствие/Структура,Неопределено.
//    * Тип - Строка,Неопределено - "столбцы" | "линия" | "круг".
//    * КолонкаКатегорий - Строка,Неопределено - по умолчанию первая колонка.
//    * КолонкаЗначений - Строка,Неопределено - по умолчанию вторая колонка.
//    * Заголовок - Строка,Неопределено.
//    * ЛимитТочек - Число,Неопределено - 1..100, по умолчанию 30.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Структура,Неопределено:
//      ** Ссылка - Строка - UUID файла XLSX с данными.
//      ** ИмяФайла - Строка - имя XLSX.
//      ** Точек - Число.
//      ** Подпись - Строка.
//      ** Диаграмма - Структура - служебная карточка для рендера чата
//         (SVG, Заголовок, Подпись, УИДФайла, ИмяФайла); реестр инструментов
//         изымает её до сериализации результата для модели.
//    * Ошибка - Строка,Неопределено.
Функция НарисоватьДиаграмму(Аргументы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		ИдДиалога = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИдДиалога", Неопределено);
		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Результат.Ошибка = "Не передан идентификатор диалога (ИдДиалога).";
			Возврат Результат;
		КонецЕсли;

		ТекстЗапроса = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ТекстЗапроса", ""));
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			Результат.Ошибка = "Не передан ТекстЗапроса. Передайте текст запроса в поле ТекстЗапроса.";
			Возврат Результат;
		КонецЕсли;

		ЛимитТочек = НормализоватьЛимитТочек(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ЛимитТочек", Неопределено));
		ПараметрыЗапроса = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Параметры", Неопределено);

		Выборка = ВыполнитьЗапросДляВыгрузки(ТекстЗапроса, ПараметрыЗапроса,
			ЛимитТочек, Неопределено);
		Если НЕ СИ_РаботаСJSON.БезопасноПолучить(Выборка, "Успех", Ложь) Тогда
			Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(Выборка, "Ошибка",
				"Запрос диаграммы не выполнен.");
			Возврат Результат;
		КонецЕсли;

		Данные = СИ_РаботаСJSON.БезопасноПолучить(Выборка, "Значение", Неопределено);
		Если Данные = Неопределено Тогда
			Результат.Ошибка = "Запрос диаграммы вернул пустой результат.";
			Возврат Результат;
		КонецЕсли;

		Строки = СИ_РаботаСJSON.БезопасноПолучить(Данные, "Строки", Неопределено);
		Колонки = СИ_РаботаСJSON.БезопасноПолучить(Данные, "Колонки", Неопределено);
		Если ТипЗнч(Строки) <> Тип("Массив") ИЛИ Строки.Количество() = 0
			ИЛИ ТипЗнч(Колонки) <> Тип("Массив") ИЛИ Колонки.Количество() = 0 Тогда
			Результат.Ошибка = "Запрос диаграммы не вернул данных. Проверьте отбор запроса.";
			Возврат Результат;
		КонецЕсли;

		КолонкаКатегорий = ОпределитьКолонку(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "КолонкаКатегорий", ""),
			Колонки, 0);
		КолонкаЗначений = ОпределитьКолонку(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "КолонкаЗначений", ""),
			Колонки, 1);
		Если ПустаяСтрока(КолонкаКатегорий) ИЛИ ПустаяСтрока(КолонкаЗначений) Тогда
			Результат.Ошибка = "Колонка диаграммы не найдена. Доступные колонки: "
				+ СтрСоединить(Колонки, ", ") + ".";
			Возврат Результат;
		КонецЕсли;
		Если КолонкаКатегорий = КолонкаЗначений Тогда
			Результат.Ошибка = "Колонка категорий и колонка значений не могут совпадать ("
				+ КолонкаКатегорий + "). Укажите разные колонки.";
			Возврат Результат;
		КонецЕсли;

		Заголовок = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Заголовок", "")));
		Если ПустаяСтрока(Заголовок) Тогда
			Заголовок = КолонкаЗначений + " по " + КолонкаКатегорий;
		КонецЕсли;

		ВидДиаграммы = НормализоватьТипДиаграммы(
			СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Тип", ""));

		SVG = ПостроитьSVGДиаграмму(Строки, ВидДиаграммы, КолонкаКатегорий, КолонкаЗначений, Заголовок);
		Если ПустаяСтрока(SVG) Тогда
			Результат.Ошибка = "В выбранных колонках (" + КолонкаКатегорий + ", " + КолонкаЗначений
				+ ") нет данных для диаграммы: значения должны быть числовыми.";
			Возврат Результат;
		КонецЕсли;

		Точек = 0;
		Для Каждого СтрокаДанных Из Строки Цикл
			Если ЧислоИлиНеопределено(СтрокаДанных.Получить(КолонкаЗначений)) <> Неопределено Тогда
				Точек = Точек + 1;
			КонецЕсли;
		КонецЦикла;

		SVG = СИ_ЧатHTMLСервер.БезопасныйSVG(SVG);
		Если ПустаяСтрока(SVG) Тогда
			Результат.Ошибка = "Разметка диаграммы не прошла проверку безопасности и не показана.";
			Возврат Результат;
		КонецЕсли;

		Подпись = "Значений: " + Формат(Точек, "ЧДЦ=0; ЧГ=")
			+ " · " + КолонкаКатегорий + " - " + КолонкаЗначений;

		ИмяSVG = ИмяФайлаВыгрузки("", "диаграмма", "svg");
		ДанныеSVG = ПолучитьДвоичныеДанныеИзСтроки(SVG, "UTF-8");
		СсылкаSVG = СИ_ФайлыДиалога.СохранитьБинарныйФайлВДиалоге(
			ИдДиалога, ИмяSVG, ДанныеSVG, "Диаграмма чата");
		Если НЕ ЗначениеЗаполнено(СсылкаSVG) Тогда
			Результат.Ошибка = "Не удалось сохранить файл диаграммы в диалог: " + ИмяSVG;
			Возврат Результат;
		КонецЕсли;

		ТабличныйДокумент = ПостроитьТабличныйДокумент(Строки, Колонки);
		ДвоичныеДанные = ЗаписатьТабличныйДокументВXLSX(ТабличныйДокумент);
		ТабличныйДокумент = Неопределено;
		ИмяXLSX = ИмяФайлаВыгрузки("", "данные_диаграммы", "xlsx");
		СсылкаXLSX = Неопределено;
		Если ДвоичныеДанные <> Неопределено Тогда
			СсылкаXLSX = СИ_ФайлыДиалога.СохранитьБинарныйФайлВДиалоге(
				ИдДиалога, ИмяXLSX, ДвоичныеДанные, "Данные диаграммы");
		КонецЕсли;

		Карточка = Новый Структура;
		Карточка.Вставить("SVG", SVG);
		Карточка.Вставить("Заголовок", Заголовок);
		Карточка.Вставить("Подпись", Подпись);
		Карточка.Вставить("УИДФайла", Строка(СсылкаSVG.УникальныйИдентификатор()));
		Карточка.Вставить("ИмяФайла", ИмяSVG);

		Значение = Новый Структура;
		Значение.Вставить("Ссылка", ?(ЗначениеЗаполнено(СсылкаXLSX),
			Строка(СсылкаXLSX.УникальныйИдентификатор()), Строка(СсылкаSVG.УникальныйИдентификатор())));
		Значение.Вставить("ИмяФайла", ?(ЗначениеЗаполнено(СсылкаXLSX), ИмяXLSX, ИмяSVG));
		Значение.Вставить("Точек", Точек);
		Значение.Вставить("Подпись", Подпись);
		Значение.Вставить("Диаграмма", Карточка);
		Результат.Значение = Значение;
		Результат.Успех = Истина;

	Исключение
		Результат.Ошибка = "Ошибка построения диаграммы: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_Инструменты1С.НарисоватьДиаграмму",
			УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИнструментыОбзора

// Регистрирует инструменты обзора в реестре.
//
// Возвращаемое значение:
//  Массив из Строка - имена зарегистрированных инструментов.
Функция ЗарегистрироватьИнструментыОбзора()

	Зарегистрированные = Новый Массив;

	СвойстваПродаж = Новый Соответствие;
	СвойстваПродаж.Вставить("НачалоПериода", ОписаниеПараметраДаты("Начало периода (ГГГГ-ММ-ДД). По умолчанию - начало текущего месяца."));
	СвойстваПродаж.Вставить("КонецПериода", ОписаниеПараметраДаты("Конец периода (ГГГГ-ММ-ДД), включительно. По умолчанию - конец текущего месяца."));

	Если ЗарегистрироватьИнструмент("GetSalesSummary",
		"Обзор продаж за период: выручка, маржа, количество, число продаж, сравнение с прошлым месяцем и годом, топ-5 товаров и клиентов - для «как продажи», «итоги по выручке»; точечные списки документов - ExecuteDBQuery. Период датами (словами - ParsePeriod), по умолчанию текущий месяц. Нет регистра продаж - ошибка, дальше ExecuteDBQuery.",
		СвойстваПродаж, Неопределено, "СИ_Инструменты1С.ПолучитьСводкуПродаж", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестра("Сводки",
			"сводка, обзор, продажи, выручка, маржа, итоги, оборот",
			"Считаю продажи")) Тогда
		Зарегистрированные.Добавить("GetSalesSummary");
	КонецЕсли;

	СвойстваДенег = Новый Соответствие;
	СвойстваДенег.Вставить("НачалоПериода", ОписаниеПараметраДаты("Начало периода для поступлений/списаний (ГГГГ-ММ-ДД). По умолчанию - начало текущего месяца."));
	СвойстваДенег.Вставить("КонецПериода", ОписаниеПараметраДаты("Конец периода (ГГГГ-ММ-ДД). По умолчанию - текущая дата."));
	СвойстваДенег.Вставить("ДатаОстатков", ОписаниеПараметраДаты("Дата, на которую считать остатки денег и долгов (ГГГГ-ММ-ДД). По умолчанию - текущая дата."));

	Если ЗарегистрироватьИнструмент("GetMoneySummary",
		"Обзор денег и долгов: остаток денег, поступления/списания за период, дебиторка и кредиторка, топ-5 должников - для «сколько денег», «какие долги», «кто нам должен». Период и ДатаОстатков датами (период словами - ParsePeriod); по умолчанию текущий месяц и сегодня. Нет регистров денег/расчётов - ошибка, дальше ExecuteDBQuery.",
		СвойстваДенег, Неопределено, "СИ_Инструменты1С.ПолучитьСводкуДенег", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестра("Сводки",
			"сводка, обзор, деньги, касса, банк, остаток, долг, дебиторка, кредиторка, задолженность",
			"Считаю деньги и долги")) Тогда
		Зарегистрированные.Добавить("GetMoneySummary");
	КонецЕсли;

	СвойстваСклада = Новый Соответствие;
	СвойстваСклада.Вставить("ДатаОстатков", ОписаниеПараметраДаты("Дата, на которую считать остатки (ГГГГ-ММ-ДД). По умолчанию - текущая дата."));
	МесяцевСвойство = Новый Соответствие;
	МесяцевСвойство.Вставить("type", "number");
	МесяцевСвойство.Вставить("description",
		"За сколько последних месяцев проверять движение по позициям (по умолчанию 3).");
	СвойстваСклада.Вставить("МесяцевБезДвижения", МесяцевСвойство);

	Если ЗарегистрироватьИнструмент("GetStockSummary",
		"Обзор склада: стоимость запасов, число позиций, минусовые остатки, позиции без наличия и без движения за N месяцев, топ-20 по стоимости - для «что на складе», «что заканчивается», «что не продаётся». ДатаОстатков датами (по умолчанию сегодня), МесяцевБезДвижения - по умолчанию 3. Нет регистра остатков - ошибка, дальше ExecuteDBQuery.",
		СвойстваСклада, Неопределено, "СИ_Инструменты1С.ПолучитьСводкуСклада", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестра("Сводки",
			"сводка, обзор, склад, остатки, запасы, товары, номенклатура, дефицит",
			"Смотрю склад")) Тогда
		Зарегистрированные.Добавить("GetStockSummary");
	КонецЕсли;

	Возврат Зарегистрированные;

КонецФункции

// Доступность сводок: какие предметные объекты найдены в базе. Нужна стартовому
// экрану чата - плитки ролей показываются, только если сводка применима.
//
// Возвращаемое значение:
//  Структура:
//    * Продажи - Булево - найден регистр продаж;
//    * Деньги - Булево - найден регистр денежных средств;
//    * Долги - Булево - найден регистр расчётов;
//    * Склад - Булево - найден регистр остатков товаров.
Функция ДоступностьОбзоров() Экспорт

	Критерии = Новый Массив;
	Критерии.Добавить(КритерийРегистраПродаж());
	Критерии.Добавить(КритерийРегистраДенег());
	Критерии.Добавить(КритерийРегистраРасчетов());
	Критерии.Добавить(КритерийРегистраОстатков());

	Найденные = НайтиРегистрыСводок(Критерии);

	Результат = Новый Структура;
	Результат.Вставить("Продажи", Найденные.Получить("Продажи") <> Неопределено);
	Результат.Вставить("Деньги", Найденные.Получить("Деньги") <> Неопределено);
	Результат.Вставить("Долги", Найденные.Получить("Долги") <> Неопределено);
	Результат.Вставить("Склад", Найденные.Получить("Склад") <> Неопределено);

	Возврат Результат;

КонецФункции

