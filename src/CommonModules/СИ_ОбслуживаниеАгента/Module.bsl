#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания СИ_ОбслуживаниеАгента.
Процедура ВыполнитьОбслуживание() Экспорт

	УдаленоФактов = ОчиститьПросроченнуюПамять();
	СнятыеЗаходы = СнятьЗависшиеЗаходы();

	ЗаписьЖурналаРегистрации("Агент1С.Обслуживание", УровеньЖурналаРегистрации.Информация,,,
		СтрШаблон("Обслуживание агента: удалено просроченных фактов памяти - %1,"
			+ " снято зависших заходов - %2.",
			УдаленоФактов, СнятыеЗаходы));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удаляет просроченные факты памяти всех диалогов (один пакетный вызов
// СИ_ПамятьДиалога - без запроса на каждый диалог).
//
// Возвращаемое значение:
//  Число - количество удалённых фактов.
Функция ОчиститьПросроченнуюПамять()

	Результат = 0;
	Попытка
		Результат = СИ_ПамятьДиалога.УдалитьПросроченныеПоВсемДиалогам();
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.Обслуживание", УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка очистки просроченной памяти: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Снимает зависшие активные заходы (общий метод СИ_УправлениеДиалогом).
//
// Возвращаемое значение:
//  Число - количество снятых заходов.
Функция СнятьЗависшиеЗаходы()

	Результат = 0;
	Попытка
		Результат = СИ_УправлениеДиалогом.СнятьЗависшиеЗаходы();
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.Обслуживание", УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка снятия зависших заходов: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
