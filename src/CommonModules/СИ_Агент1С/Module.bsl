// Извлекает вызовы инструментов из XML-разметки в тексте ответа модели.
// Модель без tools-схемы иногда эмулирует вызовы инструментов текстом вида:
//   <tool_calls>
//   <invoke name="read_file">
//   <parameter name="filePath">.../Module.bsl</parameter>
//   <parameter name="projectName">unf</parameter>
//   </invoke>
//   </tool_calls>
// Функция разбирает такие блоки и возвращает массив вызовов в формате
// ОбработатьВызовыИнструментов: {Ид, Имя, Аргументы}.
//
// Параметры:
//  Текст - Строка - текст ответа модели.
//
// Возвращаемое значение:
//  Массив из Структура - извлечённые вызовы (пустой массив, если эмуляции нет).
Функция ИзвлечьXMLВызовыИнструментов(Текст)
	Результат = Новый Массив;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстВерхнийРегистр = НРег(Текст);
	ЕстьМаркер = СтрНайти(ТекстВерхнийРегистр, "<tool_calls") > 0
		ИЛИ СтрНайти(ТекстВерхнийРегистр, "<invoke") > 0
		ИЛИ СтрНайти(ТекстВерхнийРегистр, "<function_calls") > 0
		ИЛИ СтрНайти(ТекстВерхнийРегистр, "<call_tool") > 0;
	Если НЕ ЕстьМаркер Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПозицияПоиска = 1;
	ИндексВызова = 0;
	Пока Истина Цикл
		ПозИнвока = СтрНайти(ТекстВерхнийРегистр, "<invoke", НаправлениеПоиска.СНачала, ПозицияПоиска);
		ПозКолТула = СтрНайти(ТекстВерхнийРегистр, "<call_tool", НаправлениеПоиска.СНачала, ПозицияПоиска);
		
		ПозНачала = 0;
		ИмяТега = "";
		Если ПозИнвока > 0 И (ПозКолТула = 0 ИЛИ ПозИнвока < ПозКолТула) Тогда
			ПозНачала = ПозИнвока;
			ИмяТега = "invoke";
		ИначеЕсли ПозКолТула > 0 Тогда
			ПозНачала = ПозКолТула;
			ИмяТега = "call_tool";
		Иначе
			Прервать;
		КонецЕсли;
		
		ПозКонецОткрывающегоТега = СтрНайти(Текст, ">", НаправлениеПоиска.СНачала, ПозНачала);
		Если ПозКонецОткрывающегоТега = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ОткрывающийТег = Сред(Текст, ПозНачала, ПозКонецОткрывающегоТега - ПозНачала + 1);
		ИмяВызова = ИзвлечьЗначениеАтрибута(ОткрывающийТег, "name");
		
		ПозЗакрывающийТег = СтрНайти(ТекстВерхнийРегистр, "</" + ИмяТега + ">", НаправлениеПоиска.СНачала, ПозКонецОткрывающегоТега + 1);
		Если ПозЗакрывающийТег = 0 Тогда
			ПозЗакрывающийТег = СтрДлина(Текст) + 1;
		КонецЕсли;
		
		Тело = Сред(Текст, ПозКонецОткрывающегоТега + 1, ПозЗакрывающийТег - ПозКонецОткрывающегоТега - 1);
		
		Если НЕ ПустаяСтрока(ИмяВызова) Тогда
			Аргументы = ИзвлечьПараметрыИзXML(Тело);
			Вызов = Новый Структура;
			Вызов.Вставить("Ид", "xml_call_" + Строка(ИндексВызова));
			Вызов.Вставить("Имя", ИмяВызова);
			Вызов.Вставить("Аргументы", Аргументы);
			Результат.Добавить(Вызов);
			ИндексВызова = ИндексВызова + 1;
		КонецЕсли;
		
		ПозицияПоиска = ПозЗакрывающийТег + СтрДлина("</" + ИмяТега + ">");
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Извлекает значение атрибута name="..." или name='...' из открывающего тега XML.
// Регистронезависимый поиск имени атрибута: name= / NAME= / Name=.
Функция ИзвлечьЗначениеАтрибута(Тег, ИмяАтрибута)
	ТегВерхнийРегистр = НРег(Тег);
	ИмяАтрибутаВерхнийРегистр = НРег(ИмяАтрибута);
	ШаблонПоиска = ИмяАтрибутаВерхнийРегистр + "=";
	Поз = СтрНайти(ТегВерхнийРегистр, ШаблонПоиска);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ПозЗначения = Поз + СтрДлина(ШаблонПоиска);
	Если ПозЗначения > СтрДлина(Тег) Тогда
		Возврат "";
	КонецЕсли;
	
	Кавычка = Сред(Тег, ПозЗначения, 1);
	Если Кавычка <> """" И Кавычка <> "'" Тогда
		Возврат "";
	КонецЕсли;
	
	ПозЗакрывающейКавычки = СтрНайти(Тег, Кавычка, НаправлениеПоиска.СНачала, ПозЗначения + 1);
	Если ПозЗакрывающейКавычки = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Значение = Сред(Тег, ПозЗначения + 1, ПозЗакрывающейКавычки - ПозЗначения - 1);
	Возврат СокрЛП(Значение);
КонецФункции

// Извлекает параметры из тела блока <invoke>...</invoke>.
// Поддерживает <parameter name="P">value</parameter> и <parameter name="P" value="V"/>.
// Поиск тегов <parameter> и </parameter> — регистронезависимый.
Функция ИзвлечьПараметрыИзXML(Тело)
	Результат = Новый Структура;
	Если ПустаяСтрока(Тело) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТелоВерхнийРегистр = НРег(Тело);
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ПозПараметра = СтрНайти(ТелоВерхнийРегистр, "<parameter", НаправлениеПоиска.СНачала, ПозицияПоиска);
		Если ПозПараметра = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПозКонецОткрывающего = СтрНайти(Тело, ">", НаправлениеПоиска.СНачала, ПозПараметра);
		Если ПозКонецОткрывающего = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ОткрывающийТег = Сред(Тело, ПозПараметра, ПозКонецОткрывающего - ПозПараметра + 1);
		ИмяПараметра = ИзвлечьЗначениеАтрибута(ОткрывающийТег, "name");
		
		ЗначениеПараметра = "";
		Если НЕ ПустаяСтрока(ИмяПараметра) Тогда
			ЗначениеПараметра = ИзвлечьЗначениеАтрибута(ОткрывающийТег, "value");
			Если ПустаяСтрока(ЗначениеПараметра)
				И НЕ (ПозКонецОткрывающего > ПозПараметра
					И Сред(Тело, ПозКонецОткрывающего - 1, 1) = "/") Тогда
				ПозЗакрывающий = СтрНайти(ТелоВерхнийРегистр, "</parameter>", НаправлениеПоиска.СНачала, ПозКонецОткрывающего + 1);
				Если ПозЗакрывающий = 0 Тогда
					ЗначениеПараметра = Сред(Тело, ПозКонецОткрывающего + 1);
				Иначе
					ЗначениеПараметра = Сред(Тело, ПозКонецОткрывающего + 1, ПозЗакрывающий - ПозКонецОткрывающего - 1);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ИмяПараметра) Тогда
			Результат.Вставить(ИмяПараметра, СокрЛП(ЗначениеПараметра));
		КонецЕсли;
		
		ПозЗакрывающийТег = СтрНайти(ТелоВерхнийРегистр, "</parameter>", НаправлениеПоиска.СНачала, ПозПараметра);
		Если ПозЗакрывающийТег = 0 Тогда
			ПозицияПоиска = ПозКонецОткрывающего + 1;
		Иначе
			ПозицияПоиска = ПозЗакрывающийТег + СтрДлина("</parameter>");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Приводит вложения из ДопПараметры к единому массиву структур:
// (ИмяФайла, ТипВложения, Содержимое, АдресВоВременномХранилище, СсылкаСохраненногоФайла).
// Поддерживает два формата:
//  - новый: ДопПараметры.Вложения — массив структур (несколько файлов любых типов);
//  - старый: одиночные поля ТипВложения/ИмяФайла/СодержимоеФайла/АдресФайлаВоВременномХранилище
//    (обратная совместимость) — оборачиваются в массив из одного элемента.
// Если вложений нет — возвращает пустой массив.
//
// Параметры:
//  ДопПараметры - Структура,Неопределено - параметры запуска фонового задания.
//
// Возвращаемое значение:
//  Массив - структуры вложений в едином формате (может быть пустым).
Функция НормализоватьВложенияИзПараметров(ДопПараметры)

	Результат = Новый Массив;
	Если ДопПараметры = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	МассивВложений = СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "Вложения", Неопределено);
	Если МассивВложений <> Неопределено И ТипЗнч(МассивВложений) = Тип("Массив") Тогда

		Для Каждого Вложение Из МассивВложений Цикл
			Если НЕ ТипЗнч(Вложение) = Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Нормализованное = Новый Структура;
			Нормализованное.Вставить("ИмяФайла", Строка(СИ_РаботаСJSON.БезопасноПолучить(Вложение, "ИмяФайла", "файл")));
			Нормализованное.Вставить("ТипВложения", Строка(СИ_РаботаСJSON.БезопасноПолучить(Вложение, "ТипВложения", "Текст")));
			Нормализованное.Вставить("Содержимое", Строка(СИ_РаботаСJSON.БезопасноПолучить(Вложение, "Содержимое", "")));
			Нормализованное.Вставить("АдресВоВременномХранилище", Строка(СИ_РаботаСJSON.БезопасноПолучить(Вложение, "АдресВоВременномХранилище", "")));
			Нормализованное.Вставить("СсылкаСохраненногоФайла", СИ_РаботаСJSON.БезопасноПолучить(Вложение, "СсылкаСохраненногоФайла", Неопределено));
			Результат.Добавить(Нормализованное);
		КонецЦикла;

	Иначе

		ИмяФайла = Строка(СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "ИмяФайла", ""));
		Если НЕ ПустаяСтрока(ИмяФайла) Тогда
			Нормализованное = Новый Структура;
			Нормализованное.Вставить("ИмяФайла", ИмяФайла);
			Нормализованное.Вставить("ТипВложения", Строка(СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "ТипВложения", "Текст")));
			Нормализованное.Вставить("Содержимое", Строка(СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "СодержимоеФайла", "")));
			Нормализованное.Вставить("АдресВоВременномХранилище", Строка(СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "АдресФайлаВоВременномХранилище", "")));
			Нормализованное.Вставить("СсылкаСохраненногоФайла", СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "СсылкаСохраненногоФайла", Неопределено));
			Результат.Добавить(Нормализованное);
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Обрабатывает бинарное вложение (картинку или PDF) для добавления в контекст модели.
//
// Параметры:
//  АдресВложения - Строка - адрес файла во временном хранилище.
//  ИмяФайла - Строка - имя файла с расширением.
//  ТипВложения - Строка - "Картинка" или "PDF".
//  МодельАгента - Строка - основная модель диалога.
//  ПрофильПодключения - СправочникСсылка.СИ_ПрофилиПодключений - профиль подключения.
//  Настройки - Структура - настройки агента (для МодельРаспознованияКартинок и параметров PDF).
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог (для фолбэка чтения из справочника).
//
// Возвращаемое значение:
//  Структура,Неопределено - сообщение для добавления в контекст (в память);
//    Неопределено при ошибке чтения/распознавания.
Функция ОбработатьБинарноеВложение(АдресВложения, ИмяФайла, ТипВложения, МодельАгента, ПрофильПодключения, Настройки, ИдДиалога = Неопределено, СсылкаСохраненногоФайла = Неопределено, РежимСсылка = Неопределено)

	Результат = Неопределено;

	Попытка
		ДвоичныеДанныеВложения = ПолучитьИзВременногоХранилища(АдресВложения);

		Если ДвоичныеДанныеВложения = Неопределено Тогда
			Если ЗначениеЗаполнено(СсылкаСохраненногоФайла) Тогда
				ДвоичныеДанныеВложения = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаСохраненногоФайла, Ложь);
			КонецЕсли;
		КонецЕсли;

		Если ДвоичныеДанныеВложения = Неопределено
			И ЗначениеЗаполнено(ИдДиалога) И НЕ ПустаяСтрока(ИмяФайла) Тогда
			Попытка
				СсылкаФайлаВДиалоге = СИ_ФайлыДиалога.НайтиФайлДиалога(ИдДиалога, ИмяФайла);
				Если ЗначениеЗаполнено(СсылкаФайлаВДиалоге) Тогда
					ДвоичныеДанныеВложения = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаФайлаВДиалоге, Ложь);
				КонецЕсли;
			Исключение
				ЗаписьЖурналаРегистрации("Агент1С.ОбработатьБинарноеВложение.Фолбэк", УровеньЖурналаРегистрации.Предупреждение, ,
					Строка(ИдДиалога) + " | Файл: " + ИмяФайла, "Ошибка чтения файла из справочника: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		Если ДвоичныеДанныеВложения = Неопределено Тогда
			ЗаписьЖурналаРегистрации("Агент1С.ОбработатьБинарноеВложение", УровеньЖурналаРегистрации.Ошибка, ,
				ИмяФайла, "Не удалось получить данные вложения из временного хранилища и из справочника файлов диалога.");
			Возврат Неопределено;
		КонецЕсли;

		Расширение = НРег(СИ_ФайлыДиалога.ПолучитьРасширениеФайла(ИмяФайла));

		МодельVision = "";
		ПрофильVisionДляВложений = Неопределено;
		Попытка
			РежимДляVision = РежимСсылка;
			Если НЕ ЗначениеЗаполнено(РежимДляVision) И ЗначениеЗаполнено(ИдДиалога) Тогда
				Попытка
					ЗначРежимаДиалога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдДиалога, "Режим");
					РежимДляVision = ЗначРежимаДиалога.Режим;
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если ЗначениеЗаполнено(РежимДляVision) Тогда
				ЗначРежимаVision = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РежимДляVision, "МодельРаспознованияКартинок, ПрофильРаспознованияКартинок");
				МодельVision = СокрЛП(Строка(ЗначРежимаVision.МодельРаспознованияКартинок));
				ПрофильVisionДляВложений = ЗначРежимаVision.ПрофильРаспознованияКартинок;
			КонецЕсли;
		Исключение
		КонецПопытки;

		ИспользоватьОтдельноеРаспознавание = (НЕ ПустаяСтрока(МодельVision))
			И (НРег(МодельVision) <> НРег(МодельАгента));

		ЗаписьЖурналаРегистрации("Агент1С.ОбработатьБинарноеВложение", УровеньЖурналаРегистрации.Информация, ,
			ИмяФайла, "Начало обработки. Тип=" + ТипВложения
			+ " | Размер=" + Формат(ДвоичныеДанныеВложения.Размер(), "ЧДЦ=0; ЧГ=0") + " байт"
			+ " | Расширение=" + Расширение
			+ " | МодельVision=" + МодельVision
			+ " | ОтдельноеРаспознавание=" + Строка(ИспользоватьОтдельноеРаспознавание));

		СообщениеСФайлом = Новый Структура;
		СообщениеСФайлом.Вставить("Роль", "user");
		СообщениеСФайлом.Вставить("ФайлВложение", Истина);
		СообщениеСФайлом.Вставить("ИмяВложения", ИмяФайла);

		Если ТипВложения = "PDF" Тогда
			Если ИспользоватьОтдельноеРаспознавание Тогда
				РезультатРаспознавания = СИ_РаспознованиеИзображений.РаспознатьPDF(ДвоичныеДанныеВложения, ПрофильПодключения);
				Если СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Успех", Ложь) Тогда
					ТекстРаспознавания = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "ОбщийТекст", ""));
					Если ПустаяСтрока(ТекстРаспознавания) Тогда
						ТекстРаспознавания = "[PDF «" + ИмяФайла + "» распознан, но текст не извлечён.]";
					КонецЕсли;
					СообщениеСФайлом.Вставить("Контент",
						"Прикреплён PDF-файл «" + ИмяФайла + "». Ниже приведён текст, распознанный vision-моделью по страницам документа:"
						+ Символы.ПС + Символы.ПС
						+ ТекстРаспознавания);
				Иначе
					СообщениеСФайлом.Вставить("Контент",
						"[Прикреплён PDF-файл «" + ИмяФайла + "». Не удалось распознать содержимое: "
						+ Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Ошибка", "ошибка распознавания")) + "]");
				КонецЕсли;
			Иначе
				РезультатКонвертации = СИ_РаспознованиеИзображений.КонвертироватьPDFВКартинки(ДвоичныеДанныеВложения, ПрофильПодключения);
				Если СИ_РаботаСJSON.БезопасноПолучить(РезультатКонвертации, "Успех", Ложь) Тогда
					КартинкиPDF = СИ_РаботаСJSON.БезопасноПолучить(РезультатКонвертации, "Картинки", Новый Массив);
					МассивКартинок = Новый Массив;
					Для Каждого КартинкаPDF Из КартинкиPDF Цикл
						ОписаниеКартинки = Новый Структура;
						ОписаниеКартинки.Вставить("ДвоичныеДанные", СИ_РаботаСJSON.БезопасноПолучить(КартинкаPDF, "ДвоичныеДанные", Неопределено));
						ОписаниеКартинки.Вставить("Расширение", "jpg");
						МассивКартинок.Добавить(ОписаниеКартинки);
					КонецЦикла;
					VisionСообщение = СИ_РаспознованиеИзображений.ПодготовитьVisionСообщение(
						"Прикреплён PDF-файл «" + ИмяФайла + "». Проанализируй изображения страниц документа.",
						МассивКартинок);
					Если VisionСообщение <> Неопределено Тогда
						СообщениеСФайлом.Вставить("Контент", VisionСообщение.Контент);
					КонецЕсли;
				Иначе
					СообщениеСФайлом.Вставить("Контент",
						"[Прикреплён PDF-файл «" + ИмяФайла + "». Не удалось конвертировать PDF в изображения: "
						+ Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатКонвертации, "Ошибка", "ошибка конвертации")) + "]");
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипВложения = "Картинка" Тогда
			Если ИспользоватьОтдельноеРаспознавание Тогда
				РезультатРаспознавания = СИ_РаспознованиеИзображений.РаспознатьИзображение(ДвоичныеДанныеВложения, ИмяФайла, ПрофильVisionДляВложений, РежимДляVision);
				Если СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Успех", Ложь) Тогда
					ТекстРаспознавания = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Текст", ""));
					Если ПустаяСтрока(ТекстРаспознавания) Тогда
						ТекстРаспознавания = "[Изображение «" + ИмяФайла + "» распознано, но текст не извлечён.]";
					КонецЕсли;
					СообщениеСФайлом.Вставить("Контент",
						"Прикреплено изображение «" + ИмяФайла + "». Ниже приведено описание, распознанное vision-моделью:"
						+ Символы.ПС + Символы.ПС
						+ ТекстРаспознавания);
				Иначе
					ОшибкаVision = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Ошибка", "ошибка распознавания"));
					ЗаписьЖурналаРегистрации("Агент1С.ОбработатьБинарноеВложение", УровеньЖурналаРегистрации.Предупреждение, ,
						ИмяФайла, "Vision неуспешен, фолбэк на image_url. Ошибка: " + ОшибкаVision);
					Попытка
						МассивКартинокФолбэк = Новый Массив;
						ОписаниеФолбэк = Новый Структура;
						ОписаниеФолбэк.Вставить("ДвоичныеДанные", ДвоичныеДанныеВложения);
						ОписаниеФолбэк.Вставить("Расширение", Расширение);
						МассивКартинокФолбэк.Добавить(ОписаниеФолбэк);
						VisionФолбэк = СИ_РаспознованиеИзображений.ПодготовитьVisionСообщение(
							"Прикреплено изображение «" + ИмяФайла + "». Проанализируй изображение. (Vision-распознавание не удалось: " + Лев(ОшибкаVision, 200) + ")",
							МассивКартинокФолбэк);
						Если VisionФолбэк <> Неопределено Тогда
							СообщениеСФайлом.Вставить("Контент", VisionФолбэк.Контент);
						Иначе
							СообщениеСФайлом.Вставить("Контент",
								"[Прикреплено изображение «" + ИмяФайла + "». Не удалось распознать: " + ОшибкаVision + "]");
						КонецЕсли;
					Исключение
						СообщениеСФайлом.Вставить("Контент",
							"[Прикреплено изображение «" + ИмяФайла + "». Не удалось распознать: " + ОшибкаVision + "]");
					КонецПопытки;
				КонецЕсли;
			Иначе
				МассивКартинок = Новый Массив;
				ОписаниеКартинки = Новый Структура;
				ОписаниеКартинки.Вставить("ДвоичныеДанные", ДвоичныеДанныеВложения);
				ОписаниеКартинки.Вставить("Расширение", Расширение);
				МассивКартинок.Добавить(ОписаниеКартинки);

				VisionСообщение = СИ_РаспознованиеИзображений.ПодготовитьVisionСообщение(
					"Прикреплено изображение «" + ИмяФайла + "». Проанализируй изображение.",
					МассивКартинок);
				Если VisionСообщение <> Неопределено Тогда
					СообщениеСФайлом.Вставить("Контент", VisionСообщение.Контент);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Результат = СообщениеСФайлом;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ОбработатьБинарноеВложение", УровеньЖурналаРегистрации.Ошибка, ,
			ИмяФайла, "Ошибка обработки бинарного вложения: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Подмешивает релевантные факты памяти диалога в первое system-сообщение истории.
// История сообщений остаётся как есть — память добавляется отдельным блоком
// в system-контент. Ничего не делает, если система/история пуста или фактов нет.
//
// Параметры:
//  ИдДиалога  - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  История    - Массив из Структура - история сообщений (мутируется на месте).
//
Процедура ПодмешатьПамятьВИсторию(ИдДиалога, История)

	Если История = Неопределено ИЛИ История.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТекстПамяти = СИ_ПамятьДиалога.СформироватьБлокПамяти(ИдДиалога);
	Если ДописатьБлокВПервоеСистемноеСообщение(История, ТекстПамяти) Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ПамятьДиалога", УровеньЖурналаРегистрации.Информация,
			Строка(ИдДиалога),, "Память подмешана в system-сообщение");
	КонецЕсли;

КонецПроцедуры

// Общий примитив подмешивания служебного блока в системный промпт: находит
// первое system-сообщение истории и дописывает к его контенту готовый текст
// (сам текст собирает вызывающий код - блоки памяти, открытых форм и имени
// пользователя отличаются только источником). Правка формата сообщений
// делается здесь одна, а не в каждой процедуре подмешивания.
//
// Блок добавляется ТОЛЬКО в памяти захода: история, прочитанная из регистра,
// не меняется, поэтому служебные блоки не накапливаются в диалоге.
//
// Параметры:
//  История - Массив из Структура - история сообщений (мутируется на месте).
//  ТекстБлока - Строка - готовый текст блока; пустая строка - ничего не делает.
//
// Возвращаемое значение:
//  Булево - Истина, если блок добавлен (есть system-сообщение и непустой текст).
Функция ДописатьБлокВПервоеСистемноеСообщение(История, ТекстБлока)

	Если История = Неопределено ИЛИ История.Количество() = 0 ИЛИ ПустаяСтрока(ТекстБлока) Тогда
		Возврат Ложь;
	КонецЕсли;

	СистемноеСообщение = Неопределено;
	Для Каждого Сообщение Из История Цикл
		РольСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
		Если ПустаяСтрока(РольСообщения) Тогда
			РольСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "role", "");
		КонецЕсли;
		Если РольСообщения = "system" Тогда
			СистемноеСообщение = Сообщение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СистемноеСообщение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	КонтентСистемы = СИ_РаботаСJSON.БезопасноПолучить(СистемноеСообщение, "Контент", "");
	Если ПустаяСтрока(КонтентСистемы) Тогда
		КонтентСистемы = СИ_РаботаСJSON.БезопасноПолучить(СистемноеСообщение, "content", "");
	КонецЕсли;

	Если ПустаяСтрока(КонтентСистемы) Тогда
		СистемноеСообщение.Вставить("Контент", ТекстБлока);
	Иначе
		СистемноеСообщение.Вставить("Контент", КонтентСистемы + Символы.ПС + Символы.ПС + ТекстБлока);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Подмешивает в первое system-сообщение истории блок с формами, открытыми
// у пользователя в клиенте. Список передаёт клиент (только там доступен
// ПолучитьОкна) в ДопПараметры.ОткрытыеФормы; ядро лишь добавляет готовый
// текст в system-контент. Блок живёт ТОЛЬКО в памяти захода и в регистр не
// пишется, поэтому список всегда соответствует моменту последнего запроса.
//
// Параметры:
//  История - Массив из Структура - история сообщений (мутируется на месте).
//  ДопПараметры - Структура,Неопределено - доп.параметры захода.
Процедура ПодмешатьОткрытыеФормыВИсторию(История, ДопПараметры)

	Если ДопПараметры = Неопределено ИЛИ История = Неопределено ИЛИ История.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОткрытыеФормы = СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "ОткрытыеФормы", Неопределено);
	СписокФорм = СформироватьСписокОткрытыхФорм(ОткрытыеФормы);
	Если ПустаяСтрока(СписокФорм) Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ОткрытыеФормы", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Клиент не передал список открытых форм (ДопПараметры.ОткрытыеФормы пуст)");
		Возврат;
	КонецЕсли;

	ТекстБлока = СИ_Промпты.БлокОткрытыхФорм(СписокФорм);
	ДописатьБлокВПервоеСистемноеСообщение(История, ТекстБлока);

КонецПроцедуры

// Формирует текстовый перечень открытых форм для блока системного промпта:
// по одной форме в строке, вида «- Заголовок (ПолноеИмяФормы)». Одна и та же
// форма, открытая в нескольких окнах, выводится один раз; размер перечня
// ограничен МаксимумФормВПромпте, а заголовок и имя формы обезвреживаются
// (ОбезвредитьТекстФормы) - заголовок формирует приложение, и перевод строки
// в нём разорвал бы формат блока.
//
// Перечень возвращается СТРОКОЙ, а не массивом, потому что его принимает
// СИ_Промпты.БлокОткрытыхФорм - модуль с кэшированием возвращаемых значений
// (см. шапку СИ_Промпты).
//
// Параметры:
//  ОткрытыеФормы - Массив из Структура,Неопределено - формы, собранные на клиенте
//    (элементы: ИмяФормы, Заголовок).
//
// Возвращаемое значение:
//  Строка - перечень форм (пустая строка, если форм нет).
Функция СформироватьСписокОткрытыхФорм(ОткрытыеФормы)
	Если ОткрытыеФормы = Неопределено ИЛИ ТипЗнч(ОткрытыеФормы) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	МаксимумФорм = МаксимумФормВПромпте();
	СписокФорм = "";
	ВыведенныеФормы = Новый Соответствие;

	Для Каждого ОткрытаяФорма Из ОткрытыеФормы Цикл
		Если ВыведенныеФормы.Количество() >= МаксимумФорм Тогда
			Прервать;
		КонецЕсли;
		Если ТипЗнч(ОткрытаяФорма) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		ИмяФормы = "";
		Если ОткрытаяФорма.Свойство("ИмяФормы") Тогда
			ИмяФормы = ОбезвредитьТекстФормы(ОткрытаяФорма.ИмяФормы);
		КонецЕсли;
		Заголовок = "";
		Если ОткрытаяФорма.Свойство("Заголовок") Тогда
			Заголовок = ОбезвредитьТекстФормы(ОткрытаяФорма.Заголовок);
		КонецЕсли;

		Если ПустаяСтрока(ИмяФормы) И ПустаяСтрока(Заголовок) Тогда
			Продолжить;
		КонецЕсли;

		КлючФормы = ИмяФормы + "|" + Заголовок;
		Если ВыведенныеФормы[КлючФормы] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВыведенныеФормы.Вставить(КлючФормы, Истина);

		ОписаниеФормы = Заголовок;
		Если ПустаяСтрока(ОписаниеФормы) Тогда
			ОписаниеФормы = ИмяФормы;
		ИначеЕсли НЕ ПустаяСтрока(ИмяФормы) Тогда
			ОписаниеФормы = Заголовок + " (" + ИмяФормы + ")";
		КонецЕсли;

		СписокФорм = СписокФорм + ?(ПустаяСтрока(СписокФорм), "", Символы.ПС) + "- " + ОписаниеФормы;
	КонецЦикла;

	Возврат СписокФорм;
КонецФункции

// Подмешивает в первое system-сообщение истории блок с именем текущего
// пользователя. Имя вычисляет ИмяТекущегоПользователя, а текст блока собирает
// СИ_Промпты.БлокПользователя. Как и память с открытыми формами, блок живёт
// только в памяти захода - в регистр сообщений он не пишется.
//
// Параметры:
//  История - Массив из Структура - история сообщений (мутируется на месте).
//  ИмяПользователя - Строка - имя пользователя; пустая строка - ничего не делает.
Процедура ПодмешатьПользователяВИсторию(История, ИмяПользователя)

	Если ДописатьБлокВПервоеСистемноеСообщение(История, СИ_Промпты.БлокПользователя(ИмяПользователя)) Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ТекущийПользователь", УровеньЖурналаРегистрации.Информация, , ,
			"Имя пользователя подмешано в system-сообщение: " + ИмяПользователя);
	КонецЕсли;

КонецПроцедуры

// Определяет имя пользователя для блока системного промпта. Приоритет:
// владелец диалога (реквизит Пользователь - его проставляет форма чата при
// создании диалога), затем авторизованный пользователь сеанса. Владелец важнее
// сеанса: фоновое задание агента может исполняться в сеансе, отличном от
// клиентского, а диалог всегда принадлежит конкретному пользователю.
//
// Чтение реквизита - через ОбщегоНазначения.ЗначенияРеквизитовОбъекта (без
// ПолучитьОбъект): объект диалога параллельно пишется фоновым заданием, и
// чтение через полученный объект давало бы конфликты версий.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента,Неопределено - диалог захода.
//
// Возвращаемое значение:
//  Строка - имя пользователя (пустая строка, если определить не удалось).
Функция ИмяТекущегоПользователя(ИдДиалога)

	Пользователь = Неопределено;
	Если ЗначениеЗаполнено(ИдДиалога) Тогда
		Попытка
			Пользователь = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдДиалога, "Пользователь").Пользователь;
		Исключение
			Пользователь = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Попытка
			Пользователь = Пользователи.АвторизованныйПользователь();
		Исключение
			Пользователь = Неопределено;
		КонецПопытки;
	КонецЕсли;

	ИмяДляПромпта = ОбезвредитьТекстФормы(Пользователь, 150);
	Если ПустаяСтрока(ИмяДляПромпта) Тогда
		Попытка
			ИмяДляПромпта = ОбезвредитьТекстФормы(ИмяПользователя(), 150);
		Исключение
			ИмяДляПромпта = "";
		КонецПопытки;
	КонецЕсли;

	Если ПустаяСтрока(ИмяДляПромпта) Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ТекущийПользователь", УровеньЖурналаРегистрации.Предупреждение, ,
			Строка(ИдДиалога), "Не удалось определить имя пользователя - блок «Пользователь» не подмешан");
	КонецЕсли;

	Возврат ИмяДляПромпта;

КонецФункции

// Приводит заголовок или имя формы к виду, безопасному для текста системного
// промпта: убирает переводы строк (заголовок формирует приложение, и символ
// перевода строки в нём позволил бы разорвать формат блока и подставить свои
// строки) и усекает слишком длинный текст, чтобы одно длинное имя не съедало
// токены всего блока.
//
// Параметры:
//  Значение - Произвольный - заголовок окна или полное имя формы.
//  МаксДлина - Число - предельная длина результата в символах.
//
// Возвращаемое значение:
//  Строка - очищенный текст.
Функция ОбезвредитьТекстФормы(Значение, МаксДлина = 100)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Если СтрДлина(Текст) > МаксДлина Тогда
		Текст = Лев(Текст, МаксДлина) + "...";
	КонецЕсли;

	Возврат Текст;
КонецФункции

// Сохраняет ключевые факты текущего захода агента в память диалога.
// MVP-эвристика БЕЗ вызова модели:
//   1. Финальный итоговый текст (ИтоговыйТекст) → факт типа "Вывод".
//   2. Каждый tool-вызов (Имя + краткие аргументы) → факт типа "Факт".
// Всё в Попытка/Исключение — сбой памяти не влияет на результат захода.
//
// Параметры:
//  ИдДиалога     - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  КонтекстЦикла - Структура - контекст цикла (Сообщения, ВызовыИнструментов,
//                  СчетчикИтераций, ИтоговыйТекст).
//
Процедура СохранитьФактыЗахода(ИдДиалога, КонтекстЦикла)

	МассивФактов = Новый Массив;

	ИтоговыйТекстЗахода = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИтоговыйТекст", "");
	Если НЕ ПустаяСтрока(ИтоговыйТекстЗахода) Тогда
		КлючВывода = СИ_ПамятьДиалога.ПрефиксКлючаВывода() + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
		ЗначениеВывода = Лев(СокрЛП(ИтоговыйТекстЗахода), СИ_ПамятьДиалога.МаксДлинаЗначенияФакта());
		ФактВывод = Новый Структура("ТипФакта,Ключ,Значение,Сортировка,АктуальноДо,Источник,Пользователь",
			СИ_ПамятьДиалога.ТипФактаВывод(), КлючВывода, ЗначениеВывода, СИ_ПамятьДиалога.ПриоритетФактаВывод(), Неопределено,
			"Итерация " + Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "СчетчикИтераций", 0)), Неопределено);
		МассивФактов.Добавить(ФактВывод);
	КонецЕсли;

	ВызовыЗахода = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ВызовыИнструментов", Неопределено);
	Если ВызовыЗахода <> Неопределено И ТипЗнч(ВызовыЗахода) = Тип("Массив") Тогда
		НомерВызова = 0;
		Для Каждого ВызовЗахода Из ВызовыЗахода Цикл
			НомерВызова = НомерВызова + 1;
			ИмяИнструмента = Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовЗахода, "Имя", ""));
			Если ПустаяСтрока(ИмяИнструмента) Тогда
				ИмяИнструмента = Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовЗахода, "name", ""));
			КонецЕсли;
			Если ПустаяСтрока(ИмяИнструмента) Тогда
				Продолжить;
			КонецЕсли;

			АргументыВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовЗахода, "Аргументы", "");
			Если АргументыВызова <> Неопределено И ТипЗнч(АргументыВызова) <> Тип("Строка") Тогда
				АргументыВызова = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(АргументыВызова);
			КонецЕсли;
			АргументыВызова = Строка(АргументыВызова);

			ИдВызоваИнструмента = Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовЗахода, "Ид", ""));
			Если ПустаяСтрока(ИдВызоваИнструмента) Тогда
				ИдВызоваИнструмента = Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовЗахода, "id", ""));
			КонецЕсли;
			Если ПустаяСтрока(ИдВызоваИнструмента) Тогда
				ИдВызоваИнструмента = СИ_ПамятьДиалога.ПрефиксКлючаВызова() + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss") + "_" + Строка(НомерВызова);
			КонецЕсли;

			ЗначениеИнструмента = ИмяИнструмента + ?(ПустаяСтрока(АргументыВызова), "",
				": " + Лев(АргументыВызова, СИ_ПамятьДиалога.МаксДлинаАргументовИнструмента()));
			ФактИнструмента = Новый Структура("ТипФакта,Ключ,Значение,Сортировка,АктуальноДо,Источник,Пользователь",
				СИ_ПамятьДиалога.ТипФактаФакт(), ИдВызоваИнструмента, ЗначениеИнструмента, СИ_ПамятьДиалога.ПриоритетФактаИнструмент(), Неопределено,
				СИ_ПамятьДиалога.ПрефиксИсточникаИнструмента() + ИмяИнструмента, Неопределено);
			МассивФактов.Добавить(ФактИнструмента);
		КонецЦикла;
	КонецЕсли;

	Если МассивФактов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СИ_ПамятьДиалога.ДобавитьФакты(ИдДиалога, МассивФактов);

	ЗаписьЖурналаРегистрации("Агент1С.ПамятьДиалога", УровеньЖурналаРегистрации.Информация,
		Строка(ИдДиалога),, "Сохранено фактов памяти захода: " + Строка(МассивФактов.Количество()));

КонецПроцедуры

// Собирает карту навигационных ссылок финального ответа: карты всех
// tool-сообщений текущего ХОДА, от последнего сообщения пользователя до конца
// истории захода. Именно из истории, а не из накопителя в контексте цикла:
// после паузы на запрос разрешения контекст создаётся заново, а история
// восстанавливается из регистра, поэтому ссылки на объекты, найденные ДО
// подтверждения, не теряются.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//
// Возвращаемое значение:
//  Массив из Структура - карта ссылок (Упоминание, Адрес); пустой массив,
//  если в ходу ссылок не было.
Функция СобратьСсылкиХодаДляОтвета(КонтекстЦикла)

	Результат = Новый Массив;
	Сообщения = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Сообщения", Неопределено);
	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	УжеСобрано = Новый Соответствие;

	Индекс = Сообщения.ВГраница();
	Пока Индекс >= 0 Цикл
		Сообщение = Сообщения[Индекс];
		Индекс = Индекс - 1;

		Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
		Если ПустаяСтрока(Роль) Тогда
			Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "role", "");
		КонецЕсли;
		Если Роль = "user" Тогда
			Прервать;
		КонецЕсли;

		СсылкиСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "СсылкиДокументов", Неопределено);
		Если ТипЗнч(СсылкиСообщения) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СсылкаКарты Из СсылкиСообщения Цикл
			Если Результат.Количество() >= МаксимумСсылокВОтвете() Тогда
				Возврат Результат;
			КонецЕсли;
			Упоминание = СИ_РаботаСJSON.БезопасноПолучить(СсылкаКарты, "Упоминание", "");
			Адрес = СИ_РаботаСJSON.БезопасноПолучить(СсылкаКарты, "Адрес", "");
			Если ПустаяСтрока(Упоминание) ИЛИ ПустаяСтрока(Адрес)
				ИЛИ УжеСобрано.Получить(Упоминание) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УжеСобрано.Вставить(Упоминание, Истина);
			Результат.Добавить(Новый Структура("Упоминание, Адрес", Упоминание, Адрес));
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собирает карточки диаграмм текущего хода (по образцу СобратьСсылкиХодаДляОтвета):
// обходит историю с конца до вопроса пользователя и берёт ключ Диаграмма из
// tool-сообщений. Рисуется не больше МаксимумДиаграммВОтвете() карточек -
// несколько диаграмм в одном ответе дублируют друг друга и раздувают документ.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла.
//
// Возвращаемое значение:
//  Массив из Структура - карточки диаграмм (SVG, Заголовок, Подпись,
//  УИДФайла, ИмяФайла); пустой массив, если диаграмм в ходу не было.
Функция СобратьДиаграммыХодаДляОтвета(КонтекстЦикла)

	Результат = Новый Массив;
	Сообщения = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Сообщения", Неопределено);
	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	УжеСобрано = Новый Соответствие;
	Индекс = Сообщения.ВГраница();
	Пока Индекс >= 0 Цикл
		Сообщение = Сообщения[Индекс];
		Индекс = Индекс - 1;

		Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
		Если ПустаяСтрока(Роль) Тогда
			Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "role", "");
		КонецЕсли;
		Если Роль = "user" Тогда
			Прервать;
		КонецЕсли;

		ДиаграммаСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Диаграмма", Неопределено);
		Если ДиаграммаСообщения = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Карточки = Новый Массив;
		Если ТипЗнч(ДиаграммаСообщения) = Тип("Массив") Тогда
			Для Каждого Элемент Из ДиаграммаСообщения Цикл
				Карточки.Добавить(Элемент);
			КонецЦикла;
		ИначеЕсли ТипЗнч(ДиаграммаСообщения) = Тип("Структура") Тогда
			Карточки.Добавить(ДиаграммаСообщения);
		КонецЕсли;

		Для Каждого Карточка Из Карточки Цикл
			Если Результат.Количество() >= МаксимумДиаграммВОтвете() Тогда
				Возврат Результат;
			КонецЕсли;
			УИДФайла = СИ_РаботаСJSON.БезопасноПолучить(Карточка, "УИДФайла", "");
			Если Неопределено = УжеСобрано.Получить(УИДФайла) Тогда
				УжеСобрано.Вставить(УИДФайла, Истина);
				Результат.Добавить(Карточка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Максимальное число карточек диаграмм в одном ответе.
//
// Возвращаемое значение:
//  Число - предел карточек.
Функция МаксимумДиаграммВОтвете()

	Возврат 3;

КонецФункции

// Копия массива сообщений без служебных сообщений агента (роль "service"):
// ошибки вызова модели и уведомления о лимите токенов адресованы пользователю
// и не должны попадать в контекст модели.
//
// Параметры:
//  Сообщения - Массив - история сообщений захода.
//
// Возвращаемое значение:
//  Массив - история без служебных сообщений (порядок остальных сохранён).
Функция СообщенияБезСлужебныхРолей(Сообщения)

	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат Сообщения;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
		Если ПустаяСтрока(Роль) Тогда
			Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "role", "");
		КонецЕсли;
		Если Роль = "service" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Сообщение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Копия массива сообщений без служебных ключей, которых не должно быть в
// запросе к модели: карта навигационных ссылок СсылкиДокументов и карточки
// диаграмм Диаграмма. Сообщения без служебных ключей переносятся КАК ЕСТЬ:
// копирование всего массива на каждой итерации цикла не нужно.
//
// Параметры:
//  Сообщения - Массив - история сообщений захода.
//
// Возвращаемое значение:
//  Массив - сообщения, пригодные для отправки в API.
Функция СообщенияБезСлужебныхКлючей(Сообщения)

	СлужебныеКлючи = Новый Массив;
	СлужебныеКлючи.Добавить("СсылкиДокументов");
	СлужебныеКлючи.Добавить("Диаграмма");

	Результат = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Если Сообщение = Неопределено ИЛИ ТипЗнч(Сообщение) = Тип("Строка") Тогда
			Результат.Добавить(Сообщение);
			Продолжить;
		КонецЕсли;

		ЕстьСлужебныйКлюч = Ложь;
		Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
			Для Каждого Ключ Из СлужебныеКлючи Цикл
				Если Сообщение.Свойство(Ключ) Тогда
					ЕстьСлужебныйКлюч = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(Сообщение) = Тип("Соответствие") Тогда
			Для Каждого Ключ Из СлужебныеКлючи Цикл
				Если Сообщение.Получить(Ключ) <> Неопределено Тогда
					ЕстьСлужебныйКлюч = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если НЕ ЕстьСлужебныйКлюч Тогда
			Результат.Добавить(Сообщение);
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
			Копия = Новый Структура;
			Для Каждого Пара Из Сообщение Цикл
				Если СлужебныеКлючи.Найти(Пара.Ключ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Копия.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
			Результат.Добавить(Копия);
		ИначеЕсли ТипЗнч(Сообщение) = Тип("Соответствие") Тогда
			Копия = Новый Соответствие;
			Для Каждого Пара Из Сообщение Цикл
				Если СлужебныеКлючи.Найти(Пара.Ключ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Копия.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
			Результат.Добавить(Копия);
		Иначе
			Результат.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Максимальное число ссылок в карте ответа. Совпадает с лимитом карты
// инструмента (СИ_УправлениеИнструментами1С.МаксимумСсылокВКарте): объединение карт
// хода не должно раздувать сообщение диалога.
//
// Возвращаемое значение:
//  Число - лимит ссылок.
Функция МаксимумСсылокВОтвете()
	Возврат 20;
КонецФункции

#Область ПодборИнструментовШага

// Имя виртуального инструмента загрузки дополнительных инструментов.
// В справочник СИ_ИнструментыАгента он не пишется и обрабатывается ядром до
// диспетчеризации: иначе администратор мог бы его отключить и сломать подбор.
//
// Возвращаемое значение:
//  Строка - имя инструмента (как его видит модель).
Функция ИмяИнструментаЗагрузкиИнструментов()
	Возврат "fetch_toolset";
