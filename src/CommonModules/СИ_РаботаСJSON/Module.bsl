#Область ПрограммныйИнтерфейс

// Разбор JSON-строки в платформенные структуры (Соответствие, Массив, скаляры).
// Использует ручной парсер, не зависящий от платформенного ЧтениеJSON,
// который некорректно работает на некоторых платформах.
//
// Параметры:
//  Текст - Строка - JSON-строка для разбора.
//
// Возвращаемое значение:
//  Произвольный - разобранное значение; Неопределено при ошибке разбора
//    (ошибка логируется в журнал регистрации).
Функция ПрочитатьСтрокуJSON(Текст) Экспорт
	Попытка
		Поз = 1;
		Результат = РучнойПарсерJSON(Текст, Поз, 0);
		Возврат Результат;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.Debug.ОшибкаJSON", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка парсинга JSON: " + ОписаниеОшибки()
			+ " | Длина строки = " + Строка(СтрДлина(Текст))
			+ " | Первые 200 символов = " + Лев(Текст, 200));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Сериализация платформенного значения в JSON-строку.
//
// Параметры:
//  Значение - Произвольный - значение для сериализации
//    (Соответствие, Массив, Структура, Строка, Число, Булево, Неопределено, Дата, ссылка 1С).
//
// Возвращаемое значение:
//  Строка - JSON-строка; пустая строка ("") при ошибке сериализации
//    (ошибка логируется в журнал регистрации).
Функция ЗаписатьСтрокуJSON(Значение) Экспорт
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьЗначениеВJSON(ЗаписьJSON, Значение);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Трассировка = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Агент1С.Debug.ОшибкаСериализацииJSON", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка сериализации JSON: " + Трассировка
			+ " | Тип значения = " + ?(Значение = Неопределено, "Неопределено", Строка(ТипЗнч(Значение)))
			+ " | Трассировка = " + Трассировка);
		Возврат "";
	КонецПопытки;
КонецФункции

// Разбор event-stream из тела HTTP-ответа на отдельные data-чанки.
// Поддерживает поля data, event, id и комментарии (:) спецификации SSE,
// нормализует окончания строк \r\n -> \n.
//
// Параметры:
//  Чтение - Поток - источник байтов SSE-потока.
//  ОбработчикЧанка - ОписаниеОповещения,Неопределено - колбэк обработки каждого чанка;
//    при Неопределено чанки собираются в возвращаемый массив.
//    Колбэк вызывается как Выполнить(Чанк, ДопПараметры); для маркера завершения
//    [DONE] ДопПараметры содержит структуру {"_done":Истина, "Закончен":Истина}.
//
// Возвращаемое значение:
//  Массив Из Структура - массив разобранных чанков SSE:
//    * Элемент - Структура/Соответствие - разобранный объект data
//      (или {"_done":Истина} для [DONE]).
//    Пустой массив при ошибке чтения (ошибка логируется в журнал регистрации).
Функция ПрочитатьSSEПоток(Чтение, ОбработчикЧанка) Экспорт
	Результат = Новый Массив;
	ЧтениеТекста = Новый ЧтениеТекста;
	Состояние = Новый Структура("ТекущиеДанные, ТипСобытия, ИдСобытия", "", "", "");
	
	Попытка
		Если Чтение = Неопределено Тогда
			ВызватьИсключение "Не передан источник SSE-потока (Чтение = Неопределено)";
		КонецЕсли;
		
		Если ТипЗнч(Чтение) = Тип("Поток") Тогда
			ЧтениеТекста.Открыть(Чтение, "UTF-8");
		Иначе
			ВызватьИсключение "Неподдерживаемый тип источника SSE: " + Строка(ТипЗнч(Чтение));
		КонецЕсли;
		
		Пока Истина Цикл
			СтрокаSSE = ЧтениеТекста.ПрочитатьСтроку();
			Если СтрокаSSE = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			СтрокаSSE = СокрЛП(СтрокаSSE);
			ОбработатьСтрокуSSE(СтрокаSSE, Состояние, Результат, ОбработчикЧанка, Истина);
		КонецЦикла;
		
		ЧтениеТекста.Закрыть();
		
		Если НЕ ПустаяСтрока(Состояние.ТекущиеДанные) Тогда
			РазобратьSSEData(Состояние.ТекущиеДанные, Результат, ОбработчикЧанка);
		КонецЕсли;
		
	Исключение
		Попытка
			ЧтениеТекста.Закрыть();
		Исключение
			ИгнорОшибкиЗакрытия = ОписаниеОшибки();
		КонецПопытки;
		ЗаписьЖурналаРегистрации("Агент1С.РаботаСJSON.ПрочитатьОбъектSSE", УровеньЖурналаРегистрации.Ошибка,
			,, "Ошибка чтения потока SSE: " + ОписаниеОшибки()
			+ " | Тип источника = " + ?(Чтение = Неопределено, "Неопределено", Строка(ТипЗнч(Чтение))));
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Извлечение JSON-значений из текстового SSE-потока ("data: ...").
// Отличается от ПрочитатьSSEПоток тем, что принимает уже полученную строку тела
// ответа (не поток байтов), и возвращает массив разобранных значений без
// служебного чанка {"_done":Истина} для [DONE] (такие строки игнорируются).
// Поддерживает многострочные data-блоки (объединяются переводом строки),
// поля event/id и комментарии (:) спецификации SSE.
//
// Параметры:
//  Тело - Строка - текст SSE-потока (тело HTTP-ответа).
//
// Возвращаемое значение:
//  Массив из Произвольный - массив разобранных data-значений;
//    пустой массив при отсутствии data-строк или при ошибке разбора
//    (ошибка логируется в журнал регистрации).
Функция ИзвлечьJSONИзSSE(Тело) Экспорт
	Результат = Новый Массив;
	Состояние = Новый Структура("ТекущиеДанные, ТипСобытия, ИдСобытия", "", "", "");
	Попытка
		Строки = СтрРазделить(Тело, Символы.ПС, Ложь);
		Для Каждого СтрокаSSE Из Строки Цикл
			СтрокаSSE = СокрЛП(СтрокаSSE);
			ОбработатьСтрокуSSE(СтрокаSSE, Состояние, Результат, Неопределено, Ложь);
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(Состояние.ТекущиеДанные) Тогда
			РазобратьSSEData(Состояние.ТекущиеДанные, Результат, Неопределено);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РаботаСJSON.ИзвлечьJSONИзSSE", УровеньЖурналаРегистрации.Предупреждение,
			,, "Ошибка разбора SSE-тела: " + ОписаниеОшибки()
			+ " | Длина тела = " + Строка(СтрДлина(Тело)));
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Конвертация Структуры в Соответствие для совместимости с парсером JSON.
//
// Примечание (M10/F4): ключи Структуры всегда строки, поэтому на этом шаге
// потери ключей нет. При обратной конвертации Соответствие -> Структура
// ключи-не-строки теряются, поэтому round-trip
// Структура -> Соответствие -> Структура сохраняет данные полностью,
// а Соответствие -> Структура -> Соответствие — нет.
//
// Параметры:
//  ИсходнаяСтруктура - Структура - исходная структура.
//
// Возвращаемое значение:
//  Соответствие из Строка,Произвольный - соответствие с теми же ключами и значениями.
Функция СтруктуруВСоответствие(ИсходнаяСтруктура) Экспорт
	Результат = Новый Соответствие;
	Для Каждого КлючЗначение Из ИсходнаяСтруктура Цикл
		Результат.Вставить(КлючЗначение.Ключ, СконвертироватьЗначениеВСоответствие(КлючЗначение.Значение));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Конвертация Соответствия в Структуру для удобства доступа по точке.
//
// Примечание (M10/F4): ключи-не-строки (например, Число) не могут быть
// ключами Структуры и пропускаются с записью предупреждения в журнал.
// Значение Неопределено по существующему ключу в Соответствии неотличимо
// от отсутствующего ключа (см. БезопасноПолучить), поэтому при round-trip
// такие пары также теряются.
//
// Параметры:
//  ИсходноеСоответствие - Соответствие из Строка,Произвольный - исходное соответствие.
//
// Возвращаемое значение:
//  Структура - структура с теми же ключами и значениями
//    (ключи-не-строки пропускаются с записью предупреждения в журнал).
Функция СоответствиеВСтруктуру(ИсходноеСоответствие) Экспорт
	Результат = Новый Структура;
	Для Каждого КлючЗначение Из ИсходноеСоответствие Цикл
		Ключ = КлючЗначение.Ключ;
		Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
			ЗаписьЖурналаРегистрации("Агент1С.СоответствиеВСтруктуру", УровеньЖурналаРегистрации.Предупреждение,
				,, "Пропущен ключ не-строка: " + Строка(Ключ));
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Ключ, СконвертироватьЗначениеВСтруктуру(КлючЗначение.Значение));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Безопасный доступ к значению вложенного контейнера по ключу с возвратом значения по умолчанию.
//
// Параметры:
//  Контейнер - Структура,Соответствие из Строка,Произвольный,Неопределено - исходный контейнер.
//  Ключ - Строка - ключ поиска.
//  ПоУмолчанию - Произвольный - значение по умолчанию при отсутствии ключа или Неопределено контейнера.
//
// Возвращаемое значение:
//  Произвольный - найденное значение или ПоУмолчанию.
//
// Примечание (C4): для Соответствие значение Неопределено по существующему ключу
// неотличимо от отсутствующего ключа — в 1С нет метода проверки существования ключа
// у Соответствия, поэтому в обоих случаях возвращается ПоУмолчанию.
// Для Структура используется метод Свойство(), поэтому значение Неопределено
// по существующему ключу возвращается корректно.
Функция БезопасноПолучить(Контейнер, Ключ, ПоУмолчанию) Экспорт
	Если Контейнер = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	
	Если ТипЗнч(Контейнер) = Тип("Структура") Тогда
		Результат = Неопределено;
		Если Контейнер.Свойство(Ключ, Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Контейнер) = Тип("Соответствие") Тогда
		Значение = Контейнер.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Максимальная глубина рекурсии парсера JSON и конвертеров значений (C5).
//
// Возвращаемое значение:
//  Число - предельная глубина вложенности (защита от переполнения стека).
Функция МаксимальнаяГлубинаРекурсии()
	Возврат 1000;
КонецФункции

// Префикс поля data в строке SSE (S7).
//
// Возвращаемое значение:
//  Строка - литерал "data:".
Функция ПрефиксDataSSE()
	Возврат "data:";
КонецФункции

// Маркер завершения потока SSE (S7).
//
// Возвращаемое значение:
//  Строка - литерал "[DONE]".
Функция МаркерЗавершенияSSE()
	Возврат "[DONE]";
КонецФункции

// Ключ маркера завершения в структуре чанка (S7).
//
// Возвращаемое значение:
//  Строка - литерал "_done".
Функция КлючМаркераЗавершения()
	Возврат "_done";
КонецФункции

// Обработка одной строки SSE-потока по спецификации Server-Sent Events.
// Единая логика разбора для ПрочитатьSSEПоток и ИзвлечьJSONИзSSE (M2).
//
// Параметры:
//  СтрокаSSE - Строка - строка события (уже нормализованная, без перевода строки и \r).
//  Состояние - Структура - контейнер состояния разбора (изменяется по ссылке):
//      * ТекущиеДанные - Строка - накопленный блок данных поля data.
//      * ТипСобытия - Строка - последнее значение поля event (для диагностики).
//      * ИдСобытия - Строка - последнее значение поля id (для диагностики).
//  Результат - Массив - массив, в который добавляются разобранные значения/чанки.
//  ОбработчикЧанка - ОписаниеОповещения,Неопределено - колбэк выдачи чанка (поток);
//    при Неопределено чанки только накапливаются в Результат.
//  ДобавлятьМаркерЗавершения - Булево - Истина: для строки [DONE] в Результат
//    добавляется чанк {"_done":Истина} и вызывается колбэк с признаком Закончен;
//    Ложь: строки [DONE] игнорируются.
Процедура ОбработатьСтрокуSSE(СтрокаSSE, Состояние, Результат, ОбработчикЧанка, ДобавлятьМаркерЗавершения)
	Если ПустаяСтрока(СтрокаSSE) Тогда
		Если НЕ ПустаяСтрока(Состояние.ТекущиеДанные) Тогда
			РазобратьSSEData(Состояние.ТекущиеДанные, Результат, ОбработчикЧанка);
			Состояние.ТекущиеДанные = "";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СтрНачинаетсяС(СтрокаSSE, ПрефиксDataSSE()) Тогда
		Данные = СокрЛП(Сред(СтрокаSSE, 6));
		Если Данные = МаркерЗавершенияSSE() Тогда
			Если ДобавлятьМаркерЗавершения Тогда
				Чанк = Новый Структура;
				Чанк.Вставить(КлючМаркераЗавершения(), Истина);
				Результат.Добавить(Чанк);
				Если ОбработчикЧанка <> Неопределено Тогда
					ДопПараметры = Новый Структура;
					ДопПараметры.Вставить(КлючМаркераЗавершения(), Истина);
					ДопПараметры.Вставить("Закончен", Истина);
					ОбработчикЧанка.Выполнить(Чанк, ДопПараметры);
				КонецЕсли;
			КонецЕсли;
			Состояние.ТекущиеДанные = "";
			Возврат;
		КонецЕсли;
		Если ПустаяСтрока(Состояние.ТекущиеДанные) Тогда
			Состояние.ТекущиеДанные = Данные;
		Иначе
			Состояние.ТекущиеДанные = Состояние.ТекущиеДанные + Символы.ПС + Данные;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если СтрНачинаетсяС(СтрокаSSE, "event:") Тогда
		Состояние.ТипСобытия = СокрЛП(Сред(СтрокаSSE, 7));
		Возврат;
	КонецЕсли;
	
	Если СтрНачинаетсяС(СтрокаSSE, "id:") Тогда
		Состояние.ИдСобытия = СокрЛП(Сред(СтрокаSSE, 4));
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Разбор одной порции data-строки SSE и парсинг JSON.
//
// Параметры:
//  Данные - Строка - накопленный блок данных поля data (может быть многострочным).
//  Результат - Массив - массив, в который добавляется разобранный чанк.
//  ОбработчикЧанка - ОписаниеОповещения,Неопределено - колбэк выдачи чанка;
//    при Неопределено чанк только добавляется в Результат.
Процедура РазобратьSSEData(Данные, Результат, ОбработчикЧанка)
	Попытка
		Чанк = ПрочитатьСтрокуJSON(Данные);
		Если Чанк <> Неопределено Тогда
			Результат.Добавить(Чанк);
			Если ОбработчикЧанка <> Неопределено Тогда
				ОбработчикЧанка.Выполнить(Чанк, Неопределено);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РаботаСJSON.РазобратьSSEData", УровеньЖурналаРегистрации.Ошибка,
			,, "Некорректный JSON-чанк: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Ручной рекурсивный парсер JSON.
// Не использует платформенный ЧтениеJSON, вместо этого парсит строку посимвольно.
// Работает на любой платформе 8.3+.
//
// Параметры:
//  Текст - Строка - исходная JSON-строка.
//  Поз - Число - текущая позиция в строке (изменяется по ссылке).
//  Глубина - Число - текущая глубина рекурсии (защита от переполнения стека, C5).
//
// Возвращаемое значение:
//  Произвольный - распарсенное значение.
Функция РучнойПарсерJSON(Текст, Поз, Глубина = 0)
	Если Глубина > МаксимальнаяГлубинаРекурсии() Тогда
		ВызватьИсключение "Превышена максимальная глубина вложенности JSON ("
			+ Строка(МаксимальнаяГлубинаРекурсии()) + ")";
	КонецЕсли;
	
	Поз = ПропуститьПробелы(Текст, Поз);
	Если Поз > СтрДлина(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Символ = Сред(Текст, Поз, 1);
	
	Если Символ = "{" Тогда
		Поз = Поз + 1;
		Результат = Новый Соответствие;
		Поз = ПропуститьПробелы(Текст, Поз);
		Если Поз <= СтрДлина(Текст) И Сред(Текст, Поз, 1) = "}" Тогда
			Поз = Поз + 1;
			Возврат Результат;
		КонецЕсли;
		Пока Истина Цикл
			Поз = ПропуститьПробелы(Текст, Поз);
			Если Поз > СтрДлина(Текст) Тогда Прервать; КонецЕсли;
			Если Сред(Текст, Поз, 1) = "}" Тогда
				Поз = Поз + 1;
				Прервать;
			КонецЕсли;
			
			Ключ = РучнойПарсерСтрока(Текст, Поз);
			Поз = ПропуститьПробелы(Текст, Поз);
			Если Поз <= СтрДлина(Текст) И Сред(Текст, Поз, 1) = ":" Тогда
				Поз = Поз + 1;
			КонецЕсли;
			Значение = РучнойПарсерJSON(Текст, Поз, Глубина + 1);
			Если Ключ <> Неопределено Тогда
				Результат.Вставить(Ключ, Значение);
			КонецЕсли;
			
			Поз = ПропуститьПробелы(Текст, Поз);
			Если Поз <= СтрДлина(Текст) И Сред(Текст, Поз, 1) = "," Тогда
				Поз = Поз + 1;
			Иначе
				Если Поз <= СтрДлина(Текст) И Сред(Текст, Поз, 1) = "}" Тогда
					Поз = Поз + 1;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
		
	ИначеЕсли Символ = "[" Тогда
		Поз = Поз + 1;
		Результат = Новый Массив;
		Поз = ПропуститьПробелы(Текст, Поз);
		Если Поз <= СтрДлина(Текст) И Сред(Текст, Поз, 1) = "]" Тогда
			Поз = Поз + 1;
			Возврат Результат;
		КонецЕсли;
		Пока Истина Цикл
			Элемент = РучнойПарсерJSON(Текст, Поз, Глубина + 1);
			Результат.Добавить(Элемент);
			Поз = ПропуститьПробелы(Текст, Поз);
			Если Поз <= СтрДлина(Текст) И Сред(Текст, Поз, 1) = "," Тогда
				Поз = Поз + 1;
			Иначе
				Если Поз <= СтрДлина(Текст) И Сред(Текст, Поз, 1) = "]" Тогда
					Поз = Поз + 1;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
		
	ИначеЕсли Символ = """" Тогда
		Возврат РучнойПарсерСтрока(Текст, Поз);
		
	ИначеЕсли (Символ >= "0" И Символ <= "9") ИЛИ Символ = "-" Тогда
		Старт = Поз;
		Если Символ = "-" Тогда
			Поз = Поз + 1;
		КонецЕсли;
		Пока Поз <= СтрДлина(Текст) Цикл
			Сим = Сред(Текст, Поз, 1);
			Если (Сим >= "0" И Сим <= "9") ИЛИ Сим = "." ИЛИ Сим = "e" ИЛИ Сим = "E" ИЛИ Сим = "+" ИЛИ Сим = "-" Тогда
				Поз = Поз + 1;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат Число(Сред(Текст, Старт, Поз - Старт));
		
	ИначеЕсли Символ = "t" ИЛИ Символ = "T" Тогда
		Если Сред(Текст, Поз, 4) = "true" ИЛИ Сред(Текст, Поз, 4) = "True" ИЛИ Сред(Текст, Поз, 4) = "TRUE" Тогда
			Поз = Поз + 4;
			Возврат Истина;
		КонецЕсли;
		ВызватьИсключение "Некорректный литерал 'true' на позиции " + Строка(Поз);
		
	ИначеЕсли Символ = "f" ИЛИ Символ = "F" Тогда
		Если Сред(Текст, Поз, 5) = "false" ИЛИ Сред(Текст, Поз, 5) = "False" ИЛИ Сред(Текст, Поз, 5) = "FALSE" Тогда
			Поз = Поз + 5;
			Возврат Ложь;
		КонецЕсли;
		ВызватьИсключение "Некорректный литерал 'false' на позиции " + Строка(Поз);
		
	ИначеЕсли Символ = "n" ИЛИ Символ = "N" Тогда
		Если Сред(Текст, Поз, 4) = "null" ИЛИ Сред(Текст, Поз, 4) = "Null" ИЛИ Сред(Текст, Поз, 4) = "NULL" Тогда
			Поз = Поз + 4;
			Возврат Неопределено;
		КонецЕсли;
		ВызватьИсключение "Некорректный литерал 'null' на позиции " + Строка(Поз);
		
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

// Парсинг JSON-строки (с кавычками). Позиция передаётся по ссылке.
// Декодирует стандартные escape-последовательности, включая \uXXXX (M7).
//
// Параметры:
//  Текст - Строка - исходная JSON-строка.
//  Поз - Число - текущая позиция (указывает на открывающую кавычку; изменяется по ссылке).
//
// Возвращаемое значение:
//  Строка - распарсенное строковое значение.
Функция РучнойПарсерСтрока(Текст, Поз)
	Если Поз > СтрДлина(Текст) ИЛИ Сред(Текст, Поз, 1) <> """" Тогда
		Возврат "";
	КонецЕсли;
	Поз = Поз + 1;
	Результат = "";
	Пока Поз <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Поз, 1);
		Если Символ = "\" Тогда
			Поз = Поз + 1;
			Если Поз > СтрДлина(Текст) Тогда Прервать; КонецЕсли;
			След = Сред(Текст, Поз, 1);
			Если След = """" Тогда
				Результат = Результат + """";
			ИначеЕсли След = "\" Тогда
				Результат = Результат + "\";
			ИначеЕсли След = "/" Тогда
				Результат = Результат + "/";
			ИначеЕсли След = "n" Тогда
				Результат = Результат + Символы.ПС;
			ИначеЕсли След = "r" Тогда
				Результат = Результат + Символы.ВК;
			ИначеЕсли След = "t" Тогда
				Результат = Результат + Символы.Таб;
			ИначеЕсли След = "b" Тогда
				Результат = Результат + Символы.ВК;
			ИначеЕсли След = "f" Тогда
				Результат = Результат + Символ(12);
			ИначеЕсли След = "u" Тогда
				Код = ПрочитатьUnicodeEscape(Текст, Поз + 1);
				Если Код < 0 Тогда
					ВызватьИсключение "Некорректный Unicode escape в JSON на позиции " + Строка(Поз);
				КонецЕсли;
				Если Код >= 55296 И Код <= 56319 Тогда
					Если Поз + 6 <= СтрДлина(Текст)
						И Сред(Текст, Поз + 5, 1) = "\"
						И Сред(Текст, Поз + 6, 1) = "u" Тогда
						Младший = ПрочитатьUnicodeEscape(Текст, Поз + 7);
						Если Младший >= 56320 И Младший <= 57343 Тогда
							КодСимвола = 65536 + (Код - 55296) * 1024 + (Младший - 56320);
							Старший = 55296 + Цел((КодСимвола - 65536) / 1024);
							МладшийСуррогат = 56320 + ((КодСимвола - 65536) % 1024);
							Результат = Результат + Символ(Старший) + Символ(МладшийСуррогат);
							Поз = Поз + 10;
						Иначе
							ВызватьИсключение "Некорректная суррогатная пара в JSON на позиции " + Строка(Поз);
						КонецЕсли;
					Иначе
						ВызватьИсключение "Одинокий старший суррогат в JSON на позиции " + Строка(Поз);
					КонецЕсли;
				ИначеЕсли Код >= 56320 И Код <= 57343 Тогда
					ВызватьИсключение "Одинокий младший суррогат в JSON на позиции " + Строка(Поз);
				Иначе
					Поз = Поз + 4;
					Результат = Результат + Символ(Код);
				КонецЕсли;
			Иначе
				Результат = Результат + След;
			КонецЕсли;
			Поз = Поз + 1;
		ИначеЕсли Символ = """" Тогда
			Поз = Поз + 1;
			Прервать;
		Иначе
			Результат = Результат + Символ;
			Поз = Поз + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Чтение Unicode escape-последовательности \uXXXX.
//
// Параметры:
//  Текст - Строка - исходная JSON-строка.
//  ПозПервойHex - Число - позиция первой шестнадцатеричной цифры (после "u").
//
// Возвращаемое значение:
//  Число - код символа (0..65535); -1 при некорректной последовательности.
Функция ПрочитатьUnicodeEscape(Текст, ПозПервойHex)
	Если ПозПервойHex + 3 > СтрДлина(Текст) Тогда
		Возврат -1;
	КонецЕсли;
	Код = 0;
	Для Инд = 0 По 3 Цикл
		Цифра = Сред(Текст, ПозПервойHex + Инд, 1);
		ЗначениеЦифры = ШестнадцатеричныйСимволВЧисло(Цифра);
		Если ЗначениеЦифры < 0 Тогда
			Возврат -1;
		КонецЕсли;
		Код = Код * 16 + ЗначениеЦифры;
	КонецЦикла;
	Возврат Код;
КонецФункции

// Преобразование шестнадцатеричной цифры в её числовое значение.
//
// Параметры:
//  Символ - Строка - один символ (0-9, a-f, A-F).
//
// Возвращаемое значение:
//  Число - значение цифры (0..15); -1 для нешестнадцатеричного символа.
Функция ШестнадцатеричныйСимволВЧисло(Символ)
	Если Символ >= "0" И Символ <= "9" Тогда
		Возврат Число(Символ);
	ИначеЕсли Символ >= "a" И Символ <= "f" Тогда
		Возврат КодСимвола(Символ) - КодСимвола("a") + 10;
	ИначеЕсли Символ >= "A" И Символ <= "F" Тогда
		Возврат КодСимвола(Символ) - КодСимвола("A") + 10;
	Иначе
		Возврат -1;
	КонецЕсли;
КонецФункции

// Пропуск пробельных символов (F6).
//
// Параметры:
//  Текст - Строка - исходная строка.
//  Поз - Число - текущая позиция.
//
// Возвращаемое значение:
//  Число - позиция первого непробельного символа (или СтрДлина(Текст) + 1).
Функция ПропуститьПробелы(Текст, Поз)
	Пока Поз <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Поз, 1);
		Если Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК ИЛИ Символ = Символы.ВТаб Тогда
			Поз = Поз + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Поз;
КонецФункции

// Рекурсивная запись произвольного значения в JSON.
//
// Параметры:
//  ЗаписьJSON - ЗаписьJSON - объект записи JSON.
//  Значение - Произвольный - значение для записи.
Процедура ЗаписатьЗначениеВJSON(ЗаписьJSON, Значение)
	Если Значение = Неопределено Тогда
		ЗаписьJSON.ЗаписатьЗначение(Неопределено);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Null") Тогда
		ЗаписьJSON.ЗаписатьЗначение(Неопределено);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		ЗаписьJSON.ЗаписатьЗначение(Значение);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		ЗаписьJSON.ЗаписатьЗначение(Значение);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		ЗаписьJSON.ЗаписатьЗначение(Значение);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		СмещениеСЛокальнымВременем = ТекущаяДата() - ТекущаяУниверсальнаяДата();
		ЗначениеUTC = Значение - СмещениеСЛокальнымВременем;
		ЗаписьJSON.ЗаписатьЗначение(Формат(ЗначениеUTC, "ДФ='yyyy-MM-dd'T'HH:mm:ss'") + "Z");
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Элемент Из Значение Цикл
			ЗаписатьЗначениеВJSON(ЗаписьJSON, Элемент);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого КлючЗначение Из Значение Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(КлючЗначение.Ключ);
			ЗаписатьЗначениеВJSON(ЗаписьJSON, КлючЗначение.Значение);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого КлючЗначение Из Значение Цикл
			Ключ = КлючЗначение.Ключ;
			Если ТипЗнч(Ключ) = Тип("Строка") Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства(Ключ);
				ЗаписатьЗначениеВJSON(ЗаписьJSON, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
		Попытка
			ЗаписьJSON.ЗаписатьЗначение(Строка(Значение.УникальныйИдентификатор()));
		Исключение
			ЗаписьЖурналаРегистрации("Агент1С.РаботаСJSON.СсылкаБезUUID", УровеньЖурналаРегистрации.Предупреждение,
				,, "Не удалось получить UUID ссылки, использовано строковое представление: "
				+ Строка(ТипЗнч(Значение)));
			ЗаписьJSON.ЗаписатьЗначение(Строка(Значение));
		КонецПопытки;
		
	Иначе
		Попытка
			СтроковоеПредставление = Строка(Значение);
		Исключение
			СтроковоеПредставление = "";
		КонецПопытки;
		ЗаписьЖурналаРегистрации("Агент1С.РаботаСJSON.НеподдерживаемыйТип", УровеньЖурналаРегистрации.Предупреждение,
			,, "Неподдерживаемый тип значения при сериализации JSON: " + Строка(ТипЗнч(Значение))
			+ " | Представление: " + Лев(СтроковоеПредставление, 200));
		ЗаписьJSON.ЗаписатьЗначение(СтроковоеПредставление);
		
	КонецЕсли;
КонецПроцедуры

// Рекурсивная конвертация значения в представление для Соответствия (F1).
// Тонкая обёртка над общим методом СконвертироватьЗначение.
//
// Параметры:
//  Значение - Произвольный - исходное значение.
//
// Возвращаемое значение:
//  Произвольный - значение с вложенными Структурами, преобразованными в Соответствие;
//    значение типа Соответствие возвращается как есть (глубокая конвертация не выполняется, F4).
Функция СконвертироватьЗначениеВСоответствие(Значение)
	Возврат СконвертироватьЗначение(Значение, Истина, 0);
КонецФункции

// Рекурсивная конвертация значения в представление для Структуры (F1).
// Тонкая обёртка над общим методом СконвертироватьЗначение.
//
// Параметры:
//  Значение - Произвольный - исходное значение.
//
// Возвращаемое значение:
//  Произвольный - значение с вложенными Соответствиями, преобразованными в Структуру;
//    ключи-не-строки внутри Соответствий пропускаются (см. СоответствиеВСтруктуру).
Функция СконвертироватьЗначениеВСтруктуру(Значение)
	Возврат СконвертироватьЗначение(Значение, Ложь, 0);
КонецФункции

// Рекурсивная конвертация значения в представление для Соответствия или Структуры (F1).
// Единая реализация для СконвертироватьЗначениеВСоответствие и СконвертироватьЗначениеВСтруктуру.
//
// Параметры:
//  Значение - Произвольный - исходное значение.
//  ВСоответствие - Булево - Истина: конвертировать вложенные Структуры в Соответствие;
//    Ложь: конвертировать вложенные Соответствия в Структуру.
//  Глубина - Число - текущая глубина рекурсии (защита от переполнения стека, C5).
//
// Возвращаемое значение:
//  Произвольный - сконвертированное значение.
Функция СконвертироватьЗначение(Значение, ВСоответствие, Глубина = 0)
	Если Глубина > МаксимальнаяГлубинаРекурсии() Тогда
		ВызватьИсключение "Превышена максимальная глубина вложенности при конвертации значения";
	КонецЕсли;
	
	Если ВСоответствие Тогда
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			Результат = Новый Соответствие;
			Для Каждого КлючЗначение Из Значение Цикл
				Результат.Вставить(КлючЗначение.Ключ,
					СконвертироватьЗначение(КлючЗначение.Значение, Истина, Глубина + 1));
			КонецЦикла;
			Возврат Результат;
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
			Результат = Новый Массив;
			Для Каждого Элемент Из Значение Цикл
				Результат.Добавить(СконвертироватьЗначение(Элемент, Истина, Глубина + 1));
			КонецЦикла;
			Возврат Результат;
		Иначе
			Возврат Значение;
		КонецЕсли;
	Иначе
		Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Результат = Новый Структура;
			Для Каждого КлючЗначение Из Значение Цикл
				Ключ = КлючЗначение.Ключ;
				Если ТипЗнч(Ключ) = Тип("Строка") Тогда
					Результат.Вставить(Ключ,
						СконвертироватьЗначение(КлючЗначение.Значение, Ложь, Глубина + 1));
				КонецЕсли;
			КонецЦикла;
			Возврат Результат;
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
			Результат = Новый Массив;
			Для Каждого Элемент Из Значение Цикл
				Результат.Добавить(СконвертироватьЗначение(Элемент, Ложь, Глубина + 1));
			КонецЦикла;
			Возврат Результат;
		Иначе
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
КонецФункции

