#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("СерверMCP", СерверMCP);
	
	ЗаполнитьТаблицуИнструментов();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьВыбранные(Команда)

	ВыбранныеИнструменты = Новый Массив;
	
	НСтроки = ТаблицаИнструментов.НайтиСтроки(Новый Структура("Выбран", Истина));
	
	Для Каждого СтрокаТЗ Из НСтроки Цикл
		
		Выбранный = Новый Структура;
		Выбранный.Вставить("Имя", СтрокаТЗ.Имя);
		Выбранный.Вставить("Описание", СтрокаТЗ.Описание);

		Выбранный.Вставить("СхемаПараметровJSON", СтрокаТЗ.СхемаПараметров);

		Выбранный.Вставить("АннотацииJSON", СтрокаТЗ.Аннотации);

		ВыбранныеИнструменты.Добавить(Выбранный);
		
	КонецЦикла;

	Если ВыбранныеИнструменты.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(, "Не выбрано ни одного инструмента");
		Возврат;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ВыбранныеИнструменты", ВыбранныеИнструменты);

	Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВыделенные(Команда)
	УстановитьСнятьФлажки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыборСВыделенных(Команда)
	УстановитьСнятьФлажки(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьСнятьФлажки(Флаг)
	
	ВыделенныеСтроки = Элементы.ТаблицаИнструментов.ВыделенныеСтроки;
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Элементы.ТаблицаИнструментов.ДанныеСтроки(Строка);
		ДанныеСтроки.Выбран = Флаг;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуИнструментов()
	
	ИнструментыСервера = СИ_УправлениеИнструментамиMCP.ПолучитьИнструментыСервера(СерверMCP);
	
	Если ИнструментыСервера = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ТаблицаИнструментов.Очистить();
	
	РанееВыбранныеИнструменты = ПолучитьРанееВыбранныеИнструменты();
	
	Для Каждого Инструмент Из ИнструментыСервера.Инструменты Цикл
		НоваяСтрока = ТаблицаИнструментов.Добавить();
		НоваяСтрока.Имя = ПолучитьЗначениеСвойства(Инструмент, "Имя", "");
		НоваяСтрока.Выбран = РанееВыбранныеИнструменты.Получить(НРег(НоваяСтрока.Имя)) <> Неопределено;
		НоваяСтрока.Описание = ПолучитьЗначениеСвойства(Инструмент, "Описание", "");

		СхемаПараметров = ПолучитьЗначениеСвойства(Инструмент, "СхемаПараметров", Новый Соответствие);
		НоваяСтрока.СхемаПараметров = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(СхемаПараметров);

		Аннотации = ПолучитьЗначениеСвойства(Инструмент, "Аннотации", Неопределено);
		НоваяСтрока.Аннотации = ?(Аннотации = Неопределено, "", СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Аннотации));
	КонецЦикла;
	
	ТаблицаИнструментов.Сортировать("Имя");

КонецПроцедуры

&НаСервере
Функция ПолучитьРанееВыбранныеИнструменты()
	
	Результат = Новый Соответствие;
	
	Если НЕ ЗначениеЗаполнено(СерверMCP) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СИ_MCPСерверыИнструменты.ИмяИнструмента КАК ИмяИнструмента
		|ИЗ
		|	Справочник.СИ_MCPСерверы.Инструменты КАК СИ_MCPСерверыИнструменты
		|ГДЕ
		|	СИ_MCPСерверыИнструменты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СерверMCP);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(НРег(Выборка.ИмяИнструмента), Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Чтение свойства структуры/соответствия безопасным способом.
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЗначениеСвойства(Контейнер, Ключ, ПоУмолчанию)
	Если Контейнер = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Контейнер) = Тип("Структура") И Контейнер.Свойство(Ключ) Тогда
		Возврат Контейнер[Ключ];
	ИначеЕсли ТипЗнч(Контейнер) = Тип("Соответствие") Тогда
		Значение = Контейнер.Получить(Ключ);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти
