&НаКлиенте
Процедура ПрофильПодключенияПриИзменении(Элемент)

	ЗагрузитьДанныеПрофиля();

КонецПроцедуры

&НаКлиенте
Процедура ТипАвторизацииПриИзменении(Элемент)

	УстановитьВидимостьИмениЗаголовка();

КонецПроцедуры

&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)

	СоздатьНовыйРежим = Ложь;
	ЗагрузитьДанныеРежима();
	ОбновитьСписокВыбораМоделей();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйРежимПриИзменении(Элемент)

	Если СоздатьНовыйРежим Тогда
		РежимРаботы = Неопределено;
		Если НЕ ЗначениеЗаполнено(ИмяРежима) Тогда
			ИмяРежима = НСтр("ru='Основной режим'");
		КонецЕсли;
		Если ПустаяСтрока(СистемныйПромпт) Тогда
			СистемныйПромпт = СистемныйПромптПоУмолчаниюНаСервере();
		КонецЕсли;
	КонецЕсли;

	ОбновитьСписокВыбораМоделей();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Далее(Команда)

	ПереходДалее(Элементы.Страницы.ТекущаяСтраница);

КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)

	ПереходНазад(Элементы.Страницы.ТекущаяСтраница);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйПрофиль(Команда)

	Если СоздатьНовыйПрофильНаСервере() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Поля заполнены значениями по умолчанию для нового профиля. Заполните Базовый URL и Ключ API - профиль будет записан при нажатии «Проверить подключение» или «Далее».'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	Результат = ПроверитьПодключениеНаСервере();

	Если Результат.Доступен Тогда
		ТекстРезультата = НСтр("ru='Подключение доступно. Endpoint отвечает.'");
		Если Результат.СписокМоделей.Количество() > 0 Тогда
			ТекстРезультата = ТекстРезультата + Символы.ПС
				+ СтрШаблон(НСтр("ru='Провайдер вернул список моделей (%1 шт.). Кнопка «Заполнить из API» заполнит таблицу моделей этим списком.'"),
					Формат(Результат.СписокМоделей.Количество(), "ЧГ=0"));
		КонецЕсли;
	Иначе
		ТекстРезультата = НСтр("ru='Подключение недоступно:'") + Символы.ПС + Результат.Ошибка;
	КонецЕсли;

	Элементы.ДекорацияРезультатПроверки.Заголовок = ТекстРезультата;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМоделиИзAPI(Команда)

	Результат = ПроверитьПодключениеНаСервере();

	Если НЕ Результат.Доступен Тогда
		Элементы.ДекорацияРезультатПроверки.Заголовок = НСтр("ru='Подключение недоступно - модели не получены:'")
			+ Символы.ПС + Результат.Ошибка;
		Возврат;
	КонецЕсли;

	Если Результат.СписокМоделей.Количество() = 0 Тогда
		Элементы.ДекорацияРезультатПроверки.Заголовок = НСтр("ru='Endpoint доступен, но провайдер не вернул список моделей.'");
		Возврат;
	КонецЕсли;

	ТаблицаМоделей.Очистить();
	ЗаполненоКонтекстов = 0;
	ЗаполненоМаксимумов = 0;

	Если Результат.ДанныеМоделей.Количество() > 0 Тогда
		// Провайдер сообщил расширенные данные моделей (OpenRouter-совместимый API).
		Для Каждого ДанныеМодели Из Результат.ДанныеМоделей Цикл
			НоваяСтрока = ТаблицаМоделей.Добавить();
			НоваяСтрока.ИмяМодели = ДанныеМодели.ИмяМодели;
			Если ДанныеМодели.КонтекстноеОкно > 0 Тогда
				НоваяСтрока.КонтекстноеОкно = ДанныеМодели.КонтекстноеОкно;
				ЗаполненоКонтекстов = ЗаполненоКонтекстов + 1;
			Иначе
				// Контекстное окно не сообщается - консервативное значение по умолчанию.
				НоваяСтрока.КонтекстноеОкно = 128000;
			КонецЕсли;
			Если ДанныеМодели.МаксимумТокеновОтвета > 0 Тогда
				НоваяСтрока.МаксимумТокеновОтвета = ДанныеМодели.МаксимумТокеновОтвета;
				ЗаполненоМаксимумов = ЗаполненоМаксимумов + 1;
			КонецЕсли;
			НоваяСтрока.ПоддержкаИзображений = ДанныеМодели.ПоддержкаИзображений;
		КонецЦикла;
	Иначе
		Для Каждого ИмяМодели Из Результат.СписокМоделей Цикл
			НоваяСтрока = ТаблицаМоделей.Добавить();
			НоваяСтрока.ИмяМодели = ИмяМодели;
			// Контекстное окно провайдер не сообщает - консервативное значение,
			// при необходимости уточните его вручную.
			НоваяСтрока.КонтекстноеОкно = 128000;
		КонецЦикла;
	КонецЕсли;

	// Первая модель помечается «по умолчанию», чтобы шаг можно было пройти
	// без ручной правки; пользователь при необходимости переключит флажок.
	Если ТаблицаМоделей.Количество() > 0 Тогда
		ТаблицаМоделей[0].ИспользоватьПоУмолчанию = Истина;
	КонецЕсли;

	Если ЗаполненоКонтекстов > 0 ИЛИ ЗаполненоМаксимумов > 0 Тогда
		Элементы.ДекорацияРезультатПроверки.Заголовок = СтрШаблон(
			НСтр("ru='Таблица моделей заполнена (%1 шт.). От провайдера получено: контекстное окно - для %2 моделей, максимум токенов ответа - для %3 моделей; поддержка изображений - по данным архитектуры моделей. Для моделей без данных окно установлено 128 000 - проверьте по документации.'"),
			Формат(ТаблицаМоделей.Количество(), "ЧГ=0"),
			Формат(ЗаполненоКонтекстов, "ЧГ=0"),
			Формат(ЗаполненоМаксимумов, "ЧГ=0"));
	Иначе
		Элементы.ДекорацияРезультатПроверки.Заголовок = СтрШаблон(
			НСтр("ru='Таблица моделей заполнена (%1 шт.). Провайдер не сообщает контекстное окно - установлено 128 000; поддержка изображений не определена. Уточните по документации провайдера.'"),
			Формат(ТаблицаМоделей.Количество(), "ЧГ=0"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьИнструментыПоУмолчанию(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗарегистрироватьИнструментыПоУмолчаниюЗавершение", ЭтотОбъект);

	ТекстВопроса = НСтр("ru='Будут зарегистрированы инструменты, поставляемые с расширением (уже зарегистрированные обновлены не будут, дубли не создаются; новые инструменты разрешаются сразу). Продолжить?'");

	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьИнструментыПоУмолчаниюЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ЗарегистрироватьИнструментыНаСервере();

	Если НЕ ПустаяСтрока(Результат.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не удалось зарегистрировать инструменты:'") + Символы.ПС
			+ Результат.ТекстОшибки, , НСтр("ru='Регистрация инструментов'"));
		Возврат;
	КонецЕсли;

	Если Результат.Зарегистрировано.Количество() > 0 Тогда
		Сообщение = НСтр("ru='Зарегистрированы инструменты: '") + СтрСоединить(Результат.Зарегистрировано, ", ");
	Иначе
		Сообщение = НСтр("ru='Новых инструментов не зарегистрировано - все инструменты по умолчанию уже существуют в реестре.'");
	КонецЕсли;

	Если НЕ ПустаяСтрока(Результат.Предупреждения) Тогда
		Сообщение = Сообщение + Символы.ПС + Результат.Предупреждения;
	КонецЕсли;

	Элементы.ТаблицаИнструментов.Обновить();

	ПоказатьПредупреждение(, Сообщение, , НСтр("ru='Регистрация инструментов'"));

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьMCPSервер(Команда)

	Оповещение = Новый ОписаниеОповещения("ДобавитьMCPSерверЗавершение", ЭтотОбъект);

	ОткрытьФорму("Справочник.СИ_MCPСерверы.Форма.ФормаЭлемента", , ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьMCPSерверЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Элементы.ТаблицаMCPSерверов.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ПромптПоУмолчанию(Команда)

	// Тот же текст, что и кнопка «Промпт по умолчанию» формы элемента СИ_РежимиРаботы.
	СистемныйПромпт = СистемныйПромптПоУмолчаниюНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработкаПереходов

&НаКлиенте
Процедура ПереходДалее(ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаПриветствие Тогда
		УстановитьСтраницуПрофиль();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаПрофиль Тогда
		Если НЕ ПроверитьШагПрофиль() Тогда
			Возврат;
		КонецЕсли;
		Если НЕ ЗаписатьПрофильНаСервере() Тогда
			Возврат;
		КонецЕсли;
		УстановитьСтраницуРежим();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРежим Тогда
		Если НЕ ПроверитьШагРежим() Тогда
			Возврат;
		КонецЕсли;
		ЗаписанныйРежим = ЗаписатьРежимНаСервере();
		Если НЕ ЗначениеЗаполнено(ЗаписанныйРежим) Тогда
			Возврат;
		КонецЕсли;
		АктивныйРежим = ЗаписанныйРежим;
		// Повторный проход шага редактирует записанный режим, а не создаёт дубликат.
		РежимРаботы = ЗаписанныйРежим;
		СоздатьНовыйРежим = Ложь;
		УстановитьСтраницуИнструменты();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаИнструменты Тогда
		УстановитьСтраницуMCP();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаMCP Тогда
		Элементы.ДекорацияИтоговаяСводка.Заголовок = ТекстИтоговойСводки();
		УстановитьСтраницуЗавершение();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаЗавершение Тогда
		ЗавершитьМастер();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПереходНазад(ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаПрофиль Тогда
		УстановитьСтраницуПриветствие();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРежим Тогда
		УстановитьСтраницуПрофиль();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаИнструменты Тогда
		УстановитьСтраницуРежим();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаMCP Тогда
		УстановитьСтраницуИнструменты();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаЗавершение Тогда
		УстановитьСтраницуMCP();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуПриветствие()

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПриветствие;
	Элементы.КнопкаНазад.Видимость = Ложь;
	Элементы.КнопкаДалее.Заголовок = НСтр("ru='Далее'");
	ЭтаФорма.Заголовок = НСтр("ru='Мастер настройки агента ИИ - шаг 1 из 6'");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуПрофиль()

	// Если профиль ещё не выбран - подставляем первый существующий
	// или создаём профиль с настройками по умолчанию (когда профилей нет).
	ПодготовитьШагПрофильНаСервере();

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПрофиль;
	Элементы.КнопкаНазад.Видимость = Истина;
	Элементы.КнопкаДалее.Заголовок = НСтр("ru='Далее'");
	ЭтаФорма.Заголовок = НСтр("ru='Мастер настройки агента ИИ - шаг 2 из 6'");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуРежим()

	// Если режим ещё не выбран - предлагаем текущий активный режим как основу.
	ПодготовитьШагРежимНаСервере();

	ОбновитьСписокВыбораМоделей();

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаРежим;
	Элементы.КнопкаНазад.Видимость = Истина;
	Элементы.КнопкаДалее.Заголовок = НСтр("ru='Далее'");
	ЭтаФорма.Заголовок = НСтр("ru='Мастер настройки агента ИИ - шаг 3 из 6'");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуИнструменты()

	// Если инструменты ещё не зарегистрированы - регистрируем инструменты по умолчанию.
	ПодготовитьШагИнструментыНаСервере();

	Элементы.ТаблицаИнструментов.Обновить();

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаИнструменты;
	Элементы.КнопкаНазад.Видимость = Истина;
	Элементы.КнопкаДалее.Заголовок = НСтр("ru='Далее'");
	ЭтаФорма.Заголовок = НСтр("ru='Мастер настройки агента ИИ - шаг 4 из 6'");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуMCP()

	Элементы.ТаблицаMCPSерверов.Обновить();

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаMCP;
	Элементы.КнопкаНазад.Видимость = Истина;
	Элементы.КнопкаДалее.Заголовок = НСтр("ru='Далее'");
	ЭтаФорма.Заголовок = НСтр("ru='Мастер настройки агента ИИ - шаг 5 из 6'");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуЗавершение()

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗавершение;
	Элементы.КнопкаНазад.Видимость = Истина;
	Элементы.КнопкаДалее.Заголовок = НСтр("ru='Готово'");
	ЭтаФорма.Заголовок = НСтр("ru='Мастер настройки агента ИИ - шаг 6 из 6'");

КонецПроцедуры

&НаСервере
Функция ПроверитьШагПрофиль()

	Если НЕ ЗначениеЗаполнено(ПрофильПодключения) И НЕ НовыйПрофильНеЗаписан Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Выберите профиль подключения или создайте новый.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(БазовыйURL) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Заполните Базовый URL (например, https://api.openai.com/v1).'"));
		Возврат Ложь;
	КонецЕсли;

	Если ТипАвторизации <> Перечисления.СИ_ТипыАвторизации.Нет И ПустаяСтрока(КлючAPI) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Заполните Ключ API: без него провайдер ответит ошибкой авторизации (401).'"));
		Возврат Ложь;
	КонецЕсли;

	Если ТаблицаМоделей.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Добавьте в таблицу хотя бы одну модель. Кнопка «Заполнить из API» заполнит таблицу моделями провайдера.'"));
		Возврат Ложь;
	КонецЕсли;

	ЕстьМодельПоУмолчанию = Ложь;
	Для Каждого СтрокаТаблицы Из ТаблицаМоделей Цикл
		Если ПустаяСтрока(СтрокаТаблицы.ИмяМодели) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='В таблице моделей есть строка с пустым именем модели.'"));
			Возврат Ложь;
		КонецЕсли;
		Если СтрокаТаблицы.ИспользоватьПоУмолчанию Тогда
			ЕстьМодельПоУмолчанию = Истина;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьМодельПоУмолчанию Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Отметьте флажком «Использовать по умолчанию» хотя бы одну модель в таблице - она будет использоваться, если у режима не задана модель.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция ПроверитьШагРежим()

	Если НЕ СоздатьНовыйРежим И НЕ ЗначениеЗаполнено(РежимРаботы) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Выберите существующий режим работы или установите флажок «Создать новый режим».'"));
		Возврат Ложь;
	КонецЕсли;

	Если СоздатьНовыйРежим И ПустаяСтрока(ИмяРежима) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Заполните наименование нового режима.'"));
		Возврат Ложь;
	КонецЕсли;

	Если СоздатьНовыйРежим И ПустаяСтрока(СистемныйПромпт) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Заполните системный промпт нового режима.'"));
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(МодельРежима) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Выберите модель режима из списка моделей профиля.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

