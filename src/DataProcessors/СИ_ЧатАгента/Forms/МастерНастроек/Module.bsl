Процедура ПодготовитьШагПрофильНаСервере()

	// Профиль уже выбран или данные нового (ещё не записанного) профиля уже в полях.
	Если ЗначениеЗаполнено(ПрофильПодключения) ИЛИ НовыйПрофильНеЗаписан Тогда
		Возврат;
	КонецЕсли;

	// Если в базе нет ни одного профиля - создаём профиль с настройками
	// по умолчанию, чтобы пользователю не пришлось нажимать кнопку отдельно.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Профили.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СИ_ПрофилиПодключений КАК Профили
	|ГДЕ
	|	НЕ Профили.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Профили.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПрофильПодключения = Выборка.Ссылка;
		ЗагрузитьДанныеПрофиля();
	Иначе
		СоздатьНовыйПрофильНаСервере();
	КонецЕсли;

