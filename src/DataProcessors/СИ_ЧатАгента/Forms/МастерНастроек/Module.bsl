	КонецЕсли;

	ДанныеРежима = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РежимРаботы,
		"Наименование, СистемныйПромпт, Модель, Температура");

	ИмяРежима = ДанныеРежима.Наименование;
	СистемныйПромпт = ДанныеРежима.СистемныйПромпт;
	МодельРежима = ДанныеРежима.Модель;
	Температура = ДанныеРежима.Температура;

КонецПроцедуры

// Готовит данные нового профиля без записи в базу: значения держатся
// в реквизитах формы, объект создаётся и записывается при первом
// сохранении (ЗаписатьПрофильНаСервере). Если пользователь закроет
// мастер до записи - в справочнике не останется пустого элемента.
//
// Возвращаемое значение:
//  Булево - всегда Истина (для совместимости с обработчиком команды).
&НаСервере
Функция СоздатьНовыйПрофильНаСервере()

	ПрофильПодключения = Неопределено;
	НовыйПрофильНеЗаписан = Истина;

	Если НЕ ЗначениеЗаполнено(НаименованиеПрофиля) Тогда
		НаименованиеПрофиля = НСтр("ru='Новый профиль'");
	КонецЕсли;
	ТипАвторизации = Перечисления.СИ_ТипыАвторизации.Bearer;
	ИмяЗаголовкаАвторизации = "Authorization";
	ПроверятьSSL = Истина;
	Таймаут = 60;
	// Рассуждения (reasoning) разрешены по умолчанию.
	РазрешитьРассуждения = Истина;
	УстановитьВидимостьИмениЗаголовка();

	ТаблицаМоделей.Очистить();
	Элементы.ДекорацияРезультатПроверки.Заголовок = " ";

	Возврат Истина;

КонецФункции

// Сохраняет профиль подключения из реквизитов формы и таблицы моделей.
//
// Возвращаемое значение:
//  Булево - Истина, если профиль записан.
&НаСервере
Функция ЗаписатьПрофильНаСервере()

	Если НовыйПрофильНеЗаписан И НЕ ЗначениеЗаполнено(ПрофильПодключения) Тогда
		// Профиль ещё не записан - создаём объект при первом сохранении.
		ПрофильОбъект = Справочники.СИ_ПрофилиПодключений.СоздатьЭлемент();
	Иначе
		Если НЕ ЗначениеЗаполнено(ПрофильПодключения) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Выберите профиль подключения или создайте новый.'"));
			Возврат Ложь;
		КонецЕсли;
		ПрофильОбъект = ПрофильПодключения.ПолучитьОбъект();
		Если ПрофильОбъект = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Профиль подключения не найден.'"));
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Попытка
		ПрофильОбъект.Наименование = НаименованиеПрофиля;
		ПрофильОбъект.БазовыйURL = СокрЛП(БазовыйURL);
		ПрофильОбъект.КлючAPI = СокрЛП(КлючAPI);
		ПрофильОбъект.ТипАвторизации = ТипАвторизации;
		ПрофильОбъект.ИмяЗаголовкаАвторизации = ИмяЗаголовкаАвторизации;
		ПрофильОбъект.ПроверятьSSL = ПроверятьSSL;
		ПрофильОбъект.Таймаут = Макс(0, Таймаут);
		ПрофильОбъект.РазрешитьРассуждения = РазрешитьРассуждения;

		ПрофильОбъект.Модели.Очистить();
		Для Каждого СтрокаТаблицы Из ТаблицаМоделей Цикл
			Если ПустаяСтрока(СтрокаТаблицы.ИмяМодели) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ПрофильОбъект.Модели.Добавить();
			НоваяСтрока.ИмяМодели = СокрЛП(СтрокаТаблицы.ИмяМодели);
			НоваяСтрока.КонтекстноеОкно = СтрокаТаблицы.КонтекстноеОкно;
			НоваяСтрока.МаксимумТокеновОтвета = СтрокаТаблицы.МаксимумТокеновОтвета;
			НоваяСтрока.ПоддержкаИзображений = СтрокаТаблицы.ПоддержкаИзображений;
			НоваяСтрока.ИспользоватьПоУмолчанию = СтрокаТаблицы.ИспользоватьПоУмолчанию;
		КонецЦикла;

		ПрофильОбъект.Записать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не удалось записать профиль подключения:'")
			+ Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	НовыйПрофильНеЗаписан = Ложь;
	ПрофильПодключения = ПрофильОбъект.Ссылка;

	Возврат Истина;

КонецФункции

// Записывает профиль и проверяет доступность endpoint через API провайдера.
//
// Возвращаемое значение:
//  Структура - Доступен, Ошибка, СписокМоделей (см. СИ_НастройкиАгента.ПроверитьДоступностьEndpoint).
&НаСервере
Функция ПроверитьПодключениеНаСервере()

	Если НЕ ЗаписатьПрофильНаСервере() Тогда
		Результат = Новый Структура;
		Результат.Вставить("Доступен", Ложь);
		Результат.Вставить("Ошибка", НСтр("ru='Профиль подключения не записан.'"));
		Результат.Вставить("СписокМоделей", Новый Массив);
		Результат.Вставить("ДанныеМоделей", Новый Массив);
		Возврат Результат;
	КонецЕсли;

	РезультатПроверки = СИ_НастройкиАгента.ПроверитьДоступностьEndpoint(ПрофильПодключения);

	Результат = Новый Структура;
	Результат.Вставить("Доступен", РезультатПроверки.Доступен);
	Результат.Вставить("Ошибка", ?(РезультатПроверки.Ошибка = Неопределено, "", РезультатПроверки.Ошибка));
	Результат.Вставить("СписокМоделей", ?(РезультатПроверки.СписокМоделей = Неопределено, Новый Массив,
		РезультатПроверки.СписокМоделей));
	Результат.Вставить("ДанныеМоделей", ?(РезультатПроверки.ДанныеМоделей = Неопределено, Новый Массив,
		РезультатПроверки.ДанныеМоделей));

	Возврат Результат;

КонецФункции

// Создаёт или обновляет режим работы по данным мастера.
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_РежимиРаботы,Неопределено - ссылка записанного режима.
&НаСервере
Функция ЗаписатьРежимНаСервере()

	Если СоздатьНовыйРежим Тогда
		РежимОбъект = Справочники.СИ_РежимиРаботы.СоздатьЭлемент();
		РежимОбъект.ТипРежима = Перечисления.СИ_РежимыРаботыАгента.ToolCalling;
		РежимОбъект.ИспользоватьВСпискеЧатов = Истина;
	Иначе
		РежимОбъект = РежимРаботы.ПолучитьОбъект();
		Если РежимОбъект = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Выбранный режим работы не найден.'"));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Попытка
		РежимОбъект.Наименование = ИмяРежима;
		РежимОбъект.СистемныйПромпт = СистемныйПромпт;
		РежимОбъект.Профиль = ПрофильПодключения;
		РежимОбъект.Модель = СокрЛП(МодельРежима);
		РежимОбъект.Температура = Температура;
		РежимОбъект.Записать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не удалось записать режим работы:'")
			+ Символы.ПС + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат РежимОбъект.Ссылка;

КонецФункции

// Записывает константы настроек в одной транзакции (последовательная запись
// без транзакции при сбое оставила бы настройки частично применёнными).
//
// Возвращаемое значение:
//  Булево - Истина, если настройки записаны.
&НаСервере
Функция ЗаписатьКонстантыНаСервере()

	Если НЕ УправлениеДоступом.ЕстьРоль("СИ_АдминистрированиеЧатАгента") Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Недостаточно прав для записи настроек. Требуется роль «СИ_АдминистрированиеЧатАгента».'"));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		НачатьТранзакцию();
		Попытка
			Константы.СИ_АктивныйРежим.Установить(АктивныйРежим);
			Константы.СИ_ЛимитТокеновНаОтвет.Установить(Макс(0, ЛимитТокеновНаОтвет));
			Константы.СИ_ЗаголовокЧерезИИ.Установить(ЗаголовокЧерезИИ);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не удалось записать настройки:'")
			+ Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Регистрирует инструменты по умолчанию напрямую в модулях инструментов.
//
// Возвращаемое значение:
//  Структура - Зарегистрировано (Массив из Строка), Предупреждения, ТекстОшибки.
&НаСервере
Функция ЗарегистрироватьИнструментыНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("Зарегистрировано", Новый Массив);
	Результат.Вставить("Предупреждения", "");
	Результат.Вставить("ТекстОшибки", "");

	Если НЕ УправлениеДоступом.ЕстьРоль("СИ_АдминистрированиеЧатАгента") Тогда
		Результат.ТекстОшибки = НСтр("ru='Недостаточно прав. Требуется роль «СИ_АдминистрированиеЧатАгента».'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Зарегистрированные = СИ_ФайлыДиалога.ЗарегистрироватьИнструменты();
		Для Каждого ИмяИнструмента Из Зарегистрированные Цикл
			Результат.Зарегистрировано.Добавить(ИмяИнструмента);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ИнструментыАгента.РегистрацияИнструментов", УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка регистрации инструментов файлов: " + ОписаниеОшибки());
		Результат.Предупреждения = "Ошибка регистрации инструментов файлов: " + ОписаниеОшибки();
	КонецПопытки;

	Попытка
		Зарегистрированные = СИ_Инструменты1С.ЗарегистрироватьИнструменты();
		Для Каждого ИмяИнструмента Из Зарегистрированные Цикл
			Результат.Зарегистрировано.Добавить(ИмяИнструмента);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ИнструментыАгента.РегистрацияИнструментов", УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка регистрации встроенных инструментов 1С: " + ОписаниеОшибки());
		Результат.Предупреждения = (?(ПустаяСтрока(Результат.Предупреждения), "",
			Результат.Предупреждения + Символы.ПС))
			+ "Ошибка регистрации встроенных инструментов 1С: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ТекстИтоговойСводки()

	Сводка = НСтр("ru='По итогам мастера будут записаны:'") + Символы.ПС
		+ "- Активный режим: " + ?(ЗначениеЗаполнено(АктивныйРежим), Строка(АктивныйРежим), НСтр("ru='НЕ выбран!'")) + Символы.ПС
		+ "- Профиль подключения: " + Строка(ПрофильПодключения)
		+ " (" + БазовыйURL + ")" + Символы.ПС
		+ "- Модель режима: " + МодельРежима + Символы.ПС
		+ СтрШаблон(НСтр("ru='- Разрешённых инструментов 1С: %1'"), Формат(КоличествоРазрешенныхИнструментов(), "ЧГ=0")) + Символы.ПС
		+ СтрШаблон(НСтр("ru='- Включённых MCP-серверов: %1'"), Формат(КоличествоВключенныхMCPSерверов(), "ЧГ=0")) + Символы.ПС
		+ НСтр("ru='Примечание: у активного режима профиль подключения будет заменён профилем, выбранным на шаге 2.'");

	Возврат Сводка;

КонецФункции

#КонецОбласти
