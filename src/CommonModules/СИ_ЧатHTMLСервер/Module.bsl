// Скрипты страницы, встроенные в документ истории чата.
//
// Назначение: инкрементальное дописывание сообщений. Форма обращается к этим
// функциям через JS-мост (Документ.defaultView / parentWindow) - документ при
// этом НЕ пересоздаётся, поэтому ранее отрисованные сообщения, картинки и
// позиция прокрутки сохраняются. Реквизит ТекстИстории на живом тике и при
// финализации захода не переприсваивается: полная перерисовка делается только
// на смене чата, сжатии, дозагрузке вверх и в аварийных ветках.
//
// Ограничения контракта:
//  - скрипт выполняется в движке документа (WebKit), внешние ресурсы не нужны;
//  - готовый HTML-фрагмент разбирает сам движок через innerHTML временного
//    узла: у 1С-обёртки ЭлементHTML свойства InnerHTML нет, строку в узлы
//    она не превращает;
//  - через мост передаются только строки - объекты 1С не маршалятся;
//  - индикатор печати рисуется формой последним элементом («<div id=siPrinting>»)
//    и обязан оставаться последним видимым блоком, поэтому новое вставляется
//    перед ним, а при его отсутствии - перед якорем chatBottom;
//  - прокрутку выполняет НАТИВНАЯ поверхность поля, а не DOM документа:
//    записи scrollTop из скрипта страницы вид не двигают (движок не отдаёт
//    переполнение контента ни через body, ни через html). Единственный
//    рабочий механизм - запись Документ.body.scrollTop со стороны 1С
//    (ПрокрутитьВнизНепосредственно формы), поэтому
//    скрипт прокруткой не занимается: из него форме нужны только дописывание
//    и чтение положения «внизу или нет» (siAppend/siChatAtBottom);
//  - смена темы (siSetTheme) заменяет ТОЛЬКО узел палитры <style id="siTheme">
//    и перекрашивает посимвольно окрашенные элементы скриптом (siPaintRoles) -
//    заголовки роли и текст ссылки «В таблицу»: цвет символов задан
//    inline-стилем и правилом CSS не переопределяется. Функции siStops,
//    siHex, siEscChar, siPaintRoles - вспомогательные для siSetTheme.
//
// Возвращаемое значение:
//  Строка - HTML-блок <script> с функциями страницы.
Функция ПолучитьСкриптДокументаHTML() Экспорт

	Возврат
	"<script>"
	+ "function siChatTail(){"
		+ "var p=document.getElementById('siPrinting');if(p){return p;}"
		+ "var a=document.getElementById('chatBottom');"
		+ "if(!a){var c=document.getElementsByName('chatBottom');a=c.length?c[0]:null;}"
		+ "return a;}"
	+ "function siChatInsert(html,node){"
		+ "var h=document.createElement('div');h.innerHTML=html;"
		+ "while(h.firstChild){node.parentNode.insertBefore(h.firstChild,node);}}"
	+ "function siScroller(){"
		+ "var b=document.body,h=document.documentElement;"
		+ "if(b&&b.scrollHeight>b.clientHeight+1){return b;}"
		+ "if(h&&h.scrollHeight>h.clientHeight+1){return h;}"
		+ "return b||h||null;}"
	+ "function siChatAtBottom(){"
		+ "var s=siScroller();if(!s){return true;}"
		+ "return (s.scrollTop+s.clientHeight)>=(s.scrollHeight-60);}"
	+ "function siScrollNodes(){"
		+ "var a=[],b=document.body,h=document.documentElement,s=siScroller();"
		+ "if(s){a.push(s);}"
		+ "if(b&&b!==s){a.push(b);}"
		+ "if(h&&h!==s&&h!==b){a.push(h);}"
		+ "return a;}"
	+ "function siScrollBottomInstant(){"
		+ "var a=siScrollNodes();if(!a.length){return 'noset';}"
		+ "for(var i=0;i<a.length;i++){"
		+ "var s=a[i],st=s.style? s.style.scrollBehavior : null;"
		+ "if(s.style){s.style.scrollBehavior='auto';}"
		+ "s.scrollTop=1000000000000000000;"
		+ "if(s.style){s.style.scrollBehavior=st||'';}}"
		+ "return 'ok';}"
	+ "function siAppend(html){"
		+ "if(!html){return 'empty';}"
		+ "var n=siChatTail();if(!n){return 'noanchor';}"
		+ "var f=siChatAtBottom();"
		+ "siChatInsert(html,n);"
		+ "if(f){siScrollBottomInstant();}"
		+ "return f?'bottom':'stay';}"
	+ "function siReplaceBubble(id,html){"
		+ "if(!id||!html){return 'notfound';}"
		+ "var sel='[data-si-bubble=\''+id+'\']';"
		+ "var old=document.querySelector(sel);"
		+ "if(!old){return 'notfound';}"
		+ "var parent=old.parentNode;"
		+ "siChatInsert(html,old);"
		+ "parent.removeChild(old);"
		+ "return 'ok';}"
	+ "function siSetLive(html){"
		+ "if(!html){return 'notfound';}"
		+ "var p=document.getElementById('siPrinting');"
		+ "if(!p){return 'notfound';}"
		+ "p.innerHTML=html;return 'ok';}"
	+ "function siSetPrintingOff(){"
		+ "var p=document.getElementById('siPrinting');"
		+ "if(!p){return 'off';}"
		+ "p.parentNode.removeChild(p);return 'off';}"
	+ "function siRemovePermCard(){"
		+ "var c=document.querySelector('[data-si-perm]');"
		+ "if(!c){return 'off';}"
		+ "c.parentNode.removeChild(c);return 'ok';}"
	+ "function siReplacePermCard(html){"
		+ "var c=document.querySelector('[data-si-perm]');"
		+ "if(!c){return 'off';}"
		+ "if(!html){c.parentNode.removeChild(c);return 'ok';}"
		+ "var t=document.createElement('div');t.innerHTML=html;"
		+ "var n=null,i;"
		+ "for(i=0;i<t.childNodes.length;i++){"
		+ "if(t.childNodes[i].nodeType===1){n=t.childNodes[i];break;}}"
		+ "if(!n){c.parentNode.removeChild(c);return 'ok';}"
		+ "c.parentNode.replaceChild(n,c);return 'ok';}"
	+ "function siStops(s){"
		+ "var p=s.split(','),a=[],i;"
		+ "for(i=0;i<p.length;i++){"
		+ "a.push([i/(p.length-1),parseInt(p[i].substr(0,2),16),parseInt(p[i].substr(2,2),16),parseInt(p[i].substr(4,2),16)]);"
		+ "}"
		+ "return a;}"
	+ "function siHex(v){"
		+ "var n=Math.round(v);if(n<0){n=0;}if(n>255){n=255;}"
		+ "var h=n.toString(16);return h.length<2?'0'+h:h;}"
	+ "function siEscChar(c){"
		+ "return c==='<'?'&lt;':(c==='>'?'&gt;':(c==='&'?'&amp;':c));}"
	+ "function siPaintRoles(root,stops){"
		+ "var g=siStops(stops),nodes=root.querySelectorAll('[data-si-role]');"
		+ "for(var n=0;n<nodes.length;n++){"
			+ "var el=nodes[n],t=el.textContent||'',out='';"
			+ "for(var i=0;i<t.length;i++){"
				+ "var ch=t.charAt(i);"
				+ "if(ch===' '){out+=' ';continue;}"
				+ "var d=t.length>1?i/(t.length-1):0,seg=0,k;"
				+ "for(k=1;k<g.length;k++){seg=k-1;if(d<=g[k][0]){break;}}"
				+ "var A=g[seg],B=g[seg+1];"
				+ "var l=(B[0]!==A[0])?(d-A[0])/(B[0]-A[0]):0;"
				+ "out+='<span style=""color:#'+siHex(A[1]+(B[1]-A[1])*l)+siHex(A[2]+(B[2]-A[2])*l)+siHex(A[3]+(B[3]-A[3])*l)+'"">'+siEscChar(ch)+'</span>';"
			+ "}"
			+ "el.innerHTML=out;"
		+ "}}"
	+ "function siSetTheme(css,stops){"
		+ "if(!css){return 'nocss';}"
		+ "var s=document.getElementById('siTheme');"
		+ "if(!s){return 'nostyle';}"
		+ "var n=document.createElement('style');"
		+ "n.id='siTheme';"
		+ "n.appendChild(document.createTextNode(css));"
		+ "s.parentNode.replaceChild(n,s);"
		+ "if(stops){siPaintRoles(document,stops);}"
		+ "return 'ok';}"
	+ "</script>";

КонецФункции

// Формирует HTML-блок «Контекст сжат» со сводкой сжатого контекста диалога.
//
// Параметры:
//  ТекстСводки - Строка - текст сводки (markdown не разбирается, переводы строк
//   сохраняются); пустая строка - блока нет.
//
// Возвращаемое значение:
//  Строка - HTML блока сводки либо "" (сводка не передана).
//
Функция ПолучитьСводкуHTML(Знач ТекстСводки) Экспорт
	Если ПустаяСтрока(ТекстСводки) Тогда
		Возврат "";
	КонецЕсли;
	СводкаЭкран = СИ_МаркдаунHTML.ЭкранироватьHTML(ТекстСводки);
	СводкаЭкран = СтрЗаменить(СводкаЭкран, Символы.ПС, "<br/>");
	СводкаЭкран = СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте(СводкаЭкран);
	Возврат "<div class=""si-summary"">"
		+ "<b>Контекст сжат:</b> " + СводкаЭкран + "</div>";
КонецФункции

// Подсказки-кнопки стартового экрана пустого диалога.
//
// Тексты заданы списком, а кнопка несёт только НОМЕР с единицы (ссылка
// hint:<номер>, обработчик - в форме чата): порядок существующих подсказок
// менять нельзя, новые дописываются в конец, иначе старые кнопки в уже
// отрисованном документе отправят чужой вопрос. Хвост "0" в ссылке не
// используется: платформа теряет его при разборе адреса (см.
// ПолучитьСтартовыйЭкранHTML).
//
// Параметры:
//  Режим - СправочникСсылка.СИ_РежимиРаботы - режим работы, из которого
//   читаются подсказки из реквизита «Подсказки» (многострочный текст,
//   каждая строка - отдельная подсказка). Реквизит пуст или режим не
//   передан - настраиваемых подсказок нет, остаётся только «Что ты умеешь?».
//
// Возвращаемое значение:
//  Массив из Строка - тексты подсказок (они же отправляются как вопрос).
Функция ПодсказкиСтартовогоЭкрана(Знач Режим = Неопределено) Экспорт

	Подсказки = Новый Массив;

	Если Режим <> Неопределено И ЗначениеЗаполнено(Режим) Тогда
		ТекстПодсказок = Режим.Подсказки;
		Если НЕ ПустаяСтрока(ТекстПодсказок) Тогда
			СтрокиПодсказок = СтрРазделить(ТекстПодсказок, Символы.ПС, Ложь);
			Для Каждого Стр Из СтрокиПодсказок Цикл
				СтрОчистленная = СокрЛП(Стр);
				Если НЕ ПустаяСтрока(СтрОчистленная) Тогда
					Подсказки.Добавить(СтрОчистленная);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Подсказки.Добавить("Что ты умеешь?");

	Возврат Подсказки;

КонецФункции

// Плитки ролей стартового экрана: «Руководитель», «Финансы», «Склад».
// Плитка показывается, только если в базе есть объекты соответствующей сводки
// (проверка по метаданным): в конфигурации без предметных регистров блок пуст,
// и стартовый экран остаётся прежним.
//
// Клик по плитке - ссылка role:<код>; обработчик в форме чата отправляет вопрос
// обзора и ограничивает набор инструментов первого шага одной сводкой.
//
// Возвращаемое значение:
//  Строка - HTML блока плиток; "" - если ни одна сводка неприменима.
Функция ПолучитьСтартовыеКарточкиHTML() Экспорт

	Попытка
		Доступность = СИ_Инструменты1С.ДоступностьОбзоров();
	Исключение
		ЗаписьЖурналаРегистрации("ЧатHTML.ПлиткиРолей", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось определить доступность сводок: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

	Плитки = Новый Массив;

	Если Доступность.Продажи Тогда
		Плитки.Добавить(СтартоваяКарточкаHTML("sales", "Руководитель",
			"Продажи и выручка за месяц, топ товаров и клиентов"));
	КонецЕсли;

	Если Доступность.Деньги ИЛИ Доступность.Долги Тогда
		Плитки.Добавить(СтартоваяКарточкаHTML("money", "Финансы",
			"Деньги, поступления и списания, долги"));
	КонецЕсли;

	Если Доступность.Склад Тогда
		Плитки.Добавить(СтартоваяКарточкаHTML("stock", "Склад",
			"Запасы, минусовые остатки, позиции без движения"));
	КонецЕсли;

	Если Плитки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить("<div class=""si-start-roles"">");
	Для Каждого ПлиткаHTML Из Плитки Цикл
		Части.Добавить(ПлиткаHTML);
	КонецЦикла;
	Части.Добавить("</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Разметка одной плитки роли.
//
// Параметры:
//  Код - Строка - код роли (ссылка role:<код>).
//  Заголовок - Строка - название роли.
//  Текст - Строка - пояснение.
//
// Возвращаемое значение:
//  Строка - HTML плитки.
Функция СтартоваяКарточкаHTML(Код, Заголовок, Текст)

	Возврат "<a class=""si-role-tile"" href=""role:" + СИ_МаркдаунHTML.ЭкранироватьHTML(Код) + """>"
		+ "<div class=""si-role-title"">" + СИ_МаркдаунHTML.ЭкранироватьHTML(Заголовок) + "</div>"
		+ "<div class=""si-role-text"">" + СИ_МаркдаунHTML.ЭкранироватьHTML(Текст) + "</div>"
		+ "</a>";

КонецФункции

// Стартовый экран пустого диалога: приветствие и подсказки-кнопки. Показывается
// вместо пустого каркаса документа, когда в диалоге ещё нет ни одного сообщения
// (см. форму чата: ОбновитьТекстИстории).
//
// Параметры:
//  Режим - СправочникСсылка.СИ_РежимиРаботы - режим работы, из которого
//   читаются подсказки стартового экрана. Если не передан или пуст -
//   настраиваемых подсказок нет, остаётся только «Что ты умеешь?».
//
// Список диалогов на экран НЕ выводится: он постоянно виден в списке слева,
// дублировать его в области чата незачем.
//
// Возвращаемое значение:
//  Строка - HTML стартового экрана (без заголовка документа и закрывающих тегов).
Функция ПолучитьСтартовыйЭкранHTML(Знач Режим = Неопределено) Экспорт

	Части = Новый Массив;
	Части.Добавить("<div class=""si-start"">");
	Части.Добавить("<div class=""si-start-title"">Чем помочь?</div>");
	Части.Добавить("<div class=""si-start-text"">Задайте вопрос по данным базы: посмотрю структуру, "
		+ "выполню запрос и объясню результат. Можно прикрепить файл или скриншот - "
		+ "разберу содержимое.</div>");

	СтартовыеКарточки = ПолучитьСтартовыеКарточкиHTML();
	Если НЕ ПустаяСтрока(СтартовыеКарточки) Тогда
		Части.Добавить(СтартовыеКарточки);
	КонецЕсли;

	Подсказки = ПодсказкиСтартовогоЭкрана(Режим);
	Части.Добавить("<div class=""si-start-tips"">");
	Для Индекс = 0 По Подсказки.Количество() - 1 Цикл
		Части.Добавить("<a class=""chatbtnopt"" href=""hint:"
			+ Формат(Индекс + 1, "ЧДЦ=0; ЧГ=0") + """>"
			+ СИ_МаркдаунHTML.ЭкранироватьHTML(Строка(Подсказки[Индекс])) + "</a>");
	КонецЦикла;
	Части.Добавить("</div>");

	Части.Добавить("</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Проверяет SVG-разметку на безопасность для вывода в поле HTML-документа.
// Задел для инлайн-диаграмм: сейчас схемы приходят файлами-картинками, поэтому
// функция нигде не вызывается - она включается вместе с задачей вывода SVG
// прямо в чат.
//
// Разметка допускается, только если начинается с <svg (возможно, после
// XML-заголовка) и не содержит: скриптов, inline-обработчиков событий (on*=),
// javascript:, вставок чужой разметки (foreignObject, iframe, embed, object)
// и внешних адресов в href/xlink:href (внутренние ссылки вида "#id" разрешены -
// на них держатся градиенты и фильтры SVG). Иначе возвращается пустая строка.
//
// Параметры:
//  Текст - Строка - проверяемая разметка SVG.
//
// Возвращаемое значение:
//  Строка - безопасная разметка (без крайних пробелов) либо "" - разметка
//  отклонена целиком.
Функция БезопасныйSVG(Знач Текст) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Сокр = СокрЛП(Текст);
	НРегТекст = НРег(Сокр);

	Если НЕ (СтрНачинаетсяС(НРегТекст, "<svg") ИЛИ СтрНачинаетсяС(НРегТекст, "<?xml")) Тогда
		Возврат "";
	КонецЕсли;

	ЗапрещенныеФрагменты = Новый Массив;
	ЗапрещенныеФрагменты.Добавить("<script");
	ЗапрещенныеФрагменты.Добавить("javascript:");
	ЗапрещенныеФрагменты.Добавить("foreignobject");
	ЗапрещенныеФрагменты.Добавить("<iframe");
	ЗапрещенныеФрагменты.Добавить("<embed");
	ЗапрещенныеФрагменты.Добавить("<object");
	Для Каждого Фрагмент Из ЗапрещенныеФрагменты Цикл
		Если СтрНайти(НРегТекст, Фрагмент) > 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Если ЕстьВнешняяСсылкаВSVG(НРегТекст) ИЛИ ЕстьInlineОбработчикСобытия(НРегТекст) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сокр;

КонецФункции

// Карточка диаграммы в ответе ассистента: заголовок, инлайн-SVG и ссылка
// «Скачать файл» на сохранённый SVG/SVG-файл диалога.
//
// SVG повторно проверяется БезопасныйSVG прямо здесь: карточка может быть
// отрисована из регистра (перечитка истории), и полагаться на проверку в момент
// построения нельзя - хранилище могло быть изменено.
//
// Параметры:
//  Заголовок - Строка - заголовок диаграммы.
//  SVG - Строка - разметка SVG (уже проверенная при сохранении, проверяется снова).
//  Подпись - Строка - подпись под диаграммой (число точек, колонки).
//  УИДФайла - Строка - UUID файла в диалоге; пусто - ссылки нет.
//  ИмяФайла - Строка - имя файла для подписи ссылки.
//
// Возвращаемое значение:
//  Строка - HTML карточки; "" - если SVG отклонён проверкой.
Функция ПолучитьКарточкуДиаграммыHTML(Заголовок, SVG, Подпись, УИДФайла, ИмяФайла) Экспорт

	SVG = СтрЗаменить(SVG, " 0  1 ", " 0 0 1 ");

	БезопаснаяРазметка = БезопасныйSVG(SVG);
	Если ПустаяСтрока(БезопаснаяРазметка) Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить("<div class=""si-chart-card"">");

	Если НЕ ПустаяСтрока(Заголовок) Тогда
		Части.Добавить("<div class=""si-chart-title"">"
			+ СИ_МаркдаунHTML.ЭкранироватьHTML(Заголовок) + "</div>");
	КонецЕсли;

	Части.Добавить("<div class=""si-chart-body"">" + БезопаснаяРазметка + "</div>");

	Если НЕ ПустаяСтрока(Подпись) Тогда
		Части.Добавить("<div class=""si-chart-caption"">"
			+ СИ_МаркдаунHTML.ЭкранироватьHTML(Подпись) + "</div>");
	КонецЕсли;

	Если НЕ ПустаяСтрока(УИДФайла) Тогда
		ТекстСсылки = "Скачать файл";
		Если НЕ ПустаяСтрока(ИмяФайла) Тогда
			ТекстСсылки = "Скачать " + ИмяФайла;
		КонецЕсли;
		Части.Добавить("<div class=""si-chart-actions""><a class=""chatbtn"" href=""file:"
			+ СИ_МаркдаунHTML.ЭкранироватьHTML(УИДФайла) + """>"
			+ СИ_МаркдаунHTML.ЭкранироватьHTML(ТекстСсылки) + "</a></div>");
	КонецЕсли;

	Части.Добавить("</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Разбирает «вопрос с вариантами ответа» в контенте сообщения ассистента.
// Модель (по инструкции системного промпта) может завершить ответ маркерным блоком:
// [Вопрос: ...] и строк [Вариант: ...]. Возвращает структуру:
//   Успех - Булево - маркерный блок найден и содержит вопрос + >= 2 вариантов
//   Вопрос - Строка - текст вопроса
//   Варианты - Массив - тексты вариантов
//   КонтентБезМаркеров - Строка - исходный контент с вырезанными строками-маркерами
Функция РазобратьВопросСВариантами(Знач Контент) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Вопрос", "");
	Результат.Вставить("Варианты", Новый Массив);
	Результат.Вставить("КонтентБезМаркеров", Контент);

	Если ПустаяСтрока(Контент) Тогда
		Возврат Результат;
	КонецЕсли;

	СтрокиКонтента = СтрРазделить(Контент, Символы.ПС, Ложь);

	МассивОставшихся = Новый Массив;
	ТекстВопроса = "";
	Варианты = Новый Массив;
	Для Каждого СтрокаКонтента Из СтрокиКонтента Цикл
		СтрокаОбработки = СокрЛП(СтрокаКонтента);

		СтрокаМаркеров = СокрЛП(УбратьHTMLТегиИзСтроки(СтрокаОбработки));

		Пока НЕ ПустаяСтрока(СтрокаМаркеров)
			И СтрНайти("-*+> ", Лев(СтрокаМаркеров, 1)) > 0 Цикл
			СтрокаМаркеров = СокрЛП(Сред(СтрокаМаркеров, 2));
		КонецЦикла;

		Если СтрНачинаетсяС(СтрокаМаркеров, "[Вопрос:") Тогда
			Если Прав(СтрокаМаркеров, 1) = "]" Тогда
				ТекстВопроса = СокрЛП(Сред(СтрокаМаркеров, 9, СтрДлина(СтрокаМаркеров) - 9));
			Иначе
				ТекстВопроса = СокрЛП(Сред(СтрокаМаркеров, 9));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(СтрокаМаркеров, "[Вариант:") Тогда
			ТекстВарианта = "";
			Если Прав(СтрокаМаркеров, 1) = "]" Тогда
				ТекстВарианта = СокрЛП(Сред(СтрокаМаркеров, 10, СтрДлина(СтрокаМаркеров) - 10));
			Иначе
				ТекстВарианта = СокрЛП(Сред(СтрокаМаркеров, 10));
			КонецЕсли;
			Если НЕ ПустаяСтрока(ТекстВарианта) Тогда
				Варианты.Добавить(ТекстВарианта);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(СтрокаМаркеров) И СтрНайти(СтрокаОбработки, "<") > 0 Тогда
			Продолжить;
		КонецЕсли;

		МассивОставшихся.Добавить(СтрокаКонтента);
	КонецЦикла;

	Если НЕ ПустаяСтрока(ТекстВопроса) И Варианты.Количество() >= 2 Тогда
		Результат.Успех = Истина;
		Результат.Вопрос = ТекстВопроса;
		Результат.Варианты = Варианты;

		Пока МассивОставшихся.Количество() > 0
			И ПустаяСтрока(СокрЛП(МассивОставшихся[МассивОставшихся.Количество() - 1])) Цикл
			МассивОставшихся.Удалить(МассивОставшихся.Количество() - 1);
		КонецЦикла;
		Результат.КонтентБезМаркеров = СтрСоединить(МассивОставшихся, Символы.ПС);
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Формирует HTML-блок «вопрос с вариантами ответа»: подпись вопроса и кнопки-варианты
// в стиле кнопки-действия «Скачать файл» (плоский чип без рамки).
// Каждая кнопка - ссылка href="choose:<номер сообщения>:<индекс варианта>",
// клик обрабатывает ТекстИсторииНажатиеНаСсылке -> ВыбратьВариантОтвета.
//
// Параметры:
//  НомерСообщения - Число - номер сообщения ассистента с вопросом; <= 0 или
//   Неопределено - блока нет (кнопкам нечего адресовать);
//  Вопрос - Строка - текст вопроса над кнопками; пустая строка - только кнопки;
//  Варианты - Массив из Строка - тексты вариантов (нужно не меньше двух).
//
// Возвращаемое значение:
//  Строка - HTML карточки с кнопками-вариантами; "" - вариантов нет или номер
//  сообщения не передан.
//
Функция ПолучитьБлокВопросаHTML(НомерСообщения, Вопрос, Варианты) Экспорт

	Если НомерСообщения = Неопределено ИЛИ НомерСообщения <= 0 Тогда
		Возврат "";
	КонецЕсли;
	Если Варианты = Неопределено ИЛИ ТипЗнч(Варианты) <> Тип("Массив") ИЛИ Варианты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ВопросЭкран = "";
	Если НЕ ПустаяСтрока(Вопрос) Тогда
		ВопросЭкран = "<div class=""si-q"">"
			+ СИ_МаркдаунHTML.ЭкранироватьHTML(Вопрос) + "</div>";
	КонецЕсли;

	Кнопки = Новый Массив;
	Для ИндексВарианта = 0 По Варианты.Количество() - 1 Цикл
		ТекстВарианта = СИ_МаркдаунHTML.ЭкранироватьHTML(Варианты[ИндексВарианта]);
		ТекстВарианта = СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте(ТекстВарианта);
		Кнопки.Добавить(
			"<a href=""choose:" + Формат(НомерСообщения, "ЧН=0; ЧДЦ=0; ЧГ=0") + ":"
				+ Формат(ИндексВарианта, "ЧН=0; ЧДЦ=0; ЧГ=0") + """"
			+ " title=""Выбрать этот вариант"""
			+ " class=""chatbtnopt si-btn-opt"">"
			+ ТекстВарианта + "</a>");
	КонецЦикла;

	Возврат
	"<div class=""si-panel"">"
		+ ВопросЭкран
		+ СтрСоединить(Кнопки, "")
	+ "</div>";

КонецФункции

// Формирует HTML-карточку «запрос разрешения» для отложенных вызовов инструментов
// (двухфазный запуск агента). Карточка показывает ОДИН вызов - первый, по которому
// решение ещё не принято, - и кнопки-решения для него: Разрешить /
// Разрешить всегда в этом диалоге / Отклонить.
//
// Последовательное подтверждение: решение пишется только по текущему вызову
// (СИ_Агент1С.ЗаписатьРешениеРазрешения), после чего карточка перерисовывается
// и показывает следующий нерешённый вызов. Фоновое задание запускается один раз,
// когда решения приняты по всему пакету.
//
// Параметры:
//  ВызовыJSON - Строка - JSON-массив отложенных вызовов из регистра
//    СИ_ОжидающиеРазрешения. У решённых вызовов заполнено поле Решение
//    ("allow"/"always"/"deny"); такие вызовы пропускаются.
//  ПоказыватьПродолжение - Булево - Истина: если решения уже приняты по всем
//    вызовам, показать карточку с кнопкой «Продолжить» (perm:resume:). Так
//    пользователь может перезапустить возобновление после сбоя запуска.
//
// Возвращаемое значение:
//  Строка - HTML-карточка; пустая строка, если вызовов нет или все решения уже
//   приняты, а ПоказыватьПродолжение = Ложь.
Функция ПолучитьБлокРазрешенияHTML(Знач ВызовыJSON, Знач ПоказыватьПродолжение = Ложь) Экспорт

	Если ПустаяСтрока(ВызовыJSON) Тогда
		Возврат "";
	КонецЕсли;

	Разобранное = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ВызовыJSON);
	Если Разобранное = Неопределено ИЛИ ТипЗнч(Разобранное) <> Тип("Массив") ИЛИ Разобранное.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ТекущийИндекс = -1;
	ОсталосьНерешённых = 0;
	Для ИндексВызова = 0 По Разобранное.Количество() - 1 Цикл
		ЭлементВызова = Разобранное[ИндексВызова];
		РешениеВызова = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(ЭлементВызова, "Решение", "")));
		Если ПустаяСтрока(РешениеВызова)
			И НЕ ПустаяСтрока(Строка(СИ_РаботаСJSON.БезопасноПолучить(ЭлементВызова, "Ид", ""))) Тогда
			ОсталосьНерешённых = ОсталосьНерешённых + 1;
			Если ТекущийИндекс < 0 Тогда
				ТекущийИндекс = ИндексВызова;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ТекущийИндекс < 0 Тогда
		Если НЕ ПоказыватьПродолжение Тогда
			Возврат "";
		КонецЕсли;
		Возврат ПолучитьКарточкуПродолженияHTML();
	КонецЕсли;

	Элемент = Разобранное[ТекущийИндекс];
	ИмяИнструмента = Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Имя", ""));
	ИдТекущегоВызова = Строка(СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Ид", ""));
	Если ПустаяСтрока(ИдТекущегоВызова) Тогда
		Если ПоказыватьПродолжение Тогда
			Возврат ПолучитьКарточкуПродолженияHTML();
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	СтрокаВызова = "<div class=""si-call"">"
		+ "<b>" + СИ_МаркдаунHTML.ЭкранироватьHTML(ИмяИнструмента) + "</b>";
	АргументыИзВызова = СИ_РаботаСJSON.БезопасноПолучить(Элемент, "Аргументы", Неопределено);
	Если АргументыИзВызова <> Неопределено Тогда
		ТекстАргументов = "";
		Попытка
			ТекстАргументов = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(АргументыИзВызова);
		Исключение
			ТекстАргументов = "";
		КонецПопытки;
		Если НЕ ПустаяСтрока(ТекстАргументов) Тогда
			ТекстАргументов = СтрЗаменить(ТекстАргументов, "\r", " ");
			ТекстАргументов = СтрЗаменить(ТекстАргументов, "\n", " ");
			ТекстАргументов = СтрЗаменить(ТекстАргументов, "\t", " ");
			СтрокаВызова = СтрокаВызова + "<span class=""si-args""> "
				+ СИ_МаркдаунHTML.ЭкранироватьHTML(Лев(ТекстАргументов, 200))
				+ ?(СтрДлина(ТекстАргументов) > 200, "…", "") + "</span>";
		КонецЕсли;
	КонецЕсли;
	СтрокаВызова = СтрокаВызова + "</div>";

	КнопкаСтиль = " class=""chatbtnopt si-btn-perm""";
	Кнопки =
		"<a href=""perm:allow:" + ИдТекущегоВызова + """ title=""Исполнить этот вызов"""
		+ КнопкаСтиль + ">Разрешить</a>"
		+ "<a href=""perm:always:" + ИдТекущегоВызова + """ title=""Исполнить и не спрашивать для этого инструмента в текущем диалоге"""
		+ КнопкаСтиль + ">Разрешить всегда в диалоге</a>"
		+ "<a href=""perm:deny:" + ИдТекущегоВызова + """ title=""Отклонить этот вызов"""
		+ КнопкаСтиль + ">Отклонить</a>";

	ИконкаЗамка =
		"<svg xmlns=""http://www.w3.org/2000/svg"" width=""14"" height=""14"" viewBox=""0 0 24 24"""
		+ " fill=""none"" stroke=""currentColor"" stroke-width=""2.5"" stroke-linecap=""round"" stroke-linejoin=""round"""
		+ " style=""vertical-align:middle;margin-right:6px;"">"
		+ "<rect x=""4"" y=""11"" width=""16"" height=""9"" rx=""2""></rect>"
		+ "<path d=""M8 11V7a4 4 0 0 1 8 0v4""></path>"
		+ "</svg>";

	ВсегоВызовов = Разобранное.Количество();
	Если ВсегоВызовов = 1 Тогда
		Заголовок = ИконкаЗамка + "Требуется подтверждение: агент хочет исполнить инструмент";
	Иначе
		Заголовок = ИконкаЗамка + "Требуется подтверждение: вызов "
			+ Формат(ТекущийИндекс + 1, "ЧН=0; ЧДЦ=0; ЧГ=0") + " из "
			+ Формат(ВсегоВызовов, "ЧН=0; ЧДЦ=0; ЧГ=0");
	КонецЕсли;

	Если ВсегоВызовов = 1 Тогда
		Подпись = "";
	ИначеЕсли ОсталосьНерешённых > 1 Тогда
		Подпись = "<div class=""si-perm-hint"">После решения откроется следующий вызов.</div>";
	Иначе
		Подпись = "<div class=""si-perm-hint"">Это последний вызов - после решения агент продолжит работу.</div>";
	КонецЕсли;

	Возврат
	МаркерНачалаБлокаРазрешения() + " class=""si-panel"">"
		+ "<div class=""si-panel-title"">" + Заголовок + "</div>"
		+ СтрокаВызова
		+ Подпись
		+ Кнопки
	+ "</div>" + МаркерКонцаБлокаРазрешения();

КонецФункции

// Заменяет блок карточки запроса разрешения в готовом HTML документа чата.
// Нужна резервному пути формы (без JS-моста): документ перерисовывается
// платформой целиком, и строка ТекстИстории должна нести уже следующую карточку.
//
// Знание о разметке карточки (маркеры начала и конца) живёт здесь, а не в форме.
// Замена идёт от открывающего div карточки до её маркера конца, поэтому блоки
// после карточки сохраняются. Пустая HTMLКарточки удаляет блок.
//
// Параметры:
//  HTMLДокумента - Строка - текущая строка документа чата (реквизит ТекстИстории).
//  HTMLКарточки - Строка - новая карточка (см. ПолучитьБлокРазрешенияHTML);
//   пустая строка удаляет блок.
//
// Возвращаемое значение:
//  Строка - документ с заменённым блоком карточки.
Функция ЗаменитьБлокРазрешенияHTML(Знач HTMLДокумента, Знач HTMLКарточки) Экспорт

	НачалоБлока = СтрНайти(HTMLДокумента, МаркерНачалаБлокаРазрешения());
	Если НачалоБлока = 0 Тогда
		Возврат HTMLДокумента;
	КонецЕсли;

	МаркерКонца = МаркерКонцаБлокаРазрешения();
	ПозицияМаркера = СтрНайти(HTMLДокумента, МаркерКонца, НаправлениеПоиска.СНачала, НачалоБлока);
	Если ПозицияМаркера = 0 Тогда
		ПозицияЗакрытия = СтрНайти(HTMLДокумента, "</body></html>");
		Если ПозицияЗакрытия = 0 Тогда
			Возврат HTMLДокумента;
		КонецЕсли;
		КонецБлока = ПозицияЗакрытия;
	Иначе
		КонецБлока = ПозицияМаркера + СтрДлина(МаркерКонца);
	КонецЕсли;

	Возврат Лев(HTMLДокумента, НачалоБлока - 1) + HTMLКарточки
		+ Сред(HTMLДокумента, КонецБлока);

КонецФункции

// Пузырь пользователя - плотная синяя плашка (класс si-card-user): белый текст
// читается на ней лучше, чем на полупрозрачной «стеклянной», а от карточек
// ответа модели она отличается и цветом, и стороной выравнивания.
// Все цвета - в палитре темы (см. ПолучитьСтилиТемыCSS).
//
// Параметры:
//  Время - Строка - подпись времени в заголовке пузыря («Вы · время»);
//  Контент - Строка - готовый HTML контента сообщения.
//
// Возвращаемое значение:
//  Строка - HTML пузыря пользователя.
//
Функция ПолучитьBubbleUserHTML(Время, Контент) Экспорт
	ЗаголовокHTML = "<span class=""si-role si-role-user"">Вы · " + Время + "</span>";
	Возврат
	"<div class=""si-msg si-msg-user"">"
		+ "<div class=""si-card si-card-user"">"
			+ "<div class=""si-head"">" + ЗаголовокHTML + "</div>"
			+ "<div class=""si-body"">" + Контент + "</div>"
		+ "</div>"
	+ "</div>";
КонецФункции

// HTML-ссылка «В таблицу» под ответом ассистента. По клику таблицы из ТЕКСТА
// ответа выгружаются табличным документом (markdown-таблицы разбирает
// СИ_МаркдаунHTML.ИзвлечьТаблицыMarkdown). Привязки к инструментам нет:
// ссылка появляется, когда в ответе есть таблица, а номер сообщения нужен
// выгрузке, чтобы найти текст ответа.
// Оформление: не кнопка-чип, а текстовая ссылка в цвете надписи «Ассистент» -
// надпись и ссылка красятся одним и тем же посимвольным градиентом заголовка
// роли. Поэтому у текста ссылки стоит метка data-si-role: цвет символов задан
// inline-стилем, и при смене темы скрипт страницы (siPaintRoles) перекрашивает
// ссылку вместе с заголовками.
//
// Параметры:
//  НомерСообщения - Число, Неопределено - номер сообщения ассистента, для
//   которого выводится ссылка; 0 или Неопределено - ссылки нет;
//  ТемнаяТема - Булево - Истина: стопы градиента заголовка берутся из тёмной
//   палитры (как в ПолучитьBubbleAssistantHTML).
//
// Возвращаемое значение:
//  Строка - HTML ссылки либо "" (номер не передан или некорректен).
Функция КнопкаВТаблицуHTML(НомерСообщения, Знач ТемнаяТема = Ложь) Экспорт

	Если НомерСообщения = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	НомерСообщенияЧисло = 0;
	Попытка
		НомерСообщенияЧисло = Число(НомерСообщения);
	Исключение
		НомерСообщенияЧисло = 0;
	КонецПопытки;
	Если НомерСообщенияЧисло <= 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат
	"<div class=""si-btn-totable"">"
		+ "<a href=""totable:" + Формат(НомерСообщенияЧисло, "ЧДЦ=0; ЧГ=0") + """"
		+ " title=""Выгрузить таблицу ответа табличным документом"""
		+ " class=""si-link-totable"">"
		+ "<svg xmlns=""http://www.w3.org/2000/svg"" width=""14"" height=""14"" viewBox=""0 0 24 24"""
		+ " fill=""none"" stroke=""currentColor"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round"""
		+ " style=""vertical-align:middle;margin-right:5px;"">"
			+ "<rect x=""3"" y=""4"" width=""18"" height=""16"" rx=""2""></rect>"
			+ "<line x1=""3"" y1=""10"" x2=""21"" y2=""10""></line>"
			+ "<line x1=""3"" y1=""16"" x2=""21"" y2=""16""></line>"
			+ "<line x1=""10"" y1=""10"" x2=""10"" y2=""20""></line>"
		+ "</svg>"
		+ "<span data-si-role=""1"">" + РаскраситьТекстГрадиентом("В таблицу", ТемнаяТема) + "</span>"
	+ "</a></div>";

КонецФункции

// Пузырь ответа ассистента: карточка с полосой роли слева (класс si-card-bot,
// цвета - в палитре темы), градиентным заголовком «Ассистент · время», блоком
// вопроса с вариантами (если задан) и ссылкой «В таблицу» (если в ответе есть
// таблица). Рассуждения модели в пузыре ответа не показываются: они живут
// в живом индикаторе «Думаю» (ПолучитьИндикаторПечатиHTML) и снимаются вместе
// с ним на финализации.
// ВНИМАНИЕ: функция внутренняя для чата (единственный вызов - ФормаЧата),
// при изменении сигнатуры совместимость с внешними вызовами не сохраняется:
// параметр Рассуждения удалён 04.10.2026 без сохранения совместимости.
//
// Параметры:
//  Время - Строка - подпись времени в заголовке пузыря («Ассистент · время»);
//  Контент - Строка - готовый HTML контента ответа;
//  НомерСообщения - Число - номер сообщения для метки пузыря и ссылки «Копировать»;
//  НомерСообщенияДляТаблицы - Число - номер сообщения ассистента, для которого
//   выводится ссылка «В таблицу»; 0 или Неопределено - ссылки нет;
//  БлокВопросаДляВывода - Строка - готовый HTML блока вопроса с вариантами;
//  ТемнаяТема - Булево - Истина: стопы градиента заголовка берутся из тёмной
//   палитры (цвета самой карточки приходят из css темы и от параметра не зависят).
//
// Возвращаемое значение:
//  Строка - HTML пузыря ответа ассистента.
Функция ПолучитьBubbleAssistantHTML(Время, Контент, НомерСообщения = 0, НомерСообщенияДляТаблицы = Неопределено, БлокВопросаДляВывода = "", Знач ТемнаяТема) Экспорт

	НомерДляСсылки = 0;
	Если НомерСообщения <> Неопределено И ТипЗнч(НомерСообщения) = Тип("Число") Тогда
		НомерДляСсылки = НомерСообщения;
	КонецЕсли;
	СсылкаКопирования = "";
	Если НомерДляСсылки > 0 Тогда
		СсылкаКопирования = "<a href=""copy:" + Формат(НомерДляСсылки, "ЧДЦ=0; ЧГ=0")
			+ """ title=""Копировать ответ"" class=""si-copy"">"
			+ "<svg xmlns=""http://www.w3.org/2000/svg"" width=""14"" height=""14"" viewBox=""0 0 24 24"" fill=""none"" stroke-width=""2"" stroke-linecap=""round"" stroke-linejoin=""round"">"
				+ "<rect class=""si-ico-back"" x=""9"" y=""9"" width=""13"" height=""13"" rx=""2"" ry=""2""></rect>"
				+ "<path class=""si-ico-front"" d=""M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1""></path>"
			+ "</svg>"
		+ "</a>";
	КонецЕсли;

	ЗаголовокСообщения = "Ассистент · " + Время;
	ЗаголовокHTML = "<span class=""si-role"" data-si-role=""1"">"
		+ РаскраситьТекстГрадиентом(ЗаголовокСообщения, ТемнаяТема) + "</span>";

	МеткаПузыря = "";
	Если НомерДляСсылки > 0 Тогда
		МеткаПузыря = "data-si-bubble=""" + Формат(НомерДляСсылки, "ЧДЦ=0; ЧГ=0") + """ ";
	КонецЕсли;

	Возврат
	"<div " + МеткаПузыря + "class=""si-msg si-msg-bot"">"
		+ "<div class=""si-card si-card-bot"">"
			+ "<div class=""si-head"">"
				+ ЗаголовокHTML
				+ СсылкаКопирования
			+ "</div>"
			+ "<div class=""si-body"">" + Контент + "</div>"
			+ БлокВопросаДляВывода
			+ КнопкаВТаблицуHTML(НомерСообщенияДляТаблицы, ТемнаяТема)
		+ "</div>"
	+ "</div>";
КонецФункции

// Раскрашивает текст градиентом: каждый символ окрашен сплошным цветом,
// интерполированным между стопами палитры темы. Светлая тема даёт прежнюю
// тройку #3b82f6 → #8b5cf6 → #a855f7, тёмная - осветлённые стопы (иначе первый
// символ заголовка на тёмной карточке читается хуже остальных).
// Работает в любом движке HTML, включая Trident (тонкий клиент).
// Стопы приходят строкой "RRGGBB,RRGGBB,..." из палитры
// (ПолучитьПалитруТемы.СтопыГрадиентаЗаголовка) и раскладываются по долям
// равномерно - как в прежней жёстко заданной тройке.
//
// Параметры:
//  Текст - Строка - текст заголовка («Ассистент · время»);
//  ТемнаяТема - Булево - Истина: стопы тёмной палитры, Ложь - светлой.
//
// Возвращаемое значение:
//  Строка - текст, в котором каждый непробельный символ обёрнут
//  в <span style="color:#RRGGBB">.
//
Функция РаскраситьТекстГрадиентом(Знач Текст, Знач ТемнаяТема = Ложь) Экспорт

	СтопыЦветов = СтрРазделить(ПолучитьПалитруТемы(ТемнаяТема).СтопыГрадиентаЗаголовка, ",", Ложь);
	ВсегоСтопов = СтопыЦветов.Количество();
	Если ВсегоСтопов < 2 Тогда
		Возврат Текст;
	КонецЕсли;

	Градиент = Новый Массив;
	Для ИндСтопа = 1 По ВсегоСтопов Цикл
		ЦветСтопа = СтопыЦветов[ИндСтопа - 1];
		Стоп = Новый Структура;
		Стоп.Вставить("Доля", (ИндСтопа - 1) / (ВсегоСтопов - 1));
		Стоп.Вставить("КК", Сред(ЦветСтопа, 1, 2));
		Стоп.Вставить("З",  Сред(ЦветСтопа, 3, 2));
		Стоп.Вставить("С",  Сред(ЦветСтопа, 5, 2));
		Градиент.Добавить(Стоп);
	КонецЦикла;

	Результат = "";
	ДлинаТекста = СтрДлина(Текст);
	Если ДлинаТекста <= 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Инд = 1 По ДлинаТекста Цикл
		Символ = Сред(Текст, Инд, 1);
		Если Символ = " " Тогда
			Результат = Результат + " ";
			Продолжить;
		КонецЕсли;

		Доля = (Инд - 1) / (ДлинаТекста - 1);

		Сегмент = 0;
		Для К = 1 По Градиент.Количество() - 1 Цикл
			Если Доля <= Градиент[К].Доля Тогда
				Сегмент = К - 1;
				Прервать;
			КонецЕсли;
			Сегмент = К - 1;
		КонецЦикла;

		СтопА = Градиент[Сегмент];
		СтопБ = Градиент[Сегмент + 1];
		ЛокальнаяДоля = 0;
		Если СтопБ.Доля <> СтопА.Доля Тогда
			ЛокальнаяДоля = (Доля - СтопА.Доля) / (СтопБ.Доля - СтопА.Доля);
		КонецЕсли;

		КК = Цел(ЧислоИзHex(СтопА.КК) + (ЧислоИзHex(СтопБ.КК) - ЧислоИзHex(СтопА.КК)) * ЛокальнаяДоля);
		З  = Цел(ЧислоИзHex(СтопА.З)  + (ЧислоИзHex(СтопБ.З)  - ЧислоИзHex(СтопА.З))  * ЛокальнаяДоля);
		С  = Цел(ЧислоИзHex(СтопА.С)  + (ЧислоИзHex(СтопБ.С)  - ЧислоИзHex(СтопА.С))  * ЛокальнаяДоля);

		ЦифрыHex = "0123456789abcdef";
		Цвет = "#" + Сред(ЦифрыHex, Цел(КК / 16) + 1, 1) + Сред(ЦифрыHex, КК - Цел(КК / 16) * 16 + 1, 1)
			+ Сред(ЦифрыHex, Цел(З / 16) + 1, 1) + Сред(ЦифрыHex, З - Цел(З / 16) * 16 + 1, 1)
			+ Сред(ЦифрыHex, Цел(С / 16) + 1, 1) + Сред(ЦифрыHex, С - Цел(С / 16) * 16 + 1, 1);

		Результат = Результат + "<span style=""color:" + Цвет + """>" + Символ + "</span>";
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Возвращает число 0..255 из двузначной hex-строки (например, "3b" → 59).
Функция ЧислоИзHex(Знач Шестнадцатеричное) Экспорт
	Цифры = "0123456789ABCDEF";
	Результат = 0;
	Для Поз = 1 По 2 Цикл
		Символ = ВРег(Сред(Шестнадцатеричное, Поз, 1));
		Результат = Результат * 16 + (СтрНайти(Цифры, Символ) - 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пузырь ошибки: карточка ошибки (класс si-card-err) с заголовком
// «Ошибка · время». Цвета - в палитре темы.
//
// Параметры:
//  Время - Строка - подпись времени в заголовке («Ошибка · время»);
//  Контент - Строка - готовый HTML текста ошибки.
//
// Возвращаемое значение:
//  Строка - HTML пузыря ошибки.
//
Функция ПолучитьBubbleErrorHTML(Время, Контент) Экспорт
	Возврат
	"<div class=""si-msg si-msg-bot"">"
		+ "<div class=""si-card si-card-err"">"
			+ "<div class=""si-meta"">Ошибка · " + Время + "</div>"
			+ "<div class=""si-body-sm"">" + Контент + "</div>"
		+ "</div>"
	+ "</div>";
КонецФункции

// Индикатор живого режима агента: стеклянный пузырь в стиле пузыря ассистента.
// Один пузырь на весь заход, служит единственным блоком активности:
//  - заголовок «Ассистент · время» (градиентный, как у пузыря ответа);
//  - строка «Обдумываю…» с пульсирующими точками - всегда;
//  - строка «Инструменты: …» - ПОД ней, зарезервирована пустой (высота пузыря
//    не меняется), заполняется перечнем вызовов и перерисовывается на месте
//    (см. ОбновитьЖивойИндикатор формы чата); у упавшего вызова имя красное
//    с пометкой ⚠.
// Пузырь остаётся последним блоком документа (хвостом, перед которым
// дописываются сообщения), поэтому ответ модели всегда оказывается над ним,
// а на финализации пузырь снимается вместе с siPrinting.
// Иконка и текст - в разных узлах (см. ИконкаЧатАгентаHTML); CSS точек - в
// голове документа (ПолучитьЗаголовокHTML).
//
// Параметры:
//  ИменаИнструментов - Массив из Структура - вызовы инструментов текущего
//   захода в порядке появления; элемент содержит ключи Имя (Строка),
//   Действие (Строка - человекочитаемый статус шага; пусто - показывается имя)
//   и Успех (Булево); Неопределено или пустой массив - строка инструментов пустая.
//  Рассуждения - Строка - рассуждения модели последней итерации (сырой текст;
//   форма затирает их каждой новой итерацией); показываются развернутым блоком
//   «Рассуждения модели» между строкой
//   «Обдумываю…» и строкой инструментов. Как и вызовы инструментов, живут
//   только в живом индикаторе: на финализации хода индикатор снимается
//   вместе с рассуждениями.
//  ПромежуточныйТекст - Строка - последняя промежуточная реплика модели
//   (контент assistant-сообщения с вызовом инструментов, «Сейчас уточню
//   структуру…»); форма затирает её следующей репликой. Показывается строкой
//   над блоком рассуждений, на финализации снимается вместе с индикатором;
//  ТемнаяТема - Булево - Истина: стопы градиента заголовка берутся из тёмной
//   палитры (цвета карточки приходят из css темы и от параметра не зависят).
//
// Возвращаемое значение:
//  Строка - HTML-блок пузыря (внутреннее содержимое узла <div id="siPrinting">).
//
// ВНИМАНИЕ: функция внутренняя для чата (вызывается из ФормаЧата);
// 04.10.2026 сигнатура менялась без сохранения совместимости: параметр
// Тихо (Булево) удалён, вторым параметром стал Рассуждения (Строка).
Функция ПолучитьИндикаторПечатиHTML(Знач ИменаИнструментов = Неопределено, Знач Рассуждения = "", Знач ПромежуточныйТекст = "", Знач ТемнаяТема) Экспорт

	СтрокаИнструментовHTML = "&nbsp;";

	Если ИменаИнструментов <> Неопределено И ИменаИнструментов.Количество() > 0 Тогда
		ЧастиИмен = Новый Массив;
		Для Каждого Вызов Из ИменаИнструментов Цикл
			ИмяВызова = "";
			УспехВызова = Истина;
			Попытка
				ИмяВызова = Вызов.Имя;
				УспехВызова = Вызов.Успех;
				ДействиеВызова = "";
				Если Вызов.Свойство("Действие") Тогда
					ДействиеВызова = СокрЛП(Строка(Вызов.Действие));
				КонецЕсли;
			Исключение
				Продолжить;
			КонецПопытки;
			Если ПустаяСтрока(ИмяВызова) Тогда
				Продолжить;
			КонецЕсли;
			ТекстВызова = ?(ПустаяСтрока(ДействиеВызова), ИмяВызова, ДействиеВызова);
			ИмяЭкран = СИ_МаркдаунHTML.ЭкранироватьHTML(ТекстВызова);
			Если УспехВызова = Ложь Тогда
				ИмяЭкран = "<span class=""si-fail"">⚠ " + ИмяЭкран + "</span>";
			КонецЕсли;
			ЧастиИмен.Добавить(ИмяЭкран);
		КонецЦикла;
		Если ЧастиИмен.Количество() > 0 Тогда
			ТекстЧасть = СтрСоединить(ЧастиИмен, ", ");
			Если СтрДлина(ТекстЧасть) > 300 Тогда
				ТекстЧасть = Лев(ТекстЧасть, 300) + "…";
			КонецЕсли;
			СтрокаИнструментовHTML = ТекстЧасть;
		КонецЕсли;
	КонецЕсли;

	БлокРассужденийHTML = "";
	Если НЕ ПустаяСтрока(Рассуждения) Тогда
		ТекстРассуждений = СИ_МаркдаунHTML.ЭкранироватьHTML(Рассуждения);
		ТекстРассуждений = СтрЗаменить(ТекстРассуждений, Символы.ПС, "<br/>");
		ТекстРассуждений = СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте(ТекстРассуждений);
		Если СтрДлина(ТекстРассуждений) > 600 Тогда
			ТекстРассуждений = "…" + ОбрезатьHTMLХвост(ТекстРассуждений, 600);
		КонецЕсли;
		БлокРассужденийHTML =
		"<details open class=""si-reason"">"
			+ "<summary>Рассуждения модели</summary>"
			+ "<div style=""margin-top:6px;white-space:normal;word-wrap:break-word;font-family:'Segoe UI',Arial,sans-serif;"">" + ТекстРассуждений + "</div>"
		+ "</details>";
	КонецЕсли;

	БлокПромежуточныйHTML = "";
	Если НЕ ПустаяСтрока(ПромежуточныйТекст) Тогда
		ТекстПромежуточный = СИ_МаркдаунHTML.ЭкранироватьHTML(ПромежуточныйТекст);
		ТекстПромежуточный = СтрЗаменить(ТекстПромежуточный, Символы.ПС, "<br/>");
		ТекстПромежуточный = СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте(ТекстПромежуточный);
		Если СтрДлина(ТекстПромежуточный) > 600 Тогда
			ТекстПромежуточный = "…" + ОбрезатьHTMLХвост(ТекстПромежуточный, 600);
		КонецЕсли;
		БлокПромежуточныйHTML =
		"<div class=""si-body-sm"" style=""margin-bottom:6px;"">"
			+ ТекстПромежуточный
		+ "</div>";
	КонецЕсли;

	ЗаголовокСообщения = "Ассистент · " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	ЗаголовокHTML = "<span class=""si-role"" data-si-role=""1"">"
		+ РаскраситьТекстГрадиентом(ЗаголовокСообщения, ТемнаяТема) + "</span>";

	Возврат
	"<div class=""si-msg si-msg-bot"">"
		+ "<div class=""si-card si-card-bot si-card-live"">"
			+ "<div class=""si-head"">"
				+ ЗаголовокHTML
			+ "</div>"
			+ "<div>" + ИконкаЧатАгентаHTML()
			+ "&nbsp;<span>Обдумываю</span>"
			+ "<span class=""si-dot si-dot1 siDot1""></span>"
			+ "<span class=""si-dot si-dot2 siDot2""></span>"
			+ "<span class=""si-dot si-dot3 siDot3""></span>"
			+ "</div>"
			+ БлокПромежуточныйHTML
			+ БлокРассужденийHTML
			+ "<div class=""si-tools"">" + СтрокаИнструментовHTML + "</div>"
		+ "</div>"
	+ "</div>";
КонецФункции

// Иконка агента для живого индикатора: общая картинка СИ_РазделЧатАгента
// (БиблиотекаКартинок.СИ_РазделЧатАгента), встроенная в HTML как data-URI
// (base64). Запросов к сети и БД нет - двоичные данные берутся из метаданных
// конфигурации, уже загруженных в память сеанса; Base64 небольшого PNG (2-9 КБ)
// считается на лету, стоимость несопоставима с рендером HTML. Если картинка
// недоступна, возвращается "" - пузырь останется только с текстом и точками.
//
// Возвращаемое значение:
//  Строка - HTML <img> с data-URI либо "".
Функция ИконкаЧатАгентаHTML() Экспорт

	Результат = "";
	Попытка
		ДвоичныеДанные = БиблиотекаКартинок.СИ_РазделЧатАгента.ПолучитьДвоичныеДанные();
		Если ДвоичныеДанные <> Неопределено Тогда
			Результат = "<img src=""data:image/png;base64," + Base64Строка(ДвоичныеДанные) + """"
				+ " width=""16"" height=""16"""
				+ " style=""vertical-align:middle;display:inline-block;"" />";
		КонецЕсли;
	Исключение
		Результат = "";
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Преобразует пользовательские маркеры вложений [Вложение: имя] + file:<UUID>
// в кликабельные ссылки «Скачать файл» (для изображений - с миниатюрой-превью,
// получаемой через СИ_ФайлыДиалога.HTMLПревьюФайла).
// Входной текст - user-сообщение ПОСЛЕ ЭкранироватьHTML и замены переводов строк.
//
// Параметры:
//  Текст - Строка - HTML user-сообщения после экранирования.
//  КэшПревью - Соответствие из Структура, Неопределено - кэш готовых превью формы чата
//   (см. СИ_ФайлыДиалога.ПревьюИзКэша); Неопределено - без кэша.
//
// Возвращаемое значение:
//  Строка - HTML сообщения, в котором маркеры вложений заменены чипами-ссылками
//  (у картинок перед чипом выводится миниатюра).
//
Функция ПреобразоватьВложенияПользователяВHTML(Знач Текст, КэшПревью = Неопределено) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Остаток = Текст;

	Пока Истина Цикл
		Поз = СтрНайти(Остаток, "file:");
		Если Поз = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		Конец = Поз + 5;
		Пока Конец <= СтрДлина(Остаток) Цикл
			Символ = Сред(Остаток, Конец, 1);
			Если Символ = " " ИЛИ Символ = Символы.ПС ИЛИ Символ = "<" ИЛИ Символ = ">" Тогда
				Прервать;
			КонецЕсли;
			Конец = Конец + 1;
		КонецЦикла;
		УИДФайла = Сред(Остаток, Поз + 5, Конец - (Поз + 5));
		Если СтрНачинаетсяС(УИДФайла, "//") Тогда
			УИДФайла = Сред(УИДФайла, 3);
		КонецЕсли;

		Если СтрДлина(УИДФайла) < 8 Тогда
			Результат = Результат + Лев(Остаток, Поз + 4);
			Остаток = Сред(Остаток, Поз + 5);
			Продолжить;
		КонецЕсли;

		Префикс = Лев(Остаток, Поз - 1);
		ПозЗакрывающей = СтрНайти(Префикс, "]", НаправлениеПоиска.СКонца);

		Если ПозЗакрывающей = 0 Тогда
			Результат = Результат + Лев(Остаток, Поз + 4);
			Остаток = Сред(Остаток, Поз + 5);
			Продолжить;
		КонецЕсли;

		ПозОткрывающей = СтрНайти(Лев(Префикс, ПозЗакрывающей - 1), "[", НаправлениеПоиска.СКонца);

		Если ПозОткрывающей = 0 Тогда
			Результат = Результат + Лев(Остаток, Поз + 4);
			Остаток = Сред(Остаток, Поз + 5);
			Продолжить;
		КонецЕсли;

		ТекстВложения = Сред(Префикс, ПозОткрывающей + 1, ПозЗакрывающей - ПозОткрывающей - 1);

		Замена = "";
		ПревьюHTML = СИ_ФайлыДиалога.HTMLПревьюФайла(УИДФайла, КэшПревью);
		Если НЕ ПустаяСтрока(ПревьюHTML) Тогда
			Замена = Замена + ПревьюHTML + "<br/>";
		КонецЕсли;

		Замена = Замена
			+ "<a href=""file:" + СИ_МаркдаунHTML.ЭкранироватьАтрибут(УИДФайла) + """"
			+ " title=""Скачать файл"""
			+ " class=""si-chip"">"
			+ ТекстВложения + "</a>";

		Результат = Результат + Лев(Префикс, ПозОткрывающей - 1) + Замена;
		Остаток = Сред(Остаток, Конец);
	КонецЦикла;

	Возврат Результат;

КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Внешние адреса в ссылках SVG-разметки (href/xlink:href): проверка для
// БезопасныйSVG. Внутренние ссылки на элементы самой схемы ("#id", на них
// держатся градиенты и фильтры) внешними не считаются, а любой другой адрес
// считается внешним и разметку отклоняет.
//
// "href" ищется именно как АТРИБУТ: имя должно начинаться с границы имени
// (пробел, "<" либо ":" у xlink:href) и продолжаться знаком "=" (возможно,
// через пробелы). Иначе слово href в тексте схемы или в середине чужого имени
// давало бы ложное срабатывание, а поиск "=" по всей строке - ложное
// срабатывание на следующем атрибуте тега.
//
// Параметры:
//  ТекстНРег - Строка - разметка в нижнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если найдена ссылка на внешний адрес.
Функция ЕстьВнешняяСсылкаВSVG(Знач ТекстНРег)

	ДлинаТекста = СтрДлина(ТекстНРег);
	ПозицияПоиска = 1;
	Пока Истина Цикл
		Позиция = СтрНайти(ТекстНРег, "href", НаправлениеПоиска.СНачала, ПозицияПоиска);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияПоиска = Позиция + 4;

		Если Позиция > 1 Тогда
			СимволПеред = Сред(ТекстНРег, Позиция - 1, 1);
			Если НЕ (СимволПеред = " " ИЛИ СимволПеред = Символы.Таб ИЛИ СимволПеред = Символы.ПС
				ИЛИ СимволПеред = Символы.ВК ИЛИ СимволПеред = "<" ИЛИ СимволПеред = ":") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ПозицияПроверки = Позиция + 4;
		СимволПослеИмени = "";
		Пока ПозицияПроверки <= ДлинаТекста Цикл
			СимволПослеИмени = Сред(ТекстНРег, ПозицияПроверки, 1);
			Если СимволПослеИмени <> " " И СимволПослеИмени <> Символы.Таб Тогда
				Прервать;
			КонецЕсли;
			ПозицияПроверки = ПозицияПроверки + 1;
		КонецЦикла;
		Если СимволПослеИмени <> "=" Тогда
			Продолжить;
		КонецЕсли;

		Значение = ЗначениеАтрибутаSVG(Сред(ТекстНРег, ПозицияПроверки + 1));
		Если НЕ ПустаяСтрока(Значение) И НЕ СтрНачинаетсяС(Значение, "#") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Значение атрибута SVG, начинающегося с позиции после «=»: в кавычках или без
// них (до пробела или «>»).
//
// Параметры:
//  Хвост - Строка - часть разметки после знака «=».
//
// Возвращаемое значение:
//  Строка - значение атрибута.
Функция ЗначениеАтрибутаSVG(Знач Хвост)

	Хвост = СокрЛ(Хвост);
	ПервыйСимвол = Лев(Хвост, 1);
	Если ПервыйСимвол = """" ИЛИ ПервыйСимвол = "'" Тогда
		Остаток = Сред(Хвост, 2);
		ПозицияКавычки = СтрНайти(Остаток, ПервыйСимвол);
		Если ПозицияКавычки > 0 Тогда
			Возврат Лев(Остаток, ПозицияКавычки - 1);
		КонецЕсли;
		Возврат Остаток;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Позиция, 1);
		Если Символ = " " ИЛИ Символ = ">" ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.Таб Тогда
			Возврат Лев(Хвост, Позиция - 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Хвост;

КонецФункции

// Inline-обработчики событий (onclick=, onload= и подобные) в разметке:
// проверка для БезопасныйSVG. Ищется шаблон « on» + имя из латинских букв и
// цифр + «=», поэтому список конкретных событий перечислять не нужно.
//
// Параметры:
//  ТекстНРег - Строка - разметка в нижнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если найден inline-обработчик события.
Функция ЕстьInlineОбработчикСобытия(Знач ТекстНРег)

	ДлинаТекста = СтрДлина(ТекстНРег);
	ПозицияПоиска = 1;
	Пока ПозицияПоиска <= ДлинаТекста Цикл
		Позиция = СтрНайти(ТекстНРег, " on", НаправлениеПоиска.СНачала, ПозицияПоиска);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияПоиска = Позиция + 3;

		ИмяОбработчика = "";
		ЭтоОбработчик = Ложь;
		Для Смещение = Позиция + 3 По Мин(ДлинаТекста, Позиция + 20) Цикл
			Символ = Сред(ТекстНРег, Смещение, 1);
			Если Символ = "=" Тогда
				ЭтоОбработчик = Истина;
				Прервать;
			ИначеЕсли Символ = " " ИЛИ Символ = ">" ИЛИ Символ = "/" ИЛИ Символ = Символы.ПС Тогда
				Прервать;
			Иначе
				ИмяОбработчика = ИмяОбработчика + Символ;
			КонецЕсли;
		КонецЦикла;

		Если ЭтоОбработчик И (ПустаяСтрока(ИмяОбработчика) ИЛИ ЭтоЛатинскиеБуквыИЦифры(ИмяОбработчика)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Состоит ли строка только из латинских букв и цифр (проверка имени
// inline-обработчика; вход уже в нижнем регистре).
//
// Параметры:
//  Строка - Строка - проверяемое имя.
//
// Возвращаемое значение:
//  Булево - Истина, если других символов в строке нет.
Функция ЭтоЛатинскиеБуквыИЦифры(Знач Строка)

	КодA = КодСимвола("a");
	КодZ = КодСимвола("z");
	КодНоль = КодСимвола("0");
	КодДевять = КодСимвола("9");

	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Код = КодСимвола(Сред(Строка, Позиция, 1));
		Если НЕ ((Код >= КодA И Код <= КодZ) ИЛИ (Код >= КодНоль И Код <= КодДевять)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Убирает HTML-теги из строки: «<span style="display:none">[Вопрос: ...]</span>»
// превращается в «[Вопрос: ...]». Применяется при разборе маркерного блока вопроса:
// модель может обернуть служебные строки в HTML, и теги не должны ни ломать
// распознавание маркеров, ни попадать в текст ответа пользователю.
//
// Началом тега считается только «<», за которым идёт буква (имя тега), «/»
// (закрывающий тег) или «!» (комментарий): сравнения вида «5 < 10 шт.» тегом не
// считаются. Если закрывающего «>» в строке нет вовсе, строка возвращается как
// есть - обычный текст не теряется.
//
// Параметры:
//  Строка - Строка - исходная строка.
//
// Возвращаемое значение:
//  Строка - строка без фрагментов вида <...>.
Функция УбратьHTMLТегиИзСтроки(Знач Строка)

	Если СтрНайти(Строка, ">") = 0 Тогда
		Возврат Строка;
	КонецЕсли;

	Результат = "";
	ВнутриТега = Ложь;
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		СимволСтроки = Сред(Строка, Индекс, 1);
		Если ВнутриТега Тогда
			Если СимволСтроки = ">" Тогда
				ВнутриТега = Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если СимволСтроки = "<" И ЭтоНачалоТегаHTML(Строка, Индекс) Тогда
			ВнутриТега = Истина;
			Продолжить;
		КонецЕсли;
		Результат = Результат + СимволСтроки;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Признак начала HTML-тега в позиции: сразу после «<» идёт буква, «/» или «!».
//
// Параметры:
//  Строка - Строка - проверяемая строка.
//  Позиция - Число - позиция символа «<».
//
// Возвращаемое значение:
//  Булево - Истина, если с этой позиции начинается тег.
Функция ЭтоНачалоТегаHTML(Строка, Позиция)

	СледующийСимвол = Сред(Строка, Позиция + 1, 1);
	Если ПустаяСтрока(СледующийСимвол) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СледующийСимвол = "/" ИЛИ СледующийСимвол = "!" Тогда
		Возврат Истина;
	КонецЕсли;
	КодСимволаСтроки = КодСимвола(СледующийСимвол);
	Возврат (КодСимволаСтроки >= 65 И КодСимволаСтроки <= 90)
		ИЛИ (КодСимволаСтроки >= 97 И КодСимволаСтроки <= 122)
		ИЛИ (КодСимволаСтроки >= 1040 И КодСимволаСтроки <= 1103);

КонецФункции

// Начало блока карточки запроса разрешения в документе чата. Единственное место,
// где эта разметка задана: её используют генератор карточки
// (ПолучитьБлокРазрешенияHTML) и замена блока в строке документа
// (ЗаменитьБлокРазрешенияHTML).
//
// Возвращаемое значение:
//  Строка - открывающий тег карточки с признаком data-si-perm.
Функция МаркерНачалаБлокаРазрешения()

	Возврат "<div data-si-perm=""1""";

КонецФункции

// Конец блока карточки запроса разрешения в документе чата: HTML-комментарий
// сразу после закрывающего div. По нему замена находит границу карточки и не
// задевает блоки, оказавшиеся после неё.
//
// Возвращаемое значение:
//  Строка - маркер конца карточки.
Функция МаркерКонцаБлокаРазрешения()

	Возврат "<!--/si-perm-->";

КонецФункции

// Карточка «Все вызовы подтверждены» с кнопкой «Продолжить» (perm:resume:).
// Показывается, когда решения приняты по всем вызовам, но возобновление не
// запущено (сбой запуска или переоткрытие формы).
//
// Возвращаемое значение:
//  Строка - HTML карточки продолжения.
Функция ПолучитьКарточкуПродолженияHTML()

	Возврат
	МаркерНачалаБлокаРазрешения() + " class=""si-panel"">"
		+ "<div class=""si-panel-title"">Все вызовы подтверждены</div>"
		+ "<div class=""si-perm-hint"">Агент готов продолжить работу.</div>"
		+ "<a href=""perm:resume:"" title=""Запустить продолжение захода"""
		+ " class=""chatbtnopt si-btn-perm"">Продолжить</a>"
	+ "</div>" + МаркерКонцаБлокаРазрешения();

КонецФункции

// Палитра оформления чата: все цвета обеих тем в одном месте.
//
// Значения подставляются в CSS функцией ПолучитьСтилиТемыCSS; состав ключей
