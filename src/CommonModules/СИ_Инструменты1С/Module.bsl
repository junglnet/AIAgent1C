// Находит регистр по одному критерию (обёртка над общим проходом).
//
// Параметры:
//  Критерий - Структура - критерий (см. КритерийПоискаРегистраСводки).
//
// Возвращаемое значение:
//  Структура,Неопределено - описание регистра (см. ОписаниеРегистраСводки).
Функция НайтиРегистрСводкиПоКритерию(Критерий)

	Критерии = Новый Массив;
	Критерии.Добавить(Критерий);

	Возврат НайтиРегистрыСводок(Критерии).Получить(Критерий.Ключ);

КонецФункции

// Ищет регистры по нескольким критериям за один проход по метаданным
// регистров накопления. Для каждого критерия выбирается регистр с наибольшим
// счётом совпадений.
//
// Параметры:
//  Критерии - Массив из Структура - критерии (см. КритерийПоискаРегистраСводки).
//
// Возвращаемое значение:
//  Соответствие - ключ критерия -> описание регистра (см. ОписаниеРегистраСводки)
//    либо Неопределено.
Функция НайтиРегистрыСводок(Критерии)

	Для Каждого МетаданныеРегистра Из Метаданные.РегистрыНакопления Цикл

		ВидРегистра = СвойствоМетаданных(МетаданныеРегистра, "ВидРегистра");
		Ресурсы = ИменаКоллекции(МетаданныеРегистра.Ресурсы);
		Измерения = ИменаКоллекции(МетаданныеРегистра.Измерения);

		Для Каждого Критерий Из Критерии Цикл
			Если НЕ ВидРегистраПодходит(ВидРегистра, Критерий.ТребуемыйВид) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ СовпадаетПоПризнакам(МетаданныеРегистра.Имя, МетаданныеРегистра.Синоним,
				Критерий.ПризнакиИмени) Тогда
				Продолжить;
			КонецЕсли;

			СчетРесурсов = КоличествоСовпадений(Ресурсы, Критерий.ПризнакиРесурсов);
			Если СчетРесурсов = 0 Тогда
				Продолжить;
			КонецЕсли;

			Счет = 4 + 2 * СчетРесурсов
				+ КоличествоСовпадений(Измерения, Критерий.ПризнакиИзмерений);
			Если Счет > Критерий.ЛучшийСчет Тогда
				Критерий.ЛучшийСчет = Счет;
				Критерий.Лучший = ОписаниеРегистраСводки(МетаданныеРегистра, Ресурсы, Измерения);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого Критерий Из Критерии Цикл
		Результат.Вставить(Критерий.Ключ, Критерий.Лучший);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подходит ли вид регистра накопления критерию.
//
// Параметры:
//  ВидРегистра - ВидРегистраНакопления - вид регистра.
//  ТребуемыйВид - Строка - "Остатки" | "Обороты" | "" (любой).
//
// Возвращаемое значение:
//  Булево - Истина, если вид подходит.
Функция ВидРегистраПодходит(ВидРегистра, ТребуемыйВид)

	Если ПустаяСтрока(ТребуемыйВид) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТребуемыйВид = "Остатки" Тогда
		Возврат ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
	ИначеЕсли ТребуемыйВид = "Обороты" Тогда
		Возврат ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Описание найденного регистра для построения запросов.
//
// Параметры:
//  МетаданныеРегистра - ОбъектМетаданных - регистр накопления.
//  Ресурсы - Массив из Строка - имена ресурсов.
//  Измерения - Массив из Строка - имена измерений.
//
// Возвращаемое значение:
//  Структура:
//    * Имя - Строка;
//    * Таблица - Строка - "РегистрНакопления.X";
//    * Ресурсы - Массив из Строка;
//    * Измерения - Массив из Строка;
//    * Реквизиты - Массив из Строка;
//    * Периодический - Булево.
Функция ОписаниеРегистраСводки(МетаданныеРегистра, Ресурсы, Измерения)

	Реквизиты = ИменаКоллекции(СвойствоМетаданных(МетаданныеРегистра, "Реквизиты"));

	Описание = Новый Структура;
	Описание.Вставить("Имя", МетаданныеРегистра.Имя);
	Описание.Вставить("Таблица", "РегистрНакопления." + МетаданныеРегистра.Имя);
	Описание.Вставить("Ресурсы", Ресурсы);
	Описание.Вставить("Измерения", Измерения);
	Описание.Вставить("Реквизиты", Реквизиты);
	Описание.Вставить("Периодический", РегистрПериодический(МетаданныеРегистра));

	Возврат Описание;

КонецФункции

// Определяет, периодический ли регистр накопления (есть ли поле Период).
//
// Параметры:
//  МетаданныеРегистра - ОбъектМетаданных - регистр накопления.
//
// Возвращаемое значение:
//  Булево - Истина, если периодичность задана.
Функция РегистрПериодический(МетаданныеРегистра)

	Периодичность = СвойствоМетаданных(МетаданныеРегистра, "Периодичность");
	Если Периодичность = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Строка(Периодичность) <> "Непериодический";

КонецФункции

// Имена элементов коллекции метаданных.
//
// Параметры:
//  Коллекция - КоллекцияМетаданных,Неопределено - коллекция ресурсов/измерений.
//
// Возвращаемое значение:
//  Массив из Строка - имена.
Функция ИменаКоллекции(Коллекция)

	Имена = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Имена;
	КонецЕсли;

	Попытка
		Для Каждого Элемент Из Коллекция Цикл
			Имена.Добавить(Элемент.Имя);
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Имена;

КонецФункции

// Значение свойства метаданных по имени; отсутствие свойства - Неопределено.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - объект метаданных.
//  ИмяСвойства - Строка - имя свойства.
//
// Возвращаемое значение:
//  Произвольный,Неопределено - значение свойства.
Функция СвойствоМетаданных(МетаданныеОбъекта, ИмяСвойства)

	Попытка
		Возврат МетаданныеОбъекта[ИмяСвойства];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Совпадает ли имя/синоним с одним из признаков (подстрока, регистр не важен).
//
// Параметры:
//  Имя - Строка - имя объекта.
//  Синоним - Произвольный - синоним (ЛокализованнаяСтрока).
//  Признаки - Строка - признаки через запятую.
//
// Возвращаемое значение:
//  Булево - Истина при совпадении.
Функция СовпадаетПоПризнакам(Имя, Синоним, Признаки)

	Возврат СовпадаетСПризнаками(Строка(Имя), Признаки)
		ИЛИ СовпадаетСПризнаками(Строка(Синоним), Признаки);

КонецФункции

// Совпадает ли строка с одним из признаков.
//
// Параметры:
//  Текст - Строка - проверяемый текст.
//  Признаки - Строка - признаки через запятую.
//
// Возвращаемое значение:
//  Булево - Истина при совпадении.
Функция СовпадаетСПризнаками(Текст, Признаки)

	ТекстНРег = НРег(Строка(Текст));
	Для Каждого Признак Из СтрРазделить(Признаки, ",", Ложь) Цикл
		ПризнакНРег = НРег(СокрЛП(Признак));
		Если НЕ ПустаяСтрока(ПризнакНРег) И СтрНайти(ТекстНРег, ПризнакНРег) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Сколько имен коллекции совпало с признаками.
//
// Параметры:
//  Имена - Массив из Строка - имена.
//  Признаки - Строка - признаки через запятую.
//
// Возвращаемое значение:
//  Число - количество совпадений.
Функция КоличествоСовпадений(Имена, Признаки)

	Счет = 0;
	Для Каждого Имя Из Имена Цикл
		Если СовпадаетСПризнаками(Имя, Признаки) Тогда
			Счет = Счет + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счет;

КонецФункции

// Первое имя коллекции, совпавшее с признаками.
//
// Параметры:
//  Имена - Массив из Строка - имена.
//  Признаки - Строка - признаки через запятую.
//
// Возвращаемое значение:
//  Строка - имя; пустая строка, если совпадений нет.
Функция НайтиПолеПоПризнакам(Имена, Признаки)

	Для Каждого Имя Из Имена Цикл
		Если СовпадаетСПризнаками(Имя, Признаки) Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Измерение контрагента (клиента, партнёра) в списке измерений.
//
// Параметры:
//  Имена - Массив из Строка - имена измерений.
//
// Возвращаемое значение:
//  Строка - имя измерения; пустая строка, если не найдено.
Функция НайтиПолеПоИзмерениямКонтрагента(Имена)

	Возврат НайтиПолеПоПризнакам(Имена, "контрагент,партнер,клиент,покупатель,поставщик,дебитор");

КонецФункции

// Находит справочник по признакам имени/синонима (запрещённые объекты
// пропускаются: подсказка не должна ссылаться на недоступные таблицы).
//
// Параметры:
//  Признаки - Строка - признаки через запятую.
//
// Возвращаемое значение:
//  Строка - имя справочника; пустая строка, если не найден.
Функция НайтиСправочникПоПризнакам(Признаки)

	Для Каждого МетаданныеСправочника Из Метаданные.Справочники Цикл
		Если СовпадаетПоПризнакам(МетаданныеСправочника.Имя, МетаданныеСправочника.Синоним, Признаки) Тогда
			Возврат МетаданныеСправочника.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Период сводки из аргументов. Оба конца не заданы - текущий месяц.
//
// Параметры:
//  Аргументы - Структура/Соответствие - аргументы вызова.
//
// Возвращаемое значение:
//  Структура - {Начало: Дата, Конец: Дата, Подпись: Строка}.
Функция ПериодСводки(Аргументы)

	Начало = ДатаИзАргументов(Аргументы, "НачалоПериода");
	Конец = ДатаИзАргументов(Аргументы, "КонецПериода");

	Если Начало = Неопределено И Конец = Неопределено Тогда
		Начало = НачалоМесяца(ТекущаяДатаСеанса());
		Конец = КонецДня(КонецМесяца(Начало));
	ИначеЕсли Начало = Неопределено Тогда
		Начало = НачалоМесяца(Конец);
		Конец = КонецДня(Конец);
	ИначеЕсли Конец = Неопределено Тогда
		Конец = КонецДня(ТекущаяДатаСеанса());
	Иначе
		Конец = КонецДня(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Начало", Начало);
	Результат.Вставить("Конец", Конец);
	Результат.Вставить("Подпись", Формат(Начало, "ДЛФ=D") + " - " + Формат(Конец, "ДЛФ=D"));
	Возврат Результат;

КонецФункции

// Дата из строкового аргумента (ISO или обычная дата 1С).
//
// Параметры:
//  Аргументы - Структура/Соответствие - аргументы вызова.
//  Имя - Строка - имя аргумента.
//
// Возвращаемое значение:
//  Дата,Неопределено - дата или Неопределено, если аргумент пуст/некорректен.
Функция ДатаИзАргументов(Аргументы, Имя)

	Значение = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, Имя, "");
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст);
	Исключение
		Попытка
			Возврат Дата(Текст);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;

КонецФункции

// Условие периода для регистра: по полю Период у периодических, иначе пусто.
//
// Параметры:
//  Регистр - Структура - описание регистра.
//  Префикс - Строка - псевдоним таблицы ("Т").
//
// Возвращаемое значение:
//  Строка - условие ГДЕ без слова ГДЕ либо пустая строка.
Функция УсловиеПериодаРегистра(Регистр, Префикс)

	Если НЕ Регистр.Периодический Тогда
		Возврат "";
	КонецЕсли;

	Возврат Префикс + ".Период МЕЖДУ &НачалоПериода И &КонецПериода";

КонецФункции

// Сборка текста запроса: SELECT ... FROM <таблица> КАК Т [ГДЕ условие].
//
// Параметры:
//  Регистр - Структура - описание регистра.
//  Выборка - Строка - текст списка полей.
//  УсловиеПериода - Строка - условие периода (пусто - без отбора).
//
// Возвращаемое значение:
//  Строка - текст запроса.
Функция ТекстЗапросаРегистра(Регистр, Выборка, УсловиеПериода)

	Текст = "ВЫБРАТЬ" + Символы.ПС + Выборка
		+ Символы.ПС + "ИЗ" + Символы.ПС + Регистр.Таблица + " КАК Т";
	Если НЕ ПустаяСтрока(УсловиеПериода) Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + УсловиеПериода;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Выполняет внутренний запрос сводки (лимит строк <= 100).
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса.
//  Параметры - Соответствие,Неопределено - параметры.
//  ЛимитСтрок - Число - лимит (по умолчанию 100).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево;
//    * Строки - Массив из Соответствие;
//    * ЕстьЕщеДанные - Булево;
//    * Ошибка - Строка,Неопределено.
Функция ВыполнитьЗапросСводки(ТекстЗапроса, Параметры = Неопределено, ЛимитСтрок = 100)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("ЕстьЕщеДанные", Ложь);
	Результат.Вставить("Ошибка", Неопределено);

	Аргументы = Новый Структура;
	Аргументы.Вставить("ТекстЗапроса", ТекстЗапроса);
	Аргументы.Вставить("Параметры", Параметры);
	Аргументы.Вставить("ЛимитСтрок", Мин(ЛимитСтрок, 100));

	Ответ = ВыполнитьЗапрос(Аргументы);
	Результат.Успех = СИ_РаботаСJSON.БезопасноПолучить(Ответ, "Успех", Ложь);
	Если НЕ Результат.Успех Тогда
		Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(Ответ, "Ошибка", "ошибка запроса");
		Возврат Результат;
	КонецЕсли;

	Значение = СИ_РаботаСJSON.БезопасноПолучить(Ответ, "Значение", Неопределено);
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Строки = СИ_РаботаСJSON.БезопасноПолучить(Значение, "Строки", Неопределено);
		Если ТипЗнч(Строки) = Тип("Массив") Тогда
			Результат.Строки = Строки;
		КонецЕсли;
		Результат.ЕстьЕщеДанные = СИ_РаботаСJSON.БезопасноПолучить(Значение, "ЕстьЕщеДанные", Ложь);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Агрегат продаж за период: выручка, себестоимость, количество, число продаж.
//
// Параметры:
//  Регистр - Структура - описание регистра.
//  РесурсВыручки - Строка - ресурс выручки.
//  РесурсСебестоимости - Строка - ресурс себестоимости (пусто - нет).
//  РесурсКоличества - Строка - ресурс количества (пусто - нет).
//  Начало - Дата - начало периода.
//  Конец - Дата - конец периода.
//
// Возвращаемое значение:
//  Структура - {Успех, Строка: Соответствие, Ошибка}.
Функция СводкаПродажЗаПериод(Регистр, РесурсВыручки, РесурсСебестоимости, РесурсКоличества, Начало, Конец)

	Выборка = "СУММА(Т." + РесурсВыручки + ") КАК Выручка";
	Если НЕ ПустаяСтрока(РесурсСебестоимости) Тогда
		Выборка = Выборка + "," + Символы.ПС + "СУММА(Т." + РесурсСебестоимости + ") КАК Себестоимость";
	КонецЕсли;
	Если НЕ ПустаяСтрока(РесурсКоличества) Тогда
		Выборка = Выборка + "," + Символы.ПС + "СУММА(Т." + РесурсКоличества + ") КАК Количество";
	КонецЕсли;
	Выборка = Выборка + "," + Символы.ПС + "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Регистратор) КАК Продаж";

	Условие = УсловиеПериодаРегистра(Регистр, "Т");
	Текст = ТекстЗапросаРегистра(Регистр, Выборка, Условие);

	Параметры = Новый Соответствие;
	Если НЕ ПустаяСтрока(Условие) Тогда
		Параметры.Вставить("НачалоПериода", Начало);
		Параметры.Вставить("КонецПериода", Конец);
	КонецЕсли;

	Запрос = ВыполнитьЗапросСводки(Текст, Параметры, 1);
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Строка", Неопределено);
	Результат.Вставить("Ошибка", Запрос.Ошибка);

	Если Запрос.Успех И Запрос.Строки.Количество() > 0 Тогда
		Результат.Строка = Запрос.Строки[0];
		Результат.Успех = Истина;
	ИначеЕсли Запрос.Успех Тогда
		Результат.Ошибка = "запрос не вернул строк";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выручка за произвольный период (для сравнений).
//
// Параметры:
//  Регистр - Структура - описание регистра.
//  РесурсВыручки - Строка - ресурс выручки.
//  Начало - Дата - начало периода.
//  Конец - Дата - конец периода.
//
// Возвращаемое значение:
//  Структура - {Успех, Значение: Число, Ошибка}.
Функция СводкаВыручкиРегистра(Регистр, РесурсВыручки, Начало, Конец)

	Запрос = СводкаПродажЗаПериод(Регистр, РесурсВыручки, "", "", Начало, Конец);
	Результат = Новый Структура;
	Результат.Вставить("Успех", Запрос.Успех);
	Результат.Вставить("Значение", 0);
	Результат.Вставить("Ошибка", Запрос.Ошибка);

	Если Запрос.Успех Тогда
		Результат.Значение = ЧислоИзСтроки(Запрос.Строка, "Выручка");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Топ значений по измерению за период.
//
// Параметры:
//  Регистр - Структура - описание регистра.
//  Измерение - Строка - имя измерения.
//  Ресурс - Строка - ресурс суммы.
//  Период - Структура - {Начало, Конец}.
//  Максимум - Число - сколько строк вернуть.
//
// Возвращаемое значение:
//  Массив из Соответствие - строки {Наименование, Значение}.
Функция ТопПоИзмерению(Регистр, Измерение, Ресурс, Период, Максимум)

	Выборка = "Т." + Измерение + " КАК Наименование," + Символы.ПС
		+ "СУММА(Т." + Ресурс + ") КАК Значение";
	Условие = УсловиеПериодаРегистра(Регистр, "Т");
	Текст = ТекстЗапросаРегистра(Регистр, Выборка, Условие)
		+ Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + "Т." + Измерение
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "Значение УБЫВ";

	Параметры = Новый Соответствие;
	Если НЕ ПустаяСтрока(Условие) Тогда
		Параметры.Вставить("НачалоПериода", Период.Начало);
		Параметры.Вставить("КонецПериода", Период.Конец);
	КонецЕсли;

	Запрос = ВыполнитьЗапросСводки(Текст, Параметры, Максимум);
	Если НЕ Запрос.Успех Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Запрос.Строки;

КонецФункции

// Добавляет строки топа в общий массив детализации.
//
// Параметры:
//  Строки - Массив из Структура - результат (дополняется).
//  Топ - Массив из Соответствие - строки {Наименование, Значение}.
//  Группа - Строка - название группы.
Процедура ДобавитьСтрокиТопа(Строки, Топ, Группа)

	Для Каждого СтрокаТопа Из Топ Цикл
		Если Строки.Количество() >= 20 Тогда
			Прервать;
		КонецЕсли;
		Значение = Новый Структура;
		Значение.Вставить("Группа", Группа);
		Значение.Вставить("Наименование", СИ_РаботаСJSON.БезопасноПолучить(СтрокаТопа, "Наименование", ""));
		Значение.Вставить("Значение", СИ_РаботаСJSON.БезопасноПолучить(СтрокаТопа, "Значение", 0));
		Значение.Вставить("Дополнительно", "");
		Значение.Вставить("Пояснение", "");
		Строки.Добавить(Значение);
	КонецЦикла;

КонецПроцедуры

// Дата последней продажи (по полю Период периодического регистра) в виде
// строки, уже подготовленной сериализацией результата запроса.
//
// Параметры:
//  Регистр - Структура - описание регистра.
//
// Возвращаемое значение:
//  Строка - дата последней записи ("dd.MM.yyyy HH:mm:ss"); пустая строка,
//  если дату определить нельзя.
Функция ДатаПоследнейПродажи(Регистр)

	Если НЕ Регистр.Периодический Тогда
		Возврат "";
	КонецЕсли;

	Текст = "ВЫБРАТЬ" + Символы.ПС + "МАКСИМУМ(Т.Период) КАК Дата"
		+ Символы.ПС + "ИЗ" + Символы.ПС + Регистр.Таблица + " КАК Т";
	Запрос = ВыполнитьЗапросСводки(Текст, Неопределено, 1);
	Если НЕ Запрос.Успех ИЛИ Запрос.Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ТекстДаты = Строка(СИ_РаботаСJSON.БезопасноПолучить(Запрос.Строки[0], "Дата", ""));
	Если ПустаяСтрока(ТекстДаты) ИЛИ ВРег(ТекстДаты) = "NULL" Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекстДаты;

КонецФункции

// Остаток по ресурсу регистра на дату (виртуальная таблица Остатки).
//
// Параметры:
//  Регистр - Структура - описание регистра.
//  Ресурс - Строка - имя ресурса.
//  ДатаОстатков - Дата - дата остатков.
//
// Возвращаемое значение:
//  Структура - {Успех, Значение: Число, Ошибка}.
Функция ОстатокРегистра(Регистр, Ресурс, ДатаОстатков)

	Текст = "ВЫБРАТЬ" + Символы.ПС
		+ "СУММА(Т." + Ресурс + "Остаток) КАК Значение"
		+ Символы.ПС + "ИЗ" + Символы.ПС + Регистр.Таблица + ".Остатки(&ДатаОстатков) КАК Т";

	Параметры = Новый Соответствие;
	Параметры.Вставить("ДатаОстатков", ДатаОстатков);

	Запрос = ВыполнитьЗапросСводки(Текст, Параметры, 1);
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", 0);
	Результат.Вставить("Ошибка", Запрос.Ошибка);

	Если Запрос.Успех И Запрос.Строки.Количество() > 0 Тогда
		Результат.Значение = ЧислоИзСтроки(Запрос.Строки[0], "Значение");
		Результат.Успех = Истина;
	ИначеЕсли Запрос.Успех Тогда
		Результат.Успех = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Поступления и списания денег за период: движения ресурса суммы,
// разделённые по виду движения (Приход/Расход). Ресурс в регистре остатков
// обычно положительный, поэтому деление по знаку ресурса неверно.
//
// Параметры:
//  Регистр - Структура - описание регистра.
//  Ресурс - Строка - ресурс суммы.
//  Начало - Дата - начало периода.
//  Конец - Дата - конец периода.
//
// Возвращаемое значение:
//  Структура - {Успех, Поступления, Списания, Ошибка}.
Функция ОборотыРегистраДенег(Регистр, Ресурс, Начало, Конец)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Поступления", 0);
	Результат.Вставить("Списания", 0);
	Результат.Вставить("Ошибка", Неопределено);

	Если НЕ Регистр.Периодический Тогда
		Результат.Ошибка = "Регистр " + Регистр.Таблица
			+ " непериодический: обороты за период не рассчитываются.";
		Возврат Результат;
	КонецЕсли;

	Выборка = "СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА Т."
		+ Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Поступления," + Символы.ПС
		+ "СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) ТОГДА Т."
		+ Ресурс + " ИНАЧЕ 0 КОНЕЦ) КАК Списания";
	Условие = УсловиеПериодаРегистра(Регистр, "Т");
	Текст = ТекстЗапросаРегистра(Регистр, Выборка, Условие);

	Параметры = Новый Соответствие;
	Если НЕ ПустаяСтрока(Условие) Тогда
		Параметры.Вставить("НачалоПериода", Начало);
		Параметры.Вставить("КонецПериода", Конец);
	КонецЕсли;

	Запрос = ВыполнитьЗапросСводки(Текст, Параметры, 1);
	Результат.Ошибка = Запрос.Ошибка;

	Если Запрос.Успех И Запрос.Строки.Количество() > 0 Тогда
		Результат.Поступления = ЧислоИзСтроки(Запрос.Строки[0], "Поступления");
		Результат.Списания = ЧислоИзСтроки(Запрос.Строки[0], "Списания");
		Результат.Успех = Истина;
	ИначеЕсли Запрос.Успех Тогда
		Результат.Успех = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сальдо по контрагентам на дату: дебиторка, кредиторка, топ должников.
//
// Параметры:
//  Регистр - Структура - описание регистра расчётов.
//  Ресурс - Строка - ресурс суммы.
//  ИзмерениеКонтрагента - Строка - измерение контрагента.
//  ДатаОстатков - Дата - дата остатков.
//
// Возвращаемое значение:
//  Структура - {Успех, Дебиторка, Кредиторка, ТопДолжников, Ошибка}.
Функция СальдоПоКонтрагентам(Регистр, Ресурс, ИзмерениеКонтрагента, ДатаОстатков)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Дебиторка", 0);
	Результат.Вставить("Кредиторка", 0);
	Результат.Вставить("ТопДолжников", Новый Массив);
	Результат.Вставить("Ошибка", Неопределено);

	Если ПустаяСтрока(ИзмерениеКонтрагента) Тогда
		Результат.Ошибка = "в регистре " + Регистр.Таблица + " нет измерения контрагента";
		Возврат Результат;
	КонецЕсли;

	Текст = "ВЫБРАТЬ" + Символы.ПС
		+ "Т." + ИзмерениеКонтрагента + " КАК Наименование," + Символы.ПС
		+ "СУММА(Т." + Ресурс + "Остаток) КАК Значение"
		+ Символы.ПС + "ИЗ" + Символы.ПС + Регистр.Таблица + ".Остатки(&ДатаОстатков) КАК Т"
		+ Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + "Т." + ИзмерениеКонтрагента
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "Значение УБЫВ";

	Параметры = Новый Соответствие;
	Параметры.Вставить("ДатаОстатков", ДатаОстатков);

	Запрос = ВыполнитьЗапросСводки(Текст, Параметры, 100);
	Если НЕ Запрос.Успех Тогда
		Результат.Ошибка = Запрос.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаДолга Из Запрос.Строки Цикл
		Сумма = ЧислоИзСтроки(СтрокаДолга, "Значение");
		Если Сумма > 0 Тогда
			Результат.Дебиторка = Результат.Дебиторка + Сумма;
			Если Результат.ТопДолжников.Количество() < 5 Тогда
				Результат.ТопДолжников.Добавить(СтрокаДолга);
			КонецЕсли;
		ИначеЕсли Сумма < 0 Тогда
			Результат.Кредиторка = Результат.Кредиторка - Сумма;
		КонецЕсли;
	КонецЦикла;

	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Остатки товаров на дату: итоги и строки по номенклатуре.
//
// Параметры:
//  Регистр - Структура - описание регистра остатков.
//  Измерение - Строка - измерение номенклатуры.
//  РесурсКоличества - Строка - ресурс количества.
//  РесурсСтоимости - Строка - ресурс стоимости (пусто - нет).
//  ДатаОстатков - Дата - дата остатков.
//
// Возвращаемое значение:
//  Структура - {Успех, Стоимость, Позиций, Минусовых, БезНаличия, Строки, Ошибка}.
Функция ОстаткиТоваров(Регистр, Измерение, РесурсКоличества, РесурсСтоимости, ДатаОстатков)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Стоимость", 0);
	Результат.Вставить("Позиций", 0);
	Результат.Вставить("Минусовых", 0);
	Результат.Вставить("БезНаличия", 0);
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("Ошибка", Неопределено);

	Выборка = "Т." + Измерение + " КАК Наименование," + Символы.ПС
		+ "СУММА(Т." + РесурсКоличества + "Остаток) КАК Количество";
	Если НЕ ПустаяСтрока(РесурсСтоимости) Тогда
		Выборка = Выборка + "," + Символы.ПС
			+ "СУММА(Т." + РесурсСтоимости + "Остаток) КАК Стоимость";
	КонецЕсли;

	Текст = "ВЫБРАТЬ" + Символы.ПС + Выборка
		+ Символы.ПС + "ИЗ" + Символы.ПС + Регистр.Таблица + ".Остатки(&ДатаОстатков) КАК Т"
		+ Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + "Т." + Измерение
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС
		+ ?(ПустаяСтрока(РесурсСтоимости), "Количество", "Стоимость") + " УБЫВ";

	Параметры = Новый Соответствие;
	Параметры.Вставить("ДатаОстатков", ДатаОстатков);

	Запрос = ВыполнитьЗапросСводки(Текст, Параметры, 100);
	Если НЕ Запрос.Успех Тогда
		Результат.Ошибка = Запрос.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаОстатка Из Запрос.Строки Цикл
		Количество = ЧислоИзСтроки(СтрокаОстатка, "Количество");
		Стоимость = ЧислоИзСтроки(СтрокаОстатка, "Стоимость");

		Результат.Позиций = Результат.Позиций + 1;
		Результат.Стоимость = Результат.Стоимость + Стоимость;
		Если Количество < 0 Тогда
			Результат.Минусовых = Результат.Минусовых + 1;
		КонецЕсли;
		Если Количество <= 0 Тогда
			Результат.БезНаличия = Результат.БезНаличия + 1;
		КонецЕсли;

		Результат.Строки.Добавить(СтрокаОстатка);
	КонецЦикла;

	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Количество позиций без движения за период (в пределах первых 100 позиций).
//
// Параметры:
//  Регистр - Структура - описание регистра остатков.
//  Измерение - Строка - измерение номенклатуры.
//  ВсегоПозиций - Число - число позиций в остатках.
//  ДатаОстатков - Дата - дата остатков.
//  Месяцев - Число - глубина проверки.
//
// Возвращаемое значение:
//  Структура - {Успех, Количество, Ошибка}.
Функция БезДвиженияПоСкладу(Регистр, Измерение, ВсегоПозиций, ДатаОстатков, Месяцев)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Количество", 0);
	Результат.Вставить("Ошибка", Неопределено);

	НачалоДвижения = НачалоМесяца(ДобавитьМесяц(ДатаОстатков, -Месяцев));
	Условие = "Т." + Измерение + " В (ВЫБРАТЬ РАЗЛИЧНЫЕ Д." + Измерение + " ИЗ "
		+ Регистр.Таблица + " КАК Д";

	Если Регистр.Периодический Тогда
		Условие = Условие + " ГДЕ Д.Период >= &НачалоДвижения";
	КонецЕсли;
	Условие = Условие + ")";

	Текст = "ВЫБРАТЬ" + Символы.ПС
		+ "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т." + Измерение + ") КАК Позиций"
		+ Символы.ПС + "ИЗ" + Символы.ПС + Регистр.Таблица + ".Остатки(&ДатаОстатков) КАК Т"
		+ Символы.ПС + "ГДЕ" + Символы.ПС + Условие;

	Параметры = Новый Соответствие;
	Параметры.Вставить("ДатаОстатков", ДатаОстатков);
	Если Регистр.Периодический Тогда
		Параметры.Вставить("НачалоДвижения", НачалоДвижения);
	КонецЕсли;

	Запрос = ВыполнитьЗапросСводки(Текст, Параметры, 1);
	Если НЕ Запрос.Успех Тогда
		Результат.Ошибка = Запрос.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Двигались = 0;
	Если Запрос.Строки.Количество() > 0 Тогда
		Двигались = ЧислоИзСтроки(Запрос.Строки[0], "Позиций");
	КонецЕсли;

	Результат.Количество = Макс(0, ВсегоПозиций - Двигались);
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Сравнение чисел в процентах.
//
// Параметры:
//  Текущее - Число - текущее значение.
//  Прошлое - Число - прошлое значение.
//
// Возвращаемое значение:
//  Число,Неопределено - изменение в процентах; Неопределено, если база сравнения 0.
Функция ИзменениеПроцентов(Текущее, Прошлое)

	Если Прошлое = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Окр((Текущее - Прошлое) / Прошлое * 100, 1);

КонецФункции

// Текст процентов для пояснений.
//
// Параметры:
//  Значение - Число,Неопределено - проценты.
//
// Возвращаемое значение:
//  Строка - подпись.
Функция ФорматПроцента(Значение)

	Если Значение = Неопределено Тогда
		Возврат "нет базы сравнения";
	КонецЕсли;

	Возврат Формат(Значение, "ЧДЦ=1; ЧГ=") + "%";

КонецФункции

// Число из поля строки результата запроса.
//
// Параметры:
//  Строка - Соответствие,Структура,Неопределено - строка результата.
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  Число - значение; 0, если поля нет или оно не число.
Функция ЧислоИзСтроки(Строка, Имя)

	Если Строка = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Значение = СИ_РаботаСJSON.БезопасноПолучить(Строка, Имя, 0);
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Нормализует глубину проверки движения: 1..24 месяца, по умолчанию 3.
//
// Параметры:
//  Значение - Произвольный - значение параметра.
//
// Возвращаемое значение:
//  Число - нормализованное число месяцев.
Функция НормализоватьМесяцы(Значение)

	Если Значение = Неопределено Тогда
		Возврат 3;
	КонецЕсли;

	Попытка
		Месяцев = Цел(Число(Значение));
	Исключение
		Возврат 3;
	КонецПопытки;

	Если Месяцев < 1 Тогда
		Возврат 3;
	КонецЕсли;

	Возврат Мин(Месяцев, 24);

КонецФункции

