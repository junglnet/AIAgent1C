#Область ПрограммныйИнтерфейс

// Замена эмодзи вне BMP на inline SVG или текстовые эквиваленты.
//
// Параметры:
//  Текст - Строка - текст (обычно уже HTML-экранированный) для обработки.
//  ЗаменятьНеизвестные - Булево - заменять ли неизвестные суррогатные пары на "[?]"
//    (Истина) или удалять их (Ложь). По умолчанию Истина.
//
// Возвращаемое значение:
//  Строка - текст с заменёнными эмодзи.
Функция ЗаменитьЭмодзиВТексте(Текст, ЗаменятьНеизвестные = Истина) Экспорт
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	СоответствиеЗамен = ПолучитьСоответствиеЗаменЭмодзи();

	Фрагменты = Новый Массив;
	Длина = СтрДлина(Текст);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Код = КодСимвола(Текст, Индекс);

		Если ЭтоСтаршийСуррогат(Код) И Индекс < Длина Тогда
			Младший = КодСимвола(Текст, Индекс + 1);
			Если ЭтоМладшийСуррогат(Младший) Тогда
				ПолныйКод = КодСимволаИзСуррогатнойПары(Код, Младший);
				Если ПолныйКод >= 127995 И ПолныйКод <= 127999 Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;

				Замена = СоответствиеЗамен.Получить(ПолныйКод);
				Если Замена = Неопределено Тогда
					Если ЗаменятьНеизвестные Тогда
						Фрагменты.Добавить("[?]");
					КонецЕсли;
				Иначе
					Фрагменты.Добавить(Замена);
				КонецЕсли;
				Индекс = Индекс + 2;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если (Код >= 65024 И Код <= 65039) ИЛИ (Код >= 917760 И Код <= 917999) ИЛИ Код = 8205 Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если ЭтоМладшийСуррогат(Код) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Фрагменты.Добавить(Сред(Текст, Индекс, 1));
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат СтрСоединить(Фрагменты, "");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверка: код является старшим суррогатом (U+D800..U+DBFF).
Функция ЭтоСтаршийСуррогат(Код)
	Возврат Код >= 55296 И Код <= 56319;
КонецФункции

// Проверка: код является младшим суррогатом (U+DC00..U+DFFF).
Функция ЭтоМладшийСуррогат(Код)
	Возврат Код >= 56320 И Код <= 57343;
КонецФункции

// Вычисление полного кода Unicode из суррогатной пары.
Функция КодСимволаИзСуррогатнойПары(Старший, Младший)
	Возврат (Старший - 55296) * 1024 + (Младший - 56320) + 65536;
КонецФункции

