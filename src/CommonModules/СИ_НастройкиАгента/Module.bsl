#Область ПрограммныйИнтерфейс

// Чтение настроек агента из профиля подключения.
//
// Параметры:
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения.
//    Если Неопределено - используется профиль активного режима из константы СИ_АктивныйРежим.
//
// Возвращаемое значение:
//  Структура - настройки агента (состав задан в ЗаполнитьНастройкиПоУмолчанию):
//    * БазовыйURL - Строка - базовый URL endpoint API (с версией, например https://api.openai.com/v1).
//    * КлючAPI - Строка - секретный ключ (Bearer токен).
//    * МодельПоУмолчанию - Строка - имя модели по умолчанию (устаревший ключ; актуальная модель
//      по умолчанию определяется из ТЧ Модели профиля через ПолучитьМодельПоУмолчанию).
//    * Температура - Число - температура по умолчанию (фолбэк; приоритет у реквизита режима).
//    * MaxTokens - Число,Неопределено - лимит токенов ответа по умолчанию (фолбэк;
//      приоритет у колонки ТЧ Модели.МаксимумТокеновОтвета).
//    * Таймаут - Число - таймаут HTTP в секундах.
//    * Прокси - Неопределено,Структура:
//    	** Сервер - Строка
//    	** Порт - Число
//    	** Пользователь - Строка
//    	** Пароль - Строка
//    * MaxIterations - Число - максимум итераций агентского цикла.
//    * РазрешитьРассуждения - Булево - признак разрешения режима рассуждений (reasoning).
//    * ЗаголовокЧерезИИ - Булево - способ автозаголовка нового диалога: Ложь (по умолчанию) -
//      заголовок из текста первого сообщения без ИИ; Истина - один дешёвый вызов модели.
//    * ИспользоватьСводку - Булево - признак использования сводки (Уровень 2 сжатия).
//    * МаксТокеновСводки - Число - бюджет сводки в токенах.
//    * КоличествоСвежихСообщений - Число - сколько свежих сообщений не сжимать.
//    * МаксДлинаToolРезультата - Число - лимит tool-результата в символах.
//    * МаксДлинаСообщения - Число - лимит длины сообщения в символах.
//    * ПроцентОкнаДляИстории - Число - доля контекстного окна, отводимая под историю (0.75 = 75%).
//    * ПрофильПодключения - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль, из которого прочитаны настройки.
//    * ТипАвторизации - ПеречислениеСсылка.СИ_ТипыАвторизации - способ авторизации (Bearer/КлючВЗаголовке/КлючВURL/Нет).
//    * ИмяЗаголовкаАвторизации - Строка - имя заголовка при ТипАвторизации = КлючВЗаголовке (по умолчанию "Authorization").
//    * ПроверятьSSL - Булево - проверять сертификат при HTTPS-соединении.
Функция ПолучитьНастройки(Профиль = Неопределено) Экспорт
	НастройкиПоУмолчанию = ЗаполнитьНастройкиПоУмолчанию();
	
	Попытка
		ИспользуемыйПрофиль = ПолучитьИспользуемыйПрофиль(Профиль);
		Если ИспользуемыйПрофиль = Неопределено Тогда
			Возврат НастройкиПоУмолчанию;
		КонецЕсли;
		
		ДанныеПрофиля = ДанныеПрофиляИзЗапроса(ИспользуемыйПрофиль);
		Если ДанныеПрофиля = Неопределено Тогда
			Возврат НастройкиПоУмолчанию;
		КонецЕсли;
		
		Настройки = ЗаполнитьНастройкиПоУмолчанию();
		ЗаполнитьЗначенияСвойств(Настройки, ДанныеПрофиля);
		Настройки.Вставить("Прокси", СобратьНастройкиПрокси(ДанныеПрофиля));
		Настройки.Вставить("ПрофильПодключения", ИспользуемыйПрофиль);
		
		Возврат Настройки;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.ПолучитьНастройки", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка чтения настроек агента: " + ОписаниеОшибки());
		Возврат НастройкиПоУмолчанию;
	КонецПопытки;
КонецФункции

// Сохранение настроек агента в профиль подключения.
//
// Параметры:
//  Настройки - Структура - настройки агента (как в ПолучитьНастройки).
//    Записываются только ключи, присутствующие в структуре (непереданные реквизиты профиля не меняются).
//    Сохраняются все ключи из ЗаполнитьНастройкиПоУмолчанию, кроме служебных
//    (ПрофильПодключения) и прокси (Прокси записывается полями ИспользоватьПрокси/ПроксиСервер/...).
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль, в который сохранить.
//    Если Неопределено - используется профиль активного режима из константы СИ_АктивныйРежим.
//
// Возвращаемое значение:
//  Булево - Истина, если настройки успешно записаны; Ложь при отсутствии профиля или ошибке записи.
Функция СохранитьНастройки(Настройки, Профиль = Неопределено) Экспорт
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.СохранитьНастройки", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка сохранения настроек: параметр Настройки не является структурой (тип: " + Строка(ТипЗнч(Настройки)) + ")");
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ИспользуемыйПрофиль = ПолучитьИспользуемыйПрофиль(Профиль);
		Если ИспользуемыйПрофиль = Неопределено Тогда
			ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.СохранитьНастройки", УровеньЖурналаРегистрации.Предупреждение,
				, , "Сохранение настроек пропущено: профиль подключения не задан");
			Возврат Ложь;
		КонецЕсли;
		
		ПрофильОбъект = ИспользуемыйПрофиль.ПолучитьОбъект();
		Если ПрофильОбъект = Неопределено Тогда
			ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.СохранитьНастройки", УровеньЖурналаРегистрации.Предупреждение,
				, , "Сохранение настроек пропущено: объект профиля не получен (" + Строка(ИспользуемыйПрофиль) + ")");
			Возврат Ложь;
		КонецЕсли;
		
		ПрименитьНастройкиКОбъекту(Настройки, ПрофильОбъект);
		
		ПрофильОбъект.Записать();
		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.СохранитьНастройки", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка сохранения настроек: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Получение профиля возможностей модели по её имени.
//
// Параметры:
//  ИмяМодели - Строка - идентификатор модели.
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения,
//    в котором искать модель в табличной части Модели. Если Неопределено - используется активный профиль.
//
// Возвращаемое значение:
//  Структура - профиль модели (для неизвестной модели возвращаются консервативные дефолты):
//    * Имя - Строка - имя модели.
//    * КонтекстОкно - Число - размер контекстного окна в токенах.
//    * MaxTokens - Число,Неопределено - лимит токенов ответа из ТЧ Модели (приоритет над шапкой).
//    * ПоддержкаИзображений - Булево - признак поддержки image_url/vision.
Функция ПолучитьПрофильМодели(ИмяМодели, Профиль = Неопределено) Экспорт
	ПрофильПоУмолчанию = Новый Структура;
	ПрофильПоУмолчанию.Вставить("Имя", ИмяМодели);
	ПрофильПоУмолчанию.Вставить("КонтекстОкно", 128000);
	ПрофильПоУмолчанию.Вставить("MaxTokens", Неопределено);
	ПрофильПоУмолчанию.Вставить("ПоддержкаИзображений", Ложь);
	
	Попытка
		ИспользуемыйПрофиль = ПолучитьИспользуемыйПрофиль(Профиль);
		Если ИспользуемыйПрофиль = Неопределено Тогда
			Возврат ПрофильПоУмолчанию;
		КонецЕсли;
		
		ДанныеМодели = ДанныеМоделиИзЗапроса(ИспользуемыйПрофиль, ИмяМодели);
		Если ДанныеМодели = Неопределено Тогда
			Возврат ПрофильПоУмолчанию;
		КонецЕсли;
		
		Результат = Новый Структура;
		Результат.Вставить("Имя", ДанныеМодели.ИмяМодели);
		Результат.Вставить("КонтекстОкно", ЗначениеИлиДефолт(ДанныеМодели.КонтекстноеОкно, 128000));
		Результат.Вставить("MaxTokens", ДанныеМодели.МаксимумТокеновОтвета);
		Результат.Вставить("ПоддержкаИзображений", ЗначениеИлиДефолт(ДанныеМодели.ПоддержкаИзображений, Ложь));
		Возврат Результат;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.ПолучитьПрофильМодели", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка чтения профиля модели '" + ИмяМодели + "': " + ОписаниеОшибки());
		Возврат ПрофильПоУмолчанию;
	КонецПопытки;
КонецФункции

// Возвращает защитный лимит токенов на один ответ (одно фоновое задание).
//
// Лимит хранится в константе СИ_ЛимитТокеновНаОтвет и ограничивает расход
// токенов ТЕКУЩЕГО захода (одного ответа на одно сообщение пользователя),
// не суммируясь с накопленным ПотраченоТокенов диалога.
//
// Возвращаемое значение:
//  Число - лимит из константы СИ_ЛимитТокеновНаОтвет; при 0/Неопределено/ошибке - 1000000.
//
Функция ПолучитьЛимитТокеновНаОтвет() Экспорт
	ЛимитПоУмолчанию = 1000000;
	Попытка
		Лимит = Константы.СИ_ЛимитТокеновНаОтвет.Получить();
		Если Лимит = 0 ИЛИ Лимит = Неопределено Тогда
			Возврат ЛимитПоУмолчанию;
		КонецЕсли;
		Возврат Лимит;
	Исключение
		Возврат ЛимитПоУмолчанию;
	КонецПопытки;
КонецФункции

// Проверка доступности endpoint API через GET {base_url}/models.
//
// Возвращаемое значение:
//  Структура - результат проверки:
//    * Доступен - Булево - признак доступности endpoint.
//    * СписокМоделей - Неопределено,Массив из Строка - массив имён доступных моделей.
//    * Ошибка - Строка,Неопределено - текст ошибки при Доступен=Ложь.
Функция ПроверитьДоступностьEndpoint() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Доступен", Ложь);
	Результат.Вставить("СписокМоделей", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);
	
	Попытка
		Настройки = ПолучитьНастройки();
		Если ПустаяСтрока(Настройки.БазовыйURL) Тогда
			Результат.Ошибка = "Не указан БазовыйURL";
			Возврат Результат;
		КонецЕсли;
		
		СтруктураURL = ОбщегоНазначенияКлиентСервер.СтруктураURI(Настройки.БазовыйURL);
		Если ПустаяСтрока(СтруктураURL.Хост) Тогда
			Результат.Ошибка = "Некорректный БазовыйURL: " + Настройки.БазовыйURL;
			Возврат Результат;
		КонецЕсли;
		
		ПутьПроверки = ПутьРесурсаБезВерсии(Настройки.БазовыйURL) + "models";
		
		HTTPСоединение = СоздатьHTTPСоединениеПоНастройкам(Настройки);
		Если HTTPСоединение = Неопределено Тогда
			Результат.Ошибка = "Не удалось создать HTTP-соединение по настройкам профиля";
			Возврат Результат;
		КонецЕсли;
		
		HTTPЗапрос = Новый HTTPЗапрос(ПутьПроверки);
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
		
		УстановитьЗаголовкиАвторизации(HTTPЗапрос, Настройки);
		
		HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Результат.Доступен = Истина;
			Тело = HTTPОтвет.ПолучитьТелоКакСтроку();
			Данные = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(Тело);
			Если Данные <> Неопределено Тогда
				МоделиМассив = СИ_РаботаСJSON.БезопасноПолучить(Данные, "data", Неопределено);
				Если МоделиМассив <> Неопределено И ТипЗнч(МоделиМассив) = Тип("Массив") Тогда
					Список = Новый Массив;
					Для Каждого Модель Из МоделиМассив Цикл
						Идентификатор = Модель.Получить("id");
						Если Идентификатор <> Неопределено И ТипЗнч(Идентификатор) = Тип("Строка") Тогда
							Список.Добавить(Идентификатор);
						КонецЕсли;
					КонецЦикла;
					Результат.СписокМоделей = Список;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Результат.Ошибка = "HTTP " + Строка(HTTPОтвет.КодСостояния) + ": " + HTTPОтвет.ПолучитьТелоКакСтроку();
		КонецЕсли;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Создаёт HTTP-соединение по настройкам агента.
// Использует БазовыйURL, Таймаут, Прокси, ПроверятьSSL из структуры настроек.
//
// Параметры:
//  Настройки - Структура - настройки агента (как в ПолучитьНастройки).
//
// Возвращаемое значение:
//  HTTPСоединение,Неопределено - соединение; Неопределено при некорректных настройках.
Функция СоздатьHTTPСоединениеПоНастройкам(Настройки) Экспорт
	БазовыйURL = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "БазовыйURL", "");
	Таймаут = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "Таймаут", 60);
	ПроверятьSSL = ЗначениеИлиДефолт(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ПроверятьSSL", Истина), Истина);
	
	СтруктураURL = ОбщегоНазначенияКлиентСервер.СтруктураURI(БазовыйURL);
	Если ПустаяСтрока(СтруктураURL.Хост) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Хост = СтруктураURL.Хост;
	Порт = ЗначениеИлиДефолт(СтруктураURL.Порт, 0);
	Схема = НРег(СтруктураURL.Схема);
	ИспользоватьSSL = Истина;
	Если ПустаяСтрока(Схема) ИЛИ Схема = "https" Тогда
		ИспользоватьSSL = Истина;
		Если Порт = 0 Тогда
			Порт = 443;
		КонецЕсли;
	ИначеЕсли Схема = "http" Тогда
		ИспользоватьSSL = Ложь;
		Если Порт = 0 Тогда
			Порт = 80;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Прокси = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "Прокси", Неопределено);
	ИспользоватьПрокси = Неопределено;
	Если Прокси <> Неопределено Тогда
		ПроксиСервер = СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Сервер", "");
		Если НЕ ПустаяСтрока(ПроксиСервер) Тогда
			ПроксиПорт = ЗначениеИлиДефолт(СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Порт", 8080), 8080);
			ПроксиПользователь = СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Пользователь", Неопределено);
			ПроксиПароль = СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Пароль", Неопределено);
			ИспользоватьПрокси = Новый ИнтернетПрокси(Ложь);
			ИспользоватьПрокси.Установить("http", ПроксиСервер, ПроксиПорт, ПроксиПользователь, ПроксиПароль);
			ИспользоватьПрокси.Установить("https", ПроксиСервер, ПроксиПорт, ПроксиПользователь, ПроксиПароль);
			ИспользоватьПрокси.УстановитьБезПроксиДляЛокальныхАдресов = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ЗащищенноеСоединение = Неопределено;
	Если ИспользоватьSSL И ПроверятьSSL Тогда
		Попытка
			ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
		Исключение
			ЗащищенноеСоединение = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ИспользоватьПрокси <> Неопределено Тогда
		Возврат Новый HTTPСоединение(Хост, Порт,,, ИспользоватьПрокси, Таймаут, ЗащищенноеСоединение);
	Иначе
		Возврат Новый HTTPСоединение(Хост, Порт,,,, Таймаут, ЗащищенноеСоединение);
	КонецЕсли;
КонецФункции

// Устанавливает заголовки авторизации в HTTP-запрос по настройкам агента.
// Учитывает ТипАвторизации (Bearer / КлючВЗаголовке / КлючВURL) и ИмяЗаголовкаАвторизации.
//
// Параметры:
//  HTTPЗапрос - HTTPЗапрос - запрос, в который добавляются заголовки.
//  Настройки - Структура - настройки агента (как в ПолучитьНастройки).
Процедура УстановитьЗаголовкиАвторизации(HTTPЗапрос, Настройки) Экспорт
	КлючAPI = ЗначениеИлиДефолт(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "КлючAPI", ""), "");
	Если ПустаяСтрока(КлючAPI) Тогда
		Возврат;
	КонецЕсли;
	
	ТипАвторизации = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ТипАвторизации", Перечисления.СИ_ТипыАвторизации.Bearer);
	Если ТипАвторизации = Перечисления.СИ_ТипыАвторизации.Bearer Тогда
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
	ИначеЕсли ТипАвторизации = Перечисления.СИ_ТипыАвторизации.КлючВЗаголовке Тогда
		ИмяЗаголовка = ЗначениеИлиДефолт(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ИмяЗаголовкаАвторизации", "Authorization"), "Authorization");
		Если НЕ ПустаяСтрока(ИмяЗаголовка) Тогда
			HTTPЗапрос.Заголовки.Вставить(ИмяЗаголовка, КлючAPI);
		КонецЕсли;
	ИначеЕсли ТипАвторизации = Перечисления.СИ_ТипыАвторизации.КлючВURL Тогда
		HTTPЗапрос.АдресРесурса = HTTPЗапрос.АдресРесурса + ?(СтрНайти(HTTPЗапрос.АдресРесурса, "?") > 0, "&", "?") + "api_key=" + КлючAPI;
	КонецЕсли;
КонецПроцедуры

// Возвращает имя модели по умолчанию из табличной части Модели профиля подключения.
// Моделью по умолчанию считается строка ТЧ Модели с установленным флагом ИспользоватьПоУмолчанию.
// Если таких строк несколько — берётся первая (упорядочение по строке ТЧ). Если ни одной — возвращается "".
//
// Параметры:
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения.
//    Если Неопределено - используется профиль активного режима из константы СИ_АктивныйРежим.
//
// Возвращаемое значение:
//  Строка - имя модели по умолчанию; "" если модель по умолчанию не задана.
Функция ПолучитьМодельПоУмолчанию(Профиль = Неопределено) Экспорт
	Попытка
		ИспользуемыйПрофиль = ПолучитьИспользуемыйПрофиль(Профиль);
		Если ИспользуемыйПрофиль = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Модели.ИмяМодели КАК ИмяМодели
		|ИЗ
		|	Справочник.СИ_ПрофилиПодключений.Модели КАК Модели
		|ГДЕ
		|	Модели.Ссылка = &Ссылка
		|	И Модели.ИспользоватьПоУмолчанию = Истина";
		Запрос.УстановитьПараметр("Ссылка", ИспользуемыйПрофиль);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ИмяМодели;
		КонецЕсли;
		
		Возврат "";
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.ПолучитьМодельПоУмолчанию", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка определения модели по умолчанию: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

// Проверяет доступность режима работы для пользователя.
//
// Параметры:
//  Режим - СправочникСсылка.СИ_РежимиРаботы - режим работы.
//  Пользователь - СправочникСсылка.Пользователи - пользователь.
//
// Возвращаемое значение:
//  Булево - Истина, если режим доступен пользователю.
//    Если табличная часть ДоступныеПользователи режима пуста - режим доступен всем.
Функция РежимДоступенПользователю(Режим, Пользователь) Экспорт
	Если НЕ ЗначениеЗаполнено(Режим) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Количество(*) КАК ВсегоСтрок,
		|	Сумма(ВЫБОР
		|		КОГДА Доступные.Пользователь = &Пользователь
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ) КАК СтрокСПользователем
		|ИЗ
		|	Справочник.СИ_РежимиРаботы.ДоступныеПользователи КАК Доступные
		|ГДЕ
		|	Доступные.Ссылка = &Режим";
		Запрос.УстановитьПараметр("Режим", Режим);
		Запрос.УстановитьПараметр("Пользователь", Пользователь);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.ВсегоСтрок = 0 ИЛИ Выборка.СтрокСПользователем > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.РежимДоступенПользователю", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка проверки доступности режима: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Ложь;
КонецФункции

// Возвращает список режимов работы, доступных пользователю.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - пользователь.
//  ТолькоДляСпискаЧатов - Булево - при Истина возвращаются только режимы
//    с реквизитом ИспользоватьВСпискеЧатов = Истина (для поля «Режим» формы чата).
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.СИ_РежимиРаботы - режимы, доступные пользователю.
//    Если у режима табличная часть ДоступныеПользователи пуста - режим доступен всем.
Функция ПолучитьДоступныеРежимыПользователя(Пользователь, ТолькоДляСпискаЧатов = Ложь) Экспорт
	Результат = Новый Массив;

	Попытка
		УсловиеДляСпискаЧатов = ?(ТолькоДляСпискаЧатов, "И Режимы.ИспользоватьВСпискеЧатов = Истина", "");

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Режимы.Ссылка КАК Ссылка,
		|	Режимы.Наименование КАК Наименование
		|ИЗ
		|	Справочник.СИ_РежимиРаботы КАК Режимы
		|ГДЕ
		|	Режимы.ПометкаУдаления = Ложь
		|	" + УсловиеДляСпискаЧатов + "
		|	И (Режимы.Ссылка НЕ В (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		Доступные.Ссылка
		|	ИЗ
		|			Справочник.СИ_РежимиРаботы.ДоступныеПользователи КАК Доступные)
		|	ИЛИ Режимы.Ссылка В (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		Доступные.Ссылка
		|	ИЗ
		|			Справочник.СИ_РежимиРаботы.ДоступныеПользователи КАК Доступные
		|	ГДЕ
		|			Доступные.Пользователь = &Пользователь))
		|УПОРЯДОЧИТЬ ПО
		|	Режимы.Наименование";
		Запрос.УстановитьПараметр("Пользователь", Пользователь);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.НастройкиАгента.ПолучитьДоступныеРежимыПользователя", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка получения доступных режимов: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает значение, если оно заполнено (не Null и не Неопределено), иначе — значение по умолчанию.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//  Дефолт - Произвольный - значение, возвращаемое при Значение = Неопределено или Значение = Null.
//
// Возвращаемое значение:
//  Произвольный - Значение, если оно не Null и не Неопределено; иначе Дефолт.
Функция ЗначениеИлиДефолт(Значение, Дефолт)
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Возвращает структуру настроек агента со значениями по умолчанию.
// Единственный источник состава ключей: ПолучитьНастройки, СохранитьНастройки
// и ДанныеПрофиляИзЗапроса используют именно этот набор.
//
// Возвращаемое значение:
//  Структура - настройки агента с дефолтными значениями (см. ПолучитьНастройки).
Функция ЗаполнитьНастройкиПоУмолчанию()
	Настройки = Новый Структура;
	Настройки.Вставить("БазовыйURL", "");
	Настройки.Вставить("КлючAPI", "");
	Настройки.Вставить("МодельПоУмолчанию", "");
	Настройки.Вставить("Температура", 0.20);
	Настройки.Вставить("MaxTokens", Неопределено);
	Настройки.Вставить("Таймаут", 60);
	Настройки.Вставить("Прокси", Неопределено);
	Настройки.Вставить("MaxIterations", 10);
	Настройки.Вставить("РазрешитьРассуждения", Ложь);
	Настройки.Вставить("ЗаголовокЧерезИИ", Ложь);
	Настройки.Вставить("ИспользоватьСводку", Ложь);
	Настройки.Вставить("МаксТокеновСводки", 1500);
	Настройки.Вставить("КоличествоСвежихСообщений", 10);
	Настройки.Вставить("МаксДлинаToolРезультата", 4000);
	Настройки.Вставить("МаксДлинаСообщения", 4000);
	Настройки.Вставить("ПроцентОкнаДляИстории", 0.75);
	Настройки.Вставить("ПрофильПодключения", Неопределено);
	Настройки.Вставить("ТипАвторизации", Перечисления.СИ_ТипыАвторизации.Bearer);
	Настройки.Вставить("ИмяЗаголовкаАвторизации", "Authorization");
	Настройки.Вставить("ПроверятьSSL", Истина);
	Настройки.Вставить("КоличествоПовторовПриТранспортнойОшибке", 2);
	Настройки.Вставить("ПутьКУтилитеКонвертацииPDF", "");
	Настройки.Вставить("ДвижокКонвертацииPDF", "pdftoppm");
	Настройки.Вставить("МаксимумСтраницPDF", 10);
	Настройки.Вставить("DPIКонвертацииPDF", 100);
	Возврат Настройки;
КонецФункции

// Возвращает профиль подключения для чтения/записи: явный параметр или профиль активного режима.
//
// Параметры:
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - явно переданный профиль.
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения;
//  Неопределено, если профиль не задан и активный режим (или его профиль) не заполнен.
Функция ПолучитьИспользуемыйПрофиль(Профиль)
	ИспользуемыйПрофиль = Профиль;
	Если ИспользуемыйПрофиль = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИспользуемыйПрофиль) Тогда
		АктивныйРежим = Константы.СИ_АктивныйРежим.Получить();
		Если ЗначениеЗаполнено(АктивныйРежим) Тогда
			ИспользуемыйПрофиль = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктивныйРежим, "Профиль").Профиль;
		КонецЕсли;
	КонецЕсли;
	Если ИспользуемыйПрофиль = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИспользуемыйПрофиль) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИспользуемыйПрофиль;
КонецФункции

// Применяет переданные настройки к объекту профиля подключения.
// Записываются только ключи, присутствующие в структуре Настройки.
// Прокси раскладывается на реквизиты ИспользоватьПрокси/ПроксиСервер/ПроксиПорт/ПроксиПользователь/ПроксиПароль.
//
// Параметры:
//  Настройки - Структура - настройки агента (как в ПолучитьНастройки).
//  ПрофильОбъект - СправочникОбъект.СИ_ПрофилиПодключений - объект профиля для записи.
Процедура ПрименитьНастройкиКОбъекту(Настройки, ПрофильОбъект)
	СоответствиеКлючРеквизит = Новый Соответствие;
	СоответствиеКлючРеквизит.Вставить("БазовыйURL", "БазовыйURL");
	СоответствиеКлючРеквизит.Вставить("КлючAPI", "КлючAPI");
	СоответствиеКлючРеквизит.Вставить("Таймаут", "Таймаут");
	СоответствиеКлючРеквизит.Вставить("MaxIterations", "МаксимумИтераций");
	СоответствиеКлючРеквизит.Вставить("РазрешитьРассуждения", "РазрешитьРассуждения");
	СоответствиеКлючРеквизит.Вставить("ЗаголовокЧерезИИ", "ЗаголовокЧерезИИ");
	СоответствиеКлючРеквизит.Вставить("ИспользоватьСводку", "ИспользоватьСводку");
	СоответствиеКлючРеквизит.Вставить("МаксТокеновСводки", "МаксТокеновСводки");
	СоответствиеКлючРеквизит.Вставить("КоличествоСвежихСообщений", "КоличествоСвежихСообщений");
	СоответствиеКлючРеквизит.Вставить("МаксДлинаToolРезультата", "МаксДлинаToolРезультата");
	СоответствиеКлючРеквизит.Вставить("МаксДлинаСообщения", "МаксДлинаСообщения");
	СоответствиеКлючРеквизит.Вставить("ПроцентОкнаДляИстории", "ПроцентОкнаДляИстории");
	СоответствиеКлючРеквизит.Вставить("ТипАвторизации", "ТипАвторизации");
	СоответствиеКлючРеквизит.Вставить("ИмяЗаголовкаАвторизации", "ИмяЗаголовкаАвторизации");
	СоответствиеКлючРеквизит.Вставить("ПроверятьSSL", "ПроверятьSSL");
	СоответствиеКлючРеквизит.Вставить("ПутьКУтилитеКонвертацииPDF", "ПутьКУтилитеКонвертацииPDF");
	СоответствиеКлючРеквизит.Вставить("ДвижокКонвертацииPDF", "ДвижокКонвертацииPDF");
	СоответствиеКлючРеквизит.Вставить("МаксимумСтраницPDF", "МаксимумСтраницPDF");
	СоответствиеКлючРеквизит.Вставить("DPIКонвертацииPDF", "DPIКонвертацииPDF");
	
	Для Каждого Пара Из СоответствиеКлючРеквизит Цикл
		Ключ = Пара.Ключ;
		Если Настройки.Свойство(Ключ) Тогда
			ПрофильОбъект[Пара.Значение] = Настройки[Ключ];
		КонецЕсли;
	КонецЦикла;
	
	Если Настройки.Свойство("Прокси") Тогда
		Прокси = Настройки.Прокси;
		Если Прокси = Неопределено Тогда
			ПрофильОбъект.ИспользоватьПрокси = Ложь;
			ПрофильОбъект.ПроксиСервер = "";
			ПрофильОбъект.ПроксиПорт = 0;
			ПрофильОбъект.ПроксиПользователь = "";
			ПрофильОбъект.ПроксиПароль = "";
		Иначе
			ПрофильОбъект.ИспользоватьПрокси = Истина;
			ПрофильОбъект.ПроксиСервер = ЗначениеИлиДефолт(СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Сервер", ""), "");
			ПрофильОбъект.ПроксиПорт = ЗначениеИлиДефолт(СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Порт", 8080), 8080);
			ПрофильОбъект.ПроксиПользователь = ЗначениеИлиДефолт(СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Пользователь", ""), "");
			ПрофильОбъект.ПроксиПароль = ЗначениеИлиДефолт(СИ_РаботаСJSON.БезопасноПолучить(Прокси, "Пароль", ""), "");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Собирает структуру прокси из данных профиля.
//
// Параметры:
//  ДанныеПрофиля - Структура - поля профиля (см. ДанныеПрофиляИзЗапроса).
//
// Возвращаемое значение:
//  Неопределено,Структура - параметры прокси:
//    * Сервер - Строка
//    * Порт - Число
//    * Пользователь - Строка
//    * Пароль - Строка
//  Неопределено, если прокси не используется или не задан сервер прокси.
Функция СобратьНастройкиПрокси(ДанныеПрофиля)
	Если НЕ ДанныеПрофиля.ИспользоватьПрокси Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПроксиСервер = СокрЛП(ЗначениеИлиДефолт(ДанныеПрофиля.ПроксиСервер, ""));
	Если ПустаяСтрока(ПроксиСервер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Прокси = Новый Структура;
	Прокси.Вставить("Сервер", ПроксиСервер);
	Прокси.Вставить("Порт", ЗначениеИлиДефолт(ДанныеПрофиля.ПроксиПорт, 8080));
	Прокси.Вставить("Пользователь", ЗначениеИлиДефолт(ДанныеПрофиля.ПроксиПользователь, ""));
	Прокси.Вставить("Пароль", ЗначениеИлиДефолт(ДанныеПрофиля.ПроксиПароль, ""));
	Возврат Прокси;
КонецФункции

// Возвращает путь ресурса из полного URL (после хоста), с завершающим слэшем.
// Используется для проверки доступности endpoint и построения пути из БазовыйURL
// (версия API уже включена в БазовыйURL, например https://api.openai.com/v1).
//
// Параметры:
//  БазовыйURL - Строка - полный URL endpoint (например, https://api.openai.com/v1).
//
// Возвращаемое значение:
//  Строка - путь ресурса с завершающим слэшем (например, "/v1/").
Функция ПутьРесурсаБезВерсии(БазовыйURL)
	ПутьРесурса = БазовыйURL;
	Если СтрНачинаетсяС(ПутьРесурса, "https://") Тогда
		ПутьРесурса = Сред(ПутьРесурса, 9);
	ИначеЕсли СтрНачинаетсяС(ПутьРесурса, "http://") Тогда
		ПутьРесурса = Сред(ПутьРесурса, 8);
	КонецЕсли;
	ПозицияПервогоСлеша = СтрНайти(ПутьРесурса, "/");
	Если ПозицияПервогоСлеша > 0 Тогда
		ПутьРесурса = Сред(ПутьРесурса, ПозицияПервогоСлеша);
	Иначе
		ПутьРесурса = "";
	КонецЕсли;
	Если Прав(ПутьРесурса, 1) <> "/" И НЕ ПустаяСтрока(ПутьРесурса) Тогда
		ПутьРесурса = ПутьРесурса + "/";
	КонецЕсли;
	Возврат ПутьРесурса;
КонецФункции

