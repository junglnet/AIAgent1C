&НаСервере
Процедура ПодготовитьШагРежимНаСервере()

	// Если режим ещё не выбран - предлагаем текущий активный режим как основу.
	Если НЕ ЗначениеЗаполнено(РежимРаботы) Тогда
		РежимРаботы = Константы.СИ_АктивныйРежим.Получить();
		Если ЗначениеЗаполнено(РежимРаботы) Тогда
			ЗагрузитьДанныеРежима();
		КонецЕсли;
	КонецЕсли;

	// Если в базе нет ни одного режима - включаем создание нового
	// с наименованием и промптом по умолчанию.
	Если НЕ ЗначениеЗаполнено(РежимРаботы) И КоличествоРежимов() = 0 Тогда
		СоздатьНовыйРежим = Истина;
		Если НЕ ЗначениеЗаполнено(ИмяРежима) Тогда
			ИмяРежима = НСтр("ru='Основной режим'");
		КонецЕсли;
		Если ПустаяСтрока(СистемныйПромпт) Тогда
			СистемныйПромпт = СИ_Промпты.ПолучитьСистемныйПромптПоУмолчанию();
		КонецЕсли;
	КонецЕсли;

	// Если модель не выбрана - берём модель профиля с флагом «Использовать по умолчанию».
	Если ПустаяСтрока(МодельРежима) И ЗначениеЗаполнено(ПрофильПодключения) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Модели.ИмяМодели КАК ИмяМодели
		|ИЗ
		|	Справочник.СИ_ПрофилиПодключений.Модели КАК Модели
		|ГДЕ
		|	Модели.Ссылка = &Профиль
		|	И Модели.ИспользоватьПоУмолчанию = ИСТИНА";
		Запрос.УстановитьПараметр("Профиль", ПрофильПодключения);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			МодельРежима = Выборка.ИмяМодели;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

