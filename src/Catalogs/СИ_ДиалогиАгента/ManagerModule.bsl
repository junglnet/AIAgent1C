// Переименовать диалог.
// 
// Параметры:
//  ДиалогСсылка - СправочникСсылка.СИ_ДиалогиАгента
//  Наименование - Строка
Процедура ПереименоватьДиалог(ДиалогСсылка, Наименование) Экспорт
	
	Если ЗначениеЗаполнено(ДиалогСсылка) И Не ПустаяСтрока(Наименование) Тогда
		
		Попытка
			
			ДиалогОбъект = ДиалогСсылка.ПолучитьОбъект();
			ДиалогОбъект.Наименование = Наименование;
			ДиалогОбъект.Записать();
			
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'СИ_ДиалогиАгента.Ошибка переименования диалога'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , ДиалогСсылка, ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КОНЕЦЕСЛИ
