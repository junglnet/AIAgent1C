// Нормализует лимит точек диаграммы: 1..100, по умолчанию 30.
//
// Параметры:
//  Значение - Произвольный - значение параметра ЛимитТочек.
//
// Возвращаемое значение:
//  Число - нормализованный лимит.
Функция НормализоватьЛимитТочек(Значение)

	Максимум = 100;
	ПоУмолчанию = 30;

	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Попытка
		Число = Цел(Число(Значение));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;

	Если Число < 1 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Возврат Мин(Число, Максимум);

КонецФункции

// Приводит тип диаграммы к внутреннему: "столбцы" | "линия" | "круг".
//
// Параметры:
//  Значение - Произвольный - значение параметра Тип.
//
// Возвращаемое значение:
//  Строка - нормализованный тип.
Функция НормализоватьТипДиаграммы(Значение)

	ТипНРег = НРег(СокрЛП(Строка(Значение)));
	Если ТипНРег = "круг" ИЛИ ТипНРег = "круговая" ИЛИ ТипНРег = "pie" Тогда
		Возврат "круг";
	ИначеЕсли ТипНРег = "линия" ИЛИ ТипНРег = "график" ИЛИ ТипНРег = "line" Тогда
		Возврат "линия";
	КонецЕсли;

	Возврат "столбцы";

КонецФункции

// Определяет имя колонки: явно указанное (проверяется в списке) либо по позиции.
//
// Параметры:
//  ИмяИзАргументов - Строка - имя колонки из аргументов вызова.
//  Колонки - Массив из Строка - доступные колонки.
//  ПозицияПоУмолчанию - Число - индекс колонки (с 0) по умолчанию.
//
// Возвращаемое значение:
//  Строка - имя колонки; пустая строка, если колонка не найдена.
Функция ОпределитьКолонку(ИмяИзАргументов, Колонки, ПозицияПоУмолчанию)

	Имя = СокрЛП(Строка(ИмяИзАргументов));
	Если ПустаяСтрока(Имя) Тогда
		Если ПозицияПоУмолчанию < Колонки.Количество() Тогда
			Возврат Колонки[ПозицияПоУмолчанию];
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Если Колонка = Имя Тогда
			Возврат Колонка;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Колонка Из Колонки Цикл
		Если НРег(Колонка) = НРег(Имя) Тогда
			Возврат Колонка;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Формирует имя файла выгрузки: имя пользователя/модели (или префикс + метка
// времени) с гарантированным расширением и без недопустимых символов.
//
// Параметры:
//  ИмяИзАргументов - Строка - имя файла из аргументов (может быть пустым).
//  Префикс - Строка - префикс имени по умолчанию.
//  Расширение - Строка - расширение без точки.
//
// Возвращаемое значение:
//  Строка - безопасное имя файла.
Функция ИмяФайлаВыгрузки(ИмяИзАргументов, Префикс, Расширение)

	Имя = СокрЛП(Строка(ИмяИзАргументов));

	ПозицияРазделителя = СтрНайти(Имя, "\");
	Пока ПозицияРазделителя > 0 Цикл
		Имя = Сред(Имя, ПозицияРазделителя + 1);
		ПозицияРазделителя = СтрНайти(Имя, "\");
	КонецЦикла;
	ПозицияРазделителя = СтрНайти(Имя, "/");
	Пока ПозицияРазделителя > 0 Цикл
		Имя = Сред(Имя, ПозицияРазделителя + 1);
		ПозицияРазделителя = СтрНайти(Имя, "/");
	КонецЦикла;
	Имя = СокрЛП(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Имя = Префикс + "_" + Формат(ТекущаяДатаСеанса(), "ДФ='yyyyMMdd_HHmmss'");
	КонецЕсли;

	Имя = ЗаменитьНедопустимыеСимволыИмени(Имя);
	Если СтрДлина(Имя) > 120 Тогда
		Имя = Лев(Имя, 120);
	КонецЕсли;

	ОжидаемоеРасширение = "." + НРег(Расширение);
	Если НЕ СтрЗаканчиваетсяНа(НРег(Имя), ОжидаемоеРасширение) Тогда
		Точка = СтрНайти(Имя, ".", НаправлениеПоиска.СКонца);
		Если Точка > 1 Тогда
			Имя = Лев(Имя, Точка - 1);
		КонецЕсли;
		Имя = Имя + ОжидаемоеРасширение;
	КонецЕсли;

	Возврат Имя;

КонецФункции

// Убирает из имени файла недопустимые символы и служебные хвосты.
//
// Параметры:
//  Имя - Строка - исходное имя.
//
// Возвращаемое значение:
//  Строка - очищенное имя.
Функция ЗаменитьНедопустимыеСимволыИмени(Имя)

	Результат = Строка(Имя);
	Недопустимые = "\\/:*?""<>|" + Символы.ПС + Символы.ВК + Символы.Таб;
	Для Индекс = 1 По СтрДлина(Недопустимые) Цикл
		Результат = СтрЗаменить(Результат, Сред(Недопустимые, Индекс, 1), "_");
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции

// Строит табличный документ выгрузки: шапка жирным с фоном, данные под ней.
//
// Параметры:
//  Строки - Массив из Соответствие - строки с сырыми значениями.
//  Колонки - Массив из Строка - имена колонок.
//
// Возвращаемое значение:
//  ТабличныйДокумент - готовый документ.
Функция ПостроитьТабличныйДокумент(Строки, Колонки)

	Документ = Новый ТабличныйДокумент;

	НомерКолонки = 0;
	Для Каждого ИмяКолонки Из Колонки Цикл
		НомерКолонки = НомерКолонки + 1;
		ОбластьШапки = Документ.Область(1, НомерКолонки, 1, НомерКолонки);
		ОбластьШапки.Текст = Строка(ИмяКолонки);
		ОбластьШапки.Шрифт = Новый Шрифт(, , Истина); // АПК:1345
		ОбластьШапки.ЦветФона = Новый Цвет(238, 242, 255); // АПК:1345
		ОбластьШапки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Документ.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = 18;
	КонецЦикла;

	// Данные пишутся в ячейки итогового документа напрямую: механизм параметров
	// (Параметр у ячеек программного макета + Параметры.Заполнить) при записи в
	// XLSX оставляет в ячейках имена параметров (Значение1, Значение2, ...).
	// Числа и даты пишутся типизированными (СодержитЗначение), чтобы тип
	// сохранился при экспорте в XLSX.
	НомерСтроки = 1;
	Для Каждого СтрокаДанных Из Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		НомерКолонки = 0;
		Для Каждого ИмяКолонки Из Колонки Цикл
			НомерКолонки = НомерКолонки + 1;
			ЗаполнитьЯчейкуВыгрузки(
				Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки),
				СтрокаДанных.Получить(ИмяКолонки));
		КонецЦикла;
	КонецЦикла;

	Возврат Документ;

КонецФункции


// Записывает значение в ячейку выгрузки и задаёт её оформление. Тип значения
// определяется один раз: числа и даты пишутся типизированными (СодержитЗначение),
// чтобы тип сохранился при экспорте в XLSX; булево выводится как "Да"/"Нет",
// прочие значения - строкой (для Неопределено - пустая ячейка).
//
// Параметры:
//  Область - ОбластьЯчеекТабличногоДокумента - ячейка.
//  Значение - Произвольный - сырое значение данных.
Процедура ЗаполнитьЯчейкуВыгрузки(Область, Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Число") Тогда
		Область.СодержитЗначение = Истина;
		Область.Значение = Значение;
		Область.Формат = "ЧДЦ=2; ЧГ=";
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Область.СодержитЗначение = Истина;
		Область.Значение = Значение;
		Область.Формат = "ДЛФ=DT";
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Авто;
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Область.Текст = ?(Значение, "Да", "Нет");
		Область.Формат = "";
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Авто;
	Иначе
		Область.Текст = Строка(Значение);
		Область.Формат = "";
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Авто;
	КонецЕсли;

КонецПроцедуры

// Записывает табличный документ в двоичные данные XLSX через временный файл:
// поток в памяти на большом документе (до 100 000 строк) держит лишнюю копию
// всего файла, поэтому запись идёт на диск, а в память читается готовый файл.
//
// Параметры:
//  Документ - ТабличныйДокумент - документ.
//
// Возвращаемое значение:
//  ДвоичныеДанные,Неопределено - данные файла; Неопределено при ошибке записи.
Функция ЗаписатьТабличныйДокументВXLSX(Документ)

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанные = Неопределено;

	Попытка
		Документ.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Исключение
		ЗаписьЖурналаРегистрации("СИ_Инструменты1С.ЗаписьXLSX",
			УровеньЖурналаРегистрации.Ошибка, , , "Ошибка записи XLSX: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ЗаписьЖурналаРегистрации("СИ_Инструменты1С.УдалениеВременногоФайла",
			УровеньЖурналаРегистрации.Информация, , , "Не удалось удалить временный файл: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат ДвоичныеДанные;

КонецФункции

// Первые строки результата в текстовом виде для модели (не более 5).
//
// Параметры:
//  Строки - Массив из Соответствие - строки выгрузки.
//  Колонки - Массив из Строка - имена колонок.
//  Максимум - Число - сколько строк вернуть.
//
// Возвращаемое значение:
//  Массив из Соответствие - строки со строковыми значениями.
Функция ПервыеСтрокиДляМодели(Строки, Колонки, Максимум)

	Результат = Новый Массив;
	Количество = Мин(Максимум, Строки.Количество());
	Для Индекс = 0 По Количество - 1 Цикл
		СтрокаРезультата = Новый Соответствие;
		Для Каждого ИмяКолонки Из Колонки Цикл
			СтрокаРезультата.Вставить(ИмяКолонки,
				ЗначениеДляМодели(Строки[Индекс].Получить(ИмяКолонки)));
		КонецЦикла;
		Результат.Добавить(СтрокаРезультата);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строковое представление значения ячейки для модели.
//
// Параметры:
//  Значение - Произвольный - значение.
//
// Возвращаемое значение:
//  Строка - представление.
Функция ЗначениеДляМодели(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='yyyy-MM-dd HH:mm:ss'");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧДЦ=2; ЧГ=");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Итоги по числовым колонкам (не более 5 колонок - чтобы результат не раздувал
// контекст модели). Колонка считается числовой, если в ней есть числа.
//
// Параметры:
//  Строки - Массив из Соответствие - строки выгрузки.
//  Колонки - Массив из Строка - имена колонок.
//
// Возвращаемое значение:
//  Структура - имя колонки -> сумма.
Функция ИтогиПоЧисловымКолонкам(Строки, Колонки)

	Итоги = Новый Структура;
	КолонокСИтогами = 0;

	Для Каждого ИмяКолонки Из Колонки Цикл
		Если КолонокСИтогами >= 5 Тогда
			Прервать;
		КонецЕсли;

		Сумма = 0;
		ЕстьЧисла = Ложь;
		Для Каждого СтрокаДанных Из Строки Цикл
			Значение = СтрокаДанных.Получить(ИмяКолонки);
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Сумма = Сумма + Значение;
				ЕстьЧисла = Истина;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьЧисла Тогда
			Итоги.Вставить(ИмяКолонки, Сумма);
			КолонокСИтогами = КолонокСИтогами + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Строит SVG-диаграмму (столбцы, линия, круг). Подписи экранируются;
// цвета задаются классами si-chart-* (палитра темы чата), поэтому диаграмма
// перекрашивается вместе с темой до перерисовки документа.
//
// Параметры:
//  Строки - Массив из Соответствие - строки выборки.
//  Тип - Строка - "столбцы" | "линия" | "круг".
//  КолонкаКатегорий - Строка - колонка подписей.
//  КолонкаЗначений - Строка - числовая колонка.
//  Заголовок - Строка - заголовок диаграммы.
//
// Возвращаемое значение:
//  Строка - разметка SVG; пустая строка, если числовых значений нет.
Функция ПостроитьSVGДиаграмму(Строки, Тип, КолонкаКатегорий, КолонкаЗначений, Заголовок)

	Категории = Новый Массив;
	Значения = Новый Массив;

	Для Каждого СтрокаДанных Из Строки Цикл
		ЧислоЗначения = ЧислоИлиНеопределено(СтрокаДанных.Получить(КолонкаЗначений));
		Если ЧислоЗначения = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Категории.Добавить(ПодписьКатегории(СтрокаДанных.Получить(КолонкаКатегорий)));
		Значения.Добавить(ЧислоЗначения);
	КонецЦикла;

	Если Значения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если Тип = "круг" Тогда
		Возврат SVGКруговаяДиаграмма(Категории, Значения, Заголовок);
	ИначеЕсли Тип = "линия" Тогда
		Возврат SVGЛинейнаяДиаграмма(Категории, Значения, Заголовок);
	КонецЕсли;

	Возврат SVGСтолбчатаяДиаграмма(Категории, Значения, Заголовок);

КонецФункции

// Число из значения ячейки либо Неопределено, если значение не числовое.
//
// Параметры:
//  Значение - Произвольный - значение ячейки.
//
// Возвращаемое значение:
//  Число,Неопределено - числовое значение.
Функция ЧислоИлиНеопределено(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(Значение) Тогда
		Попытка
			Возврат Число(СтрЗаменить(СокрЛП(Значение), ",", "."));
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Подпись категории для диаграммы: дата - коротко, прочее - как есть.
//
// Параметры:
//  Значение - Произвольный - значение колонки категорий.
//
// Возвращаемое значение:
//  Строка - подпись.
Функция ПодписьКатегории(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=D");
	КонецЕсли;

	Представление = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Представление) Тогда
		Возврат "-";
	КонецЕсли;

	Если СтрДлина(Представление) > 18 Тогда
		Возврат Лев(Представление, 17) + "…";
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Строит столбчатую диаграмму.
//
// Параметры:
//  Категории - Массив из Строка - подписи.
//  Значения - Массив из Число - значения.
//  Заголовок - Строка - заголовок.
//
// Возвращаемое значение:
//  Строка - SVG.
Функция SVGСтолбчатаяДиаграмма(Категории, Значения, Заголовок)

	Геометрия = Новый Структура;
	Геометрия.Вставить("Ширина", 720);
	Геометрия.Вставить("Высота", 360);
	Геометрия.Вставить("Лево", 64);
	Геометрия.Вставить("Право", 24);
	Геометрия.Вставить("Верх", 52);
	Геометрия.Вставить("Низ", 78);

	Диапазон = ДиапазонЗначений(Значения);
	ОбластьШ = Геометрия.Ширина - Геометрия.Лево - Геометрия.Право;
	ОбластьВ = Геометрия.Высота - Геометрия.Верх - Геометрия.Низ;

	Части = Новый Массив;
	Части.Добавить(НачалоСVG(Заголовок));
	Части.Добавить(СеткаSVG(Геометрия, Диапазон, ОбластьВ));

	КоличествоТочек = Значения.Количество();
	Шаг = ОбластьШ / КоличествоТочек;
	ШиринаСтолбца = Мин(56, Шаг * 0.65);

	Для Индекс = 0 По КоличествоТочек - 1 Цикл
		ЦентрX = Геометрия.Лево + Шаг * (Индекс + 0.5);
		ВерхY = YНаДиаграмме(Значения[Индекс], Диапазон, Геометрия, ОбластьВ);
		НольY = YНаДиаграмме(0, Диапазон, Геометрия, ОбластьВ);
		ВерхСтолбца = Мин(ВерхY, НольY);
		ВысотаСтолбца = Макс(1, Макс(ВерхY, НольY) - Мин(ВерхY, НольY));

		Части.Добавить("<rect class=""si-chart-bar"" x="""
			+ ЧислоВSVG(ЦентрX - ШиринаСтолбца / 2) + """ y=""" + ЧислоВSVG(ВерхСтолбца)
			+ """ width=""" + ЧислоВSVG(ШиринаСтолбца) + """ height=""" + ЧислоВSVG(ВысотаСтолбца)
			+ """ rx=""2""/>");

		Если КоличествоТочек <= 15 Тогда
			Части.Добавить("<text class=""si-chart-value"" x=""" + ЧислоВSVG(ЦентрX)
				+ """ y=""" + ЧислоВSVG(ВерхСтолбца - 5) + """ text-anchor=""middle"" font-size=""10"">"
				+ ЭкранироватьXML(ПодписьЧисла(Значения[Индекс])) + "</text>");
		КонецЕсли;
	КонецЦикла;

	Части.Добавить(ПодписиОсиX(Категории, Геометрия, ОбластьШ, ОбластьВ));
	Части.Добавить("</svg>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Строит линейную диаграмму.
//
// Параметры:
//  Категории - Массив из Строка - подписи.
//  Значения - Массив из Число - значения.
//  Заголовок - Строка - заголовок.
//
// Возвращаемое значение:
//  Строка - SVG.
Функция SVGЛинейнаяДиаграмма(Категории, Значения, Заголовок)

	Геометрия = Новый Структура;
	Геометрия.Вставить("Ширина", 720);
	Геометрия.Вставить("Высота", 360);
	Геометрия.Вставить("Лево", 64);
	Геометрия.Вставить("Право", 24);
	Геометрия.Вставить("Верх", 52);
	Геометрия.Вставить("Низ", 78);

	Диапазон = ДиапазонЗначений(Значения);
	ОбластьШ = Геометрия.Ширина - Геометрия.Лево - Геометрия.Право;
	ОбластьВ = Геометрия.Высота - Геометрия.Верх - Геометрия.Низ;

	Части = Новый Массив;
	Части.Добавить(НачалоСVG(Заголовок));
	Части.Добавить(СеткаSVG(Геометрия, Диапазон, ОбластьВ));

	КоличествоТочек = Значения.Количество();
	Шаг = ?(КоличествоТочек > 1, ОбластьШ / (КоличествоТочек - 1), 0);
	Точки = Новый Массив;
	Для Индекс = 0 По КоличествоТочек - 1 Цикл
		ТочкаX = Геометрия.Лево + Шаг * Индекс;
		ТочкаY = YНаДиаграмме(Значения[Индекс], Диапазон, Геометрия, ОбластьВ);
		Точки.Добавить(ЧислоВSVG(ТочкаX) + "," + ЧислоВSVG(ТочкаY));
	КонецЦикла;

	Части.Добавить("<polyline class=""si-chart-line"" fill=""none"" points="""
		+ СтрСоединить(Точки, " ") + """/>");

	Для Индекс = 0 По КоличествоТочек - 1 Цикл
		ТочкаX = Геометрия.Лево + Шаг * Индекс;
		ТочкаY = YНаДиаграмме(Значения[Индекс], Диапазон, Геометрия, ОбластьВ);
		Части.Добавить("<circle class=""si-chart-point"" cx=""" + ЧислоВSVG(ТочкаX)
			+ """ cy=""" + ЧислоВSVG(ТочкаY) + """ r=""3""/>");
		Если КоличествоТочек <= 15 Тогда
			Части.Добавить("<text class=""si-chart-value"" x=""" + ЧислоВSVG(ТочкаX)
				+ """ y=""" + ЧислоВSVG(ТочкаY - 8) + """ text-anchor=""middle"" font-size=""10"">"
				+ ЭкранироватьXML(ПодписьЧисла(Значения[Индекс])) + "</text>");
		КонецЕсли;
	КонецЦикла;

	Части.Добавить(ПодписиОсиX(Категории, Геометрия, ОбластьШ, ОбластьВ, Истина));
	Части.Добавить("</svg>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Строит круговую диаграмму. Лишние точки (сверх 12) сворачиваются в «Прочие»,
// отрицательные и нулевые значения не рисуются.
//
// Параметры:
//  Категории - Массив из Строка - подписи.
//  Значения - Массив из Число - значения.
//  Заголовок - Строка - заголовок.
//
// Возвращаемое значение:
//  Строка - SVG; пустая строка, если положительных значений нет.
Функция SVGКруговаяДиаграмма(Категории, Значения, Заголовок)

	КатегорииПоложительные = Новый Массив;
	ЗначенияПоложительные = Новый Массив;
	Для Индекс = 0 По Значения.Количество() - 1 Цикл
		Если Значения[Индекс] > 0 Тогда
			КатегорииПоложительные.Добавить(Категории[Индекс]);
			ЗначенияПоложительные.Добавить(Значения[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Если ЗначенияПоложительные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Если ЗначенияПоложительные.Количество() > 12 Тогда
		СуммаПрочих = 0;
		Для Индекс = 11 По ЗначенияПоложительные.Количество() - 1 Цикл
			СуммаПрочих = СуммаПрочих + ЗначенияПоложительные[Индекс];
		КонецЦикла;
		Пока ЗначенияПоложительные.Количество() > 11 Цикл
			ЗначенияПоложительные.Удалить(11);
			КатегорииПоложительные.Удалить(11);
		КонецЦикла;
		КатегорииПоложительные.Добавить("Прочие");
		ЗначенияПоложительные.Добавить(СуммаПрочих);
	КонецЕсли;

	Сумма = 0;
	Для Каждого Значение Из ЗначенияПоложительные Цикл
		Сумма = Сумма + Значение;
	КонецЦикла;
	Если Сумма <= 0 Тогда
		Возврат "";
	КонецЕсли;

	ЦентрX = 210;
	ЦентрY = 205;
	Радиус = 128;

	Части = Новый Массив;
	Части.Добавить(НачалоСVG(Заголовок));

	УголНачала = -90;
	Для Индекс = 0 По ЗначенияПоложительные.Количество() - 1 Цикл
		Доля = ЗначенияПоложительные[Индекс] / Сумма;
		УголКонца = УголНачала + Доля * 360;
		КлассСегмента = "si-chart-seg" + Строка(Индекс % 5);

		Если Доля >= 0.9999 Тогда
			Части.Добавить("<circle class=""" + КлассСегмента + """ cx="""
				+ ЧислоВSVG(ЦентрX) + """ cy=""" + ЧислоВSVG(ЦентрY) + """ r=""" + ЧислоВSVG(Радиус) + """/>");
		Иначе
			НачалоТочки = ТочкаНаОкружности(ЦентрX, ЦентрY, Радиус, УголНачала);
			КонецТочки = ТочкаНаОкружности(ЦентрX, ЦентрY, Радиус, УголКонца);
			БольшаяДуга = ?(УголКонца - УголНачала > 180, 1, 0);

			Части.Добавить("<path class=""" + КлассСегмента
				+ """ d=""M " + ЧислоВSVG(ЦентрX) + " " + ЧислоВSVG(ЦентрY)
				+ " L " + НачалоТочки
				+ " A " + ЧислоВSVG(Радиус) + " " + ЧислоВSVG(Радиус)
				+ " 0 " + Строка(БольшаяДуга) + " 1 " + КонецТочки + " Z""/>");
		КонецЕсли;

		УголНачала = УголКонца;
	КонецЦикла;

	ЛегендаX = 392;
	ЛегендаY = 74;
	Для Индекс = 0 По ЗначенияПоложительные.Количество() - 1 Цикл
		Доля = ЗначенияПоложительные[Индекс] / Сумма;
		YСтроки = ЛегендаY + Индекс * 24;
		КлассСегмента = "si-chart-seg" + Строка(Индекс % 5);
		Части.Добавить("<rect class=""" + КлассСегмента
			+ """ x=""" + ЧислоВSVG(ЛегендаX) + """ y=""" + ЧислоВSVG(YСтроки - 11)
			+ """ width=""12"" height=""12"" rx=""2""/>");
		Части.Добавить("<text class=""si-chart-legend"" x=""" + ЧислоВSVG(ЛегендаX + 20)
			+ """ y=""" + ЧислоВSVG(YСтроки) + """ font-size=""11"">"
			+ ЭкранироватьXML(КатегорииПоложительные[Индекс]) + " - "
			+ ЭкранироватьXML(Формат(Доля * 100, "ЧН=0; ЧДЦ=0; ЧГ=0")) + "% ("
			+ ЭкранироватьXML(ПодписьЧисла(ЗначенияПоложительные[Индекс])) + ")</text>");
	КонецЦикла;

	Части.Добавить("</svg>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Начало SVG-документа с заголовком.
//
// Параметры:
//  Заголовок - Строка - заголовок диаграммы.
//
// Возвращаемое значение:
//  Строка - открывающий тег и заголовок.
Функция НачалоСVG(Заголовок)

	Возврат "<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 720 360"" width=""100%"" "
		+ "role=""img"" aria-label=""" + ЭкранироватьXML(Заголовок) + """>"
		+ "<text class=""si-chart-svg-title"" x=""64"" y=""30"" font-size=""16"" font-weight=""600"">"
		+ ЭкранироватьXML(Заголовок) + "</text>";

КонецФункции

// Сетка и подписи оси Y.
//
// Параметры:
//  Геометрия - Структура - размеры и отступы.
//  Диапазон - Структура - Мин, Макс.
//  ОбластьВ - Число - высота области графика.
//
// Возвращаемое значение:
//  Строка - разметка сетки.
Функция СеткаSVG(Геометрия, Диапазон, ОбластьВ)

	Части = Новый Массив;
	Для Индекс = 0 По 4 Цикл
		Уровень = Диапазон.Мин + (Диапазон.Макс - Диапазон.Мин) * Индекс / 4;
		Y = Геометрия.Верх + ОбластьВ - ОбластьВ * Индекс / 4;
		Части.Добавить("<line class=""si-chart-grid"" x1=""" + ЧислоВSVG(Геометрия.Лево)
			+ """ y1=""" + ЧислоВSVG(Y) + """ x2=""" + ЧислоВSVG(Геометрия.Ширина - Геометрия.Право)
			+ """ y2=""" + ЧислоВSVG(Y) + """/>");
		Части.Добавить("<text class=""si-chart-label"" x=""" + ЧислоВSVG(Геометрия.Лево - 8)
			+ """ y=""" + ЧислоВSVG(Y + 4) + """ text-anchor=""end"" font-size=""11"">"
			+ ЭкранироватьXML(ПодписьЧисла(Уровень)) + "</text>");
	КонецЦикла;

	Части.Добавить("<line class=""si-chart-axis"" x1=""" + ЧислоВSVG(Геометрия.Лево)
		+ """ y1=""" + ЧислоВSVG(Геометрия.Верх) + """ x2=""" + ЧислоВSVG(Геометрия.Лево)
		+ """ y2=""" + ЧислоВSVG(Геометрия.Верх + ОбластьВ) + """/>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Подписи категорий под осью X (при большом числе точек - каждая N-я).
//
// Параметры:
//  Категории - Массив из Строка - подписи.
//  Геометрия - Структура - размеры и отступы.
//  ОбластьШ - Число - ширина области графика.
//  ОбластьВ - Число - высота области графика.
//  ПоТочкам - Булево - Истина для линейной диаграммы: подписи ставятся под
//    точками графика (первая на левом краю, последняя на правом), а не по
//    центрам полос.
//
// Возвращаемое значение:
//  Строка - разметка подписей.
Функция ПодписиОсиX(Категории, Геометрия, ОбластьШ, ОбластьВ, ПоТочкам = Ложь)

	КоличествоТочек = Категории.Количество();
	Части = Новый Массив;

	ШагПодписи = ?(КоличествоТочек > 14, Цел((КоличествоТочек + 11) / 12), 1);
	Если ПоТочкам Тогда
		ШагX = ?(КоличествоТочек > 1, ОбластьШ / (КоличествоТочек - 1), 0);
	Иначе
		ШагX = ОбластьШ / КоличествоТочек;
	КонецЕсли;
	YПодписи = Геометрия.Верх + ОбластьВ + 20;

	Для Индекс = 0 По КоличествоТочек - 1 Цикл
		Если ШагПодписи > 1 И Индекс % ШагПодписи <> 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ПоТочкам Тогда
			ЦентрX = Геометрия.Лево + ШагX * Индекс;
		Иначе
			ЦентрX = Геометрия.Лево + ШагX * (Индекс + 0.5);
		КонецЕсли;
		Части.Добавить("<text class=""si-chart-label"" x=""" + ЧислоВSVG(ЦентрX)
			+ """ y=""" + ЧислоВSVG(YПодписи) + """ text-anchor=""middle"" font-size=""11"">"
			+ ЭкранироватьXML(Категории[Индекс]) + "</text>");
	КонецЦикла;

	Части.Добавить("<line class=""si-chart-axis"" x1=""" + ЧислоВSVG(Геометрия.Лево)
		+ """ y1=""" + ЧислоВSVG(Геометрия.Верх + ОбластьВ)
		+ """ x2=""" + ЧислоВSVG(Геометрия.Ширина - Геометрия.Право)
		+ """ y2=""" + ЧислоВSVG(Геометрия.Верх + ОбластьВ) + """/>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Диапазон значений для вертикальной оси.
//
// Параметры:
//  Значения - Массив из Число - значения.
//
// Возвращаемое значение:
//  Структура - Мин, Макс (Макс > Мин всегда).
Функция ДиапазонЗначений(Значения)

	МинЗначение = 0;
	МаксЗначение = 0;
	Для Каждого Значение Из Значения Цикл
		МинЗначение = Мин(МинЗначение, Значение);
		МаксЗначение = Макс(МаксЗначение, Значение);
	КонецЦикла;

	Если МаксЗначение = МинЗначение Тогда
		Если МаксЗначение = 0 Тогда
			МаксЗначение = 1;
		Иначе
			МаксЗначение = МинЗначение + 1;
		КонецЕсли;
	КонецЕсли;

	Диапазон = Новый Структура;
	Диапазон.Вставить("Мин", МинЗначение);
	Диапазон.Вставить("Макс", МаксЗначение);
	Возврат Диапазон;

КонецФункции

// Координата Y значения на диаграмме.
//
// Параметры:
//  Значение - Число - значение.
//  Диапазон - Структура - Мин, Макс.
//  Геометрия - Структура - размеры и отступы.
//  ОбластьВ - Число - высота области.
//
// Возвращаемое значение:
//  Число - координата Y.
Функция YНаДиаграмме(Значение, Диапазон, Геометрия, ОбластьВ)

	Возврат Геометрия.Верх + (Диапазон.Макс - Значение) / (Диапазон.Макс - Диапазон.Мин) * ОбластьВ;

КонецФункции

// Точка на окружности для круговой диаграммы.
//
// Параметры:
//  ЦентрX - Число - X центра.
//  ЦентрY - Число - Y центра.
//  Радиус - Число - радиус.
//  УголГрадусов - Число - угол в градусах (0 - вправо, по часовой стрелке).
//
// Возвращаемое значение:
//  Строка - "x y" для path.
Функция ТочкаНаОкружности(ЦентрX, ЦентрY, Радиус, УголГрадусов)

	УголРадиан = УголГрадусов * 3.141592653589793 / 180;
	Возврат ЧислоВSVG(ЦентрX + Радиус * Cos(УголРадиан)) + " "
		+ ЧислоВSVG(ЦентрY + Радиус * Sin(УголРадиан));

КонецФункции

// Число в формате SVG (точка как десятичный разделитель, без разделителей групп).
//
// Параметры:
//  Значение - Число - значение.
//
// Возвращаемое значение:
//  Строка - представление числа.
Функция ЧислоВSVG(Значение)

	Возврат СтрЗаменить(Формат(Значение, "ЧДЦ=2; ЧГ="), ",", ".");

КонецФункции

// Подпись числа для осей и легенды: целые - без дробной части.
//
// Параметры:
//  Значение - Число - значение.
//
// Возвращаемое значение:
//  Строка - подпись.
Функция ПодписьЧисла(Значение)

	Если Цел(Значение) = Значение Тогда
		Возврат Формат(Значение, "ЧН=0; ЧДЦ=0; ЧГ=0");
	КонецЕсли;

	Возврат Формат(Значение, "ЧДЦ=2; ЧГ=");

КонецФункции

// Экранирует текст для XML/SVG.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - экранированный текст.
Функция ЭкранироватьXML(Знач Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат СтрЗаменить(Результат, "'", "&#39;");

КонецФункции

#КонецОбласти

#Область ИнструментыОбзора

// Новый результат инструмента.
//
// Возвращаемое значение:
//  Структура - {Успех: Ложь, Значение: Неопределено, Ошибка: Неопределено}.
Функция НовыйРезультатИнструмента()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);
	Возврат Результат;

КонецФункции

// Значение сводки по контракту (Период, Показатели, Строки, Подсказка).
//
// Параметры:
//  Период - Строка - подпись периода.
//  Показатели - Массив из Структура - показатели.
//  Строки - Массив из Структура - детализация.
//  Подсказка - Строка - следующий шаг для модели.
//
// Возвращаемое значение:
//  Структура - значение результата.
Функция НовоеЗначениеСводки(Период, Показатели, Строки, Подсказка)

	Значение = Новый Структура;
	Значение.Вставить("Период", Период);
	Значение.Вставить("Показатели", Показатели);
	Значение.Вставить("Строки", Строки);
	Значение.Вставить("Подсказка", Подсказка);
	Возврат Значение;

КонецФункции

// Показатель сводки.
//
// Параметры:
//  Код - Строка - код показателя.
//  Заголовок - Строка - человекочитаемый заголовок.
//  Значение - Число,Строка - значение.
//  Единица - Строка - единица измерения.
//  Сравнение - Строка - с чем сравнивается (пусто, если не сравнивается).
//  ИзменениеПроцентов - Число,Неопределено - изменение в процентах.
//  Важность - Строка - "Высокая" | "Средняя" | "Обычная".
//  Пояснение - Строка - пояснение.
//
// Возвращаемое значение:
//  Структура - показатель.
Функция НовыйПоказатель(Код, Заголовок, Значение, Единица, Сравнение, ИзменениеПроцентов, Важность, Пояснение)

	Показатель = Новый Структура;
	Показатель.Вставить("Код", Код);
	Показатель.Вставить("Заголовок", Заголовок);
	Показатель.Вставить("Значение", Значение);
	Показатель.Вставить("Единица", Единица);
	Показатель.Вставить("Сравнение", Сравнение);
	Показатель.Вставить("ИзменениеПроцентов", ИзменениеПроцентов);
	Показатель.Вставить("Важность", Важность);
	Показатель.Вставить("Пояснение", Пояснение);
	Возврат Показатель;

КонецФункции

// Схема строкового параметра-даты.
//
// Параметры:
//  Подсказка - Строка - описание параметра.
//
// Возвращаемое значение:
//  Соответствие - JSON Schema параметра.
Функция ОписаниеПараметраДаты(Подсказка)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", "string");
	Свойство.Вставить("description", Подсказка);
	Возврат Свойство;

КонецФункции


// Текст ошибки «в базе нет подходящих объектов»: один ответ, без серии
// пробных запросов, с подсказкой перейти к ExecuteDBQuery.
//
// Параметры:
//  Тема - Строка - что искали («продаж»).
//  Что - Строка - какой объект ожидался.
//
// Возвращаемое значение:
//  Строка - текст ошибки.
Функция ТекстОтсутствияОбъектов(Тема, Что)

	Возврат "В этой базе не найдены объекты " + Тема + ": ожидался " + Что + ". "
		+ "Обзорная сводка недоступна. Используйте ExecuteDBQuery по конкретным таблицам, "
		+ "найденным через GetMetadataSchema, либо уточните у пользователя, где ведутся эти данные. "
		+ "Не выполняйте серию пробных запросов.";

КонецФункции

// Критерий поиска регистра сводки. Ключ различает критерии в общем проходе
// (ДоступностьОбзоров), Лучший/ЛучшийСчет накапливают результат поиска.
//
// Параметры:
//  Ключ - Строка - идентификатор критерия в результате.
//  ПризнакиИмени - Строка - признаки через запятую (имя/синоним регистра).
//  ПризнакиРесурсов - Строка - признаки имен ресурсов.
//  ПризнакиИзмерений - Строка - признаки имен измерений.
//  ТребуемыйВид - Строка - "Остатки" | "Обороты" | "" (любой).
//
// Возвращаемое значение:
//  Структура - критерий поиска.
Функция КритерийПоискаРегистраСводки(Ключ, ПризнакиИмени, ПризнакиРесурсов, ПризнакиИзмерений, ТребуемыйВид)

	Критерий = Новый Структура;
	Критерий.Вставить("Ключ", Ключ);
	Критерий.Вставить("ПризнакиИмени", ПризнакиИмени);
	Критерий.Вставить("ПризнакиРесурсов", ПризнакиРесурсов);
	Критерий.Вставить("ПризнакиИзмерений", ПризнакиИзмерений);
	Критерий.Вставить("ТребуемыйВид", ТребуемыйВид);
	Критерий.Вставить("Лучший", Неопределено);
	Критерий.Вставить("ЛучшийСчет", 0);

	Возврат Критерий;

КонецФункции

