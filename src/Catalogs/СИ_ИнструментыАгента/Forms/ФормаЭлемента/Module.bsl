#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	Объект.ТипИнструмента = Перечисления.СИ_ТипыИнструментов.Инструмент1С;

	Если Объект.Ссылка.Пустая() Тогда

		Объект.Разрешен = Истина;
		Объект.ДатаРегистрации = ТекущаяУниверсальнаяДата();
		
		Объект.Родитель = СИ_УправлениеИнструментами1С.СсылкаГруппыПоУмолчанию();

		Объект.ПараметрыSchema = "{""type"": ""object"", ""properties"": {""Параметр1"": {""type"": ""string"", ""description"": ""Описание параметра""}}, ""required"": [""Параметр1""]}";

	КонецЕсли;
	
	Если Объект.ИмяФункции = "ExecuteDBQuery" Тогда
	
		МассивСтрок = СтрРазделить(Константы.СИ_ЗапрещенныеОбъектыЗапросов.Получить(), ";", Ложь);
		ЗапрещенныеОбъектыЗапросов.ЗагрузитьЗначения(МассивСтрок);
		
		Элементы.ГруппаНастройкиИнструмента.Видимость = Истина;
	
	КонецЕсли;
	
	ОбновитьВидимостьПоТипуИнструмента();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.ИмяФункции = "ExecuteDBQuery" Тогда
		
		СтрокаОбъектов = СобратьЗапрещенныеОбъектыВСтроку(ЗапрещенныеОбъектыЗапросов);
		Константы.СИ_ЗапрещенныеОбъектыЗапросов.Установить(СтрокаОбъектов);
		
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипИнструментаПриИзменении(Элемент)
	УстановитьТипИнструментаНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодобратьМетаданные(Команда)
	
	ПараметрыФормы = ПараметрыВыбораОбъектовМетаданныхДляФормы();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПодобратьМетаданныеЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборОбъектовМетаданных", ПараметрыФормы, ЭтотОбъект,,,,
		ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СобратьЗапрещенныеОбъектыВСтроку(СписокЗапрещенныхОбъектов)
	
	Значения = Новый Массив;
	Если СписокЗапрещенныхОбъектов = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Элемент Из СписокЗапрещенныхОбъектов Цикл
		ИмяОбъекта = СокрЛП(Строка(Элемент.Значение));
		Если НЕ ПустаяСтрока(ИмяОбъекта) Тогда
			Значения.Добавить(ИмяОбъекта);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Значения, ";");

КонецФункции

&НаКлиенте
Процедура ПодобратьМетаданныеЗавершение(ВыбранныеОбъектыМетаданных, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеОбъектыМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДобавленных = 0;
	Для Каждого ЭлементВыбора Из ВыбранныеОбъектыМетаданных Цикл
		ИмяОбъекта = СокрЛП(Строка(ЭлементВыбора.Значение));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗапрещенныеОбъектыЗапросов.НайтиПоЗначению(ИмяОбъекта) = Неопределено Тогда
			ЗапрещенныеОбъектыЗапросов.Добавить(ИмяОбъекта);
			КоличествоДобавленных = КоличествоДобавленных + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоДобавленных = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выбранные объекты уже присутствуют в списке.'"));
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыВыбораОбъектовМетаданныхДляФормы()
	
	ПараметрыФормы = СтандартныеПодсистемыКлиентСервер.ПараметрыВыбораОбъектовМетаданных();
	
	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("Справочники");
	ИменаКоллекций.Добавить("Документы");
	ИменаКоллекций.Добавить("Перечисления");
	ИменаКоллекций.Добавить("ЖурналыДокументов");
	ИменаКоллекций.Добавить("ПланыВидовХарактеристик");
	ИменаКоллекций.Добавить("ПланыСчетов");
	ИменаКоллекций.Добавить("ПланыВидовРасчета");
	ИменаКоллекций.Добавить("РегистрыСведений");
	ИменаКоллекций.Добавить("РегистрыНакопления");
	ИменаКоллекций.Добавить("РегистрыБухгалтерии");
	ИменаКоллекций.Добавить("РегистрыРасчета");
	ИменаКоллекций.Добавить("БизнесПроцессы");
	ИменаКоллекций.Добавить("Задачи");
	
	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		ПараметрыФормы.КоллекцииВыбираемыхОбъектовМетаданных.Добавить(ИмяКоллекции);
	КонецЦикла;
	
	ПараметрыФормы.Заголовок = НСтр("ru = 'Выбор запрещенных объектов метаданных'");
	ПараметрыФормы.ВыборЕдинственного = Ложь;
	ПараметрыФормы.СпособГруппировкиОбъектов = "ПоВидам";
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервере
Процедура УстановитьТипИнструментаНаСервере()
	Объект.ТипИнструмента = Перечисления.СИ_ТипыИнструментов.Инструмент1С;
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьПоТипуИнструмента()

	ЭлементТипИнструмента = Элементы.Найти("ТипИнструмента");
	Если ЭлементТипИнструмента <> Неопределено Тогда
		ЭлементТипИнструмента.Видимость = Ложь;
	КонецЕсли;

	ЭлементОбработчик = Элементы.Найти("ИмяФункцииОбработчика");
	Если ЭлементОбработчик <> Неопределено Тогда
		ЭлементОбработчик.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
