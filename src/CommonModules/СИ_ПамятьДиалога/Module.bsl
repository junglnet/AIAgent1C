// Добавляет или перезаписывает один факт памяти диалога.
//
// Параметры:
//  ИдДиалога   - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  ТипФакта    - Строка - тип факта (см. ТипФакта*).
//  Ключ        - Строка - уникализирующий ключ факта (до 100 символов).
//  Значение    - Строка - текст факта.
//  Сортировка  - Число,Неопределено - приоритет (по умолчанию 50).
//  АктуальноДо - Дата,Неопределено - TTL факта; пустая дата = бессрочно.
//  Источник    - Строка - откуда факт (номер сообщения/имя инструмента).
//  Пользователь- СправочникСсылка.Пользователи,Неопределено - владелец.
//
// Возвращаемое значение:
//  Булево - Истина при успешной записи.
//
Функция ДобавитьФакт(ИдДиалога, ТипФакта, Ключ, Значение,
	Сортировка = Неопределено, АктуальноДо = Неопределено,
	Источник = "", Пользователь = Неопределено) Экспорт

	МассивФактов = Новый Массив;
	Факт = Новый Структура("ТипФакта,Ключ,Значение,Сортировка,АктуальноДо,Источник,Пользователь",
		ТипФакта, Ключ, Значение, Сортировка, АктуальноДо, Источник, Пользователь);
	МассивФактов.Добавить(Факт);

	Возврат ДобавитьФакты(ИдДиалога, МассивФактов);

КонецФункции

// Пакетно добавляет/перезаписывает факты памяти диалога одним набором записей.
//
// Параметры:
//  ИдДиалога   - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  МассивФактов - Массив из Структура - факты:
//    * ТипФакта    - Строка
//    * Ключ        - Строка
//    * Значение    - Строка
//    * Сортировка  - Число,Неопределено
//    * АктуальноДо - Дата,Неопределено
//    * Источник    - Строка,Неопределено
//    * Пользователь- СправочникСсылка.Пользователи,Неопределено
//
// Возвращаемое значение:
//  Булево - Истина при успешной записи (или пустом массиве).
//
Функция ДобавитьФакты(ИдДиалога, МассивФактов) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если МассивФактов = Неопределено ИЛИ МассивФактов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей = РегистрыСведений.СИ_ПамятьДиалога.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдДиалога.Установить(ИдДиалога);
		НаборЗаписей.Прочитать();

		ТекущаяДатаЗаписи = ТекущаяДата();
		МаксДлинаЗначения = МаксДлинаЗначенияФакта();

		Для Каждого Факт Из МассивФактов Цикл
			ТипФакта = Строка(Факт.ТипФакта);
			Ключ = Строка(Факт.Ключ);
			Значение = Строка(Факт.Значение);
			Если ПустаяСтрока(ТипФакта) ИЛИ ПустаяСтрока(Ключ) Тогда
				Продолжить;
			КонецЕсли;

			ТипФакта = Лев(ТипФакта, 50);
			Ключ = Лев(Ключ, 100);
			Если СтрДлина(Значение) > МаксДлинаЗначения Тогда
				Значение = Лев(Значение, МаксДлинаЗначения) + "...";
			КонецЕсли;

			Сортировка = СортировкаПоУмолчанию();
			Если Факт.Свойство("Сортировка") И Факт.Сортировка <> Неопределено
				И ТипЗнч(Факт.Сортировка) = Тип("Число") Тогда
				Сортировка = Факт.Сортировка;
			КонецЕсли;

			АктуальноДо = Дата(1, 1, 1);
			Если Факт.Свойство("АктуальноДо") И Факт.АктуальноДо <> Неопределено
				И ТипЗнч(Факт.АктуальноДо) = Тип("Дата") Тогда
				АктуальноДо = Факт.АктуальноДо;
			КонецЕсли;

			Источник = "";
			Если Факт.Свойство("Источник") И Факт.Источник <> Неопределено Тогда
				Источник = Лев(Строка(Факт.Источник), 200);
			КонецЕсли;

			ПользовательФакта = Неопределено;
			Если Факт.Свойство("Пользователь") И Факт.Пользователь <> Неопределено
				И ЗначениеЗаполнено(Факт.Пользователь) Тогда
				ПользовательФакта = Факт.Пользователь;
			КонецЕсли;

			НайденнаяЗапись = НайтиЗаписьНабора(НаборЗаписей, ТипФакта, Ключ);
			Если НайденнаяЗапись <> Неопределено Тогда
				НайденнаяЗапись.Значение = Значение;
				НайденнаяЗапись.Сортировка = Сортировка;
				НайденнаяЗапись.ДатаЗаписи = ТекущаяДатаЗаписи;
				НайденнаяЗапись.АктуальноДо = АктуальноДо;
				НайденнаяЗапись.Источник = Источник;
				НайденнаяЗапись.Пользователь = ПользовательФакта;
			Иначе
				Запись = НаборЗаписей.Добавить();
				Запись.ИдДиалога = ИдДиалога;
				Запись.ТипФакта = ТипФакта;
				Запись.Ключ = Ключ;
				Запись.Значение = Значение;
				Запись.Сортировка = Сортировка;
				Запись.ДатаЗаписи = ТекущаяДатаЗаписи;
				Запись.АктуальноДо = АктуальноДо;
				Запись.Источник = Источник;
				Запись.Пользователь = ПользовательФакта;
			КонецЕсли;
		КонецЦикла;

		НаборЗаписей.Записать();

		Попытка
			ЗаписьЖурналаРегистрации("ПамятьДиалога.ДобавлениеФактов", УровеньЖурналаРегистрации.Информация,
				Строка(ИдДиалога),, "Добавлено фактов памяти: " + Строка(МассивФактов.Количество()));
		Исключение
		КонецПопытки;

		УстановитьПривилегированныйРежим(Ложь);

		Возврат Истина;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ЗаписьЖурналаРегистрации("ПамятьДиалога.ДобавлениеФактов", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка записи фактов памяти: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает факты памяти диалога.
//
// Параметры:
//  ИдДиалога     - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  ПараметрыОтбора - Структура,Неопределено:
//    * ТипФакта       - Строка - фильтр по типу факта.
//    * БезПросроченных - Булево - исключить факты с АктуальноДо < текущей даты
//                        (по умолчанию Истина).
//    * Лимит          - Число - максимум записей (Неопределено = без ограничения).
//
// Возвращаемое значение:
//  Массив из Структура - массив фактов со свойствами
//  ТипФакта, Ключ, Значение, Сортировка, ДатаЗаписи, АктуальноДо, Источник, Пользователь.
//
Функция ПолучитьФакты(ИдДиалога, ПараметрыОтбора = Неопределено) Экспорт

	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ТипФактаФильтр = "";
		БезПросроченных = Истина;
		Лимит = 0;

		Если ПараметрыОтбора <> Неопределено Тогда
			Если ПараметрыОтбора.Свойство("ТипФакта") И ПараметрыОтбора.ТипФакта <> Неопределено Тогда
				ТипФактаФильтр = Строка(ПараметрыОтбора.ТипФакта);
			КонецЕсли;
			Если ПараметрыОтбора.Свойство("БезПросроченных") И ПараметрыОтбора.БезПросроченных <> Неопределено Тогда
				БезПросроченных = Булево(ПараметрыОтбора.БезПросроченных);
			КонецЕсли;
			Если ПараметрыОтбора.Свойство("Лимит") И ПараметрыОтбора.Лимит <> Неопределено
				И ТипЗнч(ПараметрыОтбора.Лимит) = Тип("Число") Тогда
				Лимит = Цел(ПараметрыОтбора.Лимит);
			КонецЕсли;
		КонецЕсли;

		Условия = Новый Массив;
		Условия.Добавить("Память.ИдДиалога = &ИдДиалога");
		Если НЕ ПустаяСтрока(ТипФактаФильтр) Тогда
			Условия.Добавить("Память.ТипФакта = &ТипФакта");
		КонецЕсли;
		Если БезПросроченных Тогда
			Условия.Добавить("(Память.АктуальноДо = &ПустаяДата ИЛИ Память.АктуальноДо >= &ТекущаяДата)");
		КонецЕсли;

		Запрос = Новый Запрос;
		Если Лимит > 0 Тогда
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
				|	Память.ТипФакта КАК ТипФакта,
				|	Память.Ключ КАК Ключ,
				|	Память.Значение КАК Значение,
				|	Память.Сортировка КАК Сортировка,
				|	Память.ДатаЗаписи КАК ДатаЗаписи,
				|	Память.АктуальноДо КАК АктуальноДо,
				|	Память.Источник КАК Источник,
				|	Память.Пользователь КАК Пользователь
				|ИЗ
				|	РегистрСведений.СИ_ПамятьДиалога КАК Память
				|ГДЕ "
				+ СтрСоединить(Условия, " И ")
				+ "
				|УПОРЯДОЧИТЬ ПО
				|	Память.Сортировка,
				|	Память.ДатаЗаписи УБЫВ";
		Иначе
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Память.ТипФакта КАК ТипФакта,
				|	Память.Ключ КАК Ключ,
				|	Память.Значение КАК Значение,
				|	Память.Сортировка КАК Сортировка,
				|	Память.ДатаЗаписи КАК ДатаЗаписи,
				|	Память.АктуальноДо КАК АктуальноДо,
				|	Память.Источник КАК Источник,
				|	Память.Пользователь КАК Пользователь
				|ИЗ
				|	РегистрСведений.СИ_ПамятьДиалога КАК Память
				|ГДЕ "
				+ СтрСоединить(Условия, " И ")
				+ "
				|УПОРЯДОЧИТЬ ПО
				|	Память.Сортировка,
				|	Память.ДатаЗаписи УБЫВ";
		КонецЕсли;

		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);
		Если НЕ ПустаяСтрока(ТипФактаФильтр) Тогда
			Запрос.УстановитьПараметр("ТипФакта", ТипФактаФильтр);
		КонецЕсли;
		Если БезПросроченных Тогда
			Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
			Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		КонецЕсли;

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Факт = Новый Структура("ТипФакта,Ключ,Значение,Сортировка,ДатаЗаписи,АктуальноДо,Источник,Пользователь");
			Факт.ТипФакта = Выборка.ТипФакта;
			Факт.Ключ = Выборка.Ключ;
			Факт.Значение = Выборка.Значение;
			Факт.Сортировка = Выборка.Сортировка;
			Факт.ДатаЗаписи = Выборка.ДатаЗаписи;
			Факт.АктуальноДо = Выборка.АктуальноДо;
			Факт.Источник = Выборка.Источник;
			Факт.Пользователь = Выборка.Пользователь;
			Результат.Добавить(Факт);
		КонецЦикла;

	Исключение
		ЗаписьЖурналаРегистрации("ПамятьДиалога.ПолучитьФакты", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка чтения фактов памяти: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает релевантные факты памяти: отбор по типу, без просроченных,
// ограничение по количеству и бюджету токенов.
//
// Параметры:
//  ИдДиалога     - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  ПараметрыОтбора - Структура,Неопределено:
//    * ТипФакта     - Строка - фильтр по типу факта.
//    * МаксФактов   - Число - максимум фактов (по умолчанию МаксФактовВКонтексте()).
//    * БюджетТокенов - Число - бюджет токенов на блок (по умолчанию БюджетТокеновПамяти()).
//
// Возвращаемое значение:
//  Массив из Структура (как в ПолучитьФакты) - отрелевантное подмножество.
//
Функция ПолучитьРелевантныйКонтекст(ИдДиалога, ПараметрыОтбора = Неопределено) Экспорт

	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Результат;
	КонецЕсли;

	МаксФактов = МаксФактовВКонтексте();
	БюджетТокенов = БюджетТокеновПамяти();
	ТипФактаФильтр = Неопределено;

	Если ПараметрыОтбора <> Неопределено Тогда
		Если ПараметрыОтбора.Свойство("МаксФактов") И ПараметрыОтбора.МаксФактов <> Неопределено
			И ТипЗнч(ПараметрыОтбора.МаксФактов) = Тип("Число") Тогда
			МаксФактов = Цел(ПараметрыОтбора.МаксФактов);
		КонецЕсли;
		Если ПараметрыОтбора.Свойство("БюджетТокенов") И ПараметрыОтбора.БюджетТокенов <> Неопределено
			И ТипЗнч(ПараметрыОтбора.БюджетТокенов) = Тип("Число") Тогда
			БюджетТокенов = Цел(ПараметрыОтбора.БюджетТокенов);
		КонецЕсли;
		Если ПараметрыОтбора.Свойство("ТипФакта") Тогда
			ТипФактаФильтр = ПараметрыОтбора.ТипФакта;
		КонецЕсли;
	КонецЕсли;

	Если МаксФактов <= 0 Тогда
		МаксФактов = МаксФактовВКонтексте();
	КонецЕсли;
	Если БюджетТокенов <= 0 Тогда
		БюджетТокенов = БюджетТокеновПамяти();
	КонецЕсли;

	ПараметрыВыборки = Новый Структура("ТипФакта,БезПросроченных,Лимит",
		ТипФактаФильтр, Истина, МаксФактов * 2);
	Факты = ПолучитьФакты(ИдДиалога, ПараметрыВыборки);

	ИспользованоТокенов = 0;
	Для Каждого Факт Из Факты Цикл
		Если Результат.Количество() >= МаксФактов Тогда
			Прервать;
		КонецЕсли;

		Оценка = СИ_УправлениеДиалогом.ОценитьКоличествоТокенов(Строка(Факт.Значение));
		Если ИспользованоТокенов + Оценка > БюджетТокенов И Результат.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;

		ИспользованоТокенов = ИспользованоТокенов + Оценка;
		Результат.Добавить(Факт);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует готовый текстовый блок памяти для вставки в system-сообщение.
// Пустая строка, если релевантных фактов нет.
//
// Параметры:
//  ИдДиалога     - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  ПараметрыОтбора - Структура,Неопределено - параметры отбора
//  (поля соответствуют ПолучитьРелевантныйКонтекст).
//
// Возвращаемое значение:
//  Строка - блок "=== ПАМЯТЬ ДИАЛОГА ===" или пустая строка.
//
Функция СформироватьБлокПамяти(ИдДиалога, ПараметрыОтбора = Неопределено) Экспорт

	Факты = ПолучитьРелевантныйКонтекст(ИдДиалога, ПараметрыОтбора);
	Если Факты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	СтрокиБлока = Новый Массив;
	СтрокиБлока.Добавить("=== ПАМЯТЬ ДИАЛОГА (проверенные факты из предыдущих сообщений) ===");

	Для Каждого Факт Из Факты Цикл
		СтрокаФакта = "- [" + Строка(Факт.ТипФакта) + "] " + Строка(Факт.Значение);
		Если СтрДлина(СтрокаФакта) > 500 Тогда
			СтрокаФакта = Лев(СтрокаФакта, 500) + "...";
		КонецЕсли;
		СтрокиБлока.Добавить(СтрокаФакта);
	КонецЦикла;

	Возврат СтрСоединить(СтрокиБлока, Символы.ПС);

КонецФункции

// Очищает память диалога полностью (историю сообщений НЕ трогает).
//
// Возвращаемое значение:
//  Булево - Истина при успешной очистке.
//
Функция ОчиститьПамятьДиалога(ИдДиалога) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей = РегистрыСведений.СИ_ПамятьДиалога.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдДиалога.Установить(ИдДиалога);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);

		ЗаписьЖурналаРегистрации("ПамятьДиалога.Очистка", УровеньЖурналаРегистрации.Информация,
			Строка(ИдДиалога),, "Память диалога очищена");

		Возврат Истина;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ЗаписьЖурналаРегистрации("ПамятьДиалога.Очистка", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка очистки памяти диалога: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Удаляет просроченные факты диалога (АктуальноДо < текущей даты).
// Вызывается best-effort перед отбором контекста.
//
// Возвращаемое значение:
//  Число - количество удалённых фактов.
//
Функция УдалитьПросроченные(ИдДиалога) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат 0;
	КонецЕсли;

	УдаленоИтого = 0;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Память.ТипФакта КАК ТипФакта,
			|	Память.Ключ КАК Ключ
			|ИЗ
			|	РегистрСведений.СИ_ПамятьДиалога КАК Память
			|ГДЕ
			|	Память.ИдДиалога = &ИдДиалога
			|	И Память.АктуальноДо <> &ПустаяДата
			|	И Память.АктуальноДо < &ТекущаяДата";
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());

		Выборка = Запрос.Выполнить().Выбрать();

		НаборЗаписей = РегистрыСведений.СИ_ПамятьДиалога.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдДиалога.Установить(ИдДиалога);
		НаборЗаписей.Прочитать();

		Просроченные = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Пара = Новый Структура("ТипФакта,Ключ", Выборка.ТипФакта, Выборка.Ключ);
			Просроченные.Добавить(Пара);
		КонецЦикла;

		ИндексыДляУдаления = Новый Массив;
		Для Индекс = 0 По НаборЗаписей.Количество() - 1 Цикл
			Запись = НаборЗаписей[Индекс];
			НайденоПросроченных = Ложь;
			Для Каждого Пара Из Просроченные Цикл
				Если Запись.ТипФакта = Пара.ТипФакта И Запись.Ключ = Пара.Ключ Тогда
					НайденоПросроченных = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НайденоПросроченных Тогда
				ИндексыДляУдаления.Добавить(Индекс);
			КонецЕсли;
		КонецЦикла;

		Индекс = ИндексыДляУдаления.Количество() - 1;
		Пока Индекс >= 0 Цикл
			НаборЗаписей.Удалить(ИндексыДляУдаления[Индекс]);
			УдаленоИтого = УдаленоИтого + 1;
			Индекс = Индекс - 1;
		КонецЦикла;

		Если УдаленоИтого > 0 Тогда
			НаборЗаписей.Записать();
		КонецЕсли;

		УстановитьПривилегированныйРежим(Ложь);

		Если УдаленоИтого > 0 Тогда
			ЗаписьЖурналаРегистрации("ПамятьДиалога.УдалениеПросроченных", УровеньЖурналаРегистрации.Информация,
				Строка(ИдДиалога),, "Удалено просроченных фактов: " + Строка(УдаленоИтого));
		КонецЕсли;

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ЗаписьЖурналаРегистрации("ПамятьДиалога.УдалениеПросроченных", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка удаления просроченных фактов: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат УдаленоИтого;

КонецФункции

// Пакетно удаляет просроченные факты по ВСЕМ диалогам (регламентное
// обслуживание, СИ_ОбслуживаниеАгента): один запрос выбирает все просроченные
// записи, затем каждый затронутый диалог перечитывается набором записей
// один раз - без предварительного запроса на каждый диалог.
//
// Возвращаемое значение:
//  Число - количество удалённых фактов.
Функция УдалитьПросроченныеПоВсемДиалогам() Экспорт

	УдаленоИтого = 0;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Память.ИдДиалога КАК ИдДиалога,
			|	Память.ТипФакта КАК ТипФакта,
			|	Память.Ключ КАК Ключ
			|ИЗ
			|	РегистрСведений.СИ_ПамятьДиалога КАК Память
			|ГДЕ
			|	Память.АктуальноДо <> &ПустаяДата
			|	И Память.АктуальноДо < &ТекущаяДата";
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());

		ПросроченныеПоДиалогам = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Пары = ПросроченныеПоДиалогам.Получить(Выборка.ИдДиалога);
			Если Пары = Неопределено Тогда
				Пары = Новый Массив;
				ПросроченныеПоДиалогам.Вставить(Выборка.ИдДиалога, Пары);
			КонецЕсли;
			Пары.Добавить(Новый Структура("ТипФакта,Ключ", Выборка.ТипФакта, Выборка.Ключ));
		КонецЦикла;

		Для Каждого Задача Из ПросроченныеПоДиалогам Цикл
			НаборЗаписей = РегистрыСведений.СИ_ПамятьДиалога.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдДиалога.Установить(Задача.Ключ);
			НаборЗаписей.Прочитать();

			ИндексыДляУдаления = Новый Массив;
			Для Индекс = 0 По НаборЗаписей.Количество() - 1 Цикл
				Запись = НаборЗаписей[Индекс];
				Для Каждого Пара Из Задача.Значение Цикл
					Если Запись.ТипФакта = Пара.ТипФакта И Запись.Ключ = Пара.Ключ Тогда
						ИндексыДляУдаления.Добавить(Индекс);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;

			Индекс = ИндексыДляУдаления.Количество() - 1;
			Пока Индекс >= 0 Цикл
				НаборЗаписей.Удалить(ИндексыДляУдаления[Индекс]);
				УдаленоИтого = УдаленоИтого + 1;
				Индекс = Индекс - 1;
			КонецЦикла;

			Если ИндексыДляУдаления.Количество() > 0 Тогда
				НаборЗаписей.Записать();
			КонецЕсли;
		КонецЦикла;

		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ЗаписьЖурналаРегистрации("ПамятьДиалога.УдалениеПросроченных", УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка пакетного удаления просроченных фактов: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат УдаленоИтого;

КонецФункции

// Возвращает количество фактов памяти диалога (для UI/индикатора).
//
// Возвращаемое значение:
//  Число - количество записей регистра по диалогу.
//
Функция КоличествоФактов(ИдДиалога) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(Память.ИдДиалога) КАК КоличествоФактов
			|ИЗ
			|	РегистрСведений.СИ_ПамятьДиалога КАК Память
			|ГДЕ
			|	Память.ИдДиалога = &ИдДиалога";
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.КоличествоФактов;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ПамятьДиалога.КоличествоФактов", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка подсчёта фактов памяти: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ищет запись в наборе записей по измерениям ТипФакта/Ключ.
// Возвращает запись набора или Неопределено.
Функция НайтиЗаписьНабора(НаборЗаписей, ТипФакта, Ключ)

	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись.ТипФакта = ТипФакта И Запись.Ключ = Ключ Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
