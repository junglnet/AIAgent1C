Функция СостояниеНастроекТекст()

	АктивныйРежимТекущий = Константы.СИ_АктивныйРежим.Получить();

	ТекстСостояния = "";

	Если ЗначениеЗаполнено(АктивныйРежимТекущий) Тогда
		ТекстСостояния = ТекстСостояния + "- Активный режим: задан (" + Строка(АктивныйРежимТекущий) + ")"
			+ Символы.ПС;
		РеквизитыРежима = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктивныйРежимТекущий, "Профиль, Модель");
		Если ЗначениеЗаполнено(РеквизитыРежима.Профиль) Тогда
			ТекстСостояния = ТекстСостояния + "- Профиль подключения: " + Строка(РеквизитыРежима.Профиль) + Символы.ПС;
			ДанныеПрофиля = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыРежима.Профиль,
				"БазовыйURL, КлючAPI, ТипАвторизации");
			Если ПустаяСтрока(ДанныеПрофиля.БазовыйURL) Тогда
				ТекстСостояния = ТекстСостояния + "- Базовый URL: НЕ заполнен" + Символы.ПС;
			Иначе
				ТекстСостояния = ТекстСостояния + "- Базовый URL: заполнен" + Символы.ПС;
			КонецЕсли;
			Если ПустаяСтрока(ДанныеПрофиля.КлючAPI) И ДанныеПрофиля.ТипАвторизации <> Перечисления.СИ_ТипыАвторизации.Нет Тогда
				ТекстСостояния = ТекстСостояния + "- Ключ API: НЕ заполнен" + Символы.ПС;
			Иначе
				ТекстСостояния = ТекстСостояния + "- Ключ API: заполнен" + Символы.ПС;
			КонецЕсли;
		Иначе
			ТекстСостояния = ТекстСостояния + "- Профиль подключения: НЕ задан у активного режима" + Символы.ПС;
		КонецЕсли;
		Если ПустаяСтрока(РеквизитыРежима.Модель) Тогда
			ТекстСостояния = ТекстСостояния + "- Модель режима: НЕ задана" + Символы.ПС;
		Иначе
			ТекстСостояния = ТекстСостояния + "- Модель режима: " + РеквизитыРежима.Модель + Символы.ПС;
		КонецЕсли;
	Иначе
		ТекстСостояния = ТекстСостояния
			+ "- Активный режим: НЕ задан (агент не сможет подключиться к провайдеру)" + Символы.ПС;
	КонецЕсли;

	ТекстСостояния = ТекстСостояния
		+ СтрШаблон(НСтр("ru='- Разрешённых инструментов 1С: %1'"), Формат(КоличествоРазрешенныхИнструментов(), "ЧГ=0"))
		+ Символы.ПС
		+ СтрШаблон(НСтр("ru='- Включённых MCP-серверов: %1'"), Формат(КоличествоВключенныхMCPSерверов(), "ЧГ=0"));

	Возврат ТекстСостояния;

КонецФункции

