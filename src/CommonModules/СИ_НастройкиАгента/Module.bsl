// Возвращает структуру полей профиля подключения по ссылке (чтение без блокировки).
//
// Параметры:
//   Ссылка - СправочникСсылка.СИ_ПрофилиПодключений - ссылка на профиль.
//
// Возвращаемое значение:
//   Структура,Неопределено - поля профиля (ключи соответствуют составу из ЗаполнитьНастройкиПоУмолчанию,
//   кроме служебного ПрофильПодключения и прокси, который собирается отдельно):
//     * БазовыйURL - Строка
//     * КлючAPI - Строка
//     * Таймаут - Число
//     * ИспользоватьПрокси - Булево
//     * ПроксиСервер - Строка
//     * ПроксиПорт - Число
//     * ПроксиПользователь - Строка
//     * ПроксиПароль - Строка
//     * MaxIterations - Число
//     * РазрешитьРассуждения - Булево
//     * ИспользоватьСводку - Булево
//     * МаксТокеновСводки - Число
//     * КоличествоСвежихСообщений - Число
//     * МаксДлинаToolРезультата - Число
//     * МаксДлинаСообщения - Число
//     * ПроцентОкнаДляИстории - Число
//     * ТипАвторизации - ПеречислениеСсылка.СИ_ТипыАвторизации
//     * ИмяЗаголовкаАвторизации - Строка
//     * ПроверятьSSL - Булево
//     * КоличествоПовторовПриТранспортнойОшибке - Число - автоповтор вызова модели при временных сбоях
//   Неопределено - профиль не найден.
Функция ДанныеПрофиляИзЗапроса(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БазовыйURL,
	|	КлючAPI,
	|	Таймаут,
	|	ИспользоватьПрокси,
	|	ПроксиСервер,
	|	ПроксиПорт,
	|	ПроксиПользователь,
	|	ПроксиПароль,
	|	МаксимумИтераций,
	|	РазрешитьРассуждения,
	|	ИспользоватьСводку,
	|	МаксТокеновСводки,
	|	КоличествоСвежихСообщений,
	|	МаксДлинаToolРезультата,
	|	МаксДлинаСообщения,
	|	ПроцентОкнаДляИстории,
	|	ТипАвторизации,
	|	ИмяЗаголовкаАвторизации,
	|	ПроверятьSSL,
	|	ЗаголовокЧерезИИ,
	|	ПутьКУтилитеКонвертацииPDF,
	|	ДвижокКонвертацииPDF,
	|	МаксимумСтраницPDF,
	|	DPIКонвертацииPDF,
	|	КоличествоПовторовПриТранспортнойОшибке
	|ИЗ
	|	Справочник.СИ_ПрофилиПодключений
	|ГДЕ
	|	Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("БазовыйURL", Выборка.БазовыйURL);
	Данные.Вставить("КлючAPI", Выборка.КлючAPI);
	Данные.Вставить("Таймаут", ЗначениеИлиДефолт(Выборка.Таймаут, 60));
	Данные.Вставить("ИспользоватьПрокси", ЗначениеИлиДефолт(Выборка.ИспользоватьПрокси, Ложь));
	Данные.Вставить("ПроксиСервер", Выборка.ПроксиСервер);
	Данные.Вставить("ПроксиПорт", Выборка.ПроксиПорт);
	Данные.Вставить("ПроксиПользователь", Выборка.ПроксиПользователь);
	Данные.Вставить("ПроксиПароль", Выборка.ПроксиПароль);
	Данные.Вставить("MaxIterations", ЗначениеИлиДефолт(Выборка.МаксимумИтераций, 10));
	Данные.Вставить("РазрешитьРассуждения", ЗначениеИлиДефолт(Выборка.РазрешитьРассуждения, Ложь));
	Данные.Вставить("ИспользоватьСводку", ЗначениеИлиДефолт(Выборка.ИспользоватьСводку, Ложь));
	Данные.Вставить("МаксТокеновСводки", ЗначениеИлиДефолт(Выборка.МаксТокеновСводки, 1500));
	Данные.Вставить("КоличествоСвежихСообщений", ЗначениеИлиДефолт(Выборка.КоличествоСвежихСообщений, 10));
	Данные.Вставить("МаксДлинаToolРезультата", ЗначениеИлиДефолт(Выборка.МаксДлинаToolРезультата, 4000));
	Данные.Вставить("МаксДлинаСообщения", ЗначениеИлиДефолт(Выборка.МаксДлинаСообщения, 4000));
	Данные.Вставить("ПроцентОкнаДляИстории", ЗначениеИлиДефолт(Выборка.ПроцентОкнаДляИстории, 0.75));
	Данные.Вставить("ТипАвторизации", ЗначениеИлиДефолт(Выборка.ТипАвторизации, Перечисления.СИ_ТипыАвторизации.Bearer));
	Данные.Вставить("ИмяЗаголовкаАвторизации", ЗначениеИлиДефолт(Выборка.ИмяЗаголовкаАвторизации, "Authorization"));
	Данные.Вставить("ПроверятьSSL", ЗначениеИлиДефолт(Выборка.ПроверятьSSL, Истина));
	Данные.Вставить("ЗаголовокЧерезИИ", ЗначениеИлиДефолт(Выборка.ЗаголовокЧерезИИ, Ложь));
	Данные.Вставить("КоличествоПовторовПриТранспортнойОшибке", ЗначениеИлиДефолт(Выборка.КоличествоПовторовПриТранспортнойОшибке, 2));
	Данные.Вставить("ПутьКУтилитеКонвертацииPDF", ЗначениеИлиДефолт(Выборка.ПутьКУтилитеКонвертацииPDF, ""));
	Данные.Вставить("ДвижокКонвертацииPDF", ЗначениеИлиДефолт(Выборка.ДвижокКонвертацииPDF, "pdftoppm"));
	Данные.Вставить("МаксимумСтраницPDF", ЗначениеИлиДефолт(Выборка.МаксимумСтраницPDF, 10));
	Данные.Вставить("DPIКонвертацииPDF", ЗначениеИлиДефолт(Выборка.DPIКонвертацииPDF, 100));
	
	Возврат Данные;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Возвращает данные строки табличной части Модели по имени модели (чтение без блокировки).
//
// Параметры:
//   СсылкаНаПрофиль - СправочникСсылка.СИ_ПрофилиПодключений - ссылка на профиль.
//   ИмяМодели - Строка - идентификатор модели.
//
// Возвращаемое значение:
//   Структура,Неопределено - данные модели:
//     * ИмяМодели - Строка
//     * КонтекстноеОкно - Число
//     * ПоддержкаИзображений - Булево - признак поддержки image_url/vision
//   Неопределено - модель не найдена.
Функция ДанныеМоделиИзЗапроса(СсылкаНаПрофиль, ИмяМодели)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Модели.ИмяМодели,
	|	Модели.КонтекстноеОкно,
	|	Модели.МаксимумТокеновОтвета,
	|	Модели.ПоддержкаИзображений,
	|	Модели.ИспользоватьПоУмолчанию
	|ИЗ
	|	Справочник.СИ_ПрофилиПодключений.Модели КАК Модели
	|ГДЕ
	|	Модели.Ссылка = &Ссылка
	|	И Модели.ИмяМодели = &ИмяМодели";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаПрофиль);
	Запрос.УстановитьПараметр("ИмяМодели", ИмяМодели);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("ИмяМодели", Выборка.ИмяМодели);
	Данные.Вставить("КонтекстноеОкно", Выборка.КонтекстноеОкно);
	Данные.Вставить("МаксимумТокеновОтвета", Выборка.МаксимумТокеновОтвета);
	Данные.Вставить("ПоддержкаИзображений", Выборка.ПоддержкаИзображений);
	Данные.Вставить("ИспользоватьПоУмолчанию", Выборка.ИспользоватьПоУмолчанию);
	
	Возврат Данные;
	
КонецФункции

#КонецОбласти
