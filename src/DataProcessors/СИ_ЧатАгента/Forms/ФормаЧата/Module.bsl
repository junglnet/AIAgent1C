&НаСервере
Функция ПодсказкиСтартовогоЭкрана(Знач Режим)
	Возврат СИ_ЧатHTMLСервер.ПодсказкиСтартовогоЭкрана(Режим);
КонецФункции

// Пишет в журнал регистрации адрес подсказки, который не удалось разобрать.
// Вызывается из клиентского обработчика ссылок: ЗаписьЖурналаРегистрации
// на клиенте недоступна, поэтому запись идёт серверным безконтекстным вызовом.
//
// Параметры:
//  АдресСсылки - Строка - адрес, который вернула платформа по клику.
//
&НаСервереБезКонтекста
Процедура ЗарегистрироватьНеразобраннуюСсылкуПодсказки(Знач АдресСсылки)

	ЗаписьЖурналаРегистрации("ЧатАгента.ПодсказкаСтарта",
		УровеньЖурналаРегистрации.Предупреждение, , ,
		"Не удалось разобрать ссылку подсказки: " + АдресСсылки);

КонецПроцедуры

// Обрабатывает клик по кнопке-подсказке стартового экрана (ссылка
// hint:<номер с единицы>):
// текст подсказки берётся из единого списка и отправляется агенту как обычное
// сообщение пользователя - как и выбор варианта ответа (ВыбратьВариантОтвета).
//
// Параметры:
//  Индекс - Число - номер подсказки в списке СИ_ЧатHTMLСервер.
&НаКлиенте
Процедура ОтправитьПодсказкуСтартовогоЭкрана(Знач Индекс)

	Подсказки = ПодсказкиСтартовогоЭкрана(РежимРаботы);
	Если Индекс < 0 ИЛИ Индекс >= Подсказки.Количество() Тогда
		Возврат;
	КонецЕсли;

	ТекстПодсказки = Подсказки[Индекс];
	Если ПустаяСтрока(ТекстПодсказки) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания)
		И ЗначениеЗаполнено(ЗаходИдДиалога) И ЗаходИдДиалога = АктивныйДиалог Тогда
		ПоказатьПредупреждение(, "Дождитесь завершения текущего запроса");
		Возврат;
	КонецЕсли;

	Элементы.КомандаОтправить.Доступность = Ложь;
	Элементы.ПолеВвода.Доступность = Ложь;
	Элементы.КомандаПрикрепитьФайл.Доступность = Ложь;
	Элементы.КомандаСжать.Доступность = Ложь;

	ТекстВвода = ТекстПодсказки;
	ОтправитьСообщениеАгенту();

КонецПроцедуры

// Обрабатывает клик по плитке роли стартового экрана (ссылка role:<код>):
// отправляет вопрос обзора как обычное сообщение и ограничивает набор
// инструментов первого шага одной сводкой (ИнструментыПервогоШага).
//
// Параметры:
//  Код - Строка - код роли: sales | money | stock.
&НаКлиенте
Процедура ОтправитьОбзорПоРоли(Знач Код)

	Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания)
		И ЗначениеЗаполнено(ЗаходИдДиалога) И ЗаходИдДиалога = АктивныйДиалог Тогда
		ПоказатьПредупреждение(, "Дождитесь завершения текущего запроса");
		Возврат;
	КонецЕсли;

	Подготовка = ПодготовитьОбзорПоРолиНаСервере(Код);
	Если Подготовка = Неопределено ИЛИ ПустаяСтрока(Подготовка.Вопрос) Тогда
		Возврат;
	КонецЕсли;

	Элементы.КомандаОтправить.Доступность = Ложь;
	Элементы.ПолеВвода.Доступность = Ложь;
	Элементы.КомандаПрикрепитьФайл.Доступность = Ложь;
	Элементы.КомандаСжать.Доступность = Ложь;

	ТекстВвода = Подготовка.Вопрос;
	ОтправитьСообщениеАгенту();

КонецПроцедуры

&НаСервере
Функция ПодготовитьОбзорПоРолиНаСервере(Знач Код)

	Результат = Новый Структура;
	Результат.Вставить("Вопрос", "");

	Инструменты = Новый Массив;
	Вопрос = "";

	Если Код = "sales" Тогда
		Вопрос = "Сделай обзор продаж за текущий месяц: выручка, маржа, число продаж, "
			+ "сравнение с прошлым месяцем, топ-5 товаров и топ-5 клиентов.";
		Инструменты.Добавить("GetSalesSummary");
	ИначеЕсли Код = "money" Тогда
		Вопрос = "Сделай обзор денег и долгов: остаток денежных средств, поступления и списания "
			+ "за текущий месяц, дебиторская и кредиторская задолженность, топ-5 должников.";
		Инструменты.Добавить("GetMoneySummary");
	ИначеЕсли Код = "stock" Тогда
		Вопрос = "Сделай обзор склада: стоимость запасов, число позиций, минусовые остатки, "
			+ "позиции без наличия и без движения за 3 месяца, топ-20 позиций по стоимости.";
		Инструменты.Добавить("GetStockSummary");
	КонецЕсли;

	Если ПустаяСтрока(Вопрос) Тогда
		Возврат Результат;
	КонецЕсли;

	ИнструментыПервогоШагаЗахода = Инструменты;
	Результат.Вопрос = Вопрос;

	Возврат Результат;

КонецФункции

// Открывает объект 1С по навигационной ссылке (ссылки e1cib/ в ответах агента).
// Переход по такой ссылке внутри поля HTML-документа платформа сама не
// выполняет, поэтому клик обрабатывает форма.
//
// Параметры:
//  АдресОбъекта - Строка - навигационная ссылка вида "e1cib/data/...".
&НаКлиенте
Процедура ОткрытьОбъектПоНавигационнойСсылке(Знач АдресОбъекта)

	ЗаписатьВЖурналНавигации("Информация", "Открываю объект по ссылке: " + АдресОбъекта);

	Оповещение = Новый ОписаниеОповещения("ОткрытиеОбъектаЗавершено", ЭтотОбъект, АдресОбъекта);
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(АдресОбъекта, Оповещение);

КонецПроцедуры

// Обработчик результата перехода по ссылке объекта (см. ФайловаяСистемаКлиент.
// ОткрытьНавигационнуюСсылку). Исход не влияет на работу чата - он только
// фиксируется в журнале навигации.
//
// Параметры:
//  ПриложениеЗапущено - Булево - Истина, если переход выполнен без ошибок;
//  ДополнительныеПараметры - Строка - адрес объекта (передан в ОписаниеОповещения).
&НаКлиенте
Процедура ОткрытиеОбъектаЗавершено(ПриложениеЗапущено, ДополнительныеПараметры) Экспорт

	Если ПриложениеЗапущено = Истина Тогда
		ЗаписатьВЖурналНавигации("Информация", "Переход по ссылке выполнен: " + Строка(ДополнительныеПараметры));
	Иначе
		ЗаписатьВЖурналНавигации("Предупреждение",
			"Переход по ссылке не удался: " + Строка(ДополнительныеПараметры));
	КонецЕсли;

КонецПроцедуры

// Открывает диалог по ссылке: отсоединяет активный заход, разблокирует ввод,
// загружает чат и перезахватывает живой заход, если по диалогу он уже идёт.
// Вызывается выбором строки в списке диалогов (СписокЧатовВыбор) и кликом по
// ссылке на диалог в ответе агента (ОткрытьДиалогПоНавигационнойСсылке) - это
// самостоятельный клиентский метод формы, а не обработчик элемента таблицы
// списка чатов.
//
// Параметры:
//  СсылкаДиалога - СправочникСсылка.СИ_ДиалогиАгента - открываемый диалог;
//  СообщатьОбУжеОткрытом - Булево - показать сообщение, когда клик пришёлся на
//    уже открытый диалог. Для ссылки в ответе это нужно (иначе клик выглядит
//    как «не работает»), для повторного выбора строки в списке - лишний шум.
&НаКлиенте
Процедура ОткрытьДиалогПоСсылке(Знач СсылкаДиалога, Знач СообщатьОбУжеОткрытом = Ложь)

	Если НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(АктивныйДиалог) И СсылкаДиалога = АктивныйДиалог Тогда

		Если СообщатьОбУжеОткрытом Тогда
			ПоказатьПредупреждение(, "Этот диалог уже открыт в чате.");
		КонецЕсли;
		Возврат;

	КонецЕсли;

	ОтсоединитьЗаход();

	Элементы.КомандаОтправить.Доступность = Истина;
	Элементы.ПолеВвода.Доступность = Истина;
	Элементы.КомандаПрикрепитьФайл.Доступность = Истина;
	Элементы.КомандаПрерватьДиалог.Доступность = Ложь;
	Элементы.КомандаСжать.Доступность = Истина;
	АктивныйДиалог = СсылкаДиалога;

	ЗагрузитьЧатНаСервере(СсылкаДиалога);

	ИдЗаданияДиалога = ПроверитьПерезахватНаСервере(СсылкаДиалога);
	Если НЕ ПустаяСтрока(ИдЗаданияДиалога) Тогда
		ПрисоединитьЗаход(СсылкаДиалога, ИдЗаданияДиалога);
	КонецЕсли;

КонецПроцедуры

// Открывает ДИАЛОГ агента по ссылке на его элемент справочника: пользователю
// в этом случае нужен сам диалог (продолжить переписку), а не карточка
// элемента справочника. Если диалог определить не удалось (объект удалён),
// выполняется обычный переход по ссылке.
//
// Параметры:
//  АдресОбъекта - Строка - навигационная ссылка на элемент СИ_ДиалогиАгента.
&НаКлиенте
Процедура ОткрытьДиалогПоНавигационнойСсылке(Знач АдресОбъекта)

	УИДДиалога = УИДИзНавигационнойСсылки(АдресОбъекта);
	СсылкаДиалога = ПолучитьДиалогПоУИДНаСервере(УИДДиалога);

	Если НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		ЗаписатьВЖурналНавигации("Предупреждение",
			"Диалог по ссылке не найден, выполняется обычный переход: " + АдресОбъекта);
		ОткрытьОбъектПоНавигационнойСсылке(АдресОбъекта);
		Возврат;
	КонецЕсли;

	ЗаписатьВЖурналНавигации("Информация", "Открываю диалог по ссылке: " + Строка(СсылкаДиалога));
	ОткрытьДиалогПоСсылке(СсылкаДиалога, Истина);

КонецПроцедуры

// Ссылка ли навигационная ссылка на элемент справочника диалогов агента.
// Проверка по имени справочника: адрес приходит и в русской записи
// (Справочник.СИ_ДиалогиАгента), и в англоязычной (Catalog.СИ_ДиалогиАгента).
//
// Параметры:
//  АдресОбъекта - Строка - навигационная ссылка вида "e1cib/data/...".
//
// Возвращаемое значение:
//  Булево - Истина, если ссылка ведёт на диалог агента.
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСсылкаНаДиалог(Знач АдресОбъекта)
	Возврат СтрНайти(НРег(АдресОбъекта), "си_диалогиагента") > 0;
КонецФункции

// Уникальный идентификатор объекта из навигационной ссылки (параметр ref).
//
// Параметры:
//  АдресОбъекта - Строка - навигационная ссылка вида "e1cib/data/...?ref=<УИД>".
//
// Возвращаемое значение:
//  Строка - уникальный идентификатор; пустая строка, если его в ссылке нет.
&НаКлиентеНаСервереБезКонтекста
Функция УИДИзНавигационнойСсылки(Знач АдресОбъекта)

	Позиция = СтрНайти(НРег(АдресОбъекта), "ref=");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(АдресОбъекта, Позиция + 4);
	КонецЗначения = СтрДлина(Хвост) + 1;
	Для НомерСимвола = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, НомерСимвола, 1);
		Если Символ = "&" ИЛИ Символ = " " ИЛИ Символ = ">" ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК Тогда
			КонецЗначения = НомерСимвола;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Лев(Хвост, КонецЗначения - 1);

КонецФункции
// Строка уникального идентификатора в том виде, который принимает конструктор
// УникальныйИдентификатор (8-4-4-4-12 с дефисами). В параметре ref= навигационной
// ссылки e1cib/data платформа отдаёт ту же запись БЕЗ дефисов, а конструктор
// понимает только форму с дефисами (все типовые вызовы в конфигурации - с дефисами),
// поэтому без восстановления разделителей диалог по своей же ссылке не находился.
//
// Параметры:
//  УИД - Строка - идентификатор из навигационной ссылки (с дефисами или без).
//
// Возвращаемое значение:
//  Строка - идентификатор с дефисами; аргумент без 32 шестнадцатеричных знаков
//  возвращается как есть (конструктор вернёт ошибку в своей Попытке вызывающего).
&НаКлиентеНаСервереБезКонтекста
Функция УИДСДефисами(Знач УИД)

	Хекс = СокрЛП(УИД);
	Если СтрДлина(Хекс) <> 32 ИЛИ СтрНайти(Хекс, "-") > 0 Тогда
		Возврат Хекс;
	КонецЕсли;

	Возврат Лев(Хекс, 8) + "-" + Сред(Хекс, 9, 4) + "-" + Сред(Хекс, 13, 4)
		+ "-" + Сред(Хекс, 17, 4) + "-" + Сред(Хекс, 21, 12);

КонецФункции

// Запись в журнал регистрации по кликам ссылок на объекты. Единая точка:
// по событию «ЧатАгента.Навигация» видно, что именно произошло с кликом
// (открыт диалог, выполнен переход, переход не удался).
//
// Параметры:
//  Уровень - Строка - "Информация", "Предупреждение" и т.п.;
//  Текст - Строка - описание события.
&НаКлиенте
Процедура ЗаписатьВЖурналНавигации(Знач Уровень, Знач Текст)
	ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации("ЧатАгента.Навигация", Уровень, Текст);
КонецПроцедуры

&НаСервере
Функция ПолучитьДиалогПоУИДНаСервере(Знач УИД)

	ПустаяСсылка = Справочники.СИ_ДиалогиАгента.ПустаяСсылка();

	Попытка
		СсылкаДиалога = Справочники.СИ_ДиалогиАгента.ПолучитьСсылку(
			Новый УникальныйИдентификатор(УИДСДефисами(УИД)));
	Исключение
		Возврат ПустаяСсылка;
	КонецПопытки;

	Если НЕ ОбщегоНазначения.СсылкаСуществует(СсылкаДиалога) Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;

	Возврат СсылкаДиалога;

КонецФункции

#КонецОбласти
