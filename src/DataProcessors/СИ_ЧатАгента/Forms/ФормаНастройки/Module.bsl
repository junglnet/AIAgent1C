&НаКлиенте
Процедура ЗарегистрироватьИнструментыПоУмолчанию(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ЗарегистрироватьИнструментыПоУмолчаниюОбработкаОтвета", ЭтотОбъект);

	ТекстВопроса = "Будут зарегистрированы инструменты, поставляемые с конфигурацией:"
		+ Символы.ПС + "- файлы диалога (CreateDialogFile, ReadDialogFile, UpdateDialogFile, ListDialogFiles, RecognizeImage);"
		+ Символы.ПС + "- запросы к БД (ExecuteDBQuery, GetMetadataSchema, GetCurrentDateTime);"
		+ Символы.ПС + "- встроенные инструменты 1С (Calculate);"
		+ Символы.ПС + "- диагностика (GetRecentErrors, ParsePeriod);"
		+ Символы.ПС + "- выгрузка и диаграммы (ExportTable, DrawChart);"
		+ Символы.ПС + "- обзорные сводки (GetSalesSummary, GetMoneySummary, GetStockSummary)."
		+ Символы.ПС + Символы.ПС
		+ "Уже зарегистрированные инструменты обновлены не будут, дубли не создаются. Продолжить?";

	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции


&НаКлиенте
Процедура ЗарегистрироватьИнструментыПоУмолчаниюОбработкаОтвета(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	РезультатРегистрации = ЗарегистрироватьИнструментыПоУмолчаниюНаСервере();

	Если РезультатРегистрации.Выполнено Тогда
		Элементы.Список.Обновить();

		Если РезультатРегистрации.Зарегистрировано.Количество() > 0 Тогда
			Сообщение = "Зарегистрированы инструменты: " + СтрСоединить(РезультатРегистрации.Зарегистрировано, ", ");
		Иначе
			Сообщение = "Новых инструментов не зарегистрировано - все инструменты по умолчанию уже существуют в реестре.";
		КонецЕсли;

		Если Не ПустаяСтрока(РезультатРегистрации.Предупреждения) Тогда
			Сообщение = Сообщение + Символы.ПС + РезультатРегистрации.Предупреждения;
		КонецЕсли;

		ПоказатьПредупреждение(, Сообщение, , "Регистрация инструментов");
	Иначе
		ПоказатьПредупреждение(, "Не удалось зарегистрировать инструменты: " + РезультатРегистрации.ТекстОшибки,
			, "Регистрация инструментов");
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция ЗарегистрироватьИнструментыПоУмолчаниюНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("Зарегистрировано", Новый Массив);
	Результат.Вставить("Предупреждения", "");
	Результат.Вставить("ТекстОшибки", "");

	Если Не УправлениеДоступом.ЕстьРоль("СИ_ДобавлениеИзменениеСИ_ИнструментыАгента") Тогда
		Результат.Выполнено = Ложь;
		Результат.ТекстОшибки = "Недостаточно прав. Требуется роль ""СИ_ДобавлениеИзменениеСИ_ИнструментыАгента"".";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Зарегистрированные = СИ_ФайлыДиалога.ЗарегистрироватьИнструменты();
		Для Каждого ИмяИнструмента Из Зарегистрированные Цикл
			Результат.Зарегистрировано.Добавить(ИмяИнструмента);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ИнструментыАгента.РегистрацияИнструментов", УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка регистрации инструментов файлов: " + ОписаниеОшибки());
		Результат.Предупреждения = (?(ПустаяСтрока(Результат.Предупреждения), "",
			Результат.Предупреждения + Символы.ПС))
			+ "Ошибка регистрации инструментов файлов: " + ОписаниеОшибки();
	КонецПопытки;

	Попытка
		Зарегистрированные = СИ_Инструменты1С.ЗарегистрироватьИнструменты();
		Для Каждого ИмяИнструмента Из Зарегистрированные Цикл
			Результат.Зарегистрировано.Добавить(ИмяИнструмента);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ИнструментыАгента.РегистрацияИнструментов", УровеньЖурналаРегистрации.Предупреждение,,,
			"Ошибка регистрации встроенных инструментов 1С: " + ОписаниеОшибки());
		Результат.Предупреждения = (?(ПустаяСтрока(Результат.Предупреждения), "",
			Результат.Предупреждения + Символы.ПС))
			+ "Ошибка регистрации встроенных инструментов 1С: " + ОписаниеОшибки();
	КонецПопытки;

	Результат.Выполнено = Истина;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПодобратьМетаданныеЗавершение(ВыбранныеОбъектыМетаданных, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеОбъектыМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДобавленных = 0;
	Для Каждого ЭлементВыбора Из ВыбранныеОбъектыМетаданных Цикл
		ИмяОбъекта = СокрЛП(Строка(ЭлементВыбора.Значение));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗапрещенныеОбъектыЗапросов.НайтиПоЗначению(ИмяОбъекта) = Неопределено Тогда
			ЗапрещенныеОбъектыЗапросов.Добавить(ИмяОбъекта);
			КоличествоДобавленных = КоличествоДобавленных + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоДобавленных = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выбранные объекты уже присутствуют в списке.'"));
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()

	Если НЕ ЗначениеЗаполнено(АктивныйРежим) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не выбран активный режим. Запись отменена.'"));
		Возврат;
	КонецЕсли;

	Константы.СИ_АктивныйРежим.Установить(АктивныйРежим);

	Константы.СИ_ЛимитТокеновНаОтвет.Установить(Макс(0, ЛимитТокеновНаОтвет));

	Константы.СИ_ЗаголовокЧерезИИ.Установить(ЗаголовокЧерезИИ);

	Модифицированность = Ложь;
		
Конецпроцедуры

#КонецОбласти
