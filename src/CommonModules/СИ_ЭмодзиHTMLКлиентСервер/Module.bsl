// Обёртка SVG: единый размер и стиль для всех иконок.
Функция ОбернутьSVG(Содержимое)
	Возврат "<svg xmlns=""http://www.w3.org/2000/svg"" width=""18"" height=""18"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""1.7"" stroke-linecap=""round"" stroke-linejoin=""round"" style=""vertical-align:middle;display:inline-block;"">"
		+ Содержимое
		+ "</svg>";
КонецФункции

// SVG-лицо по выражениям глаз и рта.
Функция SVGЛицо(ВыражениеГлаз, ВыражениеРта)
	Глаза = "";
	Если ВыражениеГлаз = "normal" Тогда
		Глаза = "<circle cx=""8.5"" cy=""10.5"" r=""1.1"" fill=""currentColor"" stroke=""none""></circle>"
			+ "<circle cx=""15.5"" cy=""10.5"" r=""1.1"" fill=""currentColor"" stroke=""none""></circle>";
	ИначеЕсли ВыражениеГлаз = "happy" Тогда
		Глаза = "<path d=""M7 10.5 q1.5 -1.6 3 0""></path>"
			+ "<path d=""M14 10.5 q1.5 -1.6 3 0""></path>";
	ИначеЕсли ВыражениеГлаз = "sad" Тогда
		Глаза = "<path d=""M7 10.5 q1.5 1.6 3 0""></path>"
			+ "<path d=""M14 10.5 q1.5 1.6 3 0""></path>";
	ИначеЕсли ВыражениеГлаз = "closed" Тогда
		Глаза = "<path d=""M7 10.5 q1.5 -1.2 3 0""></path>"
			+ "<path d=""M14 10.5 q1.5 -1.2 3 0""></path>";
	ИначеЕсли ВыражениеГлаз = "wink" Тогда
		Глаза = "<circle cx=""8.5"" cy=""10.5"" r=""1.1"" fill=""currentColor"" stroke=""none""></circle>"
			+ "<path d=""M14 10.5 q1.5 -1.2 3 0""></path>";
	ИначеЕсли ВыражениеГлаз = "angry" Тогда
		Глаза = "<path d=""M7 11.5 l2.5 -1.8""></path>"
			+ "<path d=""M17 11.5 l-2.5 -1.8""></path>"
			+ "<circle cx=""8.5"" cy=""12"" r=""0.9"" fill=""currentColor"" stroke=""none""></circle>"
			+ "<circle cx=""15.5"" cy=""12"" r=""0.9"" fill=""currentColor"" stroke=""none""></circle>";
	ИначеЕсли ВыражениеГлаз = "surprised" Тогда
		Глаза = "<circle cx=""8.5"" cy=""10.5"" r=""1.5"" fill=""currentColor"" stroke=""none""></circle>"
			+ "<circle cx=""15.5"" cy=""10.5"" r=""1.5"" fill=""currentColor"" stroke=""none""></circle>";
	ИначеЕсли ВыражениеГлаз = "sunglasses" Тогда
		Глаза = "<rect x=""6.5"" y=""9"" width=""4.6"" height=""2.6"" rx=""1""></rect>"
			+ "<rect x=""12.9"" y=""9"" width=""4.6"" height=""2.6"" rx=""1""></rect>"
			+ "<path d=""M11.1 10.3 h1.8""></path>";
	ИначеЕсли ВыражениеГлаз = "glasses" Тогда
		Глаза = "<circle cx=""8.5"" cy=""10.5"" r=""2""></circle>"
			+ "<circle cx=""15.5"" cy=""10.5"" r=""2""></circle>"
			+ "<path d=""M10.5 10.5 h3""></path>";
	ИначеЕсли ВыражениеГлаз = "star" Тогда
		Глаза = "<path d=""M8.5 8.8 l0.6 1.2 1.3 0.2 -0.9 0.9 0.2 1.3 -1.2 -0.6 -1.2 0.6 0.2 -1.3 -0.9 -0.9 1.3 -0.2 z"" fill=""currentColor"" stroke=""none""></path>"
			+ "<path d=""M15.5 8.8 l0.6 1.2 1.3 0.2 -0.9 0.9 0.2 1.3 -1.2 -0.6 -1.2 0.6 0.2 -1.3 -0.9 -0.9 1.3 -0.2 z"" fill=""currentColor"" stroke=""none""></path>";
	ИначеЕсли ВыражениеГлаз = "sweat" Тогда
		Глаза = "<circle cx=""8.5"" cy=""10.5"" r=""1"" fill=""currentColor"" stroke=""none""></circle>"
			+ "<circle cx=""15.5"" cy=""10.5"" r=""1"" fill=""currentColor"" stroke=""none""></circle>";
	КонецЕсли;

	Рот = "";
	Если ВыражениеРта = "smile" Тогда
		Рот = "<path d=""M8.5 14 q3.5 3.2 7 0""></path>";
	ИначеЕсли ВыражениеРта = "grin" Тогда
		Рот = "<path d=""M7.5 13.5 q4.5 5 9 0""></path>";
	ИначеЕсли ВыражениеРта = "laugh" Тогда
		Рот = "<path d=""M8 13.5 q4 5 8 0 z""></path>";
	ИначеЕсли ВыражениеРта = "sad" Тогда
		Рот = "<path d=""M8.5 16 q3.5 -3.2 7 0""></path>";
	ИначеЕсли ВыражениеРта = "angry" Тогда
		Рот = "<path d=""M8 14.5 l2.5 1.5 l2.5 -2 l2.5 2 l2.5 -1.5""></path>";
	ИначеЕсли ВыражениеРта = "open" Тогда
		Рот = "<ellipse cx=""12"" cy=""15.5"" rx=""2.2"" ry=""2.6""></ellipse>";
	ИначеЕсли ВыражениеРта = "wow" Тогда
		Рот = "<circle cx=""12"" cy=""15.5"" r=""2.4""></circle>";
	ИначеЕсли ВыражениеРта = "flat" Тогда
		Рот = "<path d=""M8.5 15.5 h7""></path>";
	КонецЕсли;

	Возврат ОбернутьSVG("<circle cx=""12"" cy=""12"" r=""9""></circle>" + Глаза + Рот);
КонецФункции

// 😭 — лицо со слезами.
Функция SVGПлач()
	Возврат ОбернутьSVG(
		"<circle cx=""12"" cy=""12"" r=""9""></circle>"
		+ "<path d=""M7 10.5 q1.5 -1.2 3 0""></path>"
		+ "<path d=""M14 10.5 q1.5 -1.2 3 0""></path>"
		+ "<path d=""M8.5 13.5 q3.5 3.5 7 0""></path>"
		+ "<path d=""M5.5 12 q-1 2 0.5 3.5""></path>"
		+ "<path d=""M18.5 12 q1 2 -0.5 3.5""></path>");
КонецФункции

