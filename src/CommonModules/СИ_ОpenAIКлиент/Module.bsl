#Область ПрограммныйИнтерфейс

// Синхронный вызов метода /v1/chat/completions OpenAI-совместимого API без потоковой передачи.
//
// Параметры:
//  ПараметрыЗапроса - Структура - параметры запроса к модели:
//    * Модель - Строка - идентификатор модели.
//    * Сообщения - Массив из Структура - история сообщений в формате OpenAI.
//    * Инструменты - Массив из Структура,Неопределено - описания функций в поле tools API.
//    * ВыборИнструмента - Строка,Структура,Неопределено - значение поля tool_choice.
//    * Температура - Число - параметр сэмплирования температуры модели.
//    * MaxTokens - Число,Неопределено - максимум токенов в ответе.
//    * ФорматОтвета - Структура,Неопределено - значение поля response_format.
//    * Потоковый - Булево - признак потокового режима; значение берётся из параметра (по умолчанию Ложь).
//    * Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения.
//    * Настройки - Структура,Неопределено - уже прочитанные настройки агента (оптимизация,
//      позволяет избежать повторного запроса к БД); при Неопределено читаются по Профиль.
//
// Возвращаемое значение:
//  Структура - результат вызова API:
//    * Успех - Булево - признак успешного вызова.
//    * Ответ - Структура,Неопределено - тело ответа API при Успех=Истина.
//    * КодОшибки - Строка,Неопределено - код ошибки при Успех=Ложь.
//    * ТекстОшибки - Строка,Неопределено - текст ошибки.
//    * Заголовки - Неопределено,Соответствие из Строка,Строка - заголовки ответа.
Функция ВызватьChatCompletion(ПараметрыЗапроса) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ответ", Неопределено);
	Результат.Вставить("КодОшибки", Неопределено);
	Результат.Вставить("ТекстОшибки", Неопределено);
	Результат.Вставить("Заголовки", Неопределено);
	
	Попытка
		ПрофильЗапроса = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Профиль", Неопределено);
		Настройки = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Настройки", Неопределено);
		Если Настройки = Неопределено Тогда
			Настройки = СИ_НастройкиАгента.ПолучитьНастройки(ПрофильЗапроса);
		КонецЕсли;
		Если ПустаяСтрока(Настройки.БазовыйURL) Тогда
			Результат.КодОшибки = "CONFIG_ERROR";
			Результат.ТекстОшибки = "Не настроен БазовыйURL";
			Возврат Результат;
		КонецЕсли;
		
		ПутьРесурса = СобратьПутьРесурса(Настройки);
		
		ТелоЗапроса = СформироватьТелоЗапроса(ПараметрыЗапроса, Настройки);
		Если ПустаяСтрока(ТелоЗапроса) Тогда
			Результат.КодОшибки = "PARAM_ERROR";
			Результат.ТекстОшибки = "Ошибка формирования тела запроса";
			Возврат Результат;
		КонецЕсли;
		
		Если ПараметрыЗапроса.Свойство("Таймаут") Тогда
			Настройки.Вставить("Таймаут", Число(ПараметрыЗапроса.Таймаут));
		КонецЕсли;

		HTTPСоединение = СИ_НастройкиАгента.СоздатьHTTPСоединениеПоНастройкам(Настройки);
		Если HTTPСоединение = Неопределено Тогда
			Результат.КодОшибки = "CONFIG_ERROR";
			Результат.ТекстОшибки = "Не удалось создать HTTP-соединение по настройкам профиля";
			Возврат Результат;
		КонецЕсли;
		
		HTTPЗапрос = Новый HTTPЗапрос(ПутьРесурса);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
		СИ_НастройкиАгента.УстановитьЗаголовкиАвторизации(HTTPЗапрос, Настройки);
		
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		
		HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		ЗаголовкиОтвета = ПолучитьЗаголовкиОтвета(HTTPОтвет);
		
		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Тело = HTTPОтвет.ПолучитьТелоКакСтроку();
			ОтветДанные = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(Тело);

			ЕстьОшибкаВТеле = ОтветДанные <> Неопределено
				И СИ_РаботаСJSON.БезопасноПолучить(ОтветДанные, "error", Неопределено) <> Неопределено
				И СИ_РаботаСJSON.БезопасноПолучить(ОтветДанные, "choices", Неопределено) = Неопределено;
			Если ЕстьОшибкаВТеле Тогда
				ОшибкаAPI = РазобратьОшибкуИзДанных(ОтветДанные, Строка(HTTPОтвет.КодСостояния));
				Результат.КодОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаAPI, "КодОшибки", "400");
				Результат.ТекстОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаAPI, "ТекстОшибки", Тело);
				Результат.Заголовки = ЗаголовкиОтвета;

				ЗаписьЖурналаРегистрации("Агент1С.OpenAIКлиент.ОшибкаHTTP", УровеньЖурналаРегистрации.Ошибка, , ,
					"Код: " + Результат.КодОшибки + " | Путь: " + ПутьРесурса
					+ " | Текст: " + Лев(Результат.ТекстОшибки, 150));
			Иначе
				Результат.Успех = Истина;
				Результат.Ответ = ОтветДанные;
				Результат.Заголовки = ЗаголовкиОтвета;
			КонецЕсли;
		Иначе
			ОшибкаAPI = ОбработатьОшибкуAPI(HTTPОтвет);
			Результат.КодОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаAPI, "КодОшибки", Строка(HTTPОтвет.КодСостояния));
			Результат.ТекстОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаAPI, "ТекстОшибки", HTTPОтвет.ПолучитьТелоКакСтроку());
			Результат.Заголовки = ЗаголовкиОтвета;
			
			ЗаписьЖурналаРегистрации("Агент1С.OpenAIКлиент.ОшибкаHTTP", УровеньЖурналаРегистрации.Ошибка, , ,
				"Код: " + Результат.КодОшибки + " | Путь: " + ПутьРесурса);
		КонецЕсли;
		
	Исключение
		Результат.КодОшибки = "TRANSPORT";
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Потоковый вызов метода /v1/chat/completions с чтением SSE-потока.
//
// Параметры:
//  ПараметрыЗапроса - Структура - параметры запроса (как у ВызватьChatCompletion),
//    поле Потоковый игнорируется и принудительно устанавливается в Истина.
//  ОбработчикЧанка - ОписаниеОповещения - колбэк обработки каждого SSE-чанка.
//
// Возвращаемое значение:
//  Структура - итог потокового вызова:
//    * Успех - Булево - признак успешного завершения потока.
//    * СобранноеСообщение - Структура,Неопределено - финальное сообщение из всех чанков.
//    * ПричинаЗавершения - Строка - finish_reason.
//    * Метрики - Структура,Неопределено - usage ответа.
//    * КодОшибки - Строка,Неопределено - код ошибки транспорта.
//    * ТекстОшибки - Строка,Неопределено - описание ошибки транспорта.
Функция ВызватьChatCompletionПотоково(ПараметрыЗапроса, ОбработчикЧанка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("СобранноеСообщение", Неопределено);
	Результат.Вставить("ПричинаЗавершения", "");
	Результат.Вставить("Метрики", Неопределено);
	Результат.Вставить("КодОшибки", Неопределено);
	Результат.Вставить("ТекстОшибки", Неопределено);
	
	Попытка
		ПрофильЗапроса = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Профиль", Неопределено);
		Настройки = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Настройки", Неопределено);
		Если Настройки = Неопределено Тогда
			Настройки = СИ_НастройкиАгента.ПолучитьНастройки(ПрофильЗапроса);
		КонецЕсли;
		Если ПустаяСтрока(Настройки.БазовыйURL) Тогда
			Результат.КодОшибки = "CONFIG_ERROR";
			Результат.ТекстОшибки = "Не настроен БазовыйURL";
			Возврат Результат;
		КонецЕсли;
		
		ПараметрыЗапроса.Вставить("Потоковый", Истина);
		
		ПутьРесурса = СобратьПутьРесурса(Настройки);
		
		ТелоЗапроса = СформироватьТелоЗапроса(ПараметрыЗапроса, Настройки);
		Если ПустаяСтрока(ТелоЗапроса) Тогда
			Результат.КодОшибки = "PARAM_ERROR";
			Результат.ТекстОшибки = "Ошибка формирования тела запроса";
			Возврат Результат;
		КонецЕсли;
		
		HTTPСоединение = СИ_НастройкиАгента.СоздатьHTTPСоединениеПоНастройкам(Настройки);
		Если HTTPСоединение = Неопределено Тогда
			Результат.КодОшибки = "CONFIG_ERROR";
			Результат.ТекстОшибки = "Не удалось создать HTTP-соединение по настройкам профиля";
			Возврат Результат;
		КонецЕсли;
		
		HTTPЗапрос = Новый HTTPЗапрос(ПутьРесурса);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
		HTTPЗапрос.Заголовки.Вставить("Accept", "text/event-stream");
		HTTPЗапрос.Заголовки.Вставить("Cache-Control", "no-cache");
		СИ_НастройкиАгента.УстановитьЗаголовкиАвторизации(HTTPЗапрос, Настройки);
		
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		
		HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		Если HTTPОтвет.КодСостояния < 200 ИЛИ HTTPОтвет.КодСостояния >= 300 Тогда
			ОшибкаAPI = ОбработатьОшибкуAPI(HTTPОтвет);
			Результат.КодОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаAPI, "КодОшибки", Строка(HTTPОтвет.КодСостояния));
			Результат.ТекстОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаAPI, "ТекстОшибки", HTTPОтвет.ПолучитьТелоКакСтроку());
			Возврат Результат;
		КонецЕсли;

		Если ЯвляетсяSSEОтветом(HTTPОтвет) Тогда
			Поток = HTTPОтвет.ПолучитьТелоКакПоток();
		Иначе
			ТелоНеПоток = HTTPОтвет.ПолучитьТелоКакСтроку();
			ДанныеОшибки = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ТелоНеПоток);
			Если ДанныеОшибки <> Неопределено
				И СИ_РаботаСJSON.БезопасноПолучить(ДанныеОшибки, "error", Неопределено) <> Неопределено Тогда
				ОшибкаAPI = РазобратьОшибкуИзДанных(ДанныеОшибки, Строка(HTTPОтвет.КодСостояния));
				Результат.КодОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаAPI, "КодОшибки", "400");
				Результат.ТекстОшибки = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаAPI, "ТекстОшибки", ТелоНеПоток);
				ЗаписьЖурналаРегистрации("Агент1С.OpenAIКлиент.ОшибкаHTTP", УровеньЖурналаРегистрации.Ошибка, , ,
					"Код: " + Результат.КодОшибки + " | Путь: " + ПутьРесурса
					+ " | Текст: " + Лев(Результат.ТекстОшибки, 150));
				Возврат Результат;
			Иначе
				Поток = HTTPОтвет.ПолучитьТелоКакПоток();
			КонецЕсли;
		КонецЕсли;
		ЧанкиSSE = СИ_РаботаСJSON.ПрочитатьSSEПоток(Поток, ОбработчикЧанка);
		
		Дельты = Новый Массив;
		ПоследняяПричина = "";
		ФинальноеИспользование = Неопределено;
		
		Для Каждого Чанк Из ЧанкиSSE Цикл
			Если Чанк.Свойство("_done") И Чанк._done = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			Выборки = СИ_РаботаСJSON.БезопасноПолучить(Чанк, "choices", Неопределено);
			Если Выборки = Неопределено ИЛИ ТипЗнч(Выборки) <> Тип("Массив") ИЛИ Выборки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Выборка = Выборки[0];
			Дельта = СИ_РаботаСJSON.БезопасноПолучить(Выборка, "delta", Неопределено);
			Если Дельта <> Неопределено Тогда
				Дельты.Добавить(Дельта);
			КонецЕсли;
			
			Причина = СИ_РаботаСJSON.БезопасноПолучить(Выборка, "finish_reason", Неопределено);
			Если Причина <> Неопределено И ТипЗнч(Причина) = Тип("Строка") И НЕ ПустаяСтрока(Причина) Тогда
				ПоследняяПричина = Причина;
			КонецЕсли;
			
			Использование = СИ_РаботаСJSON.БезопасноПолучить(Чанк, "usage", Неопределено);
			Если Использование <> Неопределено Тогда
				ФинальноеИспользование = Использование;
			КонецЕсли;
		КонецЦикла;
		
		СобранноеСообщение = СлитьЧанкиПотока(Дельты);
		
		Результат.Успех = Истина;
		Результат.СобранноеСообщение = СобранноеСообщение;
		Результат.ПричинаЗавершения = ПоследняяПричина;
		Результат.Метрики = ФинальноеИспользование;
		
	Исключение
		Результат.КодОшибки = "TRANSPORT";
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Извлечение сообщения модели, причины завершения и вызовов инструментов из тела ответа API.
//
// Параметры:
//  Ответ - Структура - тело ответа /v1/chat/completions:
//    * Choices - Массив из Структура - варианты ответа API.
//    * Usage - Структура,Неопределено - метрики использования.
//
// Возвращаемое значение:
//  Структура - разобранный результат ответа:
//    * Сообщение - Структура,Неопределено - объект message из choices[0].
//    * ПричинаЗавершения - Строка - finish_reason из choices[0].
//    * ВызовыИнструментов - Массив из Структура - распарсенные вызовы инструментов (содержат поля Ид, Тип, Имя, Аргументы).
//    * Использование - Структура,Неопределено - копия поля Usage.
//    * Рассуждения - Строка - текст рассуждений модели (reasoning/reasoning_content).
Функция СобратьСообщениеИзОтвета(Ответ) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Сообщение", Неопределено);
	Результат.Вставить("ПричинаЗавершения", "");
	Результат.Вставить("ВызовыИнструментов", Новый Массив);
	Результат.Вставить("Использование", Неопределено);
	Результат.Вставить("Рассуждения", "");
	
	Если Ответ = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Использование = СИ_РаботаСJSON.БезопасноПолучить(Ответ, "usage", Неопределено);
	Если Использование <> Неопределено Тогда
		Результат.Использование = Использование;
	КонецЕсли;
	
	Выборки = СИ_РаботаСJSON.БезопасноПолучить(Ответ, "choices", Неопределено);
	
	Если Выборки = Неопределено ИЛИ ТипЗнч(Выборки) <> Тип("Массив") ИЛИ Выборки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = Выборки[0];
	Результат.ПричинаЗавершения = СИ_РаботаСJSON.БезопасноПолучить(Выборка, "finish_reason", "");
	
	Сообщение = СИ_РаботаСJSON.БезопасноПолучить(Выборка, "message", Неопределено);
	Если Сообщение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Сообщение = Сообщение;
	
	Рассуждения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "reasoning", Неопределено);
	Если Рассуждения = Неопределено Тогда
		Рассуждения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "reasoning_content", Неопределено);
	КонецЕсли;
	Если Рассуждения <> Неопределено И ТипЗнч(Рассуждения) = Тип("Строка") Тогда
		Результат.Рассуждения = Рассуждения;
	КонецЕсли;
	
	ВызовыИнструментов = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "tool_calls", Неопределено);
	Если ВызовыИнструментов <> Неопределено И ТипЗнч(ВызовыИнструментов) = Тип("Массив") Тогда
		РаспарсенныеВызовы = Новый Массив;
		ПропущеноПустыхИмен = 0;
		Для Каждого Вызов Из ВызовыИнструментов Цикл
			ДанныеФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "function", Неопределено);
			ИмяФункцииВызова = "";
			Если ДанныеФункции <> Неопределено Тогда
				ИмяФункцииВызова = СИ_РаботаСJSON.БезопасноПолучить(ДанныеФункции, "name", "");
			КонецЕсли;
			Если ТипЗнч(ИмяФункцииВызова) <> Тип("Строка") ИЛИ ПустаяСтрока(ИмяФункцииВызова) Тогда
				ПропущеноПустыхИмен = ПропущеноПустыхИмен + 1;
				Продолжить;
			КонецЕсли;
			
			РаспарсенныйВызов = Новый Структура;
			РаспарсенныйВызов.Вставить("Ид", СИ_РаботаСJSON.БезопасноПолучить(Вызов, "id", ""));
			РаспарсенныйВызов.Вставить("Тип", СИ_РаботаСJSON.БезопасноПолучить(Вызов, "type", "function"));
			
			АргументыJSON = СИ_РаботаСJSON.БезопасноПолучить(ДанныеФункции, "arguments", "{}");
			АргументыРаспарсенные = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(АргументыJSON);
			Если АргументыРаспарсенные = Неопределено Тогда
				АргументыРаспарсенные = Новый Соответствие;
			КонецЕсли;
			
			РаспарсенныйВызов.Вставить("Имя", ИмяФункцииВызова);
			РаспарсенныйВызов.Вставить("Аргументы", АргументыРаспарсенные);
			РаспарсенныеВызовы.Добавить(РаспарсенныйВызов);
		КонецЦикла;
		Результат.ВызовыИнструментов = РаспарсенныеВызовы;
		
		Если ПропущеноПустыхИмен > 0 Тогда
			ЗаписьЖурналаРегистрации("Агент1С.ПропущенВызовИнструмента",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"При разборе ответа модели пропущено tool_calls с пустым именем функции: "
				+ Строка(ПропущеноПустыхИмен) + ".");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Слияние массива SSE-дельт в единое сообщение ассистента.
//
// Параметры:
//  Чанки - Массив из Структура - массив разобранных объектов delta из SSE-потока.
//
// Возвращаемое значение:
//  Структура - собранное сообщение:
//    * Роль - Строка - роль отправителя (assistant).
//    * Контент - Строка - полный текст ответа.
//    * ВызовыИнструментов - Неопределено,Массив из Структура - вызовы, сгруппированные по Индекс.
//    * Рассуждения - Строка - полный текст рассуждений модели (reasoning/reasoning_content).
Функция СлитьЧанкиПотока(Чанки) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Роль", "assistant");
	Результат.Вставить("Контент", "");
	Результат.Вставить("ВызовыИнструментов", Неопределено);
	Результат.Вставить("Рассуждения", "");
	
	Если Чанки = Неопределено ИЛИ Чанки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПолныйКонтент = "";
	ПолныеРассуждения = "";
	ВызовыПоИндексу = Новый Соответствие;
	
	Для Каждого Чанк Из Чанки Цикл
		Контент = СИ_РаботаСJSON.БезопасноПолучить(Чанк, "content", "");
		Если ТипЗнч(Контент) = Тип("Строка") Тогда
			ПолныйКонтент = ПолныйКонтент + Контент;
		КонецЕсли;
		
		РассужденияЧанк = СИ_РаботаСJSON.БезопасноПолучить(Чанк, "reasoning", Неопределено);
		Если РассужденияЧанк = Неопределено Тогда
			РассужденияЧанк = СИ_РаботаСJSON.БезопасноПолучить(Чанк, "reasoning_content", Неопределено);
		КонецЕсли;
		Если РассужденияЧанк <> Неопределено И ТипЗнч(РассужденияЧанк) = Тип("Строка") Тогда
			ПолныеРассуждения = ПолныеРассуждения + РассужденияЧанк;
		КонецЕсли;
		
		ВызовыИнструментов = СИ_РаботаСJSON.БезопасноПолучить(Чанк, "tool_calls", Неопределено);
		Если ВызовыИнструментов <> Неопределено И ТипЗнч(ВызовыИнструментов) = Тип("Массив") Тогда
			Для Каждого Вызов Из ВызовыИнструментов Цикл
				Индекс = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "index", 0);
				КлючИндекса = Строка(Индекс);
				
				Если НЕ ВызовыПоИндексу.Свойство(КлючИндекса) Тогда
					НовыйВызов = Новый Структура;
					НовыйВызов.Вставить("Ид", "");
					НовыйВызов.Вставить("Тип", "function");
					НовыйВызов.Вставить("Функция", Новый Структура);
					НовыйВызов.Функция.Вставить("Имя", "");
					НовыйВызов.Функция.Вставить("Аргументы", "");
					ВызовыПоИндексу.Вставить(КлючИндекса, НовыйВызов);
				КонецЕсли;
				
				СуществующийВызов = ВызовыПоИндексу.Получить(КлючИндекса);
				
				Ид = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "id", "");
				Если ТипЗнч(Ид) = Тип("Строка") И НЕ ПустаяСтрока(Ид) Тогда
					СуществующийВызов.Ид = Ид;
				КонецЕсли;
				
				ВызовФункция = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "function", Неопределено);
				Если ВызовФункция <> Неопределено Тогда
					ИмяФункцииВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовФункция, "name", "");
					Если ТипЗнч(ИмяФункцииВызова) = Тип("Строка") И НЕ ПустаяСтрока(ИмяФункцииВызова) Тогда
						СуществующийВызов.Функция.Имя = ИмяФункцииВызова;
					КонецЕсли;
					
					АргументыВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовФункция, "arguments", "");
					Если ТипЗнч(АргументыВызова) = Тип("Строка") Тогда
						СуществующийВызов.Функция.Аргументы = СуществующийВызов.Функция.Аргументы + АргументыВызова;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Результат.Контент = ПолныйКонтент;
	Результат.Рассуждения = ПолныеРассуждения;
	
	Если ВызовыПоИндексу.Количество() > 0 Тогда
		ИтоговыеВызовы = Новый Массив;
		ПропущеноПустыхИмен = 0;
		Для Каждого КлючЗначение Из ВызовыПоИндексу Цикл
			СобранныйВызов = КлючЗначение.Значение;
			ИмяСобранногоВызова = "";
			Если СобранныйВызов <> Неопределено И СобранныйВызов.Свойство("Функция") Тогда
				ИмяСобранногоВызова = СИ_РаботаСJSON.БезопасноПолучить(СобранныйВызов.Функция, "Имя", "");
			КонецЕсли;
			Если ТипЗнч(ИмяСобранногоВызова) <> Тип("Строка") ИЛИ ПустаяСтрока(ИмяСобранногоВызова) Тогда
				ПропущеноПустыхИмен = ПропущеноПустыхИмен + 1;
				Продолжить;
			КонецЕсли;
			ИтоговыеВызовы.Добавить(СобранныйВызов);
		КонецЦикла;
		
		Если ПропущеноПустыхИмен > 0 Тогда
			ЗаписьЖурналаРегистрации("Агент1С.ПропущенВызовИнструмента",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"При слиянии чанков SSE-потока пропущено tool_calls с пустым именем функции: "
				+ Строка(ПропущеноПустыхИмен) + ".");
		КонецЕсли;
		
		Если ИтоговыеВызовы.Количество() > 0 Тогда
			Результат.ВызовыИнструментов = ИтоговыеВызовы;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Формирование JSON-строки тела запроса к /v1/chat/completions из структуры параметров.
//
// Параметры:
//  ПараметрыЗапроса - Структура - параметры запроса, сериализуемые в JSON:
//    * Модель - Строка - идентификатор модели (если пусто, используется модель по умолчанию из ТЧ Модели профиля).
//    * Сообщения - Массив из Структура - сообщения; ключи нормализуются в английские.
//    * Температура - Число - параметр сэмплирования (по умолчанию 0.7).
//    * MaxTokens - Число,Неопределено - лимит токенов ответа (передаётся при Неопределено).
//    * Потоковый - Булево - признак потокового режима (по умолчанию Ложь).
//    * Инструменты - Массив из Структура,Неопределено - описания функций tools.
//    * ВыборИнструмента - Строка,Структура,Неопределено - значение tool_choice.
//    * ФорматОтвета - Соответствие из Строка,Произвольный,Структура,Неопределено - значение response_format.
//    * РазрешитьРассуждения - Булево - глобальный флаг из профиля (по умолчанию Ложь).
//    * ОтключитьРассуждения - Булево - принудительное отключение рассуждений для итерации.
//    * Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль (используется,
//      только когда Настройки не переданы).
//  Настройки - Структура,Неопределено - уже прочитанные настройки агента (оптимизация,
//    исключает повторный запрос к БД); при Неопределено читаются по Профиль.
//
// Возвращаемое значение:
//  Строка - JSON-строка тела запроса ("" при ошибке сериализации).
Функция СформироватьТелоЗапроса(ПараметрыЗапроса, Настройки = Неопределено) Экспорт
	Попытка
		ТелоОбъект = Новый Соответствие;
		
		Модель = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Модель", "");
		Если ПустаяСтрока(Модель) Тогда
			Если Настройки = Неопределено Тогда
				ПрофильЗапроса = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Профиль", Неопределено);
				Настройки = СИ_НастройкиАгента.ПолучитьНастройки(ПрофильЗапроса);
			КонецЕсли;
			ПрофильДляМодели = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Профиль", Неопределено);
			Модель = СИ_НастройкиАгента.ПолучитьМодельПоУмолчанию(ПрофильДляМодели);
			Если ПустаяСтрока(Модель) Тогда
				Модель = Настройки.МодельПоУмолчанию;
			КонецЕсли;
		КонецЕсли;
		ТелоОбъект.Вставить("model", Модель);
		
		Сообщения = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Сообщения", Новый Массив);
		Сообщения = НормализоватьКлючиСообщений(Сообщения);
		ТелоОбъект.Вставить("messages", Сообщения);
		
		Температура = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Температура", 0.7);
		ТелоОбъект.Вставить("temperature", Температура);
		
		MaxTokens = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "MaxTokens", Неопределено);
		Если MaxTokens <> Неопределено Тогда
			ТелоОбъект.Вставить("max_tokens", MaxTokens);
		КонецЕсли;
		
		Потоковый = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Потоковый", Ложь);
		ТелоОбъект.Вставить("stream", Потоковый);
		
		Инструменты = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Инструменты", Неопределено);
		Если Инструменты <> Неопределено И ТипЗнч(Инструменты) = Тип("Массив") И Инструменты.Количество() > 0 Тогда
			ТелоОбъект.Вставить("tools", Инструменты);
		КонецЕсли;
		
		ВыборИнструмента = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "ВыборИнструмента", Неопределено);
		Если ВыборИнструмента <> Неопределено Тогда
			ТелоОбъект.Вставить("tool_choice", ВыборИнструмента);
		КонецЕсли;
		
		ФорматОтвета = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "ФорматОтвета", Неопределено);
		Если ФорматОтвета <> Неопределено Тогда
			ТелоОбъект.Вставить("response_format", ФорматОтвета);
		КонецЕсли;
		
		РазрешитьРассуждения = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "РазрешитьРассуждения", Ложь);
		ОтключитьРассуждения = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "ОтключитьРассуждения", Ложь);
		РассужденияВключены = (РазрешитьРассуждения И НЕ ОтключитьРассуждения);
		
		Если НЕ РассужденияВключены Тогда
			ТелоОбъект.Вставить("think", Ложь);
			ТелоОбъект.Вставить("enable_thinking", Ложь);
		КонецЕсли;
		
		Возврат СИ_РаботаСJSON.ЗаписатьСтрокуJSON(ТелоОбъект);
	Исключение
		
		ЗаписьЖурналаРегистрации("Агент1С.Debug.ОшибкаСериализации", УровеньЖурналаРегистрации.Ошибка,,
			"Ошибка сериализации тела запроса: " + ОписаниеОшибки());
		
		Возврат "";
	КонецПопытки;
КонецФункции

// Разбор неуспешного ответа API и формирование стандартизованной структуры ошибки.
//
// Параметры:
//  HTTPОтвет - HTTPОтвет - объект ответа HTTP-вызова (код состояния >= 400).
//
// Возвращаемое значение:
//  Структура - описание ошибки:
//    * Успех - Булево - всегда Ложь.
//    * КодОшибки - Строка - строковое представление HTTP-кода (или error.code из тела).
//    * ТекстОшибки - Строка - текст ошибки из тела ответа (error.message или сырое тело).
Функция ОбработатьОшибкуAPI(HTTPОтвет) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("ТекстОшибки", "");
	
	Если HTTPОтвет = Неопределено Тогда
		Результат.КодОшибки = "NO_RESPONSE";
		Результат.ТекстОшибки = "Не получен ответ от сервера";
		Возврат Результат;
	КонецЕсли;
	
	Результат.КодОшибки = Строка(HTTPОтвет.КодСостояния);
	
	Попытка
		ТелоОшибки = HTTPОтвет.ПолучитьТелоКакСтроку();
		Если НЕ ПустаяСтрока(ТелоОшибки) Тогда
			ДанныеОшибки = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ТелоОшибки);
			Если ДанныеОшибки <> Неопределено Тогда
				Разобранная = РазобратьОшибкуИзДанных(ДанныеОшибки, Строка(HTTPОтвет.КодСостояния));
				Если НЕ ПустаяСтрока(СИ_РаботаСJSON.БезопасноПолучить(Разобранная, "ТекстОшибки", "")) Тогда
					Результат.ТекстОшибки = СИ_РаботаСJSON.БезопасноПолучить(Разобранная, "ТекстОшибки", "");
					КодРазобранный = СИ_РаботаСJSON.БезопасноПолучить(Разобранная, "КодОшибки", "");
					Если НЕ ПустаяСтрока(КодРазобранный) И КодРазобранный <> "400" Тогда
						Результат.КодОшибки = КодРазобранный;
					КонецЕсли;
				Иначе
					Результат.ТекстОшибки = ТелоОшибки;
				КонецЕсли;
			Иначе
				Результат.ТекстОшибки = ТелоОшибки;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат.ТекстОшибки = "HTTP " + Результат.КодОшибки;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Разбирает данные ошибки из тела ответа API независимо от того, как провайдер
// упаковал ошибку. Поддерживаемые форматы:
//   1. OpenAI-формат: { "error": { "message": "...", "code": "..." } }
//   2. Прокси-шлюзы (routerai и т.п.): { "error": "{\"error\":{\"message\":\"...\",\"code\":400}}" } —
//      value ключа error является СТРОКОЙ, содержащей вложенный JSON ошибки.
//   3. Плоский формат: { "message": "...", "code": "..." } (без обёртки error).
//
// Параметры:
//  Данные - Соответствие,Структура - разобранное тело ответа (JSON-объект).
//  КодПоУмолчанию - Строка - код ошибки, если не удалось извлечь из тела (например, "400").
//
// Возвращаемое значение:
//  Структура:
//    * КодОшибки - Строка - код ошибки.
//    * ТекстОшибки - Строка - текст ошибки (message), либо пустая строка, если не извлечён.
Функция РазобратьОшибкуИзДанных(Данные, КодПоУмолчанию = "400") Экспорт
	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", КодПоУмолчанию);
	Результат.Вставить("ТекстОшибки", "");

	Если Данные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ОшибкаAPI = СИ_РаботаСJSON.БезопасноПолучить(Данные, "error", Неопределено);
	Если ОшибкаAPI = Неопределено Тогда
		СообщениеПлоское = СИ_РаботаСJSON.БезопасноПолучить(Данные, "message", Неопределено);
		Если СообщениеПлоское <> Неопределено И ТипЗнч(СообщениеПлоское) = Тип("Строка") И НЕ ПустаяСтрока(СообщениеПлоское) Тогда
			Результат.ТекстОшибки = СообщениеПлоское;
			КодПлоский = СИ_РаботаСJSON.БезопасноПолучить(Данные, "code", Неопределено);
			Если КодПлоский <> Неопределено Тогда
				Результат.КодОшибки = Строка(КодПлоский);
			КонецЕсли;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ОшибкаAPI) = Тип("Строка") Тогда
		Вложенные = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ОшибкаAPI);
		Если Вложенные <> Неопределено Тогда
			ОшибкаВлож = СИ_РаботаСJSON.БезопасноПолучить(Вложенные, "error", Неопределено);
			Если ОшибкаВлож = Неопределено Тогда
				ОшибкаВлож = Вложенные;
			КонецЕсли;
			РазобратьВложенную(ОшибкаВлож, Результат);
		Иначе
			Если НЕ ПустаяСтрока(ОшибкаAPI) Тогда
				Результат.ТекстОшибки = ОшибкаAPI;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОшибкаAPI) = Тип("Соответствие") ИЛИ ТипЗнч(ОшибкаAPI) = Тип("Структура") Тогда
		РазобратьВложенную(ОшибкаAPI, Результат);
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Заполняет Результат из объекта ошибки (error-объект OpenAI: message/code).
//
// Параметры:
//  ОшибкаОбъект - Соответствие,Структура - объект ошибки.
//  Результат - Структура - результат РазобратьОшибкуИзДанных (модифицируется).
Процедура РазобратьВложенную(ОшибкаОбъект, Результат)
	Если ОшибкаОбъект = Неопределено ИЛИ (ТипЗнч(ОшибкаОбъект) <> Тип("Соответствие") И ТипЗнч(ОшибкаОбъект) <> Тип("Структура")) Тогда
		Возврат;
	КонецЕсли;

	Сообщение = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаОбъект, "message", Неопределено);
	Если Сообщение <> Неопределено И ТипЗнч(Сообщение) = Тип("Строка") И НЕ ПустаяСтрока(Сообщение) Тогда
		Результат.ТекстОшибки = Сообщение;
	КонецЕсли;

	Код = СИ_РаботаСJSON.БезопасноПолучить(ОшибкаОбъект, "code", Неопределено);
	Если Код <> Неопределено И НЕ ПустаяСтрока(Строка(Код)) Тогда
		Результат.КодОшибки = Строка(Код);
	КонецЕсли;
КонецПроцедуры

// Нормализует массив vision content-блоков сообщения в формат OpenAI:
// [{type:"text", text:"..."}, {type:"image_url", image_url:{url:"..."}}].
//
// Параметры:
//  Блоки - Массив из Произвольный - массив блоков контента. Каждый блок — Структура или
//    Соответствие с русскими (Тип/Текст/ИзображениеURL/Изображение) или английскими
//    (type/text/image_url/image) ключами.
//
// Возвращаемое значение:
//  Массив из Соответствие,Неопределено - нормализованные блоки; Неопределено при пустом/некорректном массиве.
Функция НормализоватьКонтентБлоки(Блоки)
	Результат = Новый Массив;
	
	Если Блоки = Неопределено ИЛИ ТипЗнч(Блоки) <> Тип("Массив") ИЛИ Блоки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Блок Из Блоки Цикл
		Если Блок = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТипБлока = СИ_РаботаСJSON.БезопасноПолучить(Блок, "type", Неопределено);
		Если ТипБлока = Неопределено Тогда
			ТипБлока = СИ_РаботаСJSON.БезопасноПолучить(Блок, "Тип", "text");
		КонецЕсли;
		Если НЕ ТипЗнч(ТипБлока) = Тип("Строка") Тогда
			ТипБлока = "text";
		КонецЕсли;
		
		НовыйБлок = Новый Соответствие;
		НовыйБлок.Вставить("type", НРег(ТипБлока));
		
		Если НРег(ТипБлока) = "text" Тогда
			Текст = СИ_РаботаСJSON.БезопасноПолучить(Блок, "text", Неопределено);
			Если Текст = Неопределено Тогда
				Текст = СИ_РаботаСJSON.БезопасноПолучить(Блок, "Текст", "");
			КонецЕсли;
			НовыйБлок.Вставить("text", ?(Текст = Неопределено, "", Строка(Текст)));
		ИначеЕсли НРег(ТипБлока) = "image_url" Тогда
			Изображение = СИ_РаботаСJSON.БезопасноПолучить(Блок, "image_url", Неопределено);
			Если Изображение = Неопределено Тогда
				Изображение = СИ_РаботаСJSON.БезопасноПолучить(Блок, "image", Неопределено);
			КонецЕсли;
			Если Изображение = Неопределено Тогда
				Изображение = СИ_РаботаСJSON.БезопасноПолучить(Блок, "ИзображениеURL", Неопределено);
			КонецЕсли;
			Если Изображение = Неопределено Тогда
				Изображение = СИ_РаботаСJSON.БезопасноПолучить(Блок, "Изображение", Неопределено);
			КонецЕсли;
			
			ОбъектИзображения = Новый Соответствие;
			Если ТипЗнч(Изображение) = Тип("Строка") Тогда
				ОбъектИзображения.Вставить("url", Изображение);
			ИначеЕсли ТипЗнч(Изображение) = Тип("Соответствие") ИЛИ ТипЗнч(Изображение) = Тип("Структура") Тогда
				URLИзображения = СИ_РаботаСJSON.БезопасноПолучить(Изображение, "url", "");
				ОбъектИзображения.Вставить("url", URLИзображения);
				Детализация = СИ_РаботаСJSON.БезопасноПолучить(Изображение, "detail", Неопределено);
				Если Детализация <> Неопределено Тогда
					ОбъектИзображения.Вставить("detail", Детализация);
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			НовыйБлок.Вставить("image_url", ОбъектИзображения);
		Иначе
			НовыйБлок = СИ_РаботаСJSON.СтруктуруВСоответствие(Блок);
		КонецЕсли;
		
		Результат.Добавить(НовыйБлок);
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует путь ресурса /chat/completions из настроек подключения.
// БазовыйURL должен содержать полный путь с версией API (например, https://api.openai.com/v1),
// поэтому конечный путь = {путь из БазовыйURL}/chat/completions.
// Единая точка построения пути для синхронного и потокового вызовов.
//
// Параметры:
//  Настройки - Структура - настройки агента (как в ПолучитьНастройки):
//    * БазовыйURL - Строка - базовый URL endpoint (с версией, например https://api.openai.com/v1).
//
// Возвращаемое значение:
//  Строка - путь ресурса (например, "/v1/chat/completions").
Функция СобратьПутьРесурса(Настройки)
	БазовыйURL = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "БазовыйURL", "");
	
	ПутьРесурса = БазовыйURL;
	Если СтрНачинаетсяС(ПутьРесурса, "https://") Тогда
		ПутьРесурса = Сред(ПутьРесурса, 9);
	ИначеЕсли СтрНачинаетсяС(ПутьРесурса, "http://") Тогда
		ПутьРесурса = Сред(ПутьРесурса, 8);
	КонецЕсли;
	ПозицияПервогоСлеша = СтрНайти(ПутьРесурса, "/");
	Если ПозицияПервогоСлеша > 0 Тогда
		ПутьРесурса = Сред(ПутьРесурса, ПозицияПервогоСлеша);
	Иначе
		ПутьРесурса = "";
	КонецЕсли;
	
	Если Прав(ПутьРесурса, 1) <> "/" И НЕ ПустаяСтрока(ПутьРесурса) Тогда
		ПутьРесурса = ПутьРесурса + "/";
	КонецЕсли;
	
	Возврат ПутьРесурса + "chat/completions";
КонецФункции

// Извлечение заголовков из HTTP-ответа.
//
// Параметры:
//  HTTPОтвет - HTTPОтвет - объект ответа HTTP-вызова.
//
// Возвращаемое значение:
//  Соответствие из Строка,Строка - заголовки ответа (все доступные заголовки).
Функция ПолучитьЗаголовкиОтвета(HTTPОтвет)
	Заголовки = Новый Соответствие;
	Попытка
		Для Каждого КлючЗначение Из HTTPОтвет.Заголовки Цикл
			Заголовки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.OpenAIКлиент.ПолучитьЗаголовкиОтвета", УровеньЖурналаРегистрации.Ошибка,
			, , "Ошибка получения заголовков ответа: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Заголовки;
КонецФункции

// Проверяет, что HTTP-ответ является SSE-потоком (Content-Type: text/event-stream).
// Часть прокси-шлюзов на потоковый вызов отвечают HTTP 2xx, но НЕ SSE-потоком,
// а JSON-телом ошибки — это нужно распознать ДО чтения потока.
//
// Параметры:
//  HTTPОтвет - HTTPОтвет - объект ответа HTTP-вызова.
//
// Возвращаемое значение:
//  Булево - Истина, если ответ является SSE-потоком.
Функция ЯвляетсяSSEОтветом(HTTPОтвет)
	Если HTTPОтвет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		ТипКонтента = "";
		Для Каждого КлючЗначение Из HTTPОтвет.Заголовки Цикл
			ИмяЗаголовка = НРег(Строка(КлючЗначение.Ключ));
			Если ИмяЗаголовка = "content-type" Тогда
				ТипКонтента = Строка(КлючЗначение.Значение);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат НРег(ТипКонтента) = "text/event-stream";
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Нормализация ключей сообщений из русских в английские для совместимости с API.
// Поддерживаются русские ключи: Роль/Контент/ВызовыИнструментов/Ид/Тип/Функция/Имя/Аргументы/ИдВызоваИнструмента.
//
// Защита (ТЗ v2): вызовы с пустым именем функции отбрасываются (API отклоняет
// "name": "" HTTP 400); "висячие" role=tool сообщения (без родительского вызова
// с непустым именем) отбрасываются целиком. Это даёт самолечение диалогов,
// чьи tool_calls были повреждены раунд-трипом сжатия.
//
// Параметры:
//  Сообщения - Массив из Структура,Произвольный - массив сообщений с возможными русскими ключами
//    (элементы - Структура или Соответствие).
//
// Возвращаемое значение:
//  Массив из Произвольный - массив сообщений с английскими ключами (элементы - Соответствие).
Функция НормализоватьКлючиСообщений(Сообщения)
	ВалидныеИдВызовов = Новый Соответствие;
	Для Каждого СообщениеИзПрохода1 Из Сообщения Цикл
		ТулКоллыПрохода1 = СИ_РаботаСJSON.БезопасноПолучить(СообщениеИзПрохода1, "tool_calls", Неопределено);
		Если ТулКоллыПрохода1 = Неопределено Тогда
			ТулКоллыПрохода1 = СИ_РаботаСJSON.БезопасноПолучить(СообщениеИзПрохода1, "ВызовыИнструментов", Неопределено);
		КонецЕсли;
		Если ТулКоллыПрохода1 = Неопределено ИЛИ ТипЗнч(ТулКоллыПрохода1) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ВызовПрохода1 Из ТулКоллыПрохода1 Цикл
			Если ИмяФункцииВызоваИзToolCall(ВызовПрохода1) = "" Тогда
				Продолжить;
			КонецЕсли;
			ИдВызоваВалидного = СИ_РаботаСJSON.БезопасноПолучить(ВызовПрохода1, "id", "");
			Если ПустаяСтрока(ИдВызоваВалидного) Тогда
				ИдВызоваВалидного = СИ_РаботаСJSON.БезопасноПолучить(ВызовПрохода1, "Ид", "");
			КонецЕсли;
			Если НЕ ПустаяСтрока(ИдВызоваВалидного) Тогда
				ВалидныеИдВызовов.Вставить(ИдВызоваВалидного, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ОтвеченныеИд = Новый Соответствие;
	Для Каждого СообщениеИзПрохода1 Из Сообщения Цикл
		РольПрохода1 = СИ_РаботаСJSON.БезопасноПолучить(СообщениеИзПрохода1, "role", Неопределено);
		Если РольПрохода1 = Неопределено Тогда
			РольПрохода1 = СИ_РаботаСJSON.БезопасноПолучить(СообщениеИзПрохода1, "Роль", "");
		КонецЕсли;
		Если РольПрохода1 <> "tool" Тогда
			Продолжить;
		КонецЕсли;
		ИдОтветаПрохода1 = СИ_РаботаСJSON.БезопасноПолучить(СообщениеИзПрохода1, "tool_call_id", "");
		Если ПустаяСтрока(ИдОтветаПрохода1) Тогда
			ИдОтветаПрохода1 = СИ_РаботаСJSON.БезопасноПолучить(СообщениеИзПрохода1, "ИдВызоваИнструмента", "");
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИдОтветаПрохода1) Тогда
			ОтвеченныеИд.Вставить(ИдОтветаПрохода1, Истина);
		КонецЕсли;
	КонецЦикла;

	НеотвеченныеИд = Новый Соответствие;
	Для Каждого ЭлементВалидногоИд Из ВалидныеИдВызовов Цикл
		Если ОтвеченныеИд.Получить(ЭлементВалидногоИд.Ключ) = Неопределено Тогда
			НеотвеченныеИд.Вставить(ЭлементВалидногоИд.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	ПропущеноПустыхИмен = 0;
	ПропущеноВисячихTool = 0;
	ДостроеноОтветов = 0;
	
	Для Каждого Сообщение Из Сообщения Цикл
		НовоеСообщение = Новый Соответствие;
		
		Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "role", Неопределено);
		Если Роль = Неопределено Тогда
			Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
		КонецЕсли;
		НовоеСообщение.Вставить("role", Роль);
		
		Если Роль = "tool" Тогда
			ИдВызоваИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "tool_call_id", "");
			Если ПустаяСтрока(ИдВызоваИнструмента) Тогда
				ИдВызоваИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИдВызоваИнструмента", "");
			КонецЕсли;
			Если ПустаяСтрока(ИдВызоваИнструмента) ИЛИ ВалидныеИдВызовов.Получить(ИдВызоваИнструмента) = Неопределено Тогда
				ПропущеноВисячихTool = ПропущеноВисячихTool + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НормализованныеВызовы = Неопределено;
		ТулКоллы = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "tool_calls", Неопределено);
		Если ТулКоллы = Неопределено Тогда
			ТулКоллы = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ВызовыИнструментов", Неопределено);
		КонецЕсли;
		Если ТулКоллы <> Неопределено И ТипЗнч(ТулКоллы) = Тип("Массив") И ТулКоллы.Количество() > 0 Тогда
			НормализованныеВызовы = Новый Массив;
			Для Каждого Вызов Из ТулКоллы Цикл
				Если ИмяФункцииВызоваИзToolCall(Вызов) = "" Тогда
					ПропущеноПустыхИмен = ПропущеноПустыхИмен + 1;
					Продолжить;
				КонецЕсли;
				
				НовыйВызов = Новый Соответствие;
				
				ИдВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "id", "");
				Если ПустаяСтрока(ИдВызова) Тогда
					ИдВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Ид", "");
				КонецЕсли;
				НовыйВызов.Вставить("id", ИдВызова);
				
				ТипВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "type", "function");
				НовыйВызов.Вставить("type", ТипВызова);
				
				ФункцияВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "function", Неопределено);
				Если ФункцияВызова = Неопределено Тогда
					ФункцияВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Функция", Неопределено);
				КонецЕсли;
				
				НоваяФункция = Новый Соответствие;
				Если ФункцияВызова <> Неопределено Тогда
					ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "name", "");
					Если ПустаяСтрока(ИмяФункции) Тогда
						ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "Имя", "");
					КонецЕсли;
					НоваяФункция.Вставить("name", ИмяФункции);
					
					АргументыФункции = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "arguments", "");
					Если ПустаяСтрока(АргументыФункции) Тогда
						АргументыФункции = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "Аргументы", "");
					КонецЕсли;
					НоваяФункция.Вставить("arguments", АргументыФункции);
				Иначе
					ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Имя", "");
					Если ПустаяСтрока(ИмяФункции) Тогда
						ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "name", "");
					КонецЕсли;
					Если НЕ ПустаяСтрока(ИмяФункции) Тогда
						НоваяФункция.Вставить("name", ИмяФункции);
					КонецЕсли;
					
					АргументыФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Аргументы", "");
					Если ПустаяСтрока(АргументыФункции) Тогда
						АргументыФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "arguments", "");
					КонецЕсли;
					Если НЕ ПустаяСтрока(АргументыФункции) Тогда
						НоваяФункция.Вставить("arguments", АргументыФункции);
					КонецЕсли;
				КонецЕсли;
				НовыйВызов.Вставить("function", НоваяФункция);
				
				НормализованныеВызовы.Добавить(НовыйВызов);
			КонецЦикла;
			Если НормализованныеВызовы.Количество() = 0 Тогда
				НормализованныеВызовы = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		ЕстьТулКоллы = (НормализованныеВызовы <> Неопределено И НормализованныеВызовы.Количество() > 0);
		Контент = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "content", Неопределено);
		Если Контент = Неопределено Тогда
			Контент = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Контент", Неопределено);
		КонецЕсли;
		Если Контент <> Неопределено И ТипЗнч(Контент) = Тип("Массив") Тогда
			НормализованныеБлоки = НормализоватьКонтентБлоки(Контент);
			Если НормализованныеБлоки <> Неопределено И НормализованныеБлоки.Количество() > 0 Тогда
				НовоеСообщение.Вставить("content", НормализованныеБлоки);
			КонецЕсли;
		ИначеЕсли Контент <> Неопределено И ТипЗнч(Контент) = Тип("Строка") И НЕ ПустаяСтрока(Контент) Тогда
			НовоеСообщение.Вставить("content", Контент);
		ИначеЕсли Контент <> Неопределено И ТипЗнч(Контент) = Тип("Строка") И ПустаяСтрока(Контент) Тогда
			Если НЕ ЕстьТулКоллы Тогда
				НовоеСообщение.Вставить("content", "");
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьТулКоллы Тогда
			НовоеСообщение.Вставить("tool_calls", НормализованныеВызовы);
		КонецЕсли;
		
		ИдВызоваИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "tool_call_id", Неопределено);
		Если ИдВызоваИнструмента = Неопределено Тогда
			ИдВызоваИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИдВызоваИнструмента", Неопределено);
		КонецЕсли;
		Если ИдВызоваИнструмента <> Неопределено Тогда
			НовоеСообщение.Вставить("tool_call_id", ИдВызоваИнструмента);
		КонецЕсли;
		
		Результат.Добавить(НовоеСообщение);

		Если ЕстьТулКоллы И НеотвеченныеИд.Количество() > 0 Тогда
			Для Каждого ВызовДостройки Из НормализованныеВызовы Цикл
				ИдДостройки = СИ_РаботаСJSON.БезопасноПолучить(ВызовДостройки, "id", "");
				Если ПустаяСтрока(ИдДостройки) ИЛИ НеотвеченныеИд.Получить(ИдДостройки) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				НеотвеченныеИд.Удалить(ИдДостройки);

				СбойДостройки = Новый Соответствие;
				СбойДостройки.Вставить("Ошибка", "Вызов не был выполнен: предыдущий заход был прерван. "
					+ "При необходимости вызови инструмент заново.");
				ДостроенныйОтвет = Новый Соответствие;
				ДостроенныйОтвет.Вставить("role", "tool");
				ДостроенныйОтвет.Вставить("tool_call_id", ИдДостройки);
				ДостроенныйОтвет.Вставить("content", СИ_РаботаСJSON.ЗаписатьСтрокуJSON(СбойДостройки));
				Результат.Добавить(ДостроенныйОтвет);
				ДостроеноОтветов = ДостроеноОтветов + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если ПропущеноПустыхИмен > 0 Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ПропущенВызовИнструмента", УровеньЖурналаРегистрации.Предупреждение,,,
			"При нормализации сообщений пропущено tool_calls с пустым именем функции: " + Строка(ПропущеноПустыхИмен));
	КонецЕсли;
	Если ПропущеноВисячихTool > 0 Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ПропущенВызовИнструмента", УровеньЖурналаРегистрации.Предупреждение,,,
			"При нормализации сообщений отброшено «висячих» role=tool сообщений без родительского вызова: " + Строка(ПропущеноВисячихTool));
	КонецЕсли;
	Если ДостроеноОтветов > 0 Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ДостроеныВызовыИнструментов", УровеньЖурналаРегистрации.Информация,,,
			"Достроено ответов на прерванные вызовы инструментов: " + Строка(ДостроеноОтветов));
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Извлекает имя функции из tool_call произвольного формата (русские/английские ключи,
// вложенный function/Функция или плоский). Возвращает "" для вызова без имени;
// такие вызовы невалидны (API отклоняет "name": "" HTTP 400).
//
// Параметры:
//  Вызов - Структура,Соответствие - один элемент массива tool_calls.
//
// Возвращаемое значение:
//  Строка - непустое имя функции, либо "" если имя отсутствует/пусто/не строка.
Функция ИмяФункцииВызоваИзToolCall(Вызов)
	Если Вызов = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "name", "");
	Если ПустаяСтрока(ИмяФункции) Тогда
		ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Имя", "");
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяФункции) Тогда
		ФункцияВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "function", Неопределено);
		Если ФункцияВызова = Неопределено Тогда
			ФункцияВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Функция", Неопределено);
		КонецЕсли;
		Если ФункцияВызова <> Неопределено Тогда
			ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "name", "");
			Если ПустаяСтрока(ИмяФункции) Тогда
				ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "Имя", "");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ИмяФункции) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ИмяФункции;
КонецФункции

#КонецОбласти
