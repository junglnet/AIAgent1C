#Область ПрограммныйИнтерфейс

// Калькулятор - вычисление простых арифметических выражений.
//
// Параметры:
//  Аргументы - Структура - параметры:
//    * Выражение - Строка - арифметическое выражение в синтаксисе 1С.
//      Поддерживаются операции + - * /, скобки ( ) и десятичная точка.
//      Примеры: "2 + 3 * (10 - 10 / 2)", "100 / 4", "17.5 * 2".
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Число,Неопределено - результат вычисления.
//    * Ошибка - Строка,Неопределено - описание ошибки при Успех=Ложь.
Функция Калькулятор(Аргументы) Экспорт
	Результат = Новый Структура("Успех, Значение, Ошибка", Ложь, Неопределено, Неопределено);

	Выражение = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Выражение", "");

	Если ПустаяСтрока(Выражение) Тогда
		Результат.Ошибка = "Не передано выражение для вычисления";
		Возврат Результат;
	КонецЕсли;

	Если НЕ ВыражениеДопустимоДляВычисления(Выражение) Тогда
		Результат.Ошибка = "Выражение содержит недопустимые символы. Допустимы только цифры, операторы + - * /, скобки ( ), точка и пробел.";
		Возврат Результат;
	КонецЕсли;

	Попытка
		УстановитьБезопасныйРежим(Истина);
		Значение = Вычислить(Выражение);
		УстановитьБезопасныйРежим(Ложь);
	Исключение
		УстановитьБезопасныйРежим(Ложь);
		Результат.Ошибка = "Ошибка вычисления выражения: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Результат.Ошибка = "Результат выражения не является числом";
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Значение = Значение;

	Возврат Результат;
КонецФункции
// НарисоватьMermaid - отрисовка Mermaid-диаграммы через MCP-инструмент render_mermaid.
//
// Находит включённый MCP-сервер, у которого в ТЧ Инструменты есть разрешённый
// инструмент render_mermaid (справочник СИ_MCPСерверы), вызывает его,
// декодирует base64-изображение (Base64Значение) и сохраняет его
// как бинарный файл диалога (schema.<расширение>).
//
// Параметры:
//  Аргументы - Структура - параметры вызова инструмента (могут прийти как Соответствие):
//    * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог (пробрасывается движком).
//    * Код       - Строка - код диаграммы на языке Mermaid (без обрамляющих ```mermaid```).
//    * Формат    - Строка,Неопределено - png/jpeg/webp/svg (по умолчанию png).
//    * Тема      - Строка,Неопределено - тема оформления (default/neutral/dark/forest).
//    Размер (Ширина/Высота) не поддерживается и игнорируется: mermaid-cli v10+
//    удалил флаги -w/-H (plans/mermaid_mcp_contract.md, §6).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Структура,Неопределено - описание созданного файла:
//      ** Ссылка   - Строка - UUID файла диалога.
//      ** ИмяФайла - Строка - имя файла (например "schema.png").
//      ** Размер   - Число - размер изображения в байтах.
//    * Ошибка - Строка,Неопределено - описание ошибки при Успех=Ложь.
Функция НарисоватьMermaid(Аргументы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		ИдДиалога = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИдДиалога", Неопределено);
		Код = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Код", ""));
		ФорматИзображения = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Формат", ""));
		Тема = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Тема", ""));

		Если ПустаяСтрока(Код) Тогда
			Результат.Ошибка = "Не передан код диаграммы (параметр Код).";
			Возврат Результат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Результат.Ошибка = "Не передан идентификатор диалога (ИдДиалога).";
			Возврат Результат;
		КонецЕсли;

		ЗапросСервера = Новый Запрос;
		ЗапросСервера.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Инструменты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СИ_MCPСерверы.Инструменты КАК Инструменты
			|ГДЕ
			|	Инструменты.ИмяИнструмента = &ИмяИнструмента
			|	И Инструменты.Разрешен = ИСТИНА
			|	И Инструменты.Ссылка.Включен = ИСТИНА
			|	И Инструменты.Ссылка.ПометкаУдаления = ЛОЖЬ
			|УПОРЯДОЧИТЬ ПО
			|	Инструменты.ДатаРегистрации УБЫВ";
		ЗапросСервера.УстановитьПараметр("ИмяИнструмента", "render_mermaid");
		Выборка = ЗапросСервера.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Результат.Ошибка = "MCP-сервер с инструментом render_mermaid не найден: проверьте, что в СИ_MCPСерверы есть включённый сервер с разрешённым инструментом render_mermaid (ТЧ Инструменты)";
			Возврат Результат;
		КонецЕсли;
		СерверСсылка = Выборка.Ссылка;

		АргументыДляMCP = Новый Соответствие;
		АргументыДляMCP.Вставить("code", Код);
		Если НЕ ПустаяСтрока(ФорматИзображения) Тогда
			АргументыДляMCP.Вставить("format", НРег(СокрЛП(ФорматИзображения)));
		КонецЕсли;
		Если НЕ ПустаяСтрока(Тема) Тогда
			АргументыДляMCP.Вставить("theme", НРег(СокрЛП(Тема)));
		КонецЕсли;

		РезультатMCP = СИ_УправлениеИнструментамиMCP.ВызватьИнструмент(СерверСсылка, "render_mermaid", АргументыДляMCP);
		Если НЕ СИ_РаботаСJSON.БезопасноПолучить(РезультатMCP, "Успех", Ложь) Тогда
			Результат.Ошибка = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатMCP, "ОшибкаИсполнения",
				"MCP render_mermaid вернул ошибку"));
			Возврат Результат;
		КонецЕсли;

		Изображения = СИ_РаботаСJSON.БезопасноПолучить(РезультатMCP, "Изображения", Неопределено);
		Если Изображения = Неопределено ИЛИ ТипЗнч(Изображения) <> Тип("Массив")
			ИЛИ Изображения.Количество() = 0 Тогда
			Результат.Ошибка = "MCP render_mermaid не вернул изображение";
			Возврат Результат;
		КонецЕсли;

		Изображение = Изображения[0];
		MIME = НРег(СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Изображение, "MIME", "image/png"))));
		ДанныеBase64 = Строка(СИ_РаботаСJSON.БезопасноПолучить(Изображение, "ДанныеBase64", ""));
		Если ПустаяСтрока(ДанныеBase64) Тогда
			Результат.Ошибка = "MCP render_mermaid вернул пустое изображение";
			Возврат Результат;
		КонецЕсли;

		Если MIME = "image/jpeg" Тогда
			Расширение = "jpg";
		ИначеЕсли MIME = "image/webp" Тогда
			Расширение = "webp";
		ИначеЕсли MIME = "image/svg+xml" Тогда
			Расширение = "svg";
		Иначе
			Расширение = "png";
		КонецЕсли;

		ДвоичныеДанные = Base64Значение(ДанныеBase64);

		ИмяФайлаСхемы = "schema." + Расширение;
		СсылкаФайла = СИ_ФайлыДиалога.СохранитьБинарныйФайлВДиалоге(
			ИдДиалога, ИмяФайлаСхемы, ДвоичныеДанные, "Схема Mermaid");

		Если НЕ ЗначениеЗаполнено(СсылкаФайла) Тогда
			Результат.Ошибка = "Не удалось сохранить файл схемы в диалог: " + ИмяФайлаСхемы;
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;
		Результат.Значение = Новый Структура("Ссылка, ИмяФайла, Размер",
			Строка(СсылкаФайла.УникальныйИдентификатор()), ИмяФайлаСхемы, ДвоичныеДанные.Размер());

	Исключение
		Результат.Ошибка = "Ошибка отрисовки Mermaid: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_Инструменты1С.НарисоватьMermaid", УровеньЖурналаРегистрации.Ошибка, , ,
			Результат.Ошибка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#Область ИнструментыЗапросБД

// Максимальное число строк, возвращаемых модели: значение по умолчанию и потолок
// для параметра ЛимитСтрок. В текст запроса подставляется ПЕРВЫЕ на одну строку
// больше лимита результата (см. ВнедритьДирективы): лишняя строка нужна, чтобы
// флаг ЕстьЕщеДанные отличал «в отборе ровно столько строк» от «строк больше».
//
// Возвращаемое значение:
//  Число - лимит строк результата.
Функция ЛимитСтрокРезультата() Экспорт
	Возврат 100;
КонецФункции

// Потолок строк для выгрузки в файл (инструмент ExportTable): модель запрашивает
// выгрузку реже, чем чтение, и получает файл, а не строки в контекст, поэтому
// потолок на два порядка выше, чем у ExecuteDBQuery.
//
// Возвращаемое значение:
//  Число - максимальное число строк выгрузки.
Функция МаксимумСтрокВыгрузки() Экспорт
	Возврат 100000;
КонецФункции

// Лимит строк выгрузки по умолчанию.
//
// Возвращаемое значение:
//  Число - лимит строк результата выгрузки.
Функция ЛимитСтрокВыгрузкиПоУмолчанию() Экспорт
	Возврат 10000;
КонецФункции

