#Область ПрограммныйИнтерфейс

// Создание нового диалога и сохранение его заголовка в справочник СИ_ДиалогиАгента.
//
// Параметры:
//  Параметры - Структура - параметры диалога:
//    * Режим - СправочникСсылка.СИ_РежимиРаботы - ссылка на режим (CatalogRef)
//    * РежимСсылка - СправочникСсылка.СИ_РежимиРаботы - ссылка на элемент справочника (опционально, для обратной совместимости)
//    * Модель - Строка - идентификатор модели.
//    * Профиль - СправочникСсылка.СИ_ПрофилиПодключений - профиль подключения (опционально, приоритет над активным).
//    * ПрофильПодключения - СправочникСсылка.СИ_ПрофилиПодключений - алиас Профиль (для обратной совместимости).
//    * СистемныйПромпт - Строка,Неопределено - системный промпт.
//    * ТекущийПользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ДиалогиАгента - ссылка на созданный диалог.
Функция СоздатьДиалог(Параметры) Экспорт
	Попытка
		ИмяМодели = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Модель", "");
		СистемныйПромпт = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "СистемныйПромпт", Неопределено);
		ТекущийПользователь = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "ТекущийПользователь", Неопределено);
		
		ДиалогОбъект = Справочники.СИ_ДиалогиАгента.СоздатьЭлемент();
		ДиалогОбъект.Наименование = "Диалог от " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DDT;");
		РежимСсылкаДляСохранения = Справочники.СИ_РежимиРаботы.ПустаяСсылка();
		РежимИзПараметров = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Режим", Неопределено);
		Если РежимИзПараметров = Неопределено Тогда
			РежимИзПараметров = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "РежимСсылка", Неопределено);
		КонецЕсли;
		Если РежимИзПараметров <> Неопределено
			И ТипЗнч(РежимИзПараметров) = Тип("СправочникСсылка.СИ_РежимиРаботы")
			И ЗначениеЗаполнено(РежимИзПараметров) Тогда
			РежимСсылкаДляСохранения = РежимИзПараметров;
		КонецЕсли;
		ДиалогОбъект.Режим = РежимСсылкаДляСохранения;
		ДиалогОбъект.Модель = ИмяМодели;
		ДиалогОбъект.ДатаНачала = ТекущаяУниверсальнаяДата();
		ДиалогОбъект.Статус = Перечисления.СИ_СтатусыДиалога.Активен;
		ДиалогОбъект.Пользователь = ТекущийПользователь;
		
		Если СистемныйПромпт <> Неопределено И ТипЗнч(СистемныйПромпт) = Тип("Строка") Тогда
			ДиалогОбъект.СистемныйПромптСтрока = Лев(СистемныйПромпт, 255);
			Хранилище = Новый ХранилищеЗначения(СистемныйПромпт);
			ДиалогОбъект.СистемныйПромпт = Хранилище;
		КонецЕсли;
		
		ПрофильДляСохранения = Справочники.СИ_ПрофилиПодключений.ПустаяСсылка();
		ПрофильИзПараметров = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Профиль", Неопределено);
		Если ПрофильИзПараметров = Неопределено Тогда
			ПрофильИзПараметров = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "ПрофильПодключения", Неопределено);
		КонецЕсли;
		Если ПрофильИзПараметров <> Неопределено И ЗначениеЗаполнено(ПрофильИзПараметров) Тогда
			ПрофильДляСохранения = ПрофильИзПараметров;
		Иначе
			АктивныйРежим = Константы.СИ_АктивныйРежим.Получить();
			Если АктивныйРежим <> Неопределено И ЗначениеЗаполнено(АктивныйРежим) Тогда
				ПрофильАктивногоРежима = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктивныйРежим, "Профиль").Профиль;
				Если ЗначениеЗаполнено(ПрофильАктивногоРежима) Тогда
					ПрофильДляСохранения = ПрофильАктивногоРежима;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПрофильДляСохранения) Тогда
			ДиалогОбъект.ПрофильПодключения = ПрофильДляСохранения;
		КонецЕсли;
		
		ДиалогОбъект.Записать();
				
		Если СистемныйПромпт <> Неопределено И ТипЗнч(СистемныйПромпт) = Тип("Строка") И НЕ ПустаяСтрока(СистемныйПромпт) Тогда
			СистемноеСообщение = Новый Структура;
			СистемноеСообщение.Вставить("Роль", "system");
			СистемноеСообщение.Вставить("Контент", СистемныйПромпт);
			ДобавитьСообщение(ДиалогОбъект.Ссылка, СистемноеСообщение);
		КонецЕсли;
		
		Возврат ДиалогОбъект.Ссылка;
	Исключение
		ЗаписатьВЖурнал("СоздатьДиалог", УровеньЖурналаРегистрации.Ошибка, "Ошибка создания диалога: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Добавление сообщения в историю диалога с записью в регистр СИ_СообщенияДиалога.
// При переданном НомерСообщения запись выполняется без дополнительного запроса
// максимального номера (используется в ЗаменитьИсториюДиалога).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  Сообщение - Структура - сообщение в формате OpenAI:
//    * Роль - Строка - "system", "user", "assistant" или "tool".
//    * Контент - Строка,Неопределено - текст сообщения.
//    * ВызовыИнструментов - Массив из Структура,Неопределено - tool_calls.
//    * ИдВызоваИнструмента - Строка,Неопределено - для role=tool.
//    * ИмяИнструмента - Строка,Неопределено - для role=tool.
//  НомерСообщения - Неопределено,Число - явный номер записи; если Неопределено,
//    номер вычисляется автоматически (максимум + 1).
Процедура ДобавитьСообщение(ИдДиалога, Сообщение, НомерСообщения = Неопределено) Экспорт
	Попытка
		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Возврат;
		КонецЕсли;
		
		Роль = ПолучитьРольСообщения(Сообщение);
		Если ПустаяСтрока(Роль) Тогда
			Роль = "user";
		КонецЕсли;
		
		РольСсылка = РольСсылкаПоСтроке(Роль);
		
		Если НомерСообщения = Неопределено Тогда
			МаксНомер = ПолучитьМаксимальныйНомерСообщения(ИдДиалога);
			ЗначениеМаксНомера = МаксНомер;
			Если ТипЗнч(ЗначениеМаксНомера) = Тип("Null")
				ИЛИ ТипЗнч(ЗначениеМаксНомера) = Тип("Неопределено") Тогда
				ЗначениеМаксНомера = -1;
			КонецЕсли;
			НомерСообщения = Число(ЗначениеМаксНомера) + 1;
		КонецЕсли;
		
		ВызовыИнструментовJSON = СериализоватьВызовыИнструментов(Сообщение);
		
		Контент = ПолучитьКонтентСообщения(Сообщение);
		
		РассужденияСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Рассуждения", "");
		Если ПустаяСтрока(РассужденияСообщения) Тогда
			РассужденияСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "reasoning", "");
			Если ПустаяСтрока(РассужденияСообщения) Тогда
				РассужденияСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "reasoning_content", "");
			КонецЕсли;
		КонецЕсли;
		
		ИдВызоваИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИдВызоваИнструмента", "");
		Если ПустаяСтрока(ИдВызоваИнструмента) Тогда
			ИдВызоваИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "tool_call_id", "");
		КонецЕсли;
		
		ИмяИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИмяИнструмента", "");
		Если ПустаяСтрока(ИмяИнструмента) Тогда
			ИмяИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "name", "");
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.СИ_СообщенияДиалога.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдДиалога = ИдДиалога;
		МенеджерЗаписи.НомерСообщения = НомерСообщения;
		МенеджерЗаписи.Роль = РольСсылка;
		МенеджерЗаписи.Контент = Контент;
		МенеджерЗаписи.ВызовыИнструментовJSON = ВызовыИнструментовJSON;
		МенеджерЗаписи.ИдВызоваИнструмента = ИдВызоваИнструмента;
		МенеджерЗаписи.ИмяИнструмента = ИмяИнструмента;
		МенеджерЗаписи.Рассуждения = РассужденияСообщения;
		МенеджерЗаписи.МетаданныеСообщения = ХранилищеСсылокДокументов(Сообщение);
		МенеджерЗаписи.ДатаЗаписи = ТекущаяДатаСеанса();
		
		МенеджерЗаписи.Записать(Истина);
		
	Исключение
		ЗаписатьВЖурнал("ДобавитьСообщение", УровеньЖурналаРегистрации.Ошибка, "Ошибка добавления сообщения: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Создаёт буфер пакетной записи сообщений диалога.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Структура - буфер сообщений:
//   * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//   * Сообщения - Массив из Структура - накопленные сообщения (формат OpenAI).
//   * НачальныйНомер - Число - стартовый номер следующей партии (максимум + 1,
//     вычисляется ОДИН раз при создании буфера - без повторных запросов в цикле).
//   * СледующийНомер - Число - служебный счётчик (синхронизируется при сбросе).
Функция НовыйБуферСообщений(ИдДиалога) Экспорт
	Буфер = Новый Структура;
	Буфер.Вставить("ИдДиалога", ИдДиалога);
	Буфер.Вставить("Сообщения", Новый Массив);
	
	НачальныйНомер = ПолучитьМаксимальныйНомерСообщения(ИдДиалога) + 1;
	Буфер.Вставить("НачальныйНомер", НачальныйНомер);
	Буфер.Вставить("СледующийНомер", НачальныйНомер);
	
	Возврат Буфер;
КонецФункции

// Добавляет сообщение в буфер пакетной записи.
// Номер сообщению НЕ присваивается: он назначается при сбросе буфера подряд,
// что исключает «дырки» в нумерации даже при повторных сбросах одного буфера.
//
// В буфер кладётся КОПИЯ структуры с проставленным временем. Копия - потому что
// структуры в 1С ссылочные: tool-сообщения одни и те же объекты идут и в буфер,
// и в контекст для модели, и добавленный ключ «Время» ушёл бы в запрос к API.
// Время нужно, чтобы дата в чате и дата в истории совпадали: из буфера оно
// едет в живой пакет ВХ (форма рисует его в пузыре) и в регистр
// (ЗаполнитьЗаписьСообщения пишет его в ДатаЗаписи). Без этого в регистр попадало
// время пакетной записи в конце хода, и дата в чате менялась при перечитке.
//
// Параметры:
//  Буфер - Структура - буфер из НовыйБуферСообщений.
//  Сообщение - Структура - сообщение в формате OpenAI (как в ДобавитьСообщение).
Процедура ДобавитьСообщениеВБуфер(Буфер, Сообщение) Экспорт

	СообщениеБуфера = Новый Структура;
	Для Каждого КлючИЗначение Из Сообщение Цикл
		СообщениеБуфера.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	СообщениеБуфера.Вставить("Время", ТекущаяДатаСеанса());

	Буфер.Сообщения.Добавить(СообщениеБуфера);

КонецПроцедуры

// Сбрасывает буфер: пакетная ДОзапись всех накопленных сообщений в регистр
// одним набором записей в одной транзакции. При успехе очищает массив буфера
// и сдвигает НачальныйНомер. Сообщениям присваиваются номера подряд,
// начиная с Буфер.НачальныйНомер (без пересчёта максимума на каждое сообщение).
//
// Защита от конфликта номеров (конкурентная запись формы/фонового задания):
// при исключении выполняется ОДНОКРАТНЫЙ retry — пересчёт максимума и повторная
// запись в новой транзакции. При повторном сбое возвращается Ложь, а сообщения
// остаются в буфере (вызывающий код решает их судьбу).
//
// Параметры:
//  Буфер - Структура,Неопределено - буфер из НовыйБуферСообщений.
//
// Возвращаемое значение:
//  Булево - Истина при успешной записи (или пустом буфере).
Функция СброситьБуферСообщений(Буфер) Экспорт
	Если Буфер = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Буфер.Сообщения.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	КоличествоПопыток = 0;
	Пока Истина Цикл
		КоличествоПопыток = КоличествоПопыток + 1;
		
		НачатьТранзакцию();
		Попытка
			НаборЗаписей = РегистрыСведений.СИ_СообщенияДиалога.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдДиалога.Установить(Буфер.ИдДиалога);
			
			Номер = Буфер.НачальныйНомер;
			Для Каждого Сообщение Из Буфер.Сообщения Цикл
				Запись = НаборЗаписей.Добавить();
				ЗаполнитьЗаписьСообщения(Запись, Буфер.ИдДиалога, Сообщение, Номер);
				Номер = Номер + 1;
			КонецЦикла;
			
			НаборЗаписей.Записать(Ложь);
			ЗафиксироватьТранзакцию();
			
			Буфер.НачальныйНомер = Номер;
			Буфер.СледующийНомер = Номер;
			Буфер.Сообщения.Очистить();
			Возврат Истина;
		Исключение
			ОтменитьТранзакцию();
			
			Если КоличествоПопыток = 1 Тогда
				Попытка
					Буфер.НачальныйНомер = ПолучитьМаксимальныйНомерСообщения(Буфер.ИдДиалога) + 1;
					Буфер.СледующийНомер = Буфер.НачальныйНомер + Буфер.Сообщения.Количество();
					Продолжить;
				Исключение
					ЗаписатьВЖурнал("СброситьБуферСообщений", УровеньЖурналаРегистрации.Ошибка,
						"Не удалось пересчитать номер для повторной записи: " + ОписаниеОшибки());
					Возврат Ложь;
				КонецПопытки;
			КонецЕсли;
			
			ЗаписатьВЖурнал("СброситьБуферСообщений", УровеньЖурналаРегистрации.Ошибка,
				"Ошибка пакетной записи сообщений (в буфере: "
				+ Строка(Буфер.Сообщения.Количество()) + "): " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
КонецФункции

// Отменяет буфер: очищает накопленные сообщения БЕЗ записи в регистр.
// Используется при отмене захода пользователем, когда «оборванный» хвост
// показывать в истории не нужно.
//
// Параметры:
//  Буфер - Структура,Неопределено - буфер из НовыйБуферСообщений.
Процедура ОтменитьБуферСообщений(Буфер) Экспорт
	Если Буфер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Буфер.Сообщения.Очистить();
КонецПроцедуры

// Ключ живых уведомлений диалога. По нему форма подключает обработчик
// (УведомленияКлиента.ПодключитьОбработчик), а ФЗ отправляет пакеты.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Строка - ключ; "" для пустой ссылки.
Функция КлючЖивыхУведомлений(ИдДиалога) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "СИ_ЧатАгента." + Строка(ИдДиалога.УникальныйИдентификатор());
	
КонецФункции

// Номер родительского сеанса фонового задания, из которого можно определить
// адресата живых уведомлений. Вызывается ТОЛЬКО внутри ФЗ.
//
// Возвращаемое значение:
//  Число - номер родительского сеанса; 0 - вызов вне фонового задания.
Функция НомерРодительскогоСеансаФЗ() Экспорт
	
	Попытка
		ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Исключение
		Возврат 0;
	КонецПопытки;
	
	Если ФоновоеЗадание = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат ФоновоеЗадание.НомерРодительскогоСеанса;
	
КонецФункции

// Клиентски-сериализуемый элемент живого пакета из сообщения буфера.
// Все значения - примитивы (структуры/массивы без вложенных объектов 1С):
// через уведомления не переносятся значения, не доступные на клиенте.
//
// Параметры:
//  Сообщение - Структура - сообщение буфера (формат ядра, «Время» - Дата).
//  НомерСообщения - Число - номер сообщения в рамках захода.
//
// Возвращаемое значение:
//  Структура - элемент живого пакета сообщения: НомерСообщения (Число), Роль,
//   Контент, Время («ДЛФ=DT»), Рассуждения (для tool - имя инструмента),
//   Действие (для tool - человекочитаемый статус шага, иначе пусто),
//   УспехИсполнения, СсылкиДокументов (Массив - карта навигационных ссылок на
//   объекты 1С, пустой, если ссылок нет), плюс поля для спасения в регистр:
//   ИмяИнструмента, ИдВызоваИнструмента, ВызовыИнструментовJSON.
Функция ЖивойЭлементСообщения(Сообщение, НомерСообщения) Экспорт
	
	РольСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
	
	Элемент = Новый Структура;
	Элемент.Вставить("НомерСообщения", НомерСообщения);
	Элемент.Вставить("Роль", РольСообщения);
	Элемент.Вставить("Контент", СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Контент", ""));
	
	ВремяСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Время", "");
	Если ТипЗнч(ВремяСообщения) = Тип("Дата") Тогда
		ВремяСообщения = Формат(ВремяСообщения, "ДЛФ=DT");
	КонецЕсли;
	Элемент.Вставить("Время", ВремяСообщения);
	
	Если РольСообщения = "tool" Тогда
		Элемент.Вставить("Рассуждения", СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИмяИнструмента", ""));
	Иначе
		Элемент.Вставить("Рассуждения", СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Рассуждения", ""));
	КонецЕсли;

	Элемент.Вставить("Действие",
		?(РольСообщения = "tool", СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Действие", ""), ""));
	
	Элемент.Вставить("УспехИсполнения",
		?(РольСообщения = "tool",
			СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "УспехИсполнения", Истина) = Истина,
			Истина));
	
	Элемент.Вставить("ИмяИнструмента", СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИмяИнструмента", ""));
	Элемент.Вставить("ИдВызоваИнструмента", СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИдВызоваИнструмента", ""));
	Элемент.Вставить("ВызовыИнструментовJSON", СериализоватьВызовыИнструментов(Сообщение));

	СсылкиДокументовЖивые = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "СсылкиДокументов", Неопределено);
	Если ТипЗнч(СсылкиДокументовЖивые) = Тип("Массив") Тогда
		Элемент.Вставить("СсылкиДокументов", СсылкиДокументовЖивые);
	Иначе
		Элемент.Вставить("СсылкиДокументов", Новый Массив);
	КонецЕсли;

	ДиаграммыЖивые = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Диаграмма", Неопределено);
	Если ТипЗнч(ДиаграммыЖивые) = Тип("Массив") Тогда
		Элемент.Вставить("Диаграмма", ДиаграммыЖивые);
	ИначеЕсли ТипЗнч(ДиаграммыЖивые) = Тип("Структура") Тогда
		МассивКарточек = Новый Массив;
		МассивКарточек.Добавить(ДиаграммыЖивые);
		Элемент.Вставить("Диаграмма", МассивКарточек);
	Иначе
		Элемент.Вставить("Диаграмма", Новый Массив);
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

// Отправляет живой пакет сообщений захода в сеанс-инициатор фонового задания
// через УведомленияКлиента. Вызывается ТОЛЬКО из фонового задания: адресат
// определяется по НомерРодительскогоСеанса, вне ФЗ отправка пропускается
// (пустые Адресаты означали бы рассылку всем сеансам).
//
// Весь вызов best-effort: сбой доставки не влияет на заход агента (истина -
// в регистре, куда буфер пишется пакетно в конце захода).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  Сообщения - Массив из Структура - сообщения буфера (полный формат ядра).
//  НомерПервого - Число - номер, присваиваемый Сообщения[0]
//   (в рамках захода: Буфер.НачальныйНомер + индекс).
//  ТокеныЗаЗаход - Число - суммарный расход токенов текущего захода (живой прогресс).
//  ПромптТокеныПоследнейИтерации - Число - размер контекста последнего вызова
//   (показатель «История»).
Процедура ОтправитьЖивойПакет(ИдДиалога, Сообщения, НомерПервого,
	ТокеныЗаЗаход = 0, ПромптТокеныПоследнейИтерации = 0) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Или Сообщения = Неопределено
		Или Сообщения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		НомерСеанса = НомерРодительскогоСеансаФЗ();
		Если НомерСеанса = 0 Тогда
			Возврат;
		КонецЕсли;
		
		СообщенияПакета = Новый Массив;
		Номер = НомерПервого;
		Для Каждого Сообщение Из Сообщения Цикл
			СообщенияПакета.Добавить(ЖивойЭлементСообщения(Сообщение, Номер));
			Номер = Номер + 1;
		КонецЦикла;
		
		Пакет = Новый Структура;
		Пакет.Вставить("ИдДиалогаУИД", Строка(ИдДиалога.УникальныйИдентификатор()));
		Пакет.Вставить("Сообщения", СообщенияПакета);
		Пакет.Вставить("ТокеныЗаЗаход", ТокеныЗаЗаход);
		Пакет.Вставить("ПромптТокеныПоследнейИтерации", ПромптТокеныПоследнейИтерации);
		
		Адресаты = Новый Массив;
		Адресаты.Добавить(НомерСеанса);
		
		УведомленияКлиента.ОтправитьУведомление(КлючЖивыхУведомлений(ИдДиалога), Пакет, Адресаты);
	Исключение
		ЗаписатьВЖурнал("ОтправитьЖивойПакет", УровеньЖурналаРегистрации.Предупреждение,
			"Не удалось отправить живой пакет: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Записывает реквизиты диалога в управляемой транзакции. Исключительная блокировка
// элемента берётся ДО чтения объекта (ПолучитьОбъект), иначе она не защищает запись,
// а лишь детектирует уже совершённую: именно так возникала ошибка «несоответствие
// версии» при запросе разрешения инструмента, когда короткий заход фонового задания
// финализируется одновременно с записью ИД задания формой.
// Конфликт записи или блокировки - повтор с короткой паузой; исчерпание повторов -
// запись в журнал регистрации, исключение наружу не выбрасывается.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  Значения - Структура - изменяемые реквизиты: ключ - имя реквизита, значение -
//   новое значение. Поддерживаются АктивноеЗаданиеИд, Статус, ОшибкаЗавершения,
//   ИсторияТокенов, СводкаДиалога, Наименование, ЛимитТокенов, Режим, Модель,
//   ПрофильПодключения, СистемныйПромпт, СистемныйПромптСтрока. Специальные ключи:
//    * ПрибавитьТокенов - Число - прибавляется к ПотраченоТокенов (текущее значение
//      читается внутри блокировки, поэтому накопление не теряется);
//    * ЛимитТокеновЕслиНеЗаполнен - Число - записывается в ЛимитТокенов, только если
//      лимит ещё не заполнен (первый заход по диалогу);
//    * ПометкаУдаления - Булево - устанавливается через УстановитьПометкуУдаления.
//  Параметры - Структура, Неопределено - дополнительные правила:
//    * ИмяОперации - Строка - подсобытие журнала регистрации;
//    * ТребуемыйАктивноеЗаданиеИд - Строка - правило владения активным заходом:
//      запись выполняется, только если записанный ИД пуст, равен требуемому или
//      указывает на мёртвое задание (чужой живой заход не перезаписывается);
//    * ТребуетсяЖивоеЗадание - Булево - запись выполняется, только если записываемый
//      ИД указывает на живое задание (защита от фиксации завершившегося захода);
//    * ТолькоСвойАктивныйЗаход - Булево - при неудачной проверке владения записать
//      остальные реквизиты, не трогая АктивноеЗаданиеИд (вместо отказа от всей записи:
//      финализация ФЗ сохраняет токены и сводку всегда);
//    * НеПонижатьСтатус - Булево - не записывать Статус = Активен, если текущий
//      статус выставлен ядром (ОжидаетРазрешения) или заход уже завершён.
//
// Возвращаемое значение:
//  Булево - Истина, если запись выполнена или значения уже нужные; Ложь - если запись
//   не выполнена (не пройдено условие владения либо исчерпаны повторы).
Функция ЗаписатьРеквизитыДиалога(ИдДиалога, Значения, Параметры = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Или Значения = Неопределено
		Или ТипЗнч(Значения) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяОперации = "ЗаписатьРеквизитыДиалога";
	ТребуемыйАктивноеЗаданиеИд = Неопределено;
	ТребуетсяЖивоеЗадание = Ложь;
	НеПонижатьСтатус = Ложь;
	ТолькоСвойАктивныйЗаход = Ложь;
	Если Параметры <> Неопределено Тогда
		ИмяОперации = Строка(СИ_РаботаСJSON.БезопасноПолучить(Параметры, "ИмяОперации", ИмяОперации));
		ТребуемыйАктивноеЗаданиеИд = СИ_РаботаСJSON.БезопасноПолучить(Параметры,
			"ТребуемыйАктивноеЗаданиеИд", Неопределено);
		ТребуетсяЖивоеЗадание = СИ_РаботаСJSON.БезопасноПолучить(Параметры,
			"ТребуетсяЖивоеЗадание", Ложь) = Истина;
		НеПонижатьСтатус = СИ_РаботаСJSON.БезопасноПолучить(Параметры,
			"НеПонижатьСтатус", Ложь) = Истина;
		ТолькоСвойАктивныйЗаход = СИ_РаботаСJSON.БезопасноПолучить(Параметры,
			"ТолькоСвойАктивныйЗаход", Ложь) = Истина;
	КонецЕсли;

	МаксПопыток = 4;
	ПоследняяОшибка = "";
	Для НомерПопытки = 1 По МаксПопыток Цикл

		НачатьТранзакцию();
		Попытка
			ИсключительнаяБлокировкаДиалога(ИдДиалога);
			
			ОбъектДиалога = ИдДиалога.ПолучитьОбъект();
			Если ОбъектДиалога = Неопределено Тогда
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
			
			ЗаписываемыйИдЗадания = "";
			Если Значения.Свойство("АктивноеЗаданиеИд") Тогда
				ЗаписываемыйИдЗадания = Строка(Значения.АктивноеЗаданиеИд);
			КонецЕсли;
			
			УсловиеВладенияПройдено = Истина;
			Если ТребуемыйАктивноеЗаданиеИд <> Неопределено Тогда
				УсловиеВладенияПройдено = АктивноеЗаданиеИдДопустимДляЗаписи(ОбъектДиалога.АктивноеЗаданиеИд,
					Строка(ТребуемыйАктивноеЗаданиеИд));
			КонецЕсли;
			
			ЗаходЖив = Истина;
			Если ТребуетсяЖивоеЗадание И НЕ ПустаяСтрока(ЗаписываемыйИдЗадания) Тогда
				ЗаходЖив = ЖивоЛиЗадание(ЗаписываемыйИдЗадания);
			КонецЕсли;
			
			ЗначенияДляЗаписи = Значения;
			Если НЕ УсловиеВладенияПройдено ИЛИ НЕ ЗаходЖив Тогда
				Если ТолькоСвойАктивныйЗаход И Значения.Свойство("АктивноеЗаданиеИд") Тогда
					ЗначенияДляЗаписи = СкопироватьБезКлюча(Значения, "АктивноеЗаданиеИд");
					ЗаписатьВЖурнал(ИмяОперации, УровеньЖурналаРегистрации.Предупреждение,
						"ИД активного захода не изменён: в диалоге заход «"
						+ Строка(ОбъектДиалога.АктивноеЗаданиеИд) + "», ожидался «"
						+ Строка(ТребуемыйАктивноеЗаданиеИд) + "»");
				Иначе
					ОтменитьТранзакцию();
					ЗаписатьВЖурнал(ИмяОперации, УровеньЖурналаРегистрации.Предупреждение,
						"Запись пропущена: в диалоге активный заход «"
						+ Строка(ОбъектДиалога.АктивноеЗаданиеИд) + "», ожидался «"
						+ Строка(ТребуемыйАктивноеЗаданиеИд) + "»");
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначенияДляЗаписи.Количество() = 0 Тогда
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
			Если ЗначенияДляЗаписи.Количество() = 1 И ЗначенияДляЗаписи.Свойство("АктивноеЗаданиеИд")
				И Строка(ОбъектДиалога.АктивноеЗаданиеИд) = Строка(ЗначенияДляЗаписи.АктивноеЗаданиеИд) Тогда
				ОтменитьТранзакцию();
				Возврат Истина;
			КонецЕсли;
			
			ПрименитьЗначенияРеквизитов(ОбъектДиалога, ЗначенияДляЗаписи, НеПонижатьСтатус);
			ОбъектДиалога.Записать();
			ЗафиксироватьТранзакцию();
			Возврат Истина;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
		КонецПопытки;
		
		Если НомерПопытки < МаксПопыток Тогда
			ВыдержатьПаузуМс(50 * НомерПопытки);
		КонецЕсли;
		
	КонецЦикла;

	ЗаписатьВЖурнал(ИмяОперации, УровеньЖурналаРегистрации.Ошибка,
		"Не удалось записать реквизиты диалога за " + Строка(МаксПопыток)
		+ " попыток: " + ПоследняяОшибка);
	Возврат Ложь;

КонецФункции

// Записывает ИД активного фонового задания в реквизит диалога АктивноеЗаданиеИд.
// Вызывается формой после успешного запуска ФЗ; реквизит читается при перезахвате
// живого захода и для защиты от второго запуска по тому же диалогу.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  ИдЗадания - Строка - уникальный идентификатор фонового задания.
Процедура УстановитьАктивноеЗадание(ИдДиалога, ИдЗадания) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Или ПустаяСтрока(ИдЗадания) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьАктивноеЗаданиеСБлокировкой(ИдДиалога, ИдЗадания);

КонецПроцедуры

// Записывает ИД активного фонового задания и статус диалога после запуска захода
// (в том числе после возобновления из карточки запроса разрешения). Запись идёт
// через ядро записи реквизитов диалога: блокировка данных ДО чтения объекта плюс
// правило владения. Запись пропускается, если в диалоге другой живой заход, а также
// если наш заход уже завершился: короткий заход с запросом разрешения успевает
// финализироваться раньше, чем форма допишет ИД задания.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  ИдЗадания - Строка - уникальный идентификатор фонового задания.
//  Статус    - ПеречислениеСсылка.СИ_СтатусыДиалога - устанавливаемый статус.
Процедура ЗаписатьАктивноеЗаданиеИСтатус(ИдДиалога, Знач ИдЗадания, Знач Статус) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Или ПустаяСтрока(ИдЗадания) Тогда
		Возврат;
	КонецЕсли;

	Значения = Новый Структура;
	Значения.Вставить("АктивноеЗаданиеИд", ИдЗадания);
	Значения.Вставить("Статус", Статус);

	Параметры = Новый Структура;
	Параметры.Вставить("ИмяОперации", "ЗаписатьАктивноеЗаданиеИСтатус");
	Параметры.Вставить("ТребуемыйАктивноеЗаданиеИд", ИдЗадания);
	Параметры.Вставить("ТребуетсяЖивоеЗадание", Истина);
	Параметры.Вставить("НеПонижатьСтатус", Истина);

	ЗаписатьРеквизитыДиалога(ИдДиалога, Значения, Параметры);

КонецПроцедуры

// Очищает реквизит диалога АктивноеЗаданиеИд (идемпотентно). Вызывается во всех
// ветках финализации захода (штатной, прерывании, аварии). Первичная очистка
// выполняется самим ядром в финальной записи диалога (СИ_Агент1С) - здесь страховая
// очистка из формы. Чужой живой заход не сбрасывается: поздняя финализация старого
// захода не должна стирать ИД захода, возобновлённого из карточки запроса разрешения.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  ОжидаемыйИдЗадания - Строка, Неопределено - ИД завершаемого захода, если
//   финализация знает его: очистка выполняется только для этого ИД. Не задан -
//   очищаются только пустой и мёртвый ИД.
Процедура ОчиститьАктивноеЗадание(ИдДиалога, Знач ОжидаемыйИдЗадания = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьАктивноеЗаданиеСБлокировкой(ИдДиалога, "",
		?(ОжидаемыйИдЗадания = Неопределено, "", ОжидаемыйИдЗадания));

КонецПроцедуры

// Записывает реквизит АктивноеЗаданиеИд диалога через ядро записи реквизитов:
// исключительная блокировка данных ДО чтения объекта и правило владения
// (см. АктивноеЗаданиеИдДопустимДляЗаписи). Запись пропускается, если значение уже
// нужное (идемпотентность) или если записан чужой живой заход.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  Значение - Строка - устанавливаемый ИД задания; "" - очистить.
//  ТребуемыйИдЗадания - Строка, Неопределено - ИД, которым оперирует вызывающий
//   код (при очистке - ожидаемый записанный ИД). Не задан - берётся Значение.
Процедура ЗаписатьАктивноеЗаданиеСБлокировкой(ИдДиалога, Значение, Знач ТребуемыйИдЗадания = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат;
	КонецЕсли;

	Если ТребуемыйИдЗадания = Неопределено Тогда
		ТребуемыйИдЗадания = Значение;
	КонецЕсли;

	Значения = Новый Структура;
	Значения.Вставить("АктивноеЗаданиеИд", Строка(Значение));

	Параметры = Новый Структура;
	Параметры.Вставить("ИмяОперации", "ЗаписатьАктивноеЗаданиеСБлокировкой");
	Параметры.Вставить("ТребуемыйАктивноеЗаданиеИд", Строка(ТребуемыйИдЗадания));
	Параметры.Вставить("ТребуетсяЖивоеЗадание", НЕ ПустаяСтрока(Строка(Значение)));

	ЗаписатьРеквизитыДиалога(ИдДиалога, Значения, Параметры);

КонецПроцедуры

// Живо ли фоновое задание по его уникальному идентификатору.
//
// Параметры:
//  ИдЗадания - Строка - уникальный идентификатор фонового задания.
//
// Возвращаемое значение:
//  Булево - Истина, если задание найдено в очереди и активно.
Функция ЖивоЛиЗадание(ИдЗадания) Экспорт
	
	Если ПустаяСтрока(ИдЗадания) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ФЗОбъект = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
			Новый УникальныйИдентификатор(ИдЗадания));
		Если ФЗОбъект = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат ФЗОбъект.Состояние = СостояниеФоновогоЗадания.Активно;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// ИД живого фонового задания диалога (реквизит АктивноеЗаданиеИд).
// Мёртвое задание (авария сеанса, завершение без очистки реквизита) лениво
// удаляется из реквизита.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Строка - идентификатор живого задания; "" - активного запуска нет.
Функция ИдАктивногоЗадания(ИдДиалога) Экспорт

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдДиалога, "АктивноеЗаданиеИд");
		ИдЗадания = Строка(ЗначенияРеквизитов.АктивноеЗаданиеИд);
		Если ПустаяСтрока(ИдЗадания) Тогда
			Возврат "";
		КонецЕсли;
		Если ЖивоЛиЗадание(ИдЗадания) Тогда
			Возврат ИдЗадания;
		КонецЕсли;
		ЗаписатьАктивноеЗаданиеСБлокировкой(ИдДиалога, "", ИдЗадания);
		Возврат "";
	Исключение
		ЗаписатьВЖурнал("ИдАктивногоЗадания", УровеньЖурналаРегистрации.Предупреждение,
			"Ошибка проверки активного задания: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

КонецФункции

// Активен ли запуск по диалогу (для защиты от второго запуска).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Булево - Истина, если по диалогу есть живое фоновое задание.
Функция ЕстьАктивныйЗапуск(ИдДиалога) Экспорт
	Возврат НЕ ПустаяСтрока(ИдАктивногоЗадания(ИдДиалога));
КонецФункции

// Снимает зависшие активные заходы: у диалогов со статусом «Активен»
// очищает АктивноеЗаданиеИд, указывающее на мёртвое задание, и переводит
// статус в «Завершён». Вызывается регламентным обслуживанием
// (СИ_ОбслуживаниеАгента.ВыполнитьОбслуживание); живые заходы не трогаются.
//
// Возвращаемое значение:
//  Число - количество снятых заходов.
Функция СнятьЗависшиеЗаходы() Экспорт

	Снято = 0;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Диалоги.Ссылка КАК Диалог,
			|	Диалоги.АктивноеЗаданиеИд КАК АктивноеЗаданиеИд
			|ИЗ
			|	Справочник.СИ_ДиалогиАгента КАК Диалоги
			|ГДЕ
			|	Диалоги.АктивноеЗаданиеИд <> """"
			|	И Диалоги.Статус = &СтатусАктивен";
		Запрос.УстановитьПараметр("СтатусАктивен", Перечисления.СИ_СтатусыДиалога.Активен);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИдЗадания = Строка(Выборка.АктивноеЗаданиеИд);
			Если ЖивоЛиЗадание(ИдЗадания) Тогда
				Продолжить;
			КонецЕсли;
			Значения = Новый Структура;
			Значения.Вставить("АктивноеЗаданиеИд", "");
			Значения.Вставить("Статус", Перечисления.СИ_СтатусыДиалога.Завершён);
			ПараметрыЗаписи = Новый Структура;
			ПараметрыЗаписи.Вставить("ИмяОперации", "СнятьЗависшиеЗаходы");
			ПараметрыЗаписи.Вставить("ТребуемыйАктивноеЗаданиеИд", ИдЗадания);
			Если ЗаписатьРеквизитыДиалога(Выборка.Диалог, Значения, ПараметрыЗаписи) Тогда
				Снято = Снято + 1;
				ЗаписатьВЖурнал("СнятьЗависшиеЗаходы", УровеньЖурналаРегистрации.Информация,
					"Снят зависший заход диалога (мёртвое задание " + ИдЗадания + ")");
			КонецЕсли;
		КонецЦикла;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ЗаписатьВЖурнал("СнятьЗависшиеЗаходы", УровеньЖурналаРегистрации.Предупреждение,
			"Ошибка снятия зависших заходов: " + ОписаниеОшибки());
		Возврат Снято;
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Снято;

КонецФункции

// Спасает накопленные живые сообщения захода в регистр. Вызывается формой
// при аварийном завершении ФЗ: сообщения, доставленные форме живыми
// уведомлениями (клиентский буфер), дописываются в регистр по их номерам.
// Сообщения с номерами, уже присутствующими в регистре (ядро успело сбросить
// буфер перед краем), пропускаются - защита от дублирования.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  Сообщения - Массив из Структура - элементы живого пакета (см. ЖивойЭлементСообщения),
//   каждое с ключом НомерСообщения.
Процедура СпастиЖивыеСообщения(ИдДиалога, Сообщения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Или Сообщения = Неопределено
		Или ТипЗнч(Сообщения) <> Тип("Массив") Или Сообщения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		МаксимальныйНомерВРегистре = ПолучитьМаксимальныйНомерСообщения(ИдДиалога);
		
		НачальныйНомер = Неопределено;
		СообщенияБуфера = Новый Массив;
		Для Каждого Сообщение Из Сообщения Цикл
			Номер = Число(СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "НомерСообщения", 0));
			Если Номер <= МаксимальныйНомерВРегистре Тогда
				Продолжить;
			КонецЕсли;
			СтруктураСообщения = Новый Структура;
			Для Каждого КлючИЗначение Из Сообщение Цикл
				Если КлючИЗначение.Ключ <> "НомерСообщения" Тогда
					СтруктураСообщения.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
				КонецЕсли;
			КонецЦикла;
			СообщенияБуфера.Добавить(СтруктураСообщения);
			Если НачальныйНомер = Неопределено ИЛИ Номер < НачальныйНомер Тогда
				НачальныйНомер = Номер;
			КонецЕсли;
		КонецЦикла;
		
		Если СообщенияБуфера.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Буфер = Новый Структура;
		Буфер.Вставить("ИдДиалога", ИдДиалога);
		Буфер.Вставить("Сообщения", СообщенияБуфера);
		Буфер.Вставить("НачальныйНомер", НачальныйНомер);
		Буфер.Вставить("СледующийНомер", НачальныйНомер + СообщенияБуфера.Количество());
		
		СброситьБуферСообщений(Буфер);
	Исключение
		ЗаписатьВЖурнал("СпастиЖивыеСообщения", УровеньЖурналаРегистрации.Предупреждение,
			"Не удалось спасти живые сообщения: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Получение истории сообщений диалога в формате массива сообщений OpenAI.
// ЛимитСообщений применяется к ПОСЛЕДНИМ сообщениям диалога (по номеру).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  Параметры - Структура,Неопределено - параметры выборки:
//    * ЛимитСообщений - Число,Неопределено - максимум сообщений (последние N по номеру).
//    * НачинаяСНомера - Число,Неопределено - догрузка только сообщений с номером > N.
//    * ДоНомераВключительно - Число,Неопределено - верхняя граница номера
//      (только сообщения с номером <= N); используется вместе с ЛимитСообщений
//      для пагинации «хвоста» диалога (порция последних перед границей).
//    * ТолькоВПамяти - Булево - признак чтения из буфера/БД.
//
// Возвращаемое значение:
//  Массив Из Структура - сообщения в формате OpenAI.
Функция ПолучитьИсторию(ИдДиалога, Параметры) Экспорт
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Лимит = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "ЛимитСообщений", Неопределено);
		НачинаяСНомера = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "НачинаяСНомера", Неопределено);
		ДоНомераВключительно = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "ДоНомераВключительно", Неопределено);
		
		ЗначениеЛимита = ?(Лимит = Неопределено ИЛИ Лимит <= 0, 1000000, Лимит);
		СтрокаЛимита = Формат(ЗначениеЛимита, "ЧДЦ=0; ЧГ=0");
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.НомерСообщения,
		|	ВложенныйЗапрос.Роль,
		|	ВложенныйЗапрос.Контент,
		|	ВложенныйЗапрос.ВызовыИнструментовJSON,
		|	ВложенныйЗапрос.ИдВызоваИнструмента,
		|	ВложенныйЗапрос.ИмяИнструмента,
		|	ВложенныйЗапрос.Рассуждения,
		|	ВложенныйЗапрос.МетаданныеСообщения,
		|	ВложенныйЗапрос.ДатаЗаписи
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ " + СтрокаЛимита + "
		|		СообщенияДиалога.НомерСообщения,
		|		СообщенияДиалога.Роль,
		|		СообщенияДиалога.Контент,
		|		СообщенияДиалога.ВызовыИнструментовJSON,
		|		СообщенияДиалога.ИдВызоваИнструмента,
		|		СообщенияДиалога.ИмяИнструмента,
		|		СообщенияДиалога.Рассуждения,
		|		СообщенияДиалога.МетаданныеСообщения,
		|		СообщенияДиалога.ДатаЗаписи
		|	ИЗ
		|		РегистрСведений.СИ_СообщенияДиалога КАК СообщенияДиалога
		|	ГДЕ
		|		СообщенияДиалога.ИдДиалога = &ИдДиалога";
		
		Если НачинаяСНомера <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "
			|		И СообщенияДиалога.НомерСообщения > &НачинаяСНомера";
			Запрос.УстановитьПараметр("НачинаяСНомера", НачинаяСНомера);
		КонецЕсли;

		Если ДоНомераВключительно <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "
			|		И СообщенияДиалога.НомерСообщения <= &ДоНомераВключительно";
			Запрос.УстановитьПараметр("ДоНомераВключительно", ДоНомераВключительно);
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "
		|	УПОРЯДОЧИТЬ ПО
		|		СообщенияДиалога.НомерСообщения УБЫВ)
		|		КАК ВложенныйЗапрос
		|УПОРЯДОЧИТЬ ПО
		|	ВложенныйЗапрос.НомерСообщения ВОЗР";
		
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Попытка
				СообщениеФормат = СформироватьСообщениеИзЗаписи(Выборка);
				Результат.Добавить(СообщениеФормат);
			Исключение
				ЗаписатьВЖурнал("ПолучитьИсторию", УровеньЖурналаРегистрации.Предупреждение,
					"Пропущено сообщение №" + Строка(Выборка.НомерСообщения) + ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
		
	Исключение
		ЗаписатьВЖурнал("ПолучитьИсторию", УровеньЖурналаРегистрации.Ошибка, "Ошибка получения истории: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;
КонецФункции
// Карты навигационных ссылок всех сообщений диалога из регистра - одним
// запросом на диалог. Нужна форме чата: при перерисовке истории карты читаются
// не по одной на строку (запрос на строку), а одной выборкой на диалог.
// Регистр - источник истины: буфер ядра пишется в него до финализации хода.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - карты по номерам сообщений:
//   * Ключ - Число - номер сообщения в рамках захода;
//   * Значение - Массив из Структура - карта ссылок (Упоминание, Адрес).
//  Сообщения без карты в соответствие не попадают.
Функция ПолучитьСсылкиДокументовПоНомерам(Знач ИдДиалога) Экспорт

	Результат = Новый Соответствие;

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СообщенияДиалога.НомерСообщения КАК НомерСообщения,
			|	СообщенияДиалога.МетаданныеСообщения КАК МетаданныеСообщения
			|ИЗ
			|	РегистрСведений.СИ_СообщенияДиалога КАК СообщенияДиалога
			|ГДЕ
			|	СообщенияДиалога.ИдДиалога = &ИдДиалога";
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Карта = СсылкиДокументовИзМетаданных(Выборка.МетаданныеСообщения);
			Если Карта <> Неопределено Тогда
				Результат.Вставить(Выборка.НомерСообщения, Карта);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписатьВЖурнал("ПолучитьСсылкиДокументовПоНомерам", УровеньЖурналаРегистрации.Ошибка,
			"Ошибка чтения карт ссылок диалога: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Карточки диаграмм всех сообщений диалога из регистра - одним запросом на
// диалог (по образцу ПолучитьСсылкиДокументовПоНомерам). Нужна форме чата:
// при перерисовке истории карточки читаются одной выборкой, а не запросом на
// строку.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - карточки по номерам сообщений:
//   * Ключ - Число - номер сообщения;
//   * Значение - Массив из Структура - карточки (SVG, Заголовок, Подпись,
//     УИДФайла, ИмяФайла).
//  Сообщения без карточек в соответствие не попадают.
Функция ПолучитьДиаграммыПоНомерам(Знач ИдДиалога) Экспорт

	Результат = Новый Соответствие;

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СообщенияДиалога.НомерСообщения КАК НомерСообщения,
			|	СообщенияДиалога.МетаданныеСообщения КАК МетаданныеСообщения
			|ИЗ
			|	РегистрСведений.СИ_СообщенияДиалога КАК СообщенияДиалога
			|ГДЕ
			|	СообщенияДиалога.ИдДиалога = &ИдДиалога";
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Диаграммы = ДиаграммыИзМетаданных(Выборка.МетаданныеСообщения);
			Если Диаграммы <> Неопределено Тогда
				Результат.Вставить(Выборка.НомерСообщения, Диаграммы);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписатьВЖурнал("ПолучитьДиаграммыПоНомерам", УровеньЖурналаРегистрации.Ошибка,
			"Ошибка чтения карточек диаграмм диалога: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает количество записей истории диалога (без чтения самих сообщений).
// Используется формой чата для подписи «Показаны последние N из M» при пагинации
// «хвоста» и для определения, есть ли более старые сообщения за порцией.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог;
//  Роли - Массив,Неопределено - значения Перечисления.СИ_РолиСообщений, которые
//     нужно посчитать. Неопределено (по умолчанию) - считаются ВСЕ записи
//     регистра, включая служебные (system- промпты, вызовы инструментов):
//     так считается «размер диалога» в записях. Форма чата передаёт роли user и
//     assistant, чтобы в подписи «Показаны последние N из M» не участвовали
//     служебные записи, которых пользователь на экране не видит.
//
// Возвращаемое значение:
//  Число - количество записей в регистре СИ_СообщенияДиалога для диалога.
Функция КоличествоСообщенийВДиалоге(ИдДиалога, Роли = Неопределено) Экспорт

	Результат = 0;

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
		|ИЗ
		|	РегистрСведений.СИ_СообщенияДиалога КАК СообщенияДиалога
		|ГДЕ
		|	СообщенияДиалога.ИдДиалога = &ИдДиалога";
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);

		Если Роли <> Неопределено И Роли.Количество() > 0 Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И СообщенияДиалога.Роль В (&Роли)";
			Запрос.УстановитьПараметр("Роли", Роли);
		КонецЕсли;

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.КоличествоЗаписей;
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("КоличествоСообщенийВДиалоге", УровеньЖурналаРегистрации.Ошибка,
			"Ошибка подсчёта количества сообщений: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Текст и время последнего сообщения пользователя с номером НЕ БОЛЬШЕ
// указанного. Нужны форме чата при пагинации «хвоста»: первая видимая
// реплика бывает ответом ассистента, а его вопрос остался за границей
// показа - без него непонятно, на что этот ответ. Форма рисует вопрос
// обычным пузырём пользователя, поэтому время нужно для шапки пузыря.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог;
//  ДоНомераВключительно - Число - верхняя граница номера сообщения.
//
// Возвращаемое значение:
//  Структура - Текст (Строка) и Время (Строка, формат ДЛФ=DT - как в истории);
//              оба пустые, если вопроса не нашлось.
Функция ПолучитьПоследнийВопросПользователя(ИдДиалога, ДоНомераВключительно) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Текст", "");
	Результат.Вставить("Время", "");

	Если НЕ ЗначениеЗаполнено(ИдДиалога) ИЛИ ДоНомераВключительно = Неопределено
		ИЛИ ДоНомераВключительно <= 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщенияДиалога.Контент,
		|	СообщенияДиалога.ДатаЗаписи
		|ИЗ
		|	РегистрСведений.СИ_СообщенияДиалога КАК СообщенияДиалога
		|ГДЕ
		|	СообщенияДиалога.ИдДиалога = &ИдДиалога
		|	И СообщенияДиалога.НомерСообщения <= &ДоНомераВключительно
		|	И СообщенияДиалога.Роль = &Роль
		|УПОРЯДОЧИТЬ ПО
		|	СообщенияДиалога.НомерСообщения УБЫВ";
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);
		Запрос.УстановитьПараметр("ДоНомераВключительно", ДоНомераВключительно);
		Запрос.УстановитьПараметр("Роль", Перечисления.СИ_РолиСообщений.User);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Текст = Строка(Выборка.Контент);
			Если ЗначениеЗаполнено(Выборка.ДатаЗаписи) Тогда
				Результат.Время = Формат(Выборка.ДатаЗаписи, "ДЛФ=DT");
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("ПолучитьПоследнийВопросПользователя", УровеньЖурналаРегистрации.Предупреждение,
			"Не удалось прочитать последний вопрос пользователя: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Обрезка истории сообщений под лимит токенов с сохранением системного сообщения.
//
// Параметры:
//  История - Массив из Структура - исходная история сообщений.
//  ЛимитТокенов - Число - максимально допустимое число токенов.
//
// Возвращаемое значение:
//  Массив Из Структура - обрезанная история.
//
// Примечание: если системное сообщение само превышает лимит, возвращается
// только оно (без него диалог невалиден для OpenAI API) итоговый размер
// в этом случае превышает заявленный лимит; в журнал пишется предупреждение.
Функция ОбрезатьИсториюПоТокенам(История, ЛимитТокенов) Экспорт
	Если История = Неопределено ИЛИ История.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Если ЛимитТокенов <= 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	СистемноеСообщение = Неопределено;
	ИндексСистемного = -1;
	
	Для Инд = 0 По История.Количество() - 1 Цикл
		Роль = ПолучитьРольСообщения(История[Инд]);
		Если Роль = "system" Тогда
			СистемноеСообщение = История[Инд];
			ИндексСистемного = Инд;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ТокеныСистемы = 0;
	Если СистемноеСообщение <> Неопределено Тогда
		СистемныйКонтент = ПолучитьКонтентСообщения(СистемноеСообщение);
		ТокеныСистемы = ОценитьКоличествоТокенов(СистемныйКонтент);
	КонецЕсли;
	
	ДоступноТокенов = ЛимитТокенов - ТокеныСистемы;
	
	Если ДоступноТокенов <= 0 Тогда
		Если СистемноеСообщение <> Неопределено Тогда
			ЗаписатьВЖурнал("ОбрезатьИсториюПоТокенам", УровеньЖурналаРегистрации.Предупреждение,
				"Системное сообщение превышает лимит токенов: " + Строка(ТокеныСистемы)
					+ " > " + Строка(ЛимитТокенов) + ". Возвращено только системное сообщение.");
			Результат = Новый Массив;
			Результат.Добавить(СистемноеСообщение);
			Возврат Результат;
		КонецЕсли;
		Возврат Новый Массив;
	КонецЕсли;
	
	ОбратныйРезультат = Новый Массив;
	ТекущиеТокены = 0;
	
	КоличествоСообщений = История.Количество();
	Инд = КоличествоСообщений - 1;
	Пока Инд >= 0 Цикл
		Если Инд = ИндексСистемного Тогда
			Инд = Инд - 1;
			Продолжить;
		КонецЕсли;
		
		Сообщение = История.Получить(Инд);
		Если Сообщение = Неопределено Тогда
			Инд = Инд - 1;
			Продолжить;
		КонецЕсли;
		
		КонтентСообщения = ПолучитьКонтентСообщения(Сообщение);
		ТокеныСообщения = ОценитьКоличествоТокенов(КонтентСообщения);
		Вызовы = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ВызовыИнструментов", Неопределено);
		Если Вызовы <> Неопределено И ТипЗнч(Вызовы) = Тип("Массив") Тогда
			ТокеныСообщения = ТокеныСообщения + Вызовы.Количество() * 20;
		КонецЕсли;
		
		Если ТекущиеТокены + ТокеныСообщения <= ДоступноТокенов Тогда
			ОбратныйРезультат.Добавить(Сообщение);
			ТекущиеТокены = ТекущиеТокены + ТокеныСообщения;
		Иначе
			Прервать;
		КонецЕсли;
		
		Инд = Инд - 1;
	КонецЦикла;
	
	Результат = Новый Массив;
	ИндРезультата = ОбратныйРезультат.ВГраница();
	Пока ИндРезультата >= 0 Цикл
		Результат.Добавить(ОбратныйРезультат[ИндРезультата]);
		ИндРезультата = ИндРезультата - 1;
	КонецЦикла;
	
	Если СистемноеСообщение <> Неопределено Тогда
		Результат.Вставить(0, СистемноеСообщение);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// ======================== Сжатие истории (оркестратор) ========================
//
// Каскадное сжатие истории диалога под лимит токенов:
//   Уровень 1 (бесплатно, без модели) → проверка лимита → Уровень 2 (сводка моделью).
// Возвращает структуру с обрезанной историей и признаком применённого сжатия.
//
// Параметры:
//  История - Массив из Структура - исходная история сообщений в формате OpenAI.
//  ЛимитТокенов - Число - максимально допустимое число токенов входа.
//  Параметры - Структура,Неопределено - параметры сжатия:
//    * Модель - Строка - модель для суммаризации (Уровень 2).
//    * Профиль - СправочникСсылка.СИ_ПрофилиПодключений - профиль подключения.
//    * ИспользоватьСводку - Булево - разрешить вызов модели для сводки (по умолчанию Ложь).
//    * МаксТокеновСводки - Число - бюджет сводки в токенах (по умолчанию 1500).
//    * КоличествоСвежих - Число - сколько последних сообщений не сжимать (по умолчанию 10).
//    * МаксДлинаToolРезультата - Число - лимит tool-результата в символах (по умолчанию 4000).
//    * МаксДлинаСообщения - Число - лимит длины отдельного сообщения в символах (по умолчанию 4000).
//    * СхлопыватьToolПары - Булево - разрешить схлопывание старых tool-пар (по умолчанию Истина).
//      Ложь - безопасный режим для использования ВНУТРИ агентского цикла: не трогает
//      assistant-сообщения с tool_calls и парные tool-сообщения (защита от invalid tool_call_id).
//    * Принудительно - Булево - принудительное сжатие (по умолчанию Ложь): игнорирует проверку
//      «история уже в пределах лимита» и всегда выполняет Уровень 1 + сводку моделью (Уровень 2).
//      Используется кнопкой «Сжать» формы чата для ручного сжатия при любом размере истории.
//
// Возвращаемое значение:
//  Структура:
//    * Сообщения - Массив из Структура - итоговая история.
//    * ПримененоСжатие - Булево - Истина, если история была изменена.
//    * ИспользованаСводка - Булево - Истина, если применялся Уровень 2.
//    * БылоСообщений - Число - исходное количество сообщений.
//    * СталоСообщений - Число - итоговое количество сообщений.
//    * Сводка - Строка - текст сводки (если использована).
//    * НечегоСжимать - Булево - Истина в принудительном режиме, если история не уменьшена
//      и недоступна сводка (мало сообщений / нет модели): сжимать фактически нечего.
Функция СжатьИсторию(История, ЛимитТокенов, Параметры = Неопределено) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Сообщения", История);
	Результат.Вставить("ПримененоСжатие", Ложь);
	Результат.Вставить("ИспользованаСводка", Ложь);
	Результат.Вставить("БылоСообщений", ?(История = Неопределено, 0, История.Количество()));
	Результат.Вставить("СталоСообщений", Результат.БылоСообщений);
	Результат.Вставить("Сводка", "");
	Результат.Вставить("НечегоСжимать", Ложь);
	
	Если История = Неопределено ИЛИ История.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЛимитТокенов <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ИспользоватьСводку = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "ИспользоватьСводку", Ложь);
		МаксТокеновСводки = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "МаксТокеновСводки", 1500);
		КоличествоСвежих = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "КоличествоСвежих", 10);
		МаксДлинаToolРезультата = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "МаксДлинаToolРезультата", 4000);
		МаксДлинаСообщения = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "МаксДлинаСообщения", 4000);
		МодельСводки = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Модель", "");
		ПрофильСводки = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Профиль", Неопределено);
		СхлопыватьToolПары = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "СхлопыватьToolПары", Истина);
		Принудительно = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Принудительно", Ложь);
		
		ОценкаТокенов = ОценитьТокеныИстории(История);
		Если НЕ Принудительно И ОценкаТокенов <= ЛимитТокенов Тогда
			Возврат Результат;
		КонецЕсли;
		
		СжатаяИстория = Новый Массив;
		Для Каждого СообщениеИстории Из История Цикл
			СжатаяИстория.Добавить(СообщениеИстории);
		КонецЦикла;
		СжатаяИстория = УбратьРассужденияСтарыхСообщений(СжатаяИстория, КоличествоСвежих);
		СжатаяИстория = ОграничитьРезультатыИнструментов(СжатаяИстория, МаксДлинаToolРезультата);
		СжатаяИстория = ОбрезатьДлинныеСообщения(СжатаяИстория, МаксДлинаСообщения);
		Если СхлопыватьToolПары Тогда
			СжатаяИстория = СхлопнутьСтарыеToolПары(СжатаяИстория, КоличествоСвежих + 2);
		КонецЕсли;
		
		ОценкаПослеУровня1 = ОценитьТокеныИстории(СжатаяИстория);
		Если НЕ Принудительно И ОценкаПослеУровня1 <= ЛимитТокенов Тогда
			Результат.Сообщения = СжатаяИстория;
			Результат.ПримененоСжатие = Истина;
			Результат.СталоСообщений = СжатаяИстория.Количество();
			Возврат Результат;
		КонецЕсли;
		
		Если ИспользоватьСводку И НЕ ПустаяСтрока(МодельСводки) Тогда
			ТекстСформированнойСводки = "";
			СводкаИстория = СформироватьСводкуИстории(
				СжатаяИстория, ЛимитТокенов, МаксТокеновСводки, МодельСводки, ПрофильСводки,
				ТекстСформированнойСводки, КоличествоСвежих);
			
			Если СводкаИстория <> Неопределено Тогда
				ОценкаПослеСводки = ОценитьТокеныИстории(СводкаИстория);
				Если ОценкаПослеСводки <= ЛимитТокенов ИЛИ Принудительно Тогда
					Результат.Сообщения = СводкаИстория;
					Результат.ПримененоСжатие = Истина;
					Результат.ИспользованаСводка = Истина;
					Результат.СталоСообщений = СводкаИстория.Количество();
					Результат.Сводка = ТекстСформированнойСводки;
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Принудительно И ОценкаПослеУровня1 <= ЛимитТокенов Тогда
			ОценкаСодержимогоБыло = ОценитьТокеныИстории(История, Ложь);
			ОценкаСодержимогоСтало = ОценитьТокеныИстории(СжатаяИстория, Ложь);
			Уровень1УменьшилИсторию = (СжатаяИстория.Количество() < Результат.БылоСообщений)
				ИЛИ (ОценкаСодержимогоСтало < ОценкаСодержимогоБыло);
			Если Уровень1УменьшилИсторию Тогда
				Результат.Сообщения = СжатаяИстория;
				Результат.ПримененоСжатие = Истина;
				Результат.СталоСообщений = СжатаяИстория.Количество();
			Иначе
				Результат.НечегоСжимать = Истина;
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;

		Результат.Сообщения = ОбрезатьИсториюПоТокенам(СжатаяИстория, ЛимитТокенов);
		Результат.ПримененоСжатие = Истина;
		Результат.СталоСообщений = Результат.Сообщения.Количество();
		
	Исключение
		ЗаписатьВЖурнал("СжатьИсторию", УровеньЖурналаРегистрации.Ошибка, "Ошибка сжатия истории: " + ОписаниеОшибки());
		Результат.Сообщения = История;
		Результат.ПримененоСжатие = Ложь;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Оценивает суммарное количество токенов во всей истории сообщений.
// Учитываются: текст сообщения (Контент), рассуждения ассистента (Рассуждения),
// фактические аргументы tool_calls и (опционально) фиксированные накладные расходы
// на сообщение и вызов инструмента.
// Оценка намеренно консервативна (не занижает реальный размер контекста), чтобы
// порог автосжатия и индикатор «История» не расходились с фактическим потреблением.
//
// Параметры:
//  История - Массив из Структура,Неопределено - история сообщений.
//  УчитыватьНакладныеРасходы - Булево - Истина (по умолчанию): прибавлять константы
//    обвязки (за сообщение и за tool_call). Ложь - только содержательная оценка
//    (текст, рассуждения, аргументы вызовов) для корректного сравнения «до/после» сжатия.
//
// Возвращаемое значение:
//  Число - приблизительная оценка количества токенов во всей истории.
Функция ОценитьТокеныИстории(История, УчитыватьНакладныеРасходы = Истина) Экспорт
	Если История = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	ТокеновНаСообщениеОбвязки = 4;
	ТокеновНаВызовИнструментаОбвязки = 12;
	
	ВсегоТокенов = 0;
	Для Каждого Сообщение Из История Цикл
		Если Сообщение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Контент = ПолучитьКонтентСообщения(Сообщение);
		ВсегоТокенов = ВсегоТокенов + ОценитьКоличествоТокенов(Контент);
		
		Рассуждения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Рассуждения", "");
		Если ПустаяСтрока(Рассуждения) Тогда
			Рассуждения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "reasoning", "");
		КонецЕсли;
		Если НЕ ПустаяСтрока(Рассуждения) Тогда
			ВсегоТокенов = ВсегоТокенов + ОценитьКоличествоТокенов(Рассуждения);
		КонецЕсли;
		
		Вызовы = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ВызовыИнструментов", Неопределено);
		Если Вызовы = Неопределено Тогда
			Вызовы = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "tool_calls", Неопределено);
		КонецЕсли;
		Если Вызовы <> Неопределено И ТипЗнч(Вызовы) = Тип("Массив") Тогда
			Для Каждого ВызовИнструмента Из Вызовы Цикл
				Если ВызовИнструмента = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если УчитыватьНакладныеРасходы Тогда
					ВсегоТокенов = ВсегоТокенов + ТокеновНаВызовИнструментаОбвязки;
				КонецЕсли;
				
				ФункцияВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовИнструмента, "Функция", Неопределено);
				Если ФункцияВызова = Неопределено Тогда
					ФункцияВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовИнструмента, "function", Неопределено);
				КонецЕсли;
				
				ИмяФункцииВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовИнструмента, "Имя", "");
				Если ПустаяСтрока(ИмяФункцииВызова) Тогда
					ИмяФункцииВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовИнструмента, "name", "");
				КонецЕсли;
				АргументыВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовИнструмента, "Аргументы", Неопределено);
				Если АргументыВызова = Неопределено Тогда
					АргументыВызова = СИ_РаботаСJSON.БезопасноПолучить(ВызовИнструмента, "arguments", Неопределено);
				КонецЕсли;
				
				Если ФункцияВызова <> Неопределено И ТипЗнч(ФункцияВызова) <> Тип("Строка") Тогда
					Если ПустаяСтрока(ИмяФункцииВызова) Тогда
						ИмяФункцииВызова = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "Имя", "");
					КонецЕсли;
					Если ПустаяСтрока(ИмяФункцииВызова) Тогда
						ИмяФункцииВызова = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "name", "");
					КонецЕсли;
					Если АргументыВызова = Неопределено Тогда
						АргументыВызова = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "Аргументы", Неопределено);
					КонецЕсли;
					Если АргументыВызова = Неопределено Тогда
						АргументыВызова = СИ_РаботаСJSON.БезопасноПолучить(ФункцияВызова, "arguments", Неопределено);
					КонецЕсли;
				КонецЕсли;
				
				АргументыСтрокой = "";
				Если АргументыВызова <> Неопределено Тогда
					Если ТипЗнч(АргументыВызова) = Тип("Строка") Тогда
						АргументыСтрокой = АргументыВызова;
					Иначе
						Попытка
							АргументыСтрокой = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(АргументыВызова);
						Исключение
							АргументыСтрокой = "";
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ ПустаяСтрока(ИмяФункцииВызова) Тогда
					ВсегоТокенов = ВсегоТокенов + ОценитьКоличествоТокенов(ИмяФункцииВызова);
				КонецЕсли;
				Если НЕ ПустаяСтрока(АргументыСтрокой) Тогда
					ВсегоТокенов = ВсегоТокенов + ОценитьКоличествоТокенов(АргументыСтрокой);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если УчитыватьНакладныеРасходы Тогда
			ВсегоТокенов = ВсегоТокенов + ТокеновНаСообщениеОбвязки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВсегоТокенов;
КонецФункции

// Формирует сводку старой части истории через вызов модели и возвращает новую историю:
// system-промпт → сводка → свежие сообщения. Текст сводки возвращается через выходной параметр.
//
// Параметры:
//  История - Массив из Структура - история для сжатия.
//  ЛимитТокенов - Число - лимит токенов входа.
//  МаксТокеновСводки - Число - бюджет сводки в токенах.
//  Модель - Строка - модель для вызова.
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения.
//  СводкаТекст - Строка - выходной параметр: текст сводки (заполняется при успехе).
//  КоличествоСвежих - Число - сколько последних сообщений оставить нетронутыми
//    (по умолчанию 8; пробрасывается из оркестратора СжатьИсторию).
//
// Возвращаемое значение:
//  Массив из Структура,Неопределено - новая история (Неопределено при ошибке вызова).
Функция СформироватьСводкуИстории(История, ЛимитТокенов, МаксТокеновСводки, Модель, Профиль, СводкаТекст, КоличествоСвежих = 8) Экспорт
	Если История = Неопределено ИЛИ История.Количество() < 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КоличествоСвежих < 2 Тогда
		КоличествоСвежих = 2;
	КонецЕсли;
	КоличествоСообщений = История.Количество();
	Порог = Макс(КоличествоСообщений - КоличествоСвежих, 2);
	
	СистемноеСообщение = Неопределено;
	СтараяЧасть = Новый Массив;
	СвежаяЧасть = Новый Массив;
	
	Для Инд = 0 По КоличествоСообщений - 1 Цикл
		Сообщение = История[Инд];
		Роль = ПолучитьРольСообщения(Сообщение);
		
		Если Роль = "system" И СистемноеСообщение = Неопределено Тогда
			СистемноеСообщение = Сообщение;
			Продолжить;
		КонецЕсли;
		
		Если Инд < Порог Тогда
			СтараяЧасть.Добавить(Сообщение);
		Иначе
			СвежаяЧасть.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	
	Если СтараяЧасть.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстДляСводки = СформироватьТекстДляСводки(СистемноеСообщение, СтараяЧасть);
	
	Сводка = ВызватьМодельДляСводки(ТекстДляСводки, Модель, Профиль, МаксТокеновСводки);
	Если ПустаяСтрока(Сводка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СводкаТекст = Сводка;
	
	НоваяИстория = Новый Массив;
	Если СистемноеСообщение <> Неопределено Тогда
		НоваяИстория.Добавить(СистемноеСообщение);
	КонецЕсли;
	
	СообщениеСводки = Новый Структура;
	СообщениеСводки.Вставить("Роль", "system");
	СообщениеСводки.Вставить("Контент", "Краткая сводка предыдущего диалога (более ранние сообщения сжаты):" + Символы.ПС + Сводка);
	НоваяИстория.Добавить(СообщениеСводки);
	
	Для Каждого СвежееСообщение Из СвежаяЧасть Цикл
		НоваяИстория.Добавить(СвежееСообщение);
	КонецЦикла;
	
	Возврат НоваяИстория;
КонецФункции

// Удаляет рассуждения (reasoning) у сообщений старше КоличествоСвежих последних.
// Рассуждения нужны только для отображения в UI и не принимаются моделями обратно,
// поэтому их включение в контекст — чистый перерасход токенов.
//
// Внимание: мутирует элементы переданного массива и возвращает тот же массив по ссылке.
// Удаляет ключ «Рассуждения» только у assistant-сообщений (у system/tool не трогает).
// Вызывающий должен скопировать массив, если исходный нужно сохранить (см. СжатьИсторию).
//
// Параметры:
//  История - Массив из Структура - исходная история сообщений.
//  КоличествоСвежих - Число - сколько последних сообщений НЕ трогать (по умолчанию 10).
//
// Возвращаемое значение:
//  Массив из Структура - история без рассуждений у старых сообщений (тот же массив).
Функция УбратьРассужденияСтарыхСообщений(История, КоличествоСвежих = 10) Экспорт
	Если История = Неопределено ИЛИ История.Количество() = 0 Тогда
		Возврат История;
	КонецЕсли;
	
	КоличествоСообщений = История.Количество();
	ПервыйИндексДляОбработки = Макс(КоличествоСообщений - КоличествоСвежих, 0);
	
	Для Инд = 0 По КоличествоСообщений - 1 Цикл
		Если Инд >= ПервыйИндексДляОбработки Тогда
			Продолжить;
		КонецЕсли;
		
		Сообщение = История[Инд];
		Если Сообщение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Роль = ПолучитьРольСообщения(Сообщение);
		Если Роль = "assistant" И Сообщение.Свойство("Рассуждения") Тогда
			Сообщение.Удалить("Рассуждения");
		КонецЕсли;
	КонецЦикла;
	
	Возврат История;
КонецФункции

// Ограничивает содержимое tool-сообщений (результаты инструментов) длиной МаксДлина
// символов. Полный результат остаётся в регистре для UI, в контекст уходит усечённая
// версия с суффиксом, информирующим модель об обрезании.
//
// Внимание: мутирует элементы переданного массива и возвращает тот же массив по ссылке.
// Вызывающий должен скопировать массив, если исходный нужно сохранить (см. СжатьИсторию).
//
// Параметры:
//  История - Массив из Структура - исходная история сообщений.
//  МаксДлина - Число - максимальная длина tool-результата в символах (по умолчанию 4000).
//
// Возвращаемое значение:
//  Массив из Структура - история с ограниченными tool-результатами (тот же массив).
Функция ОграничитьРезультатыИнструментов(История, МаксДлина = 4000) Экспорт
	Если История = Неопределено ИЛИ История.Количество() = 0 ИЛИ МаксДлина <= 0 Тогда
		Возврат История;
	КонецЕсли;
	
	Для Каждого Сообщение Из История Цикл
		Если Сообщение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Роль = ПолучитьРольСообщения(Сообщение);
		Если Роль <> "tool" Тогда
			Продолжить;
		КонецЕсли;
		
		Контент = ПолучитьКонтентСообщения(Сообщение);
		Если ПустаяСтрока(Контент) ИЛИ СтрДлина(Контент) <= МаксДлина Тогда
			Продолжить;
		КонецЕсли;
		
		Половина = Цел(МаксДлина / 2);
		Начало = Лев(Контент, Половина);
		Конец = Прав(Контент, Половина);
		СжатыйКонтент = Начало + Символы.ПС + "(Система: текст сокращён - было " + Формат(СтрДлина(Контент), "ЧДЦ=0; ЧГ=")
			+ " символов, сохранено " + Формат(МаксДлина, "ЧДЦ=0; ЧГ=") + ")..." + Символы.ПС + Конец;
		
		УстановитьКонтентСообщения(Сообщение, СжатыйКонтент);
	КонецЦикла;
	
	Возврат История;
КонецФункции

// Обрезает середину отдельных сообщений длиннее МаксДлина символов.
// Применяется только к user/assistant сообщениям с большим объёмом текста
// (например, длинные вставки кода или большие выжимки).
//
// Внимание: мутирует элементы переданного массива и возвращает тот же массив по ссылке.
// Вызывающий должен скопировать массив, если исходный нужно сохранить (см. СжатьИсторию).
//
// Параметры:
//  История - Массив из Структура - исходная история сообщений.
//  МаксДлина - Число - максимальная длина сообщения в символах (по умолчанию 4000).
//
// Возвращаемое значение:
//  Массив из Структура - история с обрезанными длинными сообщениями (тот же массив).
Функция ОбрезатьДлинныеСообщения(История, МаксДлина = 4000) Экспорт
	Если История = Неопределено ИЛИ История.Количество() = 0 ИЛИ МаксДлина <= 0 Тогда
		Возврат История;
	КонецЕсли;
	
	Для Каждого Сообщение Из История Цикл
		Если Сообщение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Роль = ПолучитьРольСообщения(Сообщение);
		Если Роль = "system" Тогда
			Продолжить;
		КонецЕсли;
		
		Контент = ПолучитьКонтентСообщения(Сообщение);
		Если ПустаяСтрока(Контент) ИЛИ СтрДлина(Контент) <= МаксДлина Тогда
			Продолжить;
		КонецЕсли;
		
		Половина = Цел(МаксДлина / 2);
		Начало = Лев(Контент, Половина);
		Конец = Прав(Контент, Половина);
		СжатыйКонтент = Начало + Символы.ПС + "...[сообщение обрезано: было " + Формат(СтрДлина(Контент), "ЧДЦ=0; ЧГ=")
			+ " символов]..." + Символы.ПС + Конец;
		
		УстановитьКонтентСообщения(Сообщение, СжатыйКонтент);
	КонецЦикла;
	
	Возврат История;
КонецФункции

// Заменяет старые пары (assistant с tool_calls + следующее tool-сообщение) одной строкой
// «использован инструмент X: {краткий итог}», если пара старше КоличествоСвежих сообщений.
// Сохраняет только последние КоличествоСвежих пар нетронутыми — они нужны модели
// для текущего незавершённого шага.
//
// Ограничения:
//  - Не обрабатывает параллельные tool_calls в одном assistant-сообщении (gpt-5/o1):
//    схлопывается только первый инструмент, остальные вызовы теряются. Для таких моделей
//    используйте безопасный режим (СхлопыватьToolПары = Ложь) в СжатьИсторию.
//  - assistant с tool_calls БЕЗ следующего tool-сообщения (обрыв диалога) не схлопывается
//    и копируется как есть, чтобы не рассогласовывать роли в OpenAI-формате.
//
// Параметры:
//  История - Массив из Структура - исходная история сообщений.
//  КоличествоСвежих - Число - сколько последних сообщений не схлопывать (по умолчанию 12).
//
// Возвращаемое значение:
//  Массив из Структура - история со схлопнутыми старыми tool-парами.
Функция СхлопнутьСтарыеToolПары(История, КоличествоСвежих = 12) Экспорт
	Если История = Неопределено ИЛИ История.Количество() <= 2 Тогда
		Возврат История;
	КонецЕсли;
	
	Результат = Новый Массив;
	КоличествоСообщений = История.Количество();
	ПорогСвежести = КоличествоСообщений - КоличествоСвежих;
	
	Инд = 0;
	Пока Инд < КоличествоСообщений Цикл
		Сообщение = История[Инд];
		Роль = ПолучитьРольСообщения(Сообщение);
		
		Если Роль = "assistant" И Инд < ПорогСвежести
			И Сообщение.Свойство("ВызовыИнструментов")
			И Сообщение.ВызовыИнструментов <> Неопределено
			И ТипЗнч(Сообщение.ВызовыИнструментов) = Тип("Массив")
			И Сообщение.ВызовыИнструментов.Количество() > 0 Тогда
			
			Если Инд + 1 >= КоличествоСообщений Тогда
				Результат.Добавить(Сообщение);
				Инд = Инд + 1;
				Продолжить;
			КонецЕсли;
			СледующееПроверочное = История[Инд + 1];
			Если ПолучитьРольСообщения(СледующееПроверочное) <> "tool" Тогда
				Результат.Добавить(Сообщение);
				Инд = Инд + 1;
				Продолжить;
			КонецЕсли;
			
			ИмяИнструмента = ПолучитьИмяПервогоИнструмента(Сообщение.ВызовыИнструментов);
			СводкаИнструмента = "";
			
			СледующийИндекс = Инд + 1;
			Пока СледующийИндекс < КоличествоСообщений Цикл
				СледующееСообщение = История[СледующийИндекс];
				РольСледующего = ПолучитьРольСообщения(СледующееСообщение);
				Если РольСледующего <> "tool" Тогда
					Прервать;
				КонецЕсли;
				
				КонтентИнструмента = ПолучитьКонтентСообщения(СледующееСообщение);
				Если НЕ ПустаяСтрока(КонтентИнструмента) Тогда
					Если НЕ ПустаяСтрока(СводкаИнструмента) Тогда
						СводкаИнструмента = СводкаИнструмента + " | ";
					КонецЕсли;
					Если СтрДлина(КонтентИнструмента) > 300 Тогда
						СводкаИнструмента = СводкаИнструмента + Лев(КонтентИнструмента, 300) + "…";
					Иначе
						СводкаИнструмента = СводкаИнструмента + КонтентИнструмента;
					КонецЕсли;
				КонецЕсли;
				СледующийИндекс = СледующийИндекс + 1;
			КонецЦикла;
			
			Замена = Новый Структура;
			Замена.Вставить("Роль", "user");
			ТекстЗамены = "[использован инструмент " + ИмяИнструмента;
			Если НЕ ПустаяСтрока(СводкаИнструмента) Тогда
				ТекстЗамены = ТекстЗамены + ": " + СводкаИнструмента;
			КонецЕсли;
			ТекстЗамены = ТекстЗамены + "]";
			Замена.Вставить("Контент", ТекстЗамены);
			Результат.Добавить(Замена);
			
			Инд = СледующийИндекс;
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(Сообщение);
		Инд = Инд + 1;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Сжимает вложения файлов (помеченные ФайлВложение) на повторных итерациях агентского цикла.
// Полное содержимое файла передаётся модели только на 1-й итерации; на последующих
// (когда модель уже получила данные и делает tool-шаги) заменяется кратким маркером,
// чтобы не тратить токены контекста на дублирующиеся данные файла.
//
// Цепочка вызова: НЕ входит в оркестратор СжатьИсторию — вызывается напрямую из
// СИ_Агент1С.СобратьПараметрыЗапроса (по номеру итерации агентского цикла).
//
// Внимание: мутирует элементы переданного массива и возвращает тот же массив по ссылке.
//
// Параметры:
//  История - Массив из Структура - история сообщений.
//  НомерИтерации - Число - текущий номер итерации агентского цикла.
//
// Возвращаемое значение:
//  Массив из Структура - история со сжатыми вложениями (на итерации > 1).
Функция СжатьВложенияНаИтерации(История, НомерИтерации) Экспорт
	Если История = Неопределено ИЛИ История.Количество() = 0 Тогда
		Возврат История;
	КонецЕсли;
	
	Если НомерИтерации <= 1 Тогда
		Возврат История;
	КонецЕсли;
	
	Для Каждого Сообщение Из История Цикл
		Если Сообщение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Сообщение.Свойство("ФайлВложение") И Сообщение.ФайлВложение = Истина Тогда
			ИмяВложения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИмяВложения", "файл");
			КонтентСообщения = ПолучитьКонтентСообщения(Сообщение);
			Если ТипЗнч(КонтентСообщения) = Тип("Массив") Тогда
				УстановитьКонтентСообщения(Сообщение,
					"[Изображение: " + ИмяВложения + " — содержимое было передано в начале диалога]");
			Иначе
				УстановитьКонтентСообщения(Сообщение,
					"[Вложение: " + ИмяВложения + " — содержимое было передано в начале диалога]");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат История;
КонецФункции

// Очищает диалог: удаляет все сообщения диалога, кроме системного.
// Очистка и восстановление системного сообщения выполняются в одной транзакции,
// чтобы параллельная запись сообщений не потеряла данные между двумя операциями.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Булево - Истина при успешной очистке.
Функция ОчиститьДиалог(ИдДиалога) Экспорт
	Попытка
		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		СистемноеСообщение = Неопределено;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СообщенияДиалога.НомерСообщения,
		|	СообщенияДиалога.Роль,
		|	СообщенияДиалога.Контент,
		|	СообщенияДиалога.ВызовыИнструментовJSON,
		|	СообщенияДиалога.ИдВызоваИнструмента,
		|	СообщенияДиалога.ИмяИнструмента
		|ИЗ
		|	РегистрСведений.СИ_СообщенияДиалога КАК СообщенияДиалога
		|ГДЕ
		|	СообщенияДиалога.ИдДиалога = &ИдДиалога
		|	И СообщенияДиалога.Роль = &РольСистемы
		|УПОРЯДОЧИТЬ ПО
		|	СообщенияДиалога.НомерСообщения ВОЗР";
		
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);
		Запрос.УстановитьПараметр("РольСистемы", Перечисления.СИ_РолиСообщений.System);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			СистемноеСообщение = Новый Структура;
			СистемноеСообщение.Вставить("НомерСообщения", Выборка.НомерСообщения);
			СистемноеСообщение.Вставить("Контент", Выборка.Контент);
			СистемноеСообщение.Вставить("ВызовыИнструментовJSON", Выборка.ВызовыИнструментовJSON);
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			НаборЗаписей = РегистрыСведений.СИ_СообщенияДиалога.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдДиалога.Установить(ИдДиалога);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
			
			Если СистемноеСообщение <> Неопределено Тогда
				НовыйНабор = РегистрыСведений.СИ_СообщенияДиалога.СоздатьНаборЗаписей();
				НоваяЗапись = НовыйНабор.Добавить();
				НоваяЗапись.ИдДиалога = ИдДиалога;
				НоваяЗапись.НомерСообщения = СистемноеСообщение.НомерСообщения;
				НоваяЗапись.Роль = Перечисления.СИ_РолиСообщений.System;
				НоваяЗапись.Контент = СистемноеСообщение.Контент;
				НоваяЗапись.ВызовыИнструментовJSON = "";
				НоваяЗапись.Рассуждения = "";
				НоваяЗапись.ДатаЗаписи = ТекущаяУниверсальнаяДата();
				НовыйНабор.Записать();
			КонецЕсли;
			ЗавершитьТранзакциюОчистки();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("Агент1С.ОчиститьДиалог", УровеньЖурналаРегистрации.Ошибка, , ,
				"Ошибка очистки диалога: " + ОписаниеОшибки());
			ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;
		
		ЗначенияСтатуса = Новый Структура;
		ЗначенияСтатуса.Вставить("Статус", Перечисления.СИ_СтатусыДиалога.Активен);
		ПараметрыСтатуса = Новый Структура;
		ПараметрыСтатуса.Вставить("ИмяОперации", "ОчиститьДиалог");
		ЗаписатьРеквизитыДиалога(ИдДиалога, ЗначенияСтатуса, ПараметрыСтатуса);
		
		Возврат Истина;
	Исключение
		ЗаписатьВЖурнал("ОчиститьДиалог", УровеньЖурналаРегистрации.Ошибка, "Ошибка очистки диалога: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Заменяет всю историю сообщений диалога на переданную (используется при ручном сжатии).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  НоваяИстория - Массив из Структура - новая история в формате OpenAI:
//    * Роль - Строка - "system", "user", "assistant" или "tool".
//    * Контент - Строка,Неопределено - текст сообщения.
//    * ВызовыИнструментов - Массив из Структура,Неопределено - tool_calls.
//    * Рассуждения - Строка,Неопределено - рассуждения ассистента.
//    * ИдВызоваИнструмента - Строка,Неопределено - для role=tool.
//    * ИмяИнструмента - Строка,Неопределено - для role=tool.
//
// Возвращаемое значение:
//  Булево - Истина при успешной замене.
Функция ЗаменитьИсториюДиалога(ИдДиалога, НоваяИстория) Экспорт
	Попытка
		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НоваяИстория = Неопределено ИЛИ НоваяИстория.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			НаборЗаписей = РегистрыСведений.СИ_СообщенияДиалога.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдДиалога.Установить(ИдДиалога);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			
			Номер = 1;
			Для Каждого Сообщение Из НоваяИстория Цикл
				Запись = НаборЗаписей.Добавить();
				ЗаполнитьЗаписьСообщения(Запись, ИдДиалога, Сообщение, Номер);
				Номер = Номер + 1;
			КонецЦикла;
			
			НаборЗаписей.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;
		
		Возврат Истина;
	Исключение
		ЗаписатьВЖурнал("ЗаменитьИсториюДиалога", УровеньЖурналаРегистрации.Ошибка, "Ошибка замены истории диалога: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Приближённая оценка количества токенов в тексте с учётом доли кириллицы.
//
// Для русского текста (кириллица) токенизаторы в среднем дают ~1 токен на 2.5-3 символа,
// для латиницы ~1 токен на 4 символа. Оценка семплирует первые 2000 символов,
// определяет долю кириллицы и применяет взвешенный коэффициент ко всей строке.
// Это заметно точнее прежней константы «длина/4» и позволяет калибровать лимиты
// сжатия по фактическим данным моделей.
//
// Коэффициенты эмпирические (калибруются по фактическим данным моделей):
//  СИМВОЛОВ_НА_ТОКЕН_ЛАТИНИЦА = 4.0, СИМВОЛОВ_НА_ТОКЕН_КИРИЛЛИЦА = 2.5,
//  ДЛИНА_ВЫБОРКИ_ДЛЯ_ОЦЕНКИ = 2000.
//
// Параметры:
//  Текст - Строка - текст для оценки.
//
// Возвращаемое значение:
//  Число - ориентировочное количество токенов (минимум 1 для непустого текста).
Функция ОценитьКоличествоТокенов(Текст) Экспорт
	Если Текст = Неопределено ИЛИ ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат 0;
	КонецЕсли;
	
	Длина = СтрДлина(Текст);
	Если Длина = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ДлинаВыборки = Мин(Длина, 2000);
	Выборка = Лев(Текст, ДлинаВыборки);
	КоличествоКириллицы = ПосчитатьКириллическиеСимволы(Выборка);
	ДоляКириллицы = КоличествоКириллицы / ДлинаВыборки;
	
	СимволовНаТокен = 4 - ДоляКириллицы * 1.5;
	Если СимволовНаТокен <= 0 Тогда
		СимволовНаТокен = 2.5;
	КонецЕсли;
	
	Возврат Макс(Цел(Длина / СимволовНаТокен), 1);
КонецФункции

// Замена эмодзи за пределами Basic Multilingual Plane (суррогатные пары UTF-16)
// на inline SVG (или текстовые эквиваленты) для совместимости с движком Trident.
//
// Устаревший шорткат: реализация перенесена в модуль представления СИ_ЭмодзиHTMLКлиентСервер
// (SRP — генерация SVG не относится к управлению диалогом). Новый код вызывайте
// напрямую через СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте.
//
// Параметры:
//  Текст - Строка - текст (обычно уже HTML-экранированный) для обработки.
//  ЗаменятьНеизвестные - Булево - заменять ли неизвестные суррогатные пары на "[?]"
//    (Истина) или удалять их (Ложь). По умолчанию Истина.
//
// Возвращаемое значение:
//  Строка - текст с заменёнными эмодзи.
Функция ЗаменитьЭмодзиВТексте(Текст, ЗаменятьНеизвестные = Истина) Экспорт
	Возврат СИ_ЭмодзиHTMLКлиентСервер.ЗаменитьЭмодзиВТексте(Текст, ЗаменятьНеизвестные);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует текст для суммаризации из системного промпта и старой части истории.
Функция СформироватьТекстДляСводки(СистемноеСообщение, СтараяЧасть)
	Части = Новый Массив;
	
	Если СистемноеСообщение <> Неопределено Тогда
		СистемныйКонтент = ПолучитьКонтентСообщения(СистемноеСообщение);
		Если НЕ ПустаяСтрока(СистемныйКонтент) Тогда
			Части.Добавить("СИСТЕМНЫЙ ПРОМПТ ДИАЛОГА:" + Символы.ПС + СистемныйКонтент + Символы.ПС + Символы.ПС);
		КонецЕсли;
	КонецЕсли;
	
	Части.Добавить("ИСТОРИЯ ДИАЛОГА:" + Символы.ПС);
	Для Каждого Сообщение Из СтараяЧасть Цикл
		Роль = ПолучитьРольСообщения(Сообщение);
		Если Роль = "service" Тогда
			Продолжить;
		КонецЕсли;
		Контент = ПолучитьКонтентСообщения(Сообщение);
		
		Части.Добавить("=== " + ВРег(Роль) + " ===" + Символы.ПС + Контент + Символы.ПС);
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "");
КонецФункции

// Вызывает модель для формирования сводки и возвращает текст сводки.
Функция ВызватьМодельДляСводки(ТекстДляСводки, Модель, Профиль, МаксТокеновСводки)
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Модель", Модель);
	ПараметрыЗапроса.Вставить("Потоковый", Ложь);
	ПараметрыЗапроса.Вставить("Температура", 0.3);
	Если Профиль <> Неопределено И ЗначениеЗаполнено(Профиль) Тогда
		ПараметрыЗапроса.Вставить("Профиль", Профиль);
	КонецЕсли;
	
	ПромптСводки =
		"Ты — компрессор контекста чата. Сожми приведённую ниже историю диалога в краткую сводку "
		+ "на русском языке. Сохрани: решённые вопросы, ключевые факты и числа, принятые решения, "
		+ "договорённости, текущие задачи и незавершённые действия, предпочтения пользователя. "
		+ "Не выдумывай фактов, которых нет в истории. Не описывай процесс — только суть. "
		+ "Объём сводки: не более " + Формат(МаксТокеновСводки, "ЧДЦ=0; ЧГ=") + " токенов. "
		+ "Начни сразу с текста сводки, без вступлений." + Символы.ПС + Символы.ПС + ТекстДляСводки;
	
	Сообщения = Новый Массив;
	Сообщение = Новый Структура;
	Сообщение.Вставить("Роль", "user");
	Сообщение.Вставить("Контент", ПромптСводки);
	Сообщения.Добавить(Сообщение);
	ПараметрыЗапроса.Вставить("Сообщения", Сообщения);
	
	Попытка
		РезультатВызова = СИ_ОpenAIКлиент.ВызватьChatCompletion(ПараметрыЗапроса);
		Если СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Успех", Ложь) Тогда
			Ответ = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Ответ", Неопределено);
			Если Ответ <> Неопределено Тогда
				Разобранный = СИ_ОpenAIКлиент.СобратьСообщениеИзОтвета(Ответ);
				СообщениеСводки = СИ_РаботаСJSON.БезопасноПолучить(Разобранный, "Сообщение", Неопределено);
				Если СообщениеСводки <> Неопределено Тогда
					Контент = СИ_РаботаСJSON.БезопасноПолучить(СообщениеСводки, "content", "");
					Если Контент = Неопределено ИЛИ ТипЗнч(Контент) <> Тип("Строка") Тогда
						Контент = СИ_РаботаСJSON.БезопасноПолучить(СообщениеСводки, "Контент", "");
					КонецЕсли;
					Если НЕ ПустаяСтрока(Контент) Тогда
						Возврат СокрЛП(Контент);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("Сводка", УровеньЖурналаРегистрации.Предупреждение, "Ошибка вызова модели для сводки: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат "";
КонецФункции

// Возвращает строковую роль сообщения (поддерживает русские и английские ключи).
Функция ПолучитьРольСообщения(Сообщение)
	Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Роль", "");
	Если ПустаяСтрока(Роль) Тогда
		Роль = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "role", "");
	КонецЕсли;
	Возврат НРег(Роль);
КонецФункции

// Роль сообщения в запись регистра. Служебные сообщения агента (ошибка вызова
// модели, уведомление о лимите токенов) хранятся отдельной ролью: их видит
// пользователь, но в запрос к модели они не передаются (см.
// СИ_Агент1С.СобратьПараметрыЗапроса).
//
// Параметры:
//  Роль - Строка - "system", "user", "assistant", "tool" или "service".
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СИ_РолиСообщений - роль для записи регистра.
Функция РольСсылкаПоСтроке(Роль)
	Если Роль = "system" Тогда
		Возврат Перечисления.СИ_РолиСообщений.System;
	ИначеЕсли Роль = "assistant" Тогда
		Возврат Перечисления.СИ_РолиСообщений.Assistant;
	ИначеЕсли Роль = "tool" Тогда
		Возврат Перечисления.СИ_РолиСообщений.Tool;
	ИначеЕсли Роль = "service" Тогда
		Возврат Перечисления.СИ_РолиСообщений.Служебное;
	КонецЕсли;
	Возврат Перечисления.СИ_РолиСообщений.User;
КонецФункции

// Возвращает контент сообщения (поддерживает русские и английские ключи).
Функция ПолучитьКонтентСообщения(Сообщение)
	Контент = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Контент", "");
	Если ПустаяСтрока(Контент) Тогда
		Контент = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "content", "");
	КонецЕсли;
	Если Контент = Неопределено Тогда
		Контент = "";
	КонецЕсли;
	Возврат Контент;
КонецФункции

// Устанавливает контент сообщения (поддерживает русские и английские ключи).
// Пишет в ТОТ ЖЕ ключ, из которого читает ПолучитьКонтентСообщения («Контент» → «content»),
// чтобы не создавать в структуре два ключа с одним содержимым (искажает JSON-сериализацию).
Процедура УстановитьКонтентСообщения(Сообщение, Значение)
	Если Сообщение.Свойство("Контент") Тогда
		Сообщение.Контент = Значение;
	ИначеЕсли Сообщение.Свойство("content") Тогда
		Сообщение.content = Значение;
	Иначе
		Сообщение.Вставить("Контент", Значение);
	КонецЕсли;
КонецПроцедуры

// Возвращает имя первого инструмента из массива tool_calls.
Функция ПолучитьИмяПервогоИнструмента(ВызовыИнструментов)
	Если ВызовыИнструментов = Неопределено ИЛИ ВызовыИнструментов.Количество() = 0 Тогда
		Возврат "инструмент";
	КонецЕсли;
	ПервыйВызов = ВызовыИнструментов[0];
	Имя = СИ_РаботаСJSON.БезопасноПолучить(ПервыйВызов, "Имя", "");
	Если ПустаяСтрока(Имя) Тогда
		Имя = СИ_РаботаСJSON.БезопасноПолучить(ПервыйВызов, "name", "");
	КонецЕсли;
	Если ПустаяСтрока(Имя) Тогда
		ФункцияОб = СИ_РаботаСJSON.БезопасноПолучить(ПервыйВызов, "Функция", Неопределено);
		Если ФункцияОб = Неопределено Тогда
			ФункцияОб = СИ_РаботаСJSON.БезопасноПолучить(ПервыйВызов, "function", Неопределено);
		КонецЕсли;
		Если ФункцияОб <> Неопределено Тогда
			Имя = СИ_РаботаСJSON.БезопасноПолучить(ФункцияОб, "Имя", "");
			Если ПустаяСтрока(Имя) Тогда
				Имя = СИ_РаботаСJSON.БезопасноПолучить(ФункцияОб, "name", "");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Имя) Тогда
		Имя = "инструмент";
	КонецЕсли;
	Возврат Имя;
КонецФункции

// Подсчитывает количество кириллических символов в тексте.
// Кириллица: коды 1040-1103 (А-я) плюс Ё (1025) и ё (1105).
//
// Параметры:
//  Текст - Строка - текст для анализа.
//
// Возвращаемое значение:
//  Число - количество кириллических символов.
Функция ПосчитатьКириллическиеСимволы(Текст)
	КоличествоКириллицы = 0;
	Длина = СтрДлина(Текст);
	
	Для ИндексСимвола = 1 По Длина Цикл
		Код = КодСимвола(Текст, ИндексСимвола);
		Если (Код >= 1040 И Код <= 1103) ИЛИ Код = 1025 ИЛИ Код = 1105 Тогда
			КоличествоКириллицы = КоличествоКириллицы + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КоличествоКириллицы;
КонецФункции

// Возвращает текст первого пользовательского запроса диалога (для генерации заголовка).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Строка - текст первого user-сообщения ("" - если не найдено).
Функция ПолучитьПервыйЗапросДиалога(ИдДиалога)
	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщенияДиалога.Контент КАК Контент
		|ИЗ
		|	РегистрСведений.СИ_СообщенияДиалога КАК СообщенияДиалога
		|ГДЕ
		|	СообщенияДиалога.ИдДиалога = &ИдДиалога
		|	И СообщенияДиалога.Роль = &РольПользователя
		|УПОРЯДОЧИТЬ ПО
		|	СообщенияДиалога.НомерСообщения ВОЗР";
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);
		Запрос.УстановитьПараметр("РольПользователя", Перечисления.СИ_РолиСообщений.User);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СокрЛП(Строка(Выборка.Контент));
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("ПолучитьПервыйЗапросДиалога", УровеньЖурналаРегистрации.Предупреждение,
			"Ошибка чтения первого запроса диалога: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат "";
КонецФункции

// Формирует заголовок диалога из текста первого user-сообщения БЕЗ вызова ИИ.
// Альтернатива СформироватьЗаголовокДиалога: берёт начало первого запроса,
// вычищает переводы строк и разметку и обрезает по границе слова до 40 символов.
// Выбирается настройкой профиля ЗаголовокЧерезИИ = Ложь (по умолчанию).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Строка - заголовок (до 40 символов, с «…» при усечении); "" - если текста нет.
Функция СформироватьЗаголовокИзТекста(ИдДиалога) Экспорт
	ПервыйЗапрос = ПолучитьПервыйЗапросДиалога(ИдДиалога);
	Если ПустаяСтрока(ПервыйЗапрос) Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = СтрЗаменить(ПервыйЗапрос, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Текст = СокрЛП(Текст);
	
	Пока СтрДлина(Текст) > 0 Цикл
		ПервыйСимвол = Лев(Текст, 1);
		Если ПервыйСимвол = "#" ИЛИ ПервыйСимвол = ">" ИЛИ ПервыйСимвол = "-"
			ИЛИ ПервыйСимвол = "*" ИЛИ ПервыйСимвол = "`" Тогда
			Текст = СокрЛП(Сред(Текст, 2));
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ОбрезатьЗаголовокПоСлову(Текст);
КонецФункции

// Обрезает текст до 40 символов по границе слова, добавляя «…» при усечении.
// Если первое слово длиннее лимита - режет жёстко: сама граница важнее целого слова.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст не длиннее 40 символов.
Функция ОбрезатьЗаголовокПоСлову(Текст)
	Если СтрДлина(Текст) <= 40 Тогда
		Возврат Текст;
	КонецЕсли;
	
	Обрезанный = Лев(Текст, 40);
	ПозицияПробела = СтрНайти(Обрезанный, " ", НаправлениеПоиска.СКонца);
	Если ПозицияПробела > 15 Тогда
		Обрезанный = Лев(Обрезанный, ПозицияПробела - 1);
	КонецЕсли;
	Возврат Лев(СокрЛП(Обрезанный), 39) + "…";
КонецФункции

// Формирует заголовок (наименование) диалога с помощью модели.
// Выполняет один лёгкий вызов: передаёт модели только первое user-сообщение,
// ограничивает ответ max_tokens=2000 (лимит увеличен, т.к. провайдеры deepseek
// генерируют reasoning_content ДО content и при малом max_tokens ответ обрывается
// с ПричинаЗавершения=length до выдачи JSON; сам JSON крошечный — бюджет уходит
// только на рассуждения). Используется ТОЛЬКО для новых диалогов (вызывающий код
// проверяет, что наименование ещё шаблонное «Диалог от …»).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  Параметры - Структура - параметры вызова:
//    * Модель     - Строка - идентификатор модели.
//    * Профиль    - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения.
//    * Настройки  - Структура,Неопределено - настройки агента (оптимизация чтения БД).
//
// Возвращаемое значение:
//  Строка - сформированный заголовок (до 40 символов); "" - если не удалось.
Функция СформироватьЗаголовокДиалога(ИдДиалога, Параметры) Экспорт
	ПервыйЗапрос = ПолучитьПервыйЗапросДиалога(ИдДиалога);
	ЗаписатьВЖурнал("СформироватьЗаголовокДиалога", УровеньЖурналаРегистрации.Информация,
		"Вход. ИдДиалога=" + Строка(ИдДиалога) + " | ДлинаПервогоЗапроса=" + Строка(СтрДлина(ПервыйЗапрос)));
	Если ПустаяСтрока(ПервыйЗапрос) Тогда
		ЗаписатьВЖурнал("СформироватьЗаголовокДиалога", УровеньЖурналаРегистрации.Информация,
			"Выход: первое user-сообщение не найдено (пустой запрос).");
		Возврат "";
	КонецЕсли;
	
	ПервыйЗапросДляМодели = ПервыйЗапрос;

	Модель = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Модель", "");
	Если ПустаяСтрока(Модель) Тогда
		ЗаписатьВЖурнал("СформироватьЗаголовокДиалога", УровеньЖурналаРегистрации.Информация,
			"Выход: модель не передана.");
		Возврат "";
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Модель", Модель);
	ПараметрыЗапроса.Вставить("Потоковый", Ложь);
	ПараметрыЗапроса.Вставить("Температура", 0.2);
	ПараметрыЗапроса.Вставить("MaxTokens", 2000);
	ПараметрыЗапроса.Вставить("ОтключитьРассуждения", Истина);
	
	ФорматОтвета = Новый Соответствие;
	ФорматОтвета.Вставить("type", "json_object");
	ПараметрыЗапроса.Вставить("ФорматОтвета", ФорматОтвета);
	
	Профиль = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Профиль", Неопределено);
	Если Профиль <> Неопределено И ЗначениеЗаполнено(Профиль) Тогда
		ПараметрыЗапроса.Вставить("Профиль", Профиль);
	КонецЕсли;
	НастройкиЗапроса = СИ_РаботаСJSON.БезопасноПолучить(Параметры, "Настройки", Неопределено);
	Если НастройкиЗапроса <> Неопределено Тогда
		ПараметрыЗапроса.Вставить("Настройки", НастройкиЗапроса);
	КонецЕсли;
	
	ПромптЗаголовка =
		"Сформулируй короткое название диалога (тему беседы) на русском языке по первому сообщению пользователя. "
		+ "Верни ТОЛЬКО JSON вида {""title"": ""название""} — без пояснений, без markdown-обёрток, без кавычек вокруг JSON. "
		+ "Название: не более 40 символов, без точки в конце. "
		+ "Первое сообщение: " + Лев(ПервыйЗапросДляМодели, 500);
	
	Сообщения = Новый Массив;
	Сообщение = Новый Структура;
	Сообщение.Вставить("Роль", "user");
	Сообщение.Вставить("Контент", ПромптЗаголовка);
	Сообщения.Добавить(Сообщение);
	ПараметрыЗапроса.Вставить("Сообщения", Сообщения);
	
	Попытка
		РезультатВызова = СИ_ОpenAIКлиент.ВызватьChatCompletion(ПараметрыЗапроса);
		Если СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Успех", Ложь) Тогда
			Ответ = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Ответ", Неопределено);
			Если Ответ <> Неопределено Тогда
				Разобранный = СИ_ОpenAIКлиент.СобратьСообщениеИзОтвета(Ответ);
				Заголовок = ОбработатьОтветЗаголовка(Разобранный);
				Если НЕ ПустаяСтрока(Заголовок) Тогда
					Возврат ОбрезатьЗаголовок(Заголовок);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ЗаписатьВЖурнал("СформироватьЗаголовокДиалога", УровеньЖурналаРегистрации.Ошибка,
				"Ошибка вызова модели для заголовка: Код="
				+ Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "КодОшибки", ""))
				+ " | Текст=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "ТекстОшибки", "")));
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("СформироватьЗаголовокДиалога", УровеньЖурналаРегистрации.Ошибка,
			"Ошибка вызова модели для заголовка: " + ОписаниеОшибки());
	КонецПопытки;
	
	ЗаписатьВЖурнал("СформироватьЗаголовокДиалога", УровеньЖурналаРегистрации.Предупреждение,
		"Функция завершилась без результата (вернула пусто).");
	Возврат "";
КонецФункции

// Извлекает заголовок из разобранного ответа модели: сначала из content,
// затем из reasoning_content (фолбэк для провайдеров, игнорирующих think:false).
//
// Параметры:
//  Разобранный - Структура - результат СИ_ОpenAIКлиент.СобратьСообщениеИзОтвета.
//
// Возвращаемое значение:
//  Строка - заголовок ("" - если не найден ни в content, ни в рассуждениях).
Функция ОбработатьОтветЗаголовка(Разобранный)
	СообщениеМодели = СИ_РаботаСJSON.БезопасноПолучить(Разобранный, "Сообщение", Неопределено);
	Если СообщениеМодели = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	КонтентОтвета = СокрЛП(СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "content", ""));
	Если ПустаяСтрока(КонтентОтвета) Тогда
		КонтентОтвета = СокрЛП(СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "Контент", ""));
	КонецЕсли;
	Если НЕ ПустаяСтрока(КонтентОтвета) Тогда
		Заголовок = ИзвлечьЗаголовокИзJSON(КонтентОтвета);
		Если НЕ ПустаяСтрока(Заголовок) Тогда
			Возврат Заголовок;
		КонецЕсли;
	КонецЕсли;
	
	РассужденияОтвета = СокрЛП(СИ_РаботаСJSON.БезопасноПолучить(Разобранный, "Рассуждения", ""));
	Если НЕ ПустаяСтрока(РассужденияОтвета) Тогда
		Заголовок = ИзвлечьЗаголовокИзJSON(РассужденияОтвета);
		Если НЕ ПустаяСтрока(Заголовок) Тогда
			Возврат Заголовок;
		КонецЕсли;
		Заголовок = ИзвлечьЗаголовокИзРассуждений(РассужденияОтвета);
		Если НЕ ПустаяСтрока(Заголовок) Тогда
			Возврат Заголовок;
		КонецЕсли;
	КонецЕсли;
	
	ЗаписатьВЖурнал("СформироватьЗаголовокДиалога", УровеньЖурналаРегистрации.Информация,
		"Модель вернула не JSON для заголовка. Ответ: " + Лев(КонтентОтвета, 300)
		+ " | Рассуждения: " + Лев(РассужденияОтвета, 300)
		+ " | ПричинаЗавершения=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(Разобранный, "ПричинаЗавершения", "")));
	Возврат "";
КонецФункции

// Извлекает кандидата в заголовок из текста рассуждений модели, когда JSON
// сформировать не удалось (лимит токенов съеден reasoning_content). Модель
// в таких случаях перечисляет варианты в кавычках; берём ПОСЛЕДНЮЮ цитату,
// содержащую кириллицу (это, как правило, итоговый выбор), и обрезаем до 40 символов.
//
// Параметры:
//  Текст - Строка - текст рассуждений модели.
//
// Возвращаемое значение:
//  Строка - заголовок; "" - если подходящая цитата не найдена.
Функция ИзвлечьЗаголовокИзРассуждений(Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	ПоследнийКандидат = "";
	ПозицияПоиска = 1;
	Пока ПозицияПоиска <= СтрДлина(Текст) Цикл
		ПозицияОткрытия = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, ПозицияПоиска);
		Если ПозицияОткрытия = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияЗакрытия = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, ПозицияОткрытия + 1);
		Если ПозицияЗакрытия = 0 Тогда
			Прервать;
		КонецЕсли;
		Кандидат = СокрЛП(Сред(Текст, ПозицияОткрытия + 1, ПозицияЗакрытия - ПозицияОткрытия - 1));
		Если НЕ ПустаяСтрока(Кандидат) Тогда
			Если СтрДлина(Кандидат) > 2 И СодержитКириллицу(Кандидат) Тогда
				ПоследнийКандидат = Кандидат;
			КонецЕсли;
		КонецЕсли;
		ПозицияПоиска = ПозицияЗакрытия + 1;
	КонецЦикла;

	Возврат ОбрезатьЗаголовок(ПоследнийКандидат);
КонецФункции

// Проверяет наличие хотя бы одного символа кириллицы в строке.
//
// Параметры:
//  Текст - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если в строке есть кириллический символ.
Функция СодержитКириллицу(Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		КодСимвола = КодСимвола(Сред(Текст, Индекс, 1));
		Если (КодСимвола >= 1040 И КодСимвола <= 1103)
			ИЛИ КодСимвола = 1105 ИЛИ КодСимвола = 1025 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Ограничивает длину заголовка 40 символами (единая точка обрезки для всех путей).
//
// Параметры:
//  Заголовок - Строка - заголовок для обрезки.
//
// Возвращаемое значение:
//  Строка - заголовок длиной не более 40 символов.
Функция ОбрезатьЗаголовок(Заголовок)
	Если СтрДлина(Заголовок) > 40 Тогда
		Возврат Лев(Заголовок, 40);
	КонецЕсли;
	Возврат Заголовок;
КонецФункции

// Извлекает поле "title" из JSON-ответа модели (допускает ```json ... ``` обёртку
// и посторонний текст вокруг). Возвращает "" если распарсить не удалось.
//
// Параметры:
//  Текст - Строка - ответ модели, предположительно содержащий {"title": "..."}.
//
// Возвращаемое значение:
//  Строка - значение поля title; "" - если не найдено.
Функция ИзвлечьЗаголовокИзJSON(Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	ПозицияБлок = СтрНайти(Текст, "```");
	Если ПозицияБлок > 0 Тогда
		Текст = Сред(Текст, ПозицияБлок);
		ПозицияЗакрытия = СтрНайти(Текст, "```", НаправлениеПоиска.СНачала, 4);
		Если ПозицияЗакрытия > 3 Тогда
			Текст = Лев(Текст, ПозицияЗакрытия - 1);
		КонецЕсли;
	КонецЕсли;
	
	ПозицияОткрытия = СтрНайти(Текст, "{");
	ПозицияЗакрытия = НайтиКонецJSON(Текст);
	Если ПозицияОткрытия > 0 И ПозицияЗакрытия > ПозицияОткрытия Тогда
		СтрокаJSON = Сред(Текст, ПозицияОткрытия, ПозицияЗакрытия - ПозицияОткрытия + 1);
		ДанныеJSON = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(СтрокаJSON);
		Если ДанныеJSON <> Неопределено Тогда
			Заголовок = СокрЛП(СИ_РаботаСJSON.БезопасноПолучить(ДанныеJSON, "title", ""));
			Если НЕ ПустаяСтрока(Заголовок) Тогда
				Возврат Заголовок;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
КонецФункции

// Возвращает позицию последней закрывающей фигурной скобки "}" в строке.
// Внутренняя утилита для ИзвлечьЗаголовокИзJSON.
//
// Параметры:
//  Текст - Строка - строка для поиска.
//
// Возвращаемое значение:
//  Число - позиция последней "}" (0, если не найдена).
Функция НайтиКонецJSON(Текст)
	Возврат СтрНайти(Текст, "}", НаправлениеПоиска.СКонца);
КонецФункции

// Получение максимального номера сообщения в диалоге.
// Внутренняя утилита: Экспорт снят (используется только внутри модуля).
//
// Параметры:
//  СсылкаДиалог - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//
// Возвращаемое значение:
//  Число - максимальный номер сообщения (или -1, если сообщений нет).
// Экспорт: используется формой чата как сверка - совпадает ли максимальный
// номер в регистре с максимальным номером отрисованных сообщений. Расхождение
// означает, что нумерация буфера сдвинулась (retry в СброситьБуферСообщений),
// и отрисованный документ уже нельзя доводить точечно - нужна перечитка.
Функция ПолучитьМаксимальныйНомерСообщения(СсылкаДиалог) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(СообщенияДиалога.НомерСообщения) КАК МаксНомер
	|ИЗ
	|	РегистрСведений.СИ_СообщенияДиалога КАК СообщенияДиалога
	|ГДЕ
	|	СообщенияДиалога.ИдДиалога = &ИдДиалога";
	
	Запрос.УстановитьПараметр("ИдДиалога", СсылкаДиалог);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Значение = Выборка.МаксНомер;
		Если ТипЗнч(Значение) <> Тип("Null") И ТипЗнч(Значение) <> Тип("Неопределено") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат -1;
КонецФункции

// Формирование структуры сообщения в формате OpenAI из записи регистра.
Функция СформироватьСообщениеИзЗаписи(Выборка)
	Сообщение = Новый Структура;
	
	Сообщение.Вставить("НомерСообщения", Выборка.НомерСообщения);
	
	РольСтрока = "user";
	Роль = Выборка.Роль;
	Если Роль = Перечисления.СИ_РолиСообщений.System Тогда
		РольСтрока = "system";
	ИначеЕсли Роль = Перечисления.СИ_РолиСообщений.Assistant Тогда
		РольСтрока = "assistant";
	ИначеЕсли Роль = Перечисления.СИ_РолиСообщений.Tool Тогда
		РольСтрока = "tool";
	ИначеЕсли Роль = Перечисления.СИ_РолиСообщений.Служебное Тогда
		РольСтрока = "service";
	КонецЕсли;
	Сообщение.Вставить("Роль", РольСтрока);
	
	Контент = Выборка.Контент;
	Если ПустаяСтрока(Контент) Тогда
		Контент = Неопределено;
	КонецЕсли;
	Сообщение.Вставить("Контент", Контент);
	
	РассужденияЗаписи = Выборка.Рассуждения;
	Если ЗначениеЗаполнено(РассужденияЗаписи) Тогда
		Сообщение.Вставить("Рассуждения", РассужденияЗаписи);
	КонецЕсли;
	
	ДатаЗаписи = Выборка.ДатаЗаписи;
	Если ЗначениеЗаполнено(ДатаЗаписи) Тогда
		Сообщение.Вставить("Время", Формат(ДатаЗаписи, "ДЛФ=DT"));
	Иначе
		Сообщение.Вставить("Время", "");
	КонецЕсли;

	СсылкиДокументовИзЗаписи = СсылкиДокументовИзМетаданных(Выборка.МетаданныеСообщения);
	Если СсылкиДокументовИзЗаписи <> Неопределено Тогда
		Сообщение.Вставить("СсылкиДокументов", СсылкиДокументовИзЗаписи);
	КонецЕсли;

	ДиаграммыИзЗаписи = ДиаграммыИзМетаданных(Выборка.МетаданныеСообщения);
	Если ДиаграммыИзЗаписи <> Неопределено Тогда
		Сообщение.Вставить("Диаграмма", ДиаграммыИзЗаписи);
	КонецЕсли;
	
	Если РольСтрока = "assistant" И НЕ ПустаяСтрока(Выборка.ВызовыИнструментовJSON) Тогда
		ВызовыСРусскимиКлючами = ДесериализоватьВызовыИнструментов(Выборка.ВызовыИнструментовJSON);
		Если ВызовыСРусскимиКлючами <> Неопределено Тогда
			Сообщение.Вставить("ВызовыИнструментов", ВызовыСРусскимиКлючами);
		КонецЕсли;
	КонецЕсли;
	
	Если РольСтрока = "tool" Тогда
		Если НЕ ПустаяСтрока(Выборка.ИдВызоваИнструмента) Тогда
			Сообщение.Вставить("ИдВызоваИнструмента", Выборка.ИдВызоваИнструмента);
		КонецЕсли;
		Если НЕ ПустаяСтрока(Выборка.ИмяИнструмента) Тогда
			Сообщение.Вставить("ИмяИнструмента", Выборка.ИмяИнструмента);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Сообщение;
КонецФункции

// Сериализует tool_calls сообщения (русские ключи → OpenAI JSON) в строку JSON.
// Пустой результат - пустая строка.
//
// Защита (ТЗ v2): вызовы с пустым именем функции отбрасываются - НЕ попадают
// ни в JSON, ни в регистр. Корневая причина порчи: десериализация возвращает
// вложенный РУССКИЙ формат {Ид, Тип, Функция:{Имя, Аргументы}}, а сериализация
// не читала ключ "Функция" - имена терялись при каждом раунд-трипе
// чтение→сжатие→запись (кнопка «Сжать контент»).
Функция СериализоватьВызовыИнструментов(Сообщение)
	ВызовыИнструментов = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ВызовыИнструментов", Неопределено);
	Если ВызовыИнструментов = Неопределено ИЛИ ТипЗнч(ВызовыИнструментов) <> Тип("Массив")
		ИЛИ ВызовыИнструментов.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	МассивAPI = Новый Массив;
	Индекс = 0;
	ПропущеноПустыхИмен = 0;
	Для Каждого Вызов Из ВызовыИнструментов Цикл
		Элемент = Новый Соответствие;
		ИдВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Ид", "");
		Если ПустаяСтрока(ИдВызова) Тогда
			ИдВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "id", "call_" + Строка(Индекс));
		КонецЕсли;
		Элемент.Вставить("id", ИдВызова);
		Элемент.Вставить("type", "function");
		
		ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Имя", "");
		Если ПустаяСтрока(ИмяФункции) Тогда
			ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "name", "");
		КонецЕсли;
		Если ПустаяСтрока(ИмяФункции) Тогда
			ИзвлеченнаяФункция = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "function", Неопределено);
			Если ИзвлеченнаяФункция = Неопределено Тогда
				ИзвлеченнаяФункция = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Функция", Неопределено);
			КонецЕсли;
			Если ИзвлеченнаяФункция <> Неопределено Тогда
				ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(ИзвлеченнаяФункция, "name", "");
				Если ПустаяСтрока(ИмяФункции) Тогда
					ИмяФункции = СИ_РаботаСJSON.БезопасноПолучить(ИзвлеченнаяФункция, "Имя", "");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(ИмяФункции) <> Тип("Строка") ИЛИ ПустаяСтрока(ИмяФункции) Тогда
			ПропущеноПустыхИмен = ПропущеноПустыхИмен + 1;
			Продолжить;
		КонецЕсли;
		
		Аргументы = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Аргументы", Неопределено);
		Если Аргументы = Неопределено Тогда
			ИзвлеченнаяФункция = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "function", Неопределено);
			Если ИзвлеченнаяФункция = Неопределено Тогда
				ИзвлеченнаяФункция = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Функция", Неопределено);
			КонецЕсли;
			Если ИзвлеченнаяФункция <> Неопределено Тогда
				Аргументы = СИ_РаботаСJSON.БезопасноПолучить(ИзвлеченнаяФункция, "arguments", Неопределено);
				Если Аргументы = Неопределено Тогда
					Аргументы = СИ_РаботаСJSON.БезопасноПолучить(ИзвлеченнаяФункция, "Аргументы", Неопределено);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		АргументыJSON = "";
		Если Аргументы <> Неопределено Тогда
			Если ТипЗнч(Аргументы) = Тип("Соответствие") ИЛИ ТипЗнч(Аргументы) = Тип("Структура") Тогда
				АргументыJSON = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Аргументы);
			ИначеЕсли ТипЗнч(Аргументы) = Тип("Строка") Тогда
				АргументыJSON = Аргументы;
			КонецЕсли;
		КонецЕсли;
		
		ФункцияОбъект = Новый Соответствие;
		ФункцияОбъект.Вставить("name", ИмяФункции);
		ФункцияОбъект.Вставить("arguments", АргументыJSON);
		Элемент.Вставить("function", ФункцияОбъект);
		
		МассивAPI.Добавить(Элемент);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Если ПропущеноПустыхИмен > 0 Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ПропущенВызовИнструмента",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"При сериализации tool_calls пропущено вызовов с пустым именем функции: "
			+ Строка(ПропущеноПустыхИмен));
	КонецЕсли;
	
	Если МассивAPI.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СИ_РаботаСJSON.ЗаписатьСтрокуJSON(МассивAPI);
КонецФункции

// Десериализует JSON tool_calls (OpenAI-формат) в массив структур с русскими ключами.
// Возвращает Неопределено, если JSON пуст или не является массивом.
Функция ДесериализоватьВызовыИнструментов(ВызовыИнструментовJSON)
	Если ПустаяСтрока(ВызовыИнструментовJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВызовыJSON2 = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ВызовыИнструментовJSON);
	Если ВызовыJSON2 = Неопределено ИЛИ ТипЗнч(ВызовыJSON2) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВызовыСРусскимиКлючами = Новый Массив;
	Для Каждого ВызовИтератор Из ВызовыJSON2 Цикл
		РусскийВызов = Новый Структура;
		РусскийВызов.Вставить("Ид", СИ_РаботаСJSON.БезопасноПолучить(ВызовИтератор, "id", ""));
		РусскийВызов.Вставить("Тип", СИ_РаботаСJSON.БезопасноПолучить(ВызовИтератор, "type", "function"));
		
		ИзвлеченнаяФункция = СИ_РаботаСJSON.БезопасноПолучить(ВызовИтератор, "function", Неопределено);
		Если ИзвлеченнаяФункция <> Неопределено Тогда
			ИмяФункцииИнструмента = СИ_РаботаСJSON.БезопасноПолучить(ИзвлеченнаяФункция, "name", "");
			АргументыФункции = СИ_РаботаСJSON.БезопасноПолучить(ИзвлеченнаяФункция, "arguments", "");
			
			НоваяФункция = Новый Структура;
			НоваяФункция.Вставить("Имя", ИмяФункцииИнструмента);
			НоваяФункция.Вставить("Аргументы", АргументыФункции);
			РусскийВызов.Вставить("Функция", НоваяФункция);
		КонецЕсли;
		
		ВызовыСРусскимиКлючами.Добавить(РусскийВызов);
	КонецЦикла;
	
	Возврат ВызовыСРусскимиКлючами;
КонецФункции

// Заполняет запись набора регистра СИ_СообщенияДиалога из структуры сообщения.
// Используется при пакетной записи в ЗаменитьИсториюДиалога (одна транзакция)
// и при сбросе буфера (СброситьБуферСообщений).
//
// ДатаЗаписи берётся из самого сообщения (ключ «Время», проставленный в
// ДобавитьСообщениеВБуфер), а не из ТекущаяДатаСеанса(). Иначе все сообщения
// одного хода получали бы секунду пакетной записи в конце хода, а чат до этого
// момента показывал время появления сообщения - при перечитке даты в пузырях
// менялись. Для сообщений без отметки времени (истории, загруженной извне)
// остаётся прежнее поведение - текущее время сеанса.
Процедура ЗаполнитьЗаписьСообщения(Запись, ИдДиалога, Сообщение, НомерСообщения)
	Роль = ПолучитьРольСообщения(Сообщение);
	РольСсылка = РольСсылкаПоСтроке(Роль);

	Запись.ИдДиалога = ИдДиалога;
	Запись.НомерСообщения = НомерСообщения;
	Запись.Роль = РольСсылка;
	Запись.Контент = ПолучитьКонтентСообщения(Сообщение);
	Запись.ВызовыИнструментовJSON = СериализоватьВызовыИнструментов(Сообщение);
	Запись.ИдВызоваИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИдВызоваИнструмента", "");
	Запись.ИмяИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "ИмяИнструмента", "");
	Запись.Рассуждения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Рассуждения", "");
	Запись.МетаданныеСообщения = ХранилищеСсылокДокументов(Сообщение);

	ВремяСообщения = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Время", Неопределено);
	Если НЕ ЗначениеЗаполнено(ВремяСообщения) Тогда
		ВремяСообщения = ТекущаяДатаСеанса();
	КонецЕсли;
	Запись.ДатаЗаписи = ВремяСообщения;
КонецПроцедуры

// Хранилище служебных метаданных сообщения для ресурса МетаданныеСообщения
// регистра. Сейчас это:
//  - карта навигационных ссылок на объекты 1С (СсылкиДокументов), по которой
//    рендер чата делает упоминания объектов кликабельными;
//  - карточки диаграмм (Диаграмма) ответа ассистента - для инлайн-отрисовки
//    в чате и сохранения карточки между перечитками истории.
//
// Формат значения:
//  - Массив - ТОЛЬКО карта ссылок (старый формат, обратная совместимость);
//  - Структура {Ссылки, Диаграмма} - когда есть диаграммы.
// Разбор - МетаданныеСообщенияРазобрать.
//
// Параметры:
//  Сообщение - Структура - сообщение в формате ядра (ключа может не быть).
//
// Возвращаемое значение:
//  ХранилищеЗначения,Неопределено - значение для ресурса; Неопределено, если
//  служебных данных у сообщения нет (ресурс остаётся пустым).
Функция ХранилищеСсылокДокументов(Сообщение)

	СсылкиДокументов = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "СсылкиДокументов", Неопределено);
	Если ТипЗнч(СсылкиДокументов) <> Тип("Массив") Тогда
		СсылкиДокументов = Новый Массив;
	КонецЕсли;

	Диаграмма = СИ_РаботаСJSON.БезопасноПолучить(Сообщение, "Диаграмма", Неопределено);
	Если ТипЗнч(Диаграмма) = Тип("Структура") Тогда
		МассивКарточек = Новый Массив;
		МассивКарточек.Добавить(Диаграмма);
		Диаграмма = МассивКарточек;
	КонецЕсли;
	Если ТипЗнч(Диаграмма) <> Тип("Массив") ИЛИ Диаграмма.Количество() = 0 Тогда
		Диаграмма = Неопределено;
	КонецЕсли;

	Если Диаграмма = Неопределено Тогда
		Если СсылкиДокументов.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый ХранилищеЗначения(СсылкиДокументов);
	КонецЕсли;

	СлужебныеМетаданные = Новый Структура;
	СлужебныеМетаданные.Вставить("Ссылки", СсылкиДокументов);
	СлужебныеМетаданные.Вставить("Диаграмма", Диаграмма);

	Возврат Новый ХранилищеЗначения(СлужебныеМетаданные);

КонецФункции

// Разбирает ресурс МетаданныеСообщения в структуру {Ссылки, Диаграмма}.
// Поддерживает оба формата: массив (только ссылки, старый формат) и структуру.
// Разбор защищён Попытка: испорченное хранилище не должно ломать чтение истории.
//
// Параметры:
//  ХранилищеИзЗаписи - ХранилищеЗначения,Null,Неопределено - ресурс записи.
//
// Возвращаемое значение:
//  Структура,Неопределено:
//    * Ссылки - Массив из Структура - карта ссылок (может быть пустой);
//    * Диаграмма - Массив из Структура,Неопределено - карточки диаграмм.
Функция МетаданныеСообщенияРазобрать(ХранилищеИзЗаписи)

	Если НЕ ЗначениеЗаполнено(ХранилищеИзЗаписи) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЗначениеМетаданных = ХранилищеИзЗаписи.Получить();
	Исключение
		ЗаписатьВЖурнал("МетаданныеСообщенияРазобрать", УровеньЖурналаРегистрации.Предупреждение,
			"Не удалось прочитать метаданные сообщения: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("Ссылки", Новый Массив);
	Результат.Вставить("Диаграмма", Неопределено);

	Если ТипЗнч(ЗначениеМетаданных) = Тип("Массив") Тогда
		Если ЗначениеМетаданных.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат.Ссылки = ЗначениеМетаданных;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ЗначениеМетаданных) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылки = СИ_РаботаСJSON.БезопасноПолучить(ЗначениеМетаданных, "Ссылки", Неопределено);
	Если ТипЗнч(Ссылки) = Тип("Массив") Тогда
		Результат.Ссылки = Ссылки;
	КонецЕсли;

	Диаграмма = СИ_РаботаСJSON.БезопасноПолучить(ЗначениеМетаданных, "Диаграмма", Неопределено);
	Если ТипЗнч(Диаграмма) = Тип("Массив") И Диаграмма.Количество() > 0 Тогда
		Результат.Диаграмма = Диаграмма;
	КонецЕсли;

	Если Результат.Ссылки.Количество() = 0 И Результат.Диаграмма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Карта навигационных ссылок из ресурса МетаданныеСообщения записи регистра.
// Разбор защищён (см. МетаданныеСообщенияРазобрать): испорченное хранилище не
// должно ломать чтение истории - сообщение отрисуется без ссылок.
//
// Параметры:
//  ХранилищеИзЗаписи - ХранилищеЗначения,Null,Неопределено - ресурс записи.
//
// Возвращаемое значение:
//  Массив,Неопределено - карта ссылок (Упоминание, Адрес) либо Неопределено,
//  если метаданных нет или они нечитаемы.
Функция СсылкиДокументовИзМетаданных(ХранилищеИзЗаписи)

	РазобранныеМетаданные = МетаданныеСообщенияРазобрать(ХранилищеИзЗаписи);
	Если РазобранныеМетаданные = Неопределено ИЛИ РазобранныеМетаданные.Ссылки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РазобранныеМетаданные.Ссылки;

КонецФункции

// Карточки диаграмм из ресурса МетаданныеСообщения записи регистра.
//
// Параметры:
//  ХранилищеИзЗаписи - ХранилищеЗначения,Null,Неопределено - ресурс записи.
//
// Возвращаемое значение:
//  Массив,Неопределено - карточки диаграмм либо Неопределено, если их нет.
Функция ДиаграммыИзМетаданных(ХранилищеИзЗаписи)

	РазобранныеМетаданные = МетаданныеСообщенияРазобрать(ХранилищеИзЗаписи);
	Если РазобранныеМетаданные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РазобранныеМетаданные.Диаграмма;

КонецФункции

// Единая запись в журнал регистрации с общим префиксом события.
Процедура ЗаписатьВЖурнал(Подсобытие, Уровень, Комментарий)
	ЗаписьЖурналаРегистрации("Агент1С.УправлениеДиалогом." + Подсобытие, Уровень,,, Комментарий);
КонецПроцедуры

// Накладывает исключительную управляемую блокировку на элемент справочника диалогов.
// Вызывается внутри транзакции и ДО чтения объекта: только в таком порядке блокировка
// защищает запись, а не просто детектирует уже совершённую другим сеансом.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
Процедура ИсключительнаяБлокировкаДиалога(ИдДиалога)
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.СИ_ДиалогиАгента");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ИдДиалога);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Применяет значения реквизитов к объекту диалога. Доступ к реквизитам по имени
// платформа не поддерживает, поэтому соответствие «ключ структуры - реквизит» задано явно.
//
// Параметры:
//  ОбъектДиалога - СправочникОбъект.СИ_ДиалогиАгента - записываемый объект.
//  Значения - Структура - изменяемые реквизиты (см. ЗаписатьРеквизитыДиалога).
//  НеПонижатьСтатус - Булево - не записывать Статус = Активен, если текущий статус
//   выставлен ядром или заход уже завершён.
Процедура ПрименитьЗначенияРеквизитов(ОбъектДиалога, Значения, НеПонижатьСтатус = Ложь)
	
	Если Значения.Свойство("АктивноеЗаданиеИд") Тогда
		ОбъектДиалога.АктивноеЗаданиеИд = Строка(Значения.АктивноеЗаданиеИд);
	КонецЕсли;
	
	Если Значения.Свойство("Статус") Тогда
		ПонижатьСтатус = НЕ (НеПонижатьСтатус
			И Значения.Статус = Перечисления.СИ_СтатусыДиалога.Активен
			И СтатусУстановленЯдром(ОбъектДиалога.Статус));
		Если ПонижатьСтатус Тогда
			ОбъектДиалога.Статус = Значения.Статус;
		КонецЕсли;
	КонецЕсли;
	
	Если Значения.Свойство("ПрибавитьТокенов") Тогда
		ОбъектДиалога.ПотраченоТокенов = ОбъектДиалога.ПотраченоТокенов + Число(Значения.ПрибавитьТокенов);
	КонецЕсли;
	Если Значения.Свойство("ИсторияТокенов") Тогда
		ОбъектДиалога.ИсторияТокенов = Значения.ИсторияТокенов;
	КонецЕсли;
	Если Значения.Свойство("ЛимитТокенов") Тогда
		ОбъектДиалога.ЛимитТокенов = Значения.ЛимитТокенов;
	КонецЕсли;
	Если Значения.Свойство("ЛимитТокеновЕслиНеЗаполнен") Тогда
		Если ОбъектДиалога.ЛимитТокенов = 0 Тогда
			ОбъектДиалога.ЛимитТокенов = Значения.ЛимитТокеновЕслиНеЗаполнен;
		КонецЕсли;
	КонецЕсли;
	Если Значения.Свойство("ОшибкаЗавершения") Тогда
		ОбъектДиалога.ОшибкаЗавершения = Лев(Строка(Значения.ОшибкаЗавершения), 150);
	КонецЕсли;
	Если Значения.Свойство("Наименование") Тогда
		ОбъектДиалога.Наименование = Значения.Наименование;
	КонецЕсли;
	Если Значения.Свойство("СводкаДиалога") Тогда
		ОбъектДиалога.СводкаДиалога = Значения.СводкаДиалога;
	КонецЕсли;
	Если Значения.Свойство("Режим") Тогда
		ОбъектДиалога.Режим = Значения.Режим;
	КонецЕсли;
	Если Значения.Свойство("Модель") Тогда
		ОбъектДиалога.Модель = Значения.Модель;
	КонецЕсли;
	Если Значения.Свойство("ПрофильПодключения") Тогда
		ОбъектДиалога.ПрофильПодключения = Значения.ПрофильПодключения;
	КонецЕсли;
	Если Значения.Свойство("СистемныйПромпт") Тогда
		ОбъектДиалога.СистемныйПромпт = Значения.СистемныйПромпт;
	КонецЕсли;
	Если Значения.Свойство("СистемныйПромптСтрока") Тогда
		ОбъектДиалога.СистемныйПромптСтрока = Значения.СистемныйПромптСтрока;
	КонецЕсли;
	Если Значения.Свойство("ПометкаУдаления") Тогда
		ОбъектДиалога.УстановитьПометкуУдаления(Значения.ПометкаУдаления = Истина);
	КонецЕсли;
	
КонецПроцедуры

// Допустима ли запись реквизита АктивноеЗаданиеИд: записан пустой ИД (хозяина нет),
// тот же ИД (идемпотентно) либо ИД мёртвого задания (мусор после аварии сеанса).
// Чужой живой заход не перезаписывается и не очищается - иначе поздняя финализация
// старого захода стирает ИД захода, возобновлённого из карточки запроса разрешения.
//
// Параметры:
//  ЗаписанныйИд - Строка - текущее значение реквизита АктивноеЗаданиеИд.
//  ТребуемыйИд - Строка - ИД захода, которым оперирует вызывающий код; при очистке
//   без ожидания конкретного ИД - пустая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если запись допустима.
Функция АктивноеЗаданиеИдДопустимДляЗаписи(ЗаписанныйИд, ТребуемыйИд)
	
	ЗаписанныйИд = Строка(ЗаписанныйИд);
	ТребуемыйИд = Строка(ТребуемыйИд);
	
	Если ПустаяСтрока(ЗаписанныйИд) Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЗаписанныйИд = ТребуемыйИд Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат НЕ ЖивоЛиЗадание(ЗаписанныйИд);
	
КонецФункции

// Копия структуры без указанного ключа. Нужна, когда запись выполняется, но один
// реквизит менять нельзя (правило владения активным заходом).
//
// Параметры:
//  Значения - Структура - исходные значения реквизитов.
//  Ключ - Строка - исключаемый ключ.
//
// Возвращаемое значение:
//  Структура - копия без указанного ключа.
Функция СкопироватьБезКлюча(Значения, Ключ)
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Значения Цикл
		Если КлючИЗначение.Ключ <> Ключ Тогда
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Выставлен ли статус ядром агента (запрос разрешения) или заход уже завершён.
// Запись формы «Активен» не должна понижать такой статус.
//
// Параметры:
//  Статус - ПеречислениеСсылка.СИ_СтатусыДиалога - текущий статус диалога.
//
// Возвращаемое значение:
//  Булево - Истина, если статус нельзя понижать до «Активен».
Функция СтатусУстановленЯдром(Статус)
	
	Возврат Статус = Перечисления.СИ_СтатусыДиалога.ОжидаетРазрешения
		ИЛИ Статус = Перечисления.СИ_СтатусыДиалога.Завершён
		ИЛИ Статус = Перечисления.СИ_СтатусыДиалога.ПрерванОшибкой
		ИЛИ Статус = Перечисления.СИ_СтатусыДиалога.ПревышенЛимит;
	
КонецФункции

// ИД текущего фонового задания или пустая строка вне фонового задания. Нужен фоновому
// заданию, чтобы при финальной записи очистить АктивноеЗаданиеИд только своего захода:
// без этой проверки финал старого захода затирает ИД захода, возобновлённого после
// запроса разрешения.
//
// Возвращаемое значение:
//  Строка - уникальный идентификатор текущего фонового задания; пустая строка - сеанс
//   не является фоновым заданием либо идентификатор недоступен.
Функция ИдТекущегоФоновогоЗадания() Экспорт
	
	Попытка
		СеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
		Если СеансИнформационнойБазы = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		ФоновоеЗадание = СеансИнформационнойБазы.ПолучитьФоновоеЗадание();
		Если ФоновоеЗадание = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(ФоновоеЗадание.УникальныйИдентификатор);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Активная пауза между попытками записи.
//
// ВАЖНО: платформенный метод паузы не используется - в фоновых заданиях (clientlessMode,
// в том числе встроенный сервер ibsrv файловой ИБ) он не реализован и валит задание
// фатальной ошибкой ядра, которая не перехватывается Попыткой/Исключением в BSL.
// Приём тот же, что в СИ_Агент1С.ПаузаНаСервере.
//
// Параметры:
//  Миллисекунд - Число - длительность паузы; значения <= 0 игнорируются.
Процедура ВыдержатьПаузуМс(Миллисекунд)
	
	Если Миллисекунд <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	МоментОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунд;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментОкончания Цикл
	КонецЦикла;
	
КонецПроцедуры

// Применяет режим работы к существующему диалогу при смене режима «на лету»:
//   1. Перезаписывает первое system-сообщение истории промптом нового режима
//      (контент собирается как промпт режима + общие дополнения из СИ_Промпты -
//      тот же состав, что и при первичной вставке system-сообщения агентом).
//   2. Обновляет реквизиты диалога: Режим, Модель, ПрофильПодключения,
//      СистемныйПромпт (хранилище) и СистемныйПромптСтрока (превью).
// История user/assistant/tool-сообщений не затрагивается - меняется только
// «личность» агента. Безопасно вызывать повторно с тем же режимом (идемпотентно).
//
// Параметры:
//  ИдДиалога   - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  РежимСсылка - СправочникСсылка.СИ_РежимиРаботы - новый режим.
//
// Возвращаемое значение:
//  Булево - Истина, если system-сообщение и/или реквизиты диалога обновлены.
Функция ПрименитьРежимКДиалогу(ИдДиалога, РежимСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдДиалога) ИЛИ НЕ ЗначениеЗаполнено(РежимСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РежимСсылка,
			"СистемныйПромпт, Модель, Профиль");
	Исключение
		ЗаписатьВЖурнал("ПрименитьРежимКДиалогу", УровеньЖурналаРегистрации.Предупреждение,
			"Ошибка чтения реквизитов режима: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	НовыйПромпт = ЗначенияРеквизитов.СистемныйПромпт;
	Дополнения = СИ_Промпты.ДополненияСистемногоПромпта();
	Если НЕ ПустаяСтрока(Дополнения) Тогда
		Если ПустаяСтрока(НовыйПромпт) Тогда
			НовыйПромпт = Дополнения;
		Иначе
			НовыйПромпт = НовыйПромпт + Символы.ПС + Символы.ПС + Дополнения;
		КонецЕсли;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ИсключительнаяБлокировкаДиалога(ИдДиалога);
		
		ДиалогОбъект = ИдДиалога.ПолучитьОбъект();
		Если ДиалогОбъект = Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
		
		Обновлено = ОбновитьПервуюСистемнуюЗапись(ИдДиалога, НовыйПромпт);
		
		ДиалогОбъект.Режим = РежимСсылка;
		Если НЕ ПустаяСтрока(ЗначенияРеквизитов.Модель) Тогда
			ДиалогОбъект.Модель = ЗначенияРеквизитов.Модель;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.Профиль) Тогда
			ДиалогОбъект.ПрофильПодключения = ЗначенияРеквизитов.Профиль;
		КонецЕсли;
		ДиалогОбъект.СистемныйПромпт = Новый ХранилищеЗначения(НовыйПромпт);
		ДиалогОбъект.СистемныйПромптСтрока = Лев(НовыйПромпт, 255);
		ДиалогОбъект.Записать();
		Обновлено = Истина;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписатьВЖурнал("ПрименитьРежимКДиалогу", УровеньЖурналаРегистрации.Ошибка,
			"Ошибка применения режима к диалогу (транзакция отменена): "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Обновлено;
	
КонецФункции

// Перезаписывает Контент первой (с минимальным НомерСообщения) system-записи
// регистра СИ_СообщенияДиалога.
//
// ВАЖНО: полная замена Контента безопасна, потому что в эту запись никогда не
// входят динамические блоки:
//   - блок памяти диалога подмешивается только в копию истории при сборке
//     запроса (ПодмешатьПамятьВИсторию), регистр не меняет;
//   - сводка сжатия пишется ОТДЕЛЬНЫМ вторым system-сообщением (см. СжатьИсторию).
//
// Параметры:
//  ИдДиалога    - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  НовыйКонтент - Строка - новый текст system-сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если запись найдена и обновлена. Ложь - если system-сообщения
//  ещё нет (агент вставит его при следующем запуске стандартным механизмом).
Функция ОбновитьПервуюСистемнуюЗапись(ИдДиалога, НовыйКонтент)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сообщения.НомерСообщения КАК НомерСообщения
		|ИЗ
		|	РегистрСведений.СИ_СообщенияДиалога КАК Сообщения
		|ГДЕ
		|	Сообщения.ИдДиалога = &ИдДиалога
		|	И Сообщения.Роль = ЗНАЧЕНИЕ(Перечисление.СИ_РолиСообщений.System)
		|УПОРЯДОЧИТЬ ПО
		|	Сообщения.НомерСообщения";
	Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.СИ_СообщенияДиалога.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдДиалога.Установить(ИдДиалога);
	НаборЗаписей.Отбор.НомерСообщения.Установить(Выборка.НомерСообщения);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запись = НаборЗаписей[0];
	Запись.Контент = НовыйКонтент;
	Запись.ДатаЗаписи = ТекущаяДатаСеанса();
	НаборЗаписей.Записать();
	
	Возврат Истина;
	
КонецФункции

// Дописывает токены аварийно завершённого захода в справочник диалога.
// Вызывается формой при «спасении» пакета ВХ (См. СпаситьБуферИзВХ формы
// СИ_ЧатАгента): штатная запись токенов в конце ФЗ при аварии не выполнена.
// Работа с объектом диалога инкапсулирована здесь (единый слой доступа):
// обработчики ПередЗаписью/ПриЗаписи справочника отрабатывают штатно.
//
// Параметры:
//  Диалог - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог.
//  ТокеныЗаЗаход - Число - израсходованные токены захода (дописываются к ПотраченоТокенов).
//  ПромптТокеныПоследнейИтерации - Число - размер контекста последнего вызова
//   (записывается в ИсторияТокенов; 0 не затирает существующее значение).
Процедура ДописатьТокеныПриСпасении(Диалог, ТокеныЗаЗаход, ПромптТокеныПоследнейИтерации) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Диалог) Тогда
		Возврат;
	КонецЕсли;
	
	Значения = Новый Структура;
	Значения.Вставить("ПрибавитьТокенов", ТокеныЗаЗаход);
	Если ПромптТокеныПоследнейИтерации > 0 Тогда
		Значения.Вставить("ИсторияТокенов", ПромптТокеныПоследнейИтерации);
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("ИмяОперации", "ДописатьТокеныПриСпасении");

	ЗаписатьРеквизитыДиалога(Диалог, Значения, Параметры);
	
КонецПроцедуры

// Фиксирует транзакцию очистки диалога. Обёртка держит точку завершения
// транзакции в одном месте, чтобы тело очистки не зависело от способа фиксации.
Процедура ЗавершитьТранзакциюОчистки()

	ЗафиксироватьТранзакцию();

КонецПроцедуры

#КонецОбласти
