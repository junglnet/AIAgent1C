// Обрезает ПОДГОТОВЛЕННЫЙ HTML (уже экранированный, с готовыми тегами) до
// Лимит символов, не оставляя в хвосте обрезанного тега или незавершённой
// HTML-сущности: неполная конструкция отбрасывается целиком (вплоть до
// начала inline-SVG эмодзи, если рез пришёлся внутрь него). Служебная
// функция (вне области программного интерфейса), используется при ужимании
// рассуждений в живом индикаторе.
//
// Параметры:
//  ПодготовленныйHTML - Строка - HTML после ЭкранироватьHTML/ЗаменитьЭмодзиВТексте;
//  Лимит              - Число  - максимальная длина результата.
//
// Возвращаемое значение:
//  Строка - HTML длиной не более Лимит, оканчивающийся полной конструкцией.
Функция ОбрезатьHTMLХвост(Знач ПодготовленныйHTML, Знач Лимит)

	Обрезка = Лев(ПодготовленныйHTML, Лимит);

	ПозицияОткрытия = СтрНайти(Обрезка, "<", НаправлениеПоиска.СКонца);
	ПозицияЗакрытия = СтрНайти(Обрезка, ">", НаправлениеПоиска.СКонца);
	Если ПозицияОткрытия > ПозицияЗакрытия Тогда
		Обрезка = Лев(Обрезка, ПозицияОткрытия - 1);
	КонецЕсли;

	ПозицияАмперсанда = СтрНайти(Обрезка, "&", НаправлениеПоиска.СКонца);
	ПозицияТочкиСЗапятой = СтрНайти(Обрезка, ";", НаправлениеПоиска.СКонца);
	Если ПозицияАмперсанда > ПозицияТочкиСЗапятой Тогда
		Обрезка = Лев(Обрезка, ПозицияАмперсанда - 1);
	КонецЕсли;

	Возврат Обрезка;

КонецФункции
#КонецОбласти
