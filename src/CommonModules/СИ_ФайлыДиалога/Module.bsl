#Область ПрограммныйИнтерфейс

// Создаёт текстовый файл в диалоге.
//
// Параметры:
//  Аргументы - Структура - параметры вызова инструмента:
//    * ИдДиалога  - СправочникСсылка.СИ_ДиалогиАгента - диалог (пробрасывается движком).
//    * ИмяФайла   - Строка - имя файла с расширением, например "отчет.txt".
//    * Содержимое - Строка - текстовое содержимое.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - признак успешного выполнения.
//    * Значение - Структура,Неопределено - описание созданного файла
//      (Неопределено при ошибке валидации):
//      ** Ссылка   - Строка - UUID файла.
//      ** ИмяФайла - Строка - итоговое имя файла.
//      ** Размер   - Число - размер содержимого в символах.
//    * Ошибка - Строка,Неопределено - описание ошибки при Успех = Ложь.
Функция СоздатьФайлВДиалоге(Аргументы) Экспорт

	Результат = НовыйРезультатИнструмента();
	ПодготовленныеДанные = Неопределено;

	ВключитьПривилегированныйРежим();
	Попытка
		ПодготовленныеДанные = ПодготовитьДвоичныеДанныеТекстовогоФайла(Аргументы, Результат);
		Если ПодготовленныеДанные = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		СсылкаФайла = СохранитьДвоичныеДанныеВДиалог(
			ПодготовленныеДанные.ИдДиалога, ПодготовленныеДанные.ИмяФайла,
			ПодготовленныеДанные.ДвоичныеДанные, "Создан моделью ИИ в диалоге");

		Результат.Успех = Истина;
		Результат.Значение = Новый Структура(
			"Ссылка, ИмяФайла, Размер",
			Строка(СсылкаФайла.УникальныйИдентификатор()), ПодготовленныеДанные.ИмяФайла,
			СтрДлина(ПодготовленныеДанные.Содержимое));
	Исключение
		Результат.Ошибка = "Ошибка создания файла: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.СоздатьФайлВДиалоге", УровеньЖурналаРегистрации.Ошибка, ,
			Строка(ПодготовленныеДанные.ИдДиалога), "Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	ВыключитьПривилегированныйРежим();

	Возврат Результат;

КонецФункции

// Обновляет (перезаписывает) содержимое существующего текстового файла диалога.
// Контракт инструмента UpdateDialogFile. Если файла с таким именем нет — создаёт его.
//
// Параметры:
//  Аргументы - Структура - параметры вызова инструмента:
//    * ИдДиалога  - СправочникСсылка.СИ_ДиалогиАгента - диалог (пробрасывается движком).
//    * ИмяФайла   - Строка - имя файла с расширением (например "отчет.txt").
//    * Содержимое - Строка - новое текстовое содержимое (полностью заменяет старое).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - признак успешного выполнения.
//    * Значение - Структура,Неопределено - описание файла:
//      ** Ссылка   - Строка - UUID файла.
//      ** ИмяФайла - Строка - имя файла.
//      ** Обновлен - Булево - Истина, если файл существовал и обновлён; Ложь, если создан.
//    * Ошибка - Строка,Неопределено - описание ошибки при Успех = Ложь.
Функция ОбновитьФайлДиалога(Аргументы) Экспорт

	Результат = НовыйРезультатИнструмента();
	ПодготовленныеДанные = Неопределено;

	ВключитьПривилегированныйРежим();
	Попытка
		ПодготовленныеДанные = ПодготовитьДвоичныеДанныеТекстовогоФайла(Аргументы, Результат);
		Если ПодготовленныеДанные = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		СуществующийФайл = НайтиФайлДиалога(ПодготовленныеДанные.ИдДиалога, ПодготовленныеДанные.ИмяФайла);
		Обновлен = Ложь;
		Если ЗначениеЗаполнено(СуществующийФайл) Тогда
			АдресФайла = ПоместитьВоВременноеХранилище(ПодготовленныеДанные.ДвоичныеДанные, Новый УникальныйИдентификатор);
			ИнформацияОФайле = Новый Структура;
			ИнформацияОФайле.Вставить("АдресФайлаВоВременномХранилище", АдресФайла);
			ИнформацияОФайле.Вставить("АдресВременногоХранилищаТекста", "");
			ИнформацияОФайле.Вставить("ДатаМодификацииУниверсальная", ТекущаяУниверсальнаяДата());
			РаботаСФайлами.ОбновитьФайл(СуществующийФайл, ИнформацияОФайле);
			СсылкаФайла = СуществующийФайл;
			Обновлен = Истина;
		Иначе
			СсылкаФайла = СохранитьДвоичныеДанныеВДиалог(
				ПодготовленныеДанные.ИдДиалога, ПодготовленныеДанные.ИмяФайла,
				ПодготовленныеДанные.ДвоичныеДанные, "Создан моделью ИИ в диалоге");
		КонецЕсли;

		Результат.Успех = Истина;
		Результат.Значение = Новый Структура(
			"Ссылка, ИмяФайла, Обновлен",
			Строка(СсылкаФайла.УникальныйИдентификатор()), ПодготовленныеДанные.ИмяФайла, Обновлен);
	Исключение
		Результат.Ошибка = "Ошибка обновления файла: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.ОбновитьФайлДиалога", УровеньЖурналаРегистрации.Ошибка, ,
			Строка(ПодготовленныеДанные.ИдДиалога), "Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	ВыключитьПривилегированныйРежим();

	Возврат Результат;

КонецФункции

// Читает содержимое файла диалога.
//
// Параметры:
//  Аргументы - Структура - параметры вызова инструмента:
//    * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//    * ИмяФайла  - Строка - имя файла (можно с расширением).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - признак успешного выполнения.
//    * Значение - Структура,Неопределено - содержимое файла
//      (Неопределено, если чтение не выполнено):
//      ** ИмяФайла   - Строка - имя файла.
//      ** Содержимое - Строка - содержимое файла. Для бинарных файлов возвращается строка
//                              "[Бинарный файл. Текстовое содержимое недоступно.]".
//      ** Обрезано   - Булево - Истина, если текстовое содержимое превышает 200000 символов и было обрезано.
//    * Ошибка - Строка,Неопределено - описание ошибки при Успех = Ложь.
Функция ПрочитатьФайлДиалога(Аргументы) Экспорт

	Результат = НовыйРезультатИнструмента();
	ИдДиалога = Неопределено;

	ВключитьПривилегированныйРежим();
	Попытка
		ИдДиалога = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИдДиалога", Неопределено);
		ИмяФайла  = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИмяФайла", ""));

		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Результат.Ошибка = "Не передан идентификатор диалога.";
			Возврат Результат;
		КонецЕсли;
		Если ПустаяСтрока(ИмяФайла) Тогда
			Результат.Ошибка = "Не указано имя файла.";
			Возврат Результат;
		КонецЕсли;

		СсылкаФайла = НайтиФайлДиалога(ИдДиалога, ИмяФайла);
		Если СсылкаФайла = Неопределено Тогда
			Результат.Ошибка = "Файл не найден в диалоге: " + ИмяФайла
				+ ". Доступные файлы можно получить инструментом ListDialogFiles.";
			Возврат Результат;
		КонецЕсли;

		ИмяФайла = ПолучитьИмяФайлаИзСсылки(СсылкаФайла);

		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаФайла, Ложь);
		Если ДвоичныеДанные = Неопределено Тогда
			Результат.Ошибка = "Не удалось прочитать данные файла.";
			Возврат Результат;
		КонецЕсли;

		Расширение = НРег(ПолучитьРасширениеФайла(ИмяФайла));
		
		Если ЭтоТекстовоеРасширение(Расширение) Тогда
			
			Текст = ПрочитатьТекстИзДвоичныхДанных(ДвоичныеДанные);
			
			Текст = ОчиститьТекстДляМодели(Текст);
			
			Обрезано = Ложь;
			МаксимальнаяДлина = 200000;
			Если СтрДлина(Текст) > МаксимальнаяДлина Тогда
				Текст = Лев(Текст, МаксимальнаяДлина);
				Обрезано = Истина;
			КонецЕсли;
			Результат.Успех = Истина;
			Результат.Значение = Новый Структура("ИмяФайла, Содержимое, Обрезано",
				ИмяФайла, Текст, Обрезано);
		Иначе
			Результат.Успех = Истина;
			Результат.Значение = Новый Структура("ИмяФайла, Содержимое, Обрезано",
				ИмяФайла, "[Бинарный файл. Текстовое содержимое недоступно.]", Ложь);
		КонецЕсли;
	Исключение
		Результат.Ошибка = "Ошибка чтения файла: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.ПрочитатьФайлДиалога", УровеньЖурналаРегистрации.Ошибка, ,
			Строка(ИдДиалога), "Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	ВыключитьПривилегированныйРежим();

	Возврат Результат;

КонецФункции

// Возвращает список файлов диалога.
//
// Параметры:
//  Аргументы - Структура - параметры вызова инструмента:
//    * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - признак успешного выполнения.
//    * Значение - Структура,Неопределено - список файлов диалога
//      (Неопределено, если запрос не выполнен):
//      ** Файлы - Массив из Структура - список файлов диалога:
//        *** ИмяФайла   - Строка - имя файла с расширением.
//        *** Ссылка     - Строка - UUID элемента справочника файлов.
//        *** Размер     - Число - размер файла в байтах.
//        *** Расширение - Строка - расширение файла без точки.
//    * Ошибка - Строка,Неопределено - описание ошибки при Успех = Ложь.
Функция СписокФайловДиалога(Аргументы) Экспорт

	Результат = НовыйРезультатИнструмента();
	ИдДиалога = Неопределено;

	ВключитьПривилегированныйРежим();
	Попытка
		ИдДиалога = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИдДиалога", Неопределено);
		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Результат.Ошибка = "Не передан идентификатор диалога.";
			Возврат Результат;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Файлы.Ссылка,
		|	Файлы.Наименование,
		|	Файлы.Расширение,
		|	Файлы.Размер,
		|	Файлы.ДатаМодификацииУниверсальная КАК ДатаДобавления
		|ИЗ
		|	Справочник.СИ_ДиалогиАгентаПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &ИдДиалога
		|	И НЕ Файлы.ПометкаУдаления
		|	И НЕ Файлы.ЭтоГруппа
		|УПОРЯДОЧИТЬ ПО
		|	ДатаДобавления УБЫВ, Файлы.Наименование";
		Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);

		Выборка = Запрос.Выполнить().Выбрать();
		МассивФайлов = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ИмяФайла = СокрЛП(Выборка.Наименование);
			Расширение = СокрЛП(Выборка.Расширение);
			Если НЕ ПустаяСтрока(Расширение) Тогда
				ИмяФайла = ИмяФайла + "." + Расширение;
			КонецЕсли;
			ОписаниеФайла = Новый Структура;
			ОписаниеФайла.Вставить("ИмяФайла", ИмяФайла);
			ОписаниеФайла.Вставить("Ссылка", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			ОписаниеФайла.Вставить("Размер", Выборка.Размер);
			ОписаниеФайла.Вставить("Расширение", Расширение);
			ОписаниеФайла.Вставить("ДатаДобавления", Выборка.ДатаДобавления);
			МассивФайлов.Добавить(ОписаниеФайла);
		КонецЦикла;

		Результат.Успех = Истина;
		Результат.Значение = Новый Структура("Файлы", МассивФайлов);
	Исключение
		Результат.Ошибка = "Ошибка получения списка файлов: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.СписокФайловДиалога", УровеньЖурналаРегистрации.Ошибка, ,
			Строка(ИдДиалога), "Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	ВыключитьПривилегированныйРежим();

	Возврат Результат;

КонецФункции

// Сохраняет прикреплённый файл в диалог. При ошибке возвращает пустую ссылку без вызова исключения.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - идентификатор диалога.
//  АдресФайлаВоВременномХранилище - Строка - адрес файла во временном хранилище.
//  ИмяФайла - Строка - имя сохраняемого файла.
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - ссылка на сохранённый файл.
//  - Пустая ссылка - при ошибке (причина логируется в журнал регистрации).
Функция СохранитьПрикрепленныйФайл(ИдДиалога, АдресФайлаВоВременномХранилище, ИмяФайла) Экспорт

	Попытка
		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Возврат Справочники.СИ_ДиалогиАгентаПрисоединенныеФайлы.ПустаяСсылка();
		КонецЕсли;

		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
		Если ДвоичныеДанные = Неопределено Тогда
			Возврат Справочники.СИ_ДиалогиАгентаПрисоединенныеФайлы.ПустаяСсылка();
		КонецЕсли;

		Возврат СохранитьДвоичныеДанныеВДиалог(ИдДиалога, ИмяФайла, ДвоичныеДанные, "Прикреплён пользователем");
	Исключение
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.СохранитьПрикрепленныйФайл", УровеньЖурналаРегистрации.Ошибка, ,
			Строка(ИдДиалога) + " | Файл: " + ИмяФайла, "Ошибка: " + ОписаниеОшибки());
		Возврат Справочники.СИ_ДиалогиАгентаПрисоединенныеФайлы.ПустаяСсылка();
	КонецПопытки;

КонецФункции
// Сохраняет двоичные данные как бинарный файл диалога. Экспортная обёртка над
// внутренней СохранитьДвоичныеДанныеВДиалог - для вызова из других модулей
// (например СИ_Инструменты1С.НарисоватьMermaid сохраняет картинку-схему).
// Если файл с указанным именем уже существует в диалоге, его содержимое обновляется.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  ИмяФайла - Строка - имя сохраняемого файла (с расширением).
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//  Комментарий - Строка - комментарий к файлу.
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - ссылка на созданный или обновлённый файл.
Функция СохранитьБинарныйФайлВДиалоге(ИдДиалога, ИмяФайла, ДвоичныеДанные, Комментарий = "Создан моделью ИИ в диалоге") Экспорт

	Возврат СохранитьДвоичныеДанныеВДиалог(ИдДиалога, ИмяФайла, ДвоичныеДанные, Комментарий);

КонецФункции

// Регистрирует инструменты работы с файлами в справочнике СИ_ИнструментыАгента.
//
// Возвращаемое значение:
//  Массив из Строка - имена зарегистрированных инструментов: CreateDialogFile, ReadDialogFile,
//    UpdateDialogFile, ListDialogFiles, RecognizeImage.
Функция ЗарегистрироватьИнструменты() Экспорт

	Зарегистрированные = Новый Массив;

	УстаревшиеИмена = Новый Массив;
	УстаревшиеИмена.Добавить("СоздатьФайлДиалога");
	УстаревшиеИмена.Добавить("ОбновитьФайлДиалога");
	УстаревшиеИмена.Добавить("ПрочитатьФайлДиалога");
	УстаревшиеИмена.Добавить("СписокФайловДиалога");
	УстаревшиеИмена.Добавить("РаспознатьИзображение");
	Для Каждого УстаревшееИмя Из УстаревшиеИмена Цикл
		Попытка
			СИ_УправлениеИнструментами1С.УдалитьИнструмент(УстаревшееИмя);
		Исключение
		КонецПопытки;
	КонецЦикла;

	Свойства1 = Новый Соответствие;
	ИмяФайла1 = Новый Соответствие;
	ИмяФайла1.Вставить("type", "string");
	ИмяФайла1.Вставить("description", "Имя файла с расширением, например отчет.txt");
	Свойства1.Вставить("ИмяФайла", ИмяФайла1);
	Содержимое1 = Новый Соответствие;
	Содержимое1.Вставить("type", "string");
	Содержимое1.Вставить("description", "Текстовое содержимое файла");
	Свойства1.Вставить("Содержимое", Содержимое1);
	Обязательные1 = Новый Массив;
	Обязательные1.Добавить("ИмяФайла");
	Обязательные1.Добавить("Содержимое");
	Если ЗарегистрироватьИнструмент("CreateDialogFile",
		"Создать текстовый файл в текущем диалоге. Возвращает ссылку на созданный файл. Используй, когда пользователь просит сформировать отчёт, письмо, заметку, данные в txt/md/json/csv/xml.",
		Свойства1, Обязательные1, "СИ_ФайлыДиалога.СоздатьФайлВДиалоге", Истина,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Создаю файл")) Тогда
		Зарегистрированные.Добавить("CreateDialogFile");
	КонецЕсли;

	СвойстваОбн = Новый Соответствие;
	ИмяФайлаОбн = Новый Соответствие;
	ИмяФайлаОбн.Вставить("type", "string");
	ИмяФайлаОбн.Вставить("description", "Имя существующего файла с расширением, например отчет.txt");
	СвойстваОбн.Вставить("ИмяФайла", ИмяФайлаОбн);
	СодержимоеОбн = Новый Соответствие;
	СодержимоеОбн.Вставить("type", "string");
	СодержимоеОбн.Вставить("description", "НОВОЕ текстовое содержимое файла (полностью заменяет старое)");
	СвойстваОбн.Вставить("Содержимое", СодержимоеОбн);
	ОбязательныеОбн = Новый Массив;
	ОбязательныеОбн.Добавить("ИмяФайла");
	ОбязательныеОбн.Добавить("Содержимое");
	Если ЗарегистрироватьИнструмент("UpdateDialogFile",
		"Перезаписать содержимое существующего файла диалога по имени (нет файла - создаст новый). Возвращает ссылку на файл и признак Обновлен.",
		СвойстваОбн, ОбязательныеОбн, "СИ_ФайлыДиалога.ОбновитьФайлДиалога", Истина,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Обновляю файл")) Тогда
		Зарегистрированные.Добавить("UpdateDialogFile");
	КонецЕсли;

	Свойства2 = Новый Соответствие;
	ИмяФайла2 = Новый Соответствие;
	ИмяФайла2.Вставить("type", "string");
	ИмяФайла2.Вставить("description", "Имя файла в диалоге (можно с расширением)");
	Свойства2.Вставить("ИмяФайла", ИмяФайла2);
	Обязательные2 = Новый Массив;
	Обязательные2.Добавить("ИмяФайла");
	Если ЗарегистрироватьИнструмент("ReadDialogFile",
		"Прочитать содержимое файла, привязанного к текущему диалогу, по имени файла. Возвращает текстовое содержимое. Для бинарных файлов возвращает пометку о недоступности текста.",
		Свойства2, Обязательные2, "СИ_ФайлыДиалога.ПрочитатьФайлДиалога", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Читаю файл")) Тогда
		Зарегистрированные.Добавить("ReadDialogFile");
	КонецЕсли;

	Если ЗарегистрироватьИнструмент("ListDialogFiles",
		"Список файлов текущего диалога {ИмяФайла, Ссылка, Размер, Расширение, ДатаДобавления}, отсортирован по дате добавления - свежие первыми: только что прикреплённый файл - первый элемент. Используйте, чтобы узнать, какие файлы есть в диалоге.",
		Неопределено, Неопределено, "СИ_ФайлыДиалога.СписокФайловДиалога", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Смотрю файлы диалога")) Тогда
		Зарегистрированные.Добавить("ListDialogFiles");
	КонецЕсли;

	Свойства6 = Новый Соответствие;
	ИмяФайла6 = Новый Соответствие;
	ИмяФайла6.Вставить("type", "string");
	ИмяФайла6.Вставить("description", "Имя файла-изображения или PDF в диалоге (из ListDialogFiles), например скан_договора.pdf");
	Свойства6.Вставить("ИмяФайла", ИмяФайла6);
	Обязательные6 = Новый Массив;
	Обязательные6.Добавить("ИмяФайла");
	Если ЗарегистрироватьИнструмент("RecognizeImage",
		"Распознать изображение (jpg/png/gif/bmp/webp) или PDF из файлов диалога через vision-модель; для PDF - постранично. Используйте, когда пользователь прикрепил картинку/скан и просит описать его или распознать текст.",
		Свойства6, Обязательные6, "СИ_РаспознованиеИзображений.РаспознатьИзображениеПоИмениФайла", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Распознаю изображение")) Тогда
		Зарегистрированные.Добавить("RecognizeImage");
	КонецЕсли;

	Возврат Зарегистрированные;

КонецФункции

// Возвращает данные файла для скачивания или открытия на клиенте.
//
// Параметры:
//  УИДФайла - Строка - UUID файла (часть маркера file:<UUID>).
//
// Возвращаемое значение:
//  Структура,Неопределено - данные файла для скачивания или открытия на клиенте:
//    * АдресВоВременномХранилище - Строка - адрес двоичных данных во временном хранилище.
//    * ИмяФайла - Строка - имя файла с расширением.
//  Неопределено - если файл не найден или произошла ошибка.
Функция ДанныеФайлаДляОткрытия(УИДФайла) Экспорт

	Результат = Неопределено;
	Попытка
		СсылкаФайла = ПолучитьСсылкуФайлаПоУИД(УИДФайла);
		Если НЕ ЗначениеЗаполнено(СсылкаФайла) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаФайла, Ложь);
		Если ДвоичныеДанные = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		ИмяФайла = ПолучитьИмяФайлаИзСсылки(СсылкаФайла);
		АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);

		Результат = Новый Структура("АдресВоВременномХранилище, ИмяФайла", АдресФайла, ИмяФайла);
	Исключение
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.ДанныеФайлаДляОткрытия", УровеньЖурналаРегистрации.Ошибка, ,
			УИДФайла, "Ошибка: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает HTML-миниатюру файла для истории чата, если файл - изображение
// (jpg/jpeg/png/gif/bmp/webp/svg). Растровое изображение уменьшается до 320px
// по большей стороне, SVG отдается как есть (вектор), оба кодируются в
// data URI (base64), чтобы превью не раздувало HTML.
// Для не-изображений или при ошибке возвращает "" - вызывающий код рисует
// обычную кнопку «Скачать файл». Клик по превью открывает оригинал для
// просмотра (ссылка view:<UUID>, форма чата открывает его приложением по
// умолчанию); скачивание остается на кнопке «Скачать файл».
//
// Параметры:
//  УИДФайла - Строка - UUID файла (часть маркера file:<UUID>).
//  КэшПревью - Соответствие из Структура, Неопределено - кэш готовых превью
//   формы чата (см. ПревьюИзКэша); Неопределено - построение без кэша.
//
// Возвращаемое значение:
//  Строка - HTML с кликабельной миниатюрой или "" .
Функция HTMLПревьюФайла(Знач УИДФайла, КэшПревью = Неопределено) Экспорт

	СсылкаФайла = ПолучитьСсылкуФайлаПоУИД(УИДФайла);
	Если НЕ ЗначениеЗаполнено(СсылкаФайла) Тогда
		Возврат "";
	КонецЕсли;

	КлючВерсии = КлючВерсииФайла(СсылкаФайла);
	HTMLИзКэша = ПревьюИзКэша(КэшПревью, "Миниатюра", УИДФайла, КлючВерсии);
	Если HTMLИзКэша <> Неопределено Тогда
		Возврат HTMLИзКэша;
	КонецЕсли;

	ДанныеПревью = ДанныеПревьюКартинки(СсылкаФайла, МаксСторонаМиниатюры(), Истина,
		МаксДлинаBase64Миниатюры(), 0);
	Если ДанныеПревью = Неопределено Тогда
		HTML = "";
	Иначе
		HTML = "<a href=""view:" + СИ_МаркдаунHTML.ЭкранироватьАтрибут(УИДФайла) + """ title=""Открыть для просмотра"">"
			+ "<img src=""data:" + ДанныеПревью.MIME + ";base64," + ДанныеПревью.СтрокаBase64 + """"
			+ " class=""si-thumb"" /></a>";
	КонецЕсли;

	ЗапомнитьПревьюВКэше(КэшПревью, "Миниатюра", УИДФайла, КлючВерсии, HTML);
	Возврат HTML;

КонецФункции

// Возвращает крупный просмотр файла-изображения для пузыря чата. Растровая
// картинка уменьшается ТОЛЬКО по ширине (высота не ограничивается), SVG
// отдается как есть (вектор); результат помещается в контейнер НА ВСЮ ШИРИНУ
// пузыря с прокруткой по высоте - длинные вертикальные схемы (mermaid и т.п.)
// остаются читаемыми: пользователь прокручивает просмотр, не теряя контекст
// сообщения. Сама схема центрируется в натуральном размере и сжимается,
// только если шире контейнера.
// Для не-изображений или если даже ужатая картинка не влезает в лимит base64,
// возвращает "" - останется только кнопка.
//
// Параметры:
//  УИДФайла - Строка - UUID файла (часть маркера file:<UUID>).
//  КэшПревью - Соответствие из Структура, Неопределено - кэш готовых превью
//   формы чата (см. ПревьюИзКэша); Неопределено - построение без кэша.
//
// Возвращаемое значение:
//  Строка - HTML с кликабельным прокручиваемым просмотром или "" .
Функция HTMLПросмотрФайла(Знач УИДФайла, КэшПревью = Неопределено) Экспорт

	СсылкаФайла = ПолучитьСсылкуФайлаПоУИД(УИДФайла);
	Если НЕ ЗначениеЗаполнено(СсылкаФайла) Тогда
		Возврат "";
	КонецЕсли;

	КлючВерсии = КлючВерсииФайла(СсылкаФайла);
	HTMLИзКэша = ПревьюИзКэша(КэшПревью, "Просмотр", УИДФайла, КлючВерсии);
	Если HTMLИзКэша <> Неопределено Тогда
		Возврат HTMLИзКэша;
	КонецЕсли;

	ДанныеПревью = ДанныеПревьюКартинки(СсылкаФайла, МаксСторонаПросмотра(), Ложь,
		МаксДлинаBase64Просмотра(), ШиринаПовтораПросмотра());
	Если ДанныеПревью = Неопределено Тогда
		HTML = "";
	Иначе
		HTML = "<div class=""si-shot"" style=""max-height:" + МаксВысотаКонтейнераПросмотра() + "px;"">"
			+ "<a href=""view:" + СИ_МаркдаунHTML.ЭкранироватьАтрибут(УИДФайла) + """ title=""Открыть для просмотра"">"
			+ "<img src=""data:" + ДанныеПревью.MIME + ";base64," + ДанныеПревью.СтрокаBase64 + """"
			+ " style=""max-width:100%;display:block;margin:0 auto;cursor:pointer;"" /></a>"
			+ "</div>";
	КонецЕсли;

	ЗапомнитьПревьюВКэше(КэшПревью, "Просмотр", УИДФайла, КлючВерсии, HTML);
	Возврат HTML;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Лимит большей стороны миниатюры вложения, px.
Функция МаксСторонаМиниатюры()
	Возврат 320;
КонецФункции

// Предельная длина base64 миниатюры (защита HTML истории от раздувания).
Функция МаксДлинаBase64Миниатюры()
	Возврат 400000;
КонецФункции

// Лимит ширины крупного просмотра, px (высота свободная - прокручивается).
Функция МаксСторонаПросмотра()
	Возврат 1000;
КонецФункции

// Предельная длина base64 крупного просмотра.
Функция МаксДлинаBase64Просмотра()
	Возврат 900000;
КонецФункции

// Ширина повторного ресайза, если крупный просмотр не уложился в лимит base64.
Функция ШиринаПовтораПросмотра()
	Возврат 600;
КонецФункции

// Высота контейнера крупного просмотра, px (дальше - прокрутка).
Функция МаксВысотаКонтейнераПросмотра()
	Возврат 420;
КонецФункции

// Предельное число записей кэша превью; при превышении кэш сбрасывается целиком.
Функция МаксЗаписейКэшаПревью()
	Возврат 20;
КонецФункции

// Возвращает кэшированный HTML превью файла, если версия файла не менялась.
//
// Параметры:
//  КэшПревью - Соответствие из Структура, Неопределено - кэш готовых превью владельца
//   (ключ "вариант:УИД", значение - Структура(КлючВерсии, HTML)); у формы чата
//   живет на сервере, пока открыта форма. Неопределено - без кэша.
//  Вариант - Строка - "Миниатюра" или "Просмотр" (у файла два разных HTML).
//  УИДФайла - Строка - UUID файла диалога.
//  КлючВерсии - Строка - версия файла (см. КлючВерсииФайла).
//
// Возвращаемое значение:
//  Строка, Неопределено - HTML превью (возможно, "") или Неопределено - кэша нет.
Функция ПревьюИзКэша(Знач КэшПревью, Знач Вариант, Знач УИДФайла, Знач КлючВерсии)

	Если КэшПревью = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запись = КэшПревью.Получить(Вариант + ":" + УИДФайла);
	Если Запись = Неопределено ИЛИ Запись.КлючВерсии <> КлючВерсии Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Запись.HTML;

КонецФункции

// Кладет готовый HTML превью файла в кэш владельца (с ограничением размера).
//
// Параметры:
//  КэшПревью - Соответствие из Структура, Неопределено - см. ПревьюИзКэша.
//  Вариант - Строка - "Миниатюра" или "Просмотр".
//  УИДФайла - Строка - UUID файла диалога.
//  КлючВерсии - Строка - версия файла (см. КлючВерсииФайла).
//  HTML - Строка - готовый HTML превью ("" для не-изображений).
Процедура ЗапомнитьПревьюВКэше(Знач КэшПревью, Знач Вариант, Знач УИДФайла,
	Знач КлючВерсии, Знач HTML)

	Если КэшПревью = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если КэшПревью.Количество() >= МаксЗаписейКэшаПревью() Тогда
		КэшПревью.Очистить();
	КонецЕсли;
	КэшПревью.Вставить(Вариант + ":" + УИДФайла,
		Новый Структура("КлючВерсии, HTML", КлючВерсии, HTML));

КонецПроцедуры

// Версия файла для инвалидации кэша превью: строка ВерсияДанных меняется при
// каждой перезаписи содержимого (перерисованная схема хранится под тем же УИД).
//
// Параметры:
//  СсылкаФайла - СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - файл диалога.
//
// Возвращаемое значение:
//  Строка - версия данных элемента справочника.
Функция КлючВерсииФайла(Знач СсылкаФайла)

	Возврат Строка(ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаФайла, "ВерсияДанных").ВерсияДанных);

КонецФункции

// Читает файл-изображение, при необходимости уменьшает и кодирует в base64.
// Общая основа HTMLПревьюФайла (миниатюра) и HTMLПросмотрФайла (крупный просмотр).
// SVG распознается по содержимому и кодируется без ресайза (MIME image/svg+xml).
// Файл читается и декодируется один раз; при превышении лимита base64 ресайз
// повторяется с ШиринаПовтора без повторного чтения данных.
//
// Параметры:
//  СсылкаФайла - СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - файл диалога.
//  МаксСторона - Число - лимит стороны при ресайзе.
//  ОграничиватьПоВысоте - Булево - Истина: лимит по обеим сторонам (миниатюра);
//   Ложь: лимит только по ширине, высота свободная (крупный просмотр схем).
//  МаксДлинаBase64 - Число - предельная длина base64 (защита HTML от раздувания).
//  ШиринаПовтора - Число - при превышении лимита base64 повторить ресайз с этой
//   шириной; 0 - без повтора.
//
// Возвращаемое значение:
//  Структура - СтрокаBase64, MIME;
//  Неопределено - не изображение или ошибка.
Функция ДанныеПревьюКартинки(Знач СсылкаФайла, Знач МаксСторона, Знач ОграничиватьПоВысоте,
	Знач МаксДлинаBase64, Знач ШиринаПовтора)

	Попытка
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаФайла, Ложь);
		Если ДвоичныеДанные = Неопределено ИЛИ ДвоичныеДанные.Размер() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;

		ГоловаSVG = ГоловаСодержимогоSVG(ДвоичныеДанные);
		Если ЭтоСодержимоеSVG(ГоловаSVG) Тогда
			Возврат ДанныеПревьюSVG(ДвоичныеДанные, МаксДлинаBase64);
		КонецЕсли;

		Картинка = Новый Картинка(ДвоичныеДанные);
		ФорматИзображения = Картинка.Формат();
		Если ФорматИзображения = ФорматКартинки.НеизвестныйФормат Тогда
			Возврат Неопределено;
		КонецЕсли;

		MIMEПревью = MIMEПоФорматуКартинки(ФорматИзображения);
		Если ПустаяСтрока(MIMEПревью) Тогда
			MIMEПревью = "image/jpeg";
		КонецЕсли;

		ДвоичныеДанныеПревью = УменьшеннаяКартинка(Картинка, ДвоичныеДанные, МаксСторона, ОграничиватьПоВысоте);
		СтрокаBase64 = Base64Строка(ДвоичныеДанныеПревью);
		Если СтрДлина(СтрокаBase64) > МаксДлинаBase64 И ШиринаПовтора > 0 И ШиринаПовтора < МаксСторона Тогда
			ДвоичныеДанныеПревью = УменьшеннаяКартинка(Картинка, ДвоичныеДанные, ШиринаПовтора, ОграничиватьПоВысоте);
			СтрокаBase64 = Base64Строка(ДвоичныеДанныеПревью);
		КонецЕсли;
		Если СтрДлина(СтрокаBase64) > МаксДлинаBase64 Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат Новый Структура("СтрокаBase64, MIME", СтрокаBase64, MIMEПревью);

	Исключение
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.ДанныеПревьюКартинки", УровеньЖурналаРегистрации.Предупреждение, ,
			СсылкаФайла, "Ошибка построения превью: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Уменьшает картинку до МаксСторона: при ОграничиватьПоВысоте - по большей из
// двух сторон (миниатюра), иначе - только по ширине (высота свободная).
// При ошибке ресайза возвращает исходные двоичные данные.
//
// Параметры:
//  Картинка - Картинка - исходное изображение.
//  ДвоичныеДанные - ДвоичныеДанные - исходные данные (запасной вариант).
//  МаксСторона - Число - лимит стороны при ресайзе.
//  ОграничиватьПоВысоте - Булево - см. ДанныеПревьюКартинки.
//
// Возвращаемое значение:
//  ДвоичныеДанные - уменьшенное изображение или исходное при ошибке.
Функция УменьшеннаяКартинка(Знач Картинка, Знач ДвоичныеДанные, Знач МаксСторона, Знач ОграничиватьПоВысоте)

	ДвоичныеДанныеПревью = ДвоичныеДанные;
	Попытка
		Ширина = Картинка.Ширина();
		Высота = Картинка.Высота();
		НадоУменьшать = Ложь;
		Если ОграничиватьПоВысоте Тогда
			НадоУменьшать = (Ширина > МаксСторона ИЛИ Высота > МаксСторона) И Ширина > 0 И Высота > 0;
		Иначе
			НадоУменьшать = Ширина > МаксСторона И Высота > 0;
		КонецЕсли;
		Если НадоУменьшать Тогда
			Если ОграничиватьПоВысоте И Высота > Ширина Тогда
				НоваяВысота = МаксСторона;
				НоваяШирина = Цел(Ширина * МаксСторона / Высота);
			Иначе
				НоваяШирина = МаксСторона;
				НоваяВысота = Цел(Высота * МаксСторона / Ширина);
			КонецЕсли;
			ОбрабатываемаяКартинка = Новый ОбрабатываемаяКартинка(Картинка);
			ОбрабатываемаяКартинка.УстановитьРазмер(НоваяШирина, НоваяВысота);
			КартинкаУменьшенная = ОбрабатываемаяКартинка.ПолучитьКартинку();
			ПотокВПамяти = Новый ПотокВПамяти;
			КартинкаУменьшенная.Записать(ПотокВПамяти);
			ДвоичныеДанныеПревью = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.УменьшеннаяКартинка", УровеньЖурналаРегистрации.Предупреждение, ,
			, "Ресайз превью не удался, используется оригинал: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат ДвоичныеДанныеПревью;

КонецФункции

// Проверяет начало содержимого файла на признаки SVG-документа (без учета
// регистра). Объект Картинка платформы SVG не декодирует и отсеивает вектор
// как НеизвестныйФормат, поэтому распознаем его сами - по содержимому
// (не по расширению имени: вложения могут сохраняться без расширения).
//
// Параметры:
//  Голова - Строка - начало содержимого файла (см. ГоловаСодержимогоSVG).
//
// Возвращаемое значение:
//  Булево - Истина, если содержимое начинается как SVG-документ.
Функция ЭтоСодержимоеSVG(Знач Голова)

	ГоловаНРег = НРег(Голова);

	Если Лев(ГоловаНРег, 4) = "<svg" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Лев(ГоловаНРег, 5) = "<?xml" И СтрНайти(ГоловаНРег, "<svg") > 0;

КонецФункции

// Формирует данные превью SVG-схемы. Без ресайза - вектор масштабируется
// стилями; кодируются оригинальные данные с тем же лимитом base64, что у
// растровых картинок.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое SVG-файла.
//  МаксДлинаBase64 - Число - предельная длина base64 (защита HTML от раздувания).
//
// Возвращаемое значение:
//  Структура - СтрокаBase64, MIME ("image/svg+xml");
//  Неопределено - SVG не уложился в лимит base64.
Функция ДанныеПревьюSVG(Знач ДвоичныеДанные, Знач МаксДлинаBase64)

	СтрокаBase64 = Base64Строка(ДвоичныеДанные);
	Если СтрДлина(СтрокаBase64) > МаксДлинаBase64 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("СтрокаBase64, MIME", СтрокаBase64, "image/svg+xml");

КонецФункции

// Читает начало файла текстом UTF-8: пролог и корневой тег SVG всегда
// размещаются в первых байтах документа.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//
// Возвращаемое значение:
//  Строка - начало содержимого (до 4096 символов) без BOM и ведущих пробелов.
Функция ГоловаСодержимогоSVG(Знач ДвоичныеДанные)

	Чтение = Новый ЧтениеДанных(ДвоичныеДанные);
	Попытка
		Голова = Чтение.ПрочитатьСимволы(4096, КодировкаТекста.UTF8);
	Исключение
		Чтение.Закрыть();
		Возврат "";
	КонецПопытки;
	Чтение.Закрыть();

	Пока СтрДлина(Голова) > 0 Цикл
		КодПервого = КодСимвола(Лев(Голова, 1), 1);
		Если КодПервого < 33 ИЛИ КодПервого = 65279 Тогда
			Голова = Сред(Голова, 2);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Голова;

КонецФункции

// Определяет MIME-тип изображения по формату картинки (объект ФорматКартинки).
//
// Параметры:
//  Формат - ФорматКартинки - формат, полученный из Картинка.Формат().
//
// Возвращаемое значение:
//  Строка - MIME-тип ("image/jpeg", "image/png", ...) или "" для неизвестного.
Функция MIMEПоФорматуКартинки(Формат)

	Если Формат = ФорматКартинки.JPEG Тогда
		Возврат "image/jpeg";
	ИначеЕсли Формат = ФорматКартинки.PNG Тогда
		Возврат "image/png";
	ИначеЕсли Формат = ФорматКартинки.GIF Тогда
		Возврат "image/gif";
	ИначеЕсли Формат = ФорматКартинки.BMP Тогда
		Возврат "image/bmp";
	ИначеЕсли Формат = ФорматКартинки.TIFF Тогда
		Возврат "image/tiff";
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает новый результат инструмента с признаком неуспеха по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//    * Успех  - Булево - Ложь.
//    * Значение - Неопределено - Неопределено (заполняется вызывающим кодом).
//    * Ошибка - Строка,Неопределено - Неопределено.
Функция НовыйРезультатИнструмента()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);
	Возврат Результат;

КонецФункции

// Включает привилегированный режим для выполнения операций с объектами информационной базы.
// Диспетчер инструментов выполняет обработчики без безопасного режима (см.
// СИ_УправлениеИнструментами1С.ВыполнитьБезБезопасногоРежима), поэтому здесь достаточно
// снятия ограничения прав доступа.
Процедура ВключитьПривилегированныйРежим()

	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.ВключитьПривилегированныйРежим",
			УровеньЖурналаРегистрации.Информация, , , ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Выключает привилегированный режим после операций с объектами информационной базы.
// Парный метод к ВключитьПривилегированныйРежим.
Процедура ВыключитьПривилегированныйРежим()

	Попытка
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		ЗаписьЖурналаРегистрации("СИ_ФайлыДиалога.ВыключитьПривилегированныйРежим",
			УровеньЖурналаРегистрации.Информация, , , ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Преобразует UUID файла в ссылку на присоединённый файл диалога.
//
// Параметры:
//  УИДФайла - Строка - UUID файла (часть маркера file:<UUID>).
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - ссылка на файл или пустая ссылка, если UUID некорректен.
Функция ПолучитьСсылкуФайлаПоУИД(УИДФайла)

	Попытка
		УИД = Новый УникальныйИдентификатор(СокрЛП(УИДФайла));
		Возврат Справочники.СИ_ДиалогиАгентаПрисоединенныеФайлы.ПолучитьСсылку(УИД);
	Исключение
		Возврат Справочники.СИ_ДиалогиАгентаПрисоединенныеФайлы.ПустаяСсылка();
	КонецПопытки;

КонецФункции

// Сохраняет двоичные данные как файл диалога.
// Если файл с указанным именем уже существует в диалоге, его содержимое обновляется.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  ИмяФайла - Строка - имя сохраняемого файла.
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//  Комментарий - Строка - комментарий к файлу.
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - ссылка на созданный или обновлённый файл.
Функция СохранитьДвоичныеДанныеВДиалог(ИдДиалога, ИмяФайла, ДвоичныеДанные, Комментарий)

	ИмяФайла = СанитизироватьИмяФайла(ИмяФайла);
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "файл_" + Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	ИмяБезРасширения = ИмяФайла;
	Расширение = "";
	ПозицияТочки = ПозицияПоследнейТочки(ИмяФайла);
	Если ПозицияТочки > 0 Тогда
		ИмяБезРасширения = Лев(ИмяФайла, ПозицияТочки - 1);
		Расширение = Сред(ИмяФайла, ПозицияТочки + 1);
	КонецЕсли;

	АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);

	СуществующийФайл = НайтиФайлДиалога(ИдДиалога, ИмяФайла);
	Если ЗначениеЗаполнено(СуществующийФайл) Тогда
		ИнформацияОФайле = Новый Структура;
		ИнформацияОФайле.Вставить("АдресФайлаВоВременномХранилище", АдресФайла);
		ИнформацияОФайле.Вставить("АдресВременногоХранилищаТекста", "");
		ИнформацияОФайле.Вставить("ДатаМодификацииУниверсальная", ТекущаяУниверсальнаяДата());
		РаботаСФайлами.ОбновитьФайл(СуществующийФайл, ИнформацияОФайле);
		Возврат СуществующийФайл;
	КонецЕсли;

	ПараметрыФайла = РаботаСФайламиСлужебныйКлиентСервер.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов = ИдДиалога;
	ПараметрыФайла.ИмяБезРасширения = ИмяБезРасширения;
	ПараметрыФайла.РасширениеБезТочки = НРег(Расширение);
	ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();

	Возврат РаботаСФайламиСлужебныйВызовСервера.ДобавитьФайл(
		ПараметрыФайла, АдресФайла, "", Комментарий);

КонецФункции

// Находит файл в диалоге по имени или UUID. Поиск по имени — регистронезависимый.
// Если в качестве ИмяФайла передан UUID файла (модель может вернуть его из
// ListDialogFiles/CreateDialogFile) — файл ищется по ссылке.
//
// Поиск выполняется в BSL (не запросом по Наименование/Расширение): имена
// реконструируются той же логикой, что и в ListDialogFiles
// (Наименование + "." + Расширение), поэтому поиск гарантированно находит
// файл, который модель видит в списке.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//  ИмяФайла - Строка - имя файла с расширением или UUID файла.
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - ссылка на найденный файл.
//  - Неопределено - если файл не найден.
Функция НайтиФайлДиалога(ИдДиалога, ИмяФайла) Экспорт

	ИмяФайла = СокрЛП(Строка(ИмяФайла));
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЭтоУИД(ИмяФайла) Тогда
		СсылкаФайла = ПолучитьСсылкуФайлаПоУИД(ИмяФайла);
		Если ЗначениеЗаполнено(СсылкаФайла) И ФайлПринадлежитДиалогу(СсылкаФайла, ИдДиалога) Тогда
			Возврат СсылкаФайла;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	ИмяДляСравнения = НРег(ИмяФайла);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Файлы.Ссылка,
	|	Файлы.Наименование,
	|	Файлы.Расширение,
	|	Файлы.ДатаМодификацииУниверсальная
	|ИЗ
	|	Справочник.СИ_ДиалогиАгентаПрисоединенныеФайлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла = &ИдДиалога
	|	И НЕ Файлы.ПометкаУдаления
	|	И НЕ Файлы.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО
	|	Файлы.ДатаМодификацииУниверсальная УБЫВ";
	Запрос.УстановитьПараметр("ИдДиалога", ИдДиалога);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИмяФайлаИзСправочника = СокрЛП(Выборка.Наименование);
		Расширение = СокрЛП(Выборка.Расширение);
		Если НЕ ПустаяСтрока(Расширение) Тогда
			ИмяФайлаИзСправочника = ИмяФайлаИзСправочника + "." + Расширение;
		КонецЕсли;
		Если НРег(ИмяФайлаИзСправочника) = ИмяДляСравнения Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Определяет, является ли строка корректным UUID (8-4-4-4-12).
//
// Параметры:
//  Значение - Строка - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если строка имеет формат UUID.
Функция ЭтоУИД(Значение)

	Значение = СокрЛП(Строка(Значение));
	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Сред(Значение, 9, 1) = "-"
		И Сред(Значение, 14, 1) = "-"
		И Сред(Значение, 19, 1) = "-"
		И Сред(Значение, 24, 1) = "-";

КонецФункции

// Проверяет, принадлежит ли файл указанному диалогу.
//
// Параметры:
//  СсылкаФайла - СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - ссылка на файл.
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//
// Возвращаемое значение:
//  Булево - Истина, если ВладелецФайла = ИдДиалога.
Функция ФайлПринадлежитДиалогу(СсылкаФайла, ИдДиалога)

	Попытка
		Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаФайла, "ВладелецФайла");
		Возврат Значения.ВладелецФайла = ИдДиалога;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Регистрирует один инструмент работы с файлами в справочнике СИ_ИнструментыАгента.
//
// Параметры:
//  Имя - Строка - имя инструмента (ИмяФункции).
//  Описание - Строка - описание инструмента для модели.
//  СвойстваJSON - Соответствие из Строка,Произвольный,Неопределено - схема properties
//    (без "type" и "required"); Неопределено, если у инструмента нет параметров.
//  Обязательные - Массив из Строка,Неопределено - список обязательных параметров.
//  Обработчик - Строка - имя функции-обработчика в формате "Модуль.Функция".
//  ТребуетРазрешения - Булево - запрашивать подтверждение пользователя перед
//    исполнением (пишущие инструменты); дефолт для новой регистрации.
//  ЗначенияРеестра - Структура,Неопределено - группа, ключевые слова и действие
//    инструмента (см. СИ_УправлениеИнструментами1С.ЗначенияРеестра): ключи передаются
//    в дескриптор только для непустых значений, поэтому правки администратора
//    в справочнике не затираются.
//
// Возвращаемое значение:
//  Булево - Истина, если инструмент зарегистрирован (или уже существовал).
Функция ЗарегистрироватьИнструмент(Имя, Описание, СвойстваJSON, Обязательные, Обработчик,
	ТребуетРазрешения = Ложь, ЗначенияРеестра = Неопределено)

	Возврат СИ_УправлениеИнструментами1С.ЗарегистрироватьИнструмент(
		СИ_УправлениеИнструментами1С.ДескрипторИнструмента(Имя, Описание, СвойстваJSON,
			Обязательные, Обработчик, ТребуетРазрешения, ЗначенияРеестра));

КонецФункции

// Возвращает безопасное имя файла без пути и недопустимых символов.
//
// Параметры:
//  ИмяФайла - Строка - исходное имя файла, возможно содержащее путь.
//
// Возвращаемое значение:
//  Строка - итоговое имя файла, ограниченное 150 символами.
Функция СанитизироватьИмяФайла(ИмяФайла)

	Результат = СокрЛП(Строка(ИмяФайла));
	Позиция = СтрНайти(Результат, "\");
	Пока Позиция > 0 Цикл
		Результат = Сред(Результат, Позиция + 1);
		Позиция = СтрНайти(Результат, "\");
	КонецЦикла;
	Позиция = СтрНайти(Результат, "/");
	Пока Позиция > 0 Цикл
		Результат = Сред(Результат, Позиция + 1);
		Позиция = СтрНайти(Результат, "/");
	КонецЦикла;

	Результат = СтрЗаменить(Результат, ":", "");
	Результат = СтрЗаменить(Результат, "*", "");
	Результат = СтрЗаменить(Результат, "?", "");
	Результат = СтрЗаменить(Результат, """", "");
	Результат = СтрЗаменить(Результат, "<", "");
	Результат = СтрЗаменить(Результат, ">", "");
	Результат = СтрЗаменить(Результат, "|", "");

	Если СтрДлина(Результат) > 150 Тогда
		Результат = Лев(Результат, 150);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает расширение файла без ведущей точки.
//
// Параметры:
//  ИмяФайла - Строка - имя файла, из которого извлекается расширение.
//
// Возвращаемое значение:
//  Строка - часть имени файла после последней точки. Если точка отсутствует - пустая строка.
Функция ПолучитьРасширениеФайла(ИмяФайла) Экспорт

	Результат = "";
	ПозицияТочки = ПозицияПоследнейТочки(ИмяФайла);
	Если ПозицияТочки > 0 Тогда
		Результат = Сред(ИмяФайла, ПозицияТочки + 1);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает позицию последней точки в имени файла.
//
// Параметры:
//  ИмяФайла - Строка - имя файла.
//
// Возвращаемое значение:
//  Число - позиция последней точки; 0, если точка отсутствует.
//  Расширением файла считается часть после ПОСЛЕДНЕЙ точки (например, "мой.отчёт.txt" -> "txt"),
//  как это делает BSP в РаботаСФайлами.ДобавитьФайл.
Функция ПозицияПоследнейТочки(ИмяФайла)

	Для Индекс = СтрДлина(ИмяФайла) По 1 Цикл
		Если Сред(ИмяФайла, Индекс, 1) = "." Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Проверяет, относится ли расширение файла к числу известных текстовых.
//
// Параметры:
//  Расширение - Строка - расширение файла без точки.
//
// Возвращаемое значение:
//  Булево - Истина, если расширение входит в список известных текстовых.
Функция ЭтоТекстовоеРасширение(Расширение)

	Если ПустаяСтрока(Расширение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти("," + СписокТекстовыхРасширений() + ",", "," + НРег(Расширение) + ",") > 0;

КонецФункции

// Возвращает список известных текстовых расширений (через запятую, без точек).
//
// Возвращаемое значение:
//  Строка - список расширений, разделённых запятыми.
Функция СписокТекстовыхРасширений()

	Возврат "txt,md,json,xml,csv,log,bsl,yml,yaml,ini,cfg,conf,html,htm,js,ts,py,sh,sql,bat,cmd,ps1,tex,rtf,csv,tsv";

КонецФункции

// Читает текст из двоичных данных.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные, Неопределено - двоичные данные для чтения.
//
// Возвращаемое значение:
//  Строка - извлечённый текст. Пустая строка, если данные пусты или не содержат читаемого текста.
Функция ПрочитатьТекстИзДвоичныхДанных(ДвоичныеДанные)

	Если ДвоичныеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Исключение
		Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.ANSI);
	КонецПопытки;

КонецФункции

// Возвращает имя файла с расширением, сформированное из реквизитов элемента справочника файлов.
//
// Параметры:
//  СсылкаФайла - СправочникСсылка.СИ_ДиалогиАгентаПрисоединенныеФайлы - ссылка на элемент справочника файлов.
//
// Возвращаемое значение:
//  Строка - имя файла с расширением в формате "Имя.Расширение".
Функция ПолучитьИмяФайлаИзСсылки(СсылкаФайла) Экспорт

	ИмяФайла = "";
	Попытка
		Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаФайла, "Наименование, Расширение");
		ИмяФайла = СокрЛП(Значения.Наименование);
		Расширение = СокрЛП(Значения.Расширение);
		Если НЕ ПустаяСтрока(Расширение) Тогда
			ИмяФайла = ИмяФайла + "." + Расширение;
		КонецЕсли;
	Исключение
		ИмяФайла = "файл";
	КонецПопытки;
	Возврат ИмяФайла;

КонецФункции

// Заменяет в тексте управляющие символы с кодами 0..31, кроме табуляции, перевода строки и возврата каретки, на пробел.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - очищенный текст.
Функция ОчиститьТекстДляМодели(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Длина = СтрДлина(Текст);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Код = КодСимвола(Текст, Индекс);
		Если Код < 32 И Код <> 9 И Код <> 10 И Код <> 13 Тогда
			Результат = Результат + " ";
		Иначе
			Результат = Результат + Сред(Текст, Индекс, 1);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подготавливает двоичные данные текстового файла из аргументов инструмента.
// Выполняет общую валидацию для CreateDialogFile и UpdateDialogFile:
// проверка ИдДиалога / ИмяФайла / Содержимое, санитизация имени,
// лимит 2 МБ по фактическому размеру двоичных данных.
//
// Параметры:
//  Аргументы - Структура - параметры вызова инструмента:
//    * ИдДиалога  - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//    * ИмяФайла   - Строка - имя файла с расширением.
//    * Содержимое - Строка - текстовое содержимое.
//  Результат - Структура - результат инструмента; при ошибке заполняется поле Ошибка.
//
// Возвращаемое значение:
//  Структура,Неопределено - подготовленные данные:
//    * ДвоичныеДанные - ДвоичныеДанные - содержимое в UTF-8.
//    * ИмяФайла - Строка - санитизированное имя файла.
//    * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//    * Содержимое - Строка - исходное текстовое содержимое.
//  Неопределено - при ошибке валидации (причина в Результат.Ошибка).
Функция ПодготовитьДвоичныеДанныеТекстовогоФайла(Аргументы, Результат)

	ИдДиалога  = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИдДиалога", Неопределено);
	ИмяФайла   = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИмяФайла", ""));
	Содержимое = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Содержимое", ""));

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Результат.Ошибка = "Не передан идентификатор диалога.";
		Возврат Неопределено;
	КонецЕсли;
	Если ПустаяСтрока(ИмяФайла) Тогда
		Результат.Ошибка = "Не указано имя файла.";
		Возврат Неопределено;
	КонецЕсли;
	Если ПустаяСтрока(Содержимое) Тогда
		Результат.Ошибка = "Содержимое файла пустое.";
		Возврат Неопределено;
	КонецЕсли;

	ИмяФайла = СанитизироватьИмяФайла(ИмяФайла);
	Если ПустаяСтрока(ИмяФайла) Тогда
		Результат.Ошибка = "Некорректное имя файла.";
		Возврат Неопределено;
	КонецЕсли;

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Содержимое, КодировкаТекста.UTF8, Ложь);

	МаксимальныйРазмер = 2 * 1024 * 1024;
	Если ДвоичныеДанные.Размер() > МаксимальныйРазмер Тогда
		Результат.Ошибка = "Содержимое файла слишком большое (максимум 2 МБ).";
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("ДвоичныеДанные, ИмяФайла, ИдДиалога, Содержимое",
		ДвоичныеДанные, ИмяФайла, ИдДиалога, Содержимое);

КонецФункции

#КонецОбласти
