#Область ПрограммныйИнтерфейс

// Запускает AI-агента в указанном режиме с заданным запросом пользователя.
// Управляет циклом взаимодействия с агентом, обрабатывает вызовы инструментов и
// возвращает итоговый результат работы.
// Оркестратор захода: подготовка параметров, инициализация контекста, цикл агента
// и финализация вынесены в служебные функции модуля (см. #Область ПодготовкаЗаходаАгента,
// #Область ЦиклАгента, #Область ФинализацияЗахода).
//
// Параметры:
//  ПараметрыЗапроса - Структура - параметры запуска агента:
//   * Режим          - СправочникСсылка.СИ_РежимиРаботы,Строка - режим работы агента (ссылка на справочник)
//   * Модель         - Строка,Неопределено - имя модели (приоритет над моделью режима и моделью профиля)
//   * Профиль        - СправочникСсылка.СИ_ПрофилиПодключений,Строка,Неопределено - профиль подключения (приоритет над профилем режима)
//   * ЗапросПользователя - Строка - текст запроса пользователя
//   * ИдДиалога      - СправочникСсылка.СИ_ДиалогиАгента,Неопределено - ссылка на существующий диалог (опционально)
//   * ДопПараметры   - Структура,Неопределено - дополнительные параметры (опционально):
//     * СистемныйПромпт - Строка - кастомный системный промпт (переопределяет промпт из справочника)
//     * ВозобновлениеРазрешения - Булево - возобновить заход после остановки на запросе
//       разрешения (двухфазный запуск): пользовательское сообщение не добавляется,
//       сжатие/память пропускаются, отложенные вызовы из СИ_ОжидающиеРазрешения
//       исполняются/отклоняются до первого вызова модели
//     * РешенияРазрешений - Массив - решения пользователя: [{ИдВызова, ИмяИнструмента, Разрешено, Запомнить}]
//
// Возвращаемое значение:
//  Структура - результат работы агента:
//   * Успех            - Булево - признак успешного выполнения
//   * ИтоговыйТекст    - Строка - текст ответа агента
//   * ВызовыИнструментов - Массив из Структура - журнал вызовов инструментов за сессию
//   * КоличествоИтераций - Число - количество выполненных итераций
//   * ИспользованоТокенов - Число - общее количество токенов за сессию
//   * ПромптТокены     - Число,Неопределено - суммарное количество входных токенов (для калибровки сжатия)
//   * ИдДиалога        - Неопределено,СправочникСсылка.СИ_ДиалогиАгента - ссылка на созданный или использованный диалог
//   * Ошибки           - Массив из Строка - список возникших ошибок
//   * ПричинаЗавершения - Строка - причина преждевременного завершения (при наличии);
//     "ОжидаетРазрешения" - ФЗ остановлен: часть вызовов ждёт подтверждения пользователя
//     (отложенные вызовы - в регистре СИ_ОжидающиеРазрешения)
//
// Пример использования:
//  Параметры = Новый Структура;
//  Параметры.Вставить("ЗапросПользователя", "Напиши отчёт");
//  Параметры.Вставить("Режим", "Чат");
//  Результат = ЗапуститьАгента(Параметры);
//  Если Результат.Успех Тогда
//      Сообщить(Результат.ИтоговыйТекст);
//  КонецЕсли;
//
Функция ЗапуститьАгента(ПараметрыЗапроса) Экспорт
	Результат = ИнициализироватьРезультатЗапуска();

	// Буфер и идентификатор диалога объявлены до Попытки: обработчик исключения
	// сбрасывает буфер (СброситьБуферСообщений), и переменные должны быть доступны,
	// даже если падение произошло до их фактического заполнения.
	БуферСообщений = Неопределено;
	ИдДиалога = Неопределено;

	Попытка
		ПараметрыЗапуска = ПодготовитьПараметрыЗапуска(ПараметрыЗапроса);
		ПараметрыМодели = ОпределитьПрофильИМодель(ПараметрыЗапроса, ПараметрыЗапуска);

		ДиалогЗахода = ОбеспечитьДиалогЗапуска(ПараметрыЗапуска, ПараметрыМодели);
		Если НЕ ДиалогЗахода.Успех Тогда
			Результат.Ошибки.Добавить(ДиалогЗахода.ТекстОшибки);
			Возврат Результат;
		КонецЕсли;
		ИдДиалога = ДиалогЗахода.ИдДиалога;
		Результат.ИдДиалога = ИдДиалога;

		// Сжатие истории выполняется один раз перед циклом, а не на каждой итерации:
		// это отдельный вызов модели, а внутри захода история в буфере сообщений
		// согласованна (добавляются только новые сообщения), повторная сводка ничего
		// не даёт и лишь удорожает итерации.
		ТекстСводки = СжатьИсториюПередЗапуском(ИдДиалога, ПараметрыЗапуска, ПараметрыМодели);
		ДобавитьСообщениеПользователя(ИдДиалога, ПараметрыЗапуска);

		КонтекстЦикла = СформироватьКонтекстЦикла(ИдДиалога, ПараметрыЗапуска, ПараметрыМодели, ТекстСводки);
		БуферСообщений = КонтекстЦикла.БуферСообщений;

		Если ПараметрыЗапуска.ЭтоВозобновление Тогда
			ВыполнитьОтложенныеВызовы(КонтекстЦикла, ПараметрыЗапуска.РешенияРазрешений, Результат);
		КонецЕсли;

		ПодготовитьВложенияВКонтекст(КонтекстЦикла, ПараметрыЗапуска, ПараметрыМодели);

		ВыполнитьЦиклАгента(КонтекстЦикла, БуферСообщений, Результат);
		ФинализироватьЗаходАгента(КонтекстЦикла, БуферСообщений, Результат, ПараметрыЗапуска, ПараметрыМодели);

	Исключение
		Результат.Ошибки.Добавить("Критическая ошибка агента: " + ОписаниеОшибки());

		Попытка
			СИ_УправлениеДиалогом.СброситьБуферСообщений(БуферСообщений);
		Исключение
			ЗаписьЖурналаРегистрации("Агент1С.ЗапуститьАгента", УровеньЖурналаРегистрации.Предупреждение,
				Строка(ИдДиалога),, "Ошибка финального сброса буфера сообщений: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Выполняет одну итерацию цикла диалога с AI-моделью
//
// Параметры:
//  КонтекстЦикла - Структура - контекст выполнения диалога. Содержит:
//    * Режим - ПеречислениеСсылка.СИ_РежимыРаботыАгента - режим выполнения
//    * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог
//    * ДопПараметры - Структура,Неопределено - дополнительные параметры, включая:
//      * ОбработчикЧанка - Произвольный - обработчик чанка для потокового режима
//    * Сообщения - Массив из Структура - история сообщений диалога
//
// Возвращаемое значение:
//  Структура - результат выполнения итерации с полями:
//    * ПродолжатьЦикл - Булево - признак необходимости продолжения цикла
//    * ПричинаЗавершения - Строка - причина завершения ("tool_calls", "stop", "length", "content_filter", или код ошибки HTTP)
//    * ВызовыИнструментов - Массив из Структура - массив вызовов инструментов (если есть)
//    * СообщениеМодели - Структура,Неопределено - полное сообщение модели
//    * ПревышенЛимит - Булево - признак превышения лимита
//    * ТекстОтвета - Строка - текстовый ответ модели
//    * ИспользованоТокенов - Число - общее количество использованных токенов
//    * ПромптТокены - Число,Неопределено - количество входных токенов (prompt_tokens) на этой итерации
//    * ТокеныОтвета - Число,Неопределено - количество токенов ответа (completion_tokens) на этой итерации
//    * НовыеToolСообщения - Неопределено,Строка
//    * Рассуждения - Строка - рассуждения (reasoning) модели, если получены
//    * ТекстОшибки - Строка - текст ошибки при сбое вызова модели (заполняется вместе
//      с ПричинаЗавершения = "HTTP_*" / "Ошибка вызова модели" / "Пустой ответ модели" / "Внутренняя ошибка")
//
// Пример:
//  Контекст = Новый Структура;
//  Контекст.Вставить("Режим", "Chat");
//  Контекст.Вставить("ИдДиалога", "12345");
//  Контекст.Вставить("Сообщения", МассивСообщений);
//  
Функция ВыполнитьИтерацию(КонтекстЦикла) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ПродолжатьЦикл", Ложь);
	Результат.Вставить("ПричинаЗавершения", "");
	Результат.Вставить("ВызовыИнструментов", Новый Массив);
	Результат.Вставить("СообщениеМодели", Неопределено);
	Результат.Вставить("ПревышенЛимит", Ложь);
	Результат.Вставить("ТекстОтвета", "");
	Результат.Вставить("ИспользованоТокенов", 0);
	Результат.Вставить("ПромптТокены", 0);
	Результат.Вставить("ТокеныОтвета", 0);
	Результат.Вставить("НовыеToolСообщения", Неопределено);
	Результат.Вставить("Рассуждения", "");
	Результат.Вставить("ТекстОшибки", "");
	
	Попытка
		Режим = КонтекстЦикла.Режим;
		ИдДиалога = КонтекстЦикла.ИдДиалога;
		БуферСообщенийИтерации = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "БуферСообщений", Неопределено);
		
		ПараметрыЗапроса = СобратьПараметрыЗапроса(КонтекстЦикла);
		
		РезультатВызова = Неопределено;
		УспехВызова = Ложь;
		
		Пока Истина Цикл
			ПроверитьПрерываниеФоновогоЗадания();
			
			Если Режим = Перечисления.СИ_РежимыРаботыАгента.Streaming Тогда
				ОбработчикЧанка = СИ_РаботаСJSON.БезопасноПолучить(
					СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ДопПараметры", Неопределено),
					"ОбработчикЧанка", Неопределено);
				
				Если ОбработчикЧанка = Неопределено Тогда
					РезультатВызова = СИ_ОpenAIКлиент.ВызватьChatCompletion(ПараметрыЗапроса);
				Иначе
					РезультатВызова = СИ_ОpenAIКлиент.ВызватьChatCompletionПотоково(ПараметрыЗапроса, ОбработчикЧанка);
				КонецЕсли;
			Иначе
				ПараметрыЗапроса.Вставить("Потоковый", Ложь);
				РезультатВызова = СИ_ОpenAIКлиент.ВызватьChatCompletion(ПараметрыЗапроса);
			КонецЕсли;
			
			Если РезультатВызова = Неопределено Тогда
				Результат.ПричинаЗавершения = "Ошибка вызова модели";
				Результат.ТекстОшибки = "Результат вызова модели не получен";
				Возврат Результат;
			КонецЕсли;
			
			УспехВызова = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Успех", Ложь);
			Если УспехВызова Тогда
				Прервать;
			КонецЕсли;
			
			КодОшибки = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "КодОшибки", "UNKNOWN");
			ТекстОшибки = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "ТекстОшибки", "Неизвестная ошибка");
			
			Если ПовторитьВызовПриТранспортнойОшибке(КодОшибки, ТекстОшибки, КонтекстЦикла, ИдДиалога) Тогда
				Продолжить;
			КонецЕсли;
			
			Результат.ПричинаЗавершения = "HTTP_" + КодОшибки;
			Результат.ТекстОшибки = ТекстОшибки;
			ЗаписьЖурналаРегистрации("Агент1С.ВыполнитьИтерацию", УровеньЖурналаРегистрации.Ошибка,
				ИдДиалога,, "Ошибка вызова модели: " + ТекстОшибки);
			Возврат Результат;
		КонецЦикла;
		
		Ответ = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Ответ", Неопределено);
		Если Ответ <> Неопределено Тогда
			Usage = СИ_РаботаСJSON.БезопасноПолучить(Ответ, "usage", Неопределено);
			Если Usage <> Неопределено Тогда
				Результат.ИспользованоТокенов = СИ_РаботаСJSON.БезопасноПолучить(Usage, "total_tokens", 0);
				
				ПромптТокены = СИ_РаботаСJSON.БезопасноПолучить(Usage, "prompt_tokens", 0);
				Результат.Вставить("ПромптТокены", Число(ПромптТокены));
				Результат.Вставить("ТокеныОтвета", Число(СИ_РаботаСJSON.БезопасноПолучить(Usage, "completion_tokens", 0)));
				
				Попытка
					ОценкаВхода = 0;
					СообщенияДляОценки = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Сообщения", Неопределено);
					Если СообщенияДляОценки <> Неопределено Тогда
						ОценкаВхода = СИ_УправлениеДиалогом.ОценитьТокеныИстории(СообщенияДляОценки);
					КонецЕсли;
					ЗаписьЖурналаРегистрации("Агент1С.ТокеныВхода", УровеньЖурналаРегистрации.Информация,
						ИдДиалога,, "Итерация=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "СчетчикИтераций", 0))
						+ " | prompt_tokens=" + Строка(ПромптТокены)
						+ " | completion_tokens=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(Usage, "completion_tokens", 0))
						+ " | оценка_входа=" + Строка(ОценкаВхода)
						+ " | модель=" + СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Модель", ""));
				Исключение
					ЗаписьЖурналаРегистрации("Агент1С.ТокеныВхода", УровеньЖурналаРегистрации.Предупреждение,
						ИдДиалога,, "Ошибка логирования токенов входа: " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		СобранноеСообщение = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "СобранноеСообщение", Неопределено);
		Если СобранноеСообщение <> Неопределено И Режим = Перечисления.СИ_РежимыРаботыАгента.Streaming Тогда
			СообщениеМодели = СобранноеСообщение;

			ПричинаЗавершения = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "ПричинаЗавершения", "");
			
			СообщениеДляИстории = Новый Структура;
			СообщениеДляИстории.Вставить("Роль", "assistant");
			СообщениеДляИстории.Вставить("Контент", СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "Контент", ""));
			СообщениеДляИстории.Вставить("ВызовыИнструментов", СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "ВызовыИнструментов", Неопределено));
			РассужденияПоток = СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "Рассуждения", "");
			Если НЕ ПустаяСтрока(РассужденияПоток) Тогда
				СообщениеДляИстории.Вставить("Рассуждения", РассужденияПоток);
			КонецЕсли;
				ДобавитьСообщениеВЦикле(БуферСообщенийИтерации, ИдДиалога, СообщениеДляИстории);
				ОтправитьЖивоеПоследнееСообщение(БуферСообщенийИтерации, КонтекстЦикла);

				Результат.ТекстОтвета = СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "Контент", "");
			Результат.ПричинаЗавершения = ПричинаЗавершения;
			Результат.СообщениеМодели = СообщениеМодели;
			Результат.Рассуждения = РассужденияПоток;
			Результат.ПродолжатьЦикл = (ПричинаЗавершения = "tool_calls" И Режим <> Перечисления.СИ_РежимыРаботыАгента.Чат);
			Результат.Вставить("КонтентДляЛокальногоНакопления",
				СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "Контент", ""));
			Возврат Результат;
		КонецЕсли;
		
		РазобранныйОтвет = СИ_ОpenAIКлиент.СобратьСообщениеИзОтвета(Ответ);

		СообщениеМодели = СИ_РаботаСJSON.БезопасноПолучить(РазобранныйОтвет, "Сообщение", Неопределено);
		
		Попытка
			Причина = СИ_РаботаСJSON.БезопасноПолучить(РазобранныйОтвет, "ПричинаЗавершения", "");
			КолВызовов = 0;
			Выз = СИ_РаботаСJSON.БезопасноПолучить(РазобранныйОтвет, "ВызовыИнструментов", Неопределено);
			Если Выз <> Неопределено И ТипЗнч(Выз) = Тип("Массив") Тогда
				КолВызовов = Выз.Количество();
			КонецЕсли;
			ЗаписьЖурналаРегистрации("Агент1С.Debug.ПослеРазбора", УровеньЖурналаРегистрации.Информация, ИдДиалога,,
				"СообщениеМодели = " + Строка(СообщениеМодели <> Неопределено)
				+ " | Причина = " + Причина
				+ " | ВызововИнструментов = " + Строка(КолВызовов));
		Исключение
			ЗаписьЖурналаРегистрации("Агент1С.Debug.ПослеРазбора", УровеньЖурналаРегистрации.Предупреждение, ИдДиалога,,
				"Ошибка логирования диагностики после разбора: " + ОписаниеОшибки());
		КонецПопытки;
		
		Если СообщениеМодели = Неопределено Тогда
			Результат.ПричинаЗавершения = "Пустой ответ модели";
			Результат.ТекстОшибки = "Модель вернула пустой ответ";
			
			Попытка
				СыройОтветСтрокой = "";
				Попытка
					Если Ответ <> Неопределено Тогда
						СыройОтветСтрокой = Лев(СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Ответ), 2000);
					Иначе
						СыройОтветСтрокой = "<Ответ=Неопределено>";
					КонецЕсли;
				Исключение
					СыройОтветСтрокой = "<не удалось сериализовать Ответ: " + ОписаниеОшибки() + ">";
				КонецПопытки;
				ЗаписьЖурналаРегистрации("Агент1С.Debug.ПустойОтвет", УровеньЖурналаРегистрации.Предупреждение, ИдДиалога,,
					"РазобранныйОтвет=" + Строка(РазобранныйОтвет <> Неопределено)
					+ " | Ответ=" + Строка(Ответ <> Неопределено)
					+ " | ПричинаРазбора=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(РазобранныйОтвет, "ПричинаЗавершения", ""))
					+ " | СыройОтвет(обрезан)=" + Лев(СыройОтветСтрокой, 1500));
			Исключение
				ЗаписьЖурналаРегистрации("Агент1С.Debug.ПустойОтвет", УровеньЖурналаРегистрации.Предупреждение, ИдДиалога,,
					"Ошибка логирования диагностики пустого ответа: " + ОписаниеОшибки());
			КонецПопытки;
			Возврат Результат;
		КонецЕсли;
		
		ПричинаЗавершения = СИ_РаботаСJSON.БезопасноПолучить(РазобранныйОтвет, "ПричинаЗавершения", "");
		ВызовыИнструментов = СИ_РаботаСJSON.БезопасноПолучить(РазобранныйОтвет, "ВызовыИнструментов", Новый Массив);
		
		КонтентМодели = СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "content", "");
		Если КонтентМодели = Неопределено ИЛИ ТипЗнч(КонтентМодели) <> Тип("Строка") Тогда
			КонтентМодели = "";
		КонецЕсли;
		Если ПустаяСтрока(КонтентМодели) Тогда
			КонтентМодели = СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "Контент", "");
			Если КонтентМодели = Неопределено ИЛИ ТипЗнч(КонтентМодели) <> Тип("Строка") Тогда
				КонтентМодели = "";
			КонецЕсли;
		КонецЕсли;
		
		СообщениеДляИстории = Новый Структура;
		СообщениеДляИстории.Вставить("Роль", "assistant");
		СообщениеДляИстории.Вставить("Контент", КонтентМодели);
		
		РассужденияРазобранные = СИ_РаботаСJSON.БезопасноПолучить(РазобранныйОтвет, "Рассуждения", "");
		Если НЕ ПустаяСтрока(РассужденияРазобранные) Тогда
			СообщениеДляИстории.Вставить("Рассуждения", РассужденияРазобранные);
		КонецЕсли;
		
		ТулКоллы = СИ_РаботаСJSON.БезопасноПолучить(СообщениеМодели, "tool_calls", Неопределено);
		Если ТулКоллы <> Неопределено И ТипЗнч(ТулКоллы) = Тип("Массив") И ТулКоллы.Количество() > 0 Тогда
			СообщениеДляИстории.Вставить("ВызовыИнструментов", ТулКоллы);
		КонецЕсли;

		Если ПричинаЗавершения <> "tool_calls" Тогда
			СозданныеФайлы = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "СозданныеФайлы", Неопределено);
			Если СозданныеФайлы <> Неопределено И ТипЗнч(СозданныеФайлы) = Тип("Массив") И СозданныеФайлы.Количество() > 0 Тогда
				БлокФайлов = "";
				Для Каждого СозданныйФайл Из СозданныеФайлы Цикл
					УИДФайла = Строка(СИ_РаботаСJSON.БезопасноПолучить(СозданныйФайл, "УИД", ""));
					Если ПустаяСтрока(УИДФайла) Тогда
						Продолжить;
					КонецЕсли;

					Если СтрНайти(КонтентМодели, "file:" + УИДФайла) = 0 Тогда
						Если ПустаяСтрока(БлокФайлов) Тогда
							БлокФайлов = Символы.ПС + Символы.ПС + "file:" + УИДФайла;
						Иначе
							БлокФайлов = БлокФайлов + Символы.ПС + "file:" + УИДФайла;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;

				Если НЕ ПустаяСтрока(БлокФайлов) Тогда
					КонтентМодели = КонтентМодели + БлокФайлов;
					СообщениеДляИстории.Вставить("Контент", КонтентМодели);
				КонецЕсли;
			КонецЕсли;

			КартаСсылокОтвета = СобратьСсылкиХодаДляОтвета(КонтекстЦикла);
			Если КартаСсылокОтвета.Количество() > 0 Тогда
				СообщениеДляИстории.Вставить("СсылкиДокументов", КартаСсылокОтвета);
			КонецЕсли;

			ДиаграммыОтвета = СобратьДиаграммыХодаДляОтвета(КонтекстЦикла);
			Если ДиаграммыОтвета.Количество() > 0 Тогда
				СообщениеДляИстории.Вставить("Диаграмма", ДиаграммыОтвета);
			КонецЕсли;
		КонецЕсли;

		Результат.Вставить("КонтентДляЛокальногоНакопления", КонтентМодели);

		ДобавитьСообщениеВЦикле(БуферСообщенийИтерации, ИдДиалога, СообщениеДляИстории);
		ОтправитьЖивоеПоследнееСообщение(БуферСообщенийИтерации, КонтекстЦикла);

		Продолжать = Ложь;
		Если ПричинаЗавершения = "tool_calls" И ВызовыИнструментов.Количество() > 0 Тогда
			Если Режим <> Перечисления.СИ_РежимыРаботыАгента.Чат Тогда
				РезультатыИнструментов = ОбработатьВызовыИнструментов(ВызовыИнструментов, КонтекстЦикла);
				
				Если РезультатыИнструментов.Количество() > 0 Тогда
					Продолжать = Истина;
				Иначе
					Продолжать = Ложь;
					Результат.ТекстОтвета = КонтентМодели;
					ЗаписьЖурналаРегистрации("Агент1С.ПропущенВызовИнструмента",
						УровеньЖурналаРегистрации.Предупреждение, ИдДиалога,,
						"Модель вернула только вызовы инструментов с пустым именем функции "
						+ "(исполнено вызовов: 0 из " + Строка(ВызовыИнструментов.Количество()) + "). "
						+ "Цикл не продолжается.");
				КонецЕсли;
				
				Для Каждого РезультатИнструмента Из РезультатыИнструментов Цикл
					ДобавитьСообщениеВЦикле(БуферСообщенийИтерации, ИдДиалога, РезультатИнструмента);
					ОтправитьЖивоеПоследнееСообщение(БуферСообщенийИтерации, КонтекстЦикла);
				КонецЦикла;
				
				Результат.НовыеToolСообщения = РезультатыИнструментов;
				Результат.ВызовыИнструментов = ВызовыИнструментов;
			КонецЕсли;
		ИначеЕсли ПричинаЗавершения = "stop" ИЛИ ПричинаЗавершения = "length" ИЛИ ПричинаЗавершения = "content_filter" Тогда
			Если Режим <> Перечисления.СИ_РежимыРаботыАгента.Чат
				И ПричинаЗавершения = "stop"
				И НЕ ПустаяСтрока(КонтентМодели) Тогда
				ИзвлеченныеВызовы = ИзвлечьXMLВызовыИнструментов(КонтентМодели);
				Если ИзвлеченныеВызовы <> Неопределено И ИзвлеченныеВызовы.Количество() > 0 Тогда
					РезультатыИнструментов = ОбработатьВызовыИнструментов(ИзвлеченныеВызовы, КонтекстЦикла);
					
					Если РезультатыИнструментов.Количество() > 0 Тогда
						Продолжать = Истина;
						
						Для Каждого РезультатИнструмента Из РезультатыИнструментов Цикл
							ДобавитьСообщениеВЦикле(БуферСообщенийИтерации, ИдДиалога, РезультатИнструмента);
						КонецЦикла;
						
						Результат.НовыеToolСообщения = РезультатыИнструментов;
						Результат.ВызовыИнструментов = ИзвлеченныеВызовы;
						
						ЗаписьЖурналаРегистрации("Агент1С.XMLЭмуляцияИнструментов", УровеньЖурналаРегистрации.Предупреждение,
							Строка(ИдДиалога),, "Модель выдала XML-разметку вызовов инструментов в тексте ответа. "
							+ "Извлечено вызовов: " + Строка(ИзвлеченныеВызовы.Количество())
							+ ". Выполняем их и продолжаем цикл.");
					Иначе
						Продолжать = Ложь;
						Результат.ТекстОтвета = КонтентМодели;
						ЗаписьЖурналаРегистрации("Агент1С.ПропущенВызовИнструмента",
							УровеньЖурналаРегистрации.Предупреждение, ИдДиалога,,
							"XML-эмуляция: извлечено вызовов " + Строка(ИзвлеченныеВызовы.Количество())
							+ ", но ни один не исполнен (пустые имена / не найдены инструменты). "
							+ "Цикл не продолжается, возвращён текст модели.");
					КонецЕсли;
				Иначе
					Результат.ТекстОтвета = КонтентМодели;
				КонецЕсли;
			Иначе
				Результат.ТекстОтвета = КонтентМодели;
			КонецЕсли;
		КонецЕсли;
		
		Если СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ОжиданиеРазрешения", Неопределено) <> Неопределено Тогда
			Результат.Вставить("ОжиданиеРазрешения", Истина);
		КонецЕсли;

		Результат.ПродолжатьЦикл = Продолжать;
		Результат.ПричинаЗавершения = ПричинаЗавершения;
		Результат.СообщениеМодели = СообщениеМодели;
		Результат.Рассуждения = РассужденияРазобранные;
		
	Исключение
		ТекстВнутреннейОшибки = ОписаниеОшибки();
		Если СтрНайти(НРег(ТекстВнутреннейОшибки), НРег("Прерывание пользователя")) > 0 Тогда
			ЗаписьЖурналаРегистрации("Агент1С.ВыполнитьИтерацию", УровеньЖурналаРегистрации.Информация,
				Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИдДиалога", Неопределено)),,
				"Итерация прервана пользователем");
			Результат.ПричинаЗавершения = "Прерван пользователем";
			Результат.ТекстОшибки = "";
		Иначе
			ЗаписьЖурналаРегистрации("Агент1С.ВыполнитьИтерацию", УровеньЖурналаРегистрации.Ошибка,
				Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИдДиалога", Неопределено)),,
				"Ошибка выполнения итерации: " + ТекстВнутреннейОшибки);
			Результат.ПричинаЗавершения = "Внутренняя ошибка";
			Результат.ТекстОшибки = ТекстВнутреннейОшибки;
		КонецЕсли;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Обрабатывает массив вызовов инструментов ИИ-агента и формирует сообщения в формате role=tool
//
// Параметры:
//  Вызовы - Массив из Структура - массив вызовов инструментов, каждый элемент содержит:
//              * Ид - Строка - идентификатор вызова инструмента
//              * Имя - Строка - имя инструмента для вызова
//              * Аргументы - Произвольный - аргументы для инструмента (JSON-структура или Неопределено)
//  КонтекстЦикла - Структура - контекст текущего цикла обработки сообщений:
//              * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог
//              * Режим - ПеречислениеСсылка.СИ_РежимыРаботыАгента - режим работы
//
// Возвращаемое значение:
//  Массив из Структура - массив сообщений в формате role=tool для отправки в ИИ-агент, каждый элемент содержит:
//           * Роль - Строка - значение "tool"
//           * ИдВызоваИнструмента - Строка - идентификатор вызова инструмента
//           * ИмяИнструмента - Строка - имя выполненного инструмента
//           * Контент - Строка - результат выполнения инструмента или описание ошибки в формате JSON
//           * ДлительностьИсполненияМс - Число - длительность исполнения инструмента в миллисекундах
//           * УспехИсполнения - Булево - признак успешного выполнения инструмента
//
// Пример использования:
//  Вызовы = Новый Массив;
//  Вызов = Новый Структура("Ид,Имя,Аргументы", "call_123", "ПоискДокументов", Новый Структура("Период", "2024-01-01"));
//  Вызовы.Добавить(Вызов);
//  Контекст = Новый Структура("ИдДиалога,Режим", "dialog_001", "Чат");
//  СообщенияTool = СИ_Агент1С.ОбработатьВызовыИнструментов(Вызовы, Контекст);
Функция ОбработатьВызовыИнструментов(Вызовы, КонтекстЦикла) Экспорт
	Результат = Новый Массив;
	
	Попытка
		
		ИдДиалога = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИдДиалога", Неопределено);		
		РежимСсылка = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "РежимСсылка", Справочники.СИ_РежимиРаботы.ПустаяСсылка());
		
		ЗапомненныеРазрешения = ЗапомненныеРазрешенияДиалога(ИдДиалога);
		
		КлючиВызовов = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "КлючиВызовов", Неопределено);
		Если ТипЗнч(КлючиВызовов) <> Тип("Соответствие") Тогда
			КлючиВызовов = Новый Соответствие;
			КонтекстЦикла.Вставить("КлючиВызовов", КлючиВызовов);
		КонецЕсли;
		ПовторовВызовов = Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПовторовВызовов", 0));

		ПропущеноПустыхИмен = 0;
		Для Каждого Вызов Из Вызовы Цикл
			ИдВызова = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Ид", "");
			Имя = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Имя", "");
			Аргументы = СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Аргументы", Неопределено);
			
			Если ТипЗнч(Имя) <> Тип("Строка") ИЛИ ПустаяСтрока(Имя) Тогда
				ПропущеноПустыхИмен = ПропущеноПустыхИмен + 1;
				Продолжить;
			КонецЕсли;

			Если ЭтоВызовЗагрузкиИнструментов(Имя) Тогда
				Результат.Добавить(СообщениеПодгрузкиИнструментов(ИдВызова, Аргументы, КонтекстЦикла));
				Продолжить;
			КонецЕсли;
			
			КонтекстВызова = Новый Структура;
			КонтекстВызова.Вставить("ИдДиалога", ИдДиалога);
			КонтекстВызова.Вставить("ИдВызова", ИдВызова);
			КонтекстВызова.Вставить("Режим", РежимСсылка);
			
			ОписаниеИнструмента = СИ_УправлениеИнструментами1С.ПолучитьОписаниеИнструмента(Имя);
			ТипИнструмента = "1С";
			Если ОписаниеИнструмента <> Неопределено Тогда
				ТипИнструмента = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Тип", "1С");
			КонецЕсли;

			Если ТипИнструмента <> "MCP" Тогда
				Если ТипЗнч(Аргументы) = Тип("Структура") ИЛИ ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
					Аргументы.Вставить("ИдДиалога", ИдДиалога);
					ЕстьПрофильВАргументах = Ложь;
					Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
						ЕстьПрофильВАргументах = Аргументы.Свойство("ПрофильПодключения");
					Иначе
						ЕстьПрофильВАргументах = Аргументы.Получить("ПрофильПодключения") <> Неопределено;
					КонецЕсли;
					Если НЕ ЕстьПрофильВАргументах Тогда
						ПрофильДляИнструмента = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПрофильПодключения", Неопределено);
						Если ПрофильДляИнструмента = Неопределено Тогда
							ПрофильДляИнструмента = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПрофильМодели", Неопределено);
						КонецЕсли;
						Если ПрофильДляИнструмента <> Неопределено Тогда
							Аргументы.Вставить("ПрофильПодключения", ПрофильДляИнструмента);
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли Аргументы = Неопределено Тогда
					Аргументы = Новый Структура("ИдДиалога", ИдДиалога);
					ПрофильДляИнструмента = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПрофильПодключения", Неопределено);
					Если ПрофильДляИнструмента = Неопределено Тогда
						ПрофильДляИнструмента = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПрофильМодели", Неопределено);
					КонецЕсли;
					Если ПрофильДляИнструмента <> Неопределено Тогда
						Аргументы.Вставить("ПрофильПодключения", ПрофильДляИнструмента);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ВозобновлениеРазрешения", Ложь)
				И ТребуетсяРазрешениеПоОписанию(ОписаниеИнструмента, Имя, ЗапомненныеРазрешения) Тогда

				Ожидание = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ОжиданиеРазрешения", Неопределено);
				Если Ожидание = Неопределено Тогда
					Ожидание = Новый Массив;
					КонтекстЦикла.Вставить("ОжиданиеРазрешения", Ожидание);
				КонецЕсли;

				ВызовОжидания = Новый Структура;
				ВызовОжидания.Вставить("Ид", ИдВызова);
				ВызовОжидания.Вставить("Имя", Имя);
				ВызовОжидания.Вставить("Аргументы", Аргументы);
				Ожидание.Добавить(ВызовОжидания);

				ЗаписьЖурналаРегистрации("Агент1С.ЗапросРазрешения", УровеньЖурналаРегистрации.Информация,
					Строка(ИдДиалога),, "Инструмент " + Имя + " ожидает подтверждения пользователя (вызов " + ИдВызова + ").");
				Продолжить;
			КонецЕсли;

			КлючВызова = КлючВызоваИнструмента(Имя, Аргументы);
			РезультатРанее = КлючиВызовов.Получить(КлючВызова);
			Если РезультатРанее <> Неопределено Тогда
				ПовторовВызовов = ПовторовВызовов + 1;
				КонтекстЦикла.Вставить("ПовторовВызовов", ПовторовВызовов);
				ЗаписьЖурналаРегистрации("Агент1С.ПовторВызова", УровеньЖурналаРегистрации.Информация,
					Строка(ИдДиалога),, "Инструмент " + Имя + " вызван повторно с теми же аргументами (повтор № "
					+ Строка(ПовторовВызовов) + "). Модели возвращён результат первого исполнения.");

				СообщениеПовтора = Новый Структура;
				СообщениеПовтора.Вставить("Роль", "tool");
				СообщениеПовтора.Вставить("ИдВызоваИнструмента", ИдВызова);
				СообщениеПовтора.Вставить("ИмяИнструмента", Имя);
				СообщениеПовтора.Вставить("Контент", РезультатРанее);
				СообщениеПовтора.Вставить("ДлительностьИсполненияМс", 0);
				СообщениеПовтора.Вставить("УспехИсполнения", Истина);
				СообщениеПовтора.Вставить("Действие", ДействиеИнструментаЗахода(КонтекстЦикла, Имя));
				Результат.Добавить(СообщениеПовтора);
				Продолжить;
			КонецЕсли;

			РезультатИнструмента = СИ_УправлениеИнструментами1С.ВызватьИнструмент(Имя, Аргументы, КонтекстВызова);
			
			Если ТипЗнч(Аргументы) = Тип("Структура") ИЛИ ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
				Аргументы.Удалить("ИдДиалога");
				Аргументы.Удалить("ПрофильПодключения");
			КонецЕсли;
			
			СообщениеTool = Новый Структура;
			СообщениеTool.Вставить("Роль", "tool");
			СообщениеTool.Вставить("ИдВызоваИнструмента", ИдВызова);
			СообщениеTool.Вставить("ИмяИнструмента", Имя);
			СообщениеTool.Вставить("Действие", ДействиеИнструментаЗахода(КонтекстЦикла, Имя));
			
			Успех = СИ_РаботаСJSON.БезопасноПолучить(РезультатИнструмента, "Успех", Ложь);

			Если НЕ Успех Тогда
				КонтекстЦикла.Вставить("ОшибокИнструментов",
					Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ОшибокИнструментов", 0)) + 1);
			КонецЕсли;

			МаркерФайла = "";
			Если Успех Тогда
				КонтентИнструмента = СИ_РаботаСJSON.БезопасноПолучить(РезультатИнструмента, "Результат", "");

				Если ПустаяСтрока(КонтентИнструмента) Тогда
					// Успех при пустом контенте - потеря результата после выполнения
					// (ошибка сериализации/гигиены в реестре): модель получала пустой
					// ответ и делала вывод «данных нет». Вместо молчаливой пустоты -
					// явная ошибка в контенте.
					ТекстПотери = "Инструмент " + Имя
						+ " завершился успешно, но результат не передан модели."
						+ " ОшибкаИсполнения: " + Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатИнструмента, "ОшибкаИсполнения", ""));
					ЗаписьЖурналаРегистрации("Агент1С.ПустойРезультатИнструмента",
						УровеньЖурналаРегистрации.Предупреждение, Строка(ИдДиалога),, ТекстПотери);
					КонтентИнструмента = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(
						Новый Структура("Ошибка", ТекстПотери));
				КонецЕсли;

				Если Имя = "CreateDialogFile" ИЛИ Имя = "UpdateDialogFile" ИЛИ Имя = "DrawMermaid"
					ИЛИ Имя = "ExportTable" ИЛИ Имя = "DrawChart" Тогда
					УИДФайла = "";
					ИмяСозданногоФайла = "";

					Попытка
						ПарсерJSON = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(КонтентИнструмента);
						Если ТипЗнч(ПарсерJSON) = Тип("Структура") ИЛИ ТипЗнч(ПарсерJSON) = Тип("Соответствие") Тогда
							УИДФайла = Строка(СИ_РаботаСJSON.БезопасноПолучить(ПарсерJSON, "Ссылка", ""));
							ИмяСозданногоФайла = Строка(СИ_РаботаСJSON.БезопасноПолучить(ПарсерJSON, "ИмяФайла", ""));
						КонецЕсли;
					Исключение
						УИДФайла = "";
						ИмяСозданногоФайла = "";
					КонецПопытки;

					Если НЕ ПустаяСтрока(УИДФайла) Тогда
						Если СтрНайти(КонтентИнструмента, "file:" + УИДФайла) = 0 Тогда
							МаркерФайла = Символы.ПС + Символы.ПС + "Файл сохранён: file:" + УИДФайла;
						КонецЕсли;

						СозданныеФайлы = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "СозданныеФайлы", Неопределено);
						Если СозданныеФайлы = Неопределено ИЛИ ТипЗнч(СозданныеФайлы) <> Тип("Массив") Тогда
							СозданныеФайлы = Новый Массив;
							КонтекстЦикла.Вставить("СозданныеФайлы", СозданныеФайлы);
						КонецЕсли;

						УжеЕсть = Ложь;
						Для Каждого СуществующийФайл Из СозданныеФайлы Цикл
							Если Строка(СИ_РаботаСJSON.БезопасноПолучить(СуществующийФайл, "УИД", "")) = УИДФайла Тогда
								УжеЕсть = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если НЕ УжеЕсть Тогда
							СозданныеФайлы.Добавить(Новый Структура("ИмяФайла, УИД", ИмяСозданногоФайла, УИДФайла));
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

				КонтентДляМодели = ОбрезатьРезультатИнструмента(КонтентИнструмента, Имя);
				Если НЕ ПустаяСтрока(МаркерФайла) И ТипЗнч(КонтентДляМодели) = Тип("Строка") Тогда
					КонтентДляМодели = КонтентДляМодели + МаркерФайла;
				КонецЕсли;
				СообщениеTool.Вставить("Контент", КонтентДляМодели);

				СсылкиДокументовИнструмента = СИ_РаботаСJSON.БезопасноПолучить(
					РезультатИнструмента, "СсылкиДокументов", Неопределено);
				Если ТипЗнч(СсылкиДокументовИнструмента) = Тип("Массив")
					И СсылкиДокументовИнструмента.Количество() > 0 Тогда
					СообщениеTool.Вставить("СсылкиДокументов", СсылкиДокументовИнструмента);
				КонецЕсли;

				ДиаграммаИнструмента = СИ_РаботаСJSON.БезопасноПолучить(
					РезультатИнструмента, "Диаграмма", Неопределено);
				Если ТипЗнч(ДиаграммаИнструмента) = Тип("Структура") Тогда
					СообщениеTool.Вставить("Диаграмма", ДиаграммаИнструмента);
				КонецЕсли;
			Иначе
				Ошибка = СИ_РаботаСJSON.БезопасноПолучить(РезультатИнструмента, "ОшибкаИсполнения", "Неизвестная ошибка");
				ОшибкаСтруктура = Новый Структура("Ошибка", Ошибка);
				СообщениеTool.Вставить("Контент", ОбрезатьРезультатИнструмента(СИ_РаботаСJSON.ЗаписатьСтрокуJSON(ОшибкаСтруктура), Имя));
			КонецЕсли;
			
			ДлительностьМс = СИ_РаботаСJSON.БезопасноПолучить(РезультатИнструмента, "ДлительностьМс", 0);
			СообщениеTool.Вставить("ДлительностьИсполненияМс", ДлительностьМс);
			СообщениеTool.Вставить("УспехИсполнения", Успех);

			Если Успех И ТипЗнч(СообщениеTool.Контент) = Тип("Строка") Тогда
				КлючиВызовов.Вставить(КлючВызова, СообщениеTool.Контент);
			КонецЕсли;
			
			Результат.Добавить(СообщениеTool);
		КонецЦикла;
		
		Если ПропущеноПустыхИмен > 0 Тогда
			ЗаписьЖурналаРегистрации("Агент1С.ПропущенВызовИнструмента",
				УровеньЖурналаРегистрации.Предупреждение, ИдДиалога,,
				"Пропущено вызовов инструментов с пустым именем функции: " + Строка(ПропущеноПустыхИмен)
				+ " из " + Строка(Вызовы.Количество()) + ".");
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ОбработатьВызовыИнструментов", УровеньЖурналаРегистрации.Ошибка,
			Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИдДиалога", Неопределено)),,
			"Ошибка обработки вызовов инструментов: " + ОписаниеОшибки());
		ДополнитьНевыполненныеВызовы(Вызовы, Результат, ОписаниеОшибки(), КонтекстЦикла);
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

// Собирает параметры для отправки запроса к AI-агенту.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст диалога с полями:
//                  * Режим - ПеречислениеСсылка.СИ_РежимыРаботыАгента - режим работы агента
//                  * Сообщения - Массив из Структура - история сообщений диалога
//                  * ДопПараметры - Структура,Неопределено - дополнительные параметры:
//                    ** Модель - Строка - идентификатор модели
//                    ** Температура - Число - параметр случайности (0.0 - 2.0)
//                    ** MaxTokens - Число,Неопределено - максимальное количество токенов в ответе
//                    ** ИменаИнструментов - Массив из Строка - список доступных инструментов
//                    ** ИнструментыПервогоШага - Массив из Строка,Неопределено - набор
//                       инструментов ТОЛЬКО для первой итерации захода (плитки ролей:
//                       первый шаг должен вызвать одну сводку). Со второй итерации
//                       или после ошибки инструмента действует полный набор.
//                    ** СхемаJSON - Произвольный - схема JSON-ответа для режима Structured
//                  * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог (для логирования)
//
// Возвращаемое значение:
//  Структура - параметры запроса с полями:
//              * Модель - Произвольный,Неопределено,Строка - используемая модель
//              * Профиль - Произвольный,СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения для вызова
//              * Настройки - Структура,Неопределено - уже прочитанные настройки агента (оптимизация:
//                исключает повторный запрос к БД в СИ_ОpenAIКлиент)
//              * Сообщения - Неопределено,Произвольный, Массив из Строка - история сообщений (возможно обрезанная по токенам; элементы - Структура)
//              * Инструменты - Массив из Структура,Неопределено - список инструментов для ToolCalling/Чат
//              * ВыборИнструмента - Строка,Неопределено - режим выбора (auto) для ToolCalling
//              * РазрешитьРассуждения - Булево,Произвольный,Неопределено - признак разрешения режима рассуждений (reasoning)
//              * ОтключитьРассуждения - Булево,Неопределено - флаг принудительного отключения рассуждений для оптимизации
//              * Температура - Число - температура запроса
//              * MaxTokens - Число,Неопределено - лимит токенов ответа
//              * ФорматОтвета - Соответствие из Строка, Произвольный,Неопределено - формат ответа для режима Structured
// Сжатие истории на итерациях цикла (Вариант A) - только безопасный Уровень 1:
// без сводки моделью и без схлопывания tool-пар. Полное сжатие (в т.ч. сводка)
// выполняется один раз в ЗапуститьАгента перед началом цикла.
Функция СобратьПараметрыЗапроса(КонтекстЦикла) Экспорт
	ПараметрыЗапроса = Новый Структура;
	
	Попытка
		Настройки = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Настройки", Неопределено);
		Если Настройки = Неопределено Тогда
			Настройки = СИ_НастройкиАгента.ПолучитьНастройки();
		КонецЕсли;
		
		ПрофильМодели = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПрофильМодели", Неопределено);
		
		ДопПараметры = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ДопПараметры", Неопределено);
		
		ПрофильПодключения = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПрофильПодключения", Неопределено);
		
		Модель = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Модель", "");
		Если ПустаяСтрока(Модель) И ДопПараметры <> Неопределено Тогда
			Модель = СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "Модель", "");
		КонецЕсли;
		Если ПустаяСтрока(Модель) Тогда
			Модель = СИ_НастройкиАгента.ПолучитьМодельПоУмолчанию(ПрофильПодключения);
			Если ПустаяСтрока(Модель) Тогда
				Модель = Настройки.МодельПоУмолчанию;
			КонецЕсли;
		КонецЕсли;
		ПараметрыЗапроса.Вставить("Модель", Модель);
		
		Если ПрофильПодключения <> Неопределено И ЗначениеЗаполнено(ПрофильПодключения) Тогда
			ПараметрыЗапроса.Вставить("Профиль", ПрофильПодключения);
		КонецЕсли;
		
		Сообщения = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Сообщения", Новый Массив);
		
		Сообщения = СообщенияБезСлужебныхРолей(Сообщения);

		НомерИтерации = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "СчетчикИтераций", 0);
		Сообщения = СИ_УправлениеДиалогом.СжатьВложенияНаИтерации(Сообщения, НомерИтерации);
		
		КонтекстОкно = КонтекстОкноПоУмолчанию();
		Если ПрофильМодели <> Неопределено Тогда
			КонтекстОкно = СИ_РаботаСJSON.БезопасноПолучить(ПрофильМодели, "КонтекстОкно", КонтекстОкноПоУмолчанию());
		КонецЕсли;
		ПроцентОкнаДляИстории = Число(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ПроцентОкнаДляИстории", ПроцентОкнаДляИсторииПоУмолчанию()));
		Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("ПроцентОкнаДляИстории") Тогда
			ПроцентОкнаДляИстории = Число(ДопПараметры.ПроцентОкнаДляИстории);
		КонецЕсли;
		Если ПроцентОкнаДляИстории <= 0 ИЛИ ПроцентОкнаДляИстории > 1 Тогда
			ПроцентОкнаДляИстории = ПроцентОкнаДляИсторииПоУмолчанию();
		КонецЕсли;
		ЛимитТокенов = Цел(КонтекстОкно * ПроцентОкнаДляИстории);
		
		Если Сообщения.Количество() > КоличествоСообщенийДляСжатия() Тогда
			ПараметрыСжатия = Новый Структура;
			ПараметрыСжатия.Вставить("Модель", Модель);
			ПараметрыСжатия.Вставить("Профиль", ПрофильПодключения);
			
			ПараметрыСжатия.Вставить("ИспользоватьСводку", Ложь);
			ПараметрыСжатия.Вставить("СхлопыватьToolПары", Ложь);
			ПараметрыСжатия.Вставить("МаксТокеновСводки",
				Число(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "МаксТокеновСводки", 1500)));
			ПараметрыСжатия.Вставить("КоличествоСвежих",
				Число(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "КоличествоСвежихСообщений", 10)));
			ПараметрыСжатия.Вставить("МаксДлинаToolРезультата",
				Число(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "МаксДлинаToolРезультата", 4000)));
			ПараметрыСжатия.Вставить("МаксДлинаСообщения",
				Число(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "МаксДлинаСообщения", 4000)));
			
			Если ДопПараметры <> Неопределено Тогда
				Если ДопПараметры.Свойство("МаксТокеновСводки") Тогда
					ПараметрыСжатия.МаксТокеновСводки = ДопПараметры.МаксТокеновСводки;
				КонецЕсли;
				Если ДопПараметры.Свойство("КоличествоСвежих") Тогда
					ПараметрыСжатия.КоличествоСвежих = ДопПараметры.КоличествоСвежих;
				КонецЕсли;
				Если ДопПараметры.Свойство("МаксДлинаToolРезультата") Тогда
					ПараметрыСжатия.МаксДлинаToolРезультата = ДопПараметры.МаксДлинаToolРезультата;
				КонецЕсли;
				Если ДопПараметры.Свойство("МаксДлинаСообщения") Тогда
					ПараметрыСжатия.МаксДлинаСообщения = ДопПараметры.МаксДлинаСообщения;
				КонецЕсли;
			КонецЕсли;
			
			РезультатСжатия = СИ_УправлениеДиалогом.СжатьИсторию(Сообщения, ЛимитТокенов, ПараметрыСжатия);
			Сообщения = СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатия, "Сообщения", Сообщения);
			
			Если СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатия, "ИспользованаСводка", Ложь) Тогда
				ТекстСводки = СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатия, "Сводка", "");
				Если НЕ ПустаяСтрока(ТекстСводки) Тогда
					КонтекстЦикла.Вставить("СводкаДиалога", ТекстСводки);
				КонецЕсли;
			КонецЕсли;
			
			Если СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатия, "ПримененоСжатие", Ложь) Тогда
				Попытка
					ЗаписьЖурналаРегистрации("Агент1С.СжатиеИстории", УровеньЖурналаРегистрации.Информация,,
						"Было сообщений: " + Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатия, "БылоСообщений", 0))
						+ " | Стало: " + Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатия, "СталоСообщений", 0))
						+ " | Сводка: " + Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатия, "ИспользованаСводка", Ложь))
						+ " | Модель: " + Модель);
				Исключение
					ЗаписьЖурналаРегистрации("Агент1С.СжатиеИстории", УровеньЖурналаРегистрации.Предупреждение,
						Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИдДиалога", Неопределено)),,
						"Ошибка логирования сжатия истории: " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если Настройки <> Неопределено И ТипЗнч(Настройки) = Тип("Структура") Тогда
			ПараметрыЗапроса.Вставить("Настройки", Настройки);
		КонецЕсли;
		Если СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ФинальныйШаг", Ложь) Тогда
			СообщенияСНапоминанием = Новый Массив;
			Для Каждого СообщениеИстории Из Сообщения Цикл
				СообщенияСНапоминанием.Добавить(СообщениеИстории);
			КонецЦикла;
			Напоминание = Новый Структура;
			Напоминание.Вставить("Роль", "user");
			Напоминание.Вставить("Контент", "(Сообщение системы: доступ к инструментам завершён - достигнут лимит шагов, "
				+ "повторов вызовов или времени. Сформируй финальный ответ пользователю из уже полученных данных; "
				+ "если данных недостаточно, укажи, что удалось сделать и каких данных не хватило.)");
			СообщенияСНапоминанием.Добавить(Напоминание);
			Сообщения = СообщенияСНапоминанием;
		КонецЕсли;

		Сообщения = СообщенияБезСлужебныхКлючей(Сообщения);

		ПараметрыЗапроса.Вставить("Сообщения", Сообщения);
		
		Температура = Настройки.Температура;
		Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("Температура") Тогда
			Температура = ДопПараметры.Температура;
		ИначеЕсли КонтекстЦикла.Свойство("ТемператураРежима") Тогда
			ТемператураИзРежима = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ТемператураРежима", Неопределено);
			Если ТемператураИзРежима <> Неопределено Тогда
				Температура = Число(ТемператураИзРежима);
			КонецЕсли;
		КонецЕсли;
		ПараметрыЗапроса.Вставить("Температура", Температура);
		
		MaxTokens = Настройки.MaxTokens;
		Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("MaxTokens") Тогда
			MaxTokens = ДопПараметры.MaxTokens;
		ИначеЕсли ПрофильМодели <> Неопределено И ПрофильМодели.Свойство("MaxTokens")
			И ПрофильМодели.MaxTokens <> Неопределено Тогда
			MaxTokens = ПрофильМодели.MaxTokens;
		КонецЕсли;
		
		Если MaxTokens <> Неопределено И ТипЗнч(MaxTokens) = Тип("Число") Тогда
			ОценкаВходаДляMaxTokens = СИ_УправлениеДиалогом.ОценитьТокеныИстории(Сообщения);
			ДоступноПодОтвет = Цел(КонтекстОкно) - ОценкаВходаДляMaxTokens - ЗапасКонтекстаДляMaxTokens(КонтекстОкно);
			Если ДоступноПодОтвет < 1 Тогда
				ДоступноПодОтвет = 1;
			КонецЕсли;
			Если MaxTokens > ДоступноПодОтвет Тогда
				Попытка
					ЗаписьЖурналаРегистрации("Агент1С.MaxTokensОграничение", УровеньЖурналаРегистрации.Информация,
						Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИдДиалога", Неопределено)),,
						"MaxTokens ограничен: было " + Строка(MaxTokens) + ", стало " + Строка(ДоступноПодОтвет)
						+ " (контекст " + Строка(КонтекстОкно) + ", вход ~" + Строка(ОценкаВходаДляMaxTokens) + ")");
				Исключение
				КонецПопытки;
				MaxTokens = ДоступноПодОтвет;
			КонецЕсли;
		КонецЕсли;
		Если MaxTokens <> Неопределено Тогда
			ПараметрыЗапроса.Вставить("MaxTokens", MaxTokens);
		КонецЕсли;
		
		РазрешитьРассуждения = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "РазрешитьРассуждения", Ложь);
		ПараметрыЗапроса.Вставить("РазрешитьРассуждения", РазрешитьРассуждения);
		
		Режим = КонтекстЦикла.Режим;
		Если Режим <> Перечисления.СИ_РежимыРаботыАгента.Чат Тогда
			
			ПоследнееСообщениеTool = Ложь;
			Если Сообщения.Количество() > 0 Тогда
				ПоследнееСообщение = Сообщения[Сообщения.Количество() - 1];
				РольПоследнего = СИ_РаботаСJSON.БезопасноПолучить(ПоследнееСообщение, "Роль", "");
				Если ПустаяСтрока(РольПоследнего) Тогда
					РольПоследнего = СИ_РаботаСJSON.БезопасноПолучить(ПоследнееСообщение, "role", "");
				КонецЕсли;
				Если РольПоследнего = "tool" Тогда
					ПоследнееСообщениеTool = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ПоследнееСообщениеTool И РазрешитьРассуждения Тогда
				ПараметрыЗапроса.Вставить("ОтключитьРассуждения", Истина);
			КонецЕсли;
			
			// Схема tools передаётся и в шагах после результатов инструментов, а не
			// только в первом запросе: без неё малые модели начинают «эмулировать»
			// вызовы инструментов XML-текстом в обычном ответе вместо function calling.
			// Принудительное отключение — только осознанно, через ПропускатьИнструментыПослеРезультата.
			ПропускатьИнструменты = Ложь;
			Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("ПропускатьИнструментыПослеРезультата") Тогда
				ПропускатьИнструменты = ДопПараметры.ПропускатьИнструментыПослеРезультата;
			КонецЕсли;
			
			ФинальныйШагОтправки = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ФинальныйШаг", Ложь);
			Если НЕ (ПропускатьИнструменты И ПоследнееСообщениеTool) И НЕ ФинальныйШагОтправки Тогда
				ИменаИнструментов = Неопределено;
				Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("ИменаИнструментов") Тогда
					ИменаИнструментов = ДопПараметры.ИменаИнструментов;
				КонецЕсли;

				ИнструментыПервогоШага = Неопределено;
				Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("ИнструментыПервогоШага") Тогда
					ИнструментыПервогоШага = ДопПараметры.ИнструментыПервогоШага;
				КонецЕсли;
				Если ТипЗнч(ИнструментыПервогоШага) = Тип("Массив") И ИнструментыПервогоШага.Количество() > 0
					И НомерИтерации <= 1
					И Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ОшибокИнструментов", 0)) = 0 Тогда
					ИменаИнструментов = ИнструментыПервогоШага;
				КонецЕсли;
				
				Инструменты = СхемыИнструментовДляШага(КонтекстЦикла, ИменаИнструментов);
				Если Инструменты <> Неопределено И Инструменты.Количество() > 0 Тогда
					ПараметрыЗапроса.Вставить("Инструменты", Инструменты);
					
					Если Режим = Перечисления.СИ_РежимыРаботыАгента.ToolCalling Тогда
						ПараметрыЗапроса.Вставить("ВыборИнструмента", "auto");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			ЕстьИнстр = ПараметрыЗапроса.Свойство("Инструменты");
			КолИнстр = 0;
			ИменаИнстр = "нет";
			Если ЕстьИнстр Тогда
				МассивИнстр = ПараметрыЗапроса.Инструменты;
				КолИнстр = МассивИнстр.Количество();
				ИменаИнстр = "";
				Для Каждого Инстр Из МассивИнстр Цикл
					ФункцияОб = Инстр.Получить("function");
					ИмяФ = ?(ФункцияОб <> Неопределено, ФункцияОб.Получить("name"), "?");
					ИменаИнстр = ИменаИнстр + ?(ПустаяСтрока(ИменаИнстр), "", ", ") + ИмяФ;
				КонецЦикла;
			КонецЕсли;
			ЕстьВыбор = ПараметрыЗапроса.Свойство("ВыборИнструмента");
			ЗаписьЖурналаРегистрации("Агент1С.Debug.СобранныеПараметры", УровеньЖурналаРегистрации.Информация,,
				"Режим=" + Строка(Режим) + " | ТипРежима=" + Строка(ТипЗнч(Режим))
				+ " | ЕстьИнструменты=" + Строка(ЕстьИнстр)
				+ " | КолИнструментов=" + Строка(КолИнстр)
				+ " | Имена=" + ИменаИнстр
				+ " | ЕстьВыборИнструмента=" + Строка(ЕстьВыбор));
		Исключение
			ЗаписьЖурналаРегистрации("Агент1С.Debug.СобранныеПараметры", УровеньЖурналаРегистрации.Ошибка,,
				"Ошибка при сборе диагностических параметров: " + ОписаниеОшибки());
		КонецПопытки;
		
		Если Режим = Перечисления.СИ_РежимыРаботыАгента.Structured Тогда
			ФорматОтвета = Новый Соответствие;
			ФорматОтвета.Вставить("type", "json_object");
			
			СхемаJSON = Неопределено;
			Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("СхемаJSON") Тогда
				СхемаJSON = ДопПараметры.СхемаJSON;
			КонецЕсли;
			
			Если СхемаJSON <> Неопределено Тогда
				ФорматОтвета.Вставить("type", "json_schema");
				СхемаОбъект = Новый Соответствие;
				СхемаОбъект.Вставить("name", "structured_response");
				СхемаОбъект.Вставить("schema", СхемаJSON);
				СхемаОбъект.Вставить("strict", Истина);
				ФорматОтвета.Вставить("json_schema", СхемаОбъект);
			КонецЕсли;
			
			ПараметрыЗапроса.Вставить("ФорматОтвета", ФорматОтвета);
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.СобратьПараметрыЗапроса", УровеньЖурналаРегистрации.Ошибка,
			Строка(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИдДиалога", Неопределено)),,
			"Ошибка сборки параметров: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ПараметрыЗапроса;
КонецФункции

// Проверяет ограничения цикла на количество итераций и использование токенов
//
// Параметры:
//  КонтекстЦикла - Структура - контекст выполнения цикла с полями:
//                         * МаксИтераций - Число - максимальное количество итераций (по умолчанию 10)
//                         * СчетчикИтераций - Число - текущая итерация (по умолчанию 0)
//                         * ИспользованоТокенов - Число - количество использованных токенов (по умолчанию 0)
//
// Возвращаемое значение:
//  Структура - результат проверки с полями:
//                 * ПревышенЛимит - Булево - Истина, если превышено хотя бы одно ограничение
//                 * Причина - Строка - код причины превышения ("MaxIterations", "MaxTokens", "InternalError")
//
Функция ПроверитьОграничения(КонтекстЦикла) Экспорт
	РезультатПроверки = Новый Структура("ПревышенЛимит, Причина, МягкийЛимит", Ложь, "", Ложь);
	
	Попытка
		ТекущаяИтерация = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "СчетчикИтераций", 0);
		Если ТекущаяИтерация > ЗащитныйЛимитИтерацийСессии() Тогда
			РезультатПроверки.ПревышенЛимит = Истина;
			РезультатПроверки.Причина = ПричинаHardIterations();
			Возврат РезультатПроверки;
		КонецЕсли;
		
		МаксИтераций = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "МаксИтераций", 10);
		Если ТекущаяИтерация > МаксИтераций Тогда
			РезультатПроверки.ПревышенЛимит = Истина;
			РезультатПроверки.Причина = ПричинаMaxIterations();
			РезультатПроверки.МягкийЛимит = Истина;
			Возврат РезультатПроверки;
		КонецЕсли;
		
		ИспользованоТокенов = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИспользованоТокенов", 0);
		ЛимитТокенов = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ЛимитТокеновНаОтвет",
			СИ_НастройкиАгента.ПолучитьЛимитТокеновНаОтвет());
		Если ИспользованоТокенов > ЛимитТокенов Тогда
			РезультатПроверки.ПревышенЛимит = Истина;
			РезультатПроверки.Причина = ПричинаMaxTokens();
			Возврат РезультатПроверки;
		КонецЕсли;
		
	Исключение
		РезультатПроверки.ПревышенЛимит = Истина;
		РезультатПроверки.Причина = ПричинаInternalError();
	КонецПопытки;
	
	Возврат РезультатПроверки;
КонецФункции

// Запускает агента в фоновом режиме с обработкой исключений и записью в журнал регистрации
//
// Параметры:
//   ПараметрыЗапроса - Структура - параметры для запуска агента
//   АдресРезультата - Строка - адрес временного хранилища результата; добавляется БСП
//    вторым параметром при запуске через ДлительныеОперации.ВыполнитьВФоне. Прямой запуск
//    через ФоновыеЗадания.Выполнить с одним параметром остаётся допустимым.
Процедура ЗапуститьАгентаФоново(ПараметрыЗапроса, АдресРезультата = "") Экспорт
	Попытка
		// Длительные операции БСП стартуют в безопасном режиме: он блокирует файловые
		// операции (запись XLSX и временных файлов в ExportTable/DrawChart/RecognizeImage).
		// Доступ инструментов ограничивает сам агент (запрещенные объекты, подтверждение
		// вызовов), поэтому безопасный режим для задания агента отключается.
		Попытка
			Если БезопасныйРежим() <> Ложь Тогда
				УстановитьБезопасныйРежим(Ложь);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("Агент1С.ФоновыйЗапуск", УровеньЖурналаРегистрации.Предупреждение,,
				, "Не удалось отключить безопасный режим: " + ОписаниеОшибки());
		КонецПопытки;

		ИдДиалогаДляЖурнала = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "ИдДиалога", Неопределено);
		ЗаписьЖурналаРегистрации("Агент1С.ФоновыйЗапуск", УровеньЖурналаРегистрации.Информация,
			Строка(ИдДиалогаДляЖурнала),,
			"Фоновое задание СТАРТОВАЛО. Режим=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Режим", ""))
			+ " | Модель=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Модель", ""))
			+ " | ДопПараметры.ТипВложения=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "ДопПараметры", Неопределено), "ТипВложения", "нет")));

		Результат = ЗапуститьАгента(ПараметрыЗапроса);

		Если НЕ ПустаяСтрока(АдресРезультата) Тогда
			Попытка
				ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
			Исключение
				ЗаписьЖурналаРегистрации("Агент1С.ФоновыйЗапуск", УровеньЖурналаРегистрации.Предупреждение,,
					, "Не удалось поместить результат в адрес результата БСП: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("Агент1С.ФоновыйЗапуск", УровеньЖурналаРегистрации.Информация,,
			, "Фоновое задание завершено: Успех = " + Строка(Результат.Успех)
			+ ", ИдДиалога = " + Строка(Результат.ИдДиалога)
			+ ", ПричинаЗавершения = " + Строка(СИ_РаботаСJSON.БезопасноПолучить(Результат, "ПричинаЗавершения", ""))
			+ ", КоличествоИтераций = " + Строка(СИ_РаботаСJSON.БезопасноПолучить(Результат, "КоличествоИтераций", 0))
			+ ", ИспользованоТокеновЗаЗаход = " + Строка(СИ_РаботаСJSON.БезопасноПолучить(Результат, "ИспользованоТокенов", 0))
			+ ", ЛимитИтерацийЖёсткий = " + Строка(ЗащитныйЛимитИтерацийСессии())
			+ ", ЛимитТокеновНаОтвет = " + Строка(ЗащитныйЛимитТокеновНаОтвет())
			+ ", Ошибок = " + Строка(СИ_РаботаСJSON.БезопасноПолучить(Результат, "Ошибки", Новый Массив).Количество()));
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ФоновыйЗапуск", УровеньЖурналаРегистрации.Ошибка,,
			, "Ошибка фонового задания: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбщиеПомощникиЗахода

// Числовой реквизит настроек агента с безопасным доступом и значением по умолчанию.
//
// Параметры:
//  Настройки - Структура - настройки профиля подключения (СИ_НастройкиАгента.ПолучитьНастройки).
//  ИмяКлюча - Строка - имя ключа настроек.
//  ПоУмолчанию - Число - значение, если ключ отсутствует.
//
// Возвращаемое значение:
//  Число - значение настройки.
Функция ЧислоНастройки(Настройки, ИмяКлюча, ПоУмолчанию)
	Возврат Число(СИ_РаботаСJSON.БезопасноПолучить(Настройки, ИмяКлюча, ПоУмолчанию));
КонецФункции

// Записывает реквизиты диалога через ядро записи СИ_УправлениеДиалогом.ЗаписатьРеквизитыДиалога:
// блокировка данных ДО чтения объекта, повтор при конфликте записи.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  ЗначенияЗаписи - Структура - значения реквизитов диалога для записи.
//  ИмяОперации - Строка - имя операции для диагностики.
//  ТолькоСвойЗаход - Булево - запись только если активный заход принадлежит текущему фоновому заданию.
//
// Возвращаемое значение:
//  Булево - Истина, если запись выполнена.
Функция ЗаписатьРеквизитыДиалогаЗахода(ИдДиалога, ЗначенияЗаписи, ИмяОперации, ТолькоСвойЗаход = Ложь)
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("ИмяОперации", ИмяОперации);
	Если ТолькоСвойЗаход Тогда
		ПараметрыЗаписи.Вставить("ТребуемыйАктивноеЗаданиеИд", СИ_УправлениеДиалогом.ИдТекущегоФоновогоЗадания());
		ПараметрыЗаписи.Вставить("ТолькоСвойАктивныйЗаход", Истина);
	КонецЕсли;
	Возврат СИ_УправлениеДиалогом.ЗаписатьРеквизитыДиалога(ИдДиалога, ЗначенияЗаписи, ПараметрыЗаписи);
КонецФункции

#КонецОбласти

#Область ПодготовкаЗаходаАгента

// Создаёт структуру результата запуска агента со всеми ключами публичного контракта.
//
// Возвращаемое значение:
//  Структура - результат работы агента:
//   * Успех - Булево - признак успешного выполнения;
//   * ИтоговыйТекст - Строка - текст ответа агента;
//   * ВызовыИнструментов - Массив из Структура - журнал вызовов инструментов за сессию;
//   * КоличествоИтераций - Число - количество выполненных итераций;
//   * ИспользованоТокенов - Число - общее количество токенов за сессию;
//   * ПромптТокены - Число - суммарное количество входных токенов;
//   * ИдДиалога - Неопределено,СправочникСсылка.СИ_ДиалогиАгента - диалог захода;
//   * Ошибки - Массив из Строка - список возникших ошибок;
//   * ПричинаЗавершения - Строка - причина преждевременного завершения.
Функция ИнициализироватьРезультатЗапуска()
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ИтоговыйТекст", "");
	Результат.Вставить("ВызовыИнструментов", Новый Массив);
	Результат.Вставить("КоличествоИтераций", 0);
	Результат.Вставить("ИспользованоТокенов", 0);
	Результат.Вставить("ПромптТокены", 0);
	Результат.Вставить("ИдДиалога", Неопределено);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("ПричинаЗавершения", "");
	Возврат Результат;
КонецФункции

// Извлекает из запроса режим работы агента с его реквизитами, входные параметры захода,
// флаги двухфазного запуска и нормализованный массив вложений.
//
// Параметры:
//  ПараметрыЗапроса - Структура - параметры запуска агента (см. ЗапуститьАгента).
//
// Возвращаемое значение:
//  Структура - параметры захода:
//   * РежимСсылка - СправочникСсылка.СИ_РежимиРаботы,Строка,Произвольный,Неопределено - режим работы агента;
//   * РежимEnum - ПеречислениеСсылка.СИ_РежимыРаботыАгента - тип режима;
//   * СистемныйПромптИзСправочника - Строка - системный промпт режима;
//   * МодельРежима - Строка - модель из режима;
//   * ПрофильРежима - СправочникСсылка.СИ_ПрофилиПодключений - профиль из режима;
//   * ТемператураРежима - Число,Неопределено - температура из режима;
//   * МодельРаспознованияКартинокРежима - Строка - vision-модель режима;
//   * ПрофильРаспознованияКартинокРежима - СправочникСсылка.СИ_ПрофилиПодключений - профиль vision-модели режима;
//   * ЗапросПользователя - Произвольный,Неопределено - текст запроса пользователя (Строка);
//   * ИдДиалога - Произвольный,Неопределено - существующий диалог (СправочникСсылка.СИ_ДиалогиАгента);
//   * ДопПараметры - Произвольный,Неопределено - дополнительные параметры захода (Структура);
//   * ЭтоВозобновление - Булево - заход возобновляется после запроса разрешения;
//   * РешенияРазрешений - Произвольный,Неопределено - решения пользователя по вызовам (массив структур);
//   * КастомныйПромпт - Строка,Неопределено - кастомный системный промпт;
//   * Вложения - Массив из Структура - нормализованные вложения захода.
Функция ПодготовитьПараметрыЗапуска(ПараметрыЗапроса)
	ПараметрыЗапуска = Новый Структура;

	РежимСсылка = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Режим", Справочники.СИ_РежимиРаботы.ПустаяСсылка());
	Если ТипЗнч(РежимСсылка) = Тип("Строка") И НЕ ПустаяСтрока(РежимСсылка) Тогда
		РежимСсылка = Справочники.СИ_РежимиРаботы.НайтиПоНаименованию(РежимСсылка);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(РежимСсылка) Тогда
		РежимСсылка = Константы.СИ_АктивныйРежим.Получить();
	КонецЕсли;

	РежимEnum = Перечисления.СИ_РежимыРаботыАгента.Чат;
	СистемныйПромптИзСправочника = "";
	МодельРежима = "";
	ПрофильРежима = Справочники.СИ_ПрофилиПодключений.ПустаяСсылка();
	ТемператураРежима = Неопределено;
	МодельРаспознованияКартинокРежима = "";
	ПрофильРаспознованияКартинокРежима = Справочники.СИ_ПрофилиПодключений.ПустаяСсылка();
	Если ЗначениеЗаполнено(РежимСсылка) Тогда
		Попытка
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РежимСсылка,
				"ТипРежима, СистемныйПромпт, Модель, Профиль, Температура, МодельРаспознованияКартинок, ПрофильРаспознованияКартинок");
			РежимEnum = ЗначенияРеквизитов.ТипРежима;
			СистемныйПромптИзСправочника = ЗначенияРеквизитов.СистемныйПромпт;
			МодельРежима = ЗначенияРеквизитов.Модель;
			ПрофильРежима = ЗначенияРеквизитов.Профиль;
			ТемператураРежима = ЗначенияРеквизитов.Температура;
			МодельРаспознованияКартинокРежима = ЗначенияРеквизитов.МодельРаспознованияКартинок;
			ПрофильРаспознованияКартинокРежима = ЗначенияРеквизитов.ПрофильРаспознованияКартинок;
		Исключение
			ЗаписьЖурналаРегистрации("Агент1С.РеквизитыРежима", УровеньЖурналаРегистрации.Предупреждение,
				Строка(РежимСсылка),, "Ошибка чтения реквизитов режима: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ЗапросПользователя = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "ЗапросПользователя", "");
	ИдДиалога = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "ИдДиалога", Неопределено);
	ДопПараметры = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "ДопПараметры", Неопределено);

	ЭтоВозобновление = СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "ВозобновлениеРазрешения", Ложь) = Истина;
	РешенияРазрешений = СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "РешенияРазрешений", Неопределено);

	КастомныйПромпт = Неопределено;
	Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("СистемныйПромпт") Тогда
		КастомныйПромпт = ДопПараметры.СистемныйПромпт;
	КонецЕсли;

	Вложения = НормализоватьВложенияИзПараметров(ДопПараметры);

	ПараметрыЗапуска.Вставить("РежимСсылка", РежимСсылка);
	ПараметрыЗапуска.Вставить("РежимEnum", РежимEnum);
	ПараметрыЗапуска.Вставить("СистемныйПромптИзСправочника", СистемныйПромптИзСправочника);
	ПараметрыЗапуска.Вставить("МодельРежима", МодельРежима);
	ПараметрыЗапуска.Вставить("ПрофильРежима", ПрофильРежима);
	ПараметрыЗапуска.Вставить("ТемператураРежима", ТемператураРежима);
	ПараметрыЗапуска.Вставить("МодельРаспознованияКартинокРежима", МодельРаспознованияКартинокРежима);
	ПараметрыЗапуска.Вставить("ПрофильРаспознованияКартинокРежима", ПрофильРаспознованияКартинокРежима);
	ПараметрыЗапуска.Вставить("ЗапросПользователя", ЗапросПользователя);
	ПараметрыЗапуска.Вставить("ИдДиалога", ИдДиалога);
	ПараметрыЗапуска.Вставить("ДопПараметры", ДопПараметры);
	ПараметрыЗапуска.Вставить("ЭтоВозобновление", ЭтоВозобновление);
	ПараметрыЗапуска.Вставить("РешенияРазрешений", РешенияРазрешений);
	ПараметрыЗапуска.Вставить("КастомныйПромпт", КастомныйПромпт);
	ПараметрыЗапуска.Вставить("Вложения", Вложения);

	Возврат ПараметрыЗапуска;
КонецФункции

// Определяет профиль подключения, настройки, модель агента и профиль модели.
//
// Параметры:
//  ПараметрыЗапроса - Структура - параметры запуска агента (см. ЗапуститьАгента).
//  ПараметрыЗапуска - Структура - результат ПодготовитьПараметрыЗапуска.
//
// Возвращаемое значение:
//  Структура - параметры модели и подключения:
//   * ПрофильПодключения - СправочникСсылка.СИ_ПрофилиПодключений,Произвольный,Неопределено - выбранный профиль;
//   * Настройки - Структура - настройки профиля подключения;
//   * МодельАгента - Строка,Произвольный,Неопределено - имя модели агента;
//   * ПрофильМодели - Структура,Неопределено - профиль модели (контекстное окно и лимиты).
Функция ОпределитьПрофильИМодель(ПараметрыЗапроса, ПараметрыЗапуска)
	ДопПараметры = ПараметрыЗапуска.ДопПараметры;
	ПрофильРежима = ПараметрыЗапуска.ПрофильРежима;
	МодельРежима = ПараметрыЗапуска.МодельРежима;

	ПрофильПодключения = Неопределено;
	ПрофильИзПараметров = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Профиль", Неопределено);
	Если ПрофильИзПараметров = Неопределено И ДопПараметры <> Неопределено Тогда
		ПрофильИзПараметров = СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "Профиль", Неопределено);
	КонецЕсли;
	Если ПрофильИзПараметров <> Неопределено И ЗначениеЗаполнено(ПрофильИзПараметров) Тогда
		ПрофильПодключения = ПрофильИзПараметров;
	ИначеЕсли ЗначениеЗаполнено(ПрофильРежима) Тогда
		ПрофильПодключения = ПрофильРежима;
	КонецЕсли;

	Если ПрофильПодключения <> Неопределено И ТипЗнч(ПрофильПодключения) = Тип("Строка")
		И НЕ ПустаяСтрока(ПрофильПодключения) Тогда
		ПрофильПодключения = Справочники.СИ_ПрофилиПодключений.НайтиПоНаименованию(ПрофильПодключения);
	КонецЕсли;

	Настройки = СИ_НастройкиАгента.ПолучитьНастройки(ПрофильПодключения);

	Если ПрофильПодключения = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ПрофильПодключения) Тогда
		ПрофильПодключения = СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ПрофильПодключения",
			Справочники.СИ_ПрофилиПодключений.ПустаяСсылка());
	КонецЕсли;

	МодельАгента = "";
	МодельИзПараметров = СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапроса, "Модель", "");
	Если ПустаяСтрока(МодельИзПараметров) И ДопПараметры <> Неопределено Тогда
		МодельИзПараметров = СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "Модель", "");
	КонецЕсли;
	Если НЕ ПустаяСтрока(МодельИзПараметров) Тогда
		МодельАгента = МодельИзПараметров;
	ИначеЕсли НЕ ПустаяСтрока(МодельРежима) Тогда
		МодельАгента = МодельРежима;
	КонецЕсли;
	Если ПустаяСтрока(МодельАгента) Тогда
		МодельАгента = СИ_НастройкиАгента.ПолучитьМодельПоУмолчанию(ПрофильПодключения);
		Если ПустаяСтрока(МодельАгента) Тогда
			МодельАгента = Настройки.МодельПоУмолчанию;
		КонецЕсли;
	КонецЕсли;

	ПрофильМодели = СИ_НастройкиАгента.ПолучитьПрофильМодели(МодельАгента, ПрофильПодключения);

	Результат = Новый Структура;
	Результат.Вставить("ПрофильПодключения", ПрофильПодключения);
	Результат.Вставить("Настройки", Настройки);
	Результат.Вставить("МодельАгента", МодельАгента);
	Результат.Вставить("ПрофильМодели", ПрофильМодели);
	Возврат Результат;
КонецФункции

// Создаёт диалог захода (или использует переданный) и гарантирует наличие
// system-сообщения в его истории.
//
// Параметры:
//  ПараметрыЗапуска - Структура - результат ПодготовитьПараметрыЗапуска.
//  ПараметрыМодели - Структура - результат ОпределитьПрофильИМодель.
//
// Возвращаемое значение:
//  Структура - результат обеспечения диалога:
//   * Успех - Булево - Истина, если диалог доступен для захода;
//   * ИдДиалога - Произвольный,Неопределено - диалог захода (СправочникСсылка.СИ_ДиалогиАгента);
//   * ТекстОшибки - Строка - текст ошибки, если Успех = Ложь.
Функция ОбеспечитьДиалогЗапуска(ПараметрыЗапуска, ПараметрыМодели)
	ИдДиалога = ПараметрыЗапуска.ИдДиалога;
	РежимСсылка = ПараметрыЗапуска.РежимСсылка;
	СистемныйПромптИзСправочника = ПараметрыЗапуска.СистемныйПромптИзСправочника;
	КастомныйПромпт = ПараметрыЗапуска.КастомныйПромпт;
	МодельАгента = ПараметрыМодели.МодельАгента;
	ПрофильПодключения = ПараметрыМодели.ПрофильПодключения;

	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("ИдДиалога", ИдДиалога);
	Результат.Вставить("ТекстОшибки", "");

	Если ИдДиалога = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		ПараметрыДиалога = Новый Структура;
		ПараметрыДиалога.Вставить("Режим", РежимСсылка);
		ПараметрыДиалога.Вставить("Модель", МодельАгента);
		ПараметрыДиалога.Вставить("Профиль", ПрофильПодключения);
		ПараметрыДиалога.Вставить("РежимСсылка", РежимСсылка);

		СистемныйПромпт = ?(ПустаяСтрока(КастомныйПромпт), СистемныйПромптИзСправочника, КастомныйПромпт);
		ПараметрыДиалога.Вставить("СистемныйПромпт", СистемныйПромпт);

		ИдДиалога = СИ_УправлениеДиалогом.СоздатьДиалог(ПараметрыДиалога);
		Если ИдДиалога = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Результат.Успех = Ложь;
			Результат.ТекстОшибки = "Не удалось создать диалог";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Результат.ИдДиалога = ИдДиалога;

	Попытка
		ИсторияДиалога = СИ_УправлениеДиалогом.ПолучитьИсторию(ИдДиалога, Неопределено);
		ЕстьСистемное = Ложь;
		Для Каждого СообщениеИзИстории Из ИсторияДиалога Цикл
			РольИзИстории = СИ_РаботаСJSON.БезопасноПолучить(СообщениеИзИстории, "Роль", "");
			Если РольИзИстории = "system" Тогда
				ЕстьСистемное = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НЕ ЕстьСистемное Тогда
			СистемныйПромптДляВставки = ?(ПустаяСтрока(КастомныйПромпт), СистемныйПромптИзСправочника, КастомныйПромпт);

			ДополненияСистемногоПромпта = СИ_Промпты.ДополненияСистемногоПромпта();

			Если ПустаяСтрока(СистемныйПромптДляВставки) Тогда
				СистемныйПромптДляВставки = ДополненияСистемногоПромпта;
			Иначе
				СистемныйПромптДляВставки = СистемныйПромптДляВставки + Символы.ПС + Символы.ПС + ДополненияСистемногоПромпта;
			КонецЕсли;

			Если НЕ ПустаяСтрока(СистемныйПромптДляВставки) Тогда
				СистемноеСообщение = Новый Структура;
				СистемноеСообщение.Вставить("Роль", "system");
				СистемноеСообщение.Вставить("Контент", СистемныйПромптДляВставки);
				СИ_УправлениеДиалогом.ДобавитьСообщение(ИдДиалога, СистемноеСообщение);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ЗапуститьАгента", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка при проверке/добавлении system-сообщения: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Сжимает историю диалога ДО отправки пользовательского сообщения и возвращает
// текст сводки, сформированной моделью (пустая строка, если сжатие не выполнялось).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  ПараметрыЗапуска - Структура - результат ПодготовитьПараметрыЗапуска.
//  ПараметрыМодели - Структура - результат ОпределитьПрофильИМодель.
//
// Возвращаемое значение:
//  Строка - текст сводки, записанной в диалог при сжатии.
Функция СжатьИсториюПередЗапуском(ИдДиалога, ПараметрыЗапуска, ПараметрыМодели)
	ТекстСводкиПередЗапуском = "";
	ДопПараметры = ПараметрыЗапуска.ДопПараметры;
	ЭтоВозобновление = ПараметрыЗапуска.ЭтоВозобновление;
	Настройки = ПараметрыМодели.Настройки;
	МодельАгента = ПараметрыМодели.МодельАгента;
	ПрофильМодели = ПараметрыМодели.ПрофильМодели;

	Попытка
		ИсторияДляСжатия = СИ_УправлениеДиалогом.ПолучитьИсторию(ИдДиалога, Неопределено);
		Если НЕ ЭтоВозобновление И ИсторияДляСжатия <> Неопределено И ИсторияДляСжатия.Количество() > КоличествоСообщенийДляСжатия() Тогда

			КонтекстОкноДляСжатия = КонтекстОкноПоУмолчанию();
			Если ПрофильМодели <> Неопределено Тогда
				КонтекстОкноДляСжатия = СИ_РаботаСJSON.БезопасноПолучить(ПрофильМодели, "КонтекстОкно", КонтекстОкноПоУмолчанию());
			КонецЕсли;
			ПроцентДляСжатия = ЧислоНастройки(Настройки, "ПроцентОкнаДляИстории", ПроцентОкнаДляИсторииПоУмолчанию());
			Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("ПроцентОкнаДляИстории") Тогда
				ПроцентДляСжатия = Число(ДопПараметры.ПроцентОкнаДляИстории);
			КонецЕсли;
			Если ПроцентДляСжатия <= 0 ИЛИ ПроцентДляСжатия > 1 Тогда
				ПроцентДляСжатия = ПроцентОкнаДляИсторииПоУмолчанию();
			КонецЕсли;
			ЛимитТокеновДляСжатия = Цел(КонтекстОкноДляСжатия * ПроцентДляСжатия);

			ОценкаТокеновДляСжатия = ОценитьТокеныИсторииДиалога(ИдДиалога, ИсторияДляСжатия);

			Если ОценкаТокеновДляСжатия > ЛимитТокеновДляСжатия Тогда
				ПараметрыСжатияПередЗапуском = ПараметрыСжатияИзНастроек(ПараметрыЗапуска, ПараметрыМодели);

				РезультатСжатияПередЗапуском = СИ_УправлениеДиалогом.СжатьИсторию(
					ИсторияДляСжатия, ЛимитТокеновДляСжатия, ПараметрыСжатияПередЗапуском);

				Если СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатияПередЗапуском, "ПримененоСжатие", Ложь) Тогда
					СжатаяИсторияПередЗапуском = СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатияПередЗапуском, "Сообщения", Неопределено);
					Если СжатаяИсторияПередЗапуском <> Неопределено И СжатаяИсторияПередЗапуском.Количество() > 0 Тогда
						СИ_УправлениеДиалогом.ЗаменитьИсториюДиалога(ИдДиалога, СжатаяИсторияПередЗапуском);
						ТекстСводкиПередЗапуском = СИ_РаботаСJSON.БезопасноПолучить(РезультатСжатияПередЗапуском, "Сводка", "");

						НовыйРазмерИстории = СИ_УправлениеДиалогом.ОценитьТокеныИстории(СжатаяИсторияПередЗапуском);
						ЗначенияЗаписиДиалога = Новый Структура;
						ЗначенияЗаписиДиалога.Вставить("ИсторияТокенов", НовыйРазмерИстории);
						ЗаписатьРеквизитыДиалогаЗахода(ИдДиалога, ЗначенияЗаписиДиалога, "СжатиеИсторииПередЗапуском");

						ЗаписьЖурналаРегистрации("Агент1С.СжатиеИсторииПередЗапуском", УровеньЖурналаРегистрации.Информация,
							Строка(ИдДиалога),, "Было: " + Строка(ИсторияДляСжатия.Количество())
							+ " | Стало: " + Строка(СжатаяИсторияПередЗапуском.Количество())
							+ " | Токены: " + Строка(ОценкаТокеновДляСжатия) + " -> " + Строка(НовыйРазмерИстории)
							+ " | Сводка: " + Строка(НЕ ПустаяСтрока(ТекстСводкиПередЗапуском))
							+ " | Модель: " + МодельАгента);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.СжатиеИсторииПередЗапуском", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка сжатия истории перед запуском: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат ТекстСводкиПередЗапуском;
КонецФункции

// Оценивает размер истории диалога в токенах: реальные входные токены последнего
// ответа модели (реквизит ИсторияТокенов), при их отсутствии - расчётная оценка.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  История - Массив из Структура - история сообщений диалога.
//
// Возвращаемое значение:
//  Число - оценка количества токенов истории.
Функция ОценитьТокеныИсторииДиалога(ИдДиалога, История)
	ОценкаТокеновДляСжатия = 0;
	Попытка
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдДиалога, "ИсторияТокенов");
		ИсторияТокеновДиалога = Число(ЗначенияРеквизитов.ИсторияТокенов);
		Если ИсторияТокеновДиалога > 0 Тогда
			ОценкаТокеновДляСжатия = ИсторияТокеновДиалога;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ОценкаТокеновДиалога", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка чтения ИсторияТокенов диалога: " + ОписаниеОшибки());
	КонецПопытки;
	Если ОценкаТокеновДляСжатия = 0 Тогда
		ОценкаТокеновДляСжатия = СИ_УправлениеДиалогом.ОценитьТокеныИстории(История);
	КонецЕсли;
	Возврат ОценкаТокеновДляСжатия;
КонецФункции

// Собирает параметры сжатия истории: значения профиля подключения, переопределённые
// доп.параметрами захода.
//
// Параметры:
//  ПараметрыЗапуска - Структура - результат ПодготовитьПараметрыЗапуска.
//  ПараметрыМодели - Структура - результат ОпределитьПрофильИМодель.
//
// Возвращаемое значение:
//  Структура - параметры для СИ_УправлениеДиалогом.СжатьИсторию.
Функция ПараметрыСжатияИзНастроек(ПараметрыЗапуска, ПараметрыМодели)
	ДопПараметры = ПараметрыЗапуска.ДопПараметры;
	Настройки = ПараметрыМодели.Настройки;

	ПараметрыСжатия = Новый Структура;
	ПараметрыСжатия.Вставить("Модель", ПараметрыМодели.МодельАгента);
	ПараметрыСжатия.Вставить("Профиль", ПараметрыМодели.ПрофильПодключения);
	ПараметрыСжатия.Вставить("ИспользоватьСводку",
		СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ИспользоватьСводку", Ложь));
	ПараметрыСжатия.Вставить("МаксТокеновСводки", ЧислоНастройки(Настройки, "МаксТокеновСводки", 1500));
	ПараметрыСжатия.Вставить("КоличествоСвежих", ЧислоНастройки(Настройки, "КоличествоСвежихСообщений", 10));
	ПараметрыСжатия.Вставить("МаксДлинаToolРезультата", ЧислоНастройки(Настройки, "МаксДлинаToolРезультата", 4000));
	ПараметрыСжатия.Вставить("МаксДлинаСообщения", ЧислоНастройки(Настройки, "МаксДлинаСообщения", 4000));

	Если ДопПараметры <> Неопределено Тогда
		Если ДопПараметры.Свойство("ИспользоватьСводку") Тогда
			ПараметрыСжатия.ИспользоватьСводку = ДопПараметры.ИспользоватьСводку;
		КонецЕсли;
		Если ДопПараметры.Свойство("МаксТокеновСводки") Тогда
			ПараметрыСжатия.МаксТокеновСводки = ДопПараметры.МаксТокеновСводки;
		КонецЕсли;
		Если ДопПараметры.Свойство("КоличествоСвежих") Тогда
			ПараметрыСжатия.КоличествоСвежих = ДопПараметры.КоличествоСвежих;
		КонецЕсли;
		Если ДопПараметры.Свойство("МаксДлинаToolРезультата") Тогда
			ПараметрыСжатия.МаксДлинаToolРезультата = ДопПараметры.МаксДлинаToolРезультата;
		КонецЕсли;
		Если ДопПараметры.Свойство("МаксДлинаСообщения") Тогда
			ПараметрыСжатия.МаксДлинаСообщения = ДопПараметры.МаксДлинаСообщения;
		КонецЕсли;
	КонецЕсли;

	Возврат ПараметрыСжатия;
КонецФункции

// Добавляет в историю диалога сообщение пользователя. При возобновлении захода после
// запроса разрешения сообщение не добавляется (оно уже в истории).
// Если к заходу прикреплены файлы - в контент добавляются маркеры с именами файлов,
// чтобы модель сразу видела, какие файлы прикреплены (без вызова ListDialogFiles).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  ПараметрыЗапуска - Структура - результат ПодготовитьПараметрыЗапуска.
Процедура ДобавитьСообщениеПользователя(ИдДиалога, ПараметрыЗапуска)
	Если ПараметрыЗапуска.ЭтоВозобновление Тогда
		Возврат;
	КонецЕсли;

	КонтентСообщенияПользователя = ПараметрыЗапуска.ЗапросПользователя;
	МассивВложений = ПараметрыЗапуска.Вложения;
	Если МассивВложений.Количество() > 0 Тогда
		КонтентСообщенияПользователя = КонтентСообщенияПользователя + МаркерыВложенийВТекст(МассивВложений);
	КонецЕсли;

	СообщениеПользователя = Новый Структура;
	СообщениеПользователя.Вставить("Роль", "user");
	СообщениеПользователя.Вставить("Контент", КонтентСообщенияПользователя);
	СИ_УправлениеДиалогом.ДобавитьСообщение(ИдДиалога, СообщениеПользователя);
КонецПроцедуры

// Формирует текстовые маркеры вложений для сообщения пользователя: имя файла и,
// при наличии, кликабельную ссылку file:UUID сохранённого файла.
//
// Параметры:
//  МассивВложений - Массив из Структура - нормализованные вложения захода.
//
// Возвращаемое значение:
//  Строка - маркеры вложений, начиная с перевода строки (пустая строка, если вложений нет).
Функция МаркерыВложенийВТекст(МассивВложений)
	ТекстМаркеров = "";
	Для Каждого ВложениеИзМассива Из МассивВложений Цикл
		ИмяФайлаДляМаркера = ВложениеИзМассива.ИмяФайла;
		Если НЕ ПустаяСтрока(ИмяФайлаДляМаркера) Тогда
			ТекстМаркеров = ТекстМаркеров + Символы.ПС + "[Файл: " + ИмяФайлаДляМаркера + "]";
			СсылкаФайлаДляМаркера = ВложениеИзМассива.СсылкаСохраненногоФайла;
			Если СсылкаФайлаДляМаркера <> Неопределено И ЗначениеЗаполнено(СсылкаФайлаДляМаркера) Тогда
				ТекстМаркеров = ТекстМаркеров + " file:"
					+ Строка(СсылкаФайлаДляМаркера.УникальныйИдентификатор());
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ТекстМаркеров;
КонецФункции

// Инициализирует контекст агентского цикла: режим, модель, историю сообщений,
// счётчики, лимиты и буфер пакетной записи сообщений. Подмешивает контекстную память
// диалога в первое system-сообщение (кроме возобновления и явного отказа).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  ПараметрыЗапуска - Структура - результат ПодготовитьПараметрыЗапуска.
//  ПараметрыМодели - Структура - результат ОпределитьПрофильИМодель.
//  ТекстСводки - Строка - сводка сжатия истории перед запуском (может быть пустой).
//
// Возвращаемое значение:
//  Структура - контекст цикла для ВыполнитьИтерацию и ФинализироватьЗаходАгента.
Функция СформироватьКонтекстЦикла(ИдДиалога, ПараметрыЗапуска, ПараметрыМодели, ТекстСводки)
	ДопПараметры = ПараметрыЗапуска.ДопПараметры;
	Настройки = ПараметрыМодели.Настройки;

	КонтекстЦикла = Новый Структура;
	КонтекстЦикла.Вставить("ИдДиалога", ИдДиалога);
	КонтекстЦикла.Вставить("Режим", ПараметрыЗапуска.РежимEnum);
	КонтекстЦикла.Вставить("РежимСсылка", ПараметрыЗапуска.РежимСсылка);
	КонтекстЦикла.Вставить("Модель", ПараметрыМодели.МодельАгента);
	КонтекстЦикла.Вставить("ПрофильПодключения", ПараметрыМодели.ПрофильПодключения);
	КонтекстЦикла.Вставить("ТемператураРежима", ПараметрыЗапуска.ТемператураРежима);
	КонтекстЦикла.Вставить("Сообщения", СИ_УправлениеДиалогом.ПолучитьИсторию(ИдДиалога, Неопределено));

	Если НЕ ПараметрыЗапуска.ЭтоВозобновление
		И (ДопПараметры = Неопределено ИЛИ НЕ СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "ОтключитьПамять", Ложь)) Тогда
		Попытка
			ПодмешатьПамятьВИсторию(ИдДиалога, КонтекстЦикла.Сообщения);
		Исключение
			ЗаписьЖурналаРегистрации("Агент1С.ПамятьДиалога", УровеньЖурналаРегистрации.Предупреждение,
				Строка(ИдДиалога),, "Ошибка подмешивания памяти: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Попытка
		ПодмешатьОткрытыеФормыВИсторию(КонтекстЦикла.Сообщения, ДопПараметры);
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ОткрытыеФормы", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка подмешивания открытых форм: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		ПодмешатьПользователяВИсторию(КонтекстЦикла.Сообщения, ИмяТекущегоПользователя(ИдДиалога));
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ТекущийПользователь", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка подмешивания имени пользователя: " + ОписаниеОшибки());
	КонецПопытки;

	КонтекстЦикла.Вставить("МодельРаспознованияКартинок", ПараметрыЗапуска.МодельРаспознованияКартинокРежима);
	КонтекстЦикла.Вставить("ПрофильРаспознованияКартинок", ПараметрыЗапуска.ПрофильРаспознованияКартинокРежима);
	Если НЕ ПустаяСтрока(ТекстСводки) Тогда
		КонтекстЦикла.Вставить("СводкаДиалога", ТекстСводки);
	КонецЕсли;
	КонтекстЦикла.Вставить("СчетчикИтераций", 0);
	КонтекстЦикла.Вставить("ПовторовТранспортнойОшибки", 0);
	КонтекстЦикла.Вставить("ВызовыИнструментов", Новый Массив);
	КонтекстЦикла.Вставить("КлючиВызовов", Новый Соответствие);
	КонтекстЦикла.Вставить("ПовторовВызовов", 0);
	КонтекстЦикла.Вставить("ДополнительныеИнструменты", Новый Массив);
	КонтекстЦикла.Вставить("ОшибокИнструментов", 0);
	КонтекстЦикла.Вставить("ФинальныйШаг", Ложь);
	КонтекстЦикла.Вставить("МоментНачалаЗахода", ТекущаяУниверсальнаяДата());
	КонтекстЦикла.Вставить("ИспользованоТокенов", 0);
	КонтекстЦикла.Вставить("ЛимитТокеновНаОтвет", СИ_НастройкиАгента.ПолучитьЛимитТокеновНаОтвет());
	КонтекстЦикла.Вставить("ДопПараметры", ДопПараметры);
	КонтекстЦикла.Вставить("МаксИтераций", Настройки.MaxIterations);
	КонтекстЦикла.Вставить("ИтоговыйТекст", "");
	КонтекстЦикла.Вставить("ТекущийПромежуточныйТекст", "");
	КонтекстЦикла.Вставить("Настройки", Настройки);
	КонтекстЦикла.Вставить("ПрофильМодели", ПараметрыМодели.ПрофильМодели);

	БуферСообщений = СИ_УправлениеДиалогом.НовыйБуферСообщений(ИдДиалога);
	КонтекстЦикла.Вставить("БуферСообщений", БуферСообщений);

	Возврат КонтекстЦикла;
КонецФункции

// Добавляет содержимое вложений захода в контекст модели отдельными сообщениями
// ТОЛЬКО в памяти (не записывается в регистр), чтобы пользователь не видел текст
// файла в своём сообщении, а в истории диалога оставались только маркеры [Файл: имя].
// Оптимизация токенов: полное содержимое передаётся только на 1-й итерации,
// на последующих заменяется маркером (см. СобратьПараметрыЗапроса → СжатьВложенияНаИтерации).
//
// Поддерживаемые типы вложений (элемент массива ПараметрыЗапуска.Вложения):
//  - "Текст" (по умолчанию) - содержимое передаётся строкой в поле Содержимое;
//  - "Картинка" - изображение передаётся адресом во временном хранилище
//    (АдресВоВременномХранилище); если задана МодельРаспознованияКартинок - распознаётся
//    отдельным вызовом vision-модели, иначе передаётся напрямую image_url блоком;
//  - "PDF" - PDF передаётся адресом во временном хранилище и распознаётся через
//    СИ_РаспознованиеИзображений.РаспознатьPDF (текст по страницам попадает в контекст).
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//  ПараметрыЗапуска - Структура - результат ПодготовитьПараметрыЗапуска.
//  ПараметрыМодели - Структура - результат ОпределитьПрофильИМодель.
Процедура ПодготовитьВложенияВКонтекст(КонтекстЦикла, ПараметрыЗапуска, ПараметрыМодели)
	МассивВложенийИзПараметров = ПараметрыЗапуска.Вложения;
	Если МассивВложенийИзПараметров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИдДиалога = КонтекстЦикла.ИдДиалога;
	Настройки = ПараметрыМодели.Настройки;

	Для Каждого ВложениеИзМассива Из МассивВложенийИзПараметров Цикл

		ИмяФайлаИзПараметров = ВложениеИзМассива.ИмяФайла;
		ТипВложенияИзПараметров = ВложениеИзМассива.ТипВложения;

		Если ТипВложенияИзПараметров = "Картинка" ИЛИ ТипВложенияИзПараметров = "PDF" Тогда
			АдресВложения = ВложениеИзМассива.АдресВоВременномХранилище;
			Если НЕ ПустаяСтрока(АдресВложения) Тогда
				СообщениеСФайлом = ОбработатьБинарноеВложение(
					АдресВложения, ИмяФайлаИзПараметров, ТипВложенияИзПараметров,
					ПараметрыМодели.МодельАгента, ПараметрыМодели.ПрофильПодключения, Настройки, ИдДиалога,
					ВложениеИзМассива.СсылкаСохраненногоФайла, ПараметрыЗапуска.РежимСсылка);
				Если СообщениеСФайлом <> Неопределено Тогда
					КонтекстЦикла.Сообщения.Добавить(СообщениеСФайлом);
				КонецЕсли;
			КонецЕсли;
		Иначе
			СодержимоеФайлаИзПараметров = ВложениеИзМассива.Содержимое;
			Если НЕ ПустаяСтрока(СодержимоеФайлаИзПараметров) Тогда
				СообщениеСФайлом = Новый Структура;
				СообщениеСФайлом.Вставить("Роль", "user");
				СообщениеСФайлом.Вставить("Контент",
					"Ниже приведено ПОЛНОЕ содержимое прикреплённого файла «" + ИмяФайлаИзПараметров + "». "
					+ "Файл уже встроен в это сообщение — НЕ пытайтесь открыть или найти его на диске, "
					+ "просто проанализируйте текст ниже."
					+ Символы.ПС
					+ "=== Содержимое файла: " + ИмяФайлаИзПараметров + " ==="
					+ Символы.ПС + СодержимоеФайлаИзПараметров
					+ Символы.ПС + "=== Конец содержимого файла ===");
				СообщениеСФайлом.Вставить("ФайлВложение", Истина);
				СообщениеСФайлом.Вставить("ИмяВложения", ИмяФайлаИзПараметров);
				КонтекстЦикла.Сообщения.Добавить(СообщениеСФайлом);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ЦиклАгента

// Выполняет основной цикл агента: проверка предохранителей, вызов итерации,
// обработка ошибок модели и отмены, накопление журнала и истории, живой показ,
// остановка на запросе разрешения и завершение по признаку продолжения.
// Мутирует КонтекстЦикла (счётчики, итоговый текст, журнал) и Результат.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//  БуферСообщений - Структура - буфер пакетной записи сообщений захода.
//  Результат - Структура - результат захода (см. ИнициализироватьРезультатЗапуска).
Процедура ВыполнитьЦиклАгента(КонтекстЦикла, БуферСообщений, Результат)
	ИдДиалога = КонтекстЦикла.ИдДиалога;

	Пока Истина Цикл
		КонтекстЦикла.СчетчикИтераций = КонтекстЦикла.СчетчикИтераций + 1;

		Проверка = ПроверитьОграничения(КонтекстЦикла);
		Если СИ_РаботаСJSON.БезопасноПолучить(Проверка, "ПревышенЛимит", Ложь)
			И НЕ СИ_РаботаСJSON.БезопасноПолучить(Проверка, "МягкийЛимит", Ложь) Тогда
			Результат.ПричинаЗавершения = СИ_РаботаСJSON.БезопасноПолучить(Проверка, "Причина", "");
			Прервать;
		КонецЕсли;

		Если СИ_РаботаСJSON.БезопасноПолучить(Проверка, "МягкийЛимит", Ложь)
			ИЛИ Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПовторовВызовов", 0)) >= МаксимумПовторовВызовов()
			ИЛИ ЗаходДольшеЛимитаВремени(КонтекстЦикла) Тогда
			Если НЕ СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ФинальныйШаг", Ложь) Тогда
				ЗаписьЖурналаРегистрации("Агент1С.ФинальныйШаг", УровеньЖурналаРегистрации.Информация,
					Строка(ИдДиалога),, "Инструменты отключены: ответ строится по уже собранным данным.");
			КонецЕсли;
			КонтекстЦикла.Вставить("ФинальныйШаг", Истина);
		КонецЕсли;

		РезультатИтерации = ВыполнитьИтерацию(КонтекстЦикла);

		ТекстОшибкиИтерации = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ТекстОшибки", "");
		ПричинаЗавершенияИтерации = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ПричинаЗавершения", "");
		ЕстьОшибкаМодели = НЕ ПустаяСтрока(ТекстОшибкиИтерации)
			ИЛИ СтрНачинаетсяС(ПричинаЗавершенияИтерации, "HTTP_")
			ИЛИ ПричинаЗавершенияИтерации = "Ошибка вызова модели"
			ИЛИ ПричинаЗавершенияИтерации = "Пустой ответ модели"
			ИЛИ ПричинаЗавершенияИтерации = "Внутренняя ошибка";

		Если ПричинаЗавершенияИтерации = "Прерван пользователем" Тогда
			Результат.ПричинаЗавершения = "Прерван пользователем";
			СИ_УправлениеДиалогом.ОтменитьБуферСообщений(БуферСообщений);
			Прервать;
		КонецЕсли;

		Если ЕстьОшибкаМодели Тогда
			ЗафиксироватьОшибкуВызоваМодели(ИдДиалога, ТекстОшибкиИтерации,
				ПричинаЗавершенияИтерации, БуферСообщений, Результат);
			Прервать;
		КонецЕсли;

		КонтекстЦикла.Вставить("ПовторовТранспортнойОшибки", 0);

		НакопитьДанныеИтерации(РезультатИтерации, КонтекстЦикла);

		СИ_УправлениеДиалогом.ОтправитьЖивойПакет(ИдДиалога, БуферСообщений.Сообщения,
			БуферСообщений.НачальныйНомер, КонтекстЦикла.ИспользованоТокенов,
			КонтекстЦикла.ПромптТокеныПоследнейИтерации);

		Если СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ОжиданиеРазрешения", Ложь) Тогда
			ОстановитьЗаходНаРазрешении(ИдДиалога, КонтекстЦикла, БуферСообщений, Результат);
			Прервать;
		КонецЕсли;

		Если НЕ СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ПродолжатьЦикл", Ложь) Тогда
			КонтекстЦикла.ИтоговыйТекст = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ТекстОтвета", "");
			Прервать;
		Иначе
			Если СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ФинальныйШаг", Ложь) Тогда
				ТекстФинальный = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ТекстОтвета", "");
				Если ПустаяСтрока(ТекстФинальный) Тогда
					ТекстФинальный = "Ответ не сформирован: достигнут лимит шагов работы агента. "
							+ "Переформулируйте запрос конкретнее - например, назовите период, объект или документ.";
				КонецЕсли;
				КонтекстЦикла.ИтоговыйТекст = ТекстФинальный;
				Прервать;
			КонецЕсли;
			ТекстОтветаИтерации = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ТекстОтвета", "");
			Если НЕ ПустаяСтрока(ТекстОтветаИтерации) Тогда
				КонтекстЦикла.ТекущийПромежуточныйТекст = ТекстОтветаИтерации;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
КонецПроцедуры

// Накапливает в контексте цикла данные успешной итерации: токены, журнал вызовов
// инструментов и локальную историю сообщений (assistant + tool-результаты) в памяти,
// вместо перечитывания всей истории из БД.
//
// Параметры:
//  РезультатИтерации - Структура - результат ВыполнитьИтерацию.
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
Процедура НакопитьДанныеИтерации(РезультатИтерации, КонтекстЦикла)
	КонтекстЦикла.ИспользованоТокенов = КонтекстЦикла.ИспользованоТокенов + СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ИспользованоТокенов", 0);
	ПромптТокеныИтерации = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ПромптТокены", 0);
	КонтекстЦикла.Вставить("ПромптТокены",
		СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПромптТокены", 0) + ПромптТокеныИтерации);
	КонтекстЦикла.Вставить("ПромптТокеныПоследнейИтерации", ПромптТокеныИтерации);

	ВызовыИтерации = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "ВызовыИнструментов", Неопределено);
	Если ВызовыИтерации <> Неопределено И ТипЗнч(ВызовыИтерации) = Тип("Массив") Тогда
		Для Каждого Вызов Из ВызовыИтерации Цикл
			КонтекстЦикла.ВызовыИнструментов.Добавить(Вызов);
		КонецЦикла;
	КонецЕсли;

	СообщениеМоделиИзИтерации = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "СообщениеМодели", Неопределено);
	Если СообщениеМоделиИзИтерации <> Неопределено Тогда
		ДобавленноеСообщение = Новый Структура;
		ДобавленноеСообщение.Вставить("Роль", "assistant");

		КонтентМодели = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "КонтентДляЛокальногоНакопления", Неопределено);
		Если КонтентМодели = Неопределено Тогда
			КонтентМодели = СИ_РаботаСJSON.БезопасноПолучить(СообщениеМоделиИзИтерации, "content", "");
		КонецЕсли;
		Если КонтентМодели = Неопределено ИЛИ ТипЗнч(КонтентМодели) <> Тип("Строка") Тогда
			КонтентМодели = "";
		КонецЕсли;
		ДобавленноеСообщение.Вставить("Контент", КонтентМодели);

		ТулКоллы = СИ_РаботаСJSON.БезопасноПолучить(СообщениеМоделиИзИтерации, "tool_calls", Неопределено);
		Если ТулКоллы <> Неопределено И ТипЗнч(ТулКоллы) = Тип("Массив") И ТулКоллы.Количество() > 0 Тогда
			ДобавленноеСообщение.Вставить("ВызовыИнструментов", ТулКоллы);
		КонецЕсли;

		РассужденияИзИтерации = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "Рассуждения", "");
		Если ПустаяСтрока(РассужденияИзИтерации) Тогда
			РассужденияИзИтерации = СИ_РаботаСJSON.БезопасноПолучить(СообщениеМоделиИзИтерации, "Рассуждения", "");
		КонецЕсли;
		Если НЕ ПустаяСтрока(РассужденияИзИтерации) Тогда
			ДобавленноеСообщение.Вставить("Рассуждения", РассужденияИзИтерации);
		КонецЕсли;

		КонтекстЦикла.Сообщения.Добавить(ДобавленноеСообщение);
	КонецЕсли;

	НовыеToolСообщения = СИ_РаботаСJSON.БезопасноПолучить(РезультатИтерации, "НовыеToolСообщения", Неопределено);
	Если НовыеToolСообщения <> Неопределено Тогда
		Для Каждого ToolСообщение Из НовыеToolСообщения Цикл
			КонтекстЦикла.Сообщения.Добавить(ToolСообщение);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Фиксирует в истории диалога и в его реквизитах ошибку вызова модели,
// затем цикл прерывается вызывающим кодом.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  ТекстОшибкиИтерации - Строка - текст ошибки вызова модели.
//  ПричинаЗавершенияИтерации - Строка - причина завершения итерации (фолбэк текста ошибки).
//  БуферСообщений - Структура - буфер пакетной записи сообщений захода.
//  Результат - Структура - результат захода (см. ИнициализироватьРезультатЗапуска).
Процедура ЗафиксироватьОшибкуВызоваМодели(ИдДиалога, ТекстОшибкиИтерации,
	ПричинаЗавершенияИтерации, БуферСообщений, Результат)

	Если ПустаяСтрока(ТекстОшибкиИтерации) Тогда
		ТекстОшибкиИтерации = ПричинаЗавершенияИтерации;
	КонецЕсли;

	Результат.Успех = Ложь;
	Результат.Ошибки.Добавить("Ошибка вызова модели: " + ТекстОшибкиИтерации);

	СИ_УправлениеДиалогом.СброситьБуферСообщений(БуферСообщений);
	Попытка
		СообщениеОбОшибке = Новый Структура;
		СообщениеОбОшибке.Вставить("Роль", "service");
		СообщениеОбОшибке.Вставить("Контент", "Ошибка: " + ТекстОшибкиИтерации);
		СИ_УправлениеДиалогом.ДобавитьСообщение(ИдДиалога, СообщениеОбОшибке);

		ЗначенияЗаписиДиалога = Новый Структура;
		ЗначенияЗаписиДиалога.Вставить("Статус", Перечисления.СИ_СтатусыДиалога.ПрерванОшибкой);
		ЗначенияЗаписиДиалога.Вставить("ОшибкаЗавершения", Лев(ТекстОшибкиИтерации, 150));
		ЗначенияЗаписиДиалога.Вставить("АктивноеЗаданиеИд", "");
		ЗаписатьРеквизитыДиалогаЗахода(ИдДиалога, ЗначенияЗаписиДиалога, "ЗаписатьОшибкуМодели", Истина);
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ЗапуститьАгента", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка при записи ошибки модели в диалог: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Останавливает заход на запросе разрешения (двухфазный запуск): фиксирует хвост
// истории в БД, сохраняет отложенные вызовы в регистр и переводит диалог в статус
// «Ожидает разрешения».
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//  БуферСообщений - Структура - буфер пакетной записи сообщений захода.
//  Результат - Структура - результат захода (см. ИнициализироватьРезультатЗапуска).
Процедура ОстановитьЗаходНаРазрешении(ИдДиалога, КонтекстЦикла, БуферСообщений, Результат)
	СИ_УправлениеДиалогом.СброситьБуферСообщений(БуферСообщений);
	ЗаписатьОжиданиеРазрешения(ИдДиалога,
		СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ОжиданиеРазрешения", Новый Массив));
	УстановитьСтатусДиалога(ИдДиалога, Перечисления.СИ_СтатусыДиалога.ОжидаетРазрешения);
	Результат.ПричинаЗавершения = "ОжидаетРазрешения";
КонецПроцедуры

#КонецОбласти

#Область ФинализацияЗахода

// Завершает заход агента: финальный сброс буфера сообщений, сохранение фактов памяти,
// уведомление о превышении лимита токенов, формирование итогового результата,
// диагностика токенов и одна запись финализации диалога (токены, сводка, заголовок).
// Мутирует Результат.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//  БуферСообщений - Структура - буфер пакетной записи сообщений захода.
//  Результат - Структура - результат захода (см. ИнициализироватьРезультатЗапуска).
//  ПараметрыЗапуска - Структура - результат ПодготовитьПараметрыЗапуска.
//  ПараметрыМодели - Структура - результат ОпределитьПрофильИМодель.
Процедура ФинализироватьЗаходАгента(КонтекстЦикла, БуферСообщений, Результат,
	ПараметрыЗапуска, ПараметрыМодели)

	ИдДиалога = КонтекстЦикла.ИдДиалога;
	ДопПараметры = ПараметрыЗапуска.ДопПараметры;
	Настройки = ПараметрыМодели.Настройки;
	МодельАгента = ПараметрыМодели.МодельАгента;
	ПрофильПодключения = ПараметрыМодели.ПрофильПодключения;
	ПрофильМодели = ПараметрыМодели.ПрофильМодели;

	СИ_УправлениеДиалогом.СброситьБуферСообщений(БуферСообщений);

	Если ЗначениеЗаполнено(ИдДиалога)
		И (ДопПараметры = Неопределено ИЛИ НЕ СИ_РаботаСJSON.БезопасноПолучить(ДопПараметры, "ОтключитьПамять", Ложь)) Тогда
		Попытка
			СохранитьФактыЗахода(ИдДиалога, КонтекстЦикла);
		Исключение
			ЗаписьЖурналаРегистрации("Агент1С.ПамятьДиалога", УровеньЖурналаРегистрации.Предупреждение,
				Строка(ИдДиалога),, "Ошибка сохранения фактов памяти: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ЗаписатьСообщениеОЛимитеТокенов(ИдДиалога, КонтекстЦикла, Результат);

	СобратьПотребностиВИнструментах(ИдДиалога, КонтекстЦикла, ПараметрыЗапуска);

	СформироватьИтоговыйРезультат(КонтекстЦикла, Результат);

	ЗалогироватьИтоговуюСтатистикуТокенов(ИдДиалога, Результат, МодельАгента);

	Если ЗначениеЗаполнено(ИдДиалога) Тогда
		НовыйЗаголовок = СформироватьЗаголовокНовогоДиалога(ИдДиалога, Настройки,
			МодельАгента, ПрофильПодключения);
		ЗаписатьФинализациюДиалога(ИдДиалога, КонтекстЦикла, Результат, НовыйЗаголовок, ПрофильМодели);
	КонецЕсли;

КонецПроцедуры

// Текст абзаца-приглашения написать, каких данных или отчётов не хватило:
// это сбор заявок на новые инструменты и MCP-серверы.
//
// Возвращаемое значение:
//  Строка - текст абзаца.
Функция ТекстСбораПотребностей()

	Возврат "Если чего-то не хватило - напишите, каких данных или отчётов не хватает: "
		+ "это поможет добавить агенту новые инструменты.";

КонецФункции

// Порог числа повторов вызовов, после которого заход считается «упершимся
// в нехватку инструментов» и включается сбор потребностей.
//
// Возвращаемое значение:
//  Число - порог повторов.
Функция ПорогПотребностейПоПовторам()

	Возврат 2;

КонецФункции

// Порог числа ошибок инструментов, после которого включается сбор потребностей.
//
// Возвращаемое значение:
//  Число - порог ошибок.
Функция ПорогПотребностейПоОшибкам()

	Возврат 2;

КонецФункции

// Максимальная длина вопроса пользователя в событии Агент1С.НетИнструмента.
//
// Возвращаемое значение:
//  Число - предел длины в символах.
Функция МаксимальнаяДлинаВопросаВЖурнале()

	Возврат 300;

КонецФункции

// Сбор потребностей в инструментах: если за заход модель дважды и более раз
// повторила вызов или инструменты дважды завершились ошибкой, в конце захода:
//  * в журнал регистрации пишется событие Агент1С.НетИнструмента (вопрос
//    пользователя и список использованных инструментов) - заявка на новые
//    инструменты и MCP-серверы; результаты вызовов в событие не попадают
//    (в них могут быть персональные данные);
//  * пользователю в чат добавляется абзац-приглашение написать, чего не хватило.
// Ограничение: не чаще одного раза на диалог - проверяется по истории сообщений.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//  ПараметрыЗапуска - Структура - параметры запуска (текст вопроса пользователя).
Процедура СобратьПотребностиВИнструментах(ИдДиалога, КонтекстЦикла, ПараметрыЗапуска)

	Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат;
	КонецЕсли;

	ПовторовВызовов = Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПовторовВызовов", 0));
	ОшибокИнструментов = Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ОшибокИнструментов", 0));
	Если ПовторовВызовов < ПорогПотребностейПоПовторам()
		И ОшибокИнструментов < ПорогПотребностейПоОшибкам() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ПоказанСборПотребностейДиалога(ИдДиалога) Тогда
			Возврат;
		КонецЕсли;

		ИменаИнструментов = Новый Массив;
		Для Каждого Вызов Из КонтекстЦикла.ВызовыИнструментов Цикл
			ИмяВызванногоИнструмента = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Имя", "")));
			Если НЕ ПустаяСтрока(ИмяВызванногоИнструмента)
				И ИменаИнструментов.Найти(ИмяВызванногоИнструмента) = Неопределено Тогда
				ИменаИнструментов.Добавить(ИмяВызванногоИнструмента);
			КонецЕсли;
		КонецЦикла;
		ВопросПользователя = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(ПараметрыЗапуска, "ЗапросПользователя", "")));
		ЗаписьЖурналаРегистрации("Агент1С.НетИнструмента", УровеньЖурналаРегистрации.Информация, ИдДиалога,,
			"Заход с повторами/ошибками инструментов (повторов: " + Строка(ПовторовВызовов)
			+ ", ошибок инструментов: " + Строка(ОшибокИнструментов) + "). Вопрос: «"
			+ Лев(ВопросПользователя, МаксимальнаяДлинаВопросаВЖурнале())
			+ "». Использованы инструменты: " + СтрСоединить(ИменаИнструментов, ", "));

		Сообщение = Новый Структура;
		Сообщение.Вставить("Роль", "assistant");
		Сообщение.Вставить("Контент", ТекстСбораПотребностей());
		СИ_УправлениеДиалогом.ДобавитьСообщение(ИдДиалога, Сообщение);

		ЗначенияЗаписиДиалога = Новый Структура;
		ЗначенияЗаписиДиалога.Вставить("ПоказанСборПотребностей", Истина);
		ЗаписатьРеквизитыДиалогаЗахода(ИдДиалога, ЗначенияЗаписиДиалога, "ПоказанСборПотребностей");
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.НетИнструмента", УровеньЖурналаРегистрации.Предупреждение, ИдДиалога,,
			"Ошибка сбора потребностей в инструментах: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Признак: абзац-приглашение о нехватке данных уже показывался в этом диалоге.
// Читается реквизит диалога ПоказанСборПотребностей (лёгкое чтение без загрузки
// объекта: диалог параллельно пишется фоновым заданием); поиск по истории
// сообщений здесь не используется - подстрока в контенте сканировала бы всю
// переписку диалога на каждом заходе с повторами.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог.
//
// Возвращаемое значение:
//  Булево - Истина, если абзац в диалоге уже показывали.
Функция ПоказанСборПотребностейДиалога(ИдДиалога)

	Попытка
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдДиалога, "ПоказанСборПотребностей");
		Возврат ЗначенияРеквизитов.ПоказанСборПотребностей = Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Пишет пользователю понятное сообщение о превышении лимита токенов на один ответ.
// Блок вызывается ПОСЛЕ сброса буфера - чтобы хвост ответа модели получил меньшие
// номера сообщений и шёл раньше уведомления о лимите. Успех и статус диалога при
// этом не меняются.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//  Результат - Структура - результат захода (см. ИнициализироватьРезультатЗапуска).
Процедура ЗаписатьСообщениеОЛимитеТокенов(ИдДиалога, КонтекстЦикла, Результат)
	Если Результат.ПричинаЗавершения <> ПричинаMaxTokens() ИЛИ НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ТекстОЛимите = СтрШаблон(
			"⚠ Ответ прерван: превышен лимит токенов на один ответ (%1 / %2). "
			+ "Разбейте запрос на части или начните новый диалог.",
			КонтекстЦикла.ИспользованоТокенов,
			КонтекстЦикла.ЛимитТокеновНаОтвет);
		СообщениеОЛимите = Новый Структура;
		СообщениеОЛимите.Вставить("Роль", "service");
		СообщениеОЛимите.Вставить("Контент", ТекстОЛимите);
		СИ_УправлениеДиалогом.ДобавитьСообщение(ИдДиалога, СообщениеОЛимите);
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ЗапуститьАгента", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка записи сообщения о превышении лимита токенов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Переносит итоги цикла в публичную структуру результата захода.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//  Результат - Структура - результат захода (см. ИнициализироватьРезультатЗапуска).
Процедура СформироватьИтоговыйРезультат(КонтекстЦикла, Результат)
	Если Результат.Ошибки.Количество() = 0 Тогда
		Результат.Успех = Истина;
	КонецЕсли;
	Результат.ИтоговыйТекст = КонтекстЦикла.ИтоговыйТекст;
	Если ПустаяСтрока(Результат.ИтоговыйТекст) Тогда
		ПромежуточныйТекст = КонтекстЦикла.ТекущийПромежуточныйТекст;
		Если НЕ ПустаяСтрока(ПромежуточныйТекст) Тогда
			Результат.ИтоговыйТекст = ПромежуточныйТекст;
		КонецЕсли;
	КонецЕсли;
	Результат.ВызовыИнструментов = КонтекстЦикла.ВызовыИнструментов;
	Результат.КоличествоИтераций = КонтекстЦикла.СчетчикИтераций;
	Результат.ИспользованоТокенов = КонтекстЦикла.ИспользованоТокенов;
	Результат.Вставить("ПромптТокены", Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПромптТокены", 0)));
КонецПроцедуры

// Пишет в журнал регистрации итоговую статистику токенов за сессию (диагностика).
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  Результат - Структура - результат захода (см. ИнициализироватьРезультатЗапуска).
//  МодельАгента - Строка - имя модели агента.
Процедура ЗалогироватьИтоговуюСтатистикуТокенов(ИдДиалога, Результат, МодельАгента)
	Попытка
		ЗаписьЖурналаРегистрации("Агент1С.ИтоговаяСтатистикаТокенов", УровеньЖурналаРегистрации.Информация,
			Строка(ИдДиалога),, "Итераций=" + Строка(Результат.КоличествоИтераций)
			+ " | ВсегоТокенов=" + Строка(Результат.ИспользованоТокенов)
			+ " | ВходныхТокенов(промпт)=" + Строка(Результат.ПромптТокены)
			+ " | Модель=" + МодельАгента);
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.ИтоговаяСтатистикаТокенов", УровеньЖурналаРегистрации.Предупреждение,
			Строка(ИдДиалога),, "Ошибка логирования итоговой статистики токенов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Формирует заголовок нового диалога, если наименование ещё шаблонное («Диалог от …»).
// Ручное переименование не затирается. Способ задаётся глобальной настройкой
// (константа СИ_ЗаголовокЧерезИИ, в структуру Настройки кладёт СИ_НастройкиАгента):
// Ложь (по умолчанию) - заголовок из текста первого запроса без вызова модели;
// Истина - один дешёвый вызов модели.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  Настройки - Структура - настройки профиля подключения.
//  МодельАгента - Строка - имя модели агента.
//  ПрофильПодключения - СправочникСсылка.СИ_ПрофилиПодключений - профиль подключения.
//
// Возвращаемое значение:
//  Строка - новый заголовок (пустая строка, если переименование не требуется).
Функция СформироватьЗаголовокНовогоДиалога(ИдДиалога, Настройки, МодельАгента, ПрофильПодключения)
	НовыйЗаголовок = "";
	Попытка
		ЗначенияРеквизитовДиалога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдДиалога, "Наименование");
		НаименованиеДоГенерации = Строка(ЗначенияРеквизитовДиалога.Наименование);
		Шаблонное = СтрНайти(НаименованиеДоГенерации, "Диалог от") > 0;
		ЗаписьЖурналаРегистрации("Агент1С.Автозаголовок", УровеньЖурналаРегистрации.Информация,
			"Вход в автогенерацию заголовка. Модель=" + Строка(МодельАгента)
			+ " | ПрофильЗаполнен=" + Строка(ЗначениеЗаполнено(ПрофильПодключения))
			+ " | Наименование до: «" + Строка(НаименованиеДоГенерации) + "»"
			+ " | Шаблонное=" + Строка(Шаблонное));
		Если Шаблонное Тогда
			Если СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ЗаголовокЧерезИИ", Ложь) Тогда
				ПараметрыЗаголовка = Новый Структура;
				ПараметрыЗаголовка.Вставить("Модель", МодельАгента);
				ПараметрыЗаголовка.Вставить("Профиль", ПрофильПодключения);
				ПараметрыЗаголовка.Вставить("Настройки", Настройки);
				НовыйЗаголовок = СИ_УправлениеДиалогом.СформироватьЗаголовокДиалога(ИдДиалога, ПараметрыЗаголовка);
			Иначе
				НовыйЗаголовок = СИ_УправлениеДиалогом.СформироватьЗаголовокИзТекста(ИдДиалога);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.Автозаголовок", УровеньЖурналаРегистрации.Предупреждение,
			"Ошибка автогенерации заголовка: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат НовыйЗаголовок;
КонецФункции

// Финализирует диалог одной записью через ядро записи реквизитов: токены за заход,
// размер истории, сводка, очистка активного задания (только для своего захода)
// и новый заголовок. Прежняя схема «ПолучитьОбъект - Заблокировать - Записать»
// роняла запись с «несоответствием версии» на коротких заходах.
//
// Параметры:
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог захода.
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//  Результат - Структура - результат захода (см. ИнициализироватьРезультатЗапуска).
//  НовыйЗаголовок - Строка - новый заголовок диалога (пустая строка, если не требуется).
//  ПрофильМодели - Структура,Неопределено - профиль модели (контекстное окно).
Процедура ЗаписатьФинализациюДиалога(ИдДиалога, КонтекстЦикла, Результат, НовыйЗаголовок, ПрофильМодели)
	СводкаДляСохранения = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "СводкаДиалога", "");
	ПромптТокеныПоследнейИтерации = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла,
		"ПромптТокеныПоследнейИтерации", Неопределено);
	ИсторияТокеновДляСохранения = Число(?(ПромптТокеныПоследнейИтерации = Неопределено, 0, ПромптТокеныПоследнейИтерации));

	ЗначенияЗаписиДиалога = Новый Структура;
	ЗначенияЗаписиДиалога.Вставить("ПрибавитьТокенов", Результат.ИспользованоТокенов);
	ЗначенияЗаписиДиалога.Вставить("ИсторияТокенов", ИсторияТокеновДляСохранения);
	ЗначенияЗаписиДиалога.Вставить("АктивноеЗаданиеИд", "");
	Если ПрофильМодели <> Неопределено Тогда
		ЗначенияЗаписиДиалога.Вставить("ЛимитТокеновЕслиНеЗаполнен",
			СИ_РаботаСJSON.БезопасноПолучить(ПрофильМодели, "КонтекстОкно", 0));
	КонецЕсли;
	Если НЕ ПустаяСтрока(СводкаДляСохранения) Тогда
		ЗначенияЗаписиДиалога.Вставить("СводкаДиалога", Новый ХранилищеЗначения(СводкаДляСохранения));
	КонецЕсли;
	Если НЕ ПустаяСтрока(НовыйЗаголовок) Тогда
		ЗначенияЗаписиДиалога.Вставить("Наименование", НовыйЗаголовок);
	КонецЕсли;

	Если ЗаписатьРеквизитыДиалогаЗахода(ИдДиалога, ЗначенияЗаписиДиалога, "ФинализацияЗахода", Истина)
		И НЕ ПустаяСтрока(НовыйЗаголовок) Тогда
		ЗаписьЖурналаРегистрации("Агент1С.Автозаголовок", УровеньЖурналаРегистрации.Информация,
			"Диалог переименован на: «" + НовыйЗаголовок + "»");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Добавляет сообщение в буфер пакетной записи, если он создан; иначе выполняет
// одиночную запись ДобавитьСообщение (деградация для вызовов без буфера).
// Используется ТОЛЬКО внутри цикла агента (ВыполнитьИтерацию), где буфер всегда
// проброшен через КонтекстЦикла.БуферСообщений.
Процедура ДобавитьСообщениеВЦикле(БуферСообщений, ИдДиалога, Сообщение)
	Если БуферСообщений <> Неопределено Тогда
		СИ_УправлениеДиалогом.ДобавитьСообщениеВБуфер(БуферСообщений, Сообщение);
	Иначе
		СИ_УправлениеДиалогом.ДобавитьСообщение(ИдДиалога, Сообщение);
	КонецЕсли;
КонецПроцедуры

// Отправляет только что добавленное (последнее в буфере) сообщение через живой
// канал уведомлений. Номер сообщения = НачальныйНомер + индекс - ровно тот,
// который сообщение получит при пакетном сбросе буфера в регистр.
// Вызывается из ВыполнитьИтерацию после каждого ДобавитьСообщениеВЦикле.
// best-effort: вся обработка внутри СИ_УправлениеДиалогом.ОтправитьЖивойПакет.
//
// Параметры:
//  БуферСообщений - Структура,Неопределено - буфер из НовыйБуферСообщений;
//   Неопределено (внешний вызов ВыполнитьИтерацию без буфера) - отправка пропускается.
//  КонтекстЦикла - Структура - контекст цикла (для живого прогресса токенов).
Процедура ОтправитьЖивоеПоследнееСообщение(БуферСообщений, КонтекстЦикла)
	
	Если БуферСообщений = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Граница = БуферСообщений.Сообщения.ВГраница();
	Если Граница < 0 Тогда
		Возврат;
	КонецЕсли;
	
	СообщениеПакета = Новый Массив;
	СообщениеПакета.Добавить(БуферСообщений.Сообщения[Граница]);
	
	СИ_УправлениеДиалогом.ОтправитьЖивойПакет(БуферСообщений.ИдДиалога,
		СообщениеПакета, БуферСообщений.НачальныйНомер + Граница,
		Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ИспользованоТокенов", 0)),
		Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПромптТокеныПоследнейИтерации", 0)));
	
КонецПроцедуры

// Проверяет, является ли ошибка вызова модели временной (транспортной), и при необходимости
// выполняет автоповтор с экспоненциальной паузой. Позволяет агенту пережить кратковременные
// сбои сети/DNS, таймауты и временные ошибки API (HTTP 408/429/5xx) вместо остановки задания.
//
// Параметры:
//  КодОшибки - Строка - код ошибки из результата вызова модели (например "TRANSPORT", "408", "500").
//  ТекстОшибки - Строка - текст ошибки (для журнала).
//  КонтекстЦикла - Структура - контекст цикла; счётчик повторов хранится
//    в элементе структуры КонтекстЦикла.ПовторовТранспортнойОшибки.
//  ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - ссылка на диалог (для журнала).
//
// Возвращаемое значение:
//  Булево - Истина, если повторная попытка выполнена (вызывающий код должен повторить вызов модели);
//           Ложь - повторы исчерпаны или ошибка не временная (вызывающий код должен завершить итерацию ошибкой).
Функция ПовторитьВызовПриТранспортнойОшибке(КодОшибки, ТекстОшибки, КонтекстЦикла, ИдДиалога)

	КодЧислом = 0;
	Попытка
		КодЧислом = Число(КодОшибки);
	Исключение
		КодЧислом = 0;
	КонецПопытки;

	КодОшибкиВерхнийРегистр = ВРег(КодОшибки);
	ЭтоТранспортнаяОшибка = (КодОшибкиВерхнийРегистр = "TRANSPORT" ИЛИ КодОшибкиВерхнийРегистр = "TIMEOUT");
	ЭтоКодОграничения = (КодОшибки = "408" ИЛИ КодОшибки = "429");
	ЭтоКод5xx = (КодЧислом >= 500 И КодЧислом < 600);
	ЭтоОшибкаПровайдера = (КодОшибки = "400" И СтрНайти(ВРег(ТекстОшибки), "PROVIDER RETURNED ERROR") > 0);
	ЭтоВременнаяОшибка = ЭтоТранспортнаяОшибка ИЛИ ЭтоКодОграничения ИЛИ ЭтоКод5xx ИЛИ ЭтоОшибкаПровайдера;

	Если НЕ ЭтоВременнаяОшибка Тогда
		Возврат Ложь;
	КонецЕсли;

	МаксПовторов = КоличествоПовторовПоУмолчанию();
	Попытка
		НастройкиКонтекста = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "Настройки", Неопределено);
		Если НастройкиКонтекста <> Неопределено Тогда
			МаксПовторов = Число(СИ_РаботаСJSON.БезопасноПолучить(НастройкиКонтекста,
				"КоличествоПовторовПриТранспортнойОшибке", КоличествоПовторовПоУмолчанию()));
		КонецЕсли;
	Исключение
		МаксПовторов = КоличествоПовторовПоУмолчанию();
	КонецПопытки;

	Если МаксПовторов <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Повторов = Число(СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ПовторовТранспортнойОшибки", 0));
	Если Повторов >= МаксПовторов Тогда
		Возврат Ложь;
	КонецЕсли;

	КонтекстЦикла.Вставить("ПовторовТранспортнойОшибки", Повторов + 1);

	ПаузаСекунд = 3 * (Повторов + 1);
	ЗаписьЖурналаРегистрации("Агент1С.ПовторВызова", УровеньЖурналаРегистрации.Предупреждение,
		Строка(ИдДиалога),, "Транспортная ошибка, автоповтор " + Строка(Повторов + 1)
		+ " из " + Строка(МаксПовторов) + " через " + Строка(ПаузаСекунд) + " сек. Код: "
		+ КодОшибки + ". Текст: " + Лев(ТекстОшибки, 200));

	ПаузаНаСервере(ПаузаСекунд);

	Возврат Истина;

КонецФункции

// Выполняет паузу на сервере.
//
// ВАЖНО: НЕ использует платформенный метод ВызватьПаузу. В фоновых заданиях
// (clientlessMode, в т.ч. встроенный сервер ibsrv файловой ИБ на платформе 8.3.22+)
// этот метод не реализован и вызывает фатальную ошибку ядра «Операция не поддерживается
// clientlessMode [ibsrv - infobaseBase.h (1176)]», которая НЕ перехватывается
// Попыткой/Исключением в BSL и валит всё фоновое задание.
//
// Вместо этого выполняется активное ожидание по системным часам
// (ТекущаяУниверсальнаяДатаВМиллисекундах) — пауза блокирует текущий поток и не
// отменяемая, но это единственный безопасный в любом контексте серверный способ
// (серверного Приостановить не существует). Приемлемо для коротких автоповторов.
//
// Параметры:
//  Секунд - Число - длительность паузы в секундах; значения <= 0 игнорируются.
//
// ⚠ Процедура применима ТОЛЬКО для коротких пауз (до ~10 сек): активное ожидание
//    на 100% нагружает ядро CPU на всё время паузы. Для длинных ожиданий нужен
//    другой механизм (регламентное задание / событие / ожидание завершения ФЗ),
//    а не синхронная пауза в фоновом задании.
Процедура ПаузаНаСервере(Секунд)

	Если Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;

	МоментОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментОкончания Цикл
	КонецЦикла

КонецПроцедуры

// Проверяет прерывание фонового задания (аналог ОбработкаПрерыванияПользователя,
// недоступной в серверном контексте). Вызывается в цикле автоповтора вызова модели.
//
// ВАЖНО: процедура НАМЕРЕННО ничего не делает (no-op) и НЕ выполняет НИКАКИХ
// платформенных вызовов. Экспериментально подтверждено (платформа 8.3.x): в фоновых
// заданиях, выполняющихся в режиме clientlessMode (встроенный сервер ibsrv — в т.ч.
// в ФАЙЛОВОЙ ИБ на платформе 8.3.22+ и в АВТОНОМНОМ СЕРВЕРЕ ibcmd), вызов
// ВызватьПаузу(0) вызывает фатальную ошибку ядра «Операция не поддерживается
// clientlessMode [ibsrv - infobaseBase.h (1176)]», которая НЕ перехватывается
// Попыткой/Исключением в BSL и валит всё задание.
//
// Надёжно отличить такой контекст от обычного клиент-серверного (rphost) изнутри
// фонового задания НЕЛЬЗЯ: ОбщегоНазначения.ИнформационнаяБазаФайловая()
// (-> СтрокаСоединенияИнформационнойБазы()) и ПолучитьТекущийСеансИнформационнойБазы()
// (операции уровня сеанса) в clientlessMode также недоступны, а автономный сервер ibcmd
// по строке соединения выглядит как клиент-серверный (Srvr=...), хотя выполняет ФЗ
// тем же ядром ibsrv. Поэтому БЕЗОПАСНОЕ поведение для ВСЕХ вариантов развёртывания
// (файловая ИБ, клиент-серверная, автономный сервер) — единый no-op.
//
// Отмена задания отслеживается на стороне формы: после ФЗОбъект.Отменить() форма при
// очередном опросе видит статус «Отменено» и не загружает результат. Побочный эффект:
// уже запущенная итерация цикла (включая HTTP-вызов модели) и пауза автоповтора
// (ПаузаНаСервере) доработают до конца и запишут сообщения в регистр — приемлемо.
Процедура ПроверитьПрерываниеФоновогоЗадания()

КонецПроцедуры

// ---- Константы модуля (дефолты, дублируемые из СИ_НастройкиАгента как фолбэк) ----
// Количество автоповторов при транспортной ошибке по умолчанию (константа модуля).
// Дублируется в СИ_НастройкиАгента.ПолучитьНастройки и в форме профиля подключения
// как дефолт профиля — это отдельные источники истины, менять их нужно осознанно.
Функция КоличествоПовторовПоУмолчанию()
	Возврат 2;
КонецФункции

// Размер контекстного окна модели по умолчанию (токенов), когда профиль модели не задан.
Функция КонтекстОкноПоУмолчанию()
	Возврат 128000;
КонецФункции

// Резерв контекстного окна (токенов), который НЕ отдаётся под max_tokens.
// Провайдеры оценивают токены входа точнее нашей эвристики; небольшой запас
// (2% окна, но не более 2000 и не менее 512) защищает от отклонения запроса
// с превышением "max context length" из-за погрешности оценки.
//
// Параметры:
//  Окно - Число - контекстное окно модели (как в КонтекстОкно из профиля модели).
Функция ЗапасКонтекстаДляMaxTokens(Окно)
	Запас = Цел(Окно * 0.02);
	Если Запас < 512 Тогда
		Запас = 512;
	ИначеЕсли Запас > 2000 Тогда
		Запас = 2000;
	КонецЕсли;
	Возврат Запас;
КонецФункции

// Доля контекстного окна, отводимая под историю сообщений (75%).
Функция ПроцентОкнаДляИсторииПоУмолчанию()
	Возврат 0.75;
КонецФункции

// Предельное число открытых форм в блоке системного промпта. Перечень нужен как
// подсказка о рабочем месте, но его текст уходит в запрос на КАЖДОЙ итерации
// агентского цикла, поэтому список не должен расти вместе с числом открытых окон:
// за остальными формами модель обратится к инструментам.
Функция МаксимумФормВПромпте()
	Возврат 25;
КонецФункции

// Порог количества сообщений, при котором история считается «длинной» и сжимается.
Функция КоличествоСообщенийДляСжатия()
	Возврат 10;
КонецФункции

// Ключ вызова инструмента для кэша повторов: «имя + аргументы» со стабильной
// сериализацией. Служебные ключи (ИдДиалога, ПрофильПодключения) исключаются -
// их добавляет сам агент, к решению модели они отношения не имеют.
//
// Параметры:
//  Имя - Строка - имя инструмента.
//  Аргументы - Структура, Соответствие из Произвольный, Произвольный - аргументы вызова.
//
// Возвращаемое значение:
//  Строка - ключ кэша.
Функция КлючВызоваИнструмента(Имя, Аргументы)
	ЧистыеАргументы = Аргументы;
	Если ТипЗнч(Аргументы) = Тип("Структура") ИЛИ ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		ЧистыеАргументы = Новый Соответствие;
		Для Каждого ЭлементАргумента Из Аргументы Цикл
			Ключ = Строка(ЭлементАргумента.Ключ);
			Если Ключ = "ИдДиалога" ИЛИ Ключ = "ПрофильПодключения" Тогда
				Продолжить;
			КонецЕсли;
			ЧистыеАргументы.Вставить(Ключ, ЭлементАргумента.Значение);
		КонецЦикла;
	КонецЕсли;
	ТекстАргументов = "";
	Попытка
		ТекстАргументов = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(ЧистыеАргументы);
	Исключение
		ТекстАргументов = "";
	КонецПопытки;
	Если ПустаяСтрока(ТекстАргументов) Тогда
		ТекстАргументов = АргументыСТипами(ЧистыеАргументы);
	КонецЕсли;
	Возврат Строка(Имя) + ":" + ТекстАргументов;
КонецФункции

// Резервное представление аргументов вызова для ключа кэша: к строковому значению
// добавляется тип значения - иначе разные значения могли бы дать одинаковый ключ.
//
// Параметры:
//  Аргументы - Произвольный - очищенные аргументы вызова (служебные ключи убраны).
//
// Возвращаемое значение:
//  Строка - текстовое представление аргументов с типами.
Функция АргументыСТипами(Аргументы)
	ТипАргументов = ТипЗнч(Аргументы);
	Если ТипАргументов <> Тип("Структура") И ТипАргументов <> Тип("Соответствие") Тогда
		Возврат Строка(ТипАргументов) + "|" + Строка(Аргументы);
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого ЭлементАргумента Из Аргументы Цикл
		Части.Добавить(Строка(ЭлементАргумента.Ключ) + "="
			+ Строка(ТипЗнч(ЭлементАргумента.Значение)) + ":" + Строка(ЭлементАргумента.Значение));
	КонецЦикла;
	Возврат "{" + СтрСоединить(Части, ",") + "}";
КонецФункции

// Обрезает один результат инструмента до предохранительного предела: сжатие истории
// работает позже и может не успеть, если один результат съел контекстное окно.
// JSON-контент обрезается структурно (см. ОбрезатьJSONСтруктурно), текстовый - по символам.
//
// Параметры:
//  Контент - Строка,Произвольный - сериализованный результат инструмента.
//  ИмяИнструмента - Строка - имя инструмента (для журнала).
//
// Возвращаемое значение:
//  Строка,Произвольный - результат в пределах лимита.
Функция ОбрезатьРезультатИнструмента(Контент, ИмяИнструмента)
	Если ТипЗнч(Контент) <> Тип("Строка") Тогда
		Возврат Контент;
	КонецЕсли;
	Предел = МаксимальнаяДлинаРезультатаИнструмента();
	Если СтрДлина(Контент) <= Предел Тогда
		Возврат Контент;
	КонецЕсли;

	РезультатОбрезки = ОбрезатьJSONСтруктурно(Контент, Предел);
	Если НЕ ПустаяСтрока(РезультатОбрезки) Тогда
		ЗаписьЖурналаРегистрации("Агент1С.ОбрезкаРезультата", УровеньЖурналаРегистрации.Информация,,,
			"Результат " + Строка(ИмяИнструмента) + " обрезан структурно: " + Строка(СтрДлина(Контент))
			+ " → " + Строка(СтрДлина(РезультатОбрезки)) + " знаков.");
		Возврат РезультатОбрезки;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Агент1С.ОбрезкаРезультата", УровеньЖурналаРегистрации.Информация,,,
		"Результат " + Строка(ИмяИнструмента) + " обрезан: " + Строка(СтрДлина(Контент))
		+ " → " + Строка(Предел) + " знаков.");
	СуффиксОбрезки = " (Система: результат сокращён до предельного размера; запросите меньше данных и повторите)";
	Возврат Лев(Контент, Предел - СтрДлина(СуффиксОбрезки)) + СуффиксОбрезки;
КонецФункции

// Быстрая проверка «контент похож на JSON-объект или массив». Полный разбор без
// такой проверки писал бы в журнал регистрации ошибку парсера на каждом текстовом
// результате инструмента.
//
// Параметры:
//  Контент - Строка - контент результата инструмента.
//
// Возвращаемое значение:
//  Булево - Истина, если контент начинается с «{»/«[» и заканчивается «}»/«]».
Функция ПохожеНаJSON(Контент)
	Текст = СокрЛП(Контент);
	ПервыйСимвол = Лев(Текст, 1);
	Если ПервыйСимвол <> "{" И ПервыйСимвол <> "[" Тогда
		Возврат Ложь;
	КонецЕсли;
	ПоследнийСимвол = Прав(Текст, 1);
	Возврат ПоследнийСимвол = "}" ИЛИ ПоследнийСимвол = "]";
КонецФункции

// Структурная обрезка JSON-контента: объекты и массивы усекаются по элементам
// (не помещающиеся опускаются целиком), поэтому модель получает ВАЛИДНЫЙ JSON с
// явным признаком неполноты, а не оборванную строку. Строковые значения, которые
// сами не помещаются, укорачиваются с пометкой внутри значения.
//
// Параметры:
//  Контент - Строка - контент результата инструмента.
//  Предел - Число - предельная длина результата в знаках.
//
// Возвращаемое значение:
//  Строка - обрезанный JSON; пустая строка, если контент не JSON или структурная
//    обрезка не удалась (тогда вызывающий обрезает контент по символам).
Функция ОбрезатьJSONСтруктурно(Контент, Предел)
	Если НЕ ПохожеНаJSON(Контент) Тогда
		Возврат "";
	КонецЕсли;
	Разобранное = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(Контент);
	Если Разобранное = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	КлючПризнака = "_РезультатОбрезан";
	ТекстПризнака = "результат уменьшен до допустимого размера, часть элементов исключена; запросите меньший объём данных";
	Запас = СтрДлина(КлючПризнака) + ДлинаJSONСтроки(ТекстПризнака) + 8;

	Бюджет = Предел - Запас;
	Для НомерПопытки = 1 По 4 Цикл
		Если Бюджет < 128 Тогда
			Возврат "";
		КонецЕсли;
		Усечённое = УсечьJSONЗначение(Разобранное, Бюджет);
		Текст = СобратьОбрезанныйJSON(Усечённое.Получить("Значение"), Усечённое.Получить("Обрезано"),
			КлючПризнака, ТекстПризнака);
		Если ПустаяСтрока(Текст) Тогда
			Возврат "";
		КонецЕсли;
		Если СтрДлина(Текст) <= Предел Тогда
			Возврат Текст;
		КонецЕсли;
		Бюджет = Цел(Бюджет * Предел / СтрДлина(Текст)) - 16;
	КонецЦикла;
	Возврат "";
КонецФункции

// Усечение одного узла разобранного JSON по бюджету знаков: контейнеры обходятся
// по элементам, помещающиеся сохраняются, остальные опускаются целиком.
//
// Параметры:
//  Значение - Произвольный - узел разобранного JSON (Соответствие, Массив, скаляр).
//  Бюджет - Число - бюджет длины JSON-представления узла в знаках.
//
// Возвращаемое значение:
//  Соответствие из Строка, Произвольный:
//   * Значение - Произвольный - усечённый узел;
//   * Длина - Число - оценка длины JSON-представления в знаках;
//   * Помещается - Булево - узел удалось представить;
//   * Обрезано - Булево - часть данных узла опущена.
Функция УсечьJSONЗначение(Значение, Бюджет)
	Результат = Новый Соответствие;
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Длина", 0);
	Результат.Вставить("Помещается", Ложь);
	Результат.Вставить("Обрезано", Ложь);

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда
		ДлинаСтроки = ДлинаJSONСтроки(Значение);
		Если ДлинаСтроки <= Бюджет Тогда
			Результат.Вставить("Значение", Значение);
			Результат.Вставить("Длина", ДлинаСтроки);
			Результат.Вставить("Помещается", Истина);
			Возврат Результат;
		КонецЕсли;
		Хвост = " …[обрезано]";
		ЗнаковДляСохранения = Цел((Бюджет - 2) / 1.5) - СтрДлина(Хвост);
		Если ЗнаковДляСохранения < 0 Тогда
			ЗнаковДляСохранения = 0;
		КонецЕсли;
		УсечённаяСтрока = Лев(Значение, ЗнаковДляСохранения) + Хвост;
		Результат.Вставить("Значение", УсечённаяСтрока);
		Результат.Вставить("Длина", ДлинаJSONСтроки(УсечённаяСтрока));
		Результат.Вставить("Помещается", Истина);
		Результат.Вставить("Обрезано", Истина);
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Элементы = Новый Массив;
		Использовано = 2;
		Опущено = 0;
		ОбрезаноУзел = Ложь;
		Для Каждого Элемент Из Значение Цикл
			Если Опущено > 0 Тогда
				Опущено = Опущено + 1;
				Продолжить;
			КонецЕсли;
			РезультатЭлемента = УсечьJSONЗначение(Элемент, Бюджет - Использовано - 1);
			Если РезультатЭлемента.Получить("Помещается") <> Истина
				ИЛИ Использовано + РезультатЭлемента.Получить("Длина") + 1 > Бюджет Тогда
				Опущено = 1;
				ОбрезаноУзел = Истина;
				Продолжить;
			КонецЕсли;
			Элементы.Добавить(РезультатЭлемента.Получить("Значение"));
			Использовано = Использовано + РезультатЭлемента.Получить("Длина") + 1;
			Если РезультатЭлемента.Получить("Обрезано") = Истина Тогда
				ОбрезаноУзел = Истина;
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("Значение", Элементы);
		Результат.Вставить("Длина", Использовано);
		Результат.Вставить("Помещается", Истина);
		Результат.Вставить("Обрезано", ОбрезаноУзел);
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("Структура") Тогда
		Свойства = Новый Соответствие;
		Использовано = 2;
		Опущено = 0;
		ОбрезаноУзел = Ложь;
		Для Каждого Элемент Из Значение Цикл
			Если Опущено > 0 Тогда
				Опущено = Опущено + 1;
				Продолжить;
			КонецЕсли;
			ИмяСвойства = Строка(Элемент.Ключ);
			СлужебнаяДлина = СтрДлина(ИмяСвойства) + 3;
			РезультатЭлемента = УсечьJSONЗначение(Элемент.Значение, Бюджет - Использовано - СлужебнаяДлина);
			Если РезультатЭлемента.Получить("Помещается") <> Истина
				ИЛИ Использовано + СлужебнаяДлина + РезультатЭлемента.Получить("Длина") > Бюджет Тогда
				Опущено = 1;
				ОбрезаноУзел = Истина;
				Продолжить;
			КонецЕсли;
			Свойства.Вставить(ИмяСвойства, РезультатЭлемента.Получить("Значение"));
			Использовано = Использовано + СлужебнаяДлина + РезультатЭлемента.Получить("Длина");
			Если РезультатЭлемента.Получить("Обрезано") = Истина Тогда
				ОбрезаноУзел = Истина;
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("Значение", Свойства);
		Результат.Вставить("Длина", Использовано);
		Результат.Вставить("Помещается", Истина);
		Результат.Вставить("Обрезано", ОбрезаноУзел);
		Возврат Результат;
	КонецЕсли;

	ТекстСкаляра = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Значение);
	Если ПустаяСтрока(ТекстСкаляра) ИЛИ СтрДлина(ТекстСкаляра) > Бюджет Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("Значение", Значение);
	Результат.Вставить("Длина", СтрДлина(ТекстСкаляра));
	Результат.Вставить("Помещается", Истина);
	Возврат Результат;
КонецФункции

// Оценка длины JSON-представления строки: кавычки плюс запас на экранирование.
// Типичный текст обходится без экранирования, поэтому берётся множитель 1.5;
// фактическая длина проверяется по итоговой длине всего результата.
//
// Параметры:
//  Значение - Строка - строковое значение.
//
// Возвращаемое значение:
//  Число - оценка длины в знаках.
Функция ДлинаJSONСтроки(Значение)
	Возврат Цел(СтрДлина(Значение) * 1.5) + 2;
КонецФункции

// Сборка итогового текста обрезанного результата. Объект получает служебный ключ-
// признак неполноты первым; массив (у него нет места под служебный ключ)
// заворачивается в объект с тем же признаком.
//
// Параметры:
//  Значение - Произвольный - усечённый узел JSON.
//  Обрезано - Булево - признак, что часть данных узла опущена.
//  КлючПризнака - Строка - имя служебного ключа.
//  ТекстПризнака - Строка - текст служебного ключа для модели.
//
// Возвращаемое значение:
//  Строка - JSON-текст (пустая строка при ошибке сериализации).
Функция СобратьОбрезанныйJSON(Значение, Обрезано, КлючПризнака, ТекстПризнака)
	Если Обрезано <> Истина Тогда
		Возврат СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Значение);
	КонецЕсли;
	Обёртка = Новый Соответствие;
	Обёртка.Вставить(КлючПризнака, ТекстПризнака);
	Если ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("Структура") Тогда
		Для Каждого Элемент Из Значение Цикл
			Обёртка.Вставить(Строка(Элемент.Ключ), Элемент.Значение);
		КонецЦикла;
	Иначе
		Обёртка.Вставить("Данные", Значение);
	КонецЕсли;
	Возврат СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Обёртка);
КонецФункции

// Предохранительный предел длины одного результата инструмента (знаков).
// Ненастраиваемый потолок безопасности: сжатие истории работает по токенам,
// а этот предел ограничивает единичный «выброс» до попадания в историю.
Функция МаксимальнаяДлинаРезультатаИнструмента()
	Возврат 20000;
КонецФункции

// Порог числа повторных вызовов инструментов с теми же аргументами, после которого
// инструменты отключаются и модель обязана ответить по уже собранным данным
// (защита от зацикливания; см. главный цикл ВыполнитьЦиклАгента).
Функция МаксимумПовторовВызовов()
	Возврат 2;
КонецФункции

// Предел длительности одного захода (секунд): после него инструменты отключаются
// и модель обязана ответить по уже собранным данным. Жёсткие предохранители
// (HardIterations/MaxTokens) при этом не меняются.
Функция ЛимитВремениЗаходаСекунд()
	Возврат 480;
КонецФункции

// Признак: заход идёт дольше отведённого времени.
//
// Параметры:
//  КонтекстЦикла - Структура - контекст цикла (см. СформироватьКонтекстЦикла).
//
// Возвращаемое значение:
//  Булево.
Функция ЗаходДольшеЛимитаВремени(КонтекстЦикла)
	МоментНачала = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "МоментНачалаЗахода", Неопределено);
	Если ТипЗнч(МоментНачала) <> Тип("Дата") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат (ТекущаяУниверсальнаяДата() - МоментНачала) > ЛимитВремениЗаходаСекунд();
КонецФункции

// Страховка пакета вызовов: сбой внутри ОбработатьВызовыИнструментов не должен
// оставить вызовы без результатов - история с assistant(tool_calls) без ответов
// будет отвергнута API на следующей отправке.
//
// Параметры:
//  Вызовы - Массив из Структура - вызовы итерации (формат ответа модели).
//  Результат - Массив из Структура - уже сформированные tool-сообщения (дополняется).
//  ТекстОшибки - Строка - описание сбоя для сообщения модели.
//  КонтекстЦикла - Структура - контекст цикла: вызовы, отложенные до решения
//    пользователя (ОжиданиеРазрешения), ответа здесь НЕ получают - их исполнит
//    ВыполнитьОтложенныеВызовы при возобновлении захода. Иначе в истории оказались
//    бы два tool-ответа с одним ИдВызова (ошибка от страховки и результат от
//    возобновления), то есть ровно та история, которую страховка и должна исключать.
Процедура ДополнитьНевыполненныеВызовы(Вызовы, Результат, ТекстОшибки, КонтекстЦикла)
	Если ТипЗнч(Вызовы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Отвеченные = Новый Соответствие;
	Для Каждого СообщениеРезультата Из Результат Цикл
		ИдОтвета = Строка(СИ_РаботаСJSON.БезопасноПолучить(СообщениеРезультата, "ИдВызоваИнструмента", ""));
		Если НЕ ПустаяСтрока(ИдОтвета) Тогда
			Отвеченные.Вставить(НРег(ИдОтвета), Истина);
		КонецЕсли;
	КонецЦикла;

	Отложенные = Новый Соответствие;
	ОжиданиеРазрешения = СИ_РаботаСJSON.БезопасноПолучить(КонтекстЦикла, "ОжиданиеРазрешения", Неопределено);
	Если ТипЗнч(ОжиданиеРазрешения) = Тип("Массив") Тогда
		Для Каждого ВызовОжидания Из ОжиданиеРазрешения Цикл
			ИдОжидания = Строка(СИ_РаботаСJSON.БезопасноПолучить(ВызовОжидания, "Ид", ""));
			Если НЕ ПустаяСтрока(ИдОжидания) Тогда
				Отложенные.Вставить(НРег(ИдОжидания), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Вызов Из Вызовы Цикл
		ИдВызова = Строка(СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Ид", ""));
		Если ПустаяСтрока(ИдВызова) Тогда
			Продолжить;
		КонецЕсли;
		ИдКлюча = НРег(ИдВызова);
		Если Отвеченные.Получить(ИдКлюча) <> Неопределено ИЛИ Отложенные.Получить(ИдКлюча) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Данные = Новый Структура;
		Данные.Вставить("Ошибка", "Вызов не был выполнен из-за внутренней ошибки агента: " + Строка(ТекстОшибки));
		СообщениеОшибки = Новый Структура;
		СообщениеОшибки.Вставить("Роль", "tool");
		СообщениеОшибки.Вставить("ИдВызоваИнструмента", ИдВызова);
		СообщениеОшибки.Вставить("ИмяИнструмента", Строка(СИ_РаботаСJSON.БезопасноПолучить(Вызов, "Имя", "")));
		СообщениеОшибки.Вставить("Контент", СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Данные));
		СообщениеОшибки.Вставить("ДлительностьИсполненияМс", 0);
		СообщениеОшибки.Вставить("УспехИсполнения", Ложь);
		Результат.Добавить(СообщениеОшибки);
	КонецЦикла;
КонецПроцедуры

// Защитный лимит токенов на один ответ (одно фоновое задание).
// Значение берётся из константы СИ_ЛимитТокеновНаОтвет через
// СИ_НастройкиАгента.ПолучитьЛимитТокеновНаОтвет (фолбэк 1000000).
// Применяется ТОЛЬКО к расходу текущего захода (ИспользованоТокенов),
// накопленный ПотраченоТокенов диалога в проверке не участвует.
Функция ЗащитныйЛимитТокеновНаОтвет()
	Возврат СИ_НастройкиАгента.ПолучитьЛимитТокеновНаОтвет();
КонецФункции

// ЖЁСТКИЙ предохранитель: максимальное суммарное число итераций агента за ОДИН
// запуск (заход). В отличие от мягкого MaxIterations, превышение этого предела
// БЕЗУСЛОВНО прерывает цикл — защита от зацикливания модели (бесконечная цепочка
// tool-вызовов). Значение 500 заведомо больше типовых настраиваемых значений
// MaxIterations (обычно 10–100), поэтому мягкий лимит профиля НЕ упирается в этот
// потолок без причины; при этом 500 итераций на один запуск — экстремальный
// сценарий, защита от бесконечного цикла. Это ненастраиваемый потолок безопасности:
// сознательно не вынесен в профиль подключения.
Функция ЗащитныйЛимитИтерацийСессии()
	Возврат 500;
КонецФункции

