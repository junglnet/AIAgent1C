#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АктивныйРежимТекущий = Константы.СИ_АктивныйРежим.Получить();

	ЛимитТокеновНаОтвет = Константы.СИ_ЛимитТокеновНаОтвет.Получить();
	Если НЕ ЗначениеЗаполнено(ЛимитТокеновНаОтвет) Тогда
		// Лимит ещё не задан - предлагаем 10 000 000 по умолчанию.
		ЛимитТокеновНаОтвет = 10000000;
	КонецЕсли;

	ЗаголовокЧерезИИ = Константы.СИ_ЗаголовокЧерезИИ.Получить();

	// Значения по умолчанию для шага «Профиль подключения».
	ТипАвторизации = Перечисления.СИ_ТипыАвторизации.Bearer;
	ИмяЗаголовкаАвторизации = "Authorization";
	ПроверятьSSL = Истина;
	Таймаут = 60;
	// Рассуждения (reasoning) разрешены по умолчанию.
	РазрешитьРассуждения = Истина;
	УстановитьВидимостьИмениЗаголовка();

	// Значения по умолчанию для шага «Режим работы».
	Температура = 0.7;
	СистемныйПромпт = СИ_Промпты.ПолучитьСистемныйПромптПоУмолчанию();

	// По умолчанию предлагаем настроить текущий активный режим и его профиль.
	Если ЗначениеЗаполнено(АктивныйРежимТекущий) Тогда
		РеквизитыРежима = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктивныйРежимТекущий, "Профиль");
		Если ЗначениеЗаполнено(РеквизитыРежима.Профиль) Тогда
			ПрофильПодключения = РеквизитыРежима.Профиль;
			ЗагрузитьДанныеПрофиля();
		КонецЕсли;
	КонецЕсли;

	// Начальный шаг - приветствие; страницы переключаются только кнопками мастера.
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПриветствие;
	Элементы.КнопкаНазад.Видимость = Ложь;
	Элементы.КнопкаДалее.Заголовок = НСтр("ru='Далее'");
	ЭтаФорма.Заголовок = НСтр("ru='Мастер настройки агента ИИ - шаг 1 из 6'");

	Элементы.ДекорацияСостояниеНастроек.Заголовок = СостояниеНастроекТекст();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Страницы мастера не отображаются вкладками - навигация только кнопками.
	Элементы.Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;

КонецПроцедуры

#КонецОбласти

