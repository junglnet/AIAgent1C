КонецФункции

// Сводка по продажам за период.
//
// Параметры:
//  Аргументы - Структура/Соответствие - параметры вызова:
//    * НачалоПериода, КонецПериода - Строка,Неопределено - даты ГГГГ-ММ-ДД.
//
// Возвращаемое значение:
//  Структура - {Успех, Значение, Ошибка}.
Функция ПолучитьСводкуПродаж(Аргументы) Экспорт

	Результат = НовыйРезультатИнструмента();

	Попытка
		Регистр = НайтиРегистрПродаж();
		Если Регистр = Неопределено Тогда
			Результат.Ошибка = ТекстОтсутствияОбъектов("продаж",
				"регистр накопления вида «Обороты» с ресурсом суммы и измерением номенклатуры/контрагента");
			Возврат Результат;
		КонецЕсли;

		РесурсВыручки = НайтиПолеПоПризнакам(Регистр.Ресурсы, "выручк,сумм,стоимост,оборот");
		Если ПустаяСтрока(РесурсВыручки) Тогда
			Результат.Ошибка = "В регистре " + Регистр.Таблица
				+ " не найден ресурс суммы/выручки. Сводка недоступна - используйте ExecuteDBQuery.";
			Возврат Результат;
		КонецЕсли;

		РесурсСебестоимости = НайтиПолеПоПризнакам(Регистр.Ресурсы, "себестоимост,затрат,расход");
		Если НЕ ПустаяСтрока(РесурсСебестоимости) И РесурсСебестоимости = РесурсВыручки Тогда
			РесурсСебестоимости = "";
		КонецЕсли;
		РесурсКоличества = НайтиПолеПоПризнакам(Регистр.Ресурсы, "количеств");
		ИзмерениеТовара = НайтиПолеПоПризнакам(Регистр.Измерения, "номенклатур,товар,продукц,услуг");
		ИзмерениеКлиента = НайтиПолеПоИзмерениямКонтрагента(Регистр.Измерения);

		Период = ПериодСводки(Аргументы);
		Данные = СводкаПродажЗаПериод(Регистр, РесурсВыручки, РесурсСебестоимости,
			РесурсКоличества, Период.Начало, Период.Конец);
		Если НЕ Данные.Успех Тогда
			Результат.Ошибка = Данные.Ошибка;
			Возврат Результат;
		КонецЕсли;

		Выручка = ЧислоИзСтроки(Данные.Строка, "Выручка");
		Себестоимость = ЧислоИзСтроки(Данные.Строка, "Себестоимость");
		Количество = ЧислоИзСтроки(Данные.Строка, "Количество");
		Продаж = ЧислоИзСтроки(Данные.Строка, "Продаж");

		Показатели = Новый Массив;
		Показатели.Добавить(НовыйПоказатель("Выручка", "Выручка за период", Выручка,
			"руб", "", Неопределено, ?(Выручка < 0, "Высокая", "Обычная"), ""));

		Если НЕ ПустаяСтрока(РесурсСебестоимости) Тогда
			Маржа = Выручка - Себестоимость;
			МаржаПроцент = ?(Выручка <> 0, Окр(Маржа / Выручка * 100, 1), Неопределено);
			Показатели.Добавить(НовыйПоказатель("Маржа", "Маржа (выручка минус себестоимость)", Маржа,
				"руб", "", МаржаПроцент, "Обычная", "Маржа в процентах от выручки: " + ФорматПроцента(МаржаПроцент)));
		КонецЕсли;

		Если НЕ ПустаяСтрока(РесурсКоличества) Тогда
			Показатели.Добавить(НовыйПоказатель("Количество", "Количество", Количество,
				"ед", "", Неопределено, "Обычная", ""));
		КонецЕсли;

		Показатели.Добавить(НовыйПоказатель("Продаж", "Число продаж (документов-регистраторов)", Продаж,
			"шт", "", Неопределено, "Обычная", ""));

		ПрошлыйМесяц = СводкаВыручкиРегистра(Регистр, РесурсВыручки,
			НачалоМесяца(ДобавитьМесяц(Период.Начало, -1)),
			КонецДня(КонецМесяца(ДобавитьМесяц(Период.Начало, -1))));
		ПрошлыйГод = СводкаВыручкиРегистра(Регистр, РесурсВыручки,
			ДобавитьМесяц(Период.Начало, -12), КонецДня(ДобавитьМесяц(Период.Конец, -12)));

		Если ПрошлыйМесяц.Успех Тогда
			Показатели.Добавить(НовыйПоказатель("ВыручкаПрошлыйМесяц", "Выручка в прошлом месяце",
				ПрошлыйМесяц.Значение, "руб", "прошлый месяц", ИзменениеПроцентов(Выручка, ПрошлыйМесяц.Значение),
				"Обычная", ""));
		КонецЕсли;
		Если ПрошлыйГод.Успех Тогда
			Показатели.Добавить(НовыйПоказатель("ВыручкаПрошлыйГод", "Выручка за тот же период прошлого года",
				ПрошлыйГод.Значение, "руб", "прошлый год", ИзменениеПроцентов(Выручка, ПрошлыйГод.Значение),
				"Обычная", ""));
		КонецЕсли;

		Строки = Новый Массив;
		Если НЕ ПустаяСтрока(ИзмерениеТовара) Тогда
			ТопТоваров = ТопПоИзмерению(Регистр, ИзмерениеТовара, РесурсВыручки, Период, 5);
			ДобавитьСтрокиТопа(Строки, ТопТоваров, "Товары");
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИзмерениеКлиента) Тогда
			ТопКлиентов = ТопПоИзмерению(Регистр, ИзмерениеКлиента, РесурсВыручки, Период, 5);
			ДобавитьСтрокиТопа(Строки, ТопКлиентов, "Клиенты");
		КонецЕсли;

		Подсказка = "Скажите пользователю период и ключевые цифры (выручка, маржа, сравнение). "
			+ "Для детального списка документов используйте ExecuteDBQuery.";

		Если Выручка = 0 И Строки.Количество() = 0 Тогда
			Последняя = ДатаПоследнейПродажи(Регистр);
			Пояснение = "За период продаж нет.";
			Если НЕ ПустаяСтрока(Последняя) Тогда
				Пояснение = Пояснение + " Последняя продажа: " + Последняя + ".";
			КонецЕсли;
			Показатели.Добавить(НовыйПоказатель("ПродажНет", "Продаж за период нет", 0,
				"шт", "", Неопределено, "Высокая", Пояснение));
			Подсказка = Пояснение + " Не перепроверяйте другими запросами: при необходимости уточните период.";
		КонецЕсли;

		Результат.Значение = НовоеЗначениеСводки(Период.Подпись, Показатели, Строки, Подсказка);
		Результат.Успех = Истина;

	Исключение
		Результат.Ошибка = "Ошибка сводки по продажам: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Сводка по деньгам и долгам.
//
// Параметры:
//  Аргументы - Структура/Соответствие:
//    * НачалоПериода, КонецПериода - Строка,Неопределено - период оборотов;
//    * ДатаОстатков - Строка,Неопределено - дата остатков.
//
// Возвращаемое значение:
//  Структура - {Успех, Значение, Ошибка}.
Функция ПолучитьСводкуДенег(Аргументы) Экспорт

	Результат = НовыйРезультатИнструмента();

	Попытка
		Критерии = Новый Массив;
		Критерии.Добавить(КритерийРегистраДенег());
		Критерии.Добавить(КритерийРегистраРасчетов());
		НайденныеРегистры = НайтиРегистрыСводок(Критерии);
		РегистрДенег = НайденныеРегистры.Получить("Деньги");
		РегистрРасчетов = НайденныеРегистры.Получить("Долги");

		Если РегистрДенег = Неопределено И РегистрРасчетов = Неопределено Тогда
			Результат.Ошибка = ТекстОтсутствияОбъектов("денег и долгов",
				"регистр накопления вида «Остатки» с ресурсом суммы (денежные средства) или измерением контрагента (расчёты)");
			Возврат Результат;
		КонецЕсли;

		Период = ПериодСводки(Аргументы);
		ДатаОстатков = ДатаИзАргументов(Аргументы, "ДатаОстатков");
		Если ДатаОстатков = Неопределено Тогда
			ДатаОстатков = КонецДня(ТекущаяДатаСеанса());
		Иначе
			ДатаОстатков = КонецДня(ДатаОстатков);
		КонецЕсли;

		Показатели = Новый Массив;
		Строки = Новый Массив;
		Пояснения = Новый Массив;

		Если РегистрДенег <> Неопределено Тогда
			РесурсСуммы = НайтиПолеПоПризнакам(РегистрДенег.Ресурсы, "сумм,остат");
			Если Не ПустаяСтрока(РесурсСуммы) Тогда
				Остаток = ОстатокРегистра(РегистрДенег, РесурсСуммы, ДатаОстатков);
				Если Остаток.Успех Тогда
					Показатели.Добавить(НовыйПоказатель("ДеньгиОстаток", "Остаток денежных средств",
						Остаток.Значение, "руб", "на " + Формат(ДатаОстатков, "ДЛФ=D"), Неопределено,
						?(Остаток.Значение < 0, "Высокая", "Обычная"), ""));
				Иначе
					Пояснения.Добавить("Остаток денег не рассчитан: " + Остаток.Ошибка);
				КонецЕсли;

				Обороты = ОборотыРегистраДенег(РегистрДенег, РесурсСуммы, Период.Начало, Период.Конец);
				Если Обороты.Успех Тогда
					Показатели.Добавить(НовыйПоказатель("Поступления", "Поступления за период",
						Обороты.Поступления, "руб", Период.Подпись, Неопределено, "Обычная", ""));
					Показатели.Добавить(НовыйПоказатель("Списания", "Списания за период",
						Обороты.Списания, "руб", Период.Подпись, Неопределено, "Обычная", ""));
				Иначе
					Пояснения.Добавить("Обороты денег не рассчитаны: " + Обороты.Ошибка);
				КонецЕсли;
			Иначе
				Пояснения.Добавить("В регистре " + РегистрДенег.Таблица + " не найден ресурс суммы.");
			КонецЕсли;
		Иначе
			Пояснения.Добавить("Регистр денежных средств не найден: остатки и обороты денег не показаны.");
		КонецЕсли;

		Если РегистрРасчетов <> Неопределено Тогда
			РесурсДолга = НайтиПолеПоПризнакам(РегистрРасчетов.Ресурсы, "сумм,остат,долг");
			ИзмерениеКонтрагента = НайтиПолеПоИзмерениямКонтрагента(РегистрРасчетов.Измерения);
			Если Не ПустаяСтрока(РесурсДолга) Тогда
				Долги = СальдоПоКонтрагентам(РегистрРасчетов, РесурсДолга, ИзмерениеКонтрагента, ДатаОстатков);
				Если Долги.Успех Тогда
					Показатели.Добавить(НовыйПоказатель("Дебиторка", "Дебиторская задолженность (нам должны)",
						Долги.Дебиторка, "руб", "на " + Формат(ДатаОстатков, "ДЛФ=D"), Неопределено,
						"Обычная", "Просроченная задолженность выделяется только при наличии признака срока оплаты в базе."));
					Показатели.Добавить(НовыйПоказатель("Кредиторка", "Кредиторская задолженность (мы должны)",
						Долги.Кредиторка, "руб", "на " + Формат(ДатаОстатков, "ДЛФ=D"), Неопределено,
						"Обычная", ""));
					ДобавитьСтрокиТопа(Строки, Долги.ТопДолжников, "Должники");
				Иначе
					Пояснения.Добавить("Долги не рассчитаны: " + Долги.Ошибка);
				КонецЕсли;
			Иначе
				Пояснения.Добавить("В регистре " + РегистрРасчетов.Таблица + " не найден ресурс суммы долга.");
			КонецЕсли;
		Иначе
			Пояснения.Добавить("Регистр расчётов не найден: долги не показаны.");
		КонецЕсли;

		Подсказка = "Скажите пользователю ключевые цифры: остаток денег, поступления/списания, дебиторку и кредиторку. "
			+ "Детализацию по документам и контрагентам можно получить через ExecuteDBQuery.";
		Если Пояснения.Количество() > 0 Тогда
			Подсказка = Подсказка + " " + СтрСоединить(Пояснения, " ");
		КонецЕсли;

		Результат.Значение = НовоеЗначениеСводки(Период.Подпись, Показатели, Строки, Подсказка);
		Результат.Успех = Истина;

	Исключение
		Результат.Ошибка = "Ошибка сводки по деньгам: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Сводка по складу.
//
// Параметры:
//  Аргументы - Структура/Соответствие:
//    * ДатаОстатков - Строка,Неопределено - дата остатков;
//    * МесяцевБезДвижения - Число,Неопределено - глубина проверки движения.
//
// Возвращаемое значение:
//  Структура - {Успех, Значение, Ошибка}.
Функция ПолучитьСводкуСклада(Аргументы) Экспорт

	Результат = НовыйРезультатИнструмента();

	Попытка
		Регистр = НайтиРегистрОстатков();
		Если Регистр = Неопределено Тогда
			Результат.Ошибка = ТекстОтсутствияОбъектов("склада",
				"регистр накопления вида «Остатки» с ресурсом количества и измерением номенклатуры");
			Возврат Результат;
		КонецЕсли;

		РесурсКоличества = НайтиПолеПоПризнакам(Регистр.Ресурсы, "количеств");
		РесурсСтоимости = НайтиПолеПоПризнакам(Регистр.Ресурсы, "стоимост,сумм");
		ИзмерениеНоменклатуры = НайтиПолеПоПризнакам(Регистр.Измерения, "номенклатур,товар,продукц");
		Если ПустаяСтрока(РесурсКоличества) ИЛИ ПустаяСтрока(ИзмерениеНоменклатуры) Тогда
			Результат.Ошибка = "В регистре " + Регистр.Таблица
				+ " нет ресурса количества или измерения номенклатуры. Сводка недоступна - используйте ExecuteDBQuery.";
			Возврат Результат;
		КонецЕсли;

		ДатаОстатков = ДатаИзАргументов(Аргументы, "ДатаОстатков");
		Если ДатаОстатков = Неопределено Тогда
			ДатаОстатков = КонецДня(ТекущаяДатаСеанса());
		Иначе
			ДатаОстатков = КонецДня(ДатаОстатков);
		КонецЕсли;

		МесяцевБезДвижения = НормализоватьМесяцы(
			СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "МесяцевБезДвижения", Неопределено));

		Остатки = ОстаткиТоваров(Регистр, ИзмерениеНоменклатуры, РесурсКоличества, РесурсСтоимости, ДатаОстатков);
		Если НЕ Остатки.Успех Тогда
			Результат.Ошибка = Остатки.Ошибка;
			Возврат Результат;
		КонецЕсли;

		Показатели = Новый Массив;
		Показатели.Добавить(НовыйПоказатель("СтоимостьЗапасов", "Стоимость запасов",
			Остатки.Стоимость, "руб", "на " + Формат(ДатаОстатков, "ДЛФ=D"), Неопределено, "Обычная", ""));
		Показатели.Добавить(НовыйПоказатель("Позиций", "Позиций на складе", Остатки.Позиций,
			"шт", "", Неопределено, "Обычная", ""));

		Если Остатки.Минусовых > 0 Тогда
			Показатели.Добавить(НовыйПоказатель("Минусовые", "Позиций с минусовым остатком", Остатки.Минусовых,
				"шт", "", Неопределено, "Высокая", "Минусовый остаток - ошибка учёта или незакрытая реализация."));
		КонецЕсли;

		Показатели.Добавить(НовыйПоказатель("НетВНаличии", "Позиций без наличия (остаток <= 0)", Остатки.БезНаличия,
			"шт", "", Неопределено, ?(Остатки.БезНаличия > 0, "Средняя", "Обычная"), ""));

		БезДвижения = БезДвиженияПоСкладу(Регистр, ИзмерениеНоменклатуры, Остатки.Позиций,
			ДатаОстатков, МесяцевБезДвижения);
		Если БезДвижения.Успех Тогда
			Показатели.Добавить(НовыйПоказатель("БезДвижения", "Позиций без движения за "
				+ Формат(МесяцевБезДвижения, "ЧДЦ=0; ЧГ=") + " мес.", БезДвижения.Количество,
				"шт", "", Неопределено, ?(БезДвижения.Количество > 0, "Средняя", "Обычная"),
				"Считаются позиции остатка, по которым не было движений за указанный период (в пределах первых 100 позиций)."));
		КонецЕсли;

		Строки = Новый Массив;
		Для Индекс = 0 По Мин(20, Остатки.Строки.Количество()) - 1 Цикл
			СтрокаОстатка = Остатки.Строки[Индекс];
			Значение = Новый Структура;
			Значение.Вставить("Группа", "Склад");
			Значение.Вставить("Наименование", СИ_РаботаСJSON.БезопасноПолучить(СтрокаОстатка, "Наименование", ""));
			Значение.Вставить("Значение", СИ_РаботаСJSON.БезопасноПолучить(СтрокаОстатка, "Количество", 0));
			Значение.Вставить("Дополнительно", СИ_РаботаСJSON.БезопасноПолучить(СтрокаОстатка, "Стоимость", 0));
			Значение.Вставить("Пояснение", "");
			Строки.Добавить(Значение);
		КонецЦикла;

		Подсказка = "Скажите пользователю стоимость запасов, число позиций, минусовые остатки и позиции без движения. "
			+ "Детальный список остатков по конкретной номенклатуре - через ExecuteDBQuery.";

		Результат.Значение = НовоеЗначениеСводки("на " + Формат(ДатаОстатков, "ДЛФ=D"),
			Показатели, Строки, Подсказка);
		Результат.Успех = Истина;

	Исключение
		Результат.Ошибка = "Ошибка сводки по складу: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
// ЗарегистрироватьИнструменты - регистрация всех встроенных инструментов 1С
// в справочнике СИ_ИнструментыАгента: встроенные (Calculate, DrawMermaid),
// запросы к БД (ExecuteDBQuery, GetMetadataSchema, GetCurrentDateTime, ParsePeriod),
// диагностика (GetRecentErrors), выгрузка и диаграммы (ExportTable, DrawChart),
// обзорные сводки (GetSalesSummary, GetMoneySummary, GetStockSummary).
// Вызывается из формы списка справочника СИ_ИнструментыАгента
// («Зарегистрировать инструменты по умолчанию») и при добавлении новых источников.
//
// Возвращаемое значение:
//  Массив из Строка - имена зарегистрированных инструментов.
Функция ЗарегистрироватьИнструменты() Экспорт

	Зарегистрированные = ЗарегистрироватьИнструментыВстроенные();

	Для Каждого ИмяИнструмента Из ЗарегистрироватьИнструментыЗапросБД() Цикл
		Зарегистрированные.Добавить(ИмяИнструмента);
	КонецЦикла;

	Для Каждого ИмяИнструмента Из ЗарегистрироватьИнструментыДиагностики() Цикл
		Зарегистрированные.Добавить(ИмяИнструмента);
	КонецЦикла;

	Для Каждого ИмяИнструмента Из ЗарегистрироватьИнструментыВыгрузки() Цикл
		Зарегистрированные.Добавить(ИмяИнструмента);
	КонецЦикла;

	Для Каждого ИмяИнструмента Из ЗарегистрироватьИнструментыОбзора() Цикл
		Зарегистрированные.Добавить(ИмяИнструмента);
	КонецЦикла;

	Возврат Зарегистрированные;

КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ВыражениеДопустимоДляВычисления - проверка, что строка содержит только символы,
// допустимые в арифметическом выражении (белый список), а не произвольный код 1С.
//
// Возвращаемое значение:
//  Булево - Истина, если выражение безопасно для Вычислить.
Функция ВыражениеДопустимоДляВычисления(Выражение)
	ДопустимыеСимволы = "0123456789+-*/(). ";
	Для Индекс = 1 По СтрДлина(Выражение) Цикл
		Символ = Сред(Выражение, Индекс, 1);
		Если СтрНайти(ДопустимыеСимволы, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// ЗарегистрироватьИнструментыВстроенные - регистрация встроенных инструментов 1С в справочнике
// СИ_ИнструментыАгента.
//
// Возвращаемое значение:
//  Массив из Строка - имена зарегистрированных инструментов: Calculate, DrawMermaid.
Функция ЗарегистрироватьИнструментыВстроенные()

	Зарегистрированные = Новый Массив;

	Свойства = Новый Соответствие;
	СвойстваВложенное = Новый Структура("type", "string");
	Свойства.Вставить("Выражение", СвойстваВложенное);

	Обязательные = Новый Массив;
	Обязательные.Добавить("Выражение");

	Если ЗарегистрироватьИнструмент("Calculate",
		"Точный расчёт арифметического выражения (синтаксис 1С): + - * /, скобки, десятичная точка. Степень, проценты и функции не поддерживаются - для процентов передавайте готовое выражение (НДС 20%: сумма * 1.2). Используйте для любых числовых расчётов вместо собственной арифметики. Деление на ноль вернёт ошибку.",
		Свойства, Обязательные, "СИ_Инструменты1С.Калькулятор", Ложь,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Считаю выражение")) Тогда
		Зарегистрированные.Добавить("Calculate");
	КонецЕсли;

	СвойстваMermaid = Новый Соответствие;
	СвойствоКод = Новый Соответствие;
	СвойствоКод.Вставить("type", "string");
	СвойствоКод.Вставить("description", "Код диаграммы Mermaid без обрамляющих ```mermaid ```, например flowchart TD; A-->B");
	СвойстваMermaid.Вставить("Код", СвойствоКод);

	ФорматыКартинки = Новый Массив;
	ФорматыКартинки.Добавить("png");
	ФорматыКартинки.Добавить("jpeg");
	ФорматыКартинки.Добавить("webp");
	ФорматыКартинки.Добавить("svg");
	СвойствоФормат = Новый Соответствие;
	СвойствоФормат.Вставить("type", "string");
	СвойствоФормат.Вставить("enum", ФорматыКартинки);
	СвойствоФормат.Вставить("description", "Выходное изображение (по умолчанию png)");
	СвойстваMermaid.Вставить("Формат", СвойствоФормат);

	СвойствоТема = Новый Соответствие;
	СвойствоТема.Вставить("type", "string");
	СвойствоТема.Вставить("description", "Тема оформления (default/neutral/dark/forest)");
	СвойстваMermaid.Вставить("Тема", СвойствоТема);

	ОбязательныеMermaid = Новый Массив;
	ОбязательныеMermaid.Добавить("Код");

	Если ЗарегистрироватьИнструмент("DrawMermaid",
		"Нарисовать диаграмму Mermaid (flowchart, sequenceDiagram, classDiagram, erDiagram, gantt, pie и др.); картинка сохраняется в файлы диалога - ссылайтесь на неё в ответе. Схемы делайте горизонтальными: в flowchart указывайте направление LR, вертикальный TD - только по явной просьбе пользователя.",
		СвойстваMermaid, ОбязательныеMermaid, "СИ_Инструменты1С.НарисоватьMermaid", Истина,
		СИ_УправлениеИнструментами1С.ЗначенияРеестраДействие("Рисую диаграмму")) Тогда
		Зарегистрированные.Добавить("DrawMermaid");
	КонецЕсли;

	Возврат Зарегистрированные;

КонецФункции

// Регистрирует один внутренний инструмент 1С в справочнике СИ_ИнструментыАгента.
//
// Параметры:
//  Имя - Строка - имя инструмента (ИмяФункции).
//  Описание - Строка - описание инструмента для модели.
//  СвойстваJSON - Соответствие из Строка,Произвольный,Неопределено - схема properties
//    (без "type" и "required"); Неопределено, если у инструмента нет параметров.
//  Обязательные - Массив из Строка,Неопределено - список обязательных параметров.
//  Обработчик - Строка - имя функции-обработчика в формате "Модуль.Функция".
//  ТребуетРазрешения - Булево - запрашивать подтверждение пользователя перед
//    исполнением (пишущие инструменты); дефолт для новой регистрации.
//  ЗначенияРеестра - Структура,Неопределено - группа, ключевые слова и действие
//    инструмента (см. СИ_УправлениеИнструментами1С.ЗначенияРеестра): ключи передаются
//    в дескриптор только для непустых значений, поэтому правки администратора
//    в справочнике не затираются.
//
// Возвращаемое значение:
//  Булево - Истина, если инструмент зарегистрирован (или уже существовал).
Функция ЗарегистрироватьИнструмент(Имя, Описание, СвойстваJSON, Обязательные, Обработчик,
	ТребуетРазрешения = Ложь, ЗначенияРеестра = Неопределено)

	Возврат СИ_УправлениеИнструментами1С.ЗарегистрироватьИнструмент(
		СИ_УправлениеИнструментами1С.ДескрипторИнструмента(Имя, Описание, СвойстваJSON,
			Обязательные, Обработчик, ТребуетРазрешения, ЗначенияРеестра));

КонецФункции

#Область ИнструментыЗапросБД

// Нормализует лимит строк, запрошенный моделью параметром ЛимитСтрок.
// Допустимо целое от 1 до Максимум; всё прочее (параметр не передан,
// не приводится к числу, 0, отрицательное, больше потолка) приводит к потолку -
// то есть к поведению без параметра. Потолок защищает контекст модели: инструмент
// не возвращает строк больше, чем объявлено в его описании, какое бы число ни
// передала модель.
//
// Параметры:
//  Значение - Произвольный - значение параметра ЛимитСтрок из аргументов вызова.
//  Максимум - Число,Неопределено - потолок лимита; Неопределено - потолок
//    интерактивного запроса (ЛимитСтрокРезультата()). Параметр добавлен для
//    выгрузки в файл (см. ВыполнитьЗапросДляВыгрузки): её потолок другой.
//
// Возвращаемое значение:
//  Число - нормализованный лимит строк (1..Максимум).
Функция НормализоватьЛимитСтрок(Значение, Максимум = Неопределено)

	Если Максимум = Неопределено Тогда
		Максимум = ЛимитСтрокРезультата();
	КонецЕсли;

	Попытка
		ЧислоСтрок = Цел(Число(Значение));
	Исключение
		Возврат Максимум;
	КонецПопытки;

	Если ЧислоСтрок < 1 Тогда
		Возврат Максимум;
	КонецЕсли;

	Возврат Мин(ЧислоСтрок, Максимум);

КонецФункции

// Читает дополнительные запрещенные объекты из константы СИ_ЗапрещенныеОбъектыЗапросов.
// Значения в константе хранятся строкой через точку с запятой:
// "РегистрСведений.СведенияОПользователях;РегистрСведений.ЕщеЧтоТо".
// Чтение выполняется в привилегированном режиме, чтобы список действовал
// независимо от прав текущего пользователя сеанса (в т.ч. фонового задания агента).
//
// Возвращаемое значение:
//  Массив из Строка - запрещенные объекты из константы (пустой, если константа пуста).
// Определяет, выполняется ли текущий серверный код в сеансе фонового задания.
// Обёртка над документированной функцией БСП СтандартныеПодсистемыСервер.
// ЭтоСеансФоновогоЗадания с защитой от сбоя в нестандартных режимах запуска.
// Проверка ИмяПриложения = "BackgroundJob" детерминирована для любого способа
// запуска фонового задания (в отличие от ПропуститьОбработчикПередЗапускомПрограммы,
// который для регламентных заданий возвращает Ложь).
//
// Возвращаемое значение:
//  Булево - Истина, если код выполняется в сеансе фонового задания.
Функция ЭтоСеансФоновогоЗадания()

	Попытка
		Возврат СтандартныеПодсистемыСервер.ЭтоСеансФоновогоЗадания();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Определяет, является ли текущий пользователь сеанса администратором системы.
// Обёртка над документированной функцией БСП Пользователи.ЭтоПолноправныйПользователь:
// проверяется роль администрирования системы (второй параметр Истина) без учета
// привилегированного режима (третий параметр Ложь). Привилегированный режим агента
// не должен «повышать» обычного пользователя до администратора.
// При сбое проверки возвращается Ложь: запреты продолжают действовать (fail-safe).
//
// Возвращаемое значение:
//  Булево - Истина, если у пользователя есть роль «Администратор системы».
Функция ЭтоАдминистраторСистемы()

	Попытка
		Возврат Пользователи.ЭтоПолноправныйПользователь(, Истина, Ложь);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Служебные объекты агента, запросы к которым запрещены всегда - независимо
// от ролей пользователя. Через них можно прочитать значения, которые система
// намеренно не показывает модели: реальные персональные данные (словарь меток
// и история сообщений), системные промпты, ключи подключений и токены MCP-серверов.
//
// Возвращаемое значение:
//  Массив из Строка - паттерны для поиска в нормализованном тексте запроса.
Функция НеотключаемыеЗапрещенныеОбъекты()

	Результат = Новый Массив;
	Результат.Добавить("РегистрСведений.СИ_СообщенияДиалога");
	Результат.Добавить("РегистрСведений.СИ_ПамятьДиалога");
	Результат.Добавить("РегистрСведений.СИ_ОжидающиеРазрешения");
	Результат.Добавить("РегистрСведений.СИ_РазрешенияИнструментовДиалога");
	Результат.Добавить("Справочник.СИ_ДиалогиАгента");
	Результат.Добавить("Справочник.СИ_ПрофилиПодключений");
	Результат.Добавить("Справочник.СИ_РежимиРаботы");
	Результат.Добавить("Справочник.СИ_MCPСерверы");

	Возврат Результат;

КонецФункции

// Читает дополнительные запрещенные объекты из константы СИ_ЗапрещенныеОбъектыЗапросов.
Функция ДополнительныеЗапрещенныеОбъектыИзКонстанты()

	Результат = Новый Массив;

	ПредыдущийПривилегированныйРежим = ПривилегированныйРежим();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Значение = Константы.СИ_ЗапрещенныеОбъектыЗапросов.Получить();
		УстановитьПривилегированныйРежим(ПредыдущийПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(ПредыдущийПривилегированныйРежим);
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(Значение) Тогда
		Возврат Результат;
	КонецЕсли;

	Элементы = СтрРазделить(Значение, ";", Ложь);
	Для Каждого Элемент Из Элементы Цикл
		Объект = СокрЛП(Строка(Элемент));
		Если НЕ ПустаяСтрока(Объект) Тогда
			Результат.Добавить(Объект);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нормализация текста запроса для анализа: удаление комментариев, схлопывание
// разделителей, удаление пробелов вокруг точек, верхний регистр.
//
// Параметры:
//  ТекстЗапроса - Строка - исходный текст запроса.
//
// Возвращаемое значение:
//  Строка - нормализованный текст (в верхнем регистре).
Функция НормализоватьТекст(ТекстЗапроса)

	БезКомментариев = УбратьКомментарии(ТекстЗапроса);

	Текст = СтрЗаменить(БезКомментариев, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");

	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;

	Текст = СтрЗаменить(Текст, ". ", ".");
	Текст = СтрЗаменить(Текст, " .", ".");

	Возврат ВРег(Текст);

КонецФункции

// Удаляет однострочные комментарии (// до конца строки).
Функция УбратьКомментарии(ТекстЗапроса)

	Строки = СтрРазделить(ТекстЗапроса, Символы.ПС, Ложь);
	Обработанные = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Позиция = СтрНайти(Строка, "//");
		Если Позиция > 0 Тогда
			Строка = Лев(Строка, Позиция - 1);
		КонецЕсли;
		Обработанные.Добавить(Строка);
	КонецЦикла;
	Возврат СтрСоединить(Обработанные, Символы.ПС);

КонецФункции

// Ищет в нормализованном тексте паттерны черного списка.
Функция НайтиЗапрещенныеОбъекты(НормализованныйТекст)

	Найденные = Новый Массив;
	Для Каждого Паттерн Из ЗапрещенныеОбъекты() Цикл
		Если СтрНайти(НормализованныйТекст, ВРег(Паттерн)) > 0 Тогда
			Найденные.Добавить(Паттерн);
		КонецЕсли;
	КонецЦикла;
	Возврат Найденные;

КонецФункции

// Проверяет, запрещен ли объект по полному имени (для схемы метаданных).
Функция ОбъектЗапрещен(ПолноеИмя)

	Для Каждого Паттерн Из ЗапрещенныеОбъекты() Цикл
		Если СтрНайти(ВРег(ПолноеИмя), ВРег(Паттерн)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Ищет в тексте запрещенный модифицирующий оператор (как отдельное слово).
Функция НайтиЗапрещенныйОператор(НормализованныйТекст)

	Операторы = Новый Массив;
	Операторы.Добавить("ИЗМЕНИТЬ");
	Операторы.Добавить("УДАЛИТЬ");
	Операторы.Добавить("ВСТАВИТЬ");
	Операторы.Добавить("УНИЧТОЖИТЬ");

	Для Каждого Оператор Из Операторы Цикл
		Если ЕстьКлючевоеСлово(НормализованныйТекст, Оператор) Тогда
			Возврат Оператор;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Единый текст ошибки о псевдониме-ключевом слове: используется в
// ВыполнитьЗапрос и ВыполнитьЗапросДляВыгрузки, чтобы формулировки не расходились.
//
// Параметры:
//  ЗапрещенныйПсевдоним - Строка - найденное ключевое слово.
//
// Возвращаемое значение:
//  Строка - текст ошибки для модели.
Функция ТекстОшибкиПсевдонима(ЗапрещенныйПсевдоним)

	Возврат "Псевдоним """ + ЗапрещенныйПсевдоним
		+ """ - ключевое слово языка запросов (И, В, ИЛИ, НЕ и т.п.), такой запрос не выполняется."
		+ " Замените псевдонимы И и В другими однобуквенными (например, Т, П) и повторите запрос.";

КонецФункции

// Ищет в тексте запроса псевдоним, совпадающий с ключевым словом языка запросов
// (прежде всего однобуквенные И и В - от русских названий таблиц: Инструменты,
// Версии): платформа отклоняет такой запрос ошибкой «Недопустимая лексема»,
// которую модель не связывает с псевдонимом и повторяет запрос без изменений,
// а пользователь получает ответ «данных нет».
//
// Проверяются слова после КАК - так пишутся и псевдонимы таблиц, и псевдонимы
// полей; оба варианта с ключевым словом недопустимы.
//
// Параметры:
//  НормализованныйТекст - Строка - текст запроса (см. НормализоватьТекст).
//
// Возвращаемое значение:
//  Строка - найденный псевдоним (верхний регистр) или "", если запрещенных нет.
Функция НайтиЗапрещенныйПсевдоним(НормализованныйТекст)

	ТекстВерхний = ВРег(НормализованныйТекст);
	ЗапрещенныеСлова = ЗапрещенныеПсевдонимы();
	ДлинаКак = СтрДлина("КАК");
	Позиция = СтрНайти(ТекстВерхний, "КАК");
	Пока Позиция > 0 Цикл
		// КАК принимается только как отдельное слово: «КАК» внутри другого
		// идентификатора (например, КАКОЙ_ЛИБО) псевдонимом не является.
		ЛеваяГраница = Позиция = 1 ИЛИ НЕ ЭтоБукваЦифра(Сред(ТекстВерхний, Позиция - 1, 1));
		ПраваяГраница = НЕ ЭтоБукваЦифра(Сред(ТекстВерхний, Позиция + ДлинаКак, 1));
		Если ЛеваяГраница И ПраваяГраница Тогда
			Псевдоним = СловоПослеПозиции(ТекстВерхний, Позиция + ДлинаКак);
			Если НЕ ПустаяСтрока(Псевдоним) И ЗапрещенныеСлова.Получить(Псевдоним) <> Неопределено Тогда
				Возврат Псевдоним;
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(ТекстВерхний, "КАК", , Позиция + 1);
	КонецЦикла;

	Возврат "";

КонецФункции

// Ключевые слова языка запросов, которые нельзя использовать как псевдонимы
// таблиц и полей. Состав проверен синтаксическим разбором платформы: каждое
// слово в позиции псевдонима дает «Недопустимая лексема». Слова, которые
// псевдонимом быть МОГУТ (проверено: ТИП, ВСЕ, ТО, СУММА, КОЛИЧЕСТВО),
// в список не включены, чтобы не блокировать валидные запросы.
//
// Возвращаемое значение:
//  Соответствие - слово (верхний регистр) -> Истина.
Функция ЗапрещенныеПсевдонимы()

	Слова = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить(
		"И,В,ИЛИ,НЕ,ПО,КАК,ГДЕ,ЕСТЬ,ИЗ,ВЫБРАТЬ,РАЗРЕШЕННЫЕ,ПЕРВЫЕ", ",") Цикл
		Слова.Вставить(ВРег(Слово), Истина);
	КонецЦикла;
	Возврат Слова;

КонецФункции

// Слово, начинающееся в тексте с указанной позиции (разделители пропускаются).
//
// Параметры:
//  Текст - Строка.
//  Позиция - Число - позиция, с которой искать начало слова (1-базная).
//
// Возвращаемое значение:
//  Строка - слово или "", если далее в тексте букв и цифр нет.
Функция СловоПослеПозиции(Текст, Позиция)

	Длина = СтрДлина(Текст);
	Индекс = Позиция;
	Пока Индекс <= Длина И НЕ ЭтоБукваЦифра(Сред(Текст, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	НачалоСлова = Индекс;
	Пока Индекс <= Длина И ЭтоБукваЦифра(Сред(Текст, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Сред(Текст, НачалоСлова, Индекс - НачалоСлова);

КонецФункции

// Проверяет наличие слова с границами (не внутри другого идентификатора).
Функция ЕстьКлючевоеСлово(Текст, Слово)

	Позиция = СтрНайти(Текст, Слово);
	Пока Позиция > 0 Цикл

		ЛеваяГраница = Позиция = 1 ИЛИ НЕ ЭтоБукваЦифра(Сред(Текст, Позиция - 1, 1));
		КонецСлова = Позиция + СтрДлина(Слово);
		ПраваяГраница = КонецСлова > СтрДлина(Текст) ИЛИ НЕ ЭтоБукваЦифра(Сред(Текст, КонецСлова, 1));

		Если ЛеваяГраница И ПраваяГраница Тогда
			Возврат Истина;
		КонецЕсли;

		Относительная = СтрНайти(Сред(Текст, Позиция + 1), Слово);
		Если Относительная = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + Относительная;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Буква/цифра/подчеркивание (латиница, кириллица, цифры).
Функция ЭтоБукваЦифра(Символ)

	Код = КодСимвола(Символ);
	Возврат (Код >= 65 И Код <= 90)
		ИЛИ (Код >= 97 И Код <= 122)
		ИЛИ (Код >= 48 И Код <= 57)
		ИЛИ (Код >= 1040 И Код <= 1103)
		ИЛИ Символ = "_";

КонецФункции

// Цифра.
Функция ЭтоЦифра(Символ)

	Код = КодСимвола(Символ);
	Возврат Код >= 48 И Код <= 57;

КонецФункции

// Идемпотентное внедрение директив в первый ВЫБРАТЬ запроса:
//  - РАЗРЕШЕННЫЕ, если отсутствует;
//  - ПЕРВЫЕ <ЛимитСтрок + 1>, если отсутствует; если присутствует ПЕРВЫЕ N -
//    число заменяется на ЛимитСтрок + 1.
//
// Число подставляется в текст литералом, а не параметром запроса: язык запросов
// 1С не допускает параметр (&Параметр) после ПЕРВЫЕ.
//
// В запрос подставляется на одну строку больше лимита результата: эта строка нужна
// сериализации (СериализоватьВыборку), чтобы отличить «в отборе ровно ЛимитСтрок
// строк» от «строк больше» и выставить флаг ЕстьЕщеДанные. Сама лишняя строка в
// результат не попадает.
//
// Ограничение: директивы внедряются только в первый ВЫБРАТЬ от начала текста.
// РАЗРЕШЕННЫЕ/ПЕРВЫЕ во вложенных подзапросах не добавляются. Если во вложенном
// подзапросе (расположенном после первого ВЫБРАТЬ) слово ПЕРВЫЕ встретится раньше
// остальных - число после него будет перезаписано лимитом результата. Для модели
// это приемлемо (лимит возвращаемых строк не нарушается), но учитывается при
// анализе текста.
//
// Параметры:
//  ТекстЗапроса - Строка - исходный текст запроса.
//  ЛимитСтрок - Число - нормализованный лимит строк результата
//    (см. НормализоватьЛимитСтрок).
//
// Возвращаемое значение:
//  Строка - текст с директивами.
Функция ВнедритьДирективы(ТекстЗапроса, ЛимитСтрок)

	Верхний = ВРег(ТекстЗапроса);
	Позиция = СтрНайти(Верхний, "ВЫБРАТЬ");
	Если Позиция = 0 Тогда
		ВызватьИсключение "Текст запроса должен содержать ключевое слово ВЫБРАТЬ.";
	КонецЕсли;

	ЛимитВЗапросе = ЛимитСтрок + 1;

	НачалоХвоста = Позиция + СтрДлина("ВЫБРАТЬ");
	ХвостОригинал = Сред(ТекстЗапроса, НачалоХвоста);
	ХвостВерхний = Сред(Верхний, НачалоХвоста);

	ПозицияРазреш = СтрНайти(ХвостВерхний, "РАЗРЕШЕННЫЕ");
	ПозицияПервые = СтрНайти(ХвостВерхний, "ПЕРВЫЕ");

	Вставка = "";

	Если ПозицияРазреш = 0 Тогда
		Вставка = Вставка + " РАЗРЕШЕННЫЕ";
	КонецЕсли;

	Если ПозицияПервые = 0 Тогда
		Вставка = Вставка + " ПЕРВЫЕ " + Формат(ЛимитВЗапросе, "ЧГ=");
	Иначе
		ХвостОригинал = ЗаменитьПервыеНаЛимит(ХвостОригинал, ПозицияПервые, ЛимитВЗапросе);
	КонецЕсли;

	Возврат Лев(ТекстЗапроса, НачалоХвоста - 1) + Вставка + ХвостОригинал;

КонецФункции

// Заменяет число после слова ПЕРВЫЕ на лимит (число строк, запрашиваемых в запросе).
// Число подставляется без разделителей групп: «ЧГ=» - приём БСП для подстановки
// числа в текст запроса.
//
// Параметры:
//  Хвост - Строка - часть текста запроса после первого ВЫБРАТЬ.
//  ПозицияПервые - Число - позиция слова ПЕРВЫЕ в Хвосте.
//  ЛимитВЗапросе - Число - число, которое ставится после ПЕРВЫЕ.
//
// Возвращаемое значение:
//  Строка - Хвост с подставленным числом.
Функция ЗаменитьПервыеНаЛимит(Хвост, ПозицияПервые, ЛимитВЗапросе)

	ЧислоСтрокой = Формат(ЛимитВЗапросе, "ЧГ=");

	НомерСимвола = ПозицияПервые + СтрДлина("ПЕРВЫЕ");
	Пока НомерСимвола <= СтрДлина(Хвост)
		И (Сред(Хвост, НомерСимвола, 1) = " " ИЛИ Сред(Хвост, НомерСимвола, 1) = Символы.Таб) Цикл
		НомерСимвола = НомерСимвола + 1;
	КонецЦикла;

	НачалоЧисла = НомерСимвола;
	КонецЧисла = НачалоЧисла;
	Пока КонецЧисла <= СтрДлина(Хвост) И ЭтоЦифра(Сред(Хвост, КонецЧисла, 1)) Цикл
		КонецЧисла = КонецЧисла + 1;
	КонецЦикла;

	Если КонецЧисла > НачалоЧисла Тогда
		Возврат Лев(Хвост, НачалоЧисла - 1) + ЧислоСтрокой + Сред(Хвост, КонецЧисла);
	Иначе
		Возврат Лев(Хвост, НачалоЧисла - 1) + ЧислоСтрокой + Сред(Хвост, НачалоЧисла);
	КонецЕсли;

КонецФункции

// Конвертация параметров из JSON-типов в типы 1С.
//  Строка в формате даты -> Дата; null -> Неопределено; Массив -> Массив с конвертацией элементов.
//  GUID намеренно не конвертируется в ссылку: без знания класса объекта это невозможно —
//  модель должна использовать текстовые поля (Код/Наименование).
//
// Параметры:
//  ПараметрыJSON - Соответствие/Структура - параметры из аргументов модели.
//
// Возвращаемое значение:
//  Соответствие - подготовленные параметры для Запрос.УстановитьПараметр.
Функция КонвертироватьПараметры(ПараметрыJSON)

	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из ПараметрыJSON Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КонвертироватьЗначение(КлючИЗначение.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Конвертация одного значения JSON в тип 1С.
Функция КонвертироватьЗначение(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда
		Если ЭтоДатаISO(Значение) Тогда
			Возврат XMLЗначение(Тип("Дата"), Значение);
		КонецЕсли;
		Возврат Значение;

	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		НовыйМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			НовыйМассив.Добавить(КонвертироватьЗначение(Элемент));
		КонецЦикла;
		Возврат НовыйМассив;

	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции

// Проверяет, что строка является датой в формате, понимаемом XMLЗначение.
Функция ЭтоДатаISO(Значение)

	Попытка
		XMLЗначение(Тип("Дата"), Значение);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Текст ошибки запроса, поймавшего исключение платформы: отказ по правам распознаётся
// отдельно и повторяется модели прямой инструкцией «не ищи обходных путей», к остальным
// ошибкам дописывается подсказка, что именно исправить (см. ТекстПодсказкиПоОшибке).
//
// Функция вызывается ТОЛЬКО из блока Исключение: источником текста ошибки служит
// ИнформацияОбОшибке() текущего исключения.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса модели (для разбора подсказки).
//  ШаблонБазовогоТекста - Строка - шаблон сообщения с подстановкой %1 (краткое
//    представление ошибки платформы).
//
// Возвращаемое значение:
//  Строка - итоговый текст ошибки для модели.
Функция ТекстОшибкиЗапросаПоИсключению(ТекстЗапроса, ШаблонБазовогоТекста)

	ИнфоОшибки = ИнформацияОбОшибке();
	Если СИ_УправлениеИнструментами1С.ЭтоОтказПоДоступуПлатформы(ИнфоОшибки) Тогда
		Возврат СИ_УправлениеИнструментами1С.ИнструкцияОтказаПоДоступу();
	КонецЕсли;

	ПодробныйТекст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОшибки);
	БазовыйТекст = СтрШаблон(ШаблонБазовогоТекста, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнфоОшибки));
	Подсказка = ТекстПодсказкиПоОшибке(ТекстЗапроса, ПодробныйТекст);
	Если ПустаяСтрока(Подсказка) И СтрНайти(ВРег(БазовыйТекст), "НЕПРЕДВИДЕННАЯ ОШИБКА") > 0 Тогда
		// Платформа не раскрыла причину; чаще всего это несуществующая таблица -
		// модель угадывает имена из общих знаний БСП (например, Валюты), а в этой
		// базе таких объектов нет.
		Подсказка = " Возможная причина: таблицы или поля не существует в этой базе."
			+ " Проверьте точное имя через GetMetadataSchema и повторите запрос.";
	КонецЕсли;
	Возврат БазовыйТекст + Подсказка;

КонецФункции
// Текст ошибки запроса, полученный строкой (статус «Ошибка» фонового задания).
// Логика та же, что у ТекстОшибкиЗапросаПоИсключению: отказ по правам - отдельной
// формулировкой, остальное - базовый текст плюс подсказка.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса модели (для разбора подсказки).
//  ТекстОшибки - Строка - представление ошибки платформы.
//  БазовыйТекст - Строка - сообщение без подсказки (начало текста для модели).
//
// Возвращаемое значение:
//  Строка - итоговый текст ошибки для модели.
Функция ТекстОшибкиЗапросаПоТексту(ТекстЗапроса, ТекстОшибки, БазовыйТекст)

	Если СИ_УправлениеИнструментами1С.ЭтоОтказПоДоступуВТексте(ТекстОшибки) Тогда
		Возврат СИ_УправлениеИнструментами1С.ИнструкцияОтказаПоДоступу();
	КонецЕсли;
	Возврат БазовыйТекст + ТекстПодсказкиПоОшибке(ТекстЗапроса, ТекстОшибки);

КонецФункции
// Возвращает блок подсказки к ошибке выполнения запроса. Диагностика устроена
// как конвейер: сначала проблема классифицируется (структура ОписаниеПроблемы),
// затем текст собирается по шаблону. Это отделяет разбор от формулировок и
// позволяет добавлять новые виды ошибок без разрастания цепочки Если.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса модели.
//  ТекстОшибки - Строка - представление ошибки платформы.
//
// Возвращаемое значение:
//  Строка - блок подсказки; пустая строка, если подсказку построить не удалось.
Функция ТекстПодсказкиПоОшибке(ТекстЗапроса, ТекстОшибки)

	Попытка
		Проблема = КлассифицироватьОшибкуЗапроса(ТекстЗапроса, ТекстОшибки);
		Если Проблема = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат ТекстПроблемыПоШаблону(Проблема);
	Исключение
		// Подсказка необязательна: сбой разбора не должен скрывать исходную ошибку.
		Возврат "";
	КонецПопытки;

КонецФункции

// Классифицирует ошибку запроса в структуру ОписаниеПроблемы. Сначала
// проверяются проблемы, которые видны по тексту запроса (литерал номера,
// виртуальная таблица), затем - правила по тексту ошибки платформы.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса модели.
//  ТекстОшибки - Строка - представление ошибки платформы.
//
// Возвращаемое значение:
//  Структура,Неопределено - описание проблемы (см. НоваяПроблемаЗапроса).
Функция КлассифицироватьОшибкуЗапроса(ТекстЗапроса, ТекстОшибки)

	Проблема = НайтиПроблемуЛитералаНомера(ТекстЗапроса);
	Если Проблема <> Неопределено Тогда
		Возврат Проблема;
	КонецЕсли;

	Проблема = НайтиПроблемуВиртуальнойТаблицы(ТекстЗапроса, ТекстОшибки);
	Если Проблема <> Неопределено Тогда
		Возврат Проблема;
	КонецЕсли;

	ОшибкаВРег = ВРег(ТекстОшибки);
	Для Каждого Правило Из ПравилаДиагностикиЗапроса() Цикл
		Если СтрНайти(ОшибкаВРег, Правило.Признак) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Проблема = ОписаниеПроблемыПоВиду(Правило.Вид, ТекстЗапроса, ТекстОшибки);
		Если Проблема <> Неопределено Тогда
			Возврат Проблема;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Набор правил сопоставления текста ошибки с видом проблемы. Правила
// проверяются по порядку; текст ошибки сравнивается в верхнем регистре.
//
// Возвращаемое значение:
//  Массив из Структура - правила {Вид, Признак}.
Функция ПравилаДиагностикиЗапроса()

	Правила = Новый Массив;
	ДобавитьПравилоДиагностики(Правила, "ПолеНеНайдено", "ПОЛЕ НЕ НАЙДЕНО");
	ДобавитьПравилоДиагностики(Правила, "ТаблицаНеНайдена", "ТАБЛИЦА НЕ НАЙДЕНА");
	ДобавитьПравилоДиагностики(Правила, "Синтаксис", "СИНТАКСИЧЕСК");
	ДобавитьПравилоДиагностики(Правила, "Синтаксис", "ОЖИДАЕТСЯ");
	ДобавитьПравилоДиагностики(Правила, "Синтаксис", "<<?>>");
	Возврат Правила;

КонецФункции

// Добавляет правило диагностики в массив.
//
// Параметры:
//  Правила - Массив из Структура - приёмник.
//  Вид - Строка - вид проблемы.
//  Признак - Строка - фрагмент текста ошибки в верхнем регистре.
Процедура ДобавитьПравилоДиагностики(Правила, Вид, Признак)

	Правило = Новый Структура;
	Правило.Вставить("Вид", Вид);
	Правило.Вставить("Признак", Признак);
	Правила.Добавить(Правило);

КонецПроцедуры

// Создаёт описание проблемы с пустыми полями.
//
// Параметры:
//  Вид - Строка - вид проблемы.
//
// Возвращаемое значение:
//  Структура - описание проблемы.
Функция НоваяПроблемаЗапроса(Вид)

	Проблема = Новый Структура;
	Проблема.Вставить("Вид", Вид);
	Проблема.Вставить("Объект", "");
	Проблема.Вставить("Поле", "");
	Проблема.Вставить("Фрагмент", "");
	Проблема.Вставить("Кандидаты", Новый Массив);
	Проблема.Вставить("Текст", "");
	Возврат Проблема;

КонецФункции

// Строит описание проблемы по её виду.
//
// Параметры:
//  Вид - Строка - вид проблемы.
//  ТекстЗапроса - Строка - текст запроса.
//  ТекстОшибки - Строка - текст ошибки платформы.
//
// Возвращаемое значение:
//  Структура,Неопределено - описание проблемы.
Функция ОписаниеПроблемыПоВиду(Вид, ТекстЗапроса, ТекстОшибки)

	Если Вид = "ПолеНеНайдено" Тогда
		Возврат НайтиПроблемуПоля(ТекстЗапроса, ТекстОшибки);
	ИначеЕсли Вид = "ТаблицаНеНайдена" Тогда
		Возврат НайтиПроблемуТаблицы(ТекстОшибки);
	ИначеЕсли Вид = "Синтаксис" Тогда
		Возврат РазобратьСинтаксическуюОшибку(ТекстЗапроса, ТекстОшибки);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Шаблоны текстов подсказок. Плейсхолдеры: {Объект}, {Поле}, {Кандидаты},
// {Фрагмент}, {Текст}.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - вид проблемы -> шаблон.
Функция ШаблоныПодсказок()

	Шаблоны = Новый Соответствие;
	Шаблоны.Вставить("ПолеНеНайдено",
		"{Объект} нет поля {Поле}. Похожие поля: {Кандидаты}. Точный состав полей даст GetMetadataSchema.");
	Шаблоны.Вставить("ТаблицаНеНайдена",
		"В конфигурации нет таблицы {Объект}. Похожие объекты: {Кандидаты}. Точный список даст GetMetadataSchema.");
	Шаблоны.Вставить("ТаблицаНеНайденаВОбъекте",
		"У {Объект} нет таблицы {Поле}. Доступные таблицы: {Кандидаты}.");
	Шаблоны.Вставить("Синтаксис",
		"Платформа не разобрала запрос около «{Фрагмент}». Проверьте скобки, кавычки и ключевые слова рядом с этим местом.");
	Шаблоны.Вставить("СинтаксисОбщий",
		"Платформа отметила синтаксическую ошибку. Проверьте расстановку скобок, запятых и ключевых слов рядом с местом ошибки.");
	Шаблоны.Вставить("СинтаксисСуществует",
		"Оператор СУЩЕСТВУЕТ (EXISTS) в языке запросов 1С не поддерживается. Замените его на Поле НЕ В (ВЫБРАТЬ ...) или на ЛЕВОЕ СОЕДИНЕНИЕ ... ГДЕ ... ЕСТЬ NULL.");
	Шаблоны.Вставить("ЛитералНомера",
		"Номер документа указан как имя таблицы. Используйте условие ГДЕ <Псевдоним>.Номер = &Номер и передайте номер в Параметры запроса.");
	Шаблоны.Вставить("ВиртуальнаяТаблица", "{Текст}");
	Шаблоны.Вставить("Общая",
		"Не угадывайте имена таблиц и полей: получите точный состав через GetMetadataSchema.");
	Возврат Шаблоны;

КонецФункции

// Собирает текст подсказки из шаблона и полей описания проблемы.
//
// Параметры:
//  Проблема - Структура - описание проблемы.
//
// Возвращаемое значение:
//  Строка - текст подсказки; пустая строка, если шаблон не найден.
Функция ТекстПроблемыПоШаблону(Проблема)

	Шаблон = ШаблоныПодсказок().Получить(Проблема.Вид);
	Если Шаблон = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Текст = Шаблон;
	Текст = СтрЗаменить(Текст, "{Объект}", Проблема.Объект);
	Текст = СтрЗаменить(Текст, "{Поле}", Проблема.Поле);
	Текст = СтрЗаменить(Текст, "{Кандидаты}", СтрСоединить(Проблема.Кандидаты, ", "));
	Текст = СтрЗаменить(Текст, "{Фрагмент}", Проблема.Фрагмент);
	Текст = СтрЗаменить(Текст, "{Текст}", Проблема.Текст);
	Возврат "Подсказка: " + Текст;

КонецФункции

// Ищет в тексте запроса литерал номера документа: имя таблицы с номером,
// переданным как часть имени. Возвращает описание проблемы или Неопределено.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса модели.
//
// Возвращаемое значение:
//  Структура,Неопределено - описание проблемы.
Функция НайтиПроблемуЛитералаНомера(ТекстЗапроса)

	ТекстНРег = НРег(ТекстЗапроса);
	Позиция = СтрНайти(ТекстНРег, "документ.");
	Пока Позиция > 0 Цикл
		НачалоИмени = Позиция + СтрДлина("документ.");
		Точка = СтрНайти(ТекстНРег, ".", НаправлениеПоиска.СНачала, НачалоИмени);
		ПередПрефиксом = ?(Позиция = 1, " ", Сред(ТекстНРег, Позиция - 1, 1));
		Если Точка > НачалоИмени
			И НЕ ЭтоБукваЦифра(ПередПрефиксом)
			И ЭтоИмяПолное(Сред(ТекстНРег, НачалоИмени, Точка - НачалоИмени))
			И СтрНайти("0123456789", Сред(ТекстНРег, Точка + 1, 1)) > 0 Тогда
			КонецЛитерала = Точка + 1;
			Пока КонецЛитерала <= СтрДлина(ТекстЗапроса) И КонецЛитерала - Позиция < 100
				И СтрНайти(" ,()=<>;'""" + Символы.ПС + Символы.ВК + Символы.Таб,
					Сред(ТекстЗапроса, КонецЛитерала, 1)) = 0 Цикл
				КонецЛитерала = КонецЛитерала + 1;
			КонецЦикла;
			Проблема = НоваяПроблемаЗапроса("ЛитералНомера");
			Проблема.Фрагмент = Сред(ТекстЗапроса, Позиция, КонецЛитерала - Позиция);
			Возврат Проблема;
		КонецЕсли;
		Позиция = СтрНайти(ТекстНРег, "документ.", НаправлениеПоиска.СНачала, НачалоИмени);
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Описывает проблему «поле не найдено»: имя поля берётся из текста ошибки,
// таблица - по псевдониму, похожие поля - из метаданных.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса.
//  ТекстОшибки - Строка - текст ошибки платформы.
//
// Возвращаемое значение:
//  Структура - описание проблемы.
Функция НайтиПроблемуПоля(ТекстЗапроса, ТекстОшибки)

	ИмяПоля = ЗначениеВКавычкахПослеФразы(ТекстОшибки, "Поле не найдено");
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат НоваяПроблемаЗапроса("Общая");
	КонецЕсли;

	Части = СтрРазделить(ИмяПоля, ".", Ложь);
	Псевдоним = "";
	ИмяИскомогоПоля = ИмяПоля;
	Если Части.Количество() >= 2 Тогда
		Псевдоним = Части[0];
		ИмяИскомогоПоля = Части[Части.Количество() - 1];
	КонецЕсли;

	Если НЕ ПустаяСтрока(Псевдоним) Тогда
		ИмяТаблицы = ИмяТаблицыПоПсевдониму(ТекстЗапроса, Псевдоним);
		Если НЕ ПустаяСтрока(ИмяТаблицы) Тогда
			ИменаПолей = ИменаПолейОбъектаПоИмениТаблицы(ИмяТаблицы);
			Если ИменаПолей.Количество() > 0 Тогда
				Похожие = ПохожиеИменаПолей(ИменаПолей, ИмяИскомогоПоля, 10);
				Проблема = НоваяПроблемаЗапроса("ПолеНеНайдено");
				Проблема.Объект = "В таблице " + Псевдоним + " (" + ИмяТаблицы + ")";
				Проблема.Поле = ИмяИскомогоПоля;
				Если НЕ ПустаяСтрока(Похожие) Тогда
					Проблема.Кандидаты = СтрРазделить(Похожие, ", ", Ложь);
				Иначе
					Проблема.Кандидаты = ОграничитьПеречень(ИменаПолей, 10);
				КонецЕсли;
				Возврат Проблема;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ИменаКандидатов = Новый Массив;
	Для Каждого ИмяОбъекта Из УпомянутыеОбъектыЗапроса(ТекстЗапроса) Цикл
		Для Каждого ИмяПоляОбъекта Из ИменаПолейОбъектаПоИмениТаблицы(ИмяОбъекта) Цикл
			Если ИменаКандидатов.Найти(ИмяПоляОбъекта) = Неопределено Тогда
				ИменаКандидатов.Добавить(ИмяПоляОбъекта);
			КонецЕсли;
		КонецЦикла;
		Если ИменаКандидатов.Количество() >= 200 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ИменаКандидатов.Количество() > 0 Тогда
		Похожие = ПохожиеИменаПолей(ИменаКандидатов, ИмяИскомогоПоля, 10);
		Если НЕ ПустаяСтрока(Похожие) Тогда
			Проблема = НоваяПроблемаЗапроса("ПолеНеНайдено");
			Проблема.Объект = "У объектов запроса";
			Проблема.Поле = ИмяИскомогоПоля;
			Проблема.Кандидаты = СтрРазделить(Похожие, ", ", Ложь);
			Возврат Проблема;
		КонецЕсли;
	КонецЕсли;

	Возврат НоваяПроблемаЗапроса("Общая");

КонецФункции

// Описывает проблему «таблица не найдена»: разбирает полное имя, ищет объект
// метаданных и похожие имена.
//
// Параметры:
//  ТекстОшибки - Строка - текст ошибки платформы.
//
// Возвращаемое значение:
//  Структура - описание проблемы.
Функция НайтиПроблемуТаблицы(ТекстОшибки)

	ПолноеИмя = ЗначениеВКавычкахПослеФразы(ТекстОшибки, "Таблица не найдена");
	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат НоваяПроблемаЗапроса("Общая");
	КонецЕсли;

	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат НоваяПроблемаЗапроса("Общая");
	КонецЕсли;

	Коллекция = КоллекцияМетаданныхПоКлассу(Части[0]);
	Если Коллекция = Неопределено Тогда
		Возврат НоваяПроблемаЗапроса("Общая");
	КонецЕсли;

	ОбъектМД = Коллекция.Найти(Части[1]);
	Если ОбъектМД <> Неопределено И Части.Количество() > 2 Тогда
		Имена = ИменаДоступныхТаблицОбъекта(ОбъектМД);
		Если Имена.Количество() = 0 Тогда
			Имена.Добавить("нет дополнительных таблиц");
		КонецЕсли;
		Проблема = НоваяПроблемаЗапроса("ТаблицаНеНайденаВОбъекте");
		Проблема.Объект = Части[0] + "." + Части[1];
		Проблема.Поле = Части[2];
		Проблема.Кандидаты = Имена;
		Возврат Проблема;
	КонецЕсли;
	Если ОбъектМД <> Неопределено Тогда
		Возврат НоваяПроблемаЗапроса("Общая");
	КонецЕсли;

	Похожие = УпомянутыеИменаКласса(Коллекция, Части[1], 15, Истина);
	Если Похожие.Количество() = 0 Тогда
		Похожие = УпомянутыеИменаКласса(Коллекция, "", 15, Ложь);
	КонецЕсли;
	Если Похожие.Количество() = 0 Тогда
		Возврат НоваяПроблемаЗапроса("Общая");
	КонецЕсли;

	Проблема = НоваяПроблемаЗапроса("ТаблицаНеНайдена");
	Проблема.Объект = Части[0] + "." + Части[1];
	Проблема.Кандидаты = Похожие;
	Возврат Проблема;

КонецФункции

// Разбирает синтаксическую ошибку: извлекает фрагмент у маркера «<<?>>»
// и определяет типовой промах. Разбор идёт в обе стороны от маркера, а не
// только вперёд, поэтому в подсказку попадает целый токен.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса (оставлен для единой сигнатуры).
//  ТекстОшибки - Строка - текст ошибки платформы.
//
// Возвращаемое значение:
//  Структура,Неопределено - описание проблемы.
Функция РазобратьСинтаксическуюОшибку(ТекстЗапроса, ТекстОшибки)

	ОшибкаВРег = ВРег(ТекстОшибки);
	Синтаксическая = СтрНайти(ОшибкаВРег, "СИНТАКСИЧЕСК") > 0
		ИЛИ СтрНайти(ОшибкаВРег, "ОЖИДАЕТСЯ") > 0
		ИЛИ СтрНайти(ОшибкаВРег, "<<?>>") > 0;
	Если НЕ Синтаксическая Тогда
		Возврат Неопределено;
	КонецЕсли;

	Фрагмент = ИзвлечьФрагментОшибки(ТекстОшибки);
	Если ВРег(Фрагмент) = "СУЩЕСТВУЕТ" ИЛИ ВРег(Фрагмент) = "EXISTS" Тогда
		Возврат НоваяПроблемаЗапроса("СинтаксисСуществует");
	КонецЕсли;
	Если ПустаяСтрока(Фрагмент) Тогда
		Возврат НоваяПроблемаЗапроса("СинтаксисОбщий");
	КонецЕсли;

	Проблема = НоваяПроблемаЗапроса("Синтаксис");
	Проблема.Фрагмент = Фрагмент;
	Возврат Проблема;

КонецФункции

// Извлекает токен, рядом с которым платформа поставила маркер «<<?>>».
// Границы токена ищутся в обе стороны по разделителям.
//
// Параметры:
//  ТекстОшибки - Строка - текст ошибки платформы.
//
// Возвращаемое значение:
//  Строка - фрагмент без маркера; пустая строка, если маркера нет.
Функция ИзвлечьФрагментОшибки(ТекстОшибки)

	Маркер = "<<?>>";
	ПозицияМаркера = СтрНайти(ТекстОшибки, Маркер);
	Если ПозицияМаркера <= 0 Тогда
		Возврат "";
	КонецЕсли;

	Начало = ПозицияМаркера;
	Пока Начало > 1 И НЕ ЭтоГраницаФрагмента(Сред(ТекстОшибки, Начало - 1, 1)) Цикл
		Начало = Начало - 1;
	КонецЦикла;

	Конец = ПозицияМаркера + СтрДлина(Маркер);
	Пока Конец <= СтрДлина(ТекстОшибки) И НЕ ЭтоГраницаФрагмента(Сред(ТекстОшибки, Конец, 1)) Цикл
		Конец = Конец + 1;
	КонецЦикла;

	Возврат СтрЗаменить(Сред(ТекстОшибки, Начало, Конец - Начало), Маркер, "");

КонецФункции

// Признак границы фрагмента в тексте ошибки.
//
// Параметры:
//  Символ - Строка - проверяемый символ.
//
// Возвращаемое значение:
//  Булево - Истина, если символ разделяет токены.
Функция ЭтоГраницаФрагмента(Символ)

	Возврат ПустаяСтрока(Символ)
		ИЛИ СтрНайти(" (),.;:=<>+-*/'""«»" + Символы.ПС + Символы.ВК + Символы.Таб, Символ) > 0;

КонецФункции
// Строка состоит только из букв, цифр и подчёркиваний (имя объекта метаданных).
//
// Параметры:
//  Текст - Строка - проверяемый фрагмент.
//
// Возвращаемое значение:
//  Булево - Истина, если фрагмент - корректное имя.
Функция ЭтоИмяПолное(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если НЕ ЭтоБукваЦифра(Сред(Текст, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Значение в кавычках из текста ошибки вида «Поле не найдено "Т.Поле"»
// (кавычки прямые или «ёлочки»). Виды кавычек перебираются списком пар:
// под определённую открывающую подходит только одна закрывающая.
//
// Параметры:
//  ТекстОшибки - Строка - представление ошибки платформы.
//  Фраза - Строка - фраза, после которой в кавычках идёт значение.
//
// Возвращаемое значение:
//  Строка - значение в кавычках; пустая строка, если разобрать не удалось.
Функция ЗначениеВКавычкахПослеФразы(ТекстОшибки, Фраза)

	Позиция = СтрНайти(ТекстОшибки, Фраза);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = СокрЛ(Сред(ТекстОшибки, Позиция + СтрДлина(Фраза)));
	ВидыКавычек = Новый Соответствие;
	ВидыКавычек.Вставить("""", """");
	ВидыКавычек.Вставить("«", "»");
	Для Каждого Пара Из ВидыКавычек Цикл
		Если Лев(Хвост, 1) <> Пара.Ключ Тогда
			Продолжить;
		КонецЕсли;
		Отрывок = Сред(Хвост, 2);
		КонецОтрывка = СтрНайти(Отрывок, Пара.Значение);
		Возврат ?(КонецОтрывка > 1, СокрЛП(Лев(Отрывок, КонецОтрывка - 1)), "");
	КонецЦикла;
	Возврат "";

КонецФункции

// Полное имя таблицы, которой в тексте запроса дан псевдоним («... КАК Т»).
// Параметры виртуальной таблицы в скобках пропускаются: у псевдонима
// «РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата) КАК Т» именем таблицы будет
// «РегистрНакопления.ТоварыНаСкладах.Остатки».
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса.
//  Псевдоним - Строка - псевдоним таблицы.
//
// Возвращаемое значение:
//  Строка - имя таблицы; пустая строка, если псевдоним не найден.
Функция ИмяТаблицыПоПсевдониму(ТекстЗапроса, Псевдоним)

	Текст = " " + СтрЗаменить(СтрЗаменить(СтрЗаменить(ТекстЗапроса, Символы.ПС, " "),
		Символы.ВК, " "), Символы.Таб, " ") + " ";
	ТекстНРег = НРег(Текст);
	Искомое = " как " + НРег(Псевдоним);
	Позиция = СтрНайти(ТекстНРег, Искомое);
	Пока Позиция > 0 Цикл
		Следующий = Сред(ТекстНРег, Позиция + СтрДлина(Искомое), 1);
		Если Следующий = "" ИЛИ СтрНайти(" ,()=<>;", Следующий) > 0 Тогда
			Токен = ИмяПоляПередПсевдонимом(Текст, Позиция);
			Если НЕ ПустаяСтрока(Токен) Тогда
				Возврат Токен;
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(ТекстНРег, Искомое, НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;

	Возврат "";

КонецФункции

// Имя таблицы перед словом КАК. Список параметров в скобках (виртуальная таблица)
// пропускается: «РегистрНакопления.X.Остатки(&Дата) КАК Т» дает «РегистрНакопления.X.Остатки».
//
// Параметры:
//  Текст - Строка - нормализованный текст запроса (без переводов строк).
//  Позиция - Число - позиция слова «как» (в нижнем регистре текста).
//
// Возвращаемое значение:
//  Строка - имя таблицы перед словом КАК.
Функция ИмяПоляПередПсевдонимом(Текст, Позиция)

	Индекс = ПропуститьПробелыНазад(Текст, Позиция);
	Если Сред(Текст, Индекс, 1) = ")" Тогда
		Индекс = ПропуститьПробелыНазад(Текст, ПропуститьЗакрытуюСкобкуНазад(Текст, Индекс));
	КонецЕсли;
	Возврат СловоНазадОт(Текст, Индекс);

КонецФункции

// Ближайший слева непробельный символ: возвращает его позицию (не индекс за ним).
//
// Параметры:
//  Текст - Строка - текст.
//  Индекс - Число - стартовая позиция (включительно).
//
// Возвращаемое значение:
//  Число - позиция первого слева символа, отличного от пробела; 0, если текст кончился.
Функция ПропуститьПробелыНазад(Текст, Индекс)

	Пока Индекс > 0 И Сред(Текст, Индекс, 1) = " " Цикл
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

// Позиция левее скобки, парной к закрывающей «)» в позиции Индекс. Для
// несбалансированного текста доходит до начала строки.
//
// Параметры:
//  Текст - Строка - текст.
//  Индекс - Число - позиция закрывающей скобки «)».
//
// Возвращаемое значение:
//  Число - позиция, предшествующая парной «(» (её символ в результат не входит).
Функция ПропуститьЗакрытуюСкобкуНазад(Текст, Индекс)

	Если Сред(Текст, Индекс, 1) <> ")" Тогда
		Возврат Индекс;
	КонецЕсли;

	Баланс = 0;
	ТекущаяПозиция = Индекс;
	Пока ТекущаяПозиция >= 1 Цикл
		СимволТекста = Сред(Текст, ТекущаяПозиция, 1);
		Если СимволТекста = "(" Тогда
			Баланс = Баланс - 1;
		ИначеЕсли СимволТекста = ")" Тогда
			Баланс = Баланс + 1;
		КонецЕсли;
		Если Баланс = 0 Тогда
			Возврат ТекущаяПозиция - 1;
		КонецЕсли;
		ТекущаяПозиция = ТекущаяПозиция - 1;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Слово, примыкающее к позиции справа, до ближайшего разделителя « ,();».
//
// Параметры:
//  Текст - Строка - текст.
//  Индекс - Число - позиция последнего символа слова.
//
// Возвращаемое значение:
//  Строка - слово; пустая строка, если слева сразу разделитель.
Функция СловоНазадОт(Текст, Индекс)

	КонецСлова = Индекс;
	Пока Индекс > 0 И СтрНайти(" ,();", Сред(Текст, Индекс, 1)) = 0 Цикл
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Сред(Текст, Индекс + 1, КонецСлова - Индекс);

КонецФункции

// Позиция подстроки поиска в имени или синониме объекта метаданных (первое
// совпадение). Единица означает, что подстрока совпала с начала строки, -
// такие кандидаты в результатах поиска идут первыми.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект метаданных.
//  ПодстрокаИмени - Строка - подстрока поиска в верхнем регистре.
//
// Возвращаемое значение:
//  Число - позиция совпадения или 0, если подстрока не найдена.
Функция ПозицияПодстрокиВОбъекте(ОбъектМД, ПодстрокаИмени)

	Позиция = СтрНайти(ВРег(ОбъектМД.Имя), ПодстрокаИмени);
	ПозицияСинонима = СтрНайти(ВРег(Строка(ОбъектМД.Синоним)), ПодстрокаИмени);
	Если Позиция = 0 Тогда
		Возврат ПозицияСинонима;
	ИначеЕсли ПозицияСинонима = 0 Тогда
		Возврат Позиция;
	КонецЕсли;
	Возврат Мин(Позиция, ПозицияСинонима);

КонецФункции

// Порог кандидатов в результатах поиска GetMetadataSchema: при поиске по
// подстроке показываются первые кандидаты и подсказка уточнить запрос.
//
// Возвращаемое значение:
//  Число - максимальное число показанных кандидатов.
Функция ПорогКандидатовПоиска()

	Возврат 20;

КонецФункции

// Коллекция метаданных по имени класса таблицы.
//
// Параметры:
//  Класс - Строка - имя класса («Справочник», «РегистрНакопления», ...).
//
// Возвращаемое значение:
//  Произвольный,Неопределено - коллекция метаданных или Неопределено.
Функция КоллекцияМетаданныхПоКлассу(Класс)

	Если Класс = "Справочник" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли Класс = "Документ" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли Класс = "РегистрСведений" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли Класс = "РегистрНакопления" Тогда
		Возврат Метаданные.РегистрыНакопления;
	ИначеЕсли Класс = "РегистрБухгалтерии" Тогда
		Возврат Метаданные.РегистрыБухгалтерии;
	ИначеЕсли Класс = "Перечисление" Тогда
		Возврат Метаданные.Перечисления;
	ИначеЕсли Класс = "ПланВидовХарактеристик" Тогда
		Возврат Метаданные.ПланыВидовХарактеристик;
	ИначеЕсли Класс = "ЖурналДокументов" Тогда
		Возврат Метаданные.ЖурналыДокументов;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Перечень виртуальных таблиц и табличных частей объекта метаданных: используется
// в подсказке при ошибке «третья часть имени таблицы не найдена».
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект метаданных (регистр, документ, справочник).
//
// Возвращаемое значение:
//  Массив из Строка - имена доступных таблиц (может быть пустым).
Функция ИменаДоступныхТаблицОбъекта(ОбъектМД)

	Имена = Новый Массив;

	Если Метаданные.РегистрыНакопления.Содержит(ОбъектМД) Тогда
		ВидРегистра = СвойствоМетаданныхПоИмени(ОбъектМД, "ВидРегистра");
		Если ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Имена.Добавить("Остатки, Обороты, ОстаткиИОбороты");
		Иначе
			Имена.Добавить("Обороты");
		КонецЕсли;
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(ОбъектМД) Тогда
		Периодичность = СвойствоМетаданныхПоИмени(ОбъектМД, "ПериодичностьРегистраСведений");
		Если Периодичность <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Имена.Добавить("СрезПоследних, СрезПервых");
		КонецЕсли;
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМД) Тогда
		Имена.Добавить("Остатки, Обороты, ОстаткиИОбороты");
	КонецЕсли;

	ТабличныеЧасти = СвойствоМетаданныхПоИмени(ОбъектМД, "ТабличныеЧасти");
	Если ТабличныеЧасти <> Неопределено Тогда
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			Имена.Добавить(ТабличнаяЧасть.Имя);
		КонецЦикла;
	КонецЕсли;

	Возврат Имена;

КонецФункции

// Значение свойства объекта метаданных по имени. У разных классов объектов состав
// свойств различается, поэтому отсутствующее свойство - это Неопределено, а не
// исключение; единственная точка подавления - здесь, вызывающий код без вложенных
// Попытка проверяет результат на Неопределено.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - объект метаданных.
//  ИмяСвойства - Строка - имя свойства (или коллекции).
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение свойства.
Функция СвойствоМетаданныхПоИмени(ОбъектМД, ИмяСвойства)

	Попытка
		Возврат ОбъектМД[ИмяСвойства];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Имена элементов коллекции метаданных через запятую. Неопределено (у класса нет
// такой коллекции) дает пустую строку.
//
// Параметры:
//  Коллекция - Произвольный - коллекция метаданных.
//
// Возвращаемое значение:
//  Строка - имена элементов через запятую.
Функция ИменаКоллекцииМетаданных(Коллекция)

	Если Коллекция = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Имена.Добавить(Элемент.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

// Имена объектов класса, похожие на образец (или первые объекты класса, если
// образец пуст). Сравнение - по словам имени и синонима.
//
// Параметры:
//  Коллекция - Произвольный - коллекция метаданных класса.
//  Образец - Строка - имя для поиска похожих (пустая строка - без сравнения).
//  Максимум - Число - максимум возвращаемых имён.
//  ТребоватьСходство - Булево - Истина: вернуть только похожие.
//
// Возвращаемое значение:
//  Массив из Строка - имена объектов метаданных.
Функция УпомянутыеИменаКласса(Коллекция, Образец, Максимум, ТребоватьСходство)

	Результат = Новый Массив;
	Слова = КлючевыеСловаИмени(Образец);

	Для Каждого ОбъектМД Из Коллекция Цикл
		Если ТребоватьСходство Тогда
			Если Слова.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			ИмяСиноним = НРег(ОбъектМД.Имя + " " + Строка(ОбъектМД.Синоним));
			Подходит = Ложь;
			Для Каждого Слово Из Слова Цикл
				Если СтрНайти(ИмяСиноним, Слово) > 0 Тогда
					Подходит = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Подходит Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(ОбъектМД.Имя);
		Если Результат.Количество() >= Максимум Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Слова имени в стиле 1С для поиска похожих: имя разбивается по CamelCase
// и разделителям, слова короче четырех символов отбрасываются, длинные
// обрезаются до основы (первые пять символов) - чтобы находить разные падежи.
//
// Параметры:
//  Имя - Строка - имя (например «ВыручкаИСебестоимость»).
//
// Возвращаемое значение:
//  Массив из Строка - слова в нижнем регистре.
Функция КлючевыеСловаИмени(Имя)

	Результат = Новый Массив;
	Если ПустаяСтрока(Имя) Тогда
		Возврат Результат;
	КонецЕсли;

	Слово = "";
	Для Индекс = 1 По СтрДлина(Имя) + 1 Цикл
		СимволТекста = Сред(Имя, Индекс, 1);
		ЭтоГраница = СимволТекста = ""
			ИЛИ ЭтоРазделительСлова(СимволТекста)
			ИЛИ (Индекс > 1 И ЭтоНачалоНовогоСлова(Сред(Имя, Индекс - 1, 1), СимволТекста));
		Если НЕ ЭтоГраница Тогда
			Слово = Слово + СимволТекста;
			Продолжить;
		КонецЕсли;

		Нормализованное = НРег(Слово);
		Если СтрДлина(Нормализованное) >= МинимальнаяДлинаКлючевогоСлова() Тогда
			Нормализованное = ОсноваСлова(Нормализованное);
			Если Результат.Найти(Нормализованное) = Неопределено Тогда
				Результат.Добавить(Нормализованное);
			КонецЕсли;
		КонецЕсли;
		Слово = СимволТекста;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Признак разделителя слов в имени объекта метаданных. Набор шире, чем в
// обычном тексте: в именах встречаются угловые скобки и обратный слэш.
//
// Параметры:
//  Символ - Строка - проверяемый символ.
//
// Возвращаемое значение:
//  Булево - Истина, если символ разделяет слова.
Функция ЭтоРазделительСлова(Символ)

	Возврат СтрНайти(" .,;:!?()[]{}<>/\|-_'""«»" + Символы.ПС + Символы.ВК + Символы.Таб, Символ) > 0;

КонецФункции

// Начало нового слова в стиле CamelCase: предыдущий символ - строчная буква,
// текущий - заглавная. Так «ВыручкаИСебестоимость» даёт два слова.
//
// Параметры:
//  Предыдущий - Строка - предыдущий символ.
//  Текущий - Строка - текущий символ.
//
// Возвращаемое значение:
//  Булево - Истина, если текущий символ начинает новое слово.
Функция ЭтоНачалоНовогоСлова(Предыдущий, Текущий)

	Возврат ВРег(Текущий) = Текущий
		И НРег(Текущий) <> Текущий
		И НРег(Предыдущий) = Предыдущий
		И ВРег(Предыдущий) <> Предыдущий;

КонецФункции

// Основа слова для поиска: длинные слова обрезаются, чтобы находить разные
// падежи и словоформы. Шестибуквенные слова сохраняются целиком.
//
// Параметры:
//  Слово - Строка - нормализованное слово.
//
// Возвращаемое значение:
//  Строка - основа слова.
Функция ОсноваСлова(Слово)

	Если СтрДлина(Слово) <= ДлинаОсновыСлова() Тогда
		Возврат Слово;
	КонецЕсли;
	Возврат Лев(Слово, ДлинаОсновыСлова());

КонецФункции

// Минимальная длина слова, попадающего в поиск.
//
// Возвращаемое значение:
//  Число - минимальная длина.
Функция МинимальнаяДлинаКлючевогоСлова()

	Возврат 4;

КонецФункции

// Длина основы слова для поиска.
//
// Возвращаемое значение:
//  Число - длина основы.
Функция ДлинаОсновыСлова()

	Возврат 6;

КонецФункции

// Похожие имена из списка: слова образца ищутся в имени как подстроки.
//
// Параметры:
//  Имена - Массив из Строка - имена для отбора.
//  Образец - Строка - имя, к которому ищутся похожие.
//  Максимум - Число - максимум возвращаемых имён.
//
// Возвращаемое значение:
//  Строка - имена через запятую; пустая строка, если похожих нет.
Функция ПохожиеИменаПолей(Имена, Образец, Максимум)

	Слова = КлючевыеСловаИмени(Образец);
	Если Слова.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Похожие = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		ИмяНРег = НРег(Имя);
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(ИмяНРег, Слово) > 0 Тогда
				Похожие.Добавить(Имя);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Похожие.Количество() >= Максимум Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Похожие, ", ");

КонецФункции

// Перечень, ограниченный количеством элементов (для усечения длинных списков
// в подсказках: перечислять все поля объекта не нужно, хватает первых).
//
// Параметры:
//  Значения - Массив - исходный массив.
//  Максимум - Число - сколько элементов оставить.
//
// Возвращаемое значение:
//  Массив - первые Максимум элементов.
Функция ОграничитьПеречень(Значения, Максимум)

	Результат = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если Результат.Количество() >= Максимум Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена полей объекта метаданных по имени его таблицы (реквизиты, измерения,
// ресурсы, табличные части, стандартные реквизиты). Сбой разбора метаданных
// возвращает пустой список - подсказка строится без перечня полей.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы («Справочник.Пользователи»).
//
// Возвращаемое значение:
//  Массив из Строка - имена полей.
Функция ИменаПолейОбъектаПоИмениТаблицы(ИмяТаблицы)

	Имена = Новый Массив;

	Если ОбъектЗапрещен(ИмяТаблицы) ИЛИ ОбъектМетаданныхПоИмениТаблицы(ИмяТаблицы) = Неопределено Тогда
		Возврат Имена;
	КонецЕсли;

	Схема = ДетальнаяСхемаОбъекта(ИмяТаблицы);
	Если Схема = Неопределено ИЛИ Схема.Поля = Неопределено Тогда
		Возврат Имена;
	КонецЕсли;
	Для Каждого ОписаниеПоля Из Схема.Поля Цикл
		Имена.Добавить(ОписаниеПоля.Имя);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Объект метаданных по полному имени таблицы. Для виртуальных таблиц, имён
// с лишними частями и опечатками возвращается Неопределено (а не исключение):
// имя перед вызовом проверяется на формат «Класс.Имя», поэтому платформенный
// поиск не может получить некорректную строку.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы («Справочник.Пользователи»).
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - объект метаданных.
Функция ОбъектМетаданныхПоИмениТаблицы(ИмяТаблицы)

	Части = СтрРазделить(ИмяТаблицы, ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		Если НЕ ЭтоИмяПолное(Часть) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);

КонецФункции

// Объекты метаданных, упомянутые в тексте запроса: токены вида «Справочник.X»,
// «Документ.Y», «РегистрНакопления.Z», существующие в конфигурации.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса модели.
//
// Возвращаемое значение:
//  Массив из Строка - полные имена таблиц (не более десяти).
Функция УпомянутыеОбъектыЗапроса(ТекстЗапроса)

	Найденные = Новый Массив;
	Классы = Новый Массив;
	Классы.Добавить("Справочник");
	Классы.Добавить("Документ");
	Классы.Добавить("РегистрСведений");
	Классы.Добавить("РегистрНакопления");
	Классы.Добавить("Перечисление");
	Классы.Добавить("ПланВидовХарактеристик");
	Классы.Добавить("ЖурналДокументов");

	Разделители = " ,;:!?()[]{}""'«»/\|_" + Символы.ПС + Символы.ВК + Символы.Таб + "<>=+*";
	Для Каждого Токен Из СтрРазделить(ТекстЗапроса, Разделители, Ложь) Цикл
		Части = СтрРазделить(Токен, ".", Ложь);
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Класс = "";
		Для Каждого ВариантКласса Из Классы Цикл
			Если Части[0] = ВариантКласса Тогда
				Класс = ВариантКласса;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПустаяСтрока(Класс) Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = Класс + "." + Части[1];
		Если Найденные.Найти(ПолноеИмя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) <> Неопределено Тогда
				Найденные.Добавить(ПолноеИмя);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если Найденные.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Подсказка по виртуальным таблицам регистров: типовые ошибки параметров
// Остатки/Обороты/ОстаткиИОбороты (и СрезПоследних/СрезПервых регистров сведений)
// показываются вместе с измерениями и ресурсами конкретного регистра из запроса.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса модели.
//  ТекстОшибки - Строка - представление ошибки платформы.
//
// Возвращаемое значение:
//  Строка - подсказка; пустая строка, если ошибка не связана с виртуальными таблицами.
Функция НайтиПроблемуВиртуальнойТаблицы(ТекстЗапроса, ТекстОшибки)

	ЗапросВРег = ВРег(ТекстЗапроса);
	ЕстьВиртуальнаяТаблица = СтрНайти(ЗапросВРег, ".ОСТАТКИИОБОРОТЫ(") > 0
		ИЛИ СтрНайти(ЗапросВРег, ".ОСТАТКИ(") > 0
		ИЛИ СтрНайти(ЗапросВРег, ".ОБОРОТЫ(") > 0
		ИЛИ СтрНайти(ЗапросВРег, ".СРЕЗПОСЛЕДНИХ(") > 0
		ИЛИ СтрНайти(ЗапросВРег, ".СРЕЗПЕРВЫХ(") > 0;
	Если НЕ ЕстьВиртуальнаяТаблица Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОшибкаВРег = ВРег(ТекстОшибки);
	Если СтрНайти(ОшибкаВРег, "ПАРАМЕТР") = 0
		И СтрНайти(ОшибкаВРег, "ОЖИДАЕТСЯ") = 0
		И СтрНайти(ОшибкаВРег, "НЕ НАЙДЕНО") = 0
		И СтрНайти(ОшибкаВРег, "СЛИШКОМ МНОГО") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПолноеИмяРегистра = "";
	Для Каждого ОбъектЗапроса Из УпомянутыеОбъектыЗапроса(ТекстЗапроса) Цикл
		Если СтрНачинаетсяС(ОбъектЗапроса, "РегистрНакопления.")
			ИЛИ СтрНачинаетсяС(ОбъектЗапроса, "РегистрСведений.")
			ИЛИ СтрНачинаетсяС(ОбъектЗапроса, "РегистрБухгалтерии.") Тогда
			ПолноеИмяРегистра = ОбъектЗапроса;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Измерения = "";
	Ресурсы = "";
	Если НЕ ПустаяСтрока(ПолноеИмяРегистра) Тогда
		ОбъектМД = ОбъектМетаданныхПоИмениТаблицы(ПолноеИмяРегистра);
		Если ОбъектМД <> Неопределено Тогда
			Измерения = ИменаКоллекцииМетаданных(СвойствоМетаданныхПоИмени(ОбъектМД, "Измерения"));
			Ресурсы = ИменаКоллекцииМетаданных(СвойствоМетаданныхПоИмени(ОбъектМД, "Ресурсы"));
		КонецЕсли;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Остатки(&Период, Условие);");
	Строки.Добавить("Обороты(&Начало, &Конец, Периодичность, Условие);");
	Строки.Добавить("ОстаткиИОбороты(&Начало, &Конец, Периодичность, МетодДополнения, Условие);");
	Если НЕ ПустаяСтрока(ПолноеИмяРегистра) И СтрНачинаетсяС(ПолноеИмяРегистра, "РегистрСведений.") Тогда
		Строки.Добавить("СрезПоследних(&Период, Условие);");
		Строки.Добавить("СрезПервых(&Период, Условие).");
	КонецЕсли;

	Текст = "Для виртуальной таблицы " + ?(ПустаяСтрока(ПолноеИмяРегистра), "регистра", ПолноеИмяРегистра)
		+ " доступны параметры:" + Символы.ПС + "- " + СтрСоединить(Строки, Символы.ПС + "- ");
	Если НЕ ПустаяСтрока(Измерения) ИЛИ НЕ ПустаяСтрока(Ресурсы) Тогда
		Текст = Текст + Символы.ПС + "Измерения: " + Измерения
			+ ?(ПустаяСтрока(Ресурсы), "", "; ресурсы: " + Ресурсы) + ".";
	КонецЕсли;
	Текст = Текст + Символы.ПС + "Ненужные параметры пропускайте запятыми. В скобках виртуальной таблицы "
		+ "отбирайте только по измерениям; отбор по ресурсам - в ГДЕ или ИМЕЮЩИЕ. К ресурсам добавляется суффикс: "
		+ "<Ресурс>Остаток, <Ресурс>Оборот, <Ресурс>НачальныйОстаток, <Ресурс>КонечныйОстаток.";

	Проблема = НоваяПроблемаЗапроса("ВиртуальнаяТаблица");
	Проблема.Объект = ПолноеИмяРегистра;
	Проблема.Текст = Текст;
	Возврат Проблема;

КонецФункции
// Разбор периода, названного словами в вопросе пользователя: инструмент
// ParsePeriod. Возвращает точные границы периода, которые модель подставляет
// в параметры запроса.
//
// Параметры:
//  Аргументы - Структура, Соответствие из Строка,Произвольный:
//    * Текст - Строка - фраза с периодом («за 3 квартал», «в прошлом месяце»,
//      «за последние 30 дней»); параметр обязательный.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура:
//      ** Распознан - Булево - удалось ли определить период.
//      ** ДатаНачала - Строка - начало периода в формате ГГГГ-ММ-ДД.
//      ** ДатаКонца - Строка - конец периода в формате ГГГГ-ММ-ДД
//        (конец периода - конец дня).
//      ** НачалоДатаВремя - Строка - начало периода в формате ГГГГ-ММ-ДДTЧЧ:ММ:СС.
//      ** КонецДатаВремя - Строка - конец периода в формате ГГГГ-ММ-ДДTЧЧ:ММ:СС
//        (передавайте границы в параметры запроса, чтобы конец последнего дня
//        вошёл в отбор).
//      ** Пояснение - Строка - как период понят человек («3 квартал 2025»).
//      ** Подсказка - Строка - что делать, если период не распознан.
//    * Ошибка - Строка,Неопределено.
Функция РазобратьПериодПоТексту(Аргументы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		Текст = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Текст", "");
		Если ПустаяСтрока(Текст) Тогда
			Результат.Ошибка = "Не передан Текст. Передайте фразу с периодом, например «за 3 квартал».";
			Возврат Результат;
		КонецЕсли;

		Период = РаспознатьПериодВТексте(НРег(СокрЛП(Текст)), ТекущаяДатаСеанса());
		Значение = Новый Структура;
		Если Период = Неопределено Тогда
			Значение.Вставить("Распознан", Ложь);
			Значение.Вставить("Подсказка", "Период из текста не распознан. Поддерживаются: «за 3 квартал», "
				+ "«во 2 квартале», «прошлый квартал», «за июль», «в сентябре 2025», «в прошлом месяце», "
				+ "«в этом месяце», «за неделю», «за последние 30 дней», «с начала года», «за 2025 год», "
				+ "«с 01.07.2025 по 30.09.2025». Уточните период у пользователя или вызовите "
				+ "GetCurrentDateTime (для «этого года», «текущего месяца»).");
		Иначе
			Значение.Вставить("Распознан", Истина);
			Значение.Вставить("ДатаНачала", Формат(Период.Начало, "ДФ='yyyy-MM-dd'"));
			Значение.Вставить("ДатаКонца", Формат(Период.Конец, "ДФ='yyyy-MM-dd'"));
			Значение.Вставить("НачалоДатаВремя", Формат(Период.Начало, "ДФ='yyyy-MM-dd''T''HH:mm:ss'"));
			Значение.Вставить("КонецДатаВремя", Формат(Период.Конец, "ДФ='yyyy-MM-dd''T''HH:mm:ss'"));
			Значение.Вставить("Пояснение", Период.Пояснение);
		КонецЕсли;

		Результат.Значение = Значение;
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = "Ошибка разбора периода: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Разбирает период из текста вопроса. Поддерживаются: две явные даты (диапазон),
// квартал (номер цифрой или словом), месяц по названию, «прошлый/этот месяц»,
// «прошлый год», «с начала года», «за 2025 год», «последние N дней/недель/месяцев»,
// «за неделю». Границы периода - от начала дня начала до конца дня окончания.
//
// Параметры:
//  ТекстНРег - Строка - текст вопроса в нижнем регистре.
//  Сегодня - Дата - текущая дата сеанса.
//
// Возвращаемое значение:
//  Структура,Неопределено:
//    * Начало - Дата - начало периода.
//    * Конец - Дата - конец периода (конец дня).
//    * Пояснение - Строка - человеческое описание периода.
Функция РаспознатьПериодВТексте(ТекстНРег, Сегодня)

	Даты = ИзвлечьДатыПериода(ТекстНРег);
	Если Даты.Количество() >= 2 Тогда
		НачалоДиапазона = Мин(Даты[0], Даты[1]);
		КонецДиапазона = Макс(Даты[0], Даты[1]);
		Возврат НовыйПериод(НачалоДиапазона, КонецДня(КонецДиапазона),
			"период с " + Формат(НачалоДиапазона, "ДФ='dd.MM.yyyy'") + " по "
			+ Формат(КонецДиапазона, "ДФ='dd.MM.yyyy'"));
	КонецЕсли;

	ПериодПоследних = ПериодПоследнихДнейИзТекста(ТекстНРег, Сегодня);
	Если ПериодПоследних <> Неопределено Тогда
		Возврат ПериодПоследних;
	КонецЕсли;

	ГодЦифрами = ИзвлечьГодПериода(ТекстНРег);
	Токены = ТокеныТекста(ТекстНРег);

	ПериодКвартала = РаспознатьКвартал(Токены, ГодЦифрами, Сегодня);
	Если ПериодКвартала <> Неопределено Тогда
		Возврат ПериодКвартала;
	КонецЕсли;

	ПериодМесяца = РаспознатьМесяц(Токены, ГодЦифрами, Сегодня);
	Если ПериодМесяца <> Неопределено Тогда
		Возврат ПериодМесяца;
	КонецЕсли;

	Прошлый = ЕстьТокенСОсновой(Токены, "прошл") ИЛИ ЕстьТокенСОсновой(Токены, "предыдущ");
	Текущий = ЕстьТокенСОсновой(Токены, "текущ")
		ИЛИ ЕстьТокенСОсновой(Токены, "этот")
		ИЛИ ЕстьТокенСОсновой(Токены, "этом")
		ИЛИ ЕстьТокенСОсновой(Токены, "этого");
	ЕстьМесяц = ЕстьТокенСОсновой(Токены, "месяц");
	ЕстьГод = ЕстьТокенСОсновой(Токены, "год");

	Если ЕстьМесяц И Прошлый Тогда
		НачалоПериода = НачалоМесяца(НачалоМесяца(Сегодня) - 1);
		Возврат НовыйПериод(НачалоПериода, КонецДня(КонецМесяца(НачалоПериода)), "прошлый месяц");
	ИначеЕсли ЕстьМесяц И Текущий Тогда
		Возврат НовыйПериод(НачалоМесяца(Сегодня), КонецДня(Сегодня), "текущий месяц");
	ИначеЕсли ЕстьГод И Прошлый Тогда
		НачалоПериода = НачалоГода(НачалоГода(Сегодня) - 1);
		Возврат НовыйПериод(НачалоПериода, КонецДня(КонецГода(НачалоПериода)), "прошлый год");
	ИначеЕсли ЕстьГод И (Текущий ИЛИ ЕстьТокенСОсновой(Токены, "начал")) Тогда
		Возврат НовыйПериод(НачалоГода(Сегодня), КонецДня(Сегодня), "с начала года");
	КонецЕсли;

	Если ГодЦифрами > 0
		И (СтрНайти(ТекстНРег, Формат(ГодЦифрами, "ЧГ=0") + " год") > 0
			ИЛИ СтрНайти(ТекстНРег, Формат(ГодЦифрами, "ЧГ=0") + " г.") > 0) Тогда
		НачалоПериода = Дата(ГодЦифрами, 1, 1);
		Возврат НовыйПериод(НачалоПериода, КонецДня(КонецГода(НачалоПериода)),
			Формат(ГодЦифрами, "ЧГ=0") + " год");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Разбирает текст на токены по пробелам и разделителям.
Функция ТокеныТекста(Текст)

	Разделители = " ,.;:!?()[]{}«»-" + Символы.ПС + Символы.ВК + Символы.Таб;
	Результат = Новый Массив;
	Слово = "";
	Для Индекс = 1 По СтрДлина(Текст) + 1 Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "" ИЛИ СтрНайти(Разделители, Символ) > 0 Тогда
			Если НЕ ПустаяСтрока(Слово) Тогда
				Результат.Добавить(Слово);
				Слово = "";
			КонецЕсли;
		Иначе
			Слово = Слово + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Распознаёт квартал по токенам перед словом «квартал».
Функция РаспознатьКвартал(Токены, ГодЦифрами, Сегодня)

	ПозицияКвартала = -1;
	Для Индекс = 0 По Токены.ВГраница() Цикл
		Если СтрНачинаетсяС(Токены[Индекс], "квартал") ИЛИ Токены[Индекс] = "кв" Тогда
			ПозицияКвартала = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияКвартала < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	НомерКвартала = 0;
	Для Смещение = 1 По 2 Цикл
		Индекс = ПозицияКвартала - Смещение;
		Если Индекс < 0 Тогда
			Прервать;
		КонецЕсли;
		НомерКвартала = НомерКварталаПоТокену(Токены[Индекс]);
		Если НомерКвартала > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НомерКвартала > 0 Тогда
		НачалоКварталаВТекущемГоду = Дата(Год(Сегодня), (НомерКвартала - 1) * 3 + 1, 1);
		ГодПериода = ?(ГодЦифрами = 0,
			ОпределитьГодПериода(НачалоКварталаВТекущемГоду, Сегодня), ГодЦифрами);
		НачалоПериода = Дата(ГодПериода, (НомерКвартала - 1) * 3 + 1, 1);
		Возврат НовыйПериод(НачалоПериода,
			КонецДня(КонецМесяца(Дата(ГодПериода, (НомерКвартала - 1) * 3 + 3, 1))),
			Формат(НомерКвартала, "ЧГ=0") + " квартал " + Формат(ГодПериода, "ЧГ=0"));
	КонецЕсли;

	Перед = "";
	Для Смещение = 1 По 2 Цикл
		Индекс = ПозицияКвартала - Смещение;
		Если Индекс < 0 Тогда
			Прервать;
		КонецЕсли;
		Перед = Перед + " " + Токены[Индекс];
	КонецЦикла;

	Если СтрНайти(Перед, "прошл") > 0 ИЛИ СтрНайти(Перед, "предыдущ") > 0 Тогда
		НачалоПериода = НачалоКварталаПериода(Сегодня, -1);
		Возврат НовыйПериод(НачалоПериода,
			КонецДня(КонецМесяца(Дата(Год(НачалоПериода), Месяц(НачалоПериода) + 2, 1))),
			"прошлый квартал");
	ИначеЕсли СтрНайти(Перед, "этот") > 0 ИЛИ СтрНайти(Перед, "этом") > 0 ИЛИ СтрНайти(Перед, "текущ") > 0 Тогда
		Возврат НовыйПериод(НачалоКварталаПериода(Сегодня), КонецДня(Сегодня), "текущий квартал");
	КонецЕсли;

	НачалоПериода = НачалоКварталаПериода(Сегодня, -1);
	Возврат НовыйПериод(НачалоПериода,
		КонецДня(КонецМесяца(Дата(Год(НачалоПериода), Месяц(НачалоПериода) + 2, 1))),
		"последний завершённый квартал");

КонецФункции

// Номер квартала по токену: цифра 1-4 или слово «первый»...«четвёртый».
Функция НомерКварталаПоТокену(Токен)

	Если ЭтоТокенЦифра(Токен) Тогда
		Номер = Число(Токен);
		Если Номер >= 1 И Номер <= 4 Тогда
			Возврат Номер;
		КонецЕсли;
		Возврат 0;
	КонецЕсли;

	Основы = КварталыПоОснове();
	Для Индекс = 0 По Основы.ВГраница() Цикл
		Если СтрНачинаетсяС(Токен, Основы[Индекс]) Тогда
			Возврат Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Основы названий кварталов.
Функция КварталыПоОснове()

	Основы = Новый Массив;
	Основы.Добавить("перв");
	Основы.Добавить("втор");
	Основы.Добавить("трет");
	Основы.Добавить("четверт");
	Возврат Основы;

КонецФункции

// Распознаёт месяц по токенам. Названия месяцев заданы основами, сравнение
// идёт по началу слова, поэтому «сентябрь» и «сентябре» находятся одинаково.
Функция РаспознатьМесяц(Токены, ГодЦифрами, Сегодня)

	НомерМесяца = 0;
	Для Каждого Токен Из Токены Цикл
		НомерМесяца = НомерМесяцаПоТокену(Токен);
		Если НомерМесяца > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НомерМесяца = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	МесяцВТекущемГоду = Дата(Год(Сегодня), НомерМесяца, 1);
	ГодПериода = ?(ГодЦифрами = 0, ОпределитьГодПериода(МесяцВТекущемГоду, Сегодня), ГодЦифрами);
	НачалоПериода = Дата(ГодПериода, НомерМесяца, 1);
	Возврат НовыйПериод(НачалоПериода, КонецДня(КонецМесяца(НачалоПериода)),
		Формат(НачалоПериода, "ДФ='ММММ yyyy'"));

КонецФункции

// Номер месяца по токену. Для мая учитываются формы «май», «мая», «мае».
Функция НомерМесяцаПоТокену(Токен)

	Если Токен = "май" ИЛИ Токен = "мая" ИЛИ Токен = "мае" Тогда
		Возврат 5;
	КонецЕсли;

	Месяцы = МесяцыПоОснове();
	Для Индекс = 0 По Месяцы.ВГраница() Цикл
		Если СтрНачинаетсяС(Токен, Месяцы[Индекс]) Тогда
			Возврат Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Основы названий месяцев.
Функция МесяцыПоОснове()

	Месяцы = Новый Массив;
	Месяцы.Добавить("январ");
	Месяцы.Добавить("феврал");
	Месяцы.Добавить("март");
	Месяцы.Добавить("апрел");
	Месяцы.Добавить("май");
	Месяцы.Добавить("июн");
	Месяцы.Добавить("июл");
	Месяцы.Добавить("август");
	Месяцы.Добавить("сентябр");
	Месяцы.Добавить("октябр");
	Месяцы.Добавить("ноябр");
	Месяцы.Добавить("декабр");
	Возврат Месяцы;

КонецФункции

// Признак токена, состоящего только из цифр.
Функция ЭтоТокенЦифра(Токен)

	Если ПустаяСтрока(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Токен) Цикл
		Если НЕ ЭтоЦифра(Сред(Токен, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Проверяет, есть ли среди токенов слово с заданной основой.
Функция ЕстьТокенСОсновой(Токены, Основа)

	Для Каждого Токен Из Токены Цикл
		Если СтрНачинаетсяС(Токен, Основа) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции
// Собирает структуру периода с концом дня в качестве окончания.
//
// Параметры:
//  Начало - Дата - начало периода (начало дня).
//  Конец - Дата - окончание периода (функция ещё раз применяет КонецДня).
//  Пояснение - Строка - человеческое описание периода.
//
// Возвращаемое значение:
//  Структура - {Начало, Конец, Пояснение}.
Функция НовыйПериод(Начало, Конец, Пояснение)

	Период = Новый Структура;
	Период.Вставить("Начало", НачалоДня(Начало));
	Период.Вставить("Конец", КонецДня(Конец));
	Период.Вставить("Пояснение", Пояснение);
	Возврат Период;

КонецФункции

// Начало квартала, в котором лежит дата, со сдвигом на СдвигКварталов
// (0 - текущий квартал, -1 - предыдущий). Имя с суффиксом «Периода»: глобальная
// функция платформы НачалоКвартала недоступна в режимах совместимости ниже 8.3.23.
//
// Параметры:
//  ДатаОтсчета - Дата - дата, по которой определяется квартал.
//  СдвигКварталов - Число - сдвиг в кварталах.
//
// Возвращаемое значение:
//  Дата - начало квартала.
Функция НачалоКварталаПериода(ДатаОтсчета, СдвигКварталов = 0)

	МесяцевОтНачалаЛет = Год(ДатаОтсчета) * 12 + (Месяц(ДатаОтсчета) - 1);
	МесяцевОтНачалаЛет = Цел(МесяцевОтНачалаЛет / 3) * 3 + СдвигКварталов * 3;
	Возврат Дата(Цел(МесяцевОтНачалаЛет / 12), МесяцевОтНачалаЛет % 12 + 1, 1);

КонецФункции

// «Последние N дней/недель/месяцев», «за неделю», «на этой неделе»: период
// отсчитывается назад от сегодняшнего дня.
//
// Параметры:
//  ТекстНРег - Строка - текст вопроса в нижнем регистре.
//  Сегодня - Дата - текущая дата сеанса.
//
// Возвращаемое значение:
//  Структура,Неопределено - период {Начало, Конец, Пояснение} или Неопределено.
Функция ПериодПоследнихДнейИзТекста(ТекстНРег, Сегодня)

	Позиция = СтрНайти(ТекстНРег, "последн");
	Если Позиция > 0 Тогда
		Хвост = Сред(ТекстНРег, Позиция + СтрДлина("последн"));
		ЧислоЕдиниц = ЧислоИзНачалаСтроки(Хвост);
		Множитель = 0;
		Название = "";
		Если СтрНайти(Хвост, "дн") > 0 Тогда
			Множитель = 1;
			Название = "дн.";
		ИначеЕсли СтрНайти(Хвост, "недел") > 0 Тогда
			Множитель = 7;
			Название = "нед.";
		ИначеЕсли СтрНайти(Хвост, "месяц") > 0 Тогда
			Если ЧислоЕдиниц = 0 Тогда
				НачалоПериода = НачалоМесяца(НачалоМесяца(Сегодня) - 1);
				Возврат НовыйПериод(НачалоПериода, КонецДня(КонецМесяца(НачалоПериода)), "последний месяц");
			КонецЕсли;
			Множитель = 30;
			Название = "мес.";
		ИначеЕсли СтрНайти(Хвост, "год") > 0 ИЛИ СтрНайти(Хвост, "лет") > 0 Тогда
			Если ЧислоЕдиниц = 0 Тогда
				НачалоПериода = Дата(Год(Сегодня) - 1, 1, 1);
				Возврат НовыйПериод(НачалоПериода, КонецДня(КонецГода(НачалоПериода)), "последний год");
			КонецЕсли;
			Множитель = 365;
			Название = "г.";
		КонецЕсли;
		Если Множитель > 0 Тогда
			Если ЧислоЕдиниц = 0 Тогда
				ЧислоЕдиниц = 1;
			КонецЕсли;
			Дней = ЧислоЕдиниц * Множитель;
			НачалоПериода = НачалоДня(Сегодня) - (Дней - 1) * 86400;
			Возврат НовыйПериод(НачалоПериода, КонецДня(Сегодня),
				"последние " + Формат(ЧислоЕдиниц, "ЧГ=0") + " " + Название);
		КонецЕсли;
	КонецЕсли;

	Если СтрНайти(ТекстНРег, "за неделю") > 0
		ИЛИ СтрНайти(ТекстНРег, "этой неделе") > 0
		ИЛИ СтрНайти(ТекстНРег, "текущей неделе") > 0
		ИЛИ СтрНайти(ТекстНРег, "последнюю неделю") > 0 Тогда
		НачалоПериода = НачалоДня(Сегодня) - 6 * 86400;
		Возврат НовыйПериод(НачалоПериода, КонецДня(Сегодня), "последние 7 дней");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Первое число в строке. Ведущие символы до цифры пропускаются: окончание
// «последние» отделяет число от слова-маркера («последн» + «ие 30 дней»).
//
// Параметры:
//  Текст - Строка - текст, в котором ищется число.
//
// Возвращаемое значение:
//  Число - найденное число или 0.
Функция ЧислоИзНачалаСтроки(Текст)

	Индекс = 1;
	Пока Индекс <= СтрДлина(Текст) И НЕ ЭтоЦифра(Сред(Текст, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;
	Цифры = "";
	Пока Индекс <= СтрДлина(Текст) И ЭтоЦифра(Сред(Текст, Индекс, 1)) Цикл
		Цифры = Цифры + Сред(Текст, Индекс, 1);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат ?(ПустаяСтрока(Цифры), 0, Число(Цифры));

КонецФункции

// Год без указания в вопросе: текущий, а если период в текущем году ещё
// не начался - прошлый («4 квартал» в феврале означает прошлогодний).
//
// Параметры:
//  НачалоВТекущемГоду - Дата - начало периода в текущем году.
//  Сегодня - Дата - текущая дата сеанса.
//
// Возвращаемое значение:
//  Число - год периода.
Функция ОпределитьГодПериода(НачалоВТекущемГоду, Сегодня)

	Если НачалоВТекущемГоду > Сегодня Тогда
		Возврат Год(Сегодня) - 1;
	КонецЕсли;
	Возврат Год(Сегодня);

КонецФункции
// Первый год вида 20NN в тексте (отдельным числом) или 0. Год ищется среди
// числовых серий текста: серия из четырёх цифр, начинающаяся на «20», годом
// является, только если перед ней нет точки (иначе это хвост даты «01.01.2025»),
// а после серии нет цифры (иначе это длинное число, например номер документа).
//
// Параметры:
//  Текст - Строка - текст вопроса в нижнем регистре.
//
// Возвращаемое значение:
//  Число - найденный год или 0.
Функция ИзвлечьГодПериода(Текст)

	Индекс = 1;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Если НЕ ЭтоЦифра(Сред(Текст, Индекс, 1)) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		КонецСерии = Индекс;
		Пока КонецСерии <= СтрДлина(Текст) И ЭтоЦифра(Сред(Текст, КонецСерии, 1)) Цикл
			КонецСерии = КонецСерии + 1;
		КонецЦикла;
		Серия = Сред(Текст, Индекс, КонецСерии - Индекс);
		Если СтрДлина(Серия) = 4 И Лев(Серия, 2) = "20"
			И (Индекс = 1 ИЛИ Сред(Текст, Индекс - 1, 1) <> ".") Тогда
			Возврат Число(Серия);
		КонецЕсли;
		Индекс = КонецСерии;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Даты вида дд.мм.гггг в тексте (используются как явный диапазон периода).
// Шаблон проверяется прямо по позициям: две цифры, точка, две цифры, точка,
// четыре цифры; некалендарные сочетания (32.13, 29.02 невисокосного года)
// отсеивает попытка построения даты.
//
// Параметры:
//  Текст - Строка - текста вопроса.
//
// Возвращаемое значение:
//  Массив из Дата - найденные даты.
Функция ИзвлечьДатыПериода(Текст)

	Результат = Новый Массив;
	Для Индекс = 1 По СтрДлина(Текст) - 9 Цикл
		Если НЕ ЭтоЦифра(Сред(Текст, Индекс, 1))
			ИЛИ НЕ ЭтоЦифра(Сред(Текст, Индекс + 1, 1))
			ИЛИ Сред(Текст, Индекс + 2, 1) <> "."
			ИЛИ НЕ ЭтоЦифра(Сред(Текст, Индекс + 3, 1))
			ИЛИ НЕ ЭтоЦифра(Сред(Текст, Индекс + 4, 1))
			ИЛИ Сред(Текст, Индекс + 5, 1) <> "."
			ИЛИ НЕ ЭтоЦифра(Сред(Текст, Индекс + 6, 1))
			ИЛИ НЕ ЭтоЦифра(Сред(Текст, Индекс + 7, 1))
			ИЛИ НЕ ЭтоЦифра(Сред(Текст, Индекс + 8, 1))
			ИЛИ НЕ ЭтоЦифра(Сред(Текст, Индекс + 9, 1)) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Результат.Добавить(Дата(Число(Сред(Текст, Индекс + 6, 4)),
				Число(Сред(Текст, Индекс + 3, 2)), Число(Сред(Текст, Индекс, 2))));
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пишет в журнал регистрации диагностику запроса: статус, текст запроса, параметры,
// таймаут и дополнительную информацию. Удобно для отладки того, что реально выполняется.
//
// Параметры:
//  Статус - Строка - краткий статус ("Выполнение", "Выполнено", "Отменено по таймауту", "Ошибка").
//  ТекстЗапроса - Строка - текст запроса (в журнал пишется до 1000 символов).
//  Параметры - Соответствие,Неопределено - параметры запроса.
//  ТаймаутСекунд - Число - таймаут в секундах (0 — не указывать).
//  Дополнительно - Строка - дополнительные сведения (количество строк, ошибка и т.п.).
//  УровеньЖурнала - УровеньЖурналаРегистрации,Неопределено - уровень записи
//    (по умолчанию Информация).
Процедура ЗаписатьДиагностикуЗапроса(Статус, ТекстЗапроса, Параметры, ТаймаутСекунд = 0,
	Дополнительно = "", УровеньЖурнала = Неопределено)

	Если УровеньЖурнала = Неопределено Тогда
		УровеньЖурнала = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;

	Сообщение = "Запрос (" + Статус + "): " + Лев(ТекстЗапроса, 1000);
	Если ТаймаутСекунд > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Таймаут: " + Строка(ТаймаутСекунд) + " сек";
	КонецЕсли;
	Сообщение = Сообщение + Символы.ПС + "Параметры: " + ПредставлениеПараметров(Параметры);
	Если НЕ ПустаяСтрока(Дополнительно) Тогда
		Сообщение = Сообщение + Символы.ПС + Дополнительно;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("СИ_Инструменты1С.Запрос", УровеньЖурнала,,, Сообщение);

КонецПроцедуры

// Формирует компактное строковое представление параметров запроса для журнала регистрации.
//
// Параметры:
//  Параметры - Соответствие,Неопределено - параметры запроса.
//
// Возвращаемое значение:
//  Строка - "Имя1=значение1; Имя2=[a,b,c]" или "(нет)".
Функция ПредставлениеПараметров(Параметры)

	Если Параметры = Неопределено ИЛИ Параметры.Количество() = 0 Тогда
		Возврат "(нет)";
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого КлючИЗначение Из Параметры Цикл
		Части.Добавить(КлючИЗначение.Ключ + "=" + ЗначениеДляЛога(КлючИЗначение.Значение));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Компактное представление одного значения параметра для журнала регистрации.
// Длинные строки сокращаются (см. МаксимальнаяДлинаСтрокиВЖурнале), чтобы в журнал
// не попадали потенциально чувствительные значения целиком (ИНН, телефоны и т.п.).
Функция ЗначениеДляЛога(Значение)

	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Элементы = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Элементы.Добавить(ЗначениеДляЛога(Элемент));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Элементы, ", ") + "]";
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='гггг-ММ-ддТЧЧ:мм:сс'");
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Если СтрДлина(Значение) > МаксимальнаяДлинаСтрокиВЖурнале() Тогда
			Возврат Лев(Значение, 2) + "..." + Прав(Значение, 2)
				+ " (строка, длина " + Строка(СтрДлина(Значение)) + ")";
		КонецЕсли;
		Возврат Значение;
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;

КонецФункции

// Порог длины строкового параметра: строки длиннее сокращаются в журнале регистрации.
//
// Возвращаемое значение:
//  Число - максимальная длина строки, выводимой в журнал полностью.
Функция МаксимальнаяДлинаСтрокиВЖурнале()

	Возврат 12;

КонецФункции

// Выполнение запроса выгрузки с таймаутом: фоновое задание с ожиданием,
// при недоступности фона - синхронно в текущем сеансе.
//
// Параметры:
//  ТекстЗапроса - Строка - подготовленный текст запроса.
//  Параметры - Соответствие - параметры запроса.
//  ТаймаутСекунд - Число - таймаут в секундах.
//  ЛимитСтрок - Число - нормализованный лимит строк выгрузки.
//
// Возвращаемое значение:
//  Структура - {Успех, Значение: {Строки, Колонки, КоличествоСтрок, ЕстьЕщеДанные}, Ошибка}.
Функция ВыполнитьВыгрузкуСТаймаутом(ТекстЗапроса, Параметры, ТаймаутСекунд, ЛимитСтрок)

	Если ЭтоСеансФоновогоЗадания() Тогда
		Возврат ВыполнитьЗапросВыгрузкиВТекущемСеансе(ТекстЗапроса, Параметры, ЛимитСтрок);
	КонецЕсли;

	Попытка
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		ПараметрыВыполнения.ОжидатьЗавершение = ТаймаутСекунд;
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выгрузка агента в файл";
		Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"СИ_Инструменты1С.ВыполнитьЗапросДляВыгрузкиВФоне",
			ТекстЗапроса, Параметры, ЛимитСтрок);
		Возврат ОбработатьРезультатДлительнойОперации(Операция, ТекстЗапроса, Параметры, ТаймаутСекунд);
	Исключение
		Возврат ВыполнитьЗапросВыгрузкиВТекущемСеансе(ТекстЗапроса, Параметры, ЛимитСтрок);
	КонецПопытки;

КонецФункции

// Выполняет запрос выгрузки в текущем сеансе и возвращает строки сырыми
// значениями. Ошибка выполнения не бросается наружу - она в результате.
//
// Параметры:
//  ТекстЗапроса - Строка - подготовленный текст запроса.
//  Параметры - Соответствие,Неопределено - параметры запроса.
//  ЛимитСтрок - Число - лимит строк выгрузки.
//
// Возвращаемое значение:
//  Структура - {Успех, Значение: {Строки, Колонки, КоличествоСтрок, ЕстьЕщеДанные}, Ошибка}.
Функция ВыполнитьЗапросВыгрузкиВТекущемСеансе(ТекстЗапроса, Параметры, ЛимитСтрок)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Если Параметры <> Неопределено Тогда
			Для Каждого КлючИЗначение Из Параметры Цикл
				Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;

		РезультатЗапроса = Запрос.Выполнить();
		Данные = СериализоватьВыгрузку(РезультатЗапроса, РезультатЗапроса.Выбрать(), ЛимитСтрок);
		Результат.Успех = Истина;
		Результат.Значение = Данные;
	Исключение
		Результат.Ошибка = ТекстОшибкиЗапросаПоИсключению(ТекстЗапроса,
			"Запрос выгрузки не выполнен: %1. Проверьте: имена таблиц и полей, синтаксис, типы параметров.");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Сериализует выборку выгрузки в строки с СЫРЫМИ значениями (число, дата,
// булево остаются собой) - табличный документ и диаграмма получают значения
// нужных типов, а не JSON-представления модели.
//
// Параметры:
//  РезультатЗапроса - РезультатЗапроса - результат (нужен для колонок).
//  Выборка - ВыборкаИзРезультатаЗапроса - выборка.
//  ЛимитСтрок - Число - предельное число строк.
//
// Возвращаемое значение:
//  Структура:
//    * Строки - Массив из Соответствие - строка: имя колонки -> сырое значение.
//    * Колонки - Массив из Строка - имена колонок в порядке запроса.
//    * КоличествоСтрок - Число - сколько строк возвращено.
//    * ЕстьЕщеДанные - Булево - в выборке была ещё одна строка за лимитом.
Функция СериализоватьВыгрузку(РезультатЗапроса, Выборка, ЛимитСтрок)

	Строки = Новый Массив;
	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	КоличествоПосчитано = 0;
	ЕстьЕщеДанные = Ложь;

	Пока Выборка.Следующий() Цикл
		Если КоличествоПосчитано >= ЛимитСтрок Тогда
			ЕстьЕщеДанные = Истина;
			Прервать;
		КонецЕсли;

		СтрокаДанных = Новый Соответствие;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаДанных.Вставить(Колонка.Имя, ЗначениеЯчейкиВыгрузки(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрокаДанных);
		КоличествоПосчитано = КоличествоПосчитано + 1;
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("Строки", Строки);
	Данные.Вставить("Колонки", Колонки);
	Данные.Вставить("КоличествоСтрок", КоличествоПосчитано);
	Данные.Вставить("ЕстьЕщеДанные", ЕстьЕщеДанные);

	Возврат Данные;

КонецФункции

// Значение ячейки для выгрузки: число, дата, булево, строка остаются собой;
// ссылка превращается в представление; прочие типы - в строку.
//
// Параметры:
//  Значение - Произвольный - значение ячейки выборки.
//
// Возвращаемое значение:
//  Произвольный - значение для табличного документа и диаграммы.
Функция ЗначениеЯчейкиВыгрузки(Значение)

	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Выполнение запроса с таймаутом через фоновое задание и отмену по превышению.
//
// Диспетчер: решает, в каком режиме выполнять запрос, и раскладывает работу
// на служебные функции ЗапуститьФоновоеЗадание и ОбработатьРезультатДлительнойОперации.
//
// Параметры:
//  ТекстЗапроса - Строка - подготовленный текст запроса.
//  Параметры - Соответствие - параметры запроса.
//  ТаймаутСекунд - Число - таймаут в секундах.
//  ЛимитСтрок - Число - нормализованный лимит строк результата.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура - результат {Строки, КоличествоСтрок, ЕстьЕщеДанные}.
//    * Ошибка - Строка,Неопределено.
Функция ВыполнитьСТаймаутом(ТекстЗапроса, Параметры, ТаймаутСекунд, ЛимитСтрок)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Если ЭтоСеансФоновогоЗадания() Тогда
		ЗаписьЖурналаРегистрации("СИ_Инструменты1С.Фон", УровеньЖурналаРегистрации.Информация,,,
			"Запрос выполняется синхронно: сеанс уже является фоновым заданием (агент работает в фоне).");
		Возврат ВыполнитьЗапросСинхронно(ТекстЗапроса, Параметры, ЛимитСтрок);
	КонецЕсли;

	Попытка
		Операция = ЗапуститьФоновоеЗадание(ТекстЗапроса, Параметры, ТаймаутСекунд, ЛимитСтрок);
		Результат = ОбработатьРезультатДлительнойОперации(Операция, ТекстЗапроса, Параметры, ТаймаутСекунд);
	Исключение
		Результат = ВыполнитьЗапросВФоне(ТекстЗапроса, Параметры, ЛимитСтрок);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Запускает фоновое задание длительной операции для выполнения запроса и ждет
// его завершения не дольше ТаймаутСекунд.
//
// Параметры:
//  ТекстЗапроса - Строка - подготовленный текст запроса.
//  Параметры - Соответствие - параметры запроса.
//  ТаймаутСекунд - Число - таймаут ожидания в секундах.
//  ЛимитСтрок - Число - нормализованный лимит строк результата.
//
// Возвращаемое значение:
//  Структура - Операция (результат ДлительныеОперации.ВыполнитьФункцию)
//    со свойствами Статус, АдресРезультата, ИдентификаторЗадания и др.
Функция ЗапуститьФоновоеЗадание(ТекстЗапроса, Параметры, ТаймаутСекунд, ЛимитСтрок)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = ТаймаутСекунд;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Запрос агента к БД";

	Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"СИ_Инструменты1С.ВыполнитьЗапросВФоне",
		ТекстЗапроса, Параметры, ЛимитСтрок);

	ИдентификаторЗадания = СИ_РаботаСJSON.БезопасноПолучить(Операция, "ИдентификаторЗадания", Неопределено);
	ДопСведения = "Статус операции: " + Строка(Операция.Статус);
	Если ИдентификаторЗадания <> Неопределено Тогда
		ДопСведения = ДопСведения + ", Идентификатор задания: " + Строка(ИдентификаторЗадания);
	КонецЕсли;
	ЗаписатьДиагностикуЗапроса("Запуск фонового задания", ТекстЗапроса, Параметры, ТаймаутСекунд, ДопСведения);

	Возврат Операция;

КонецФункции

// Разбирает статус длительной операции после ожидания и формирует результат запроса.
// При превышении таймаута принудительно отменяет задание.
//
// Параметры:
//  Операция - Структура - операция длительной операции (см. ЗапуститьФоновоеЗадание).
//  ТекстЗапроса - Строка - подготовленный текст запроса (для диагностики).
//  Параметры - Соответствие - параметры запроса (для диагностики).
//  ТаймаутСекунд - Число - таймаут в секундах (для диагностики).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево.
//    * Значение - Неопределено,Структура - результат {Строки, КоличествоСтрок, ЕстьЕщеДанные}.
//    * Ошибка - Строка,Неопределено.
Функция ОбработатьРезультатДлительнойОперации(Операция, ТекстЗапроса, Параметры, ТаймаутСекунд)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Если Операция.Статус = "Выполнено" Тогда
		РезультатФоновый = ПолучитьИзВременногоХранилища(Операция.АдресРезультата);
		Если РезультатФоновый = Неопределено Тогда
			Результат.Ошибка = "Фоновое задание вернуло пустой результат.";
		Иначе
			Результат.Успех = СИ_РаботаСJSON.БезопасноПолучить(РезультатФоновый, "Успех", Ложь);
			Результат.Значение = СИ_РаботаСJSON.БезопасноПолучить(РезультатФоновый, "Значение", Неопределено);
			Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(РезультатФоновый, "Ошибка", Неопределено);
		КонецЕсли;
		Если Результат.Успех И Результат.Значение <> Неопределено Тогда
			КоличествоСтрок = СИ_РаботаСJSON.БезопасноПолучить(Результат.Значение, "КоличествоСтрок", 0);
			ЕстьЕщеДанные = СИ_РаботаСJSON.БезопасноПолучить(Результат.Значение, "ЕстьЕщеДанные", Ложь);
			ЗаписатьДиагностикуЗапроса("Выполнено", ТекстЗапроса, Параметры, ТаймаутСекунд,
				"Строк: " + Строка(КоличествоСтрок) + ", ЕстьЕщеДанные: " + Строка(ЕстьЕщеДанные));
		КонецЕсли;

	ИначеЕсли Операция.Статус = "Отменено" Тогда
		ЗаписатьДиагностикуЗапроса("Отменено по таймауту", ТекстЗапроса, Параметры, ТаймаутСекунд,
			"", УровеньЖурналаРегистрации.Предупреждение);
		Результат.Ошибка = "Запрос отменен по таймауту (" + ТаймаутСекунд
			+ " сек). Упростите запрос: добавьте условие ГДЕ, ограничьте период, "
			+ "уменьшите число соединений или количество выбранных полей.";

	ИначеЕсли Операция.Статус = "Ошибка" Тогда
		ТекстОшибкиФона = СИ_РаботаСJSON.БезопасноПолучить(Операция, "ПодробноеПредставлениеОшибки", "см. журнал регистрации");
		Результат.Ошибка = ТекстОшибкиЗапросаПоТексту(ТекстЗапроса, ТекстОшибкиФона,
			"Ошибка выполнения запроса: " + ТекстОшибкиФона);

	Иначе
		Попытка
			ДлительныеОперации.ОтменитьВыполнениеЗадания(Операция.ИдентификаторЗадания);
		Исключение
		КонецПопытки;
		ЗаписатьДиагностикуЗапроса("Отменено по таймауту", ТекстЗапроса, Параметры, ТаймаутСекунд,
			"Задание не завершилось после ожидания.", УровеньЖурналаРегистрации.Предупреждение);
		Результат.Ошибка = "Запрос отменен по таймауту (" + ТаймаутСекунд
			+ " сек). Упростите запрос и повторите.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сериализует выборку в JSON-совместимую структуру с лимитом строк и флагом ЕстьЕщеДанные.
//
// Параметры:
//  РезультатЗапроса - РезультатЗапроса - результат запроса (нужен для колонок);
//  Выборка - ВыборкаИзРезультатаЗапроса - выборка;
//  СсылкиОбъектов - Массив - накопитель значений ячеек, не сводимых к
//    JSON-примитивам (ссылок на объекты 1С). Параметр передаётся по ссылке и
//    заполняется в ходе сериализации; вызывающий кладёт накопленное в значение
//    результата служебным ключом - см. ЗначениеСоСсылкамиОбъектов.
//  ЛимитСтрок - Число - предельное число строк результата (нормализованное
//    значение параметра ЛимитСтрок вызова инструмента).
//
// Возвращаемое значение:
//  Структура:
//    * Строки - Массив из Соответствие - строки результата.
//    * КоличествоСтрок - Число.
//    * ЕстьЕщеДанные - Булево - Истина, если в выборке осталась ещё одна строка
//        за лимитом. Директива ПЕРВЫЕ подставляется в запрос на строку больше
//        лимита (см. ВнедритьДирективы) - именно эта строка и даёт флаг.
Функция СериализоватьВыборку(РезультатЗапроса, Выборка, СсылкиОбъектов, ЛимитСтрок)

	Строки = Новый Массив;
	КоличествоПосчитано = 0;
	ЕстьЕщеДанные = Ложь;

	Пока Выборка.Следующий() Цикл
		Если КоличествоПосчитано >= ЛимитСтрок Тогда
			ЕстьЕщеДанные = Истина;
			Прервать;
		КонецЕсли;

		СтрокаДанных = Новый Соответствие;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			ЗначениеЯчейки = Выборка[Колонка.Имя];
			СтрокаДанных.Вставить(Колонка.Имя, ЗначениеДляJSON(ЗначениеЯчейки));

			Если ЭтоСсылочноеЗначение(ЗначениеЯчейки)
				И СсылкиОбъектов.Найти(ЗначениеЯчейки) = Неопределено
				И СсылкиОбъектов.Количество() < МаксимумСобираемыхСсылок() Тогда
				СсылкиОбъектов.Добавить(ЗначениеЯчейки);
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(СтрокаДанных);
		КоличествоПосчитано = КоличествоПосчитано + 1;
	КонецЦикла;

	Возврат Новый Структура("Строки, КоличествоСтрок, ЕстьЕщеДанные",
		Строки, КоличествоПосчитано, ЕстьЕщеДанные);

КонецФункции

// Добавляет в значение результата запроса служебный список ссылок на объекты 1С
// (ключ СсылкиОбъектов): реестр инструментов изымает его до сериализации
// результата для модели и строит по нему карту навигационных ссылок ответа
// (СИ_УправлениеИнструментами1С.СобратьСсылкиДокументов). Модель ссылок не видит.
//
// Параметры:
//  Данные - Структура - сериализованная выборка (см. СериализоватьВыборку);
//  СсылкиОбъектов - Массив - ссылки, собранные в ходе сериализации.
//
// Возвращаемое значение:
//  Структура - значение результата запроса (со ссылками, если они есть).
Функция ЗначениеСоСсылкамиОбъектов(Данные, СсылкиОбъектов)

	Если СсылкиОбъектов.Количество() > 0 Тогда
		Данные.Вставить("СсылкиОбъектов", СсылкиОбъектов);
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Ссылка ли это на объект метаданных (справочник, документ и подобные) - то
// есть значение, из которого вообще может получиться навигационная ссылка.
// Вид значения определяется по МЕТАДАННЫМ, как и при отборе карты ссылок
// (СИ_УправлениеИнструментами1С.ЭтоСсылочныйОбъект): для ссылок находится объект
// метаданных, а для прочих не-примитивов выборки - ХранилищеЗначения,
// УникальныйИдентификатор, ДвоичныеДанные, картинок - Неопределено, и в
// накопитель они не попадают (иначе вытеснили бы настоящие ссылки из лимита).
// Навигацию поддерживают не все виды объектов: окончательно это решает
// платформа при построении адреса (ДобавитьСсылкуВКарту).
//
// Проверка локальная, без ОбщегоНазначения.ЭтоСсылка: модуль доступен и во
// внешнем соединении, где общесистемные модули БСП недоступны.
//
// Параметры:
//  Значение - Произвольный - значение ячейки выборки.
//
// Возвращаемое значение:
//  Булево - Истина для заполненной ссылки на объект метаданных.
Функция ЭтоСсылочноеЗначение(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Неопределено") ИЛИ ТипЗначения = Тип("Null") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Метаданные.НайтиПоТипу(ТипЗначения) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(Значение);

КонецФункции

// Максимальное число ссылок, собираемых из выборки (см. СериализоватьВыборку).
//
// Возвращаемое значение:
//  Число - лимит ссылок.
Функция МаксимумСобираемыхСсылок()
	Возврат 50;
КонецФункции

// Текст подсказки о ссылках, добавляемый в результат запроса, когда среди
// выбранных полей не было ни одного ссылочного (см. ВыполнитьЗапрос).
// Формулировка условная: ссылки нужны не для каждого вопроса, и модель не должна
// добавлять ссылочные поля «на всякий случай».
//
// Возвращаемое значение:
//  Строка - текст подсказки для модели.
Функция ТекстПодсказкиОСсылкахВРезультате()

	Возврат "Подсказка: в запросе не выбрано ни одного ссылочного поля, поэтому упоминания объектов"
		+ " в ответе не станут ссылками. Если пользователю нужно открывать объект из ответа,"
		+ " перезапросите данные, добавив ссылочное поле (Ссылка таблицы источника; для документа -"
		+ " вместе с Номером и Датой) - адреса e1cib/ формировать не нужно.";

КонецФункции

// Приводит значение ячейки результата к JSON-сериализуемому виду:
// примитивы - как есть; Дата - строка; строки длиннее лимита - обрезаются.
// Ссылки и сложные типы - строковое представление. Сами ссылки при этом теряются -
// навигационные ссылки в ответе строятся по отдельному списку (см. СериализоватьВыборку).
Функция ЗначениеДляJSON(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;

	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Если СтрДлина(Значение) > МаксимальнаяДлинаСтрокиРезультата() Тогда
			Возврат Лев(Значение, МаксимальнаяДлинаСтрокиРезультата()) + "...[обрезано]";
		КонецЕсли;
		Возврат Значение;

	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'");

	Иначе
		Возврат Строка(Значение);
	КонецЕсли;

КонецФункции

// Поиск объектов метаданных по подстроке в имени/синониме с учетом черного списка.
//
// Поддерживаются три формы запроса:
//  * "Справочник", "Справочник." или "Справочники" — ВСЕ объекты класса целиком
//    (аналогично для остальных классов: Документ, Перечисление,
//    РегистрНакопления, ПланВидовХарактеристик, ЖурналДокументов);
//  * "Справочник.Польз" — подстрока имени/синонима ТОЛЬКО внутри указанного класса;
//  * "пользовател" — обычная подстрока по всем классам (прежнее поведение).
//
// Параметры:
//  СтрокаПоиска - Строка - строка поиска; пусто — краткая статистика по классам.
//
// Возвращаемое значение:
//  Массив из Строка - найденные таблицы или статистика.
Функция ПоискОбъектов(СтрокаПоиска)

	Классы = Новый Массив;
	Классы.Добавить(Новый Структура("ИмяКласса, Префикс", "Справочники", "Справочник"));
	Классы.Добавить(Новый Структура("ИмяКласса, Префикс", "Документы", "Документ"));
	Классы.Добавить(Новый Структура("ИмяКласса, Префикс", "РегистрыСведений", "РегистрСведений"));
	Классы.Добавить(Новый Структура("ИмяКласса, Префикс", "РегистрыНакопления", "РегистрНакопления"));
	Классы.Добавить(Новый Структура("ИмяКласса, Префикс", "Перечисления", "Перечисление"));
	Классы.Добавить(Новый Структура("ИмяКласса, Префикс", "ПланыВидовХарактеристик", "ПланВидовХарактеристик"));
	Классы.Добавить(Новый Структура("ИмяКласса, Префикс", "ЖурналыДокументов", "ЖурналДокументов"));

	Результат = Новый Массив;
	Поиск = ВРег(СокрЛП(СтрокаПоиска));

	Если ПустаяСтрока(Поиск) Тогда
		Для Каждого Класс Из Классы Цикл
			Количество = 0;
			Для Каждого ОбъектМД Из Метаданные[Класс.ИмяКласса] Цикл
				Если НЕ ОбъектЗапрещен(Класс.Префикс + "." + ОбъектМД.Имя) Тогда
					Количество = Количество + 1;
				КонецЕсли;
			КонецЦикла;
			Результат.Добавить(Класс.Префикс + " (доступно: " + Строка(Количество) + ")");
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	КлассПоиска = Неопределено;
	ПодстрокаИмени = "";
	ПозицияТочки = СтрНайти(Поиск, ".");
	Если ПозицияТочки > 0 Тогда
		КлассПоиска = НайтиКлассПоАлиасу(Классы, Лев(Поиск, ПозицияТочки - 1));
		Если КлассПоиска <> Неопределено Тогда
			ПодстрокаИмени = Сред(Поиск, ПозицияТочки + 1);
		Иначе
			ПодстрокаИмени = Поиск;
		КонецЕсли;
	Иначе
		КлассПоиска = НайтиКлассПоАлиасу(Классы, Поиск);
		Если КлассПоиска = Неопределено Тогда
			ПодстрокаИмени = Поиск;
		КонецЕсли;
	КонецЕсли;

	ПоискПоПодстроке = НЕ ПустаяСтрока(ПодстрокаИмени);
	СовпавшиеСНачала = Новый Массив;
	Прочие = Новый Массив;

	Для Каждого Класс Из Классы Цикл
		Если КлассПоиска <> Неопределено И КлассПоиска.ИмяКласса <> Класс.ИмяКласса Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОбъектМД Из Метаданные[Класс.ИмяКласса] Цикл
			ПолноеИмя = Класс.Префикс + "." + ОбъектМД.Имя;
			Если ОбъектЗапрещен(ПолноеИмя) Тогда
				Продолжить;
			КонецЕсли;
			ПозицияСовпадения = 0;
			Если ПоискПоПодстроке Тогда
				ПозицияСовпадения = ПозицияПодстрокиВОбъекте(ОбъектМД, ПодстрокаИмени);
				Если ПозицияСовпадения = 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ОписаниеОбъекта = ПолноеИмя + " (" + Строка(ОбъектМД.Синоним) + ")";
			Если ПозицияСовпадения = 1 Тогда
				СовпавшиеСНачала.Добавить(ОписаниеОбъекта);
			Иначе
				Прочие.Добавить(ОписаниеОбъекта);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ВсегоНайдено = СовпавшиеСНачала.Количество() + Прочие.Количество();

	Если ВсегоНайдено = 0 Тогда
		Результат.Добавить("Подсказка: ничего не найдено. Попробуйте короче: одно-два ключевых слова "
			+ "из имени или синонима («пользовател», «номенклатур») либо поиск внутри класса "
			+ "(например 'Справочник.Польз').");
		Возврат Результат;
	КонецЕсли;

	ПорогКандидатов = ПорогКандидатовПоиска();
	Если НЕ ПоискПоПодстроке Тогда
		Для Каждого ОписаниеОбъекта Из СовпавшиеСНачала Цикл
			Результат.Добавить(ОписаниеОбъекта);
		КонецЦикла;
		Для Каждого ОписаниеОбъекта Из Прочие Цикл
			Результат.Добавить(ОписаниеОбъекта);
		КонецЦикла;
		Если ВсегоНайдено > ПорогКандидатов Тогда
			Результат.Добавить("Подсказка: объектов в классе много (" + Строка(ВсегоНайдено)
				+ "). Чтобы сузить список, передайте подстроку имени: 'Справочник.Польз'.");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	ЧастиСписка = Новый Массив;
	ЧастиСписка.Добавить(СовпавшиеСНачала);
	ЧастиСписка.Добавить(Прочие);
	Для Каждого ЧастьСписка Из ЧастиСписка Цикл
		Для Каждого ОписаниеОбъекта Из ЧастьСписка Цикл
			Если Результат.Количество() >= ПорогКандидатов Тогда
				Прервать;
			КонецЕсли;
			Результат.Добавить(ОписаниеОбъекта);
		КонецЦикла;
		Если Результат.Количество() >= ПорогКандидатов Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ВсегоНайдено > ПорогКандидатов Тогда
		Результат.Добавить("Подсказка: подходит объектов: " + Строка(ВсегоНайдено) + ", показаны первые "
			+ Строка(ПорогКандидатов) + ". Уточните: точное имя таблицы ('Справочник.Пользователи') "
			+ "или более узкая подстрока/класс.");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Определяет класс метаданных по текстовому имени (алиасу) без учета регистра,
// пробелов и числа: "Справочник", "Справочники", "РегистрНакопления",
// "Регистры накопления", "ПланВидовХарактеристик" и т.п.
//
// Параметры:
//  Классы - Массив из Структура - список классов {ИмяКласса, Префикс}.
//  Текст - Строка - проверяемый фрагмент запроса (до точки или целиком).
//
// Возвращаемое значение:
//  Структура,Неопределено - описание класса из Классы или Неопределено.
Функция НайтиКлассПоАлиасу(Классы, Текст)

	Нормализованный = ВРег(СтрЗаменить(СокрЛП(Текст), " ", ""));
	Если ПустаяСтрока(Нормализованный) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Класс Из Классы Цикл
		Если Нормализованный = ВРег(Класс.Префикс)
			ИЛИ Нормализованный = ВРег(Класс.ИмяКласса) Тогда
			Возврат Класс;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Детальная схема одного объекта метаданных: поля и типы.
//
// Параметры:
//  ИмяТаблицы - Строка - точное полное имя объекта (например "Справочник.Пользователи").
//
// Возвращаемое значение:
//  Структура,Неопределено:
//    * Таблица - Строка,Неопределено - имя таблицы.
//    * Синоним - Строка,Неопределено.
//    * Поля - Массив из Структура - {Имя, Тип, Синоним}.
Функция ДетальнаяСхемаОбъекта(ИмяТаблицы)

	Если ОбъектЗапрещен(ИмяТаблицы) Тогда
		ВызватьИсключение "Объект '" + ИмяТаблицы + "' недоступен для запросов.";
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	Если ОбъектМД = Неопределено Тогда
		ВызватьИсключение "Объект '" + ИмяТаблицы
			+ "' не найден в метаданных. Найдите точное имя через поиск по подстроке.";
	КонецЕсли;

	Поля = Новый Массив;

	Попытка
		ДобавитьПоляИзКоллекции(Поля, ОбъектМД.СтандартныеРеквизиты);
	Исключение
	КонецПопытки;

	Попытка
		ДобавитьПоляИзКоллекции(Поля, ОбъектМД.Реквизиты);
	Исключение
	КонецПопытки;

	Попытка
		Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
			Поля.Добавить(ОписаниеПоля(ТабличнаяЧасть));
			ДобавитьПоляИзКоллекции(Поля, ТабличнаяЧасть.Реквизиты);
		КонецЦикла;
	Исключение
	КонецПопытки;

	Попытка
		ДобавитьПоляИзКоллекции(Поля, ОбъектМД.Измерения);
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьПоляИзКоллекции(Поля, ОбъектМД.Ресурсы);
	Исключение
	КонецПопытки;

	Попытка
		ДобавитьПоляИзКоллекции(Поля, ОбъектМД.ЗначенияПеречисления);
	Исключение
	КонецПопытки;

	Попытка
		ДобавитьПоляИзКоллекции(Поля, ОбъектМД.Графы);
	Исключение
	КонецПопытки;

	Возврат Новый Структура("Таблица, Синоним, Поля",
		ИмяТаблицы, Строка(ОбъектМД.Синоним), Поля);

КонецФункции

// Добавляет описания полей коллекции метаданных в массив.
Процедура ДобавитьПоляИзКоллекции(Поля, Коллекция)

	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ПолеМД Из Коллекция Цикл
		Поля.Добавить(ОписаниеПоля(ПолеМД));
	КонецЦикла;

КонецПроцедуры

// Формирует описание поля метаданных: Имя, Тип, Синоним.
Функция ОписаниеПоля(ПолеМД)

	Описание = Новый Структура;
	Описание.Вставить("Имя", ПолеМД.Имя);

	Попытка
		Описание.Вставить("Тип", Строка(ПолеМД.Тип));
	Исключение
		Описание.Вставить("Тип", "");
	КонецПопытки;

	Попытка
		Описание.Вставить("Синоним", Строка(ПолеМД.Синоним));
	Исключение
	КонецПопытки;

	Возврат Описание;

КонецФункции

#КонецОбласти

#Область ИнструментыДиагностики

// Находит последние записи журнала в периоде отбора. Вместо постраничного
// листания используется бисекция по времени: ищется самый ранний момент, начиная
// с которого в окне [момент, конец периода] помещается не больше лимита записей.
// Так число запросов зависит от длины периода, а не от плотности журнала.
//
// Параметры:
//  Отбор - Структура - отбор журнала с заполненными ДатаНачала и ДатаОкончания.
//  Лимит - Число - сколько последних записей нужно.
//
// Возвращаемое значение:
//  Структура:
//    * Таблица - ТаблицаЗначений - записи журнала, не больше лимита.
//    * НачалоВыборки - Дата - фактическое начало окна выборки: записи периода
//      раньше него отброшены.
//    * Усечено - Булево - Истина, если часть записей периода отброшена (лимит
//      или ограниченная точность бисекции): событий в периоде больше, чем
//      возвращено (модель получает об этом примечание).
Функция НайтиПоследниеЗаписи(Отбор, Лимит)

	Результат = Новый Структура;
	Результат.Вставить("Таблица", Новый ТаблицаЗначений);
	Результат.Вставить("НачалоВыборки", Отбор.ДатаОкончания);
	Результат.Вставить("Усечено", Ложь);

	НачалоПериода = Отбор.ДатаНачала;
	КонецПериода = Отбор.ДатаОкончания;
	Если НачалоПериода = Неопределено ИЛИ КонецПериода = Неопределено Тогда
		ВызватьИсключение "Не заданы границы периода выборки журнала.";
	КонецЕсли;

	НижняяГраница = НачалоПериода;
	ВерхняяГраница = КонецПериода;

	// Полная бисекция до секунды требует log2(длины периода в секундах) выгрузок
	// журнала (для суток ~17), каждая - под привилегированным режимом. Ограничиваем
	// 8 итерациями (точность - доли минуты для суток): усечённый результат не
	// уточняем ценой лишних выгрузок, а помечаем флагом Усечено.
	МаксимальноИтераций = 8;
	НомерИтерации = 0;
	Пока (ВерхняяГраница - НижняяГраница) > 1 И НомерИтерации < МаксимальноИтераций Цикл
		НомерИтерации = НомерИтерации + 1;
		Середина = НижняяГраница + Цел((ВерхняяГраница - НижняяГраница) / 2);
		Если КоличествоЗаписейВОкне(Отбор, Середина, КонецПериода, Лимит) <= Лимит Тогда
			ВерхняяГраница = Середина;
		Иначе
			НижняяГраница = Середина;
		КонецЕсли;
	КонецЦикла;

	// Бисекция сдвигает начало окна правее начала периода - все записи до
	// найденной границы отброшены; это усечение независимо от лимита.
	Если ВерхняяГраница > НачалоПериода Тогда
		Результат.Усечено = Истина;
	КонецЕсли;
	Результат.НачалоВыборки = ВерхняяГраница;

	Таблица = ВыгрузитьОкно(Отбор, ВерхняяГраница, КонецПериода, Лимит + 1);
	Если Таблица.Количество() > Лимит Тогда
		Результат.Усечено = Истина;
	КонецЕсли;
	Пока Таблица.Количество() > Лимит Цикл
		Таблица.Удалить(0);
	КонецЦикла;

	Результат.Таблица = Таблица;
	Возврат Результат;

КонецФункции

// Количество записей в окне, но не больше Лимит + 1: большее число для бисекции
// не нужно, а полная выгрузка плотного журнала была бы дорогой.
//
// Параметры:
//  Отбор - Структура - исходный отбор журнала.
//  Начало - Дата - начало окна.
//  Конец - Дата - конец окна.
//  Лимит - Число - предел сравнения.
//
// Возвращаемое значение:
//  Число - количество записей в окне, ограниченное Лимит + 1.
Функция КоличествоЗаписейВОкне(Отбор, Начало, Конец, Лимит)

	Возврат ВыгрузитьОкно(Отбор, Начало, Конец, Лимит + 1).Количество();

КонецФункции

// Выгружает окно журнала с ограничением количества записей.
//
// Параметры:
//  Отбор - Структура - исходный отбор журнала.
//  Начало - Дата - начало окна.
//  Конец - Дата - конец окна.
//  Количество - Число - максимум записей.
//
// Возвращаемое значение:
//  ТаблицаЗначений - записи журнала.
Функция ВыгрузитьОкно(Отбор, Начало, Конец, Количество)

	ОтборОкна = Новый Структура;
	Для Каждого Пара Из Отбор Цикл
		ОтборОкна.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	ОтборОкна.Вставить("ДатаНачала", Начало);
	ОтборОкна.Вставить("ДатаОкончания", Конец);

	Таблица = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Таблица, ОтборОкна, , , Количество);
	Возврат Таблица;

КонецФункции

// Преобразует записи журнала в структуры для модели. Набор полей задаётся
// соответствием «поле результата -> колонка журнала», чтобы не дублировать
// одинаковые Вставить для каждой колонки.
//
// Параметры:
//  Таблица - ТаблицаЗначений - записи журнала.
//
// Возвращаемое значение:
//  Массив из Соответствие - события для модели.
Функция ПреобразоватьСобытияЖурнала(Таблица)

	ИменаКолонок = Новый Соответствие;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ИменаКолонок.Вставить(Колонка.Имя, Истина);
	КонецЦикла;

	ПоляСобытия = Новый Соответствие;
	ПоляСобытия.Вставить("Уровень", "Уровень");
	ПоляСобытия.Вставить("Событие", "Событие");
	ПоляСобытия.Вставить("Метаданные", "ПредставлениеМетаданных");
	ПоляСобытия.Вставить("Данные", "ПредставлениеДанных");
	ПоляСобытия.Вставить("Комментарий", "Комментарий");

	События = Новый Массив;
	Для Каждого СтрокаЖурнала Из Таблица Цикл
		Если ЭтоСлужебноеСобытие(СтрокаЖурнала, ИменаКолонок) Тогда
			Продолжить;
		КонецЕсли;

		Событие = Новый Соответствие;
		Для Каждого Поле Из ПоляСобытия Цикл
			ЗначениеПоля = ЗначениеКолонкиСобытия(СтрокаЖурнала, ИменаКолонок, Поле.Значение);
			Если Поле.Ключ = "Комментарий" Тогда
				ЗначениеПоля = Лев(ЗначениеПоля, МаксимальнаяДлинаКомментария());
			КонецЕсли;
			Событие.Вставить(Поле.Ключ, ЗначениеПоля);
		КонецЦикла;

		ДатаСобытия = ЗначениеКолонкиСобытия(СтрокаЖурнала, ИменаКолонок, "Дата");
		Если НЕ ПустаяСтрока(ДатаСобытия) Тогда
			Событие.Вставить("Дата", Формат(СтрокаЖурнала.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'"));
		КонецЕсли;

		События.Добавить(Событие);
		Если События.Количество() > МаксимумСобытий() Тогда
			События.Удалить(0);
		КонецЕсли;
	КонецЦикла;

	Возврат События;

КонецФункции

// Признак технического события самого агента: такие события пользователю не
// показываются. Проверяется список префиксов имени события.
//
// Параметры:
//  СтрокаЖурнала - СтрокаТаблицыЗначений - запись журнала регистрации.
//  ИменаКолонок - Соответствие - имена колонок таблицы журнала.
//
// Возвращаемое значение:
//  Булево - Истина, если событие служебное.
Функция ЭтоСлужебноеСобытие(СтрокаЖурнала, ИменаКолонок)

	ИмяСобытия = ЗначениеКолонкиСобытия(СтрокаЖурнала, ИменаКолонок, "Событие");
	Если ПустаяСтрока(ИмяСобытия) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНачинаетсяС(ИмяСобытия, "Агент1С")
		ИЛИ СтрНачинаетсяС(ИмяСобытия, "СИ_")
		ИЛИ СтрНачинаетсяС(ИмяСобытия, "ЧатHTML");

КонецФункции

// Значение колонки журнала регистрации по имени.
//
// Параметры:
//  СтрокаЖурнала - СтрокаТаблицыЗначений - запись журнала регистрации.
//  ИменаКолонок - Соответствие - имена колонок таблицы журнала.
//  ИмяКолонки - Строка - имя колонки.
//
// Возвращаемое значение:
//  Строка - значение колонки; пустая строка, если колонки в таблице нет.
Функция ЗначениеКолонкиСобытия(СтрокаЖурнала, ИменаКолонок, ИмяКолонки)

	Если ИменаКолонок.Получить(ИмяКолонки) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = СтрокаЖурнала[ИмяКолонки];
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Уровни событий из аргументов вызова: массив строк «Ошибка», «Предупреждение»,
// «Информация», «Примечание». Пустой или непонятный список - уровни по умолчанию
// (Ошибка и Предупреждение).
//
// Параметры:
//  Аргументы - Структура, Соответствие - аргументы вызова инструмента.
//
// Возвращаемое значение:
//  Массив из УровеньЖурналаРегистрации - уровни для отбора журнала.
Функция УровниСобытийИзАргументов(Аргументы)

	УровниПоУмолчанию = Новый Массив;
	УровниПоУмолчанию.Добавить(УровеньЖурналаРегистрации.Ошибка);
	УровниПоУмолчанию.Добавить(УровеньЖурналаРегистрации.Предупреждение);

	УровниАргумент = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Уровни", Неопределено);
	Если ТипЗнч(УровниАргумент) <> Тип("Массив") ИЛИ УровниАргумент.Количество() = 0 Тогда
		Возврат УровниПоУмолчанию;
	КонецЕсли;

	Уровни = Новый Массив;
	Для Каждого УровеньСтрокой Из УровниАргумент Цикл
		ИмяУровня = НРег(СокрЛП(Строка(УровеньСтрокой)));
		Если ИмяУровня = "ошибка" Тогда
			Уровни.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ИначеЕсли ИмяУровня = "предупреждение" Тогда
			Уровни.Добавить(УровеньЖурналаРегистрации.Предупреждение);
		ИначеЕсли ИмяУровня = "информация" Тогда
			Уровни.Добавить(УровеньЖурналаРегистрации.Информация);
		ИначеЕсли ИмяУровня = "примечание" Тогда
			Уровни.Добавить(УровеньЖурналаРегистрации.Примечание);
		КонецЕсли;
	КонецЦикла;

	Если Уровни.Количество() = 0 Тогда
		Возврат УровниПоУмолчанию;
	КонецЕсли;
	Возврат Уровни;

КонецФункции

