#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	КэшПревьюИзображений = Новый Соответствие;
	СсылкиДокументовПоНомерам = Новый Соответствие;
	ДиаграммыПоНомерам = Новый Соответствие;
	ИнструментыПервогоШагаЗахода = Неопределено;
	ТекущийПользователь = Пользователи.ТекущийПользователь();

	НастройкиКлиента = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(
		"Общее/НастройкиКлиентскогоПриложения", "", Новый НастройкиКлиентскогоПриложения);
	
		ЭтоИнтерфейс85 = НастройкиКлиента.ВариантИнтерфейсаКлиентскогоПриложения
		= ВариантИнтерфейсаКлиентскогоПриложения.Версия8_5;

	ТемнаяТема = ЭтоИнтерфейс85
		И (ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("СИ_ЧатАгента", "ТемнаяТема", Ложь) = Истина);
	
	Элементы.ФлажокТемнаяТема.Видимость = ЭтоИнтерфейс85;
	ЭлементОтбора = СписокЧатов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Пользователь");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ТекущийПользователь;
	
	
	Элементы.ФормаОткрытьНастройки.Видимость = ПравоДоступа("Изменение", Метаданные.Справочники.СИ_ПрофилиПодключений);
	
	ИнициализироватьФорму();
	СоздатьНовыйДиалогНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(ЗаходИдДиалога) И ЗаходИдДиалога = АктивныйДиалог
		И Не ПустаяСтрока(ИдентификаторФоновогоЗадания) Тогда
		ОтменитьФоновоеЗаданиеПриЗакрытии();
	КонецЕсли;
	Если СостоянияЗаходов <> Неопределено Тогда
		Для Каждого КлючИЗначение Из СостоянияЗаходов Цикл
			ОтключитьЖивойКанал(КлючИЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ТекстИсторииДокументСформирован(Элемент)

	ИнициализироватьJSМост(Элемент);

	ПрокрутитьВнизНепосредственно();

КонецПроцедуры

// Обработчик клика по ссылкам в HTML-документе истории чата.
// Перехватывает ссылки вида copy:<номер сообщения>, которые встраиваются
// в пузырь ответа модели (иконка «Копировать»), и копирует ответ
// в системный буфер обмена без рассуждений (reasoning).
// Обычные ссылки (http/https) не перехватываем — их открывает платформа.
&НаКлиенте
Процедура ТекстИсторииНажатиеНаСсылке(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если ДанныеСобытия = Неопределено Тогда
		Возврат;
	КонецЕсли;

	URL = "";
	Попытка
		URL = ДанныеСобытия.Href;
	Исключение
		URL = "";
	КонецПопытки;
	Если URL = Неопределено Тогда
		URL = "";
	КонецЕсли;

	ПозицияМаркера = СтрНайти(URL, "copy:");
	Если ПозицияМаркера > 0 Тогда
		СтандартнаяОбработка = Ложь;
		НомерСообщения = 0;
		Попытка
			НомерСообщения = Число(Сред(URL, ПозицияМаркера + 5));
		Исключение
			НомерСообщения = 0;
		КонецПопытки;
		Если НомерСообщения > 0 Тогда
			СкопироватьОтветПоНомеру(НомерСообщения);
		КонецЕсли;
	КонецЕсли;

	ПозицияМаркераПросмотра = СтрНайти(URL, "view:");
	Если ПозицияМаркераПросмотра > 0 Тогда
		СтандартнаяОбработка = Ложь;
		УИДПросмотра = СокрЛП(Сред(URL, ПозицияМаркераПросмотра + 5));
		Если СтрНачинаетсяС(УИДПросмотра, "//") Тогда
			УИДПросмотра = Сред(УИДПросмотра, 3);
		КонецЕсли;
		Если НЕ ПустаяСтрока(УИДПросмотра) Тогда
			ОткрытьФайлДляПросмотраПоУИД(УИДПросмотра);
		КонецЕсли;
	КонецЕсли;

	ПозицияМаркераФайла = СтрНайти(URL, "file:");
	Если ПозицияМаркераФайла > 0 Тогда
		СтандартнаяОбработка = Ложь;
		УИДФайла = СокрЛП(Сред(URL, ПозицияМаркераФайла + 5));
		Если СтрНачинаетсяС(УИДФайла, "//") Тогда
			УИДФайла = Сред(УИДФайла, 3);
		КонецЕсли;
		Если НЕ ПустаяСтрока(УИДФайла) Тогда
			ОткрытьФайлДиалогаПоУИД(УИДФайла);
		КонецЕсли;
	КонецЕсли;

	ПозицияМаркераТаблицы = СтрНайти(URL, "totable:");
	Если ПозицияМаркераТаблицы > 0 Тогда
		СтандартнаяОбработка = Ложь;
		НомерСообщенияТаблицыТекст = СокрЛП(Сред(URL, ПозицияМаркераТаблицы + 8));
		Если СтрНачинаетсяС(НомерСообщенияТаблицыТекст, "//") Тогда
			НомерСообщенияТаблицыТекст = Сред(НомерСообщенияТаблицыТекст, 3);
		КонецЕсли;
		НомерСообщенияТаблицы = 0;
		Попытка
			НомерСообщенияТаблицы = Число(НомерСообщенияТаблицыТекст);
		Исключение
			НомерСообщенияТаблицы = 0;
		КонецПопытки;
		Если НомерСообщенияТаблицы > 0 Тогда
			ОткрытьТаблицуОтветаПоНомеру(НомерСообщенияТаблицы);
		КонецЕсли;
	КонецЕсли;

	ПозицияМаркераВыбора = СтрНайти(URL, "choose:");
	Если ПозицияМаркераВыбора > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ХвостВыбора = СокрЛП(Сред(URL, ПозицияМаркераВыбора + 7));
		Если СтрНачинаетсяС(ХвостВыбора, "//") Тогда
			ХвостВыбора = Сред(ХвостВыбора, 3);
		КонецЕсли;
		Разделитель = СтрНайти(ХвостВыбора, ":");
		НомерСообщенияВыбора = 0;
		ИндексВарианта = -1;
		Попытка
			Если Разделитель > 0 Тогда
				НомерСообщенияВыбора = Число(Лев(ХвостВыбора, Разделитель - 1));
				ИндексВарианта = Число(Сред(ХвостВыбора, Разделитель + 1));
			КонецЕсли;
		Исключение
			НомерСообщенияВыбора = 0;
			ИндексВарианта = -1;
		КонецПопытки;
		Если НомерСообщенияВыбора > 0 И ИндексВарианта >= 0 Тогда
			ВыбратьВариантОтвета(НомерСообщенияВыбора, ИндексВарианта);
		КонецЕсли;
	КонецЕсли;

	ПозицияМаркераРазрешения = СтрНайти(URL, "perm:");
	Если ПозицияМаркераРазрешения > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ХвостРазрешения = СокрЛП(Сред(URL, ПозицияМаркераРазрешения + 5));
		Если СтрНачинаетсяС(ХвостРазрешения, "//") Тогда
			ХвостРазрешения = Сред(ХвостРазрешения, 3);
		КонецЕсли;
		РазделительРазрешения = СтрНайти(ХвостРазрешения, ":");
		Если РазделительРазрешения > 0 Тогда
			ДействиеРазрешения = Лев(ХвостРазрешения, РазделительРазрешения - 1);
			ИдВызоваРазрешения = Сред(ХвостРазрешения, РазделительРазрешения + 1);
			Если НЕ ПустаяСтрока(ДействиеРазрешения) Тогда
				ОтветитьНаЗапросРазрешения(ДействиеРазрешения, ИдВызоваРазрешения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ПозицияМаркераОбъекта = СтрНайти(URL, "e1cib/");
	Если ПозицияМаркераОбъекта > 0 Тогда
		СтандартнаяОбработка = Ложь;
		АдресОбъекта = Сред(URL, ПозицияМаркераОбъекта);

		Если ЭтоСсылкаНаДиалог(АдресОбъекта) Тогда
			ОткрытьДиалогПоНавигационнойСсылке(АдресОбъекта);
		Иначе
			ОткрытьОбъектПоНавигационнойСсылке(АдресОбъекта);
		КонецЕсли;
	КонецЕсли;

	ПозицияМаркераПодсказки = СтрНайти(URL, "hint:");
	Если ПозицияМаркераПодсказки > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ХвостПодсказки = СокрЛП(Сред(URL, ПозицияМаркераПодсказки + 5));
		Если СтрНачинаетсяС(ХвостПодсказки, "//") Тогда
			ХвостПодсказки = Сред(ХвостПодсказки, 3);
		КонецЕсли;
		ИндексПодсказки = -1;
		Попытка
			ИндексПодсказки = Число(ХвостПодсказки) - 1;
		Исключение
			ИндексПодсказки = -1;
		КонецПопытки;
		Если ИндексПодсказки >= 0 Тогда
			ОтправитьПодсказкуСтартовогоЭкрана(ИндексПодсказки);
		Иначе
			ЗарегистрироватьНеразобраннуюСсылкуПодсказки(URL);
		КонецЕсли;
	КонецЕсли;

	ПозицияРоли = СтрНайти(URL, "role:");
	Если ПозицияРоли > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ХвостРоли = СокрЛП(Сред(URL, ПозицияРоли + 5));
		Если СтрНачинаетсяС(ХвостРоли, "//") Тогда
			ХвостРоли = Сред(ХвостРоли, 3);
		КонецЕсли;
		ПозицияРазделителя = СтрНайти(ХвостРоли, "?");
		Если ПозицияРазделителя > 0 Тогда
			ХвостРоли = Лев(ХвостРоли, ПозицияРазделителя - 1);
		КонецЕсли;
		Если НЕ ПустаяСтрока(ХвостРоли) Тогда
			ОтправитьОбзорПоРоли(НРег(ХвостРоли));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Обработчик изменения режима работы в форме чата.
// Подхватывает модель и профиль подключения из выбранного режима.
&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)

	ПрименитьДанныеРежимаНаСервере();

	Если ИсторияСообщений.Количество() = 0 Тогда
		ОбновитьТекстИстории();
	КонецЕсли;

КонецПроцедуры

// Обработчик переключения темы оформления области чата.
// Настройка сохраняется персонально для пользователя и применяется на месте -
// документ чата при этом не пересоздаётся (см. ПрименитьТемуОформления).
&НаКлиенте
Процедура ФлажокТемнаяТемаПриИзменении(Элемент)

	ОбщегоНазначенияКлиент.ХранилищеОбщихНастроекСохранить("СИ_ЧатАгента", "ТемнаяТема", ТемнаяТема);

	ПрименитьТемуОформления();

КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокЧатов

&НаКлиенте
Процедура СписокЧатовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрокаСписка = Элементы.СписокЧатов.ТекущаяСтрока;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрокаСписка) Тогда
		
		Возврат;
		
	КонецЕсли;
		
	СтандартнаяОбработка = Ложь;
		
	Если ЗначениеЗаполнено(ВыбраннаяСтрока) Тогда

		ОткрытьДиалогПоСсылке(ВыбраннаяСтрока);

	Иначе
		ОтсоединитьЗаход();

		ИсторияСообщений.Очистить();
		ТекстИстории = ПолучитьПустойДиалогНаСервере();
		ПоследнийПоказанныйНомерСообщения = 0;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОтправить(Команда)
		
	Если ПустаяСтрока(ТекстВвода) Тогда
		ПоказатьПредупреждение(, "Введите текст сообщения");
		Возврат;
	КонецЕсли;

	Элементы.КомандаОтправить.Доступность = Ложь;
	Элементы.ПолеВвода.Доступность = Ложь;
	Элементы.КомандаПрикрепитьФайл.Доступность = Ложь;
	Элементы.КомандаСжать.Доступность = Ложь;

	Если НЕ ПустаяСтрока(ИдентификаторФоновогоЗадания)
		И ЗначениеЗаполнено(ЗаходИдДиалога) И ЗаходИдДиалога = АктивныйДиалог Тогда
		Элементы.КомандаОтправить.Доступность = Истина;
		Элементы.ПолеВвода.Доступность = Истина;
		Элементы.КомандаПрикрепитьФайл.Доступность = Истина;
		ПоказатьПредупреждение(, "Дождитесь завершения текущего запроса");
		Возврат;
	КонецЕсли;

	ОтправитьСообщениеАгенту();
		
КонецПроцедуры

// Прерывает ожидание ответа модели: отменяет фоновое задание и возвращает форму
// в состояние «готов к работе». Доступна только пока фоновое задание активно.
&НаКлиенте
Процедура КомандаПрерватьДиалог(Команда)

	Если ПустаяСтрока(ИдентификаторФоновогоЗадания) Тогда
		Возврат;
	КонецЕсли;

	Элементы.КомандаПрерватьДиалог.Доступность = Ложь;

	Попытка
		ОтменитьФоновоеЗаданиеНаСервере();
		ПрерватьОжиданиеНаСервере();
	Исключение
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Ошибка при прерывании диалога: " + ОписаниеОшибки();
		СообщениеПользователю.Сообщить();
	КонецПопытки;

	ТаймерАктивен = Ложь;
	Элементы.КомандаОтправить.Доступность = Истина;
	Элементы.ПолеВвода.Доступность = Истина;
	Элементы.КомандаПрикрепитьФайл.Доступность = Истина;
	Элементы.КомандаСжать.Доступность = Истина;

КонецПроцедуры

// Принудительное сжатие истории диалога (кнопка «Сжать»).
// Игнорирует ПроцентОкнаДляИстории — сжимает до полного контекстного окна модели.
&НаКлиенте
Процедура КомандаСжать(Команда)

	Если Не ЗначениеЗаполнено(АктивныйДиалог) Тогда
		Возврат;
	КонецЕсли;

	Если ТаймерАктивен Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Дождитесь завершения текущего ответа агента перед сжатием истории.";
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;

	РезультатСжатия = СжатьИсториюНаСервере();
	Если РезультатСжатия.Успех Тогда
		СтатусАгента = РезультатСжатия.Сообщение;
		ПрокрутитьВнизНепосредственно();
	Иначе
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = РезультатСжатия.Сообщение;
		СообщениеПользователю.Сообщить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаНовыйДиалог(Команда)
	ОтсоединитьЗаход();
	СоздатьНовыйДиалог();
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчистить(Команда)

	ПрокрутитьВнизНепосредственно();

КонецПроцедуры

&НаКлиенте
АСИНХ Процедура КомандаУдалитьЧат(Команда)

ТекСтрока = Элементы.СписокЧатов.ТекущаяСтрока;

Если ТекСтрока = Неопределено Тогда
	ПоказатьПредупреждение(, "Выберите чат для удаления");
	Возврат;
КонецЕсли;

Если НЕ ЗначениеЗаполнено(ТекСтрока) Тогда
	Возврат;
КонецЕсли;

Если ТипЗнч(ТекСтрока) = Тип("СправочникСсылка.СИ_ДиалогиАгента") Тогда
	
	Ответ = ЖДАТЬ ВопросАсинх(
		СтрШаблон(НСтр("ru='Удалить чат %1'"),
		Элементы.СписокЧатов.ТекущиеДанные.Наименование),
		РежимДиалогаВопрос.ДаНетОтмена, , , , );
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		УдалитьЧатНаСервере(ТекСтрока);
		
		Элементы.СписокЧатов.Обновить();
		
		АктивныйДиалог = Неопределено;
		ИсторияСообщений.Очистить();
		ТекстИстории = ПолучитьПустойДиалогНаСервере();
		
	КонецЕсли;
	
Иначе
	
	ДанныеГруппы = Элементы.СписокЧатов.ТекущиеДанные;
	ДатаГруппы = Неопределено;
	ДанныеГруппы.Свойство("ДатаНачала", ДатаГруппы);
	
	Если Не ЗначениеЗаполнено(ДатаГруппы) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Нельзя удалить группировку: не удалось определить её дату. Выберите группировку по дате или конкретный диалог.'"));
		Возврат;
	КонецЕсли;
	
	Ответ = ЖДАТЬ ВопросАсинх(
		СтрШаблон(НСтр("ru='Удалить все диалоги за %1 (вместе с вложенными в группировку)?'"),
		Формат(ДатаГруппы, "ДЛФ=D")),
		РежимДиалогаВопрос.ДаНетОтмена, , , , );
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		УдалитьДиалогиПоДатеНаСервере(ДатаГруппы);
		
		Элементы.СписокЧатов.Обновить();
		
		АктивныйДиалог = Неопределено;
		ИсторияСообщений.Очистить();
		ТекстИстории = ПолучитьПустойДиалогНаСервере();
		
	КонецЕсли;
	
КонецЕсли;

КонецПроцедуры

// Отображает последний ответ ассистента для копирования.
// (Прямая запись в системный буфер обмена в управляемых клиентах 1С
// платформенными средствами не поддерживается, поэтому показываем текст.)
&НаКлиенте
Процедура КомандаКопироватьОтвет(Команда)
	
	ТекстДляКопирования = "";
	Инд = ИсторияСообщений.Количество() - 1;
	Пока Инд >= 0 Цикл
		Если ИсторияСообщений[Инд].Роль = "assistant" Тогда
			КонтентДляКопирования = ИсторияСообщений[Инд].Контент;
			Если КонтентДляКопирования = Неопределено Тогда
				КонтентДляКопирования = "";
			КонецЕсли;
			Если НЕ ПустаяСтрока(КонтентДляКопирования) Тогда
				ТекстДляКопирования = КонтентДляКопирования;
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Инд = Инд - 1;
	КонецЦикла;
	
	Если ПустаяСтрока(ТекстДляКопирования) Тогда
		Если ИсторияСообщений.Количество() = 0 Тогда
			ПоказатьПредупреждение(, "В этом чате ещё нет ответов ассистента для копирования.");
		ИначеЕсли ПоказыватьИндикаторПечати Тогда
			ПоказатьПредупреждение(, "Ответ ещё не готов — дождитесь завершения ответа ассистента, затем повторите.");
		Иначе
			ПоказатьПредупреждение(, "Ответ ассистента пустой — копировать нечего.");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ПослеВводаТекстаКопирования", ЭтотОбъект),
		ТекстДляКопирования, "Текст ответа (скопируйте его)", 25);
	
КонецПроцедуры

&НаКлиенте
АСИНХ Процедура КомандаПрикрепитьФайл(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файлы для анализа";
	Диалог.Фильтр = "Все файлы (*.*)|*.*|Текстовые файлы (*.txt;*.log;*.csv;*.json;*.xml;*.md)|*.txt;*.log;*.csv;*.json;*.xml;*.md|Изображения (*.jpg;*.jpeg;*.png;*.gif;*.bmp;*.webp)|*.jpg;*.jpeg;*.png;*.gif;*.bmp;*.webp|PDF (*.pdf)|*.pdf";
	Диалог.МножественныйВыбор = Истина;
	
	РезультатВыбора = ЖДАТЬ Диалог.ВыбратьАсинх();
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивФайлов = Диалог.ВыбранныеФайлы;
	Если МассивФайлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ПрикрепленныеВложения = Неопределено Тогда
		ПрикрепленныеВложения = Новый Массив;
	КонецЕсли;
	
	ПрикрепленоФайлов = 0;
	Для Каждого ПолноеИмяФайла Из МассивФайлов Цикл
		
		ОписаниеФайла = ЖДАТЬ ПоместитьФайлНаСерверАсинх(, , , ПолноеИмяФайла, УникальныйИдентификатор);
		АдресФайла = ОписаниеФайла.Адрес;
		
		ИнфоОФайле = Новый Файл(ПолноеИмяФайла);
		ИмяФайлаКороткое = ИнфоОФайле.Имя;
		
		Успех = ЖДАТЬ ПрочитатьФайлНаСервереАсинх(АдресФайла, ИмяФайлаКороткое);
		Если Успех Тогда
			ПрикрепленоФайлов = ПрикрепленоФайлов + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПрикрепленоФайлов > 0 И ПрикрепленныеВложения.Количество() > 0 Тогда
		СписокИмён = "";
		Для Каждого Вложение Из ПрикрепленныеВложения Цикл
			СписокИмён = ?(ПустаяСтрока(СписокИмён), Вложение.ИмяФайла, СписокИмён + ", " + Вложение.ИмяФайла);
		КонецЦикла;
		СтатусАгента = "Прикреплены файлы (" + ПрикрепленныеВложения.Количество() + "): "
			+ СписокИмён + ". Нажмите «Отправить».";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
АСИНХ Процедура ПереименоватьДиалог(Команда)
	
	ТекущаяСтрокаСписка = Элементы.СписокЧатов.ТекущаяСтрока;
	ТекущиеДанные = Элементы.СписокЧатов.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрокаСписка) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Наименование = ЖДАТЬ ВвестиСтрокуАсинх(ТекущиеДанные.Наименование, "Введите новое наименование диалога", 255);
	
	Если Наименование = Неопределено ИЛИ ПустаяСтрока(Наименование) ИЛИ Наименование = ТекущиеДанные.Наименование Тогда
		Возврат;
	КонецЕсли;
		
	ПереименоватьДиалогНаСервере(ТекущаяСтрокаСписка, Наименование);
	
	Элементы.СписокЧатов.Обновить();
	
КонецПроцедуры

&НаКлиенте
АСИНХ Процедура КомандаОчиститьПамять(Команда)

	Если НЕ ЗначениеЗаполнено(АктивныйДиалог) Тогда
		Возврат;
	КонецЕсли;

	Если ТаймерАктивен Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Дождитесь завершения текущего ответа агента перед очисткой памяти.";
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;

	Ответ = ЖДАТЬ ВопросАсинх(
		"Очистить память диалога? История сообщений останется без изменений.",
		РежимДиалогаВопрос.ДаНет);

	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;

	РезультатОчистки = ОчиститьПамятьНаСервере();
	Если РезультатОчистки.Успех Тогда
		СтатусАгента = "Память диалога очищена. Фактов памяти: 0.";
	Иначе
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = РезультатОчистки.Сообщение;
		СообщениеПользователю.Сообщить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	ОткрытьФорму(
		"Обработка.СИ_ЧатАгента.Форма.ФормаНастройки",
		Неопределено,
		ЭтотОбъект,
		,
		,
		,
		Неопределено,
		РежимБлокировкиПриОткрытииОкнаФормы.НеБлокировать);

КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Применяет текущую тему оформления к уже открытому документу чата.
//
// Основной путь - замена узла палитры скриптом страницы (siSetTheme): документ
// при этом НЕ пересоздаётся, поэтому перекрашиваются и уже отрисованные
// сообщения, а прокрутка/картинки сохраняются.
//
// Резервный путь - полная перерисовка документа: так работают клиенты без
// моста (веб-клиент), а также случай, когда узел палитры в документе не найден.
// Мост после перерисовки поднимается заново в ТекстИсторииДокументСформирован,
// поэтому кэш окна и признак доступности моста сбрасываются.
&НаКлиенте
Процедура ПрименитьТемуОформления()

	ПараметрыТемы = ПараметрыСтилейТемы(ТемнаяТема);

	Если МостДоступен И ОкноHTML <> Неопределено Тогда
		ОтветМоста = "";
		Попытка
			ОтветМоста = ОкноHTML.siSetTheme(ПараметрыТемы.CSS, ПараметрыТемы.СтопыГрадиента);
		Исключение
			ОтветМоста = "nostyle";
		КонецПопытки;
		Если ОтветМоста = "ok" Тогда
			Возврат;
		КонецЕсли;
		ОкноHTML = Неопределено;
		МостДоступен = Ложь;
	КонецЕсли;

	ОбновитьТекстИстории(, ВызовыИнструментовЗахода, РассужденияЗахода, ПромежуточныйТекстЗахода);

КонецПроцедуры

// Собирает параметры оформления для скрипта страницы: css палитры темы и стопы
// градиента заголовка роли (заголовок окрашен посимвольно и правилом CSS не
// переопределяется, поэтому при смене темы его цвета передаются скрипту).
//
// Параметры:
//  ТемнаяТема - Булево - Истина: тёмная палитра; Ложь - светлая.
//
// Возвращаемое значение:
//  Структура - CSS (Строка) и СтопыГрадиента (Строка).
&НаСервереБезКонтекста
Функция ПараметрыСтилейТемы(Знач ТемнаяТема)

	Результат = Новый Структура;
	Результат.Вставить("CSS", СИ_ЧатHTMLСервер.ПолучитьСтилиТемыCSS(ТемнаяТема));
	Результат.Вставить("СтопыГрадиента", СИ_ЧатHTMLСервер.ПолучитьСтопыГрадиентаЗаголовка(ТемнаяТема));

	Возврат Результат;

КонецФункции

&НаСервере
Функция ОчиститьПамятьНаСервере()

	РезультатВозврата = Новый Структура("Успех,Сообщение", Ложь, "Память не очищена.");

	Если НЕ ЗначениеЗаполнено(АктивныйДиалог) Тогда
		РезультатВозврата.Сообщение = "Не выбран диалог.";
		Возврат РезультатВозврата;
	КонецЕсли;

	Если СИ_ПамятьДиалога.ОчиститьПамятьДиалога(АктивныйДиалог) Тогда
		РезультатВозврата.Успех = Истина;
		РезультатВозврата.Сообщение = "Память диалога очищена.";
	Иначе
		РезультатВозврата.Сообщение = "Не удалось очистить память диалога. Подробности в журнале регистрации.";
	КонецЕсли;

	Возврат РезультатВозврата;

КонецФункции

// Возвращает расширение файла без ведущей точки (часть после ПОСЛЕДНЕЙ точки).
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьРасширениеФайла(ИмяФайла)

	ИмяФайла = СокрЛП(Строка(ИмяФайла));
	ПозицияТочки = 0;
	Для Индекс = СтрДлина(ИмяФайла) По 1 Цикл
		Если Сред(ИмяФайла, Индекс, 1) = "." Тогда
			ПозицияТочки = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПозицияТочки = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Прав(ИмяФайла, СтрДлина(ИмяФайла) - ПозицияТочки);

КонецФункции

// Определяет тип файла по сигнатуре содержимого (magic bytes).
// Используется как фолбэк, когда расширение по имени не позволяет определить тип.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//
// Возвращаемое значение:
//  Строка - расширение без точки (pdf/jpg/png/gif/bmp/webp); "" для неизвестного формата.
&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьТипФайлаПоСодержимому(ДвоичныеДанные)

	Если ДвоичныеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Размер = ДвоичныеДанные.Размер();
		Если Размер < 8 Тогда
			Возврат "";
		КонецЕсли;

		Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
		Байты = Новый БуферДвоичныхДанных(8);
		Прочитано = Поток.Прочитать(Байты, 0, 8);
		Поток.Закрыть();

		Если Прочитано < 4 Тогда
			Возврат "";
		КонецЕсли;

		Если Байты[0] = 37 И Байты[1] = 80 И Байты[2] = 68 И Байты[3] = 70 Тогда
			Возврат "pdf";
		КонецЕсли;

		Если Байты[0] = 255 И Байты[1] = 216 И Байты[2] = 255 Тогда
			Возврат "jpg";
		КонецЕсли;

		Если Байты[0] = 137 И Байты[1] = 80 И Байты[2] = 78 И Байты[3] = 71
			И Байты[4] = 13 И Байты[5] = 10 И Байты[6] = 26 И Байты[7] = 10 Тогда
			Возврат "png";
		КонецЕсли;

		Если Байты[0] = 71 И Байты[1] = 73 И Байты[2] = 70 Тогда
			Возврат "gif";
		КонецЕсли;

		Если Байты[0] = 66 И Байты[1] = 77 Тогда
			Возврат "bmp";
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Процедура ПереименоватьДиалогНаСервере(Диалог, Наименование)
	
	Если НЕ ЗначениеЗаполнено(Диалог) Или ПустаяСтрока(Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияЗаписиДиалога = Новый Структура;
	ЗначенияЗаписиДиалога.Вставить("Наименование", Наименование);
	ПараметрыЗаписиДиалога = Новый Структура;
	ПараметрыЗаписиДиалога.Вставить("ИмяОперации", "ПереименованиеДиалога");
	СИ_УправлениеДиалогом.ЗаписатьРеквизитыДиалога(Диалог, ЗначенияЗаписиДиалога,
		ПараметрыЗаписиДиалога);
	
КонецПроцедуры

