&НаСервере
Процедура ЗагрузитьДанныеПрофиля()

	Если НЕ ЗначениеЗаполнено(ПрофильПодключения) Тогда
		Возврат;
	КонецЕсли;

	ДанныеПрофиля = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПрофильПодключения,
		"Наименование, БазовыйURL, КлючAPI, ТипАвторизации, ИмяЗаголовкаАвторизации, ПроверятьSSL, Таймаут, РазрешитьРассуждения");

	НаименованиеПрофиля = ДанныеПрофиля.Наименование;
	БазовыйURL = ДанныеПрофиля.БазовыйURL;
	КлючAPI = ДанныеПрофиля.КлючAPI;
	ТипАвторизации = ДанныеПрофиля.ТипАвторизации;
	ИмяЗаголовкаАвторизации = ДанныеПрофиля.ИмяЗаголовкаАвторизации;
	ПроверятьSSL = ДанныеПрофиля.ПроверятьSSL;
	Таймаут = ДанныеПрофиля.Таймаут;
	РазрешитьРассуждения = ДанныеПрофиля.РазрешитьРассуждения;

	УстановитьВидимостьИмениЗаголовка();

	Элементы.ДекорацияРезультатПроверки.Заголовок = " ";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Модели.ИмяМодели КАК ИмяМодели,
	|	Модели.КонтекстноеОкно КАК КонтекстноеОкно,
	|	Модели.МаксимумТокеновОтвета КАК МаксимумТокеновОтвета,
	|	Модели.ПоддержкаИзображений КАК ПоддержкаИзображений,
	|	Модели.ИспользоватьПоУмолчанию КАК ИспользоватьПоУмолчанию
	|ИЗ
	|	Справочник.СИ_ПрофилиПодключений.Модели КАК Модели
	|ГДЕ
	|	Модели.Ссылка = &Профиль
	|УПОРЯДОЧИТЬ ПО
	|	Модели.НомерСтроки";

	Запрос.УстановитьПараметр("Профиль", ПрофильПодключения);

	ТаблицаМоделей.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаМоделей.Добавить();
		НоваяСтрока.ИмяМодели = Выборка.ИмяМодели;
		НоваяСтрока.КонтекстноеОкно = Выборка.КонтекстноеОкно;
		НоваяСтрока.МаксимумТокеновОтвета = Выборка.МаксимумТокеновОтвета;
		НоваяСтрока.ПоддержкаИзображений = Выборка.ПоддержкаИзображений;
		НоваяСтрока.ИспользоватьПоУмолчанию = Выборка.ИспользоватьПоУмолчанию;
	КонецЦикла;

КонецПроцедуры

