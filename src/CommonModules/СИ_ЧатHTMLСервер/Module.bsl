#Область ПрограммныйИнтерфейс

// Полный HTML-заголовок документа истории: открывает <html><head> со стилями
// и открывает <body>. Вызывающий код обязан закрыть документ
// "</body></html>".
//
// Документ собирается БЕЗ <!DOCTYPE html> - движок поля работает в
// quirks-режиме. Standards-режим в движке поля прокрутку ломает: переполнение
// контента не отдаётся ни через body, ни через html, записи scrollTop не
// двигают вид (подробности - в комментарии внутри функции). Скрипты в
// документе выполняются: см. ПолучитьСкриптДокументаHTML.
//
// Контейнер прокрутки - ТОЛЬКО body: html{overflow:hidden} не даёт вьюпорту
// прокручиваться (на нём же держится фон), а body{overflow-y:auto;height:100%}
// скроллится сам. Это сохраняет работу прокрутки через
// Документ.body.scrollTop со стороны 1С.
// scroll-behavior:smooth включает нативную плавную прокрутку: отдельные
// обработчики ожидания для интерполяции scrollTop больше не нужны. Если движок
// scroll-behavior не поддержит, прокрутка останется мгновенной - работоспособная
// деградация.
//
// Параметры:
//  ТемнаяТема - Булево - Истина: тёмная палитра чата, Ложь - светлая
//   (см. ПолучитьСтилиТемыCSS / ПолучитьПалитруТемы).
//
// Возвращаемое значение:
//  Строка - HTML-строка заголовка документа.
Функция ПолучитьЗаголовокHTML(Знач ТемнаяТема = Ложь) Экспорт

	Возврат "<html><head><meta http-equiv=""X-UA-Compatible"" content=""IE=edge"">"
		+ "<meta charset=""UTF-8"">"
		+ "<style>"
		+ "html,body{height:100%;margin:0;}"
		+ "html{overflow:hidden;background-repeat:repeat;background-position:0 0;}"
		+ "body{overflow-y:auto;box-sizing:border-box;padding:10px;font-size:14px;}"
		+ "html,body{scroll-behavior:smooth;}"
		+ "body,div,span,p,td,th,li{font-family:'Segoe UI','Segoe UI Emoji','Segoe UI Symbol',Arial,sans-serif !important;}"
		+ "a.chatbtn{display:inline-block;vertical-align:middle;text-decoration:none;cursor:pointer;"
		+ "border-radius:8px;padding:10px 16px 10px 16px;"
		+ "font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;line-height:1.4;text-align:left;"
		+ "font-family:'Segoe UI','Segoe UI Emoji','Segoe UI Symbol',Arial,sans-serif;}"
		+ "a.chatbtn span{background:transparent;color:inherit;display:inline;padding:0;}"
		+ "a.si-link-totable{display:inline-block;vertical-align:middle;text-decoration:none;cursor:pointer;"
		+ "font-size:13px;font-weight:600;line-height:1.4;}"
		+ "a.si-link-totable:hover{text-decoration:underline;}"
		+ "a.chatbtnopt{display:block;text-decoration:none;cursor:pointer;"
		+ "border-radius:8px;padding:7px 14px;"
		+ "font-size:14px;font-weight:600;line-height:1.4;white-space:normal;word-wrap:break-word;overflow-wrap:break-word;text-align:left;"
		+ "font-family:'Segoe UI','Segoe UI Emoji','Segoe UI Symbol',Arial,sans-serif;}"
		+ ".si-start-tips a.chatbtnopt{display:inline-block;vertical-align:top;margin:0 8px 8px 0;letter-spacing:0.3px;}"
		+ ".si-msg{display:flex;margin-bottom:10px;}"
		+ ".si-msg-user{justify-content:flex-end;}"
		+ ".si-msg-bot{justify-content:flex-start;}"
		+ ".si-card{border-radius:18px 18px 6px 18px;border-style:solid;border-width:1px;padding:10px 16px;max-width:80%;word-wrap:break-word;}"
		+ ".si-card-err{border-radius:16px 16px 6px 16px;}"
		+ ".si-card-live{max-width:90%;}"
		+ ".si-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;}"
		+ ".si-role{white-space:nowrap;font-size:12px;font-weight:600;}"
		+ ".si-body{font-size:14px;line-height:1.45;}"
		+ ".si-body-sm{font-size:13px;line-height:1.45;}"
		+ ".si-meta{font-size:11px;opacity:0.65;margin-bottom:4px;}"
		+ ".si-copy{text-decoration:none;cursor:pointer;margin-left:8px;display:inline-flex;vertical-align:middle;}"
		+ ".si-reason{margin-bottom:8px;border-style:solid;border-width:1px;border-radius:10px;padding:6px 10px;font-size:12px;line-height:1.4;}"
		+ ".si-reason>summary{cursor:pointer;font-weight:600;font-size:12px;}"
		+ ".si-tools{margin-top:6px;font-size:12px;}"
		+ ".si-dot{width:8px;height:8px;border-radius:50%;display:inline-block;vertical-align:middle;}"
		+ ".si-dot1{margin-left:10px;}"
		+ ".si-dot2,.si-dot3{margin-left:6px;}"
		+ "@keyframes siPulse{0%,100%{opacity:0.35}50%{opacity:1}}"
		+ ".siDot1{animation:siPulse 1.2s ease-in-out infinite}"
		+ ".siDot2{animation:siPulse 1.2s ease-in-out infinite 0.2s}"
		+ ".siDot3{animation:siPulse 1.2s ease-in-out infinite 0.4s}"
		+ ".si-panel{margin-top:10px;padding:11px 14px;border-style:solid;border-width:1px;border-radius:14px;text-align:left;}"
		+ ".si-panel-title{font-size:13px;font-weight:600;margin-bottom:8px;}"
		+ ".si-q{font-size:13px;font-weight:600;margin-bottom:8px;line-height:1.4;word-wrap:break-word;}"
		+ ".si-call{margin:0 0 6px 0;font-size:13px;word-wrap:break-word;}"
		+ ".si-args{font-size:12px;}"
		+ ".si-perm-hint{font-size:12px;margin:0 0 8px 0;}"
		+ ".si-summary{border-style:solid;border-width:1px;border-radius:12px;padding:9px 14px;margin:0 0 14px 0;font-size:12px;}"
		+ ".si-md-pre{border-style:solid;border-width:1px;border-radius:12px;padding:10px 12px;margin:6px 0;overflow-x:auto;line-height:1.45;}"
		+ ".si-md-pre code{font-family:Consolas,'Courier New',monospace;font-size:13px;white-space:pre;}"
		+ ".si-md-code{font-family:Consolas,'Courier New',monospace;font-size:13px;border-radius:6px;padding:1px 5px;}"
		+ ".si-md-hr{border:none;border-top-style:solid;border-top-width:1px;margin:8px 0;}"
		+ ".si-md-h{margin:8px 0 4px 0;}"
		+ ".si-md-quote{margin:6px 0;padding:7px 12px;border-left-style:solid;border-left-width:3px;border-radius:0 10px 10px 0;}"
		+ ".si-md-list{margin:6px 0;padding-left:24px;}"
		+ ".si-md-li{margin:2px 0;}"
		+ ".si-md-table{border-collapse:collapse;font-size:13px;width:100%;}"
		+ ".si-md-th{border-style:solid;border-width:1px;padding:5px 10px;text-align:left;}"
		+ ".si-md-td{border-style:solid;border-width:1px;padding:5px 10px;}"
		+ ".si-md-a{text-decoration:underline;}"
		+ ".si-scroll-x{overflow-x:auto;margin:8px 0;}"
		+ ".si-shot{border-style:solid;border-width:1px;border-radius:8px;padding:6px;margin:4px 0;overflow:auto;}"
		+ ".si-thumb{border-radius:8px;display:block;margin:4px 0;cursor:pointer;max-width:240px;max-height:180px;}"
		+ ".si-chip{display:inline-block;vertical-align:middle;text-decoration:none;cursor:pointer;margin:2px 0;border-radius:999px;padding:3px 12px;font-size:12px;font-weight:600;border-style:solid;border-width:1px;}"
		+ ".si-btn-totable{margin-top:8px;text-align:right;}"
		+ ".si-btn-opt{margin:0 0 6px 0;}"
		+ ".si-btn-perm{margin:0 6px 6px 0;display:inline-block;}"
		+ ".si-start{padding:10px 2px 4px 2px;}"
		+ ".si-start-title{font-size:20px;font-weight:700;margin:0 0 6px 0;}"
		+ ".si-start-text{font-size:13px;line-height:1.5;margin:0 0 14px 0;}"
		+ ".si-start-tips{margin:0 0 16px 0;}"
		+ ".si-start-roles{display:block;margin:0 0 16px 0;}"
		+ ".si-role-tile{display:inline-block;vertical-align:top;width:200px;margin:0 8px 8px 0;"
		+ "border-style:solid;border-width:1px;border-radius:12px;padding:10px 12px;text-decoration:none;}"
		+ ".si-role-title{font-size:14px;font-weight:700;margin:0 0 4px 0;}"
		+ ".si-role-text{font-size:12px;line-height:1.4;}"
		+ ".si-chart-card{border-style:solid;border-width:1px;border-radius:12px;padding:10px 12px;margin:0 0 14px 0;}"
		+ ".si-chart-title{font-size:14px;font-weight:700;margin:0 0 6px 0;}"
		+ ".si-chart-body{margin:0 0 6px 0;overflow-x:auto;}"
		+ ".si-chart-body svg{display:block;max-width:100%;height:auto;}"
		+ ".si-chart-caption{font-size:12px;margin:0 0 8px 0;}"
		+ ".si-chart-actions{margin:0;}"
		+ "</style>"
		+ ПолучитьСтилиТемыHTML(ТемнаяТема)
		+ "</head><body>"
		+ ПолучитьСкриптДокументаHTML();

КонецФункции

// CSS-текст палитры чата - содержимое узла <style id="siTheme">.
//
// Единственный источник цветов оформления чата. Генераторы разметки
// (ПолучитьBubbleUserHTML, ПолучитьBubbleAssistantHTML, ...) и разбор markdown
// (СИ_МаркдаунHTML) навешивают только классы .si-*, а цвета живут здесь, поэтому
// тему можно переключить, заменив текст этого блока, БЕЗ пересоздания документа
// (см. siSetTheme). Цвета в inline-стилях разметки не остаются: CSS-класс
// не переопределил бы inline-стиль, и тема не переключилась бы.
//
// ВАЖНО: CSS custom properties (var(--x)), prefers-color-scheme и
// background-clip:text НЕ используются - палитра генерируется плоским текстом
// на стороне сервера, чтобы оформление не зависело от поддержки этих
// возможностей движком поля (тонкий клиент на старом движке их не имеет).
//
// Параметры:
//  ТемнаяТема - Булево - Истина: тёмная палитра; Ложь - светлая.
//
// Возвращаемое значение:
//  Строка - CSS без обрамляющего тега <style>.
//
Функция ПолучитьСтилиТемыCSS(Знач ТемнаяТема = Ложь) Экспорт

	Палитра = ПолучитьПалитруТемы(ТемнаяТема);

	Части = Новый Массив;
	Части.Добавить("html{background-color:" + Палитра.ФонСтраницы + ";}");
	Части.Добавить("body{color:" + Палитра.ЦветТекста + ";}");
	Части.Добавить(".si-card-bot{color:" + Палитра.ТекстКарточки
		+ ";background:" + Палитра.ФонКарточки
		+ ";border-color:" + Палитра.РамкаКарточки
		+ ";box-shadow:" + Палитра.ТеньКарточки + ",inset 4px 0 0 " + Палитра.АкцентРоли + ";}");
	Части.Добавить(".si-card-user{color:" + Палитра.ТекстПользователя
		+ ";background:" + Палитра.ФонПользователя
		+ ";border-color:" + Палитра.РамкаПользователя
		+ ";box-shadow:" + Палитра.ТеньПользователя + ";}");
	Части.Добавить(".si-card-err{color:" + Палитра.ТекстОшибки
		+ ";background:" + Палитра.ФонОшибки
		+ ";border-color:" + Палитра.РамкаОшибки
		+ ";box-shadow:" + Палитра.ТеньОшибки + ";}");
	Части.Добавить(".si-role-user{color:" + Палитра.ЦветЗаголовкаПользователя + ";}");
	Части.Добавить(".si-reason{background:" + Палитра.ФонРассуждений
		+ ";border-color:" + Палитра.РамкаРассуждений
		+ ";color:" + Палитра.ЦветРассуждений + ";}");
	Части.Добавить(".si-reason>summary{color:" + Палитра.ЦветЗаголовкаРассуждений + ";}");
	Части.Добавить(".si-tools{color:" + Палитра.ЦветИнструментов + ";}");
	Части.Добавить(".si-fail{color:" + Палитра.ЦветОшибкиВызова + ";}");
	Части.Добавить(".si-dot{background:linear-gradient(135deg," + Палитра.ЦветТочки1 + "," + Палитра.ЦветТочки2
		+ ");box-shadow:" + Палитра.СвечениеТочки + ";}");
	Части.Добавить(".si-panel{background:" + Палитра.ФонПанели + ";border-color:" + Палитра.РамкаПанели + ";}");
	Части.Добавить(".si-panel-title{color:" + Палитра.ЦветЗаголовкаПанели + ";}");
	Части.Добавить(".si-q{color:" + Палитра.ЦветВопроса + ";}");
	Части.Добавить(".si-call{color:" + Палитра.ЦветВызова + ";}");
	Части.Добавить(".si-args{color:" + Палитра.ЦветАргументов + ";}");
	Части.Добавить(".si-perm-hint{color:" + Палитра.ЦветАргументов + ";}");
	Части.Добавить(".si-summary{background:" + Палитра.ФонСводки
		+ ";border-color:" + Палитра.РамкаСводки
		+ ";color:" + Палитра.ТекстСводки
		+ ";box-shadow:" + Палитра.ТеньСводки + ";}");
	Части.Добавить(".si-md-pre{background:" + Палитра.ФонКода + ";border-color:" + Палитра.РамкаКода + ";}");
	Части.Добавить(".si-md-code{background:" + Палитра.ФонИнлайнКода + ";}");
	Части.Добавить(".si-md-hr{border-top-color:" + Палитра.ЦветРазделителя + ";}");
	Части.Добавить(".si-md-h{color:" + Палитра.ЦветЗаголовкаMarkdown + ";}");
	Части.Добавить(".si-md-quote{border-left-color:" + Палитра.ЦветРамкиЦитаты
		+ ";color:" + Палитра.ЦветЦитаты
		+ ";background:" + Палитра.ФонЦитаты + ";}");
	Части.Добавить(".si-md-th{border-color:" + Палитра.РамкаТаблицы + ";background:" + Палитра.ФонШапкиТаблицы + ";}");
	Части.Добавить(".si-md-td{border-color:" + Палитра.РамкаТаблицы + ";background:" + Палитра.ФонСтрокиТаблицы + ";}");
	Части.Добавить(".si-md-tr-alt>td{background:" + Палитра.ФонПолосыТаблицы + ";}");
	Части.Добавить(".si-md-a{color:" + Палитра.ЦветСсылки + ";}");
	Части.Добавить(".si-shot{border-color:" + Палитра.РамкаКартинки
		+ ";background:" + Палитра.ФонКартинки
		+ ";box-shadow:" + Палитра.ТеньКартинки + ";}");
	Части.Добавить(".si-thumb{box-shadow:" + Палитра.ТеньМиниатюры + ";}");
	Части.Добавить(".si-chip{background:" + Палитра.ФонЧипаВложения
		+ ";border-color:" + Палитра.РамкаЧипаВложения
		+ ";color:" + Палитра.ТекстЧипаВложения + ";}");
	Части.Добавить(".si-ico-back{stroke:" + Палитра.ЦветИконкиКопииЗадней + ";}");
	Части.Добавить(".si-ico-front{stroke:" + Палитра.ЦветИконкиКопииПередней + ";}");
	Части.Добавить("a.chatbtn{background:" + Палитра.ФонКнопки
		+ ";color:" + Палитра.ТекстКнопки
		+ ";box-shadow:" + Палитра.ТеньКнопки + ";}");
	Части.Добавить("a.chatbtn:hover{background:" + Палитра.ФонКнопкиНаведение + ";}");
	Части.Добавить("a.chatbtn:active{background:" + Палитра.ФонКнопкиНажатие + ";}");
	Части.Добавить("a.chatbtnopt{background:" + Палитра.ФонКнопкиВарианта
		+ ";color:" + Палитра.ТекстКнопкиВарианта + ";}");
	Части.Добавить("a.chatbtnopt:hover{background:" + Палитра.ФонВариантаНаведение + ";}");
	Части.Добавить("a.chatbtnopt:active{background:" + Палитра.ФонВариантаНажатие + ";}");
	СтопыГрадиентаЗаголовка = СтрРазделить(Палитра.СтопыГрадиентаЗаголовка, ",", Ложь);
	Части.Добавить("a.si-link-totable{color:#" + СтопыГрадиентаЗаголовка[0] + ";}");
	Если ПустаяСтрока(Палитра.ФонПодсказки2) Тогда
		ФонПодсказок = Палитра.ФонПодсказки1;
	Иначе
		ФонПодсказок = "linear-gradient(90deg," + Палитра.ФонПодсказки1
			+ "," + Палитра.ФонПодсказки2 + ")";
	КонецЕсли;
	Части.Добавить(".si-start-tips a.chatbtnopt{background:" + ФонПодсказок
		+ ";color:" + Палитра.ЦветТекстаПодсказки + ";}");
	Части.Добавить(".si-start-tips a.chatbtnopt:hover{background:" + Палитра.ФонПодсказкиНаведение + ";}");
	Части.Добавить(".si-start-tips a.chatbtnopt:active{background:" + Палитра.ФонПодсказкиНажатие + ";}");
	Части.Добавить(".si-start-tips a.chatbtnopt:focus{outline:2px solid "
		+ Палитра.ЦветТекстаПодсказки + ";outline-offset:2px;}");
	Части.Добавить(".si-start-title{color:" + Палитра.ЦветЗаголовкаСтарта + ";}");
	Части.Добавить(".si-start-text{color:" + Палитра.ЦветТекстаСтарта + ";}");

	Части.Добавить(".si-role-tile{background:" + Палитра.ФонПлитки
		+ ";border-color:" + Палитра.РамкаПлитки + ";}");
	Части.Добавить(".si-role-title{color:" + Палитра.ЦветЗаголовкаПлитки + ";}");
	Части.Добавить(".si-role-text{color:" + Палитра.ЦветТекстаПлитки + ";}");

	Части.Добавить(".si-chart-card{background:" + Палитра.ФонДиаграммы
		+ ";border-color:" + Палитра.РамкаДиаграммы + ";}");
	Части.Добавить(".si-chart-title{color:" + Палитра.ЦветЗаголовкаДиаграммы + ";}");
	Части.Добавить(".si-chart-caption{color:" + Палитра.ЦветПодписейДиаграммы + ";}");
	Части.Добавить(".si-chart-bar{fill:" + Палитра.ЦветДиаграммы1 + ";}");
	Части.Добавить(".si-chart-line{stroke:" + Палитра.ЦветДиаграммы2 + ";}");
	Части.Добавить(".si-chart-point{fill:" + Палитра.ЦветДиаграммы2 + ";}");
	Части.Добавить(".si-chart-seg0{fill:" + Палитра.ЦветДиаграммы1 + ";}");
	Части.Добавить(".si-chart-seg1{fill:" + Палитра.ЦветДиаграммы2 + ";}");
	Части.Добавить(".si-chart-seg2{fill:" + Палитра.ЦветДиаграммы3 + ";}");
	Части.Добавить(".si-chart-seg3{fill:" + Палитра.ЦветДиаграммы4 + ";}");
	Части.Добавить(".si-chart-seg4{fill:" + Палитра.ЦветДиаграммы5 + ";}");
	Части.Добавить(".si-chart-seg{fill:" + Палитра.ЦветДиаграммы1 + ";}");
	Части.Добавить(".si-chart-axis{stroke:" + Палитра.ЦветОсиДиаграммы + ";}");
	Части.Добавить(".si-chart-grid{stroke:" + Палитра.ЦветСеткиДиаграммы + ";}");
	Части.Добавить(".si-chart-label,.si-chart-value,.si-chart-legend{fill:"
		+ Палитра.ЦветПодписейДиаграммы + ";}");
	Части.Добавить(".si-chart-svg-title{fill:" + Палитра.ЦветЗаголовкаДиаграммы + ";}");

	Возврат СтрСоединить(Части, "");

КонецФункции

// HTML-блок палитры темы для головы документа чата.
//
// Параметры:
//  ТемнаяТема - Булево - см. ПолучитьСтилиТемыCSS.
//
// Возвращаемое значение:
//  Строка - HTML вида "<style id=""siTheme"">...</style>".
//
Функция ПолучитьСтилиТемыHTML(Знач ТемнаяТема = Ложь) Экспорт

	Возврат "<style id=""siTheme"">" + ПолучитьСтилиТемыCSS(ТемнаяТема) + "</style>";

КонецФункции

// Стопы градиента заголовка роли в виде "RRGGBB,RRGGBB,RRGGBB" - для скрипта
// страницы (siSetTheme), который перекрашивает уже отрисованные заголовки при
// смене темы. Цвета заголовка задаются посимвольно в inline-стилях, поэтому
// правилами CSS они не переопределяются - нужна перекраска скриптом.
//
// Параметры:
