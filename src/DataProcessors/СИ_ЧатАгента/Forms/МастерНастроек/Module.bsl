&НаСервере
Процедура ПодготовитьШагИнструментыНаСервере()

	// Инструменты 1С уже зарегистрированы - ничего не делаем.
	Если КоличествоИнструментов1С() > 0 Тогда
		Возврат;
	КонецЕсли;

	// Инструментов ещё нет - регистрируем инструменты по умолчанию
	// (дубли не создаются, новые инструменты разрешаются сразу).
	РезультатРегистрации = ЗарегистрироватьИнструментыНаСервере();

	Если НЕ ПустаяСтрока(РезультатРегистрации.ТекстОшибки) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не удалось зарегистрировать инструменты по умолчанию:'")
			+ Символы.ПС + РезультатРегистрации.ТекстОшибки);
		Возврат;
	КонецЕсли;

	Если РезультатРегистрации.Зарегистрировано.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Зарегистрированы инструменты по умолчанию: '")
			+ СтрСоединить(РезультатРегистрации.Зарегистрировано, ", "));
	КонецЕсли;

КонецПроцедуры

