#Область ПрограммныйИнтерфейс

// Определяет, является ли расширение файла изображением.
//
// Параметры:
//  Расширение - Строка - расширение без точки (например, "jpg").
//
// Возвращаемое значение:
//  Булево - Истина, если расширение соответствует картинке.
Функция ЭтоКартинка(Расширение) Экспорт

	Расширение = НРег(СокрЛП(Строка(Расширение)));
	Возврат Расширение = "jpg"
		ИЛИ Расширение = "jpeg"
		ИЛИ Расширение = "png"
		ИЛИ Расширение = "gif"
		ИЛИ Расширение = "bmp"
		ИЛИ Расширение = "webp";

КонецФункции

// Определяет, является ли расширение файла PDF.
//
// Параметры:
//  Расширение - Строка - расширение без точки.
//
// Возвращаемое значение:
//  Булево - Истина, если расширение равно "pdf".
Функция ЭтоПDF(Расширение) Экспорт

	Расширение = НРег(СокрЛП(Строка(Расширение)));
	Возврат Расширение = "pdf";

КонецФункции

// Формирует data URI (data:<mime>;base64,...) из двоичных данных изображения.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - данные изображения.
//  Расширение - Строка - расширение без точки (jpg/png и т.п.).
//  МаксимальныйРазмерСтороны - Число,Неопределено - максимальный размер большей стороны
//    в пикселях. Если передан и изображение больше — выполняется ресайз с пересохранением
//    в JPEG (уменьшает размер base64 в несколько раз для страниц PDF).
//
// Возвращаемое значение:
//  Строка - data URI для передачи в image_url блоках OpenAI vision.
Функция ДвоичныеДанныеВDataURI(ДвоичныеДанные, Расширение, МаксимальныйРазмерСтороны = Неопределено) Экспорт

	MIME = ОпределитьMIME(Расширение);
	Если ПустаяСтрока(MIME) Тогда
		MIME = "image/jpeg";
	КонецЕсли;

	ДвоичныеДанныеДляОтправки = ДвоичныеДанные;
	Если МаксимальныйРазмерСтороны <> Неопределено И МаксимальныйРазмерСтороны > 0 Тогда
		Попытка
			Картинка = Новый Картинка(ДвоичныеДанные);
			Ширина = Картинка.Ширина();
			Высота = Картинка.Высота();
			Если Ширина > МаксимальныйРазмерСтороны ИЛИ Высота > МаксимальныйРазмерСтороны Тогда
				Если Ширина >= Высота Тогда
					НоваяШирина = МаксимальныйРазмерСтороны;
					НоваяВысота = Цел(Высота * МаксимальныйРазмерСтороны / Ширина);
				Иначе
					НоваяВысота = МаксимальныйРазмерСтороны;
					НоваяШирина = Цел(Ширина * МаксимальныйРазмерСтороны / Высота);
				КонецЕсли;
				ОбрабатываемаяКартинка = Новый ОбрабатываемаяКартинка(Картинка);
				ОбрабатываемаяКартинка.УстановитьРазмер(НоваяШирина, НоваяВысота);
				КартинкаУменьшенная = ОбрабатываемаяКартинка.ПолучитьКартинку();
				ПотокВПамяти = Новый ПотокВПамяти;
				КартинкаУменьшенная.Записать(ПотокВПамяти);
				ДвоичныеДанныеДляОтправки = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
				MIME = "image/jpeg";
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.ДвоичныеДанныеВDataURI",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				"Ошибка ресайза изображения: " + ОписаниеОшибки() + ". Отправляем оригинал.");
		КонецПопытки;
	КонецЕсли;

	Возврат "data:" + MIME + ";base64," + Base64Строка(ДвоичныеДанныеДляОтправки);

КонецФункции

// Формирует user-сообщение с content-массивом [text, image_url x N] для передачи
// изображений напрямую в основной запрос (когда основная модель - vision).
//
// Параметры:
//  Текст - Строка - текстовое описание перед изображениями.
//  МассивКартинок - Массив из Структура - массив описаний изображений:
//    * ДвоичныеДанные - ДвоичныеДанные - данные изображения.
//    * Расширение - Строка - расширение без точки.
//    * ИмяФайла - Строка - имя файла (для текста).
//
// Возвращаемое значение:
//  Структура - сообщение в формате OpenAI с массивом content-блоков:
//    * Роль - Строка - роль сообщения (всегда "user").
//    * Контент - Массив - content-блоки OpenAI: [text, image_url x N].
Функция ПодготовитьVisionСообщение(Текст, МассивКартинок) Экспорт

	Блоки = Новый Массив;

	Если НЕ ПустаяСтрока(Текст) Тогда
		ТекстовыйБлок = Новый Соответствие;
		ТекстовыйБлок.Вставить("type", "text");
		ТекстовыйБлок.Вставить("text", Текст);
		Блоки.Добавить(ТекстовыйБлок);
	КонецЕсли;

	Если МассивКартинок <> Неопределено Тогда
		Для Каждого ОписаниеКартинки Из МассивКартинок Цикл
			Если ОписаниеКартинки = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ДвоичныеДанные = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеКартинки, "ДвоичныеДанные", Неопределено);
			Расширение = Строка(СИ_РаботаСJSON.БезопасноПолучить(ОписаниеКартинки, "Расширение", "jpg"));
			Если ДвоичныеДанные = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			БлокИзображения = Новый Соответствие;
			БлокИзображения.Вставить("type", "image_url");
			ОбъектURL = Новый Соответствие;
			ОбъектURL.Вставить("url", ДвоичныеДанныеВDataURI(ДвоичныеДанные, Расширение));
			БлокИзображения.Вставить("image_url", ОбъектURL);
			Блоки.Добавить(БлокИзображения);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура("Роль, Контент", "user", Блоки);

	Возврат Результат;

КонецФункции

// Распознаёт изображение через vision-модель (МодельРаспознованияКартинок из режима).
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - данные изображения.
//  ИмяФайла - Строка - имя файла (для промпта).
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения (фолбэк).
//  Режим - СправочникСсылка.СИ_РежимиРаботы,Неопределено - режим работы (источник vision-модели/профиля).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - признак успешного распознавания.
//    * Текст - Строка - распознанный текст (при Успех = Истина).
//    * Ошибка - Строка - описание ошибки (при Успех = Ложь).
Функция РаспознатьИзображение(ДвоичныеДанные, ИмяФайла = "", Профиль = Неопределено, Режим = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Ошибка", "");

	Попытка
		МодельVision = "";
		ПрофильVision = Профиль;
		Попытка
			РежимДляVision = Режим;
			Если НЕ ЗначениеЗаполнено(РежимДляVision) И ЗначениеЗаполнено(Профиль) Тогда
			КонецЕсли;
			Если ЗначениеЗаполнено(РежимДляVision) Тогда
				ЗначРежима = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РежимДляVision, "МодельРаспознованияКартинок, ПрофильРаспознованияКартинок");
				МодельVision = СокрЛП(Строка(ЗначРежима.МодельРаспознованияКартинок));
				Если ЗначениеЗаполнено(ЗначРежима.ПрофильРаспознованияКартинок) Тогда
					ПрофильVision = ЗначРежима.ПрофильРаспознованияКартинок;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если ПустаяСтрока(МодельVision) Тогда
			Результат.Ошибка = "Не задана модель распознавания картинок (реквизит МодельРаспознованияКартинок в режиме работы).";
			Возврат Результат;
		КонецЕсли;

		Расширение = "";
		Если НЕ ПустаяСтрока(ИмяФайла) Тогда
			ПозицияТочки = СтрНайти(ИмяФайла, ".");
			Если ПозицияТочки > 0 Тогда
				Расширение = НРег(Прав(ИмяФайла, СтрДлина(ИмяФайла) - ПозицияТочки));
			КонецЕсли;
		КонецЕсли;

		DataURI = ДвоичныеДанныеВDataURI(ДвоичныеДанные, Расширение, 1568);

		Промпт = "Проанализируй изображение";
		Если НЕ ПустаяСтрока(ИмяФайла) Тогда
			Промпт = Промпт + " «" + ИмяФайла + "»";
		КонецЕсли;
		Промпт = Промпт + ". Опиши содержимое изображения максимально подробно: "
			+ "распознай весь текст (если есть), структуру, ключевые объекты и данные.";

		РезультатВызова = ВызватьVisionМодель(МодельVision, Промпт, DataURI, ПрофильVision);

		Если СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Успех", Ложь) Тогда
			Результат.Успех = Истина;
			Результат.Текст = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Текст", ""));
		Иначе
			Результат.Ошибка = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Ошибка", "Ошибка вызова vision-модели"));
		КонецЕсли;
	Исключение
		Результат.Ошибка = "Ошибка распознавания изображения: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.РаспознатьИзображение", УровеньЖурналаРегистрации.Ошибка, ,
			ИмяФайла, Результат.Ошибка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Распознаёт PDF через vision-модель: конвертирует PDF в картинки страниц,
// каждую страницу распознаёт отдельным вызовом и объединяет результаты.
//
// Параметры:
//  ДвоичныеДанныеPDF - ДвоичныеДанные - данные PDF.
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения (фолбэк).
//  Режим - СправочникСсылка.СИ_РежимиРаботы,Неопределено - режим работы (источник vision-модели/профиля).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - признак успешного распознавания.
//    * Страницы - Массив из Структура - результаты по страницам:
//      ** Номер - Число - номер страницы (с 1).
//      ** Текст - Строка - распознанный текст страницы.
//      ** Ошибка - Строка - ошибка распознавания конкретной страницы (при наличии).
//    * ОбщийТекст - Строка - объединённый текст всех страниц.
//    * Ошибка - Строка - общая ошибка (при Успех = Ложь).
Функция РаспознатьPDF(ДвоичныеДанныеPDF, Профиль = Неопределено, Режим = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Страницы", Новый Массив);
	Результат.Вставить("ОбщийТекст", "");
	Результат.Вставить("Ошибка", "");

	Попытка
		МодельVision = "";
		ПрофильVision = Профиль;
		Попытка
			Если ЗначениеЗаполнено(Режим) Тогда
				ЗначРежима = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Режим, "МодельРаспознованияКартинок, ПрофильРаспознованияКартинок");
				МодельVision = СокрЛП(Строка(ЗначРежима.МодельРаспознованияКартинок));
				Если ЗначениеЗаполнено(ЗначРежима.ПрофильРаспознованияКартинок) Тогда
					ПрофильVision = ЗначРежима.ПрофильРаспознованияКартинок;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если ПустаяСтрока(МодельVision) Тогда
			Результат.Ошибка = "Не задана модель распознавания картинок (реквизит МодельРаспознованияКартинок в режиме работы).";
			Возврат Результат;
		КонецЕсли;

		МассивКартинок = КонвертироватьPDFВКартинки(ДвоичныеДанныеPDF, Профиль);
		Если СИ_РаботаСJSON.БезопасноПолучить(МассивКартинок, "Успех", Ложь) = Ложь Тогда
			Результат.Ошибка = Строка(СИ_РаботаСJSON.БезопасноПолучить(МассивКартинок, "Ошибка", "Ошибка конвертации PDF"));
			Возврат Результат;
		КонецЕсли;

		Картинки = СИ_РаботаСJSON.БезопасноПолучить(МассивКартинок, "Картинки", Новый Массив);
		ОбщийТекст = "";

		Для Каждого Картинка Из Картинки Цикл
			НомерСтраницы = СИ_РаботаСJSON.БезопасноПолучить(Картинка, "Номер", 0);
			ДвоичныеДанные = СИ_РаботаСJSON.БезопасноПолучить(Картинка, "ДвоичныеДанные", Неопределено);
			Если ДвоичныеДанные = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.РаспознатьPDF",
				УровеньЖурналаРегистрации.Информация, ,
				, "Начало распознавания страницы " + Строка(НомерСтраницы)
				+ " из " + Строка(Картинки.Количество()) + " страниц"
				+ " | Размер страницы=" + Формат(ДвоичныеДанные.Размер() / 1024, "ЧДЦ=0") + " КБ");
			РезультатСтраницы = РаспознатьИзображение(ДвоичныеДанные, "страница_" + Строка(НомерСтраницы) + ".jpg", ПрофильVision, Режим);
			ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.РаспознатьPDF",
				УровеньЖурналаРегистрации.Информация, ,
				, "Страница " + Строка(НомерСтраницы) + " распознана. Успех="
				+ Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатСтраницы, "Успех", Ложь)));

			ОписаниеСтраницы = Новый Структура;
			ОписаниеСтраницы.Вставить("Номер", НомерСтраницы);
			Если СИ_РаботаСJSON.БезопасноПолучить(РезультатСтраницы, "Успех", Ложь) Тогда
				ТекстСтраницы = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатСтраницы, "Текст", ""));
				ОписаниеСтраницы.Вставить("Текст", ТекстСтраницы);
				ОписаниеСтраницы.Вставить("Ошибка", "");
				Если НЕ ПустаяСтрока(ОбщийТекст) Тогда
					ОбщийТекст = ОбщийТекст + Символы.ПС + Символы.ПС;
				КонецЕсли;
				ОбщийТекст = ОбщийТекст + "=== Страница " + Строка(НомерСтраницы) + " ===" + Символы.ПС + ТекстСтраницы;
			Иначе
				ОписаниеСтраницы.Вставить("Текст", "");
				ОписаниеСтраницы.Вставить("Ошибка", Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатСтраницы, "Ошибка", "Ошибка распознавания страницы")));
			КонецЕсли;

			Результат.Страницы.Добавить(ОписаниеСтраницы);
		КонецЦикла;

		Результат.Успех = Истина;
		Результат.ОбщийТекст = ОбщийТекст;
	Исключение
		Результат.Ошибка = "Ошибка распознавания PDF: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.РаспознатьPDF", УровеньЖурналаРегистрации.Ошибка, ,
			, Результат.Ошибка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Конвертирует PDF в массив картинок (JPG) внешними утилитами.
//
// Параметры:
//  ДвоичныеДанныеPDF - ДвоичныеДанные - данные PDF.
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения
//    (настройки конвертации: движок, путь, лимит страниц, DPI).
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - признак успешной конвертации.
//    * Картинки - Массив из Структура - массив картинок страниц:
//      ** ДвоичныеДанные - ДвоичныеДанные - данные JPG страницы.
//      ** Номер - Число - номер страницы (с 1).
//    * Ошибка - Строка - описание ошибки (при Успех = Ложь).
Функция КонвертироватьPDFВКартинки(ДвоичныеДанныеPDF, Профиль = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Картинки", Новый Массив);
	Результат.Вставить("Ошибка", "");

	ИмяВходногоФайла = "";
	ПрефиксВывода = "";

	Попытка
		Настройки = СИ_НастройкиАгента.ПолучитьНастройки(Профиль);
		Движок = НРег(Строка(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ДвижокКонвертацииPDF", "pdftoppm")));
		ПутьКУтилите = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "ПутьКУтилитеКонвертацииPDF", "")));
		МаксимумСтраниц = Число(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "МаксимумСтраницPDF", 10));
		DPI = Число(СИ_РаботаСJSON.БезопасноПолучить(Настройки, "DPIКонвертацииPDF", 150));

		Если МаксимумСтраниц <= 0 Тогда
			МаксимумСтраниц = 10;
		КонецЕсли;
		Если DPI <= 0 Тогда
			DPI = 150;
		КонецЕсли;

		КаталогВременныхФайлов = ФайловаяСистема.ОбщийКаталогВременныхФайлов();
		УникальныйСуффикс = Строка(Новый УникальныйИдентификатор);

		ИмяВходногоФайла = КаталогВременныхФайлов + "pdf_convert_" + УникальныйСуффикс + ".pdf";
		ДвоичныеДанныеPDF.Записать(ИмяВходногоФайла);

		ПрефиксВывода = КаталогВременныхФайлов + "pdf_convert_" + УникальныйСуффикс + "_page";

		ИмяПрограммы = ОпределитьИмяПрограммы(Движок, ПутьКУтилите);
		Если ПустаяСтрока(ИмяПрограммы) Тогда
			Результат.Ошибка = "Не удалось определить исполняемый файл для движка конвертации PDF: " + Движок
				+ ". Укажите полный путь в реквизите ПутьКУтилитеКонвертацииPDF профиля подключения.";
			Возврат Результат;
		КонецЕсли;

		Команда = СобратьКомандуКонвертации(Движок, ИмяПрограммы, ИмяВходногоФайла, ПрефиксВывода, МаксимумСтраниц, DPI);

		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.КонвертироватьPDFВКартинки",
			УровеньЖурналаРегистрации.Информация, ,
			"pdf_convert_" + УникальныйСуффикс,
			"Запуск конвертации. Движок=" + Движок + " | Программа=" + ИмяПрограммы
			+ " | Страниц(лимит)=" + Формат(МаксимумСтраниц, "ЧДЦ=0; ЧГ=0") + " | DPI=" + Формат(DPI, "ЧДЦ=0; ЧГ=0"));

		ПараметрыЗапуска = ФайловаяСистема.ПараметрыЗапускаПрограммы();
		ПараметрыЗапуска.ДождатьсяЗавершения = Истина;
		ПараметрыЗапуска.ПолучитьПотокОшибок = Истина;

		РезультатЗапуска = ФайловаяСистема.ЗапуститьПрограмму(Команда, ПараметрыЗапуска);

		КодВозврата = СИ_РаботаСJSON.БезопасноПолучить(РезультатЗапуска, "КодВозврата", 1);
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.КонвертироватьPDFВКартинки",
			УровеньЖурналаРегистрации.Информация, ,
			"pdf_convert_" + УникальныйСуффикс,
			"Конвертация завершена. Код возврата=" + Строка(КодВозврата));
		Если КодВозврата <> 0 Тогда
			ПотокОшибок = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатЗапуска, "ПотокОшибок", ""));
			Результат.Ошибка = "Ошибка конвертации PDF (код возврата " + Строка(КодВозврата) + "): " + ПотокОшибок;
			Возврат Результат;
		КонецЕсли;

		Картинки = Новый Массив;
		Для НомерСтраницы = 1 По МаксимумСтраниц Цикл
			ИмяФайлаКартинки = ПрефиксВывода + "-" + Формат(НомерСтраницы, "ЧДЦ=0; ЧГ=0") + ".jpg";
			ФайлДляПроверки = Новый Файл(ИмяФайлаКартинки);
			Если ФайлДляПроверки.Существует() Тогда
				ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаКартинки);
				ОписаниеКартинки = Новый Структура;
				ОписаниеКартинки.Вставить("ДвоичныеДанные", ДвоичныеДанные);
				ОписаниеКартинки.Вставить("Номер", НомерСтраницы);
				Картинки.Добавить(ОписаниеКартинки);
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Картинки.Количество() = 0 Тогда
			Результат.Ошибка = "Не удалось найти сгенерированные изображения страниц PDF (движок: " + Движок + ").";
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;
		Результат.Картинки = Картинки;
	Исключение
		Результат.Ошибка = "Ошибка конвертации PDF: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.КонвертироватьPDFВКартинки", УровеньЖурналаРегистрации.Ошибка, ,
			, Результат.Ошибка);
	КонецПопытки;

	Попытка
		МассивФайловДляУдаления = Новый Массив;
		Если НЕ ПустаяСтрока(ИмяВходногоФайла) Тогда
			ФайлДляПроверки = Новый Файл(ИмяВходногоФайла);
			Если ФайлДляПроверки.Существует() Тогда
				МассивФайловДляУдаления.Добавить(ИмяВходногоФайла);
			КонецЕсли;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПрефиксВывода) Тогда
			Для НомерСтраницы = 1 По 100 Цикл
				ИмяФайлаКартинки = ПрефиксВывода + "-" + Формат(НомерСтраницы, "ЧДЦ=0; ЧГ=0") + ".jpg";
				ФайлДляПроверки = Новый Файл(ИмяФайлаКартинки);
				Если ФайлДляПроверки.Существует() Тогда
					МассивФайловДляУдаления.Добавить(ИмяФайлаКартинки);
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если МассивФайловДляУдаления.Количество() > 0 Тогда
			УдалитьФайлы(МассивФайловДляУдаления);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.ОчисткаВременныхФайлов", УровеньЖурналаРегистрации.Предупреждение, ,
			, "Ошибка очистки временных файлов: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Обработчик инструмента «RecognizeImage» для модели.
// Модель вызывает распознавание картинки/PDF по имени файла из списка файлов диалога.
//
// Параметры:
//  Аргументы - Структура - параметры вызова инструмента:
//    * ИдДиалога - СправочникСсылка.СИ_ДиалогиАгента - диалог (пробрасывается движком).
//    * ИмяФайла - Строка - имя файла в диалоге (можно с расширением или UUID).
//
// Возвращаемое значение:
//  Структура - результат распознавания (контракт инструмента):
//    * Успех - Булево - признак успешного выполнения.
//    * Значение - Произвольный,Неопределено - результат распознавания:
//      ** ИмяФайла - Строка - имя файла.
//      ** Текст - Строка - распознанный текст (для PDF - общий текст всех страниц).
//      ** Страницы - Массив из Структура,Неопределено - результаты по страницам (для PDF).
//    * Ошибка - Строка,Неопределено - описание ошибки.
Функция РаспознатьИзображениеПоИмениФайла(Аргументы) Экспорт

	Результат = НовыйРезультатИнструмента();

	ВключитьПривилегированныйРежим();
	Попытка
		ИдДиалога = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИдДиалога", Неопределено);
		ИмяФайла = Строка(СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ИмяФайла", ""));
		ПрофильПодключения = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "ПрофильПодключения", Неопределено);
		РежимДляVision = СИ_РаботаСJSON.БезопасноПолучить(Аргументы, "Режим", Неопределено);
		Если НЕ ЗначениеЗаполнено(РежимДляVision) И ЗначениеЗаполнено(ИдДиалога) Тогда
			Попытка
				ЗначРежимаДиалога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдДиалога, "Режим");
				РежимДляVision = ЗначРежимаДиалога.Режим;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ИдДиалога) Тогда
			Результат.Ошибка = "Не передан идентификатор диалога.";
			Возврат Результат;
		КонецЕсли;
		Если ПустаяСтрока(ИмяФайла) Тогда
			Результат.Ошибка = "Не указано имя файла.";
			Возврат Результат;
		КонецЕсли;

		СсылкаФайла = СИ_ФайлыДиалога.НайтиФайлДиалога(ИдДиалога, ИмяФайла);
		Если НЕ ЗначениеЗаполнено(СсылкаФайла) Тогда
			Результат.Ошибка = "Файл не найден в диалоге: " + ИмяФайла
				+ ". Доступные файлы можно получить инструментом ListDialogFiles.";
			Возврат Результат;
		КонецЕсли;

		ИмяФайла = СИ_ФайлыДиалога.ПолучитьИмяФайлаИзСсылки(СсылкаФайла);
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаФайла, Ложь);
		Если ДвоичныеДанные = Неопределено Тогда
			Результат.Ошибка = "Не удалось прочитать данные файла: " + ИмяФайла;
			Возврат Результат;
		КонецЕсли;

		РасширениеИзРеквизита = "";
		Попытка
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаФайла, "Расширение");
			РасширениеИзРеквизита = СокрЛП(Строка(ЗначенияРеквизитов.Расширение));
		Исключение
		КонецПопытки;

		РасширениеИзСодержимого = НРег(ОпределитьРасширениеПоСодержимому(ДвоичныеДанные));
		Расширение = НРег(СИ_ФайлыДиалога.ПолучитьРасширениеФайла(ИмяФайла));
		Если ПустаяСтрока(Расширение) Тогда
			Расширение = НРег(РасширениеИзРеквизита);
		КонецЕсли;
		Если ПустаяСтрока(Расширение) Тогда
			Расширение = РасширениеИзСодержимого;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.РаспознатьИзображениеПоИмениФайла",
			УровеньЖурналаРегистрации.Информация, ,
			Строка(ИдДиалога) + " | Файл: " + ИмяФайла,
			"Расширение: '" + Расширение + "' (из реквизита: '" + НРег(РасширениеИзРеквизита)
			+ "', из содержимого: '" + РасширениеИзСодержимого + "')");

		Если ЭтоПDF(Расширение) Тогда
			РезультатРаспознавания = РаспознатьPDF(ДвоичныеДанные, ПрофильПодключения, РежимДляVision);
			Если СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Успех", Ложь) Тогда
				Результат.Успех = Истина;
				Результат.Значение = Новый Структура;
				Результат.Значение.Вставить("ИмяФайла", ИмяФайла);
				Результат.Значение.Вставить("Текст", СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "ОбщийТекст", ""));
				Результат.Значение.Вставить("Страницы", СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Страницы", Неопределено));
			Иначе
				Результат.Ошибка = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Ошибка", "Ошибка распознавания PDF"));
			КонецЕсли;
		ИначеЕсли ЭтоКартинка(Расширение) Тогда
			РезультатРаспознавания = РаспознатьИзображение(ДвоичныеДанные, ИмяФайла, ПрофильПодключения, РежимДляVision);
			Если СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Успех", Ложь) Тогда
				Результат.Успех = Истина;
				Результат.Значение = Новый Структура;
				Результат.Значение.Вставить("ИмяФайла", ИмяФайла);
				Результат.Значение.Вставить("Текст", СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Текст", ""));
				Результат.Значение.Вставить("Страницы", Неопределено);
			Иначе
				Результат.Ошибка = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатРаспознавания, "Ошибка", "Ошибка распознавания изображения"));
			КонецЕсли;
		Иначе
			Результат.Ошибка = "Файл «" + ИмяФайла + "» не является изображением или PDF (расширение: " + Расширение + "). "
				+ "Поддерживаются: jpg, jpeg, png, gif, bmp, webp, pdf.";
		КонецЕсли;
	Исключение
		Результат.Ошибка = "Ошибка распознавания: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.РаспознатьИзображениеПоИмениФайла", УровеньЖурналаРегистрации.Ошибка, ,
			Строка(ИдДиалога), "Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
	ВыключитьПривилегированныйРежим();

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызывает vision-модель с одним изображением и текстовым промптом.
//
// Параметры:
//  Модель - Строка - имя vision-модели.
//  Промпт - Строка - текстовый запрос.
//  DataURI - Строка - data URI изображения.
//  Профиль - СправочникСсылка.СИ_ПрофилиПодключений,Неопределено - профиль подключения.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево
//    * Текст - Строка - ответ модели.
//    * Ошибка - Строка
Функция ВызватьVisionМодель(Модель, Промпт, DataURI, Профиль)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Ошибка", "");

	Попытка
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.ВызватьVisionМодель",
			УровеньЖурналаРегистрации.Информация, ,
			Модель, "Начало HTTP-вызова vision. Размер DataURI=" + Формат(СтрДлина(DataURI), "ЧДЦ=0; ЧГ=0") + " символов");

		Сообщение = Новый Соответствие;
		Сообщение.Вставить("role", "user");
		Блоки = Новый Массив;
		ТекстовыйБлок = Новый Соответствие;
		ТекстовыйБлок.Вставить("type", "text");
		ТекстовыйБлок.Вставить("text", Промпт);
		Блоки.Добавить(ТекстовыйБлок);
		БлокИзображения = Новый Соответствие;
		БлокИзображения.Вставить("type", "image_url");
		ОбъектURL = Новый Соответствие;
		ОбъектURL.Вставить("url", DataURI);
		БлокИзображения.Вставить("image_url", ОбъектURL);
		Блоки.Добавить(БлокИзображения);
		Сообщение.Вставить("content", Блоки);

		Сообщения = Новый Массив;
		Сообщения.Добавить(Сообщение);

		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("Модель", Модель);
		ПараметрыЗапроса.Вставить("Сообщения", Сообщения);
		ПараметрыЗапроса.Вставить("Температура", 0.1);
		ПараметрыЗапроса.Вставить("Таймаут", 180);
		Если Профиль <> Неопределено Тогда
			ПараметрыЗапроса.Вставить("Профиль", Профиль);
		КонецЕсли;

		РезультатВызова = СИ_ОpenAIКлиент.ВызватьChatCompletion(ПараметрыЗапроса);
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.ВызватьVisionМодель",
			УровеньЖурналаРегистрации.Информация, ,
			Модель, "HTTP-вызов vision завершён. Успех=" + Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Успех", Ложь))
			+ " | Ошибка=" + Строка(Лев(Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "ТекстОшибки", "")), 150)));
		Если СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Успех", Ложь) Тогда
			ОтветДанные = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Ответ", Неопределено);
			СобранноеСообщение = СИ_ОpenAIКлиент.СобратьСообщениеИзОтвета(ОтветДанные);
			ТекстОтвета = СИ_РаботаСJSON.БезопасноПолучить(СобранноеСообщение, "Сообщение", Неопределено);
			Если ТекстОтвета <> Неопределено Тогда
				ТекстКонтента = СИ_РаботаСJSON.БезопасноПолучить(ТекстОтвета, "content", Неопределено);
				Если ТекстКонтента = Неопределено Тогда
					ТекстКонтента = СИ_РаботаСJSON.БезопасноПолучить(ТекстОтвета, "Контент", Неопределено);
				КонецЕсли;
				Если ТекстКонтента = Неопределено Тогда
					ТекстКонтента = "";
				КонецЕсли;
				Результат.Текст = СокрЛП(Строка(ТекстКонтента));
				Если ПустаяСтрока(Результат.Текст) Тогда
					Рассуждения = СИ_РаботаСJSON.БезопасноПолучить(СобранноеСообщение, "Рассуждения", "");
					Если НЕ ПустаяСтрока(Рассуждения) Тогда
						Результат.Текст = СокрЛП(Строка(Рассуждения));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если ПустаяСтрока(Результат.Текст) Тогда
				Попытка
					СыройJSON = Лев(СИ_РаботаСJSON.ЗаписатьСтрокуJSON(ОтветДанные), 1200);
				Исключение
					СыройJSON = "<не удалось сериализовать ответ>";
				КонецПопытки;
				ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.ВызватьVisionМодель",
					УровеньЖурналаРегистрации.Предупреждение, , Модель,
					"Vision HTTP успешен, но content пуст. Ответ (обрезан): " + СыройJSON);
				Результат.Ошибка = "Vision-модель вернула пустой content. Ответ: " + Лев(СыройJSON, 500);
				Результат.Успех = Ложь;
			Иначе
				Результат.Успех = Истина;
			КонецЕсли;
		Иначе
			Результат.Ошибка = Строка(СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "ТекстОшибки", "Ошибка вызова модели"));
		КонецЕсли;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("СИ_РаспознованиеИзображений.ВызватьVisionМодель", УровеньЖурналаРегистрации.Ошибка, ,
			Модель, Результат.Ошибка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Определяет MIME-тип по расширению изображения.
//
// Параметры:
//  Расширение - Строка - расширение без точки.
//
// Возвращаемое значение:
//  Строка - MIME-тип (например, "image/jpeg"); "" для неизвестного.
Функция ОпределитьMIME(Расширение)

	Расширение = НРег(СокрЛП(Строка(Расширение)));

	Если Расширение = "jpg" ИЛИ Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "png" Тогда
		Возврат "image/png";
	ИначеЕсли Расширение = "gif" Тогда
		Возврат "image/gif";
	ИначеЕсли Расширение = "bmp" Тогда
		Возврат "image/bmp";
	ИначеЕсли Расширение = "webp" Тогда
		Возврат "image/webp";
	КонецЕсли;

	Возврат "";

КонецФункции

// Определяет расширение файла по сигнатуре содержимого (magic bytes).
// Используется, когда реквизит Расширение и имя файла не позволяют
// определить тип (файл без расширения или с нестандартным расширением).
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла.
//
// Возвращаемое значение:
//  Строка - расширение без точки (jpg/png/gif/bmp/webp/pdf); "" для неизвестного формата.
Функция ОпределитьРасширениеПоСодержимому(ДвоичныеДанные)

	Если ДвоичныеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Размер = ДвоичныеДанные.Размер();
		Если Размер < 12 Тогда
			Возврат "";
		КонецЕсли;

		Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
		Байты = Новый БуферДвоичныхДанных(12);
		Прочитано = Поток.Прочитать(Байты, 0, 12);
		Поток.Закрыть();

		Если Прочитано < 4 Тогда
			Возврат "";
		КонецЕсли;

		Если Байты[0] = 37 И Байты[1] = 80 И Байты[2] = 68 И Байты[3] = 70 Тогда
			Возврат "pdf";
		КонецЕсли;

		Если Байты[0] = 255 И Байты[1] = 216 И Байты[2] = 255 Тогда
			Возврат "jpg";
		КонецЕсли;

		Если Байты[0] = 137 И Байты[1] = 80 И Байты[2] = 78 И Байты[3] = 71
			И Байты[4] = 13 И Байты[5] = 10 И Байты[6] = 26 И Байты[7] = 10 Тогда
			Возврат "png";
		КонецЕсли;

		Если Байты[0] = 71 И Байты[1] = 73 И Байты[2] = 70 Тогда
			Возврат "gif";
		КонецЕсли;

		Если Байты[0] = 66 И Байты[1] = 77 Тогда
			Возврат "bmp";
		КонецЕсли;

		Если Байты[0] = 82 И Байты[1] = 73 И Байты[2] = 70 И Байты[3] = 70
			И Байты[8] = 87 И Байты[9] = 69 И Байты[10] = 66 И Байты[11] = 80 Тогда
			Возврат "webp";
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

// Определяет имя исполняемого файла для выбранного движка конвертации PDF.
// Если задан полный путь - использует его; иначе типовое имя по движку.
//
// Параметры:
//  Движок - Строка - движок (pdftoppm/ghostscript/imagemagick).
//  ПутьКУтилите - Строка - полный путь к утилите (может быть пустым).
//
// Возвращаемое значение:
//  Строка - имя исполняемого файла (пусто, если движок неизвестен).
Функция ОпределитьИмяПрограммы(Движок, ПутьКУтилите)

	Если НЕ ПустаяСтрока(ПутьКУтилите) Тогда
		Возврат ПутьКУтилите;
	КонецЕсли;

	Если Движок = "pdftoppm" Тогда
		Возврат "pdftoppm";
	ИначеЕсли Движок = "ghostscript" Тогда
		Если ОбщегоНазначения.ЭтоWindowsСервер() Тогда
			Возврат "gswin64c";
		Иначе
			Возврат "gs";
		КонецЕсли;
	ИначеЕсли Движок = "imagemagick" Тогда
		Возврат "magick";
	КонецЕсли;

	Возврат "";

КонецФункции

// Собирает командную строку конвертации PDF по выбранному движку.
//
// Параметры:
//  Движок - Строка - движок.
//  ИмяПрограммы - Строка - исполняемый файл.
//  ИмяВходногоФайла - Строка - путь к PDF.
//  ПрефиксВывода - Строка - префикс выходных файлов.
//  МаксимумСтраниц - Число - лимит страниц.
//  DPI - Число - разрешение.
//
// Возвращаемое значение:
//  Массив из Строка - команда для ФайловаяСистема.ЗапуститьПрограмму (argv).
Функция СобратьКомандуКонвертации(Движок, ИмяПрограммы, ИмяВходногоФайла, ПрефиксВывода, МаксимумСтраниц, DPI)

	Команда = Новый Массив;
	Команда.Добавить(ИмяПрограммы);

	Если Движок = "pdftoppm" Тогда
		Команда.Добавить("-jpeg");
		Команда.Добавить("-r");
		Команда.Добавить(Формат(DPI, "ЧДЦ=0; ЧГ=0"));
		Команда.Добавить("-f");
		Команда.Добавить("1");
		Команда.Добавить("-l");
		Команда.Добавить(Формат(МаксимумСтраниц, "ЧДЦ=0; ЧГ=0"));
		Команда.Добавить(ИмяВходногоФайла);
		Команда.Добавить(ПрефиксВывода);
	ИначеЕсли Движок = "ghostscript" Тогда
		Команда.Добавить("-dNOPAUSE");
		Команда.Добавить("-dBATCH");
		Команда.Добавить("-sDEVICE=jpeg");
		Команда.Добавить("-r" + Формат(DPI, "ЧДЦ=0; ЧГ=0"));
		Команда.Добавить("-dFirstPage=1");
		Команда.Добавить("-dLastPage=" + Формат(МаксимумСтраниц, "ЧДЦ=0; ЧГ=0"));
		Команда.Добавить("-sOutputFile=" + ПрефиксВывода + "-%d.jpg");
		Команда.Добавить(ИмяВходногоФайла);
	ИначеЕсли Движок = "imagemagick" Тогда
		Команда.Добавить("-density");
		Команда.Добавить(Формат(DPI, "ЧДЦ=0; ЧГ=0"));
		Команда.Добавить(ИмяВходногоФайла);
		Команда.Добавить(ПрефиксВывода + "-%d.jpg");
	КонецЕсли;

	Возврат Команда;

КонецФункции

// Возвращает новый результат инструмента с признаком неуспеха по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//    * Успех - Булево - Ложь.
//    * Значение - Неопределено.
//    * Ошибка - Строка,Неопределено - Неопределено.
Функция НовыйРезультатИнструмента()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);
	Возврат Результат;

КонецФункции

