#Область ПрограммныйИнтерфейс

// Регистрация внутреннего инструмента в справочнике СИ_ИнструментыАгента.
//
// Параметры:
//  ОписаниеИнструмента - Структура - описание инструмента:
//    * Имя - Строка - уникальное имя функции для модели.
//    * Описание - Строка - описание семантики функции для модели.
//    * Параметры - Структура - JSON Schema параметров функции.
//    * Обработчик - Строка - имя функции BSL в формате "Модуль.Метод".
//    * РазрешенныеРежимы - Массив из СправочникСсылка.СИ_РежимиРаботы,Неопределено - список доступных режимов.
//    * ТребуетРазрешенияПоУмолчанию - Булево,Неопределено - запрашивать подтверждение
//      пользователя перед исполнением (пишущие инструменты); применяется только при
//      СОЗДАНИИ нового элемента, у существующего пользовательский флаг сохраняется.
//    * Группа - Строка,Неопределено - имя группы инструмента (папки иерархии); пусто
//      трактуется как «Основные» (инструменты группы «Основные» всегда передаются
//      в промпт, остальные доступны модели через виртуальный инструмент fetch_toolset).
//      Неопределено - ключ не передан: у существующего элемента группа не меняется.
//      Отсутствующая группа создаётся при регистрации.
//    * Слова - Строка,Неопределено - ключевые слова вопроса через запятую: совпадение
//      поднимает ВСЮ группу инструмента в промпт без fetch_toolset.
//      Неопределено - ключ не передан: у существующего элемента слова не меняются.
//    * Действие - Строка,Неопределено - человекочитаемый статус шага для индикатора чата
//      («Смотрю остатки товара…»); пусто - фолбэк на первую фразу описания.
//      Неопределено - ключ не передан: у существующего элемента действие не меняется.
//
// Возвращаемое значение:
//  Булево - Истина при успешной регистрации или обновлении существующего
//  инструмента, Ложь при ошибке записи или конфликте с MCP-инструментом.
Функция ЗарегистрироватьИнструмент(ОписаниеИнструмента) Экспорт
	Попытка
		Имя = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Имя", "");
		Если ПустаяСтрока(Имя) Тогда
			Возврат Ложь;
		КонецЕсли;

		Описание = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Описание", "");
		Обработчик = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Обработчик", "");
		Параметры = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Параметры", Новый Структура);
		ТребуетРазрешенияПоУмолчанию = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "ТребуетРазрешенияПоУмолчанию", Ложь);
		Группа = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Группа", Неопределено);
		Слова = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Слова", Неопределено);
		Действие = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "Действие", Неопределено);

		СуществующийЭлемент = НайтиЭлементИнструмента(Имя);
		Если СуществующийЭлемент <> Неопределено Тогда
			СуществующийЭлемент.Описание = Описание;
			СуществующийЭлемент.ПараметрыSchema = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Параметры);
			СуществующийЭлемент.ИмяФункцииОбработчика = Обработчик;
			Если Группа <> Неопределено Тогда
				СуществующийЭлемент.Родитель = СсылкаГруппыИнструмента(СокрЛП(Строка(Группа)));
			КонецЕсли;
			Если Слова <> Неопределено Тогда
				СуществующийЭлемент.Слова = СокрЛП(Строка(Слова));
			КонецЕсли;
			Если Действие <> Неопределено Тогда
				СуществующийЭлемент.Действие = СокрЛП(Строка(Действие));
			КонецЕсли;
			СуществующийЭлемент.Записать();
			ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.ЗарегистрироватьИнструмент",
				УровеньЖурналаРегистрации.Информация,
				Метаданные.Справочники.СИ_ИнструментыАгента,
				Имя, "Инструмент уже зарегистрирован - описание и схема обновлены.");
			Возврат Истина;
		КонецЕсли;

		Существующий = ПоискИнструментаПоИмени(Имя);
		Если Существующий <> Неопределено Тогда
			ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.ЗарегистрироватьИнструмент",
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.СИ_ИнструментыАгента,
				Имя, "Конфликт имён: имя " + Имя + " занято MCP-инструментом.");
			Возврат Ложь;
		КонецЕсли;

		РазрешенныеРежимы = СИ_РаботаСJSON.БезопасноПолучить(ОписаниеИнструмента, "РазрешенныеРежимы", Неопределено);

		Элемент = Справочники.СИ_ИнструментыАгента.СоздатьЭлемент();
		Элемент.Наименование = Имя;
		Элемент.ИмяФункции = Имя;
		Элемент.Описание = Описание;
		Элемент.ТипИнструмента = Перечисления.СИ_ТипыИнструментов.Инструмент1С;
		Элемент.ПараметрыSchema = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(Параметры);
		Элемент.ИмяФункцииОбработчика = Обработчик;
		Элемент.Разрешен = Истина;
		Элемент.ТребуетРазрешения = (ТребуетРазрешенияПоУмолчанию = Истина);
		Элемент.ДатаРегистрации = ТекущаяУниверсальнаяДата();
		ИмяГруппы = ?(Группа = Неопределено, "", СокрЛП(Строка(Группа)));
		Элемент.Родитель = СсылкаГруппыИнструмента(ИмяГруппы);
		Если Слова <> Неопределено Тогда
			Элемент.Слова = СокрЛП(Строка(Слова));
		КонецЕсли;
		Если Действие <> Неопределено Тогда
			Элемент.Действие = СокрЛП(Строка(Действие));
		КонецЕсли;

		Если РазрешенныеРежимы <> Неопределено И ТипЗнч(РазрешенныеРежимы) = Тип("Массив") Тогда
			Для Каждого РежимСсылка Из РазрешенныеРежимы Цикл
				Если ТипЗнч(РежимСсылка) = Тип("СправочникСсылка.СИ_РежимиРаботы") И ЗначениеЗаполнено(РежимСсылка) Тогда
					НоваяСтрока = Элемент.РазрешённыеРежимы.Добавить();
					НоваяСтрока.Режим = РежимСсылка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Элемент.Записать();

		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.ЗарегистрироватьИнструмент", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.СИ_ИнструментыАгента,
			, "Ошибка регистрации инструмента: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Дескриптор инструмента для ЗарегистрироватьИнструмент: JSON Schema параметров,
// обработчик, дефолт флага разрешения и значения реестра в одной структуре.
// Собирается здесь один раз, потому что одинаковый блок сборки был продублирован
// в модулях-владельцах инструментов (СИ_Инструменты1С, СИ_ФайлыДиалога).
//
// Параметры:
//  Имя - Строка - реестровое имя инструмента (ИмяФункции).
//  Описание - Строка - описание семантики функции для модели.
//  СвойстваJSON - Соответствие из Строка,Произвольный,Неопределено - схема properties
//    (без "type" и "required"); Неопределено, если у инструмента нет параметров.
//  Обязательные - Массив из Строка,Неопределено - список обязательных параметров.
//  Обработчик - Строка - имя функции-обработчика в формате "Модуль.Функция".
//  ТребуетРазрешения - Булево - запрашивать подтверждение пользователя перед
//    исполнением (пишущие инструменты); дефолт для новой регистрации.
//  ЗначенияРеестра - Структура,Неопределено - группа, ключевые слова и действие
//    инструмента (см. ЗначенияРеестра).
//
// Возвращаемое значение:
//  Структура - описание инструмента (см. ЗарегистрироватьИнструмент):
//    * Имя - Строка.
//    * Описание - Строка.
//    * Параметры - Соответствие из Строка,Произвольный - JSON Schema параметров.
//    * Обработчик - Строка.
//    * РазрешенныеРежимы - Неопределено - режимы задаются в справочнике.
//    * ТребуетРазрешенияПоУмолчанию - Булево.
//  Помимо перечисленного, из значений реестра переносятся группа, ключевые слова
//  и действие инструмента; ключи с пустыми значениями не переносятся.
Функция ДескрипторИнструмента(Имя, Описание, СвойстваJSON, Обязательные, Обработчик,
	ТребуетРазрешения = Ложь, ЗначенияРеестра = Неопределено) Экспорт

	Параметры = Новый Соответствие;
	Параметры.Вставить("type", "object");
	Если СвойстваJSON <> Неопределено Тогда
		Параметры.Вставить("properties", СвойстваJSON);
	КонецЕсли;
	Если Обязательные <> Неопределено Тогда
		Параметры.Вставить("required", Обязательные);
	КонецЕсли;

	ОписаниеИнструмента = Новый Структура;
	ОписаниеИнструмента.Вставить("Имя", Имя);
	ОписаниеИнструмента.Вставить("Описание", Описание);
	ОписаниеИнструмента.Вставить("Параметры", Параметры);
	ОписаниеИнструмента.Вставить("Обработчик", Обработчик);
	ОписаниеИнструмента.Вставить("РазрешенныеРежимы", Неопределено);
	ОписаниеИнструмента.Вставить("ТребуетРазрешенияПоУмолчанию", ТребуетРазрешения);

	Если ТипЗнч(ЗначенияРеестра) = Тип("Структура") Тогда
		Для Каждого Пара Из ЗначенияРеестра Цикл
			ОписаниеИнструмента.Вставить(Пара.Ключ, Пара.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат ОписаниеИнструмента;

КонецФункции

// Значения реестра для инструмента БЕЗ группы и ключевых слов: только
// человекочитаемое действие. Читаемая замена вызову ЗначенияРеестра("", "", Действие).
//
// Параметры:
//  Действие - Строка - человекочитаемый статус шага для индикатора чата.
//
// Возвращаемое значение:
//  Структура - значения реестра для дескриптора инструмента; ключи:
//    * Группа - Строка - всегда пусто: группа инструмента не задаётся.
//    * Слова - Строка - всегда пусто: ключевые слова не задаются.
//    * Действие - Строка - переданное действие.
Функция ЗначенияРеестраДействие(Действие) Экспорт

	Возврат ЗначенияРеестра(, , Действие);

КонецФункции

// Удаление инструмента из реестра по имени.
// Асимметрия намеренная: для MCP-инструмента снимается признак Разрешен в ТЧ Инструменты
// (строка остаётся в кэше сервера), для инструмента 1С — устанавливается пометка удаления
// (элемент справочника СИ_ИнструментыАгента физически не удаляется).
//
// Параметры:
//  Имя - Строка - реестровое имя инструмента.
//
// Возвращаемое значение:
//  Булево - Истина при успешном удалении, Ложь если инструмент не найден.
Функция УдалитьИнструмент(Имя) Экспорт
	Попытка
		Если ПустаяСтрока(Имя) Тогда
			Возврат Ложь;
		КонецЕсли;

		Найденный = ПоискИнструментаПоИмени(Имя);
		Если Найденный = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Найденный.Тип = "1С" Тогда
			Объект = Найденный.Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Объект.УстановитьПометкуУдаления(Истина);
				Объект.Записать();
			КонецЕсли;
		ИначеЕсли Найденный.Тип = "MCP" Тогда
			ОбъектСервера = Найденный.СерверСсылка.ПолучитьОбъект();
			Если ОбъектСервера <> Неопределено Тогда
				Для Каждого СтрокаТЧ Из ОбъектСервера.Инструменты Цикл
					Если СтрокаТЧ.ИмяИнструмента = Найденный.ИмяИнструмента Тогда
						СтрокаТЧ.Разрешен = Ложь;
					КонецЕсли;
				КонецЦикла;
				ОбъектСервера.Записать();
			КонецЕсли;
		КонецЕсли;

		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.УдалитьИнструмент", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.СИ_ИнструментыАгента,
			, "Ошибка удаления инструмента: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Получение полного описания инструмента по реестровому имени.
//
// Параметры:
//  Имя - Строка - реестровое имя инструмента.
//
// Возвращаемое значение:
//  Структура,Неопределено - описание инструмента или Неопределено при отсутствии:
//    * Имя - Строка - реестровое имя.
//    * Описание - Строка - описание инструмента.
//    * Разрешен - Булево - признак доступности.
//    * ТребуетРазрешения - Булево - запрашивать подтверждение пользователя перед исполнением.
//    * Параметры - Соответствие - JSON-схема параметров (ключ Строка, значение Произвольный).
//    * Группа - Строка - семантическая группа (пустая трактуется как «Основные»).
//    * Слова - Строка - ключевые слова вопроса через запятую.
//    * Действие - Строка - человекочитаемый статус шага (может быть пустой).
//    * Тип - Строка - "1С" или "MCP".
//    * Обработчик - Строка,Неопределено - для 1С: имя функции "Модуль.Метод".
//    * РазрешенныеРежимы - Массив из СправочникСсылка.СИ_РежимиРаботы,Неопределено - список разрешённых режимов.
//    * СерверСсылка - СправочникСсылка.СИ_MCPСерверы,Неопределено - сервер (для Тип="MCP").
//    * ИмяИнструмента - Строка,Неопределено - имя инструмента на сервере (для Тип="MCP").
Функция ПолучитьОписаниеИнструмента(Имя) Экспорт
	Попытка
		Если ПустаяСтрока(Имя) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Найденный = ПоискИнструментаПоИмени(Имя);
		Если Найденный = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Возврат Найденный;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.ПолучитьОписаниеИнструмента", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.СИ_ИнструментыАгента,
			, "Ошибка получения инструмента: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Получение списка описаний инструментов с возможностью фильтрации.
// Объединяет внутренние инструменты (СИ_ИнструментыАгента) и MCP-инструменты
// (ТЧ Инструменты включённых серверов СИ_MCPСерверы).
//
// Параметры:
//  Фильтр - Структура,Неопределено - параметры фильтрации:
//    * Тип - Строка,Неопределено - "1С" или "MCP".
//    * РазрешенныйРежим - СправочникСсылка.СИ_РежимиРаботы,Неопределено - фильтр по режиму.
//    * Имена - Массив из Строка,Неопределено - белый список реестровых имён.
//
// Возвращаемое значение:
//  Массив Из Структура - массив описаний инструментов.
Функция ПолучитьСписокИнструментов(Фильтр) Экспорт
	Результат = Новый Массив;

	Попытка
		ТипФильтр = СИ_РаботаСJSON.БезопасноПолучить(Фильтр, "Тип", Неопределено);
		ИменаФильтр = СИ_РаботаСJSON.БезопасноПолучить(Фильтр, "Имена", Неопределено);
		РазрешенныйРежим = СИ_РаботаСJSON.БезопасноПолучить(Фильтр, "РазрешенныйРежим", Неопределено);

		Если ТипФильтр = Неопределено ИЛИ ТипФильтр = "1С" Тогда
			Внутренние = ПолучитьВнутренниеИнструменты(ИменаФильтр, РазрешенныйРежим);
			Для Каждого Описание Из Внутренние Цикл
				Результат.Добавить(Описание);
			КонецЦикла;
		КонецЕсли;

		Если ТипФильтр = Неопределено ИЛИ ТипФильтр = "MCP" Тогда
			MCPИнструменты = ПолучитьMCPИнструменты(ИменаФильтр, РазрешенныйРежим);
			Для Каждого Описание Из MCPИнструменты Цикл
				Результат.Добавить(Описание);
			КонецЦикла;
		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.ПолучитьСписокИнструментов", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.СИ_ИнструментыАгента,
			, "Ошибка получения списка инструментов: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Универсальный диспетчер вызова инструмента по имени с маршрутизацией.
//
// Параметры:
//  Имя - Строка - реестровое имя инструмента.
//  Аргументы - Соответствие - распарсенные аргументы функции (ключ Строка, значение Произвольный).
//    Допускается также Структура.
//  Контекст - Структура - контекст вызова:
//    * ИдДиалога - Строка - идентификатор диалога.
//    * ИдВызова - Строка - call_id из ответа модели.
//    * Режим - СправочникСсылка.СИ_РежимиРаботы - режим работы агента.
//
// Возвращаемое значение:
//  Структура - результат вызова инструмента:
//    * Успех - Булево.
//    * Результат - Строка - JSON-сериализованный результат (для успешных вызовов).
//    * ОшибкаИсполнения - Строка,Неопределено.
//    * НетПрав - Булево - Истина, если инструмент упал на правах доступа
//      (в ОшибкаИсполнения при этом лежит инструкция «ДОСТУП ЗАПРЕЩЁН ...»).
//    * Диаграмма - Структура,Неопределено - служебная карточка DrawChart
//      (SVG, Заголовок, Подпись, УИДФайла, ИмяФайла), изъятая из значения
//      результата до сериализации для модели.
//    * ДлительностьМс - Число.
Функция ВызватьИнструмент(Имя, Аргументы, Контекст) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Результат", "");
	Результат.Вставить("ОшибкаИсполнения", Неопределено);
	Результат.Вставить("НетПрав", Ложь);
	Результат.Вставить("ДлительностьМс", 0);
	Результат.Вставить("Диаграмма", Неопределено);

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Описание = ПолучитьОписаниеИнструмента(Имя);
		Если Описание = Неопределено Тогда
			Результат.ОшибкаИсполнения = "Инструмент не найден: " + Имя;
			Результат.ДлительностьМс = РассчитатьДлительностьМс(НачалоВызова);
			Возврат Результат;
		КонецЕсли;

		РежимВызова = СИ_РаботаСJSON.БезопасноПолучить(Контекст, "Режим", Неопределено);
		Если РежимВызова <> Неопределено Тогда
			РежимыИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Описание, "РазрешенныеРежимы", Неопределено);
			Если РежимыИнструмента <> Неопределено И ТипЗнч(РежимыИнструмента) = Тип("Массив") И РежимыИнструмента.Количество() > 0 Тогда
				РежимДоступен = Ложь;
				Для Каждого ДопустимыйРежим Из РежимыИнструмента Цикл
					Если ДопустимыйРежим = РежимВызова Тогда
						РежимДоступен = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ РежимДоступен Тогда
					Результат.ОшибкаИсполнения = "Инструмент " + Имя + " не разрешён в режиме " + Строка(РежимВызова);
					Результат.ДлительностьМс = РассчитатьДлительностьМс(НачалоВызова);
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		ТипИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Описание, "Тип", "1С");

		Если ТипИнструмента = "MCP" Тогда
			СерверСсылка = СИ_РаботаСJSON.БезопасноПолучить(Описание, "СерверСсылка", Неопределено);
			ИмяИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Описание, "ИмяИнструмента", "");

			Если СерверСсылка = Неопределено ИЛИ ПустаяСтрока(ИмяИнструмента) Тогда
				Результат.ОшибкаИсполнения = "Некорректное описание MCP-инструмента: " + Имя;
				Результат.ДлительностьМс = РассчитатьДлительностьМс(НачалоВызова);
				Возврат Результат;
			КонецЕсли;

			РезультатВызова = СИ_УправлениеИнструментамиMCP.ВызватьИнструмент(СерверСсылка, ИмяИнструмента, Аргументы);
			Результат.Успех = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Успех", Ложь);
			Результат.Результат = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "Результат", "");
			Результат.ОшибкаИсполнения = СИ_РаботаСJSON.БезопасноПолучить(РезультатВызова, "ОшибкаИсполнения", Неопределено);

		ИначеЕсли ТипИнструмента = "1С" Тогда
			ИмяОбработчика = СИ_РаботаСJSON.БезопасноПолучить(Описание, "Обработчик", "");
			Если ПустаяСтрока(ИмяОбработчика) Тогда
				Результат.ОшибкаИсполнения = "Не указан обработчик для инструмента: " + Имя;
				Результат.ДлительностьМс = РассчитатьДлительностьМс(НачалоВызова);
				Возврат Результат;
			КонецЕсли;

			Точка = СтрНайти(ИмяОбработчика, ".");
			Если Точка = 0 Тогда
				Результат.ОшибкаИсполнения = "Некорректный формат обработчика: " + ИмяОбработчика;
				Результат.ДлительностьМс = РассчитатьДлительностьМс(НачалоВызова);
				Возврат Результат;
			КонецЕсли;

			ИмяМодуля = Лев(ИмяОбработчика, Точка - 1);
			ИмяМетодаОбработчика = Сред(ИмяОбработчика, Точка + 1);

			Попытка
				ИсполняемыеАргументы = Аргументы;
				Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
					ИсполняемыеАргументы = СИ_РаботаСJSON.СоответствиеВСтруктуру(Аргументы);
				КонецЕсли;

				РезультатОбработчика = ВыполнитьОбработчик(ИмяМодуля, ИмяМетодаОбработчика, ИсполняемыеАргументы);

				Результат.Успех = СИ_РаботаСJSON.БезопасноПолучить(РезультатОбработчика, "Успех", Ложь);
				ЗначениеРезультата = СИ_РаботаСJSON.БезопасноПолучить(РезультатОбработчика, "Значение", Неопределено);

				СсылкиОбъектовРезультата = Неопределено;
				Если ТипЗнч(ЗначениеРезультата) = Тип("Структура")
					И ЗначениеРезультата.Свойство("СсылкиОбъектов") Тогда
					СсылкиОбъектовРезультата = ЗначениеРезультата.СсылкиОбъектов;
					ЗначениеРезультата.Удалить("СсылкиОбъектов");
				КонецЕсли;

				ДиаграммаРезультата = Неопределено;
				Если ТипЗнч(ЗначениеРезультата) = Тип("Структура")
					И ЗначениеРезультата.Свойство("Диаграмма") Тогда
					ДиаграммаРезультата = ЗначениеРезультата.Диаграмма;
					ЗначениеРезультата.Удалить("Диаграмма");
				КонецЕсли;

				// До сериализации: модель переносит табличные данные в markdown-таблицу
				// ответа, где «|» в значениях ломает разметку GFM-таблицы.
				ПрименитьГигиенуРезультата(Имя, ЗначениеРезультата);

				Если ЗначениеРезультата <> Неопределено Тогда
					Результат.Результат = СИ_РаботаСJSON.ЗаписатьСтрокуJSON(ЗначениеРезультата);
				КонецЕсли;

				КартаСсылок = СобратьСсылкиДокументов(ЗначениеРезультата, СсылкиОбъектовРезультата);
				Если КартаСсылок.Количество() > 0 Тогда
					Результат.Вставить("СсылкиДокументов", КартаСсылок);
				КонецЕсли;

				Если ТипЗнч(ДиаграммаРезультата) = Тип("Структура") Тогда
					Результат.Диаграмма = ДиаграммаРезультата;
				КонецЕсли;

				Ошибка = СИ_РаботаСJSON.БезопасноПолучить(РезультатОбработчика, "Ошибка", Неопределено);
				Если Ошибка <> Неопределено Тогда
					Результат.ОшибкаИсполнения = Ошибка;
				КонецЕсли;
			Исключение
				Если ЭтоОтказПоДоступуПлатформы(ИнформацияОбОшибке()) Тогда
					Результат.ОшибкаИсполнения = ИнструкцияОтказаПоДоступу();
					Результат.НетПрав = Истина;
					Результат.Вставить("КодОшибки", КодОтказаПоДоступу());
				Иначе
					Результат.ОшибкаИсполнения = "Ошибка выполнения " + ИмяОбработчика + ": " + ОписаниеОшибки();
				КонецЕсли;
			КонецПопытки;
		Иначе
			Результат.ОшибкаИсполнения = "Неподдерживаемый тип инструмента: " + ТипИнструмента;
		КонецЕсли;

	Исключение
		Если ЭтоОтказПоДоступуПлатформы(ИнформацияОбОшибке()) Тогда
			Результат.ОшибкаИсполнения = ИнструкцияОтказаПоДоступу();
			Результат.НетПрав = Истина;
			Результат.Вставить("КодОшибки", КодОтказаПоДоступу());
		Иначе
			Результат.ОшибкаИсполнения = "Ошибка диспетчеризации инструмента " + Имя + ": " + ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;

	ПрименитьПравилаОшибок(Результат);

	Результат.ДлительностьМс = РассчитатьДлительностьМс(НачалоВызова);
	Возврат Результат;
КонецФункции

// Формирование списка описаний в формате, готовом к передаче в поле tools API.
// Формат соответствует OpenAI function-calling: ключи type/name/description/parameters
// (латиница) — допустимо для OpenAI-совместимых endpoint'ов.
//
// Параметры:
//  ИменаИнструментов - Массив из Строка,Неопределено - список имён инструментов;
//    при Неопределено используются все зарегистрированные.
//  Режим - СправочникСсылка.СИ_РежимиРаботы,Неопределено - режим работы агента;
//    при Неопределено фильтрация по режиму не применяется.
//
// Возвращаемое значение:
//  Массив из Структура - массив в формате поля tools API.
Функция СформироватьПолеТools(ИменаИнструментов, Режим = Неопределено) Экспорт
	Результат = Новый Массив;

	Попытка
		Фильтр = Неопределено;
		Если ИменаИнструментов <> Неопределено И ТипЗнч(ИменаИнструментов) = Тип("Массив") И ИменаИнструментов.Количество() > 0 Тогда
			Фильтр = Новый Структура("Имена", ИменаИнструментов);
		КонецЕсли;

		РежимФильтр = Режим;
		Если РежимФильтр <> Неопределено Тогда
			Если Фильтр = Неопределено Тогда
				Фильтр = Новый Структура("РазрешенныйРежим", РежимФильтр);
			Иначе
				Фильтр.Вставить("РазрешенныйРежим", РежимФильтр);
			КонецЕсли;
		КонецЕсли;

		Инструменты = ПолучитьСписокИнструментов(Фильтр);
		Результат = СформироватьПолеТoolsИзОписаний(Инструменты);

	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.СформироватьПолеТools", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.СИ_ИнструментыАгента,
			, "Ошибка формирования tools: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Формирование поля tools из уже полученных описаний инструментов.
// Отделено от СформироватьПолеТools, чтобы подбор инструментов шага
// (СИ_Агент1С.СхемыИнструментовДляШага) строил запрос по УЖЕ прочитанному списку
// описаний - без повторного запроса к справочнику на каждом шаге цикла.
//
// Параметры:
//  Описания - Массив из Структура - описания инструментов
//    (см. ПолучитьСписокИнструментов).
//
// Возвращаемое значение:
//  Массив из Структура - массив в формате поля tools API.
Функция СформироватьПолеТoolsИзОписаний(Описания) Экспорт
	Результат = Новый Массив;

	Если ТипЗнч(Описания) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Описание Из Описания Цикл
		Имя = СИ_РаботаСJSON.БезопасноПолучить(Описание, "Имя", "");
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;

		ИнструментAPI = Новый Соответствие;
		ИнструментAPI.Вставить("type", "function");

		ФункцияОбъект = Новый Соответствие;
		ФункцияОбъект.Вставить("name", Имя);
		ФункцияОбъект.Вставить("description", СИ_РаботаСJSON.БезопасноПолучить(Описание, "Описание", ""));
		ФункцияОбъект.Вставить("parameters", СИ_РаботаСJSON.БезопасноПолучить(Описание, "Параметры", Новый Соответствие));

		ИнструментAPI.Вставить("function", ФункцияОбъект);
		Результат.Добавить(ИнструментAPI);
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Инструкция для модели при отказе в доступе: единая формулировка для всех
// инструментов. Задача текста - остановить попытки обойти права и перевести
// разговор на администратора базы.
//
// Возвращаемое значение:
//  Строка - инструкция для модели.
Функция ИнструкцияОтказаПоДоступу() Экспорт

	Возврат МаркерОтказаПоДоступу()
		+ ". У текущего пользователя нет прав чтения этих данных. "
		+ "Не ищите обходные пути и не повторяйте запрос другими инструментами: "
		+ "сообщите пользователю, что доступ к данным назначает администратор базы.";

КонецФункции

// Код отказа в доступе для типизированных результатов обработчиков.
//
// Возвращаемое значение:
//  Строка - код ошибки.
Функция КодОтказаПоДоступу() Экспорт

	Возврат "ДоступЗапрещён";

КонецФункции

// Признак отказа в доступе по информации об исключении платформы.
//
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке - информация об исключении.
//
// Возвращаемое значение:
//  Булево - Истина, если исключение вызвано нехваткой прав.
Функция ЭтоОтказПоДоступуПлатформы(ИнформацияОбОшибке) Экспорт

	Возврат ЭтоОтказПоДоступуВТексте(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

КонецФункции

// Признак отказа в доступе по тексту ошибки: применяется к ошибкам, которые
// обработчик вернул строкой, и к тексту исключения платформы. Проверяются
// только специфичные формулировки платформы: широкое «нет прав» не
// используется, чтобы не поймать обычный текст данных или описание инструмента.
//
// Параметры:
//  Текст - Строка - текст ошибки.
//
// Возвращаемое значение:
//  Булево - Истина, если текст сообщает о нехватке прав.
Функция ЭтоОтказПоДоступуВТексте(Текст) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстНРег = НРег(Текст);
	Возврат СтрНайти(ТекстНРег, "недостаточно прав") > 0
		ИЛИ СтрНайти(ТекстНРег, "нарушение прав доступа") > 0
		ИЛИ СтрНачинаетсяС(СокрЛП(Текст), МаркерОтказаПоДоступу());

КонецФункции

// Значения реестра инструмента (группа, ключевые слова, действие) для дескриптора
// регистрации (см. ЗарегистрироватьИнструмент). Ключ попадает в результат ТОЛЬКО
// для непустого значения: реестр обновляет эти реквизиты лишь при явной передаче
// ключа, поэтому пустое значение не должно затирать правки администратора
// в справочнике при повторной регистрации инструмента из кода.
//
// Параметры:
//  Группа - Строка - семантическая группа инструмента.
//  Слова - Строка - ключевые слова вопроса через запятую.
//  Действие - Строка - человекочитаемый статус шага для индикатора чата.
//
// Возвращаемое значение:
//  Структура - значения реестра для дескриптора инструмента; может быть ПУСТОЙ
//  (ключ не передаётся, если соответствующее значение пустое):
//    * Группа - Строка - семантическая группа инструмента.
//    * Слова - Строка - ключевые слова вопроса через запятую.
//    * Действие - Строка - человекочитаемый статус шага для индикатора чата.
Функция ЗначенияРеестра(Группа = "", Слова = "", Действие = "") Экспорт

	Результат = Новый Структура;
	Если НЕ ПустаяСтрока(Группа) Тогда
		Результат.Вставить("Группа", Группа);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Слова) Тогда
		Результат.Вставить("Слова", Слова);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Действие) Тогда
		Результат.Вставить("Действие", Действие);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Имя группы инструментов по умолчанию. Инструменты этой группы всегда передаются
// модели в промпте; в каталог виртуального инструмента fetch_toolset они не прячутся.
//
// Возвращаемое значение:
//  Строка - имя группы по умолчанию.
Функция ГруппаИнструментаПоУмолчанию() Экспорт

	Возврат "Основные";

КонецФункции

// Группа инструмента по его описанию. Пустая группа трактуется как группа
// по умолчанию: реквизит не заполнен у инструментов, зарегистрированных до
// появления групп, и они должны вести себя как раньше (всегда в промпте).
//
// Параметры:
//  Описание - Структура,Неопределено - описание инструмента
//    (см. ПолучитьОписаниеИнструмента).
//
// Возвращаемое значение:
//  Строка - имя группы инструмента.
Функция ГруппаИнструментаПоОписанию(Описание) Экспорт

	Группа = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Группа", "")));
	Возврат ?(ПустаяСтрока(Группа), ГруппаИнструментаПоУмолчанию(), Группа);

КонецФункции

// Краткое действие инструмента - первая фраза описания, до 120 знаков.
// Используется как фолбэк статуса шага в индикаторе чата, когда реквизит
// «Действие» не заполнен (в том числе для MCP-инструментов, у которых
// человекочитаемого действия нет вовсе).
//
// Параметры:
//  ОписаниеТекст - Строка - текст описания инструмента.
//
// Возвращаемое значение:
//  Строка - первая фраза описания (пустая, если описания нет).
Функция КраткоеДействиеИнструмента(Знач ОписаниеТекст) Экспорт

	Текст = СокрЛП(ОписаниеТекст);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	ДлинаТекста = СтрДлина(Текст);
	ПозицияКонца = ДлинаТекста + 1;
	Для Инд = 1 По ДлинаТекста Цикл
		Символ = Сред(Текст, Инд, 1);
		Если Символ = Символы.ПС ИЛИ Символ = Символы.ВК ИЛИ Символ = "." Тогда
			ПозицияКонца = Инд;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Фраза = СокрЛП(Лев(Текст, ПозицияКонца - 1));
	Если ПустаяСтрока(Фраза) Тогда
		Фраза = Текст;
	КонецЕсли;

	Если СтрДлина(Фраза) > МаксимальнаяДлинаКраткогоДействия() Тогда
		Фраза = Лев(Фраза, МаксимальнаяДлинаКраткогоДействия() - 1) + "…";
	КонецЕсли;

	Возврат Фраза;

КонецФункции

// Человекочитаемое действие инструмента (статус шага в индикаторе чата):
// реквизит «Действие», иначе первая фраза описания, иначе имя инструмента.
//
// Параметры:
//  Описание - Структура,Неопределено - описание инструмента.
//  Имя - Строка - реестровое имя инструмента (фолбэк, когда описания нет).
//
// Возвращаемое значение:
//  Строка - статус шага; пустая, только если пусто и имя.
Функция ДействиеИнструментаПоОписанию(Знач Описание, Знач Имя = "") Экспорт

	Действие = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Действие", "")));
	Если НЕ ПустаяСтрока(Действие) Тогда
		Возврат Действие;
	КонецЕсли;

	ИзОписания = КраткоеДействиеИнструмента(
		СИ_РаботаСJSON.БезопасноПолучить(Описание, "Описание", ""));
	Если НЕ ПустаяСтрока(ИзОписания) Тогда
		Возврат ИзОписания;
	КонецЕсли;

	Возврат СокрЛП(Имя);

КонецФункции

// Действия всех зарегистрированных инструментов одной выборкой -
// кэш статусов шага на заход агента (индикатор чата не должен ходить
// в справочник на каждый вызов инструмента).
//
// Возвращаемое значение:
//  Соответствие из Строка, Строка - ключ НРег(реестровое имя), значение - действие.
Функция ДействияИнструментов() Экспорт

	Результат = Новый Соответствие;

	Попытка
		Для Каждого Описание Из ПолучитьСписокИнструментов(Неопределено) Цикл
			Имя = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Имя", "")));
			Если ПустаяСтрока(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Вставить(НРег(Имя), ДействиеИнструментаПоОписанию(Описание, Имя));
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.ДействияИнструментов",
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Справочники.СИ_ИнструментыАгента,,
			"Ошибка сбора действий инструментов: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Реестровые имена инструментов заданной семантической группы.
// Группа «Основные» (или пустая строка) - инструменты, которые всегда передаются
// модели в промпте; остальные группы поднимаются каталогом fetch_toolset.
//
// Параметры:
//  Группа - Строка - имя группы; пустая строка = группа по умолчанию.
//  Режим - СправочникСсылка.СИ_РежимиРаботы,Неопределено - режим работы агента;
//    при Неопределено фильтрация по режиму не применяется.
//
// Возвращаемое значение:
//  Массив из Строка - реестровые имена инструментов группы.
Функция ИнструментыПоГруппе(Знач Группа, Знач Режим = Неопределено) Экспорт

	Результат = Новый Массив;

	ИмяГруппы = СокрЛП(Строка(Группа));
	Если ПустаяСтрока(ИмяГруппы) Тогда
		ИмяГруппы = ГруппаИнструментаПоУмолчанию();
	КонецЕсли;

	Фильтр = Неопределено;
	Если Режим <> Неопределено Тогда
		Фильтр = Новый Структура("РазрешенныйРежим", Режим);
	КонецЕсли;

	Для Каждого Описание Из ПолучитьСписокИнструментов(Фильтр) Цикл
		Если ГруппаИнструментаПоОписанию(Описание) <> ИмяГруппы Тогда
			Продолжить;
		КонецЕсли;
		Имя = СокрЛП(Строка(СИ_РаботаСJSON.БезопасноПолучить(Описание, "Имя", "")));
		Если НЕ ПустаяСтрока(Имя) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Максимальная длина краткого действия инструмента (см. КраткоеДействиеИнструмента).
//
// Возвращаемое значение:
//  Число - предельная длина строки статуса.
Функция МаксимальнаяДлинаКраткогоДействия() Экспорт

	Возврат 120;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Уникальное начало текста отказа. По нему отказ, сформированный обработчиком
// инструмента, распознаётся повторно при постобработке результата.
//
// Возвращаемое значение:
//  Строка - маркер отказа.
Функция МаркерОтказаПоДоступу()

	Возврат "ДОСТУП ЗАПРЕЩЁН";

КонецФункции

// Получение внутренних (1С) инструментов из справочника СИ_ИнструментыАгента.
// Режимы из ТЧ РазрешённыеРежимы выбираются одним запросом и группируются по ссылке —
// без ПолучитьОбъект() в цикле.
//
// Параметры:
//  ИменаФильтр - Массив из Строка,Неопределено - белый список имён.
//  РазрешенныйРежим - СправочникСсылка.СИ_РежимиРаботы,Неопределено - фильтр по режиму.
//
// Возвращаемое значение:
//  Массив из Структура - описания внутренних инструментов.
Функция ПолучитьВнутренниеИнструменты(ИменаФильтр, РазрешенныйРежим)
	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИнструментыАгента.Ссылка,
	|	ИнструментыАгента.ИмяФункции,
	|	ИнструментыАгента.Описание,
	|	ИнструментыАгента.Разрешен,
	|	ИнструментыАгента.ТребуетРазрешения,
	|	ИнструментыАгента.ПараметрыSchema,
	|	ИнструментыАгента.ИмяФункцииОбработчика,
	|	ЕСТЬNULL(ИнструментыАгента.Родитель.Наименование, """") КАК Группа,
	|	ИнструментыАгента.Слова,
	|	ИнструментыАгента.Действие
	|ИЗ
	|	Справочник.СИ_ИнструментыАгента КАК ИнструментыАгента
	|ГДЕ
	|	ИнструментыАгента.Разрешен = Истина
	|	И ИнструментыАгента.ТипИнструмента = &ТипИнструмента
	|	И ИнструментыАгента.ПометкаУдаления = Ложь
	|	И НЕ ИнструментыАгента.ЭтоГруппа";
	Запрос.УстановитьПараметр("ТипИнструмента", Перечисления.СИ_ТипыИнструментов.Инструмент1С);

	Если ИменаФильтр <> Неопределено И ТипЗнч(ИменаФильтр) = Тип("Массив") И ИменаФильтр.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ИнструментыАгента.ИмяФункции В (&Имена)";
		Запрос.УстановитьПараметр("Имена", ИменаФильтр);
	КонецЕсли;

	ДанныеПоСсылке = Новый Соответствие;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеИнструмента = Новый Структура;
		ДанныеИнструмента.Вставить("Имя", Выборка.ИмяФункции);
		ДанныеИнструмента.Вставить("Описание", Выборка.Описание);
		ДанныеИнструмента.Вставить("Разрешен", Выборка.Разрешен);
		ДанныеИнструмента.Вставить("ТребуетРазрешения", Выборка.ТребуетРазрешения);
		ДанныеИнструмента.Вставить("ПараметрыSchema", Выборка.ПараметрыSchema);
		ДанныеИнструмента.Вставить("ИмяФункцииОбработчика", Выборка.ИмяФункцииОбработчика);
		ДанныеИнструмента.Вставить("Ссылка", Выборка.Ссылка);
		ДанныеИнструмента.Вставить("Группа", Выборка.Группа);
		ДанныеИнструмента.Вставить("Слова", Выборка.Слова);
		ДанныеИнструмента.Вставить("Действие", Выборка.Действие);
		ДанныеПоСсылке.Вставить(Выборка.Ссылка, ДанныеИнструмента);
	КонецЦикла;

	РежимыПоСсылке = Новый Соответствие;

	СсылкиИнструментов = Новый Массив;
	Для Каждого СсылкаДанные Из ДанныеПоСсылке Цикл
		СсылкиИнструментов.Добавить(СсылкаДанные.Ключ);
	КонецЦикла;

	Если СсылкиИнструментов.Количество() > 0 Тогда
		ЗапросРежимов = Новый Запрос;
		ЗапросРежимов.Текст =
		"ВЫБРАТЬ
		|	РазрешённыеРежимы.Ссылка КАК Ссылка,
		|	РазрешённыеРежимы.Режим КАК Режим
		|ИЗ
		|	Справочник.СИ_ИнструментыАгента.РазрешённыеРежимы КАК РазрешённыеРежимы
		|ГДЕ
		|	РазрешённыеРежимы.Ссылка В (&Ссылки)";
		ЗапросРежимов.УстановитьПараметр("Ссылки", СсылкиИнструментов);
		ВыборкаРежимов = ЗапросРежимов.Выполнить().Выбрать();
		Пока ВыборкаРежимов.Следующий() Цикл
			РежимыСсылки = РежимыПоСсылке.Получить(ВыборкаРежимов.Ссылка);
			Если РежимыСсылки = Неопределено Тогда
				РежимыСсылки = Новый Массив;
				РежимыПоСсылке.Вставить(ВыборкаРежимов.Ссылка, РежимыСсылки);
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыборкаРежимов.Режим) Тогда
				РежимыСсылки.Добавить(ВыборкаРежимов.Режим);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого СсылкаДанные Из ДанныеПоСсылке Цикл
		Режимы = РежимыПоСсылке.Получить(СсылкаДанные.Ключ);
		Если Режимы = Неопределено Тогда
			Режимы = Новый Массив;
		КонецЕсли;
		Описание = ИнструментВСтруктуру(СсылкаДанные.Значение, Режимы);
		Если Описание <> Неопределено Тогда
			Если РазрешенныйРежим <> Неопределено И НЕ ИнструментДоступенВРежиме(Описание, РазрешенныйРежим) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Получение MCP-инструментов из ТЧ Инструменты всех включённых серверов.
// Выполняет разрешение коллизий имён: API-имя = ИмяИнструмента, если свободно,
// иначе "Идентификатор.ИмяИнструмента". Объект сервера загружается один раз на сервер.
//
// Параметры:
//  ИменаФильтр - Массив из Строка,Неопределено - белый список API-имён.
//  РазрешенныйРежим - СправочникСсылка.СИ_РежимиРаботы,Неопределено - фильтр по режиму.
//
// Возвращаемое значение:
//  Массив из Структура - описания MCP-инструментов.
Функция ПолучитьMCPИнструменты(ИменаФильтр, РазрешенныйРежим)
	Результат = Новый Массив;

	ЗанятыеИмена = ИменаВнутреннихИнструментов();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Инструменты.Ссылка КАК Сервер,
	|	Инструменты.ИмяИнструмента,
	|	Инструменты.Описание,
	|	Инструменты.ПараметрыSchema,
	|	Инструменты.Разрешен,
	|	Инструменты.ДатаРегистрации
	|ИЗ
	|	Справочник.СИ_MCPСерверы.Инструменты КАК Инструменты
	|ГДЕ
	|	Инструменты.Разрешен = Истина
	|	И Инструменты.Ссылка.Включен = Истина
	|	И Инструменты.Ссылка.ПометкаУдаления = Ложь";

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	КешСерверов = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		ИмяИнструмента = СокрЛП(Выборка.ИмяИнструмента);
		Если ПустаяСтрока(ИмяИнструмента) Тогда
			Продолжить;
		КонецЕсли;

		ДанныеСервера = ДанныеMCPСервера(Выборка.Сервер, КешСерверов);
		Если ДанныеСервера = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяAPI = РазрешитьAPIИмяMCP(ИмяИнструмента, ДанныеСервера.Идентификатор, ЗанятыеИмена);

		Если ИменаФильтр <> Неопределено И ТипЗнч(ИменаФильтр) = Тип("Массив") И ИменаФильтр.Количество() > 0 Тогда
			Если НЕ ИменаФильтр.Найти(ИмяAPI) И НЕ ИменаФильтр.Найти(ИмяИнструмента) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Описание = ИнструментMCPВСтруктуру(Выборка.Сервер, ИмяИнструмента, ДанныеСервера);
		Если Описание = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Описание.Вставить("Имя", ИмяAPI);

		Если РазрешенныйРежим <> Неопределено И НЕ ИнструментДоступенВРежиме(Описание, РазрешенныйРежим) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Конвертация данных строки выборки СИ_ИнструментыАгента в структуру описания.
// Данные (включая режимы) уже получены запросом — ПолучитьОбъект() не выполняется.
//
// Параметры:
//  Данные - Структура - данные инструмента из запроса:
//    * Имя - Строка - имя функции.
//    * Описание - Строка.
//    * Разрешен - Булево.
//    * ПараметрыSchema - Строка - JSON-строка схемы параметров.
//    * ИмяФункцииОбработчика - Строка - "Модуль.Метод".
//    * Ссылка - СправочникСсылка.СИ_ИнструментыАгента - ссылка (сохраняется в описании).
//  Режимы - Массив из СправочникСсылка.СИ_РежимиРаботы - разрешённые режимы (может быть пустым).
//
// Возвращаемое значение:
//  Структура,Неопределено - описание инструмента:
//    * Имя - Строка - уникальное имя инструмента.
//    * Описание - Строка - описание инструмента.
//    * Разрешен - Булево - признак доступности.
//    * ТребуетРазрешения - Булево - запрашивать подтверждение пользователя перед исполнением.
//    * Параметры - Соответствие - JSON-схема параметров (ключ Строка, значение Произвольный).
//    * Группа - Строка - группа (пустая нормализуется в «Основные»).
//    * Слова - Строка - ключевые слова вопроса через запятую.
//    * Действие - Строка - реквизит «Действие» (может быть пустой).
//    * Тип - Строка - "1С".
//    * Обработчик - Строка - имя функции "Модуль.Метод".
//    * РазрешенныеРежимы - Массив из СправочникСсылка.СИ_РежимиРаботы.
//    * Ссылка - СправочникСсылка.СИ_ИнструментыАгента.
Функция ИнструментВСтруктуру(Данные, Режимы)
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Имя", Данные.Имя);
	Описание.Вставить("Описание", Данные.Описание);
	Описание.Вставить("Разрешен", Данные.Разрешен);
	Описание.Вставить("ТребуетРазрешения", Данные.ТребуетРазрешения);
	Описание.Вставить("Ссылка", Данные.Ссылка);
	Описание.Вставить("Группа", ?(ПустаяСтрока(СокрЛП(Строка(Данные.Группа))),
		ГруппаИнструментаПоУмолчанию(), СокрЛП(Строка(Данные.Группа))));
	Описание.Вставить("Слова", СокрЛП(Строка(Данные.Слова)));
	Описание.Вставить("Действие", СокрЛП(Строка(Данные.Действие)));

	ПараметрыСтрока = Данные.ПараметрыSchema;
	ПараметрыРаспарс = Новый Соответствие;
	Если Не ПустаяСтрока(ПараметрыСтрока) Тогда
		Распарс = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(ПараметрыСтрока);
		Если Распарс <> Неопределено Тогда
			ПараметрыРаспарс = Распарс;
		КонецЕсли;
	КонецЕсли;
	Описание.Вставить("Параметры", ПараметрыРаспарс);

	Описание.Вставить("Тип", "1С");
	Описание.Вставить("Обработчик", Данные.ИмяФункцииОбработчика);

	Описание.Вставить("РазрешенныеРежимы", Режимы);

	Возврат Описание;
КонецФункции

// Конвертация MCP-инструмента (строка ТЧ сервера) в структуру описания.
// Данные сервера (Инструменты и РежимыИнструментов) уже загружены один раз — см. ДанныеMCPСервера.
//
// Параметры:
//  СерверСсылка - СправочникСсылка.СИ_MCPСерверы - сервер-владелец.
//  ИмяИнструмента - Строка - имя инструмента на сервере.
//  ДанныеСервера - Структура - результат ДанныеMCPСервера:
//    * ДанныеИнструментов - Соответствие ИмяИнструмента -> СтрокаТЧ.
//    * РежимыПоИмени - Соответствие ИмяИнструмента -> Массив(Режим).
//    * Идентификатор - Строка.
//
// Возвращаемое значение:
//  Структура,Неопределено - описание:
//    * Имя - Строка - API-имя (заполняется после разрешения коллизий).
//    * Описание - Строка.
//    * Параметры - Соответствие - JSON-схема параметров (ключ Строка, значение Произвольный).
//    * ТребуетРазрешения - Булево - запрашивать подтверждение пользователя перед исполнением.
//    * Группа - Строка - «Основные» (у MCP-инструментов группы нет).
//    * Слова - Строка - всегда пустая.
//    * Действие - Строка - всегда пустая (фолбэк - первая фраза описания схемы).
//    * Тип - Строка - "MCP".
//    * СерверСсылка - СправочникСсылка.СИ_MCPСерверы.
//    * ИмяИнструмента - Строка - имя на сервере.
//    * РазрешенныеРежимы - Массив из СправочникСсылка.СИ_РежимиРаботы.
Функция ИнструментMCPВСтруктуру(СерверСсылка, ИмяИнструмента, ДанныеСервера)
	СтрокаИнструмента = ДанныеСервера.ДанныеИнструментов.Получить(ИмяИнструмента);
	Если СтрокаИнструмента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Имя", ИмяИнструмента);
	Описание.Вставить("Описание", СтрокаИнструмента.Описание);
	Описание.Вставить("Разрешен", СтрокаИнструмента.Разрешен);
	Описание.Вставить("ТребуетРазрешения", СтрокаИнструмента.ТребуетРазрешения);
	Описание.Вставить("Группа", ГруппаИнструментаПоУмолчанию());
	Описание.Вставить("Слова", "");
	Описание.Вставить("Действие", "");
	Описание.Вставить("Тип", "MCP");
	Описание.Вставить("СерверСсылка", СерверСсылка);
	Описание.Вставить("ИмяИнструмента", ИмяИнструмента);

	ПараметрыРаспарс = Новый Соответствие;
	Если Не ПустаяСтрока(СтрокаИнструмента.ПараметрыSchema) Тогда
		Распарс = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(СтрокаИнструмента.ПараметрыSchema);
		Если Распарс <> Неопределено Тогда
			ПараметрыРаспарс = Распарс;
		КонецЕсли;
	КонецЕсли;
	Описание.Вставить("Параметры", ПараметрыРаспарс);

	Режимы = ДанныеСервера.РежимыПоИмени.Получить(ИмяИнструмента);
	Если Режимы = Неопределено Тогда
		Режимы = Новый Массив;
	КонецЕсли;
	Описание.Вставить("РазрешенныеРежимы", Режимы);

	Возврат Описание;
КонецФункции

// Загрузка данных MCP-сервера (ТЧ Инструменты и РежимыИнструментов) с кешированием.
// Гарантирует один ПолучитьОбъект() на сервер в рамках одного прохода.
//
// Параметры:
//  СерверСсылка - СправочникСсылка.СИ_MCPСерверы.
//  КешСерверов - Соответствие - кеш: СерверСсылка -> Структура (см. ИнструментMCPВСтруктуру).
//
// Возвращаемое значение:
//  Структура,Неопределено - данные сервера или Неопределено при ошибке загрузки.
Функция ДанныеMCPСервера(СерверСсылка, КешСерверов)
	Данные = КешСерверов.Получить(СерверСсылка);
	Если Данные <> Неопределено Тогда
		Возврат Данные;
	КонецЕсли;

	ОбъектСервера = СерверСсылка.ПолучитьОбъект();
	Если ОбъектСервера = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура("Идентификатор, ДанныеИнструментов, РежимыПоИмени",
		СокрЛП(ОбъектСервера.Идентификатор), Новый Соответствие, Новый Соответствие);

	Для Каждого СтрокаТЧ Из ОбъектСервера.Инструменты Цикл
		Если Не ПустаяСтрока(СокрЛП(СтрокаТЧ.ИмяИнструмента)) Тогда
			Данные.ДанныеИнструментов.Вставить(СокрЛП(СтрокаТЧ.ИмяИнструмента), СтрокаТЧ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТЧ Из ОбъектСервера.РежимыИнструментов Цикл
		ИмяИнструмента = СокрЛП(СтрокаТЧ.Инструмент);
		Если ПустаяСтрока(ИмяИнструмента) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.Режим) Тогда
			Продолжить;
		КонецЕсли;
		Режимы = Данные.РежимыПоИмени.Получить(ИмяИнструмента);
		Если Режимы = Неопределено Тогда
			Режимы = Новый Массив;
			Данные.РежимыПоИмени.Вставить(ИмяИнструмента, Режимы);
		КонецЕсли;
		Режимы.Добавить(СтрокаТЧ.Режим);
	КонецЦикла;

	КешСерверов.Вставить(СерверСсылка, Данные);
	Возврат Данные;
КонецФункции

// Проверка доступности инструмента в указанном режиме.
// Режимы не заданы — инструмент доступен во всех режимах.
//
// Параметры:
//  Описание - Структура - описание инструмента (поле РазрешенныеРежимы).
//  РазрешенныйРежим - СправочникСсылка.СИ_РежимиРаботы - режим для проверки.
//
// Возвращаемое значение:
//  Булево - Истина, если инструмент доступен в режиме.
Функция ИнструментДоступенВРежиме(Описание, РазрешенныйРежим)
	РежимыИнструмента = СИ_РаботаСJSON.БезопасноПолучить(Описание, "РазрешенныеРежимы", Неопределено);
	Если РежимыИнструмента = Неопределено ИЛИ ТипЗнч(РежимыИнструмента) <> Тип("Массив") ИЛИ РежимыИнструмента.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	СоответствиеРежимов = СИ_РаботаСJSON.БезопасноПолучить(Описание, "РежимыСоответствие", Неопределено);
	Если СоответствиеРежимов = Неопределено Тогда
		СоответствиеРежимов = Новый Соответствие;
		Для Каждого Режим Из РежимыИнструмента Цикл
			СоответствиеРежимов.Вставить(Режим, Истина);
		КонецЦикла;
		Описание.Вставить("РежимыСоответствие", СоответствиеРежимов);
	КонецЕсли;

	Возврат СоответствиеРежимов.Получить(РазрешенныйРежим) <> Неопределено;
КонецФункции

// Сбор имён внутренних инструментов в Соответствие (для разрешения коллизий MCP).
// Вызывается лениво — только при поиске MCP-инструмента (не на каждый поиск по имени).
//
// Возвращаемое значение:
//  Соответствие - ключ НРег(ИмяФункции), значение Истина.
Функция ИменаВнутреннихИнструментов()
	Имена = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИнструментыАгента.ИмяФункции
	|ИЗ
	|	Справочник.СИ_ИнструментыАгента КАК ИнструментыАгента
	|ГДЕ
	|	ИнструментыАгента.Разрешен = Истина
	|	И ИнструментыАгента.ТипИнструмента = &ТипИнструмента
	|	И ИнструментыАгента.ПометкаУдаления = Ложь
	|	И НЕ ИнструментыАгента.ЭтоГруппа";
	Запрос.УстановитьПараметр("ТипИнструмента", Перечисления.СИ_ТипыИнструментов.Инструмент1С);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Имена.Вставить(НРег(Выборка.ИмяФункции), Истина);
	КонецЦикла;

	Возврат Имена;
КонецФункции

// Разрешение API-имени MCP-инструмента с учётом коллизий.
// Если прямое имя свободно — возвращается оно; иначе "Идентификатор.ИмяИнструмента".
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента на сервере.
//  Идентификатор - Строка - стабильный идентификатор сервера (реквизит СИ_MCPСерверы.Идентификатор).
//  ЗанятыеИмена - Соответствие - занятые имена (ключ НРег(имя), значение Истина). Мутирует: добавляет выбранное API-имя.
//
// Возвращаемое значение:
//  Строка - API-имя инструмента.
Функция РазрешитьAPIИмяMCP(ИмяИнструмента, Идентификатор, ЗанятыеИмена)
	ИмяAPI = ИмяИнструмента;
	Ключ = НРег(ИмяИнструмента);
	Если ЗанятыеИмена.Получить(Ключ) <> Неопределено Тогда
		ИмяAPI = СокрЛП(Идентификатор) + "." + ИмяИнструмента;
	КонецЕсли;
	ЗанятыеИмена.Вставить(НРег(ИмяAPI), Истина);
	Возврат ИмяAPI;
КонецФункции

// Ссылка на папку-группу инструментов по её имени. Пустое имя трактуется как
// группа по умолчанию «Основные» (ГруппаИнструментаПоУмолчанию()). Папка ищется по наименованию среди групп
// верхнего уровня справочника (наименование не уникально, поэтому отбор по
// корню и УПОРЯДОЧИТЬ ПО Ссылка делают результат детерминированным); если
// папки нет - создаётся в корне, ошибка записи пишется в журнал регистрации
// и пробрасывается вызывающему коду. Запрос выполняется на каждый вызов:
// переменные модуля в общих модулях недопустимы, а кэширующий модуль
// СИ_ГруппыИнструментов (повторное использование «на время сеанса»)
// влит в этот модуль.
// Группа инструмента задаётся помещением элемента в папку иерархии (реквизита
// «Группа» в справочнике нет).
//
// Параметры:
//  ИмяГруппы - Строка - имя группы (наименование папки).
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ИнструментыАгента - найденная или созданная папка.
Функция СсылкаГруппыИнструмента(Знач ИмяГруппы)

	Имя = СокрЛП(ИмяГруппы);
	Если ПустаяСтрока(Имя) Тогда
		Имя = ГруппаИнструментаПоУмолчанию();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнструментыАгента.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СИ_ИнструментыАгента КАК ИнструментыАгента
	|ГДЕ
	|	ИнструментыАгента.ЭтоГруппа
	|	И ИнструментыАгента.Наименование = &ИмяГруппы
	|	И ИнструментыАгента.Родитель = &Корень
	|	И НЕ ИнструментыАгента.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ИнструментыАгента.Ссылка";
	Запрос.УстановитьПараметр("ИмяГруппы", Имя);
	Запрос.УстановитьПараметр("Корень", Справочники.СИ_ИнструментыАгента.ПустаяСсылка());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Попытка
		НоваяГруппа = Справочники.СИ_ИнструментыАгента.СоздатьГруппу();
		НоваяГруппа.Наименование = Имя;
		НоваяГруппа.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.СсылкаГруппыИнструмента",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.СИ_ИнструментыАгента,
			, "Ошибка создания папки группы """ + Имя + """: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

	Возврат НоваяГруппа.Ссылка;

КонецФункции

// Ссылка на папку группы по умолчанию «Основные» (имя - ГруппаИнструментаПоУмолчанию()).
// Предопределённых элементов у справочника нет: папка ищется по наименованию
// и при отсутствии создаётся, как и любая другая группа (см. СсылкаГруппыИнструмента).
//
// Возвращаемое значение:
//  СправочникСсылка.СИ_ИнструментыАгента - папка «Основные».
Функция СсылкаГруппыПоУмолчанию() Экспорт

	Возврат СсылкаГруппыИнструмента(ГруппаИнструментаПоУмолчанию());

КонецФункции

// Находит элемент справочника СИ_ИнструментыАгента внутреннего инструмента
// (ТипИнструмента = Инструмент1С) по реестровому имени - для обновления
// схемы/описания при повторной регистрации.
//
// Параметры:
//  Имя - Строка - реестровое имя инструмента.
//
// Возвращаемое значение:
//  СправочникОбъект.СИ_ИнструментыАгента, Неопределено - объект для записи.
Функция НайтиЭлементИнструмента(Знач Имя)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнструментыАгента.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СИ_ИнструментыАгента КАК ИнструментыАгента
	|ГДЕ
	|	ИнструментыАгента.ИмяФункции = &Имя
	|	И ИнструментыАгента.ТипИнструмента = ЗНАЧЕНИЕ(Перечисление.СИ_ТипыИнструментов.Инструмент1С)
	|	И НЕ ИнструментыАгента.ПометкаУдаления
	|	И НЕ ИнструментыАгента.ЭтоГруппа";
	Запрос.УстановитьПараметр("Имя", Имя);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Поиск инструмента по реестровому имени (внутренние + MCP).
//
// Параметры:
//  Имя - Строка - реестровое имя инструмента.
//
// Возвращаемое значение:
//  Структура,Неопределено - описание инструмента.
Функция ПоискИнструментаПоИмени(Имя)
	Попытка
		Если ПустаяСтрока(Имя) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ДанныеВнутреннего = НайтиВнутреннийИнструментПоИмени(Имя);
		Если ДанныеВнутреннего <> Неопределено Тогда
			Описание = ИнструментВСтруктуру(ДанныеВнутреннего, ДанныеВнутреннего.Режимы);
			Если Описание <> Неопределено И Описание.Разрешен Тогда
				Возврат Описание;
			КонецЕсли;
		КонецЕсли;

		ЗанятыеИмена = ИменаВнутреннихИнструментов();

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Инструменты.Ссылка КАК Сервер,
		|	Инструменты.ИмяИнструмента
		|ИЗ
		|	Справочник.СИ_MCPСерверы.Инструменты КАК Инструменты
		|ГДЕ
		|	Инструменты.Разрешен = Истина
		|	И Инструменты.Ссылка.Включен = Истина
		|	И Инструменты.Ссылка.ПометкаУдаления = Ложь";

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();

		КешСерверов = Новый Соответствие;

		Пока Выборка.Следующий() Цикл
			ИмяИнструмента = СокрЛП(Выборка.ИмяИнструмента);
			Если ПустаяСтрока(ИмяИнструмента) Тогда
				Продолжить;
			КонецЕсли;

			ДанныеСервера = ДанныеMCPСервера(Выборка.Сервер, КешСерверов);
			Если ДанныеСервера = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Идентификатор = ДанныеСервера.Идентификатор;

			ЕстьВнутреннийКонфликт = (ЗанятыеИмена.Получить(НРег(ИмяИнструмента)) <> Неопределено);
			ПолноеИмя = СокрЛП(Идентификатор) + "." + ИмяИнструмента;

			Если (НЕ ЕстьВнутреннийКонфликт И НРег(ИмяИнструмента) = НРег(Имя)) ИЛИ ПолноеИмя = Имя Тогда
				Описание = ИнструментMCPВСтруктуру(Выборка.Сервер, ИмяИнструмента, ДанныеСервера);
				Если Описание <> Неопределено Тогда
					Если НРег(ИмяИнструмента) = НРег(Имя) Тогда
						Описание.Вставить("Имя", ИмяИнструмента);
					Иначе
						Описание.Вставить("Имя", ПолноеИмя);
					КонецЕсли;
					Возврат Описание;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	Исключение
		ЗаписьЖурналаРегистрации("Агент1С.РеестрИнструментов.ПоискИнструментаПоИмени", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.СИ_ИнструментыАгента,
			, "Ошибка поиска инструмента: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

// Поиск внутреннего инструмента по имени функции.
// Возвращает данные инструмента (реквизиты + режимы ТЧ) одним запросом — без ПолучитьОбъект().
// Сравнение регистронезависимое (НРег) — унифицировано с остальными проверками имён.
//
// Параметры:
//  Имя - Строка - имя функции инструмента.
//
// Возвращаемое значение:
//  Структура,Неопределено - данные инструмента (см. ИнструментВСтруктуру.Данные + поле Режимы),
//    или Неопределено, если инструмент не найден или помечен на удаление.
Функция НайтиВнутреннийИнструментПоИмени(Имя)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнструментыАгента.Ссылка,
	|	ИнструментыАгента.ИмяФункции,
	|	ИнструментыАгента.Описание,
	|	ИнструментыАгента.Разрешен,
	|	ИнструментыАгента.ТребуетРазрешения,
	|	ИнструментыАгента.ПараметрыSchema,
	|	ИнструментыАгента.ИмяФункцииОбработчика,
	|	ЕСТЬNULL(ИнструментыАгента.Родитель.Наименование, """") КАК Группа,
	|	ИнструментыАгента.Слова,
	|	ИнструментыАгента.Действие
	|ИЗ
	|	Справочник.СИ_ИнструментыАгента КАК ИнструментыАгента
	|ГДЕ
	|	ИнструментыАгента.ИмяФункции = &Имя
	|	И ИнструментыАгента.ТипИнструмента = &ТипИнструмента
	|	И ИнструментыАгента.ПометкаУдаления = Ложь
	|	И НЕ ИнструментыАгента.ЭтоГруппа";
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ТипИнструмента", Перечисления.СИ_ТипыИнструментов.Инструмент1С);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Имя", Выборка.ИмяФункции);
	Данные.Вставить("Описание", Выборка.Описание);
	Данные.Вставить("Разрешен", Выборка.Разрешен);
	Данные.Вставить("ТребуетРазрешения", Выборка.ТребуетРазрешения);
	Данные.Вставить("ПараметрыSchema", Выборка.ПараметрыSchema);
	Данные.Вставить("ИмяФункцииОбработчика", Выборка.ИмяФункцииОбработчика);
	Данные.Вставить("Ссылка", Выборка.Ссылка);
	Данные.Вставить("Группа", Выборка.Группа);
	Данные.Вставить("Слова", Выборка.Слова);
	Данные.Вставить("Действие", Выборка.Действие);
	Данные.Вставить("Режимы", Новый Массив);

	ЗапросРежимов = Новый Запрос;
	ЗапросРежимов.Текст =
	"ВЫБРАТЬ
	|	РазрешённыеРежимы.Режим
	|ИЗ
	|	Справочник.СИ_ИнструментыАгента.РазрешённыеРежимы КАК РазрешённыеРежимы
	|ГДЕ
	|	РазрешённыеРежимы.Ссылка = &Ссылка";
	ЗапросРежимов.УстановитьПараметр("Ссылка", Выборка.Ссылка);

	ВыборкаРежимов = ЗапросРежимов.Выполнить().Выбрать();
	Пока ВыборкаРежимов.Следующий() Цикл
		Данные.Режимы.Добавить(ВыборкаРежимов.Режим);
	КонецЦикла;

	Возврат Данные;
КонецФункции

// Возвращает признак того, что модуль-обработчик является доверенным внутренним
// модулем и должен выполняться БЕЗ безопасного режима.
//
// Зачем: диспетчер выполняет обработчики через Вычислить в безопасном режиме.
// Для записи объектов через BSP «Работа с файлами» (СоздатьФайлСВерсией -> запись
// файла и версии) это неприемлемо: подписка СтандартныхПодсистем «ПередЗаписью»
// (ПроверитьБезопасныйРежимПередЗаписью) запрещает запись объектов в безопасном
// режиме — «Действие недоступно в безопасном режиме».
//
// Безопасность: имя модуля приходит из справочника СИ_ИнструментыАгента (поле
// ИмяФункцииОбработчика) и не может быть подставлено моделью — модель передаёт
// только аргументы (данные), а не код. Список доверенных модулей фиксирован и
// проверяется точным сравнением по Массиву (не строкой-конкатенацией).
//
// Параметры:
//  ИмяМодуля - Строка - имя общего модуля-обработчика.
//
// Возвращаемое значение:
//  Булево - Истина, если модуль входит в фиксированный список доверенных.
Функция ЭтоМодульБезБезопасногоРежима(ИмяМодуля)
	ДоверенныеМодули = Новый Массив;
	ДоверенныеМодули.Добавить("СИ_ФайлыДиалога");
	ДоверенныеМодули.Добавить("СИ_РаспознованиеИзображений");
	ДоверенныеМодули.Добавить("СИ_Инструменты1С");
	Имя = СокрЛП(ИмяМодуля);
	Для Каждого ДоверенныйМодуль Из ДоверенныеМодули Цикл
		Если НРег(Имя) = НРег(ДоверенныйМодуль) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Выполнение обработчика доверенного модуля БЕЗ безопасного режима и БЕЗ Вычислить.
// Статическая диспетчеризация по фиксированному списку доверенных модулей -
// исключает Вычислить для доверенного кода (SU76 не применяется к этой ветке).
//
// ВНИМАНИЕ: список методов РУЧНОЙ. При регистрации нового инструмента доверенного
// модуля (ЗарегистрироватьИнструмент с обработчиком доверенного модуля) ветку с его
// методом нужно добавить сюда же, иначе вызов упадёт с «Неизвестный метод доверенного
// модуля» - проверяется именно этим исключением.
//
// Параметры:
//  ИмяМодуля - Строка - имя общего модуля.
//  ИмяМетода - Строка - имя экспортной функции.
//  Аргументы - Структура - аргументы вызова (конвертированы из Соответствия).
//
// Возвращаемое значение:
//  Произвольный - результат функции-обработчика.
Функция ВыполнитьБезБезопасногоРежима(ИмяМодуля, ИмяМетода, Аргументы)
	Если НРег(ИмяМодуля) = НРег("СИ_ФайлыДиалога") Тогда
		Если НРег(ИмяМетода) = НРег("СоздатьФайлВДиалоге") Тогда
			Возврат СИ_ФайлыДиалога.СоздатьФайлВДиалоге(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("ОбновитьФайлДиалога") Тогда
			Возврат СИ_ФайлыДиалога.ОбновитьФайлДиалога(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("ПрочитатьФайлДиалога") Тогда
			Возврат СИ_ФайлыДиалога.ПрочитатьФайлДиалога(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("СписокФайловДиалога") Тогда
			Возврат СИ_ФайлыДиалога.СписокФайловДиалога(Аргументы);
		Иначе
			ВызватьИсключение("Неизвестный метод доверенного модуля: " + ИмяМодуля + "." + ИмяМетода);
		КонецЕсли;
	ИначеЕсли НРег(ИмяМодуля) = НРег("СИ_РаспознованиеИзображений") Тогда
		Если НРег(ИмяМетода) = НРег("РаспознатьИзображениеПоИмениФайла") Тогда
			Возврат СИ_РаспознованиеИзображений.РаспознатьИзображениеПоИмениФайла(Аргументы);
		Иначе
			ВызватьИсключение("Неизвестный метод доверенного модуля: " + ИмяМодуля + "." + ИмяМетода);
		КонецЕсли;
	ИначеЕсли НРег(ИмяМодуля) = НРег("СИ_Инструменты1С") Тогда
		Если НРег(ИмяМетода) = НРег("Калькулятор") Тогда
			Возврат СИ_Инструменты1С.Калькулятор(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("НарисоватьMermaid") Тогда
			Возврат СИ_Инструменты1С.НарисоватьMermaid(Аргументы);
		// Запросы к БД (бывший СИ_ИнструментЗапросБД)
		ИначеЕсли НРег(ИмяМетода) = НРег("ВыполнитьЗапрос") Тогда
			Возврат СИ_Инструменты1С.ВыполнитьЗапрос(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("ПолучитьСхемуМетаданных") Тогда
			Возврат СИ_Инструменты1С.ПолучитьСхемуМетаданных(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("ТекущиеДатаВремя") Тогда
			Возврат СИ_Инструменты1С.ТекущиеДатаВремя(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("РазобратьПериодПоТексту") Тогда
			Возврат СИ_Инструменты1С.РазобратьПериодПоТексту(Аргументы);
		// Диагностика (бывший СИ_ИнструментыДиагностики)
		ИначеЕсли НРег(ИмяМетода) = НРег("ПоследниеСобытияЖурнала")
			ИЛИ НРег(ИмяМетода) = НРег("ОшибкиПользователяЗаПериод") Тогда
			Возврат СИ_Инструменты1С.ПоследниеСобытияЖурнала(Аргументы);
		// Выгрузка и диаграммы (бывший СИ_ИнструментыВыгрузки)
		ИначеЕсли НРег(ИмяМетода) = НРег("ВыгрузитьВExcel") Тогда
			Возврат СИ_Инструменты1С.ВыгрузитьВExcel(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("НарисоватьДиаграмму") Тогда
			Возврат СИ_Инструменты1С.НарисоватьДиаграмму(Аргументы);
		// Обзорные сводки (бывший СИ_ИнструментыОбзора)
		ИначеЕсли НРег(ИмяМетода) = НРег("ПолучитьСводкуПродаж") Тогда
			Возврат СИ_Инструменты1С.ПолучитьСводкуПродаж(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("ПолучитьСводкуДенег") Тогда
			Возврат СИ_Инструменты1С.ПолучитьСводкуДенег(Аргументы);
		ИначеЕсли НРег(ИмяМетода) = НРег("ПолучитьСводкуСклада") Тогда
			Возврат СИ_Инструменты1С.ПолучитьСводкуСклада(Аргументы);
		Иначе
			ВызватьИсключение("Неизвестный метод доверенного модуля: " + ИмяМодуля + "." + ИмяМетода);
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение("Модуль не входит в список доверенных: " + ИмяМодуля);
КонецФункции

// Универсальное выполнение обработчика.
// Вся маршрутизация — из поля ИмяФункцииОбработчика (формат "Модуль.Метод").
// Не требует хардкода при добавлении новых инструментов.
//
// Безопасность (SU76): для произвольных модулей безопасный режим устанавливается
// БЕЗУСЛОВНО непосредственно перед Вычислить и снимается после (в т.ч. при ошибке).
// Для доверенных модулей Вычислить не используется вообще — только статическая
// диспетчеризация (ВыполнитьБезБезопасногоРежима).
//
// Параметры:
//  ИмяМодуля - Строка - имя общего модуля-обработчика.
//  ИмяМетодаОбработчика - Строка - имя экспортной функции-обработчика.
//  Аргументы - Структура,Соответствие - аргументы вызова.
//
// Возвращаемое значение:
//  Структура - нормализованный результат:
//    * Успех - Булево.
//    * Значение - Произвольный,Неопределено.
//    * Ошибка - Строка,Неопределено.
Функция ВыполнитьОбработчик(ИмяМодуля, ИмяМетодаОбработчика, Аргументы)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Значение", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);

	Попытка
		Если ЭтоМодульБезБезопасногоРежима(ИмяМодуля) Тогда
			Значение = ВыполнитьБезБезопасногоРежима(ИмяМодуля, ИмяМетодаОбработчика, Аргументы);
		Иначе
			ТекстВызова = ИмяМодуля + "." + ИмяМетодаОбработчика + "(Аргументы)";

			УстановитьБезопасныйРежим(Истина);
			Попытка
				Значение = Вычислить(ТекстВызова);
			Исключение
				УстановитьБезопасныйРежим(Ложь);
				ВызватьИсключение;
			КонецПопытки;
			УстановитьБезопасныйРежим(Ложь);
		КонецЕсли;

		Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Успех") Тогда
			Результат.Успех = Значение.Успех;
			Результат.Значение = СИ_РаботаСJSON.БезопасноПолучить(Значение, "Значение", Неопределено);
			Результат.Ошибка = СИ_РаботаСJSON.БезопасноПолучить(Значение, "Ошибка", Неопределено);
		Иначе
			Результат.Успех = Истина;
			Результат.Значение = Значение;
		КонецЕсли;

	Исключение
		Результат.Ошибка = "Ошибка вызова " + ИмяМодуля + "." + ИмяМетодаОбработчика + ": " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Постобработка результата вызова инструмента - единая точка для всех веток
// (внутренние инструменты, MCP, исключения): ошибка, в тексте которой
// сообщается о нехватке прав, заменяется прямой инструкцией «ДОСТУП ЗАПРЕЩЁН ...»
// с признаком НетПрав - в том числе когда инструмент вернул такой отказ сам
// (например, инструмент запросов к БД).
//
// Параметры:
//  Результат - Структура - результат вызова инструмента (см. ВызватьИнструмент); мутируется.
Процедура ПрименитьПравилаОшибок(Результат)

	Ошибка = СИ_РаботаСJSON.БезопасноПолучить(Результат, "ОшибкаИсполнения", Неопределено);
	Если ЭтоОтказПоДоступуВТексте(Строка(Ошибка)) Тогда
		Результат.ОшибкаИсполнения = ИнструкцияОтказаПоДоступу();
		Результат.НетПрав = Истина;
		Результат.Вставить("КодОшибки", КодОтказаПоДоступу());
	КонецЕсли;

КонецПроцедуры

// Гигиена успешного результата для инструментов с табличными данными: вертикальная
// черта «|» в строковых значениях заменяется на «/». Модель переносит выборку в
// markdown-таблицу ответа, а «|» в данных ломает разметку GFM-таблицы (появляется
// лишняя колонка). Рендер (СИ_МаркдаунHTML) ячейки по «|» только режет и экранирования
// не выполняет, поэтому замена делается на стороне результата инструмента.
//
// Параметры:
//  Имя - Строка - реестровое имя инструмента.
//  ЗначениеРезультата - Произвольный - значение результата; мутируется.
Процедура ПрименитьГигиенуРезультата(Имя, ЗначениеРезультата)

	Если ЗначениеРезультата = Неопределено
		ИЛИ ИнструментыСТабличнымиДанными().Найти(Имя) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗамаскироватьВертикальныеЧерты(ЗначениеРезультата);

КонецПроцедуры

// Реестровые имена инструментов, возвращающие табличные данные (строки выборок,
// сводок, событий журнала), к которым применяется ПрименитьГигиенуРезультата.
//
// Возвращаемое значение:
//  Массив из Строка - имена инструментов.
Функция ИнструментыСТабличнымиДанными()

	Инструменты = Новый Массив;
	Инструменты.Добавить("ExecuteDBQuery");
	Инструменты.Добавить("GetMoneySummary");
	Инструменты.Добавить("GetSalesSummary");
	Инструменты.Добавить("GetStockSummary");
	Инструменты.Добавить("GetRecentErrors");
	Возврат Инструменты;

КонецФункции

// Рекурсивно заменяет «|» на «/» в строковых значениях структуры, соответствия
// или массива. Строки в 1С неизменяемы, поэтому изменённое значение записывается
// обратно в коллекцию.
//
// Параметры:
//  Значение - Произвольный - значение результата; мутируется.
Процедура ЗамаскироватьВертикальныеЧерты(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура")
		ИЛИ ТипЗначения = Тип("Соответствие") Тогда
		// При обходе структуры и соответствия запись в поле Значение элемента
		// запрещена платформой («Поле объекта недоступно для записи»),
		// поэтому обновление выполняется через Вставить.
		Ключи = Новый Массив;
		Для Каждого ЭлементКоллекции Из Значение Цикл
			Ключи.Добавить(ЭлементКоллекции.Ключ);
		КонецЦикла;
		Для Каждого Ключ Из Ключи Цикл
			ЭлементЗначение = Значение[Ключ];
			ЗамаскироватьВертикальныеЧерты(ЭлементЗначение);
			Значение.Вставить(Ключ, ЭлементЗначение);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Индекс = 0 По Значение.Количество() - 1 Цикл
			ЭлементЗначение = Значение[Индекс];
			ЗамаскироватьВертикальныеЧерты(ЭлементЗначение);
			Значение[Индекс] = ЭлементЗначение;
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Значение = СтрЗаменить(Значение, "|", "/");
	КонецЕсли;

КонецПроцедуры

// Расчёт длительности в миллисекундах.
// Защищён от сдвига системного времени (отрицательная разница возвращается как 0).
//
// Параметры:
//  НачалоВызова - Число - ТекущаяУниверсальнаяДатаВМиллисекундах() на момент начала.
//
// Возвращаемое значение:
//  Число - длительность в миллисекундах.
Функция РассчитатьДлительностьМс(НачалоВызова)
	Разница = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
	Если Разница < 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Разница;
КонецФункции

// Собирает карту навигационных ссылок на объекты 1С из значения результата
// инструмента. Значение обходится рекурсивно (Структура/Соответствие/Массив):
// отбираются ссылки на справочники, документы и подобные объекты, для каждой
// строится навигационная ссылка (e1cib/data/...), а ключами карты становятся
// текстовые упоминания объекта - представление и, для документов, «Вид № Номер»
// с «№ Номер».
//
// Параметры:
//  ЗначениеРезультата - Произвольный - значение результата инструмента (может
//    быть Неопределено, примитивом, структурой, соответствием, массивом);
//  СсылкиОбъектов - Массив,Неопределено - ссылки, собранные инструментом
//    отдельно от сериализуемого значения (см. СериализоватьВыборку в
//    СИ_Инструменты1С); могут отсутствовать.
//
// Возвращаемое значение:
//  Массив из Структура - карта ссылок (пустой массив, если объектов нет).
//    У каждой структуры: Упоминание (Строка) - текст в ответе, который
//    заменяется ссылкой; Адрес (Строка) - навигационная ссылка e1cib/.
Функция СобратьСсылкиДокументов(ЗначениеРезультата, СсылкиОбъектов)

	Ссылки = Новый Массив;

	УжеСобрано = Новый Соответствие;

	ОбойтиЗначениеДляСбораСсылок(СсылкиОбъектов, Ссылки, УжеСобрано, 1);
	ОбойтиЗначениеДляСбораСсылок(ЗначениеРезультата, Ссылки, УжеСобрано, 1);

	Возврат Ссылки;

КонецФункции

// Рекурсивный обход значения результата для сбора навигационных ссылок.
// Глубина обхода ограничена: значения инструментов бывают вложенными, но
// бесконечно углубляться незачем - ссылки лежат на первых уровнях.
//
// Параметры:
//  Значение - Произвольный - текущий узел значения;
//  Ссылки - Массив из Структура - накопитель карты (см. СобратьСсылкиДокументов);
//  УжеСобрано - Соответствие - ключ «Упоминание» -> Истина по всей карте;
//  Глубина - Число - текущая глубина обхода.
Процедура ОбойтиЗначениеДляСбораСсылок(Значение, Ссылки, УжеСобрано, Глубина)

	Если Значение = Неопределено ИЛИ Глубина > МаксимальнаяГлубинаОбходаСсылок() Тогда
		Возврат;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Структура") Тогда
		Для Каждого Пара Из Значение Цикл
			ОбойтиЗначениеДляСбораСсылок(Пара.Значение, Ссылки, УжеСобрано, Глубина + 1);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого Пара Из Значение Цикл
			ОбойтиЗначениеДляСбораСсылок(Пара.Значение, Ссылки, УжеСобрано, Глубина + 1);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			ОбойтиЗначениеДляСбораСсылок(Элемент, Ссылки, УжеСобрано, Глубина + 1);
		КонецЦикла;
	ИначеЕсли ЭтоСсылочныйОбъект(Значение) Тогда
		ДобавитьСсылкуВКарту(Значение, Ссылки, УжеСобрано);
	КонецЕсли;

КонецПроцедуры

// Ссылка ли это на объект метаданных (справочник, документ, регистр и т.п.) -
// то есть значение, для которого в принципе может существовать ссылка e1cib/.
//
// Вид значения определяется по МЕТАДАННЫМ, а не сравнением типа с обобщённым
// Тип("СправочникСсылка"): конкретный тип ссылки - это СправочникСсылка.<Имя>,
// поэтому проверка по метаданным надёжнее и не зависит от того, как платформа
// сопоставляет конкретный и обобщённый типы. Метаданные однозначно отвечают на
// вопрос «это ссылка на объект метаданных»: для ссылок находится объект
// метаданных, для примитивов, структур, хранилищ и UUID - Неопределено.
//
// Поддерживает ли вид объекта переход по навигационной ссылке, решает платформа:
// значение всё равно уходит в ДобавитьСсылкуВКарту, где ПолучитьНавигационнуюСсылку
// вызывается под Попыткой (перечисления и ключи записей адреса не получают).
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина для заполненной ссылки на объект метаданных.
Функция ЭтоСсылочныйОбъект(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Неопределено") ИЛИ ТипЗначения = Тип("Null") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Метаданные.НайтиПоТипу(ТипЗначения) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(Значение);

КонецФункции

// Добавляет в карту упоминания одного объекта и его навигационную ссылку.
// Адрес формирует платформа; объект, для которого навигационная ссылка не
// строится (удалён, недоступен), пропускается - кликабельного упоминания
// у него не будет.
//
// Параметры:
//  Ссылка - СправочникСсылка, ДокументСсылка, ... - объект из результата;
//  Ссылки - Массив из Структура - накопитель карты (см. СобратьСсылкиДокументов);
//  УжеСобрано - Соответствие - ключ «Упоминание» -> Истина по всей карте.
Процедура ДобавитьСсылкуВКарту(Ссылка, Ссылки, УжеСобрано)

	Попытка
		Адрес = ПолучитьНавигационнуюСсылку(Ссылка);
	Исключение
		Возврат;
	КонецПопытки;

	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Упоминание Из УпоминанияОбъекта(Ссылка) Цикл

		Если Ссылки.Количество() >= МаксимумСсылокВКарте() Тогда
			Возврат;
		КонецЕсли;

		Если УжеСобрано.Получить(Упоминание) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		УжеСобрано.Вставить(Упоминание, Истина);
		СсылкаКарты = Новый Структура("Упоминание, Адрес", Упоминание, Адрес);
		Ссылки.Добавить(СсылкаКарты);

	КонецЦикла;

КонецПроцедуры

// Упоминания объекта в тексте ответа, по которым ставится ссылка. Полное
// представление («Реализация товаров и услуг № 123 от 01.01.2026») -
// универсальный ключ, для документов дополнительно разбирается номер:
// модель часто пишет документ без даты («... № 123»), и точное представление
// тогда не совпало бы.
//
// Параметры:
//  Ссылка - СправочникСсылка, ДокументСсылка, ... - объект из результата.
//
// Возвращаемое значение:
//  Массив из Строка - упоминания от длинных к коротким (в этом порядке их и
//  надо заменять, иначе короткое «№ 123» съело бы часть длинного).
Функция УпоминанияОбъекта(Ссылка)

	Результат = Новый Массив;
	Представление = Строка(Ссылка);
	Если СтрДлина(Представление) < 3 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(Представление);

	ПозицияНомера = СтрНайти(Представление, " № ");
	Если ПозицияНомера = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Вид = Лев(Представление, ПозицияНомера - 1);
	Хвост = Сред(Представление, ПозицияНомера + 1);
	ПозицияДаты = СтрНайти(Хвост, " от ");
	Если ПозицияДаты > 0 Тогда
		НомерСКлючом = Лев(Хвост, ПозицияДаты - 1);
	Иначе
		НомерСКлючом = Хвост;
	КонецЕсли;

	Если НЕ ПустаяСтрока(Вид) Тогда
		Результат.Добавить(Вид + " " + НомерСКлючом);
	КонецЕсли;
	Если СтрДлина(НомерСКлючом) > 2 Тогда
		Результат.Добавить(НомерСКлючом);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Максимальное число ссылок в карте (см. ДобавитьСсылкуВКарту).
//
// Возвращаемое значение:
//  Число - лимит ссылок на сообщение.
Функция МаксимумСсылокВКарте()
	Возврат 20;
КонецФункции

// Максимальная глубина обхода значения результата при сборе ссылок.
//
// Возвращаемое значение:
//  Число - лимит глубины.
Функция МаксимальнаяГлубинаОбходаСсылок()
	Возврат 5;
КонецФункции

#КонецОбласти
