#Область ПрограммныйИнтерфейс

// Экранирует текст для безопасного вывода в HTML-поле: раскодирует ранее
// экранированные HTML-entity и экранирует спецсимволы один раз.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - экранированный текст.
Функция ЭкранироватьHTML(Знач Текст) Экспорт
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = Текст;

	Сущности = Новый Массив;
	Сущности.Добавить(Новый Структура("Entity, Символ", "&" + "lt;", "<"));
	Сущности.Добавить(Новый Структура("Entity, Символ", "&" + "gt;", ">"));
	Сущности.Добавить(Новый Структура("Entity, Символ", "&" + "quot;", """"));
	Сущности.Добавить(Новый Структура("Entity, Символ", "&" + "#39;", "'"));
	Сущности.Добавить(Новый Структура("Entity, Символ", "&" + "amp;", "&"));

	Для ИндексНормализации = 1 По 5 Цикл
		БылиЗамены = Ложь;
		Для Каждого Сущность Из Сущности Цикл
			Если СтрНайти(Результат, Сущность.Entity) > 0 Тогда
				Результат = СтрЗаменить(Результат, Сущность.Entity, Сущность.Символ);
				БылиЗамены = Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ БылиЗамены Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = СтрЗаменить(Результат, "&", "&" + "amp;");
	Результат = СтрЗаменить(Результат, "<", "&" + "lt;");
	Результат = СтрЗаменить(Результат, ">", "&" + "gt;");
	Результат = СтрЗаменить(Результат, """", "&" + "quot;");

	Возврат Результат;
КонецФункции

Функция ЭкранироватьАтрибут(Знач Значение) Экспорт
	Результат = Значение;
	Результат = СтрЗаменить(Результат, "&", "&" + "amp;");
	Результат = СтрЗаменить(Результат, """", "&" + "quot;");
	Результат = СтрЗаменить(Результат, "<", "&" + "lt;");
	Результат = СтрЗаменить(Результат, ">", "&" + "gt;");
	Возврат Результат;
КонецФункции

Функция РазобратьMarkdownВHTML(Знач Текст) Экспорт
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);

	Строки = СтрРазделить(Текст, Символы.ПС, Истина);

	Результат = Новый Массив;
	СтрокиКода = Новый Массив;
	ВБлокеКода = Ложь;
	Индекс = 0;
	Пока Индекс < Строки.Количество() Цикл
		Строка = Строки[Индекс];

		Если СтрНачинаетсяС(Строка, "```") Тогда
			Если ВБлокеКода Тогда
				Результат.Добавить(СтрСоединить(СтрокиКода, Символы.ПС) + "</code></pre>");
				СтрокиКода.Очистить();
				ВБлокеКода = Ложь;
			Иначе
				Результат.Добавить("<pre class=""si-md-pre""><code>");
				ВБлокеКода = Истина;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если ВБлокеКода Тогда
			СтрокиКода.Добавить(ЭкранироватьКодВБлоке(Строка));
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(Строка) Тогда
			Результат.Добавить("<br/>");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если Строка = "---" ИЛИ Строка = "***" ИЛИ Строка = "___" Тогда
			Результат.Добавить("<hr class=""si-md-hr""/>");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		ОбработаноЗаголовок = Ложь;
		МаркерыЗаголовков = Новый Массив;
		МаркерыЗаголовков.Добавить("# ");
		МаркерыЗаголовков.Добавить("## ");
		МаркерыЗаголовков.Добавить("### ");
		МаркерыЗаголовков.Добавить("#### ");
		МаркерыЗаголовков.Добавить("##### ");
		МаркерыЗаголовков.Добавить("###### ");
		Для Н = 1 По МаркерыЗаголовков.Количество() Цикл
			Маркер = МаркерыЗаголовков[Н - 1];
			Если СтрНачинаетсяС(Строка, Маркер) Тогда
				ТекстЗаголовка = Прав(Строка, СтрДлина(Строка) - СтрДлина(Маркер));
				Результат.Добавить("<h" + Формат(Н, "ЧДЦ=0; ЧГ=0") + " class=""si-md-h"" style=""font-size:"
					+ Формат(Макс(20 - Н * 2, 12), "ЧДЦ=0; ЧГ=0") + "px;"">" + ОбработатьИнлайн(ТекстЗаголовка) + "</h" + Формат(Н, "ЧДЦ=0; ЧГ=0") + ">");
				ОбработаноЗаголовок = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ОбработаноЗаголовок Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Строка, "#") Тогда
			Результат.Добавить(ОбработатьИнлайн(Строка) + "<br/>");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Строка, "> ") Тогда
			Результат.Добавить("<blockquote class=""si-md-quote"">"
				+ ОбработатьИнлайн(Сред(Строка, 3)) + "</blockquote>");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если НачатьСписок(Строка) Тогда
			РазобранныйСписок = РазобратьСписок(Строки, Индекс);
			Результат.Добавить(СИ_РаботаСJSON.БезопасноПолучить(РазобранныйСписок, "HTML", ""));
			Индекс = СИ_РаботаСJSON.БезопасноПолучить(РазобранныйСписок, "СледующийИндекс", Индекс);
			Продолжить;
		КонецЕсли;

		Если СтрНайти(Строка, "|") > 0 И Индекс + 1 < Строки.Количество()
			И ЭтоРазделительТаблицы(Строки[Индекс + 1]) Тогда

			РазборТаблицы = РазобратьТаблицу(Строки, Индекс);
			Результат.Добавить(РазборТаблицы.HTML);
			Индекс = РазборТаблицы.СледующийИндекс;
			Продолжить;
		КонецЕсли;

		Результат.Добавить(ОбработатьИнлайн(Строка) + "<br/>");
		Индекс = Индекс + 1;
	КонецЦикла;

	Если ВБлокеКода Тогда
		Результат.Добавить(СтрСоединить(СтрокиКода, Символы.ПС) + "</code></pre>");
	КонецЕсли;

	Возврат СтрСоединить(Результат, "");
КонецФункции

// Обрабатывает инлайновые элементы: ссылки [текст](адрес), код `...`,
// жирный **...**, курсив *...*
Функция ОбработатьИнлайн(Знач Строка) Экспорт
	Строка = ЗаменитьИнлайнСсылкиРазметки(Строка);
	Строка = ЗаменитьИнлайнКод(Строка);
	Строка = ЗаменитьИнлайнЖирный(Строка);
	Строка = ЗаменитьИнлайнКурсив(Строка);
	Возврат Строка;
КонецФункции

// Преобразует markdown-ссылки [текст](адрес) в <a href="адрес">текст</a>.
//
// Модель оформляет ссылки markdown-разметкой сама (например, колонку «Открыть»
// с адресами e1cib/data/...): без этого этапа пользователь видел бы сырой текст
// «[открыть](e1cib/data/...)» вместо ссылки.
//
// Адрес берётся из текста ответа, поэтому проверяется по списку схем (http,
// https, e1cib, file, mailto): произвольные и опасные схемы (javascript:, data:)
// ссылкой не становятся - такая разметка остаётся текстом. Текст модели
// источником адресов не является; серверная карта упоминаний
// (ПреобразоватьУпоминанияВСсылки) работает независимо от этой функции.
//
// Параметры:
//  Строка - Строка - текст строки после экранирования HTML.
//
// Возвращаемое значение:
//  Строка - текст, в котором ссылки разметки стали тегами <a>.
Функция ЗаменитьИнлайнСсылкиРазметки(Знач Строка) Экспорт

	Результат = "";
	Остаток = Строка;

	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "[");
		Если Начало = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		Хвост = Сред(Остаток, Начало + 1);
		ЗакрытиеТекста = СтрНайти(Хвост, "](");
		Если ЗакрытиеТекста = 0 Тогда
			Результат = Результат + Лев(Остаток, Начало);
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		ПослеСкобки = Сред(Хвост, ЗакрытиеТекста + 2);
		ЗакрытиеАдреса = СтрНайти(ПослеСкобки, ")");
		Если ЗакрытиеАдреса = 0 Тогда
			Результат = Результат + Лев(Остаток, Начало);
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		ТекстСсылки = Лев(Хвост, ЗакрытиеТекста - 1);
		Адрес = Лев(ПослеСкобки, ЗакрытиеАдреса - 1);

		Если ПустаяСтрока(ТекстСсылки) ИЛИ НЕ ЭтоДопустимаяСсылка(Адрес) Тогда
			Результат = Результат + Лев(Остаток, Начало);
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		Результат = Результат + Лев(Остаток, Начало - 1)
			+ "<a href=""" + ЭкранироватьАтрибут(СокрЛП(Адрес)) + """"
			+ ЦелиСсылкиРазметки(Адрес) + " class=""si-md-a"">"
			+ ТекстСсылки + "</a>";
		Остаток = Сред(ПослеСкобки, ЗакрытиеАдреса + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Замена `код` на <code>...</code> (вход экранирован)
Функция ЗаменитьИнлайнКод(Знач Строка) Экспорт
	Результат = Строка;
	Пока Истина Цикл
		Поз = СтрНайти(Результат, "`");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз2 = СтрНайти(Сред(Результат, Поз + 1), "`");
		Если Поз2 = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз2 = Поз + Поз2;
		Код = Сред(Результат, Поз + 1, Поз2 - Поз - 1);
		Результат = Лев(Результат, Поз - 1)
			+ "<code class=""si-md-code"">"
			+ Код + "</code>"
			+ Сред(Результат, Поз2 + 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Замена **текст** на <b>...</b>
Функция ЗаменитьИнлайнЖирный(Знач Строка) Экспорт
	Результат = Строка;
	Пока Истина Цикл
		Поз = СтрНайти(Результат, "**");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз2 = СтрНайти(Сред(Результат, Поз + 2), "**");
		Если Поз2 = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз2 = Поз + 1 + Поз2;
		ТекстЖирный = Сред(Результат, Поз + 2, Поз2 - Поз - 2);
		Результат = Лев(Результат, Поз - 1)
			+ "<b>" + ТекстЖирный + "</b>"
			+ Сред(Результат, Поз2 + 2);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Замена *текст* на <i>...</i>
Функция ЗаменитьИнлайнКурсив(Знач Строка) Экспорт
	Результат = Строка;
	Пока Истина Цикл
		Поз = СтрНайти(Результат, "*");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз2 = СтрНайти(Сред(Результат, Поз + 1), "*");
		Если Поз2 = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз2 = Поз + Поз2;
		ТекстКурсив = Сред(Результат, Поз + 1, Поз2 - Поз - 1);
		Результат = Лев(Результат, Поз - 1)
			+ "<i>" + ТекстКурсив + "</i>"
			+ Сред(Результат, Поз2 + 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Экранирование содержимого блока кода: заменяем < и & (вход экранирован ранее, но блок кода
// может содержать литеральные теги - их нужно показать как есть)
Функция ЭкранироватьКодВБлоке(Знач Строка) Экспорт
	Возврат Строка;
КонецФункции

// Проверка начала маркированного/нумерованного списка
Функция НачатьСписок(Знач Строка) Экспорт
	Если СтрНачинаетсяС(Строка, "- ") ИЛИ СтрНачинаетсяС(Строка, "* ") Тогда
		Возврат Истина;
	КонецЕсли;
	Точка = СтрНайти(Строка, ". ");
	Если Точка > 1 И Точка <= 4 Тогда
		Префикс = Лев(Строка, Точка - 1);
		Если СтрЧислоВхождений(Префикс, "0") + СтрЧислоВхождений(Префикс, "1")
			+ СтрЧислоВхождений(Префикс, "2") + СтрЧислоВхождений(Префикс, "3")
			+ СтрЧислоВхождений(Префикс, "4") + СтрЧислоВхождений(Префикс, "5")
			+ СтрЧислоВхождений(Префикс, "6") + СтрЧислоВхождений(Префикс, "7")
			+ СтрЧислоВхождений(Префикс, "8") + СтрЧислоВхождений(Префикс, "9")
			= СтрДлина(Префикс) И СтрДлина(Префикс) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Разбор последовательности строк списка в <ul>/<ol> с <li>.
// Возвращает Структура: HTML - строка, СледующийИндекс - индекс первой строки после списка.
Функция РазобратьСписок(Знач Строки, Индекс) Экспорт
	Результат = Новый Структура("HTML, СледующийИндекс", "", Индекс);

	Нумерованный = СтрНачинаетсяС(Строки[Индекс], "1.");

	Массив = Новый Массив;
	Если Нумерованный Тогда
		Массив.Добавить("<ol class=""si-md-list"">");
	Иначе
		Массив.Добавить("<ul class=""si-md-list"">");
	КонецЕсли;

	Пока Индекс < Строки.Количество() Цикл
		Строка = Строки[Индекс];
		Если ПустаяСтрока(Строка) Тогда
			Прервать;
		КонецЕсли;

		Если НачатьСписок(Строка) Тогда
			Если Лев(Строка, 2) = "- " ИЛИ Лев(Строка, 2) = "* " Тогда
				Содержимое = Сред(Строка, 3);
			Иначе
				Точка = СтрНайти(Строка, ". ");
				Если Точка > 0 Тогда
					Содержимое = Сред(Строка, Точка + 2);
				Иначе
					Содержимое = Строка;
				КонецЕсли;
			КонецЕсли;
			Массив.Добавить("<li class=""si-md-li"">" + ОбработатьИнлайн(Содержимое) + "</li>");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Прервать;
	КонецЦикла;

	Если Нумерованный Тогда
		Массив.Добавить("</ol>");
	Иначе
		Массив.Добавить("</ul>");
	КонецЕсли;

	Результат.HTML = СтрСоединить(Массив, "");
	Результат.СледующийИндекс = Индекс;
	Возврат Результат;
КонецФункции

// Проверка строки-разделителя GFM-таблицы.
// По спецификации GFM разделитель должен содержать хотя бы одну | и хотя бы один -,
// остальные символы - только |, -, :, пробелы и табуляция.
Функция ЭтоРазделительТаблицы(Знач Строка) Экспорт
	Строка = СокрЛП(Строка);
	Если ПустаяСтрока(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрНайти(Строка, "|") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ЕстьДефис = Ложь;
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		ТекСимвол = Сред(Строка, Позиция, 1);
		Если ТекСимвол = "-" Тогда
			ЕстьДефис = Истина;
		ИначеЕсли ТекСимвол <> "|" И ТекСимвол <> ":" И ТекСимвол <> " " И ТекСимвол <> Символы.Таб Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьДефис;
КонецФункции

// Разбивает строку GFM-таблицы на ячейки. Внешние | опциональны.
// Пустые ячейки сохраняются (СтрРазделить с Истина), иначе колонки «съедут».
Функция РазбитьЯчейкиТаблицы(Знач Строка) Экспорт
	Строка = СокрЛП(Строка);
	УбратьПервый = СтрНачинаетсяС(Строка, "|");
	УбратьПоследний = СтрЗаканчиваетсяНа(Строка, "|") И СтрДлина(Строка) > 1;

	Части = СтрРазделить(Строка, "|", Истина);
	Если УбратьПервый И Части.Количество() > 0 Тогда
		Части.Удалить(0);
	КонецЕсли;
	Если УбратьПоследний И Части.Количество() > 0 Тогда
		Части.Удалить(Части.Количество() - 1);
	КонецЕсли;

	Возврат Части;
КонецФункции

// Разбор GFM-таблицы в <table>. Первая строка - шапка, вторая - разделитель.
// Возвращает Структура: HTML - строка, СледующийИндекс - индекс первой строки после таблицы.
Функция РазобратьТаблицу(Знач Строки, Индекс) Экспорт
	Результат = Новый Структура("HTML, СледующийИндекс", "", Индекс);

	СмещениеДоТела = 2;

	Массив = Новый Массив;
	Массив.Добавить("<div class=""si-scroll-x"">");
	Массив.Добавить("<table class=""si-md-table"">");

	Массив.Добавить("<tr>");
	Для Каждого Ячейка Из РазбитьЯчейкиТаблицы(Строки[Индекс]) Цикл
		ТекстЯчейки = ОбработатьИнлайн(СокрЛП(Ячейка));
		Массив.Добавить("<th class=""si-md-th"">"
			+ ТекстЯчейки + "</th>");
	КонецЦикла;
	Массив.Добавить("</tr>");

	Индекс = Индекс + СмещениеДоТела;
	Полосатая = Ложь;
	Пока Индекс < Строки.Количество() Цикл
		СтрокаТаблицы = Строки[Индекс];
		Если ПустаяСтрока(СтрокаТаблицы) Или СтрНайти(СтрокаТаблицы, "|") = 0 Тогда
			Прервать;
		КонецЕсли;

		КлассСтроки = ?(Полосатая, " class=""si-md-tr-alt""", "");
		Полосатая = НЕ Полосатая;
		Массив.Добавить("<tr" + КлассСтроки + ">");
		Для Каждого Ячейка Из РазбитьЯчейкиТаблицы(СтрокаТаблицы) Цикл
			ТекстЯчейки = ОбработатьИнлайн(СокрЛП(Ячейка));
			Массив.Добавить("<td class=""si-md-td"">"
				+ ТекстЯчейки + "</td>");
		КонецЦикла;
		Массив.Добавить("</tr>");

		Индекс = Индекс + 1;
	КонецЦикла;

	Массив.Добавить("</table></div>");

	Результат.HTML = СтрСоединить(Массив, "");
	Результат.СледующийИндекс = Индекс;
	Возврат Результат;
КонецФункции

// Извлекает из markdown-текста все таблицы GFM: шапку и строки тела, БЕЗ
// рендеринга в HTML. Нужна ссылке «В таблицу»: она выгружает таблицы ответа
// табличным документом и не зависит от инструментов запроса к БД, поэтому
// признак и данные берутся из самого текста ответа, а не из результата запроса.
//
// Условие начала таблицы то же, что в РазобратьMarkdownВHTML, - строка с |
// и следующая строка-разделитель. Блоки кода (``` ... ```) пропускаются:
// таблица внутри кода в чате таблицей не отрисовывается и в выгрузку не идёт.
//
// Параметры:
//  Текст - Строка - сырой текст ответа (markdown до экранирования и разбора).
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Шапка - Массив из Строка - тексты ячеек шапки;
//   * Строки - Массив из Структура - строки тела; у каждой структуры поле
//     Ячейки (Массив из Строка) - тексты ячеек строки.
Функция ИзвлечьТаблицыMarkdown(Знач Текст) Экспорт

	Результат = Новый Массив;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);

	Строки = СтрРазделить(Текст, Символы.ПС, Истина);

	ВБлокеКода = Ложь;
	Индекс = 0;
	Пока Индекс < Строки.Количество() Цикл
		Строка = Строки[Индекс];

		Если СтрНачинаетсяС(Строка, "```") Тогда
			ВБлокеКода = НЕ ВБлокеКода;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если ВБлокеКода Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		ЭтоНачалоТаблицы = СтрНайти(Строка, "|") > 0
			И Индекс + 1 < Строки.Количество()
			И ЭтоРазделительТаблицы(Строки[Индекс + 1]);
		Если НЕ ЭтоНачалоТаблицы Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Таблица = Новый Структура("Шапка, Строки", Новый Массив, Новый Массив);
		Таблица.Шапка = ОчищенныеЯчейкиТаблицы(Строки[Индекс]);

		Индекс = Индекс + 2;
		Пока Индекс < Строки.Количество() Цикл
			СтрокаТаблицы = Строки[Индекс];
			Если ПустаяСтрока(СтрокаТаблицы) ИЛИ СтрНайти(СтрокаТаблицы, "|") = 0 Тогда
				Прервать;
			КонецЕсли;
			Таблица.Строки.Добавить(
				Новый Структура("Ячейки", ОчищенныеЯчейкиТаблицы(СтрокаТаблицы)));
			Индекс = Индекс + 1;
		КонецЦикла;

		Результат.Добавить(Таблица);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует URL в кликабельные ссылки. Входной текст - HTML после markdown-разметки.
Функция ПреобразоватьСсылкиВHTML(Знач Текст) Экспорт
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = Текст;
	Старт = 1;
	Пока Истина Цикл
		Поз = НайтиСсылку(Результат, Старт);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;

		СимволПередАдресом = "";
		Если Поз > 1 Тогда
			СимволПередАдресом = Сред(Результат, Поз - 1, 1);
		КонецЕсли;
		Если СимволПередАдресом = "=" ИЛИ СимволПередАдресом = """" ИЛИ СимволПередАдресом = "'" Тогда
			Старт = Поз + 4;
			Продолжить;
		КонецЕсли;

		Конец = Поз;
		Пока Конец <= СтрДлина(Результат) Цикл
			Символ = Сред(Результат, Конец, 1);
			Если Символ = " " ИЛИ Символ = Символы.ПС ИЛИ Символ = "<" ИЛИ Символ = ">" Тогда
				Прервать;
			КонецЕсли;
			Конец = Конец + 1;
		КонецЦикла;
		Конец = Конец - 1;

		URL = Сред(Результат, Поз, Конец - Поз + 1);
		Пока СтрДлина(URL) > 0 И СтрНайти(".,;:!?)]}", Прав(URL, 1)) > 0 Цикл
			URL = Лев(URL, СтрДлина(URL) - 1);
			Конец = Конец - 1;
		КонецЦикла;

		Если СтрДлина(URL) >= 8 Тогда
			Href = ЭкранироватьАтрибут(URL);
			Замена = "<a href=""" + Href + """ target=""_blank"" rel=""noopener noreferrer"" class=""si-md-a"">"
				+ URL + "</a>";
			Результат = Лев(Результат, Поз - 1) + Замена + Сред(Результат, Конец + 1);
			Старт = Поз + СтрДлина(Замена);
		Иначе
			Старт = Конец + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Преобразует маркеры файлов диалога вида file:<UUID> (или file://<UUID>)
// в кликабельные ссылки «Скачать файл» в HTML-истории чата.
// Входной текст - HTML после markdown-разметки и ПреобразоватьСсылкиВHTML.
// Функция накапливает результат в отдельной строке и двигается по остатку,
// поэтому не теряет данные даже когда найденный file: находится внутри
// уже вставленной ссылки href="file:..." (ссылка-результат сохраняется).
//
// Параметры:
//  Текст - Строка - HTML после markdown-разметки и ПреобразоватьСсылкиВHTML.
//  ВставлятьПревьюКартинок - Булево - для файлов-изображений перед кнопкой
//   выводится крупный прокручиваемый просмотр (СИ_ФайлыДиалога.
//   HTMLПросмотрФайла: читаемая ширина, прокрутка в контейнере 420px).
//   Не-изображения и слишком большие файлы рисуются только кнопкой.
//  КэшПревью - Соответствие из Структура, Неопределено - кэш готовых превью формы чата
//   (см. СИ_ФайлыДиалога.ПревьюИзКэша); Неопределено - без кэша.
//  УИДыБезПревью - Массив из Строка,Неопределено - файлы, для которых
//   встроенное превью не строится (диаграммы DrawChart уже показаны отдельной
//   карточкой); кнопка «Скачать файл» при этом остаётся.
//
// Возвращаемое значение:
//  Строка - HTML с кнопками «Скачать файл» (и превью картинок) вместо маркеров.
Функция ПреобразоватьСсылкиНаФайлыВHTML(Знач Текст, Знач ВставлятьПревьюКартинок = Ложь,
	КэшПревью = Неопределено, Знач УИДыБезПревью = Неопределено) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Остаток = Текст;

	Пока Истина Цикл
		Поз = СтрНайти(Остаток, "file:");
		Если Поз = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		СимволДо = "";
		Если Поз > 1 Тогда
			СимволДо = Сред(Остаток, Поз - 1, 1);
		КонецЕсли;
		Если СимволДо = "=" ИЛИ СимволДо = """" Тогда
			Результат = Результат + Лев(Остаток, Поз + 4);
			Остаток = Сред(Остаток, Поз + 5);
			Продолжить;
		КонецЕсли;

		Конец = Поз + 5;
		Пока Конец <= СтрДлина(Остаток) Цикл
			Символ = Сред(Остаток, Конец, 1);
			Если Символ = " " ИЛИ Символ = Символы.ПС ИЛИ Символ = "<" ИЛИ Символ = ">"
				ИЛИ Символ = ")" ИЛИ Символ = "]" ИЛИ Символ = ","
				ИЛИ Символ = "." ИЛИ Символ = "!" ИЛИ Символ = "?" ИЛИ Символ = ";"
				ИЛИ Символ = ":" Тогда
				Прервать;
			КонецЕсли;
			Конец = Конец + 1;
		КонецЦикла;

		УИДФайла = Сред(Остаток, Поз + 5, Конец - (Поз + 5));
		Если СтрНачинаетсяС(УИДФайла, "//") Тогда
			УИДФайла = Сред(УИДФайла, 3);
		КонецЕсли;

		Если СтрДлина(УИДФайла) >= 8 Тогда
			ПревьюHTML = "";
			Если ВставлятьПревьюКартинок
				И НЕ УИДФайлаВСписке(УИДыБезПревью, УИДФайла) Тогда
				Попытка
					ПревьюHTML = СИ_ФайлыДиалога.HTMLПросмотрФайла(УИДФайла, КэшПревью);
				Исключение
					ПревьюHTML = "";
				КонецПопытки;
				Если ПревьюHTML <> "" Тогда
					ПревьюHTML = ПревьюHTML + "<br/>";
				КонецЕсли;
			КонецЕсли;
			Замена = ПревьюHTML + "<a href=""file:" + ЭкранироватьАтрибут(УИДФайла) + """"
				+ " title=""Скачать файл"""
				+ " class=""chatbtn"" style=""margin:4px 2px;"">"
				+ "<span>"
				+ "<svg xmlns=""http://www.w3.org/2000/svg"" width=""14"" height=""14"" viewBox=""0 0 24 24"""
				+ " fill=""none"" stroke=""currentColor"" stroke-width=""2.5"" stroke-linecap=""round"" stroke-linejoin=""round"""
				+ " style=""vertical-align:middle;margin-right:6px;"">"
					+ "<path d=""M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4""></path>"
					+ "<polyline points=""7 10 12 15 17 10""></polyline>"
					+ "<line x1=""12"" y1=""15"" x2=""12"" y2=""3""></line>"
				+ "</svg>"
				+ "Скачать файл</span></a>";
			Результат = Результат + Лев(Остаток, Поз - 1) + Замена;

			Остаток = Сред(Остаток, Конец);
			Пока СтрДлина(Остаток) > 0 Цикл
				ПервыйСимвол = Лев(Остаток, 1);
				Если ПервыйСимвол = "." ИЛИ ПервыйСимвол = "," ИЛИ ПервыйСимвол = ";"
					ИЛИ ПервыйСимвол = "!" ИЛИ ПервыйСимвол = "?" Тогда
					Остаток = Сред(Остаток, 2);
					Прервать;
				ИначеЕсли ПервыйСимвол = " " ИЛИ ПервыйСимвол = Символы.ПС Тогда
					Остаток = Сред(Остаток, 2);
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Результат = Результат + Лев(Остаток, Поз + 4);
			Остаток = Сред(Остаток, Поз + 5);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, входит ли файл в список исключений (регистр не важен).
//
// Параметры:
//  УИДы - Массив из Строка,Неопределено - список UUID.
//  УИДФайла - Строка - UUID проверяемого файла.
//
// Возвращаемое значение:
//  Булево - Истина, если файл в списке.
Функция УИДФайлаВСписке(Знач УИДы, Знач УИДФайла)

	Если ТипЗнч(УИДы) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	УИДФайлаНРег = НРег(УИДФайла);
	Для Каждого УИД Из УИДы Цикл
		Если НРег(Строка(УИД)) = УИДФайлаНРег Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Преобразует упоминания объектов 1С в тексте ответа в кликабельные
// навигационные ссылки (e1cib/...). Карта «упоминание -> адрес» собирается
// СЕРВЕРОМ из результатов инструментов (СИ_УправлениеИнструментами1С.
// СобратьСсылкиДокументов) и хранится в сообщении диалога: текст модели
// источником адресов не является, модель карту не видит.
//
// Входной текст - HTML после markdown-разметки. Разметка разбирается на теги и
// текст: замены делаются только в текстовых участках, поэтому упоминания внутри
// уже вставленных тегов (href, атрибуты) не портятся.
//
// Параметры:
//  Текст - Строка - HTML после РазобратьMarkdownВHTML;
//  КартаСсылок - Массив из Структура,Неопределено - карта ссылок:
//    * Упоминание - Строка - текст упоминания объекта в ответе;
//    * Адрес - Строка - навигационная ссылка вида "e1cib/data/...".
//    Адрес обязан начинаться с "e1cib/" - иначе элемент карты пропускается.
//
// Возвращаемое значение:
//  Строка - HTML, в котором упоминания объектов стали ссылками.
Функция ПреобразоватьУпоминанияВСсылки(Знач Текст, КартаСсылок) Экспорт

	Если ПустаяСтрока(Текст) ИЛИ ТипЗнч(КартаСсылок) <> Тип("Массив")
		ИЛИ КартаСсылок.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Упоминания = ПодготовитьУпоминанияДляЗамены(КартаСсылок);
	Если Упоминания.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = "";
	Остаток = Текст;

	ВнутриСсылки = Ложь;

	Пока НЕ ПустаяСтрока(Остаток) Цикл
		ПозицияТега = СтрНайти(Остаток, "<");
		Если ПозицияТега = 0 Тогда
			Если НЕ ВнутриСсылки Тогда
				Остаток = ЗаменитьУпоминанияВТексте(Остаток, Упоминания);
			КонецЕсли;
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		ТекстДоТега = Лев(Остаток, ПозицияТега - 1);
		Если НЕ ВнутриСсылки Тогда
			ТекстДоТега = ЗаменитьУпоминанияВТексте(ТекстДоТега, Упоминания);
		КонецЕсли;
		Результат = Результат + ТекстДоТега;

		ПозицияЗакрытия = СтрНайти(Остаток, ">", , ПозицияТега);
		Если ПозицияЗакрытия = 0 Тогда
			Результат = Результат + Сред(Остаток, ПозицияТега);
			Прервать;
		КонецЕсли;

		Тег = Сред(Остаток, ПозицияТега, ПозицияЗакрытия - ПозицияТега + 1);
		ТегНРег = НРег(Тег);
		Если СтрНачинаетсяС(ТегНРег, "<a ") ИЛИ СтрНачинаетсяС(ТегНРег, "<a>") Тогда
			ВнутриСсылки = Истина;
		ИначеЕсли СтрНачинаетсяС(ТегНРег, "</a") Тогда
			ВнутриСсылки = Ложь;
		КонецЕсли;

		Результат = Результат + Тег;
		Остаток = Сред(Остаток, ПозицияЗакрытия + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поиск начала ссылки (http:// или https://) начиная с позиции Старт
Функция НайтиСсылку(Знач Текст, Старт) Экспорт
	Поз = 0;
	Поз2 = 0;
	Если Старт <= СтрДлина(Текст) Тогда
		ПодстрокаПоиска = Сред(Текст, Старт);
		Поз = СтрНайти(ПодстрокаПоиска, "http://");
		Поз2 = СтрНайти(ПодстрокаПоиска, "https://");
		Если Поз > 0 Тогда
			Поз = Поз + Старт - 1;
		КонецЕсли;
		Если Поз2 > 0 Тогда
			Поз2 = Поз2 + Старт - 1;
		КонецЕсли;
	КонецЕсли;
	Если Поз = 0 Тогда
		Возврат Поз2;
	ИначеЕсли Поз2 = 0 Тогда
		Возврат Поз;
	Иначе
		Возврат Мин(Поз, Поз2);
	КонецЕсли;
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подготавливает карту ссылок к замене: упоминания переводятся в HTML-вид
// (они ищутся в уже отрисованном тексте), адреса проверяются и экранируются,
// элементы сортируются по убыванию длины упоминания.
//
// Параметры:
//  КартаСсылок - Массив из Структура - карта из сообщения (Упоминание, Адрес).
//
// Возвращаемое значение:
//  Массив из Структура - подготовленные замены: УпоминаниеHTML, АдресHTML,
//  Длина. Порядок - от длинных упоминаний к коротким.
Функция ПодготовитьУпоминанияДляЗамены(КартаСсылок)

	Подготовленные = Новый Массив;

	Для Каждого СсылкаКарты Из КартаСсылок Цикл
		Упоминание = СИ_РаботаСJSON.БезопасноПолучить(СсылкаКарты, "Упоминание", "");
		Адрес = СИ_РаботаСJSON.БезопасноПолучить(СсылкаКарты, "Адрес", "");

		Если СтрДлина(Упоминание) < 3 ИЛИ НЕ СтрНачинаетсяС(Адрес, "e1cib/") Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Структура;
		Элемент.Вставить("УпоминаниеHTML", ЭкранироватьАтрибут(Упоминание));
		Элемент.Вставить("АдресHTML", ЭкранироватьАтрибут(Адрес));
		Элемент.Вставить("Длина", СтрДлина(Упоминание));
		ВставитьПоДлинеУпоминания(Подготовленные, Элемент);
	КонецЦикла;

	Возврат Подготовленные;

КонецФункции

// Вставка подготовленной замены с сохранением порядка по убыванию длины
// упоминания. Длинные упоминания обязаны заменяться первыми: иначе короткое
// «№ 123» съело бы часть длинного «Реализация товаров и услуг № 123 от 01.01.2026»,
// и хвост представления остался бы текстом.
//
// Параметры:
//  Подготовленные - Массив из Структура - накопитель (см. ПодготовитьУпоминанияДляЗамены);
//  Элемент - Структура - добавляемая замена.
Процедура ВставитьПоДлинеУпоминания(Подготовленные, Элемент)

	Позиция = Подготовленные.Количество();
	Пока Позиция > 0 И Подготовленные[Позиция - 1].Длина < Элемент.Длина Цикл
		Позиция = Позиция - 1;
	КонецЦикла;

	Подготовленные.Вставить(Позиция, Элемент);

КонецПроцедуры

// Заменяет упоминания объектов ссылками в текстовом участке HTML (вне тегов).
//
// Параметры:
//  Текст - Строка - текстовый участок HTML;
//  Упоминания - Массив из Структура - подготовленные замены
//    (см. ПодготовитьУпоминанияДляЗамены), от длинных к коротким.
//
// Возвращаемое значение:
//  Строка - текст с заменёнными упоминаниями.
Функция ЗаменитьУпоминанияВТексте(Знач Текст, Знач Упоминания)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = Текст;
	Для Каждого УпоминаниеСАдресом Из Упоминания Цикл
		Если СтрНайти(Результат, УпоминаниеСАдресом.УпоминаниеHTML) = 0 Тогда
			Продолжить;
		КонецЕсли;
		СсылкаHTML = "<a href=""" + УпоминаниеСАдресом.АдресHTML + """ class=""si-md-a"">"
			+ УпоминаниеСАдресом.УпоминаниеHTML + "</a>";
		Результат = СтрЗаменить(Результат, УпоминаниеСАдресом.УпоминаниеHTML, СсылкаHTML);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ячейки строки GFM-таблицы, очищенные от инлайн-разметки. Для выгрузки
// табличным документом: markdown-оформление там не поддерживается, в ячейке
// нужен читаемый текст, а не ** и обратные кавычки.
//
// Параметры:
//  Строка - Строка - строка GFM-таблицы (с внешними | или без них).
//
// Возвращаемое значение:
//  Массив из Строка - тексты ячеек строки.
Функция ОчищенныеЯчейкиТаблицы(Знач Строка)

	Результат = Новый Массив;
	Для Каждого Ячейка Из РазбитьЯчейкиТаблицы(Строка) Цикл
		Результат.Добавить(ОчиститьИнлайнРазметку(Ячейка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Снимает инлайн-разметку markdown, оставляя текст: ссылки [текст](адрес) и
// картинки ![alt](адрес) - по тексту, парные маркеры **жирный**, *курсив*,
// `код` - без самих маркеров. Непарные маркеры не трогаются (в рендере они
// тоже остаются как есть), подчёркивания не снимаются - они встречаются в
// именах объектов и полей (СИ_Агент1С) и не являются разметкой в этом коде.
//
// Параметры:
//  Текст - Строка - текст одной ячейки, возможно с инлайн-разметкой.
//
// Возвращаемое значение:
//  Строка - текст без инлайн-разметки.
Функция ОчиститьИнлайнРазметку(Знач Текст)

	Результат = СокрЛП(Текст);
	Если ПустаяСтрока(Результат) Тогда
		Возврат "";
	КонецЕсли;

	Результат = ЗаменитьСсылкиРазметки(Результат, "![");
	Результат = ЗаменитьСсылкиРазметки(Результат, "[");
	Результат = СнятьПарныеМаркеры(Результат, "`");
	Результат = СнятьПарныеМаркеры(Результат, "**");
	Результат = СнятьПарныеМаркеры(Результат, "*");

	Возврат СокрЛП(Результат);

КонецФункции

// Заменяет ссылки markdown вида <Префикс>текст](адрес) на «текст». Префикс -
// "[" для обычных ссылок и "![" для картинок (остаётся alt-текст). Незакрытая
// конструкция (нет "](" или ")") остаётся как есть.
//
// Параметры:
//  Текст - Строка - текст, в котором заменяются ссылки;
//  Префикс - Строка - "[" для ссылок, "![" для картинок.
//
// Возвращаемое значение:
//  Строка - текст, в котором ссылки заменены их подписями.
Функция ЗаменитьСсылкиРазметки(Знач Текст, Знач Префикс)

	Результат = "";
	Остаток = Текст;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, Префикс);
		Если Начало = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		Результат = Результат + Лев(Остаток, Начало - 1);
		Хвост = Сред(Остаток, Начало + СтрДлина(Префикс));

		ЗакрытиеТекста = СтрНайти(Хвост, "](");
		Если ЗакрытиеТекста = 0 Тогда
			Результат = Результат + Префикс + Хвост;
			Прервать;
		КонецЕсли;

		ПослеСкобки = Сред(Хвост, ЗакрытиеТекста + 2);
		ЗакрытиеАдреса = СтрНайти(ПослеСкобки, ")");
		Если ЗакрытиеАдреса = 0 Тогда
			Результат = Результат + Префикс + Хвост;
			Прервать;
		КонецЕсли;

		Результат = Результат + Лев(Хвост, ЗакрытиеТекста - 1);
		Остаток = Сред(ПослеСкобки, ЗакрытиеАдреса + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Убирает ПАРНЫЕ маркеры оформления (**, *, `), оставляя содержимое между
// ними. Непарный маркер сохраняется: он не открывал оформления и в рендере
// тоже остаётся в тексте.
//
// Параметры:
//  Текст - Строка - текст, в котором снимаются маркеры;
//  Маркер - Строка - парный маркер оформления: "`", "**" или "*".
//
// Возвращаемое значение:
//  Строка - текст без парных маркеров оформления.
Функция СнятьПарныеМаркеры(Знач Текст, Знач Маркер)

	Результат = "";
	Остаток = Текст;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, Маркер);
		Если Начало = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		Хвост = Сред(Остаток, Начало + СтрДлина(Маркер));
		Закрытие = СтрНайти(Хвост, Маркер);
		Если Закрытие = 0 Тогда
			Результат = Результат + Лев(Остаток, Начало - 1) + Маркер + Хвост;
			Прервать;
		КонецЕсли;

		Результат = Результат + Лев(Остаток, Начало - 1) + Лев(Хвост, Закрытие - 1);
		Остаток = Сред(Хвост, Закрытие + СтрДлина(Маркер));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Допустимый ли адрес у markdown-ссылки: разрешены внешние адреса (http, https),
// навигационные ссылки 1С (e1cib), почта (mailto) и ссылка на файл диалога
// (file: - только с идентификатором файла). Адрес разметки берётся из текста
// модели, а не из серверной карты, поэтому схема file: принимается только со
// служебным идентификатором: произвольный адрес (в том числе локальный путь)
// кликабельным не станет.
//
// Параметры:
//  Адрес - Строка - адрес из разметки.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылку можно ставить в href.
Функция ЭтоДопустимаяСсылка(Знач Адрес)

	АдресНРег = НРег(СокрЛП(Адрес));

	Возврат СтрНачинаетсяС(АдресНРег, "http://")
		ИЛИ СтрНачинаетсяС(АдресНРег, "https://")
		ИЛИ СтрНачинаетсяС(АдресНРег, "e1cib/")
		ИЛИ ЭтоСсылкаНаФайлДиалога(АдресНРег)
		ИЛИ СтрНачинаетсяС(АдресНРег, "mailto:");

КонецФункции

// Служебная ссылка на файл диалога: file:<UUID> или file://<UUID>, где UUID -
// 32 шестнадцатеричных знака. Ссылки на файлы чата подставляет отдельный
// механизм маркеров (ПреобразоватьСсылкиНаФайлыВHTML) - здесь проверяется
// только разметка, написанная моделью, чтобы адрес вёл именно на файл диалога
// (форма разбирает клик как идентификатор файла).
//
// Параметры:
//  АдресНРег - Строка - адрес в нижнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес - ссылка на файл диалога.
Функция ЭтоСсылкаНаФайлДиалога(Знач АдресНРег)

	Если НЕ СтрНачинаетсяС(АдресНРег, "file:") Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(АдресНРег, 6);
	Если СтрНачинаетсяС(Хвост, "//") Тогда
		Хвост = Сред(Хвост, 3);
	КонецЕсли;

	Если СтрДлина(Хвост) <> 32 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По 32 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Хвост, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Дополнительные атрибуты ссылки для адреса из разметки: внешние адреса
// открываются в браузере в новом окне (как в ПреобразоватьСсылкиВHTML),
// навигационные ссылки 1С обрабатывает форма чата - им лишние атрибуты не нужны.
//
// Параметры:
//  Адрес - Строка - адрес из разметки.
//
// Возвращаемое значение:
//  Строка - атрибуты для вставки в тег (может быть пустой строкой).
Функция ЦелиСсылкиРазметки(Знач Адрес)

	АдресНРег = НРег(СокрЛП(Адрес));
	Если СтрНачинаетсяС(АдресНРег, "http://") ИЛИ СтрНачинаетсяС(АдресНРег, "https://") Тогда
		Возврат " target=""_blank"" rel=""noopener noreferrer""";
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти
