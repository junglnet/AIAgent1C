#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗагрузитьРежимыВИнстументы(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		Объект.ТипПодключения = Перечисления.СИ_ТипыПодключенийMCP.StreamableHTTP;
		Объект.ТребуетИнициализацию = Истина;
		Объект.ВерсияПротокола = "2025-06-18";
		Объект.Включен = Истина;
		Объект.ТаймаутВызова = 60;
		Объект.ЗаголовкиJSON = "{}";
		Объект.ТипАвторизации = Перечисления.СИ_ТипыАвторизации.Нет;
	КонецЕсли;
	
	Элементы.ИнструментыРежимы.ВыбиратьТип = Ложь;
	Элементы.ИнструментыРежимы.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.СИ_РежимиРаботы");
	Элементы.ИнструментыРежимы.ДоступныеТипы = Новый ОписаниеТипов("СправочникСсылка.СИ_РежимиРаботы");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.РежимыИнструментов.Очистить();
	
	Для Каждого Строка Из Объект.Инструменты Цикл
		
		Если Строка.Режимы.Количество() > 0 И Строка.Разрешен Тогда
			
			Для Каждого Режим ИЗ Строка.Режимы Цикл
				
				НоваяСтрока = Объект.РежимыИнструментов.Добавить();
				НоваяСтрока.Инструмент = Строка.ИмяИнструмента;
				НоваяСтрока.Режим = Режим.Значение;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗагрузитьРежимыВИнстументы(ТекущийОбъект);
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
АСИНХ Процедура ПроверитьПодключение(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда	
		ЖДАТЬ ПредупреждениеАсинх(НСтр("ru='Форма содержит несохранённые изменения. Необходимо сначала записать объект'"));
		Возврат;
		
	КонецЕсли;

	Результат = ПроверитьПодключениеНаСервере();
	Прочитать();
	
	ЖДАТЬ ПредупреждениеАсинх(Результат);

КонецПроцедуры

&НаКлиенте
АСИНХ Процедура ЗагрузитьИнструменты(Команда)
		
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда	
		ЖДАТЬ ПредупреждениеАсинх(НСтр("ru='Форма содержит несохранённые изменения. Необходимо сначала записать объект'"));
		Возврат;
		
	КонецЕсли;

	ВыполнитьЗагрузкуИнструментов();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежим(Команда)
	
	ТекущиеДанные = Элементы.Инструменты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущиеДанные.ПолучитьИдентификатор());
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораРежимов", ЭтотОбъект);
	ОткрытьФорму("Справочник.СИ_РежимиРаботы.ФормаВыбора",
		ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);

КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьРежимыВИнстументы(ТекущийОбъект)
	
	Для Каждого Режим Из ТекущийОбъект.РежимыИнструментов Цикл
		
		НСтроки = Объект.Инструменты.НайтиСтроки(Новый Структура("ИмяИнструмента", Режим.Инструмент));
		
		Для Каждого НСтрока Из НСтроки Цикл
			
			Нстрока.Режимы.Добавить(Режим.Режим);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораИнструментов(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеИнструменты = Неопределено;
	
	Результат.Свойство("ВыбранныеИнструменты",ВыбранныеИнструменты);
	
	ЗагрузитьИнструментыНаСервере(ВыбранныеИнструменты);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРежимов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ВыделеныеСтроки = Элементы.Инструменты.ВыделенныеСтроки;
	
	Для Каждого Строка Из ВыделеныеСтроки Цикл
		
		ДанныеСтроки = Элементы.Инструменты.ДанныеСтроки(Строка);
		
		ДанныеСтроки.Режимы.Очистить();
		
		ДанныеСтроки.Режимы.ЗагрузитьЗначения(Результат);
				
	КонецЦикла;

КонецПроцедуры

// Действия загрузки инструментов, вызываемые из обработчика команды и
// из обработчика вопроса о сохранении (без прямого вызова обработчика события).
&НаКлиенте
Процедура ВыполнитьЗагрузкуИнструментов()
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СерверMCP", Объект.Ссылка);

	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораИнструментов", ЭтотОбъект);
	ОткрытьФорму("Справочник.СИ_MCPСерверы.Форма.ФормаВыбораИнструментов",
		ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения);

КонецПроцедуры

&НаСервере
Функция ПроверитьПодключениеНаСервере()

	Результат = СИ_УправлениеИнструментамиMCP.ПроверитьПодключение(Объект.Ссылка);
		
	Если Результат = Неопределено Тогда
		Возврат НСтр("ru='Не удалось проверить подключение'");
	КонецЕсли;
	
	Если Не Результат.Успех Тогда

		ЗаписьЖурналаРегистрации("СИ_MCPСерверы.ПроверкаПодключения",
			УровеньЖурналаРегистрации.Ошибка,
			Объект.Ссылка,
			Результат.Сообщение);
	КонецЕсли;

	Возврат СтрШаблон("%1. %2", Результат.Сообщение, Результат.ДатаПоследнейПроверки);

КонецФункции

&НаСервере
Процедура ЗагрузитьИнструментыНаСервере(ВыбранныеИнструменты)
	
	РазрешенияПоИмени = Новый Соответствие;
	Для Каждого СтрокаТЧ Из Объект.Инструменты Цикл
		РазрешенияПоИмени.Вставить(НРег(СтрокаТЧ.ИмяИнструмента), СтрокаТЧ.ТребуетРазрешения);
	КонецЦикла;

	РежимыИнструментовПоИмени = Новый Соответствие;
	Для Каждого СтрокаТЧ Из Объект.Инструменты Цикл
		Если СтрокаТЧ.Режимы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СписокРежимов = Новый Массив;
		Для Каждого РежимИзКолонки Из СтрокаТЧ.Режимы Цикл
			СписокРежимов.Добавить(РежимИзКолонки.Значение);
		КонецЦикла;
		РежимыИнструментовПоИмени.Вставить(НРег(СтрокаТЧ.ИмяИнструмента), СписокРежимов);
	КонецЦикла;
	
	Объект.Инструменты.Очистить();
	Объект.РежимыИнструментов.Очистить();
	
	ВыбранныеИмена = Новый Соответствие;
	Для Каждого Выбранный Из ВыбранныеИнструменты Цикл
		Имя = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Имя", "");
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		ВыбранныеИмена.Вставить(НРег(Имя), Выбранный);
	КонецЦикла;

	НайденныеСтроки = Новый Соответствие;
	
	Для Каждого СтрокаТЧ Из Объект.Инструменты Цикл
		
		ИмяИнструмента = СтрокаТЧ.ИмяИнструмента;
		
		Если ВыбранныеИмена.Получить(НРег(ИмяИнструмента)) <> Неопределено Тогда
			Выбранный = ВыбранныеИмена.Получить(НРег(ИмяИнструмента));
			СтрокаТЧ.Описание = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Описание", "");
			СтрокаТЧ.ПараметрыSchema = ПолучитьСхемуПараметров(Выбранный);
			СтрокаТЧ.Разрешен = Истина;
			НайденныеСтроки.Вставить(НРег(ИмяИнструмента), СтрокаТЧ);
		
		КонецЕсли;
		
	КонецЦикла;

	Для Каждого Выбранный Из ВыбранныеИнструменты Цикл
		Имя = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Имя", "");
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если НайденныеСтроки.Получить(НРег(Имя)) = Неопределено Тогда
			НоваяСтрока = Объект.Инструменты.Добавить();
			НоваяСтрока.ИмяИнструмента = Имя;
			НоваяСтрока.Описание = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "Описание", "");
			НоваяСтрока.ПараметрыSchema = ПолучитьСхемуПараметров(Выбранный);
			НоваяСтрока.Разрешен = Истина;
			НоваяСтрока.ДатаРегистрации = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТЧ Из Объект.Инструменты Цикл
		КлючРежима = НРег(СтрокаТЧ.ИмяИнструмента);

		СохранённоеРазрешение = РазрешенияПоИмени.Получить(КлючРежима);
		Если СохранённоеРазрешение <> Неопределено Тогда
			СтрокаТЧ.ТребуетРазрешения = СохранённоеРазрешение;
		Иначе
			СтрокаТЧ.ТребуетРазрешения = СИ_УправлениеИнструментамиMCP.ТребуетРазрешенияПоИнструменту(
				ДескрипторСАннотациями(ВыбранныеИмена.Получить(КлючРежима)));
		КонецЕсли;

		СписокРежимов = РежимыИнструментовПоИмени.Получить(КлючРежима);
		Если СписокРежимов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТЧ.Режимы.Очистить();
		СтрокаТЧ.Режимы.ЗагрузитьЗначения(СписокРежимов);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСхемуПараметров(Выбранный)
	СхемаПараметров = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "СхемаПараметров", Неопределено);
	Если СхемаПараметров <> Неопределено Тогда
		Возврат СИ_РаботаСJSON.ЗаписатьСтрокуJSON(СхемаПараметров);
	КонецЕсли;

	СхемаJSON = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "СхемаПараметровJSON", "");
	Если НЕ ПустаяСтрока(СхемаJSON) Тогда
		Попытка
			Распарс = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(СхемаJSON);
			Если Распарс <> Неопределено Тогда
				Возврат СхемаJSON;
			КонецЕсли;
		Исключение
			;
		КонецПопытки;
	КонецЕсли;

	Возврат "{}";
КонецФункции

&НаСервере
Функция ДескрипторСАннотациями(Выбранный)

	СтрокаАннотаций = СИ_РаботаСJSON.БезопасноПолучить(Выбранный, "АннотацииJSON", "");
	Если ПустаяСтрока(СтрокаАннотаций) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Аннотации = СИ_РаботаСJSON.ПрочитатьСтрокуJSON(СтрокаАннотаций);
	Если Аннотации = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Дескриптор = Новый Структура;
	Дескриптор.Вставить("Аннотации", Аннотации);
	Возврат Дескриптор;

КонецФункции

#КонецОбласти
