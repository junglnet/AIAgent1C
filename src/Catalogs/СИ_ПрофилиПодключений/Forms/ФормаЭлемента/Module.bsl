#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.Таймаут = 60;
		Объект.МаксимумИтераций = 20;
		Объект.ТипАвторизации = Перечисления.СИ_ТипыАвторизации.Bearer;
		Объект.РазрешитьРассуждения = Ложь;
		Объект.ИмяЗаголовкаАвторизации = "Authorization";
		Объект.КоличествоПовторовПриТранспортнойОшибке = 5;
		Объект.ПроверятьSSL = Истина;
		
		Объект.ИспользоватьСводку = Ложь;
		Объект.МаксТокеновСводки = 1500;
		Объект.КоличествоСвежихСообщений = 10;
		Объект.МаксДлинаToolРезультата = 4000;
		Объект.МаксДлинаСообщения = 4000;
		Объект.ПроцентОкнаДляИстории = 0.75;
		
		Объект.ДвижокКонвертацииPDF = "pdftoppm";
		Объект.ПутьКУтилитеКонвертацииPDF = "";
		Объект.МаксимумСтраницPDF = 10;
		Объект.DPIКонвертацииPDF = 150;
	КонецЕсли;
	
	ОформлениеФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.Наименование = Объект.БазовыйURL;
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ИспользоватьПроксиПриИзменении(Элемент)
	
	ОформлениеФормы(ЭтотОбъект);
	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОформлениеФормы(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Элементы.ПроксиСервер.Доступность = Объект.ИспользоватьПрокси;
	Элементы.ПроксиПорт.Доступность = Объект.ИспользоватьПрокси;
	Элементы.ПроксиПользователь.Доступность = Объект.ИспользоватьПрокси;
	Элементы.ПроксиПароль.Доступность = Объект.ИспользоватьПрокси;
	
КонецПроцедуры

#КонецОбласти
